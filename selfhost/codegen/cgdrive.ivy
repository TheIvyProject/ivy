// selfhost/codegen/cgdrive.ivy - driver for the selfhost textual LLVM IR
// emitter.  Reads a source path from stdin, runs the shared frontend
// (`pipeline::Cg`, H8.1) and emits the IR text through `Emitter`.  The IR goes
// to host stdout and the diagnostics to host stderr, so the harness can
// compare raw bytes against `ivy --llvm`.
//
// Usage:
//   ivy.exe selfhost\codegen\cgdrive.ivy -I selfhost\parsing -I selfhost\hir -I selfhost\mir -I selfhost\codegen -I selfhost\app -I std -o cgdrive.exe
//   cgdrive.exe < fixture.ivy
//
// H8.1 moved the lexer/preprocessor/parser/merge/splice/`.ivm`/HIR/MIR part of
// `run()` (src/app/main.cpp:917-1321) into selfhost/app/pipeline.ivy so the
// unified CLI (`selfhost/app/main.ivy`) and this differential driver share one
// implementation.  cgdrive keeps its stdin/stdout protocol: the module search
// path is the current directory (no `-I`), exactly as before.

#pragma ivy cnumber
// H7.4: `diagnostic` is imported directly so the oracle's linker (which links
// the objects of the modules the main file imports, src/app/main.cpp:929-1016)
// pulls in diagnostic.obj; the lexer/preprocessor/parser reference its symbols.
// H8.1: the same applies to every module the shared pipeline calls into - the
// linker only sees the `.obj` files of the modules *this* file imports.
import diagnostic;
import token;
import lexer;
import preprocessor;
import ast;
import parser;
import module_io;
import imports;
import cli;
import hir;
import hir_builder;
import mir;
import mir_builder;
import pipeline;
import emitter;
import io;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);

long run() {
    long result = 1;
    unsafe {
        char* path = io::read_line();
        if (path == (char*) 0) {
            io::eprintln("cgdrive: no path on stdin");
            return 1;
        }
        uint64 np = __ivy_strlen(path);
        while (np > 0 && (path[np - 1] == 13 || path[np - 1] == 10)) {
            path[np - 1] = 0;
            np = np - 1;
        }

        char* content = io::read_file(path);
        if (content == (char*) 0) {
            io::eprint("ivy: error: cannot open file '");
            io::eprint(path);
            io::eprintln("'");
            __ivy_free(path);
            return 2;
        }

        uint64 len = __ivy_strlen(content);

        // H8.1: the whole frontend, with no `-I` and no `-o` (the `.ivm` goes
        // next to the source, as the H6.2aa harness expects).
        Cg cg;
        long rc = cg.compile(path, content, (long) len, (CliPath*) 0, (char*) 0);
        if (rc == 0) {
            MUnit mu = cg.unit();
            Emitter em;
            em.setup(mu);
            long erc = em.emit();
            if (erc != 0) {
                char* fname = cg.diag_file();
                io::eprint(fname);
                io::eprint(":");
                io::eprint("{}", em.err_line());
                io::eprint(":");
                io::eprint("{}", em.err_col());
                io::eprintln(": error: {}", em.err_msg());
                result = 1;
            } else {
                result = 0;
            }
            em.release();
        }
        cg.release();

        __ivy_free(content);
        __ivy_free(path);
    }
    return result;
}

int32 main() {
    long r = run();
    unsafe {
        return (int32) r;
    }
    return 0;
}
