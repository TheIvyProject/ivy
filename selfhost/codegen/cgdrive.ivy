// selfhost/codegen/cgdrive.ivy - driver for the selfhost textual LLVM IR
// emitter.  Reads a source path from stdin, runs the selfhost frontend
// (lexer -> preprocessor -> parser -> HIR -> MIR), then emits the IR text
// through Emitter.  The IR goes to host stdout and the diagnostics to host
// stderr, so the harness can compare raw bytes against `ivy --llvm`.
//
// Usage:
//   ivy.exe selfhost\\codegen\\cgdrive.ivy -I selfhost\\parsing -I selfhost\\hir -I selfhost\\mir -I selfhost\\codegen -I std -o cgdrive.exe
//   cgdrive.exe < fixture.ivy
//
// The pipeline mirrors the `--llvm` path of src/app/main.cpp: the frontend is
// identical to interpdrive.ivy; the interpreter is replaced by Emitter.
//
// H6.2aa ports the `import` part of `run()` (main.cpp:917-1301):
//
//   * pre-scan the preprocessed tokens for `import` declarations, resolve and
//     read each `.ivm`, and predeclare its struct/enum/alias names before the
//     parser runs;
//   * after parsing, merge the imported declarations into the translation unit
//     (functions appended, types deduped by name);
//   * for imported template structs, parse the module's `.ivy` source and
//     splice its method bodies into the bodyless `.ivm` methods;
//   * write the `.ivm` interface when the source is a module interface unit.
//
// The parser is held in a field of `Cg` because an Ivy struct *argument* is
// passed by value: a helper taking `Parser` would mutate a copy, so every step
// that changes the parser is a method of `Cg` (`this.pa`).

#pragma ivy cnumber
// H7.4: `diagnostic` is imported directly so the oracle's linker (which links
// the objects of the modules the main file imports, src/app/main.cpp:929-1016)
// pulls in diagnostic.obj; the lexer/preprocessor/parser reference its symbols.
import diagnostic;
import token;
import lexer;
import preprocessor;
import ast;
import parser;
import module_io;
import imports;
import cli;
import hir;
import hir_builder;
import mir;
import mir_builder;
import emitter;
import io;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);

// One ModuleUnit is 432 bytes (52 fields: 46 scalar + `ModLine` (24 bytes) +
// 5 scalar).  `sizeof` folds a struct field to 8 bytes in the oracle
// (module_io.ivy:700), so the allocation uses a literal with a little slack
// (448); the element stride used by `mods[i]` is the real one.

struct Cg {
    Parser pa;
    Imports im;

    // Destination structs whose template methods still need a body (the
    // oracle's `tplStructs` map, src/app/main.cpp:1075-1086).
    long* tpl_;
    long tpl_n_;

    // --- small string helpers ----------------------------------------------

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) { i = i + 1; }
        }
        return i;
    }

    bool seq(const char* a, const char* b) {
        unsafe {
            long i = 0;
            while (a[i] != 0 && b[i] != 0) {
                if (a[i] != b[i]) { return false; }
                i = i + 1;
            }
            return a[i] == b[i];
        }
        return false;
    }

    // Offset of the part after the last `::` (0 when the name is unqualified).
    long bare_off(const char* s) {
        unsafe {
            long n = this.slen(s);
            long i = n - 1;
            while (i >= 1) {
                if (s[i - 1] == 58 && s[i] == 58) { return i + 1; }
                i = i - 1;
            }
        }
        return 0;
    }

    bool bare_eq(const char* a, const char* b) {
        unsafe {
            long ao = this.bare_off(a);
            long bo = this.bare_off(b);
            return this.seq(a + ao, b + bo);
        }
        return false;
    }

    // `dstBare == srcBare` + same parameter count + same parameter type
    // signature (`main.cpp:1124-1151`).  The signature is base + `const` +
    // `*` per pointer level + `&` for a reference; the other type fields are
    // ignored, exactly like the oracle's `buildSig`.
    bool type_sig_eq(AType a, AType b) {
        if (!this.seq(a.base, b.base)) { return false; }
        if (a.is_const != b.is_const) { return false; }
        if (a.ptr_depth != b.ptr_depth) { return false; }
        if (a.is_ref != b.is_ref) { return false; }
        return true;
    }

    bool method_match(AFunction dst, AFunction src) {
        if (!this.bare_eq(dst.name, src.name)) { return false; }
        if (dst.nparams != src.nparams) { return false; }
        unsafe {
            long k = 0;
            while (k < dst.nparams) {
                AParam a = dst.params[k];
                AParam b = src.params[k];
                if (!this.type_sig_eq(a.type, b.type)) { return false; }
                k = k + 1;
            }
        }
        return true;
    }

    // `<name> == <sname>::<sname>` (a constructor).
    bool is_ctor(const char* name, const char* sname) {
        long sl = this.slen(sname);
        long nl = this.slen(name);
        if (nl != sl * 2 + 2) { return false; }
        unsafe {
            long k = 0;
            while (k < sl) {
                if (name[k] != sname[k]) { return false; }
                k = k + 1;
            }
            if (name[sl] != 58 || name[sl + 1] != 58) { return false; }
            k = 0;
            while (k < sl) {
                if (name[sl + 2 + k] != sname[k]) { return false; }
                k = k + 1;
            }
        }
        return true;
    }

    // --- module unit lifetime ----------------------------------------------

    long read_unit(ModuleUnit* mu, const char* path) {
        unsafe {
            mu->read_module(path);
            return mu->ok;
        }
        return 0;
    }

    void release_unit(ModuleUnit* mu) {
        unsafe {
            mu->release();
        }
    }

    // --- pre-scan: predeclare the imported type names ----------------------

    void predeclare(ModuleUnit* mu) {
        unsafe {
            long i = 0;
            while (i < mu->nstructs) {
                this.pa.register_type_name(mu->structs[i].name);
                i = i + 1;
            }
            i = 0;
            while (i < mu->nenums) {
                this.pa.register_type_name(mu->enums[i].name);
                i = i + 1;
            }
            i = 0;
            while (i < mu->nusings) {
                this.pa.register_type_name(mu->usings[i].name);
                i = i + 1;
            }
        }
    }

    // --- post-parse merge --------------------------------------------------

    long find_struct_upto(const char* name, long upto) {
        long i = 0;
        while (i < upto) {
            AStruct s = this.pa.get_struct(i);
            if (this.seq(s.name, name)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    bool has_struct(const char* name) {
        return this.find_struct_upto(name, this.pa.struct_count()) >= 0;
    }

    bool has_enum(const char* name) {
        long i = 0;
        while (i < this.pa.enum_count()) {
            AEnum e = this.pa.get_enum(i);
            if (this.seq(e.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool has_alias(const char* name) {
        long i = 0;
        while (i < this.pa.alias_count()) {
            AAlias a = this.pa.get_alias(i);
            if (this.seq(a.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool has_concept(const char* name) {
        long i = 0;
        while (i < this.pa.concept_count()) {
            AConcept c = this.pa.get_concept(i);
            if (this.seq(c.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool has_fn(const char* name) {
        long i = 0;
        while (i < this.pa.fn_count()) {
            AFunction f = this.pa.get_fn(i);
            if (this.seq(f.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    void push_params(ModParam* params, long nparams) {
        unsafe {
            long k = 0;
            while (k < nparams) {
                ModParam mp = params[k];
                AParam ap;
                ap.type = mp.type;
                ap.name = mp.name;
                ap.attrs = (AAttr*)0;
                ap.nattrs = 0;
                ap.line = 0;
                ap.col = 0;
                ap.default_value = -1;
                ap.lt_names.items = (ALifetime*)0;
                ap.lt_names.n = 0;
                ap.legacy_lts.items = (ALegacyLifetime*)0;
                ap.legacy_lts.n = 0;
                this.pa.push_param(ap);
                k = k + 1;
            }
        }
    }

    // A declaration record shared by free functions and methods: every field
    // that the `.ivm` interface does not carry is cleared.
    AFunction blank_fn(AType ret, const char* name, AParam* params,
                       long nparams, long is_extern_c) {
        AFunction f;
        unsafe {
            f.attrs = (AAttr*)0;
            f.lt_names.items = (ALifetime*)0;
            f.ret_lts.items = (ALifetime*)0;
            f.legacy_lts.items = (ALegacyLifetime*)0;
            f.tpl_params = (ATemplateParam*)0;
        }
        f.nattrs = 0;
        f.ret = ret;
        f.name = name;
        f.params = params;
        f.nparams = nparams;
        f.is_extern_c = is_extern_c;
        f.body = -1;
        f.line = 0;
        f.col = 0;
        f.is_constexpr = 0;
        f.is_consteval = 0;
        f.is_virtual = 0;
        f.tpl_n = 0;
        f.lt_names.n = 0;
        f.ret_lts.n = 0;
        f.legacy_lts.n = 0;
        f.is_variadic = 0;
        f.minit_start = 0;
        f.minit_n = 0;
        f.is_override = 0;
        f.is_pure_virtual = 0;
        return f;
    }

    void merge_unit(ModuleUnit* mu) {
        unsafe {
            long i = 0;
            while (i < mu->nfuncs) {
                ModFunc mf = mu->funcs[i];
                long pstart = this.pa.param_count();
                this.push_params(mf.params, mf.nparams);
                AFunction f = this.blank_fn(mf.ret, mf.name,
                                            this.pa.param_at(pstart),
                                            mf.nparams, mf.is_extern_c);
                f.is_constexpr = mf.is_constexpr;
                f.is_consteval = mf.is_consteval;
                this.pa.push_fn(f);
                this.pa.mark_fn_exported(this.pa.fn_count() - 1);
                i = i + 1;
            }

            i = 0;
            while (i < mu->nstructs) {
                ModStruct ms = mu->structs[i];
                if (!this.has_struct(ms.name)) {
                    AStruct s;
                    long fstart = this.pa.field_count();
                    long k = 0;
                    while (k < ms.nfields) {
                        AField fld = ms.fields[k];
                        this.pa.push_field(fld);
                        k = k + 1;
                    }
                    s.name = ms.name;
                    s.is_class = ms.is_class;
                    s.fields = this.pa.field_at(fstart);
                    s.nfields = this.pa.field_count() - fstart;

                    long mstart = this.pa.method_count();
                    k = 0;
                    while (k < ms.nmethods) {
                        ModMethod mm = ms.methods[k];
                        long pstart = this.pa.param_count();
                        this.push_params(mm.params, mm.nparams);
                        AFunction m = this.blank_fn(mm.ret, mm.name,
                                                    this.pa.param_at(pstart),
                                                    mm.nparams, 0);
                        this.pa.push_method(m);
                        k = k + 1;
                    }
                    s.methods = this.pa.method_at(mstart);
                    s.nmethods = this.pa.method_count() - mstart;

                    long bstart = this.pa.base_count();
                    k = 0;
                    while (k < ms.nbases) {
                        AType bt = ms.bases[k];
                        this.pa.push_base(bt.base);
                        k = k + 1;
                    }
                    s.bstart = bstart;
                    s.nbases = this.pa.base_count() - bstart;

                    long tstart = this.pa.tpl_count();
                    k = 0;
                    while (k < ms.ntpl) {
                        ATemplateParam tp = ms.tpl[k];
                        this.pa.push_template_param(tp);
                        k = k + 1;
                    }
                    s.tpl_params = this.pa.tpl_param_at(tstart);
                    s.tpl_n = this.pa.tpl_count() - tstart;
                    s.line = 0;
                    s.col = 0;
                    this.pa.push_struct(s);
                    this.pa.mark_struct_exported(this.pa.struct_count() - 1);
                }
                i = i + 1;
            }

            i = 0;
            while (i < mu->nenums) {
                ModEnum me = mu->enums[i];
                if (!this.has_enum(me.name)) {
                    AEnum e;
                    long estart = this.pa.enumerator_count();
                    long k = 0;
                    while (k < me.nens) {
                        AEnumerator en = me.ens[k];
                        this.pa.push_enumerator(en);
                        k = k + 1;
                    }
                    e.name = me.name;
                    e.is_scoped = me.is_scoped;
                    e.underlying = me.underlying;
                    e.enumerators = this.pa.enumerator_at(estart);
                    e.nenumerators = this.pa.enumerator_count() - estart;
                    e.line = 0;
                    e.col = 0;
                    this.pa.push_enum(e);
                    this.pa.mark_enum_exported(this.pa.enum_count() - 1);
                }
                i = i + 1;
            }

            i = 0;
            while (i < mu->nusings) {
                ModUsing mw = mu->usings[i];
                if (!this.has_alias(mw.name)) {
                    AAlias a;
                    a.name = mw.name;
                    a.target = mw.target;
                    this.pa.push_alias(a);
                }
                i = i + 1;
            }

            i = 0;
            while (i < mu->nconcepts) {
                ModConcept mc = mu->concepts[i];
                if (!this.has_concept(mc.name)) {
                    AConcept c;
                    c.name = mc.name;
                    c.param_name = mc.param_name;
                    c.req_start = this.pa.requirement_count();
                    c.nreqs = 0;
                    c.line = 0;
                    c.col = 0;
                    long k = 0;
                    while (k < mc.nreqs) {
                        this.pa.push_requirement(
                            reinterpret_cast<const char*>(mu->reqpool[mc.req_start + k]));
                        k = k + 1;
                    }
                    c.nreqs = this.pa.requirement_count() - c.req_start;
                    this.pa.push_concept(c);
                }
                i = i + 1;
            }
        }
    }

    // --- template method body splice ---------------------------------------

    bool has_bodyless_method(AStruct s) {
        unsafe {
            long j = 0;
            while (j < s.nmethods) {
                AFunction m = s.methods[j];
                if (m.body < 0) { return true; }
                j = j + 1;
            }
        }
        return false;
    }

    // Collect the destination structs that need bodies (`tplStructs`).
    void prepare_splice() {
        unsafe {
            long n = this.pa.struct_count();
            this.tpl_ = (long*)__ivy_alloc((n + 8) * 8);
            this.tpl_n_ = 0;
            long i = 0;
            while (i < n) {
                AStruct s = this.pa.get_struct(i);
                if (s.tpl_n > 0 && this.pa.struct_exported(i) != 0 &&
                    this.has_bodyless_method(s)) {
                    this.tpl_[this.tpl_n_] = i;
                    this.tpl_n_ = this.tpl_n_ + 1;
                }
                i = i + 1;
            }
        }
    }

    long find_tpl(const char* name) {
        unsafe {
            long i = 0;
            while (i < this.tpl_n_) {
                long si = this.tpl_[i];
                AStruct s = this.pa.get_struct(si);
                if (this.seq(s.name, name)) { return si; }
                i = i + 1;
            }
        }
        return -1;
    }

    // Copy the `extern "C"` declarations of the just-parsed source module into
    // the main unit.  `poff[k]` is the param-pool offset of source function
    // `main_fn + k`; the records are still readable after `end_module_source`
    // rolled the counts back.
    void splice_extern_c(long main_fn, long src_fn_end, long* poff) {
        unsafe {
            long i = main_fn;
            while (i < src_fn_end) {
                AFunction sf = this.pa.raw_fn(i);
                if (sf.is_extern_c != 0 && !this.has_fn(sf.name)) {
                    long pstart = this.pa.param_count();
                    long base = poff[i - main_fn];
                    long k = 0;
                    while (k < sf.nparams) {
                        AParam p = this.pa.raw_param(base + k);
                        this.pa.push_param(p);
                        k = k + 1;
                    }
                    AFunction d = this.blank_fn(sf.ret, sf.name,
                                                this.pa.param_at(pstart),
                                                sf.nparams, 1);
                    d.line = sf.line;
                    d.col = sf.col;
                    d.is_variadic = sf.is_variadic;
                    this.pa.push_fn(d);
                }
                i = i + 1;
            }
        }
    }

    // Parse one module source into the main parser's pools and splice its
    // method bodies.  The declaration pools are rolled back afterwards; the
    // expression / statement / member-init pools stay, so a spliced body is a
    // plain pool index (the oracle deep-clones the AST instead).
    void splice_module(char* src_path) {
        unsafe {
            char* text = io::read_file(src_path);
            if (text == (char*)0) { return; }
            long len = (long)__ivy_strlen(text);

            Lexer slx;
            slx.setup(text, len, src_path);
            slx.lex_all(len + 16);
            long in_n = slx.token_count();
            long out_cap = in_n * 8 + 256;
            Preprocessor spp;
            spp.setup(slx.tokens(), in_n, text, len, src_path,
                      (long)__ivy_strlen(src_path), out_cap, 1024);
            spp.run();

            long main_st = this.pa.struct_count();
            long main_fn = this.pa.fn_count();
            this.pa.begin_module_source(spp.output(), spp.output_count(),
                                        spp.arena());
            this.pa.set_cnumber(spp.cnumber_enabled());
            this.pa.parse();
            long src_st_end = this.pa.struct_count();
            long src_fn_end = this.pa.fn_count();

            long nsf = src_fn_end - main_fn;
            long* poff = (long*)__ivy_alloc((nsf + 8) * 8);
            long fi = main_fn;
            while (fi < src_fn_end) {
                AFunction sf = this.pa.get_fn(fi);
                poff[fi - main_fn] = this.pa.param_offset(sf.params);
                fi = fi + 1;
            }

            // Splice the method bodies of the imported template structs.
            long si = main_st;
            while (si < src_st_end) {
                AStruct src_s = this.pa.get_struct(si);
                long di = this.find_tpl(src_s.name);
                if (di >= 0) {
                    AStruct dst = this.pa.get_struct(di);
                    long mj = 0;
                    while (mj < dst.nmethods) {
                        AFunction dm = dst.methods[mj];
                        if (dm.body < 0) {
                            long sk = 0;
                            while (sk < src_s.nmethods) {
                                AFunction sm = src_s.methods[sk];
                                if (sm.body >= 0 && this.method_match(dm, sm)) {
                                    long ms = 0;
                                    long mn = 0;
                                    if (this.is_ctor(sm.name, src_s.name)) {
                                        ms = sm.minit_start;
                                        mn = sm.minit_n;
                                    }
                                    this.pa.set_method_body(di, mj, sm.body, ms, mn);
                                    sk = src_s.nmethods;
                                } else {
                                    sk = sk + 1;
                                }
                            }
                        }
                        mj = mj + 1;
                    }
                }
                si = si + 1;
            }

            long src_failed = this.pa.end_module_source();
            if (src_failed == 0) {
                this.splice_extern_c(main_fn, src_fn_end, poff);
            }
            __ivy_free(poff);
            spp.release();
            slx.release();
            __ivy_free(text);
        }
    }

    void splice_all() {
        this.prepare_splice();
        if (this.tpl_n_ > 0) {
            unsafe {
                ImportRec* r = this.im.head;
                while (r != (ImportRec*)0) {
                    char* sp = this.im.resolve_source(r->name, (CliPath*)0);
                    if (sp != (char*)0) {
                        this.splice_module(sp);
                        __ivy_free(sp);
                    }
                    r = r->next;
                }
            }
        }
        unsafe {
            __ivy_free(this.tpl_);
            this.tpl_ = (long*)0;
            this.tpl_n_ = 0;
        }
    }

    // --- module interface output -------------------------------------------

    char* parent_path(const char* p) {
        unsafe {
            long n = this.slen(p);
            long i = n - 1;
            while (i >= 0) {
                if (p[i] == 92 || p[i] == 47) { break; }
                i = i - 1;
            }
            if (i < 0) {
                char* e = (char*)__ivy_alloc(1);
                e[0] = 0;
                return e;
            }
            char* r = (char*)__ivy_alloc(i + 1);
            long k = 0;
            while (k < i) { r[k] = p[k]; k = k + 1; }
            r[i] = 0;
            return r;
        }
        unsafe { return (char*)0; }
    }

    void write_ivm(const char* path) {
        unsafe {
            char* parent = this.parent_path(path);
            char* out = this.im.join(parent, this.pa.module_name(), ".ivm");
            ModuleUnit w;
            w.from_parser(this.pa);
            bool ok = w.write(out);
            w.release();
            if (ok) {
                io::eprintln("ivy: module interface written to '{}'", out);
            } else {
                io::eprintln("ivy: warning: failed to write module interface '{}'", out);
            }
            __ivy_free(out);
            __ivy_free(parent);
        }
    }
};

long run() {
    long result = 1;
    unsafe {
        char* path = io::read_line();
        if (path == (char*) 0) {
            io::eprintln("cgdrive: no path on stdin");
            return 1;
        }
        uint64 np = __ivy_strlen(path);
        while (np > 0 && (path[np - 1] == 13 || path[np - 1] == 10)) {
            path[np - 1] = 0;
            np = np - 1;
        }

        char* content = io::read_file(path);
        if (content == (char*) 0) {
            io::eprint("ivy: error: cannot open file '");
            io::eprint(path);
            io::eprintln("'");
            __ivy_free(path);
            return 2;
        }

        uint64 len = __ivy_strlen(content);
        long cap = (long)len + 16;

        Lexer lx;
        lx.setup(content, (long)len, path);
        lx.lex_all(cap);

        char* fname = path;

        if (!lx.had_error()) {
            long in_n = lx.token_count();
            long out_cap = in_n * 8 + 256;
            Preprocessor pp;
            pp.setup(lx.tokens(), in_n, content, (long)len, path, (long)np,
                     out_cap, 1024);
            pp.run();
            long dc = pp.diag_count();
            long di = 0;
            bool pp_failed = false;
            if (pp.has_line_file() != 0) {
                fname = pp.line_file();
            }
            while (di < dc) {
                long w = pp.diag_warn(di);
                if (w == 0) {
                    pp_failed = true;
                }
                io::eprint(fname);
                io::eprint(":");
                io::eprint("{}", pp.diag_line(di));
                io::eprint(":");
                io::eprint("{}", pp.diag_col(di));
                if (w != 0) {
                    io::eprint(": warning: ");
                } else {
                    io::eprint(": error: ");
                }
                io::eprintln("{}", pp.diag_msg(di));
                di = di + 1;
            }

            if (!pp_failed) {
                Cg cg;
                cg.pa.setup(pp.output(), pp.output_count(), pp.arena(), (long)len);
                cg.pa.set_cnumber(pp.cnumber_enabled());
                cg.im.init();
                cg.im.scan(pp.output(), pp.output_count(), pp.arena(),
                           (CliPath*)0);
                if (cg.im.failed != 0) {
                    result = 1;
                } else {
                    // Pre-scan: read each `.ivm` and predeclare its type names
                    // before the parser sees the source.  The units stay alive
                    // for the whole run: merged names point into their buffers.
                    long nmod = cg.im.count;
                    ModuleUnit* mods =
                        (ModuleUnit*)__ivy_alloc((nmod + 1) * 448);
                    long nm = 0;
                    long bad = 0;
                    ImportRec* r = cg.im.head;
                    while (r != (ImportRec*)0) {
                        long ok = cg.read_unit(mods + nm, r->path);
                        if (ok == 0) {
                            bad = 1;
                            break;
                        }
                        cg.predeclare(mods + nm);
                        nm = nm + 1;
                        r = r->next;
                    }

                    if (bad == 0) {
                        cg.pa.parse();
                        if (cg.pa.failed() != 0) {
                            long nd = cg.pa.diag_count();
                            long k = 0;
                            while (k < nd) {
                                io::eprint(fname);
                                io::eprint(":");
                                io::eprint("{}", cg.pa.diag_line(k));
                                io::eprint(":");
                                io::eprint("{}", cg.pa.diag_col(k));
                                io::eprintln(": error: {}", cg.pa.diag_msg(k));
                                k = k + 1;
                            }
                        } else {
                            // Merge the imported declarations, then splice the
                            // template method bodies from the module sources.
                            long mi = 0;
                            while (mi < nm) {
                                cg.merge_unit(mods + mi);
                                mi = mi + 1;
                            }
                            cg.splice_all();

                            // A module interface unit writes its `.ivm` next
                            // to the source before HIR runs.
                            if (cg.pa.module_name()[0] != 0 &&
                                cg.pa.is_module_export() != 0) {
                                cg.write_ivm(path);
                            }

                            HirBuilder hb;
                            hb.setup(cg.pa, pp.output_count());
                            hb.build();
                            long hd = hb.diag_count();
                            long k = 0;
                            while (k < hd) {
                                result = 1;
                                io::eprint(fname);
                                io::eprint(":");
                                io::eprint("{}", hb.diag_line(k));
                                io::eprint(":");
                                io::eprint("{}", hb.diag_col(k));
                                io::eprintln(": error: {}", hb.diag_msg(k));
                                k = k + 1;
                            }
                            if (hd == 0) {
                                HUnit u = hb.unit();
                                MirBuilder mb;
                                mb.setup(u);
                                mb.build();
                                long md = mb.diag_count();
                                k = 0;
                                while (k < md) {
                                    result = 1;
                                    io::eprint(fname);
                                    io::eprint(":");
                                    io::eprint("{}", mb.diag_line(k));
                                    io::eprint(":");
                                    io::eprint("{}", mb.diag_col(k));
                                    io::eprintln(": error: {}", mb.diag_msg(k));
                                    k = k + 1;
                                }

                                if (md == 0) {
                                    MUnit mu = mb.unit();
                                    Emitter em;
                                    em.setup(mu);
                                    long rc = em.emit();
                                    if (rc != 0) {
                                        io::eprint(fname);
                                        io::eprint(":");
                                        io::eprint("{}", em.err_line());
                                        io::eprint(":");
                                        io::eprint("{}", em.err_col());
                                        io::eprintln(": error: {}", em.err_msg());
                                        result = 1;
                                    } else {
                                        result = 0;
                                    }
                                    em.release();
                                }
                                mb.release();
                            }
                            hb.release();
                        }
                    }

                    long mi = 0;
                    while (mi < nm) {
                        cg.release_unit(mods + mi);
                        mi = mi + 1;
                    }
                    __ivy_free(mods);
                }
                cg.pa.release();
            }
            pp.release();
        }
        lx.release();

        __ivy_free(content);
        __ivy_free(path);
    }
    return result;
}

int32 main() {
    long r = run();
    unsafe {
        return (int32) r;
    }
    return 0;
}
