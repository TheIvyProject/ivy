// selfhost/codegen/emitter.ivy - H6.2a..H6.2l textual LLVM IR emitter.
//
// This module is the selfhost counterpart of the textual side of
// src/codegen/codegen.cpp.  It does NOT use the LLVM C API: it writes the
// same IR text as the oracle's `ivy --llvm <file>` to stdout, byte for byte.
//
// The supported subset is deliberately small (H6.2a..H6.2l):
//   * the `; LLVM IR emitted by ivy` header;
//   * function definitions with entry-block alloca slots and `bb<i>` labels;
//   * parameters materialized in alloca slots (`%argN` -> `%<name>.<slot>`);
//   * int constants / identifiers, integer unary and binary operators,
//     integer comparisons, local declaration/assignment, integer casts;
//   * if/else, while, for, do/while and break/continue lowered to
//     condbr/br with the oracle's block numbering;
//   * user function calls (including recursion, void calls and calls used as
//     arguments), `extern "C"` calls and the MSVC name mangling of the
//     default Windows host;
//   * `extern "C"` declarations, emitted before every definition;
//   * the C entry point `@main` forwarding `@ivy_main`;
//   * string literals as `@.str.N` globals (pre-pass collection, decode and
//     LLVM escaping), including the duplicate-global quirk of the oracle;
//   * the `io::print`/`println`/`eprint`/`eprintln` builtins (format-string
//     splitting, per-type argument formatting and the six runtime declares);
//   * H6.2d: one-dimensional arrays (`int32 a[3]`), their `[N x T]` LLVM
//     type, the zero-initializer store at the declaration point, `a[i]` as
//     lvalue and rvalue, and the oracle's bounds check with its
//     panic-message globals and `@__ivy_panic` declaration;
//   * H6.2e: struct definitions (`%struct.Name = type { ... }`, unused ones
//     included, in source order), struct locals with the zeroinitializer
//     store, whole-struct copies (load/store), member access `.` as lvalue
//     and rvalue (nested members chain GEPs), and the arrow `->` lowering;
//   * H6.2f: struct parameters and return values passed by value
//     (`%struct.Point %arg0`, `define %struct.Point @...`), with the oracle's
//     MSVC mangling fallback `H` for a struct type;
//   * H6.2g: `nullptr` locals (`store ptr null`) and the arrow `p->x` form
//     on a struct pointer, including nested `p->in.a`;
//   * H6.2h: reference parameters and reference locals (`int32& r`): a
//     `ptr %argN`/`alloca ptr` slot that holds the referenced address, the
//     two-load rvalue and the one-load lvalue, call sites passing
//     `ptr <lvalue slot>`, and the oracle's `AAV` MSVC mangling;
//   * H6.2i: reference returns (`T& f()`): `define ptr`, `ret ptr` of the
//     returned lvalue's address, call sites yielding `call ptr` plus a value
//     load for rvalue use, and the raw-pointer call path for reference
//     lvalues/locals (`suppressRefLoad_`);
//   * H6.2j: floating-point scalars (`float`/`double`/`float32_t`/
//     `float64_t`): `std::to_string`-formatted literals, fadd/fsub/fmul/
//     fdiv/frem, ordered fcmp predicates, `++`/`--` via fadd 1.0,
//     sitofp/uitofp/fptosi/fpext/fptrunc casts, float parameters/returns
//     (MSVC `M`/`N` mangling), and float arguments to io::print through
//     `__ivy_fmt_float`.
//   * H6.2k: short-circuit `&&`/`||` and the conditional operator `?:`
//     (inline `bb.i<N>` blocks plus an i1/typed PHI), and the `switch`
//     statement (MIR kind 6) with its arm table and default label.
//   * H6.2l: arrays of floating-point scalars (`float64 a[3]`) and arrays of
//     structs (`Point a[2]`): the `[N x T]` element type, element member
//     chains (`a[i].x`), whole-element copies and float formatting of an
//     element; plus reference arguments to `io::print` (bug-compatible with
//     the oracle's `sext ptr` spelling).
//
// Out of scope (H6.3+): allocators, raw pointer parameters/returns,
// wide strings, variadic functions, templates/virtual dispatch, Itanium
// mangling, arrays of pointers, array/struct initializer lists,
// array parameters or return types, array decay outside `a[i]`,
// multi-dimensional arrays, `new`/`delete`, and the arrow form on an
// allocator/`(T*)` cast (the selfhost parser rejects `(T*)0` and
// `(T*)__ivy_alloc(...)`).  A construct outside the subset records a
// diagnostic and makes the driver exit nonzero instead of emitting wrong IR.
//
// The formatting mirrors CodeGen::lowerFunction/lowerBlock/lowerInst/
// lowerExpr/lowerLValue/emitCast/emitEntryPoint exactly, including the
// evaluation order that determines `%tmp.N` numbering (the unary operators
// allocate their temporary BEFORE lowering the operand, like the oracle).

#pragma ivy cnumber
export module emitter;
import ast;
import mir;
import io;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);

// A lowered expression value.  The oracle represents values as strings; the
// port keeps the shapes it actually produces in this subset:
//   kind 0 - an integer literal (printed as its decimal text);
//   kind 1 - a `%tmp.N` temporary;
//   kind 2 - an alloca slot `%<name>.<N>` used as an lvalue;
//   kind 3 - a bool literal (printed as `true`/`false`, like the oracle);
//   kind 4 - the `nullptr` literal (printed as `null`).
export struct VRef {
    long kind;
    long ival;
    long idx;
    const char* name;
    // H6.2j: the value of a floating-point literal (kind 5).  The other
    // kinds leave it 0.0.  A literal has no temporary, so emit_val prints
    // its `std::to_string` text directly.
    double fval;
};

// The emitter state.  `mu` points at a heap copy of the MIR unit: Ivy forbids
// `&mu`, so setup() copies the 25 MUnit fields into a 256-byte allocation
// (the same idiom as selfhost/mir/interpdrive.ivy).
export struct Emitter {
    MUnit* mu;
    long temp_;
    long alloca_;
    // H6.2d: the oracle's `inUnsafe_` (copied from the current instruction),
    // its `inlineBlock_` counter for `bb.i<N>` and the `declaredIvyPanic_`
    // flag that decides whether the module ends with `declare @__ivy_panic`.
    long cur_in_unsafe_;
    long ib_;
    long declared_panic_;
    long failed_;
    const char* err_;
    long err_line_;
    long err_col_;
    long cur_fi_;
    long cur_block_start_;
    long cur_block_n_;
    // H6.2k: the oracle's `curBlock_` (either "bb<local>" or "bb.i<N>") as a
    // pair, so a ternary/short-circuit PHI can name its real predecessor even
    // when a nested expression allocated inline blocks.
    long cur_blk_inline_;
    long cur_blk_idx_;
    const char* cur_ret_ty_;
    long cur_is_void_;
    // H6.2i: the current function returns a reference (`define ptr`, `ret ptr`
    // of an lvalue address) and a flag mirroring the oracle's
    // `suppressRefLoad_` for lowerCallPtr.
    long cur_ret_ref_;
    long suppress_ref_load_;
    // The variable table of the current function: a name and its slot index.
    // The arrays are heap blocks so the record stays a plain value type.
    void* vnames_;
    void* vnums_;
    // H6.2h: parallel flag array, the oracle's `varIsRef_`.  A reference
    // parameter's slot holds the address of the referenced object, so the
    // variable table must remember which slots are references.
    void* vrefs_;
    long vn_;
    long vcap_;
    // Per-call argument scratch: `arg_vals_` holds VRef records (40 bytes
    // each) and `arg_tys_` holds the final LLVM type string of every
    // argument.  `arg_sp_` is a stack pointer so a nested call used as an
    // argument does not clobber the arguments already lowered by its parent.
    void* arg_vals_;
    void* arg_tys_;
    long arg_cap_;
    long arg_sp_;
    // H6.2c: string globals.  `str_bytes_` / `str_lens_` hold the byte buffer
    // and the decoded length of every `@.str.N`, in `stringList_` order.
    // Two interning maps point into that list:
    //   * the pre-pass map is keyed by the oracle's `"1:" + bytes`;
    //   * the io segment map is keyed by the raw decoded bytes (the quirk
    //     that makes `io::print("hi")` emit both @.str.0 and @.str.1).
    long uses_io_print_;
    long dec_len_;
    long str_n_;
    long str_cap_;
    void* str_bytes_;
    void* str_lens_;
    void* pm_keys_;
    void* pm_klens_;
    void* pm_idx_;
    long pm_n_;
    long pm_cap_;
    void* sm_keys_;
    void* sm_klens_;
    void* sm_idx_;
    long sm_n_;
    long sm_cap_;

    // --- setup / teardown -------------------------------------------------

    void setup(MUnit u) {
        unsafe {
            void* raw = __ivy_alloc(320);
            MUnit* p = (MUnit*) raw;
            p->fns = u.fns;
            p->fn_n = u.fn_n;
            p->fn_cap = u.fn_cap;
            p->exprs = u.exprs;
            p->ex_n = u.ex_n;
            p->ex_cap = u.ex_cap;
            p->insts = u.insts;
            p->in_n = u.in_n;
            p->in_cap = u.in_cap;
            p->blocks = u.blocks;
            p->bl_n = u.bl_n;
            p->bl_cap = u.bl_cap;
            p->params = u.params;
            p->pa_n = u.pa_n;
            p->pa_cap = u.pa_cap;
            p->lts = u.lts;
            p->lt_n = u.lt_n;
            p->lt_cap = u.lt_cap;
            p->args = u.args;
            p->a_n = u.a_n;
            p->a_cap = u.a_cap;
            p->arm_val = u.arm_val;
            p->arm_blk = u.arm_blk;
            p->arm_n = u.arm_n;
            p->arm_cap = u.arm_cap;
            p->structs = u.structs;
            p->st_n = u.st_n;
            p->st_cap = u.st_cap;
            p->fields = u.fields;
            p->fld_n = u.fld_n;
            p->fld_cap = u.fld_cap;
            this.mu = p;
        }
        this.temp_ = 0;
        this.alloca_ = 0;
        this.cur_in_unsafe_ = 0;
        this.ib_ = 0;
        this.declared_panic_ = 0;
        this.failed_ = 0;
        this.err_ = "";
        this.err_line_ = 0;
        this.err_col_ = 0;
        this.cur_fi_ = -1;
        this.cur_block_start_ = 0;
        this.cur_block_n_ = 0;
        this.cur_ret_ty_ = "void";
        this.cur_is_void_ = 0;
        this.cur_ret_ref_ = 0;
        this.suppress_ref_load_ = 0;
        this.vn_ = 0;
        this.vcap_ = 4096;
        this.arg_cap_ = 256;
        this.arg_sp_ = 0;
        this.uses_io_print_ = 0;
        this.dec_len_ = -1;
        this.str_n_ = 0;
        this.str_cap_ = 4096;
        this.pm_n_ = 0;
        this.pm_cap_ = 4096;
        this.sm_n_ = 0;
        this.sm_cap_ = 4096;
        unsafe {
            this.vnames_ = __ivy_alloc((unsigned long long) this.vcap_ * 8);
            this.vnums_ = __ivy_alloc((unsigned long long) this.vcap_ * 8);
            this.vrefs_ = __ivy_alloc((unsigned long long) this.vcap_ * 8);
            this.arg_vals_ = __ivy_alloc((unsigned long long) this.arg_cap_ * 40);
            this.arg_tys_ = __ivy_alloc((unsigned long long) this.arg_cap_ * 8);
            this.str_bytes_ = __ivy_alloc((unsigned long long) this.str_cap_ * 8);
            this.str_lens_ = __ivy_alloc((unsigned long long) this.str_cap_ * 8);
            this.pm_keys_ = __ivy_alloc((unsigned long long) this.pm_cap_ * 8);
            this.pm_klens_ = __ivy_alloc((unsigned long long) this.pm_cap_ * 8);
            this.pm_idx_ = __ivy_alloc((unsigned long long) this.pm_cap_ * 8);
            this.sm_keys_ = __ivy_alloc((unsigned long long) this.sm_cap_ * 8);
            this.sm_klens_ = __ivy_alloc((unsigned long long) this.sm_cap_ * 8);
            this.sm_idx_ = __ivy_alloc((unsigned long long) this.sm_cap_ * 8);
        }
    }

    void release() {
        unsafe {
            __ivy_free(this.vnames_);
            __ivy_free(this.vnums_);
            __ivy_free(this.vrefs_);
            __ivy_free(this.arg_vals_);
            __ivy_free(this.arg_tys_);
            __ivy_free(this.str_bytes_);
            __ivy_free(this.str_lens_);
            __ivy_free(this.pm_keys_);
            __ivy_free(this.pm_klens_);
            __ivy_free(this.pm_idx_);
            __ivy_free(this.sm_keys_);
            __ivy_free(this.sm_klens_);
            __ivy_free(this.sm_idx_);
            __ivy_free((void*) this.mu);
        }
    }

    long has_error() { return this.failed_; }
    long err_line() { return this.err_line_; }
    long err_col() { return this.err_col_; }
    const char* err_msg() { return this.err_; }

    void fail(long line, long col, const char* msg) {
        if (this.failed_ == 0) {
            this.failed_ = 1;
            this.err_line_ = line;
            this.err_col_ = col;
            this.err_ = msg;
        }
    }

    // --- small string helpers --------------------------------------------

    bool streq(const char* a, const char* b) {
        long i = 0;
        unsafe {
            while (a[i] != 0 && b[i] != 0) {
                if (a[i] != b[i]) {
                    return false;
                }
                i = i + 1;
            }
            return a[i] == b[i];
        }
        return false;
    }

    // Writes the decimal spelling of a non-negative `v` at `buf[o..]` and
    // returns the next free offset.  Used by the `[N x T]` array type and the
    // bounds-check panic message, neither of which can go through io::print
    // because they must produce a C string.
    long put_uint(char* buf, long o, long v) {
        unsafe {
            if (v == 0) {
                buf[o] = '0';
                return o + 1;
            }
            long digits = 0;
            long x = v;
            while (x > 0) {
                digits = digits + 1;
                x = x / 10;
            }
            long end = o + digits;
            long p = end - 1;
            x = v;
            while (x > 0) {
                buf[p] = (char) ('0' + (x % 10));
                x = x / 10;
                p = p - 1;
            }
            return end;
        }
        return o;
    }

    // Builds the LLVM spelling of `T[N]`, mirroring CodeGen::llvmType's array
    // branch: `[N x T]`.  The element is the same type with array_size = 0.
    // The buffer is returned as a `long` (the pointer-cast idiom used by
    // make_prefixed_key) so the lifetime checker sees no borrowed reference.
    long make_array_type(long n, const char* elem) {
        unsafe {
            long elen = (long) __ivy_strlen(elem);
            char* buf = (char*) __ivy_alloc((unsigned long long) (elen + 48));
            long o = 0;
            buf[o] = '['; o = o + 1;
            o = this.put_uint(buf, o, n);
            buf[o] = ' '; o = o + 1;
            buf[o] = 'x'; o = o + 1;
            buf[o] = ' '; o = o + 1;
            long i = 0;
            while (i < elen) {
                buf[o] = elem[i];
                o = o + 1;
                i = i + 1;
            }
            buf[o] = ']'; o = o + 1;
            buf[o] = 0;
            return (long) buf;
        }
        return 0;
    }

    // H6.2e: `%struct.<name>` for a struct definition.  The name is owned by
    // the parser and lives as long as the unit, so the buffer is leaked like
    // the `[N x T]` array spellings.
    long make_struct_type_name(const char* name) {
        unsafe {
            long n = (long) __ivy_strlen(name);
            char* buf = (char*) __ivy_alloc((unsigned long long) (n + 9));
            const char* pre = "%struct.";
            long o = 0;
            while (pre[o] != 0) {
                buf[o] = pre[o];
                o = o + 1;
            }
            long i = 0;
            while (i < n) {
                buf[o] = name[i];
                o = o + 1;
                i = i + 1;
            }
            buf[o] = 0;
            return (long) buf;
        }
        return 0;
    }

    long find_struct(const char* name) {
        long i = 0;
        unsafe {
            while (i < this.mu->st_n) {
                if (this.streq(this.mu->structs[i].name, name)) {
                    return i;
                }
                i = i + 1;
            }
        }
        return -1;
    }

    long find_field(long si, const char* name) {
        long i = 0;
        unsafe {
            MStruct s = this.mu->structs[si];
            while (i < s.nfields) {
                if (this.streq(s.fields[i].name, name)) {
                    return i;
                }
                i = i + 1;
            }
        }
        return -1;
    }

    // A struct value (not a pointer/reference/array).  Nested struct fields
    // and struct locals both take this path.
    bool is_struct_type(AType t) {
        if (t.array_size > 0 || t.ptr_depth > 0 || t.is_ref != 0) {
            return false;
        }
        return this.find_struct(t.base) >= 0;
    }

    // Builds `index out of bounds (line <line>)` in a heap buffer.  The
    // caller frees it after the raw-bytes string table has copied the key.
    long make_panic_msg(long line) {
        unsafe {
            char* buf = (char*) __ivy_alloc(64);
            const char* pre = "index out of bounds (line ";
            long o = 0;
            long i = 0;
            while (pre[i] != 0) {
                buf[o] = pre[i];
                o = o + 1;
                i = i + 1;
            }
            o = this.put_uint(buf, o, line);
            buf[o] = ')'; o = o + 1;
            buf[o] = 0;
            return (long) buf;
        }
        return 0;
    }

    // --- H6.2c: string decoding / escaping -------------------------------

    // Mirror of readHexEscape/readOctalEscape helpers in codegen.cpp.
    bool is_hex_digit(long c) {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
               (c >= 'A' && c <= 'F');
    }

    long hex_digit_val(long c) {
        if (c <= '9') {
            return c - '0';
        }
        return (c | 32) - 'a' + 10;
    }

    char hex_char(long v) {
        unsafe {
            if (v < 10) {
                return (char) ('0' + v);
            }
            return (char) ('A' + (v - 10));
        }
        return '0';
    }

    // Mirror of CodeGen::decodeBody for a string body (without the quotes).
    // The octal branch deliberately starts at the digit that the `switch`
    // already consumed, exactly like readOctalEscape: this reproduces the
    // oracle's byte-for-byte quirk `"\101"` -> 0x01.
    long decode_body(const char* body, long n, char* out) {
        long o = 0;
        long i = 0;
        unsafe {
        while (i < n) {
            long c = ((long) body[i]) & 255;
            if (c != '\\') {
                out[o] = body[i];
                o = o + 1;
                i = i + 1;
                continue;
            }
            i = i + 1;
            if (i >= n) {
                this.fail(0, 0, "literal ends inside an escape sequence");
                return -1;
            }
            long e = ((long) body[i]) & 255;
            if (e == 'n') { out[o] = 10; o = o + 1; }
            else if (e == 't') { out[o] = 9; o = o + 1; }
            else if (e == 'r') { out[o] = 13; o = o + 1; }
            else if (e == 'a') { out[o] = 7; o = o + 1; }
            else if (e == 'b') { out[o] = 8; o = o + 1; }
            else if (e == 'f') { out[o] = 12; o = o + 1; }
            else if (e == 'v') { out[o] = 11; o = o + 1; }
            else if (e == '\\') { out[o] = '\\'; o = o + 1; }
            else if (e == '\'') { out[o] = '\''; o = o + 1; }
            else if (e == '"') { out[o] = '"'; o = o + 1; }
            else if (e == '?') { out[o] = '?'; o = o + 1; }
            else if (e == 'x') {
                long v = 0;
                long cnt = 0;
                while (i + 1 < n && cnt < 2 &&
                       this.is_hex_digit(((long) body[i + 1]) & 255)) {
                    i = i + 1;
                    v = v * 16 + this.hex_digit_val(((long) body[i]) & 255);
                    cnt = cnt + 1;
                }
                if (cnt == 0) {
                    this.fail(0, 0, "invalid \\x escape in literal");
                    return -1;
                }
                out[o] = (char) (v & 255);
                o = o + 1;
            }
            else if (e >= '0' && e <= '7') {
                long v = 0;
                long cnt = 0;
                while (i + 1 < n && cnt < 3 &&
                       ((long) body[i + 1]) >= '0' &&
                       ((long) body[i + 1]) <= '7') {
                    i = i + 1;
                    v = v * 8 + (((long) body[i]) - '0');
                    cnt = cnt + 1;
                }
                out[o] = (char) (v & 255);
                o = o + 1;
            }
            else {
                this.fail(0, 0, "unknown escape sequence in literal");
                return -1;
            }
            i = i + 1;
        }
        out[o] = 0;
        }
        return o;
    }

    // Mirror of CodeGen::decodeStringTyped restricted to width 1.  Returns a
    // heap buffer (NUL-terminated) and stores its decoded length in
    // `dec_len_`; returns 0 after recording a diagnostic on failure.  Wide
    // prefixes (`L`, `u`, `U`) are rejected as out of scope for H6.2c;
    // `u8` is accepted because it has width 1.
    long decode_string(const char* raw) {
        this.dec_len_ = -1;
        unsafe {
        long n = (long) __ivy_strlen(raw);
        long off = 0;
        if (n >= 2 && raw[0] == 'u' && raw[1] == '8') {
            off = 2;
        } else if (n >= 1 && (raw[0] == 'L' || raw[0] == 'u' ||
                              raw[0] == 'U')) {
            this.fail(0, 0, "wide string literals are out of scope for H6.2c");
            return 0;
        }
        if (n - off >= 3 && raw[off] == 'R' && raw[off + 1] == '"') {
            long open = -1;
            long i = off + 2;
            while (i < n) {
                if (raw[i] == '(') {
                    open = i;
                    break;
                }
                i = i + 1;
            }
            long close = -1;
            i = n - 1;
            while (i >= off) {
                if (raw[i] == ')') {
                    close = i;
                    break;
                }
                i = i - 1;
            }
            if (open < 0 || close < 0 || close + 1 >= n ||
                raw[n - 1] != '"') {
                this.fail(0, 0, "malformed raw string literal");
                return 0;
            }
            long len = close - open - 1;
            char* out = (char*) __ivy_alloc((unsigned long long) (len + 1));
            i = 0;
            while (i < len) {
                out[i] = raw[open + 1 + i];
                i = i + 1;
            }
            out[len] = 0;
            this.dec_len_ = len;
            return (long) out;
        }
        if (n - off < 2 || raw[off] != '"' || raw[n - 1] != '"') {
            this.fail(0, 0, "malformed string literal");
            return 0;
        }
        long bodylen = (n - off) - 2;
        char* out = (char*) __ivy_alloc((unsigned long long) (bodylen + 1));
        long bl = this.decode_body(raw + off + 1, bodylen, out);
        if (bl < 0) {
            return 0;
        }
        this.dec_len_ = bl;
        return (long) out;
        }
        return 0;
    }

    // Mirror of CodeGen::decodeChar: strips an L/u/U prefix, decodes the body
    // and returns its first byte as an unsigned value (-1 on failure).
    long decode_char_value(const char* raw) {
        unsafe {
        long n = (long) __ivy_strlen(raw);
        long off = 0;
        if (n >= 1 && (raw[0] == 'L' || raw[0] == 'u' || raw[0] == 'U')) {
            off = 1;
        }
        if (n - off < 2 || raw[off] != '\'' || raw[n - 1] != '\'') {
            this.fail(0, 0, "malformed character literal");
            return -1;
        }
        long bodylen = (n - off) - 2;
        char* out = (char*) __ivy_alloc((unsigned long long) (bodylen + 1));
        long bl = this.decode_body(raw + off + 1, bodylen, out);
        if (bl < 0) {
            return -1;
        }
        if (bl == 0) {
            this.fail(0, 0, "empty character literal");
            return -1;
        }
        long v = ((long) out[0]) & 255;
        __ivy_free(out);
        return v;
        }
        return -1;
    }

    // --- H6.2c: string global tables --------------------------------------

    long make_prefixed_key(const char* bytes, long n) {
        unsafe {
            char* k = (char*) __ivy_alloc((unsigned long long) (n + 3));
            k[0] = '1';
            k[1] = ':';
            long i = 0;
            while (i < n) {
                k[2 + i] = bytes[i];
                i = i + 1;
            }
            k[n + 2] = 0;
            return (long) k;
        }
        return 0;
    }

    long map_get(void* keys, void* klens, void* idxs, long n,
                 const char* key, long klen) {
        long i = 0;
        unsafe {
            long* ka = (long*) keys;
            long* la = (long*) klens;
            long* ia = (long*) idxs;
            while (i < n) {
                if (la[i] == klen) {
                    const char* s = reinterpret_cast<const char*>(ka[i]);
                    long j = 0;
                    bool eq = true;
                    while (j < klen) {
                        if (s[j] != key[j]) {
                            eq = false;
                            break;
                        }
                        j = j + 1;
                    }
                    if (eq) {
                        return ia[i];
                    }
                }
                i = i + 1;
            }
        }
        return -1;
    }

    long map_add(void* keys, void* klens, void* idxs, long n, long cap,
                 long key, long klen, long gi) {
        if (n >= cap) {
            this.fail(0, 0, "too many string literals for H6.2c");
            return n;
        }
        unsafe {
            long* ka = (long*) keys;
            long* la = (long*) klens;
            long* ia = (long*) idxs;
            ka[n] = key;
            la[n] = klen;
            ia[n] = gi;
        }
        return n + 1;
    }

    long add_string(const char* bytes, long len) {
        if (this.str_n_ >= this.str_cap_) {
            this.fail(0, 0, "too many string literals for H6.2c");
            return 0;
        }
        unsafe {
            long* bp = (long*) this.str_bytes_;
            long* lp = (long*) this.str_lens_;
            bp[this.str_n_] = (long) bytes;
            lp[this.str_n_] = len;
        }
        long gi = this.str_n_;
        this.str_n_ = this.str_n_ + 1;
        return gi;
    }

    // Pre-pass interning: key `"1:" + bytes`.
    long intern_prepass(const char* raw, long line, long col) {
        unsafe {
            long p = this.decode_string(raw);
            if (p == 0) {
                if (this.failed_ == 0) {
                    this.fail(line, col, "malformed string literal");
                }
                return -1;
            }
            long bl = this.dec_len_;
            long key = this.make_prefixed_key((char*) p, bl);
            long gi = this.map_get(this.pm_keys_, this.pm_klens_, this.pm_idx_,
                                   this.pm_n_, (char*) key, bl + 2);
            if (gi >= 0) {
                return gi;
            }
            gi = this.add_string((char*) p, bl);
            this.pm_n_ = this.map_add(this.pm_keys_, this.pm_klens_,
                                      this.pm_idx_, this.pm_n_, this.pm_cap_,
                                      key, bl + 2, gi);
            return gi;
        }
        return -1;
    }

    // io format-segment interning: key is the raw decoded byte string (no
    // `"1:"` prefix), which is why it never collides with the pre-pass map.
    long intern_segment(const char* bytes, long len) {
        unsafe {
            long gi = this.map_get(this.sm_keys_, this.sm_klens_, this.sm_idx_,
                                   this.sm_n_, bytes, len);
            if (gi >= 0) {
                return gi;
            }
            char* cp = (char*) __ivy_alloc((unsigned long long) (len + 1));
            long i = 0;
            while (i < len) {
                cp[i] = bytes[i];
                i = i + 1;
            }
            cp[len] = 0;
            gi = this.add_string(cp, len);
            this.sm_n_ = this.map_add(this.sm_keys_, this.sm_klens_,
                                      this.sm_idx_, this.sm_n_, this.sm_cap_,
                                      (long) cp, len, gi);
            return gi;
        }
        return -1;
    }

    VRef emit_string_gep(long gi) {
        VRef t = this.new_temp();
        this.emit_val(t);
        this.ps(" = getelementptr i8, ptr @.str.");
        io::print("{}", gi);
        this.ps(", i64 0");
        this.nl();
        return t;
    }

    // Mirror of CodeGen::emitBoundsCheck.  `idx` is the already-lowered index
    // value and `idx_ty` its LLVM type; `n` is the array length.  The GEP
    // temporary is NOT allocated here: the caller allocates it before this
    // call and emits the GEP after the ok-block label.
    //
    // The oracle allocates `idx64` unconditionally, even when the index is
    // already i64 (where it is never emitted).  That leaves a gap in the
    // `%tmp.N` numbering and is reproduced here on purpose.
    void emit_bounds_check(VRef idx, const char* idx_ty, long n,
                           long line, long col) {
        if (this.cur_in_unsafe_ != 0) {
            return;
        }
        this.declared_panic_ = 1;
        VRef idx64 = this.new_temp();
        VRef oob = this.new_temp();
        if (!this.streq(idx_ty, "i64")) {
            this.emit_val(idx64);
            this.ps(" = sext ");
            this.ps(idx_ty);
            this.ps(" ");
            this.emit_val(idx);
            this.ps(" to i64");
            this.nl();
        }
        this.emit_val(oob);
        this.ps(" = icmp uge i64 ");
        if (this.streq(idx_ty, "i64")) {
            this.emit_val(idx);
        } else {
            this.emit_val(idx64);
        }
        this.ps(", ");
        io::print("{}", n);
        this.nl();

        long panic_b = this.ib_;
        this.ib_ = this.ib_ + 1;
        long ok_b = this.ib_;
        this.ib_ = this.ib_ + 1;
        this.ps("br i1 ");
        this.emit_val(oob);
        this.ps(", label %bb.i");
        io::print("{}", panic_b);
        this.ps(", label %bb.i");
        io::print("{}", ok_b);
        this.nl();

        io::print("bb.i{}:", panic_b);
        this.nl();
        this.cur_blk_inline_ = 1;
        this.cur_blk_idx_ = panic_b;
        // The message goes through the raw-bytes map (the io-segment map), so
        // identical messages dedup across functions and io segments.
        long mp = this.make_panic_msg(line);
        unsafe {
            const char* mb = reinterpret_cast<const char*>(mp);
            long mlen = (long) __ivy_strlen(mb);
            long gi = this.intern_segment(mb, mlen);
            __ivy_free((void*) mp);
            VRef msg = this.new_temp();
            this.emit_val(msg);
            this.ps(" = getelementptr i8, ptr @.str.");
            io::print("{}", gi);
            this.ps(", i64 0");
            this.nl();
            this.ps("call void @__ivy_panic(ptr ");
            this.emit_val(msg);
            this.ps(", i32 ");
            io::print("{}", line);
            this.ps(")");
            this.nl();
        }
        this.pl("unreachable");

        io::print("bb.i{}:", ok_b);
        this.nl();
        this.cur_blk_inline_ = 1;
        this.cur_blk_idx_ = ok_b;
    }

    // Mirror of CodeGen::llvmEscape: printable ASCII except `"` and `\`
    // stays verbatim, every other byte becomes `\XX` (uppercase hex).
    void emit_escaped(const char* bytes, long n) {
        unsafe {
            char* out = (char*) __ivy_alloc(
                (unsigned long long) (n * 4 + 1));
            long o = 0;
            long i = 0;
            while (i < n) {
                long c = ((long) bytes[i]) & 255;
                if (c >= 32 && c <= 126 && c != '"' && c != '\\') {
                    out[o] = (char) c;
                    o = o + 1;
                } else {
                    out[o] = '\\';
                    o = o + 1;
                    out[o] = this.hex_char(c >> 4);
                    o = o + 1;
                    out[o] = this.hex_char(c & 15);
                    o = o + 1;
                }
                i = i + 1;
            }
            out[o] = 0;
            io::print("{}", out);
            __ivy_free(out);
        }
    }

    // Mirror of CodeGen::emitStringConstants: every entry in collection order,
    // `[len+1 x i8]` with the NUL terminator appended as `\00`.
    void emit_string_constants() {
        long i = 0;
        unsafe {
            while (i < this.str_n_) {
                long* ba = (long*) this.str_bytes_;
                long* la = (long*) this.str_lens_;
                long bp = ba[i];
                long bl = la[i];
                const char* bytes = reinterpret_cast<const char*>(bp);
                io::print("@.str.{} = private unnamed_addr constant [{} x i8] c\"",
                          i, bl + 1);
                this.emit_escaped(bytes, bl);
                this.ps("\\00\"");
                this.nl();
                i = i + 1;
            }
        }
    }

    // --- variable table ---------------------------------------------------

    void clear_vars() {
        this.vn_ = 0;
    }

    void add_var(const char* name, long slot, long is_ref) {
        if (this.vn_ >= this.vcap_) {
            this.fail(0, 0, "too many variables for the H6.2a variable table");
            return;
        }
        unsafe {
            // Ivy's `const char**` indexing is unreliable, so the table keeps
            // interned pointers in a `long*` pool (the same idiom as
            // Parser::tnames_).
            long* names = (long*) this.vnames_;
            long* nums = (long*) this.vnums_;
            long* refs = (long*) this.vrefs_;
            names[this.vn_] = (long) name;
            nums[this.vn_] = slot;
            refs[this.vn_] = is_ref;
        }
        this.vn_ = this.vn_ + 1;
    }

    long find_var(const char* name) {
        long i = this.vn_ - 1;
        unsafe {
            long* names = (long*) this.vnames_;
            long* nums = (long*) this.vnums_;
            while (i >= 0) {
                const char* nm = reinterpret_cast<const char*>(names[i]);
                if (this.streq(nm, name)) {
                    return nums[i];
                }
                i = i - 1;
            }
        }
        return -1;
    }

    // H6.2h: mirror of the oracle's `varIsRef_` lookup.  Returns 1 when the
    // variable's alloca holds an address (reference parameter).
    long is_ref_var(const char* name) {
        long i = this.vn_ - 1;
        unsafe {
            long* names = (long*) this.vnames_;
            long* refs = (long*) this.vrefs_;
            while (i >= 0) {
                const char* nm = reinterpret_cast<const char*>(names[i]);
                if (this.streq(nm, name)) {
                    return refs[i];
                }
                i = i - 1;
            }
        }
        return 0;
    }

    // --- types ------------------------------------------------------------

    // True for the base names that denote an integer scalar.  H6.2d arrays
    // are restricted to these elements: a struct/pointer/float element (or an
    // unknown name, which llvm_type would otherwise spell `i8`) is rejected.
    bool is_int_base_name(const char* b) {
        return this.streq(b, "bool") || this.streq(b, "char") ||
               this.streq(b, "short") || this.streq(b, "int") ||
               this.streq(b, "long") || this.streq(b, "long long") ||
               this.streq(b, "int8_t") || this.streq(b, "int8") ||
               this.streq(b, "int16_t") || this.streq(b, "int16") ||
               this.streq(b, "int32_t") || this.streq(b, "int32") ||
               this.streq(b, "int64_t") || this.streq(b, "int64") ||
               this.streq(b, "int128_t") || this.streq(b, "int128") ||
               this.streq(b, "uint8_t") || this.streq(b, "uint8") ||
               this.streq(b, "uint16_t") || this.streq(b, "uint16") ||
               this.streq(b, "uint32_t") || this.streq(b, "uint32") ||
               this.streq(b, "uint64_t") || this.streq(b, "uint64") ||
               this.streq(b, "uint128_t") || this.streq(b, "uint128") ||
               this.streq(b, "size_t") || this.streq(b, "ptrdiff_t") ||
               this.streq(b, "uptr_t");
    }

    const char* llvm_type(AType t, long drop_ref) {
        // H6.2d: array type T[N] -> `[N x T]` (CodeGen::llvmType's first
        // branch).  H6.2l: a one-dimensional array may hold an integer
        // scalar, a floating-point scalar or a struct value; the parser
        // already rejects a second `[N]` suffix and raw pointer arrays.
        if (t.array_size > 0) {
            AType elem = t;
            elem.array_size = 0;
            if (elem.ptr_depth > 0 || elem.is_ref != 0) {
                this.fail(0, 0, "arrays of pointers are out of scope for H6.2d");
                return "i8";
            }
            AType ev = elem;
            ev.is_ref = 0;
            long elem_ok = 0;
            if (this.is_int_base_name(elem.base)) {
                elem_ok = 1;
            }
            if (this.is_float_base(elem.base)) {
                elem_ok = 1;
            }
            if (this.is_struct_type(ev)) {
                elem_ok = 1;
            }
            if (elem_ok == 0) {
                this.fail(0, 0, "array element type is out of scope for H6.2d");
                return "i8";
            }
            long ap = this.make_array_type(t.array_size,
                                           this.llvm_type(elem, 0));
            unsafe {
                return reinterpret_cast<const char*>(ap);
            }
            return "i8";
        }
        if (t.ptr_depth > 0 || (t.is_ref != 0 && drop_ref == 0)) {
            return "ptr";
        }
        // H6.2e: a struct value is `%struct.<name>`.  Struct pointers were
        // handled above as `ptr`.
        // H6.2i: when drop_ref asks for the referent value type, a struct
        // reference (`Point&`) denotes `%struct.Point`, so look the struct
        // up with the reference cleared (is_struct_type rejects is_ref).
        AType sv = t;
        sv.is_ref = 0;
        if (this.is_struct_type(sv)) {
            long sp = this.make_struct_type_name(sv.base);
            unsafe {
                return reinterpret_cast<const char*>(sp);
            }
            return "i8";
        }
        if (this.streq(t.base, "void")) return "void";
        if (this.streq(t.base, "bool")) return "i1";
        if (this.streq(t.base, "char")) return "i8";
        if (this.streq(t.base, "short")) return "i16";
        if (this.streq(t.base, "int")) return "i32";
        if (this.streq(t.base, "long") || this.streq(t.base, "long long")) return "i64";
        if (this.streq(t.base, "float")) return "float";
        if (this.streq(t.base, "double") || this.streq(t.base, "long double")) return "double";
        if (this.streq(t.base, "int8_t") || this.streq(t.base, "int8")) return "i8";
        if (this.streq(t.base, "int16_t") || this.streq(t.base, "int16")) return "i16";
        if (this.streq(t.base, "int32_t") || this.streq(t.base, "int32")) return "i32";
        if (this.streq(t.base, "int64_t") || this.streq(t.base, "int64")) return "i64";
        if (this.streq(t.base, "int128_t") || this.streq(t.base, "int128")) return "i128";
        if (this.streq(t.base, "uint8_t") || this.streq(t.base, "uint8")) return "i8";
        if (this.streq(t.base, "uint16_t") || this.streq(t.base, "uint16")) return "i16";
        if (this.streq(t.base, "uint32_t") || this.streq(t.base, "uint32")) return "i32";
        if (this.streq(t.base, "uint64_t") || this.streq(t.base, "uint64")) return "i64";
        if (this.streq(t.base, "uint128_t") || this.streq(t.base, "uint128")) return "i128";
        if (this.streq(t.base, "float16_t") || this.streq(t.base, "float16")) return "half";
        if (this.streq(t.base, "float32_t") || this.streq(t.base, "float32")) return "float";
        if (this.streq(t.base, "float64_t") || this.streq(t.base, "float64")) return "double";
        if (this.streq(t.base, "float128_t") || this.streq(t.base, "float128")) return "fp128";
        if (this.streq(t.base, "bfloat16_t") || this.streq(t.base, "bfloat16")) return "bfloat";
        if (this.streq(t.base, "size_t")) return "i64";
        if (this.streq(t.base, "ptrdiff_t")) return "i64";
        if (this.streq(t.base, "uptr_t")) return "i64";
        if (this.streq(t.base, "nullptr_t") || this.streq(t.base, "nullptr")) return "ptr";
        if (this.streq(t.base, "max_align_t")) return "i8";
        return "i8";
    }

    // Returns the bit width of an integer LLVM type ("i8" -> 8, "ptr" -> 64),
    // or -1 when the type is not an integer (mirror of the oracle's intBits).
    long int_bits(const char* s) {
        if (this.streq(s, "ptr")) return 64;
        if (this.streq(s, "i1") || this.streq(s, "bool")) return 1;
        if (this.streq(s, "i8") || this.streq(s, "char") ||
            this.streq(s, "int8_t") || this.streq(s, "uint8_t")) return 8;
        if (this.streq(s, "i16") || this.streq(s, "short") ||
            this.streq(s, "int16_t") || this.streq(s, "uint16_t")) return 16;
        if (this.streq(s, "i32") || this.streq(s, "int") ||
            this.streq(s, "int32_t") || this.streq(s, "uint32_t")) return 32;
        if (this.streq(s, "i64") || this.streq(s, "long") ||
            this.streq(s, "long long") || this.streq(s, "int64_t") ||
            this.streq(s, "uint64_t") || this.streq(s, "size_t") ||
            this.streq(s, "ptrdiff_t")) return 64;
        if (this.streq(s, "i128") || this.streq(s, "int128_t") ||
            this.streq(s, "uint128_t")) return 128;
        return -1;
    }

    // --- output primitives ------------------------------------------------

    void ps(const char* s) {
        io::print("{}", s);
    }

    void pl(const char* s) {
        io::print("{}", s);
        io::print("\n");
    }

    void nl() {
        io::print("\n");
    }

    void emit_slot(const char* name, long slot) {
        long first = 0;
        unsafe {
            first = (long) name[0];
        }
        io::print("%");
        if (first == 0) {
            io::print("arg");
        } else {
            io::print("{}", name);
        }
        io::print(".{}", slot);
    }

    void emit_bb(long global) {
        io::print("%bb{}", global - this.cur_block_start_);
    }

    // H6.2k: the block reference of the oracle's `curBlock_` state.  A
    // function block prints `%bb<local>`; an inline block `%bb.i<N>`.
    void emit_blk_ref(long is_inline, long idx) {
        if (is_inline != 0) {
            io::print("%bb.i{}", idx);
        } else {
            io::print("%bb{}", idx);
        }
    }

    void emit_inline_label(long idx) {
        io::print("bb.i{}:", idx);
        this.nl();
    }

    VRef imm(long v) {
        VRef r;
        r.fval = 0.0;
        r.kind = 0;
        r.ival = v;
        r.idx = 0;
        r.name = "";
        return r;
    }

    // H6.2g: the `nullptr` literal.  The oracle lowers NullptrLit to the
    // string "null" and emitCast keeps it when the target is `ptr`.
    VRef null_ref() {
        VRef r;
        r.fval = 0.0;
        r.kind = 4;
        r.ival = 0;
        r.idx = 0;
        r.name = "";
        return r;
    }

    VRef new_temp() {
        VRef r;
        r.fval = 0.0;
        r.kind = 1;
        r.ival = 0;
        r.idx = this.temp_;
        r.name = "";
        this.temp_ = this.temp_ + 1;
        return r;
    }

    VRef slot_ref(const char* name, long slot) {
        VRef r;
        r.fval = 0.0;
        r.kind = 2;
        r.ival = 0;
        r.idx = slot;
        r.name = name;
        return r;
    }

    VRef bool_ref(long v) {
        VRef r;
        r.fval = 0.0;
        r.kind = 3;
        r.ival = v;
        r.idx = 0;
        r.name = "";
        return r;
    }

    // H6.2j: a floating-point literal.  The oracle lowers FloatLit with
    // std::to_string(value), i.e. printf("%f"): fixed notation with exactly
    // six fractional digits.
    VRef float_lit(double v) {
        VRef r;
        r.kind = 5;
        r.ival = 0;
        r.idx = 0;
        r.name = "";
        r.fval = v;
        return r;
    }

    // Print std::to_string(v) for the literal subset.  The integer part is
    // taken first (it fits i64 up to 2^63) and only the fractional part is
    // scaled by 1e6, so ordinary large literals do not overflow the scaled
    // value.  Anything at or above 2^63 would need big-integer formatting
    // and is rejected explicitly instead of emitting wrong IR.
    void emit_double_lit(double v) {
        if (v < 0.0) {
            this.ps("-");
            v = -v;
        }
        if (v >= 9223372036854775808.0) {
            this.fail(0, 0, "large floating-point literals are out of scope for H6.2j");
            return;
        }
        long ip = 0;
        long frac = 0;
        unsafe {
            ip = (long) v;
            frac = (long) ((v - (double) ip) * 1000000.0 + 0.5);
        }
        if (frac >= 1000000) {
            ip = ip + 1;
            frac = frac - 1000000;
        }
        io::print("{}", ip);
        this.ps(".");
        long div = 100000;
        while (div > 0) {
            long d = frac / div;
            io::print("{}", d);
            frac = frac - d * div;
            div = div / 10;
        }
    }

    void emit_val(VRef v) {
        if (v.kind == 0) {
            io::print("{}", v.ival);
        } else if (v.kind == 1) {
            io::print("%tmp.{}", v.idx);
        } else if (v.kind == 3) {
            if (v.ival != 0) {
                this.ps("true");
            } else {
                this.ps("false");
            }
        } else if (v.kind == 4) {
            this.ps("null");
        } else if (v.kind == 5) {
            this.emit_double_lit(v.fval);
        } else {
            this.emit_slot(v.name, v.idx);
        }
    }

    // --- function lookup / mangling --------------------------------------

    // The MIR function with `name`, or -1.  The oracle first matches by
    // signature, but overloads are out of scope and the frontend rejects a
    // prototype followed by a definition, so the name alone is unambiguous
    // in this subset.
    long find_fn(const char* name) {
        long i = 0;
        unsafe {
            while (i < this.mu->fn_n) {
                MFunction f = this.mu->fns[i];
                if (this.streq(f.name, name)) {
                    return i;
                }
                i = i + 1;
            }
        }
        return -1;
    }

    bool is_float_base(const char* b) {
        return this.streq(b, "float") || this.streq(b, "double") ||
               this.streq(b, "long double") ||
               this.streq(b, "float16") || this.streq(b, "float16_t") ||
               this.streq(b, "float32") || this.streq(b, "float32_t") ||
               this.streq(b, "float64") || this.streq(b, "float64_t") ||
               this.streq(b, "float128") || this.streq(b, "float128_t") ||
               this.streq(b, "bfloat16") || this.streq(b, "bfloat16_t");
    }

    // H6.2j: mirror of the oracle's isFpType, which classifies the LLVM
    // spelling of a floating-point type (CodeGen::emitCast).
    bool is_fp_ir(const char* s) {
        return this.streq(s, "half") || this.streq(s, "bfloat") ||
               this.streq(s, "float") || this.streq(s, "double") ||
               this.streq(s, "fp128") || this.streq(s, "x86_fp80");
    }

    // Reject the types whose LLVM/MSVC spelling is out of the H6.2 subset.
    // Called for every declaration and definition, so an extern "C" symbol
    // (which is not mangled) is diagnosed too instead of silently emitting
    // IR for pointers or arrays.
    bool check_fn_signature(MFunction f, long line, long col) {
        if (f.ret.array_size > 0) {
            this.fail(line, col, "array return types are out of scope for H6.2b");
            return false;
        }
        if (f.ret.ptr_depth > 0) {
            this.fail(line, col, "pointer return types are out of scope for H6.2i");
            return false;
        }
        long j = 0;
        while (j < f.pn) {
            MParam p;
            unsafe {
                p = this.mu->params[f.pstart + j];
            }
            if (p.type.array_size > 0) {
                this.fail(line, col, "array parameters are out of scope for H6.2b");
                return false;
            }
            if (p.type.ptr_depth > 0) {
                this.fail(line, col, "pointer parameters are out of scope for H6.2h");
                return false;
            }
            j = j + 1;
        }
        return true;
    }

    // Mirror of CodeGen::msvcMangleType for the scalar subset.  The codes
    // were verified against the frozen oracle (P0):
    //   bool _N  char D  short F/G  int H/I  long J/K  long long _J/_K
    //   int8_t C  uint8_t E  int16_t F  uint16_t G  int32_t H  uint32_t I
    //   int64_t _J  uint64_t _K  size_t _K  ptrdiff_t J  uptr_t _K
    //   void ?A (a void *return* is spelled X by msvcMangleFunction).
    void emit_mangle_type(AType t, long line, long col) {
        if (t.array_size > 0) {
            this.fail(line, col, "array type mangling is out of scope for H6.2b");
            return;
        }
        // H6.2h: the oracle's msvcMangleType maps every pointer/reference to
        // the same placeholder ("AAV" for a reference, "PAV" otherwise).
        if (t.is_ref != 0) { this.ps("AAV"); return; }
        if (t.ptr_depth > 0) { this.ps("PAV"); return; }
        if (this.streq(t.base, "void")) { this.ps("?A"); return; }
        if (this.streq(t.base, "bool")) { this.ps("_N"); return; }
        if (this.streq(t.base, "char")) { this.ps("D"); return; }
        if (this.streq(t.base, "short")) { this.ps(t.is_unsigned != 0 ? "G" : "F"); return; }
        if (this.streq(t.base, "int")) { this.ps(t.is_unsigned != 0 ? "I" : "H"); return; }
        if (this.streq(t.base, "long")) { this.ps(t.is_unsigned != 0 ? "K" : "J"); return; }
        if (this.streq(t.base, "long long")) { this.ps(t.is_unsigned != 0 ? "_K" : "_J"); return; }
        // H6.2j: MSVC floating-point codes (CodeGen::msvcMangleType).
        if (this.streq(t.base, "float")) { this.ps("M"); return; }
        if (this.streq(t.base, "double") || this.streq(t.base, "long double")) { this.ps("N"); return; }
        if (this.streq(t.base, "int8_t")) { this.ps("C"); return; }
        if (this.streq(t.base, "uint8_t")) { this.ps("E"); return; }
        if (this.streq(t.base, "int16_t")) { this.ps("F"); return; }
        if (this.streq(t.base, "uint16_t")) { this.ps("G"); return; }
        if (this.streq(t.base, "int32_t")) { this.ps("H"); return; }
        if (this.streq(t.base, "uint32_t")) { this.ps("I"); return; }
        if (this.streq(t.base, "int64_t")) { this.ps("_J"); return; }
        if (this.streq(t.base, "uint64_t")) { this.ps("_K"); return; }
        if (this.streq(t.base, "int128_t") || this.streq(t.base, "uint128_t")) { this.ps("_J"); return; }
        if (this.streq(t.base, "size_t")) { this.ps("_K"); return; }
        if (this.streq(t.base, "ptrdiff_t")) { this.ps("J"); return; }
        if (this.streq(t.base, "uptr_t")) { this.ps("_K"); return; }
        if (this.streq(t.base, "float16_t") || this.streq(t.base, "float16")) { this.ps("M"); return; }
        if (this.streq(t.base, "float32_t") || this.streq(t.base, "float32")) { this.ps("M"); return; }
        if (this.streq(t.base, "float64_t") || this.streq(t.base, "float64")) { this.ps("N"); return; }
        if (this.streq(t.base, "float128_t") || this.streq(t.base, "float128")) { this.ps("N"); return; }
        if (this.streq(t.base, "bfloat16_t") || this.streq(t.base, "bfloat16")) { this.ps("M"); return; }
        if (this.streq(t.base, "max_align_t")) { this.ps("PEAV"); return; }
        // H6.2f: the oracle's msvcMangleType falls back to "H" (int) for a
        // type it does not know, and a struct by value takes that path.
        if (this.is_struct_type(t)) { this.ps("H"); return; }
        this.fail(line, col, "type mangling is out of scope for H6.2b");
    }

    // Mirror of CodeGen::msvcMangleFunction for a global, non-extern "C"
    // function: ?<name>@@Y<ret><params>@Z (no class/namespace scope).  The
    // symbol is always quoted because '?' and '@' are not bare LLVM
    // identifier characters (CodeGen::llvmGlobalName).
    void emit_mangled_name(const char* name, long fi, long line, long col) {
        long i = 0;
        bool scoped = false;
        unsafe {
            while (name[i] != 0) {
                if (name[i] == ':' && name[i + 1] == ':') {
                    scoped = true;
                    break;
                }
                i = i + 1;
            }
        }
        if (scoped) {
            this.fail(line, col, "namespace-qualified function names are out of scope for H6.2b");
            return;
        }
        MFunction f;
        unsafe {
            f = this.mu->fns[fi];
        }
        if (!this.check_fn_signature(f, line, col)) {
            return;
        }
        this.ps("\"?");
        this.ps(name);
        this.ps("@@Y");
        if (this.streq(f.ret.base, "void")) {
            this.ps("X");
        } else {
            this.emit_mangle_type(f.ret, line, col);
        }
        if (f.pn == 0) {
            this.ps("X");
        } else {
            long j = 0;
            while (j < f.pn) {
                MParam p;
                unsafe {
                    p = this.mu->params[f.pstart + j];
                }
                this.emit_mangle_type(p.type, line, col);
                j = j + 1;
            }
        }
        this.ps("@Z\"");
    }

    // The symbol after `@`: user `main` is `ivy_main`, extern "C" names are
    // left alone and every other function is MSVC-mangled.
    void emit_fn_symbol(const char* name, long is_extern_c, long fi,
                        long line, long col) {
        if (this.streq(name, "main")) {
            this.ps("ivy_main");
            return;
        }
        if (is_extern_c != 0) {
            this.ps(name);
            return;
        }
        this.emit_mangled_name(name, fi, line, col);
    }

    // --- casts ------------------------------------------------------------

    // Mirror of CodeGen::emitCast for the integer subset.  The temporary is
    // allocated before the conversion is classified, exactly like the oracle.
    VRef emit_cast(VRef v, const char* from, const char* to,
                   long from_unsigned, long line, long col) {
        if (this.streq(from, to)) {
            return v;
        }
        // H6.2g: CodeGen::emitCast keeps the literal `null` when the target
        // is a pointer (`if (value == "null" && to == "ptr") return "null";`).
        if (v.kind == 4 && this.streq(to, "ptr")) {
            return v;
        }
        VRef t = this.new_temp();
        if (this.streq(to, "ptr") && !this.streq(from, "ptr") &&
            this.int_bits(from) > 0) {
            this.emit_val(t);
            this.ps(" = inttoptr ");
            this.ps(from);
            this.ps(" ");
            this.emit_val(v);
            this.ps(" to ptr");
            this.nl();
            return t;
        }
        if (this.streq(from, "ptr") && !this.streq(to, "ptr") &&
            this.int_bits(to) > 0) {
            this.emit_val(t);
            this.ps(" = ptrtoint ptr ");
            this.emit_val(v);
            this.ps(" to ");
            this.ps(to);
            this.nl();
            return t;
        }
        long fb = this.int_bits(from);
        long tb = this.int_bits(to);
        if (fb > 0 && tb > 0) {
            if (fb < tb) {
                this.emit_val(t);
                this.ps(from_unsigned != 0 ? " = zext " : " = sext ");
                this.ps(from);
                this.ps(" ");
                this.emit_val(v);
                this.ps(" to ");
                this.ps(to);
                this.nl();
            } else if (fb > tb) {
                this.emit_val(t);
                this.ps(" = trunc ");
                this.ps(from);
                this.ps(" ");
                this.emit_val(v);
                this.ps(" to ");
                this.ps(to);
                this.nl();
            } else {
                return v;
            }
            return t;
        }
        // H6.2j: float <-> float (fpext / fptrunc), mirroring
        // CodeGen::emitCast.  Unsupported pairs keep the value unchanged.
        if (this.is_fp_ir(from) && this.is_fp_ir(to)) {
            if (this.streq(from, "float") && this.streq(to, "double")) {
                this.emit_val(t);
                this.ps(" = fpext float ");
                this.emit_val(v);
                this.ps(" to double");
                this.nl();
            } else if (this.streq(from, "double") && this.streq(to, "float")) {
                this.emit_val(t);
                this.ps(" = fptrunc double ");
                this.emit_val(v);
                this.ps(" to float");
                this.nl();
            } else if (this.streq(from, "half") &&
                       (this.streq(to, "float") || this.streq(to, "double"))) {
                this.emit_val(t);
                this.ps(" = fpext half ");
                this.emit_val(v);
                this.ps(" to ");
                this.ps(to);
                this.nl();
            } else if (this.streq(to, "half") &&
                       (this.streq(from, "float") || this.streq(from, "double"))) {
                this.emit_val(t);
                this.ps(" = fptrunc ");
                this.ps(from);
                this.ps(" ");
                this.emit_val(v);
                this.ps(" to half");
                this.nl();
            } else {
                return v;
            }
            return t;
        }
        // int -> float
        if (fb > 0 && this.is_fp_ir(to)) {
            this.emit_val(t);
            this.ps(from_unsigned != 0 ? " = uitofp " : " = sitofp ");
            this.ps(from);
            this.ps(" ");
            this.emit_val(v);
            this.ps(" to ");
            this.ps(to);
            this.nl();
            return t;
        }
        // float -> int (the oracle always uses fptosi here).
        if (this.is_fp_ir(from) && tb > 0) {
            this.emit_val(t);
            this.ps(" = fptosi ");
            this.ps(from);
            this.ps(" ");
            this.emit_val(v);
            this.ps(" to ");
            this.ps(to);
            this.nl();
            return t;
        }
        this.fail(line, col, "cast is out of scope for H6.2a");
        return v;
    }

    // --- expression lowering ---------------------------------------------

    VRef lower_ident(MExpr e) {
        long slot = this.find_var(e.sval);
        if (slot < 0) {
            this.fail(e.line, e.col, "internal: identifier is not in the variable table");
            return this.imm(0);
        }
        if (this.is_ref_var(e.sval) != 0 || e.type.is_ref != 0) {
            // H6.2h: reference variable (reference parameter).  The slot holds
            // the address of the referenced object; load it, then load the
            // value through it (CodeGen::lowerExpr's IdentRef reference case).
            VRef addr = this.new_temp();
            this.emit_val(addr);
            this.ps(" = load ptr, ptr ");
            this.emit_slot(e.sval, slot);
            this.nl();
            VRef t = this.new_temp();
            this.emit_val(t);
            this.ps(" = load ");
            this.ps(this.llvm_type(e.type, 1));
            this.ps(", ptr ");
            this.emit_val(addr);
            this.nl();
            return t;
        }
        if (e.type.array_size > 0) {
            this.fail(e.line, e.col, "array decay is out of scope for H6.2d");
            return this.imm(0);
        }
        VRef t = this.new_temp();
        this.emit_val(t);
        this.ps(" = load ");
        this.ps(this.llvm_type(e.type, 0));
        this.ps(", ptr ");
        this.emit_slot(e.sval, slot);
        this.nl();
        return t;
    }

    // Resolve the base of an array index to its alloca slot.  The only base
    // in scope is a local array identifier: the oracle's lowerExpr decays an
    // array IdentRef to its slot address without allocating a temporary.
    // Pointer indexing and every other decay form are rejected.
    long array_base_slot(MExpr base, long line, long col) {
        if (base.type.array_size <= 0) {
            this.fail(line, col, "pointer indexing is out of scope for H6.2d");
            return -1;
        }
        if (base.kind != 6) {
            this.fail(line, col, "array decay is out of scope for H6.2d");
            return -1;
        }
        long slot = this.find_var(base.sval);
        if (slot < 0) {
            this.fail(line, col, "internal: array base is not in the variable table");
        }
        return slot;
    }

    // Shared Index lowering (MExpr kind 12, the oracle's M::Index): lowers
    // the index, allocates the GEP temporary, emits the bounds check and then
    // the GEP, and returns the element address.  The oracle allocates the GEP
    // temporary BEFORE the bounds-check temporaries but emits it after the
    // ok-block label; that ordering fixes the `%tmp.N` numbering.
    VRef lower_index_addr(MExpr e) {
        MExpr base;
        MExpr ix;
        unsafe {
            base = this.mu->exprs[e.a];
            ix = this.mu->exprs[e.b];
        }
        long slot = this.array_base_slot(base, e.line, e.col);
        if (slot < 0) {
            return this.imm(0);
        }
        VRef idx = this.lower_expr(e.b);
        unsafe {
            const char* idx_ty = this.llvm_type(ix.type, 0);
            VRef gep = this.new_temp();
            VRef ba = this.slot_ref(base.sval, slot);
            this.emit_bounds_check(idx, idx_ty, base.type.array_size,
                                   e.line, e.col);
            this.emit_val(gep);
            this.ps(" = getelementptr ");
            this.ps(this.llvm_type(base.type, 0));
            this.ps(", ptr ");
            this.emit_val(ba);
            this.ps(", i32 0, ");
            this.ps(idx_ty);
            this.ps(" ");
            this.emit_val(idx);
            this.nl();
            return gep;
        }
        return this.imm(0);
    }

    // H6.2e: the address of a struct member.  A value base (`p.x`, `o.in.x`)
    // is lowered as an lvalue; an arrow base (`p->x`) is a pointer value.
    // The field index is resolved through the MIR struct table and becomes
    // the second GEP index, exactly like the oracle's lowerLValue Member.
    VRef lower_member_addr(MExpr e) {
        MExpr base;
        unsafe {
            base = this.mu->exprs[e.a];
        }
        AType st = base.type;
        VRef addr;
        if (e.flag != 0) {
            if (st.ptr_depth == 0) {
                this.fail(e.line, e.col, "arrow on a non-pointer is out of scope for H6.2e");
                return this.imm(0);
            }
            st.ptr_depth = st.ptr_depth - 1;
            addr = this.lower_expr(e.a);
        } else {
            st.is_ref = 0;
            addr = this.lower_lvalue(e.a);
        }
        long si = this.find_struct(st.base);
        if (si < 0) {
            this.fail(e.line, e.col, "member access on a non-struct is out of scope for H6.2e");
            return this.imm(0);
        }
        long fi = this.find_field(si, e.sval);
        if (fi < 0) {
            this.fail(e.line, e.col, "unknown struct member is out of scope for H6.2e");
            return this.imm(0);
        }
        VRef t = this.new_temp();
        this.emit_val(t);
        this.ps(" = getelementptr ");
        this.ps(this.llvm_type(st, 0));
        this.ps(", ptr ");
        this.emit_val(addr);
        this.ps(", i32 0, i32 ");
        io::print("{}", fi);
        this.nl();
        return t;
    }

    VRef lower_unary(MExpr e) {
        if (this.streq(e.sval, "+")) {
            return this.lower_expr(e.a);
        }
        if (this.streq(e.sval, "-")) {
            // The oracle allocates the temporary before lowering the operand.
            VRef t = this.new_temp();
            VRef op = this.lower_expr(e.a);
            long is_f =
                (e.type.ptr_depth == 0 && this.is_float_base(e.type.base)) ? 1 : 0;
            this.emit_val(t);
            this.ps(is_f != 0 ? " = fsub " : " = sub ");
            this.ps(this.llvm_type(e.type, 0));
            this.ps(is_f != 0 ? " 0.0, " : " 0, ");
            this.emit_val(op);
            this.nl();
            return t;
        }
        if (this.streq(e.sval, "!")) {
            VRef t = this.new_temp();
            VRef op = this.lower_expr(e.a);
            this.emit_val(t);
            this.ps(" = xor i1 ");
            this.emit_val(op);
            this.ps(", true");
            this.nl();
            return t;
        }
        if (this.streq(e.sval, "~")) {
            VRef t = this.new_temp();
            VRef op = this.lower_expr(e.a);
            this.emit_val(t);
            this.ps(" = xor ");
            this.ps(this.llvm_type(e.type, 0));
            this.ps(" ");
            this.emit_val(op);
            this.ps(", -1");
            this.nl();
            return t;
        }
        if (this.streq(e.sval, "++") || this.streq(e.sval, "--")) {
            MExpr opnd;
            unsafe {
                opnd = this.mu->exprs[e.a];
            }
            VRef p = this.lower_lvalue(e.a);
            VRef oldV = this.new_temp();
            this.emit_val(oldV);
            this.ps(" = load ");
            this.ps(this.llvm_type(opnd.type, 1));
            this.ps(", ptr ");
            this.emit_val(p);
            this.nl();
            VRef newV = this.new_temp();
            this.emit_val(newV);
            this.ps(" = ");
            if (opnd.type.ptr_depth > 0) {
                this.fail(e.line, e.col, "pointer increment is out of scope for H6.2j");
                return this.imm(0);
            }
            long is_f = this.is_float_base(opnd.type.base) ? 1 : 0;
            if (is_f != 0) {
                // The oracle always emits `fadd ..., 1.0`, even for `--`.
                this.ps("fadd ");
                this.ps(this.llvm_type(opnd.type, 1));
                this.ps(" ");
                this.emit_val(oldV);
                this.ps(", 1.0");
            } else {
                this.ps(this.streq(e.sval, "++") ? "add " : "sub ");
                this.ps(this.llvm_type(opnd.type, 1));
                this.ps(" ");
                this.emit_val(oldV);
                this.ps(", 1");
            }
            this.nl();
            this.ps("store ");
            this.ps(this.llvm_type(opnd.type, 1));
            this.ps(" ");
            this.emit_val(newV);
            this.ps(", ptr ");
            this.emit_val(p);
            this.nl();
            if (e.flag != 0) {
                return newV;
            }
            return oldV;
        }
        this.fail(e.line, e.col, "unary operator is out of scope for H6.2a");
        return this.imm(0);
    }

    bool is_cmp_op(const char* op) {
        return this.streq(op, "==") || this.streq(op, "!=") ||
               this.streq(op, "<") || this.streq(op, ">") ||
               this.streq(op, "<=") || this.streq(op, ">=");
    }

    const char* cmp_name(const char* op, long is_unsigned) {
        if (this.streq(op, "==")) return "eq";
        if (this.streq(op, "!=")) return "ne";
        if (this.streq(op, "<")) return is_unsigned != 0 ? "ult" : "slt";
        if (this.streq(op, ">")) return is_unsigned != 0 ? "ugt" : "sgt";
        if (this.streq(op, "<=")) return is_unsigned != 0 ? "ule" : "sle";
        if (this.streq(op, ">=")) return is_unsigned != 0 ? "uge" : "sge";
        return "eq";
    }

    // H6.2j: the oracle's ordered fcmp predicates.
    const char* fcmp_name(const char* op) {
        if (this.streq(op, "==")) return "oeq";
        if (this.streq(op, "!=")) return "one";
        if (this.streq(op, "<")) return "olt";
        if (this.streq(op, ">")) return "ogt";
        if (this.streq(op, "<=")) return "ole";
        if (this.streq(op, ">=")) return "oge";
        return "oeq";
    }

    VRef emit_binop(const char* op, const char* ty, VRef lc, VRef rc) {
        VRef t = this.new_temp();
        this.emit_val(t);
        this.ps(" = ");
        this.ps(op);
        this.ps(" ");
        this.ps(ty);
        this.ps(" ");
        this.emit_val(lc);
        this.ps(", ");
        this.emit_val(rc);
        this.nl();
        return t;
    }

    VRef lower_binary(MExpr e) {
        if (this.streq(e.sval, "&&") || this.streq(e.sval, "||")) {
            // H6.2k: short-circuit `&&`/`||` (CodeGen::lowerExpr Binary).
            // The lhs is lowered in the current block, then a branch picks the
            // rhs block or the merge block; the merge block ends in an i1 PHI
            // whose constant arm is `false` for `&&` and `true` for `||`.
            long is_and = this.streq(e.sval, "&&") ? 1 : 0;
            VRef lv = this.lower_expr(e.a);
            long prev_inline = this.cur_blk_inline_;
            long prev_idx = this.cur_blk_idx_;
            long eval_b = this.ib_;
            this.ib_ = this.ib_ + 1;
            long merge_b = this.ib_;
            this.ib_ = this.ib_ + 1;
            this.ps("br i1 ");
            this.emit_val(lv);
            this.ps(", label ");
            this.emit_blk_ref(1, is_and != 0 ? eval_b : merge_b);
            this.ps(", label ");
            this.emit_blk_ref(1, is_and != 0 ? merge_b : eval_b);
            this.nl();

            this.cur_blk_inline_ = 1;
            this.cur_blk_idx_ = eval_b;
            this.emit_inline_label(eval_b);
            VRef rv = this.lower_expr(e.b);
            long rhs_inline = this.cur_blk_inline_;
            long rhs_idx = this.cur_blk_idx_;
            this.ps("br label ");
            this.emit_blk_ref(1, merge_b);
            this.nl();

            this.cur_blk_inline_ = 1;
            this.cur_blk_idx_ = merge_b;
            this.emit_inline_label(merge_b);

            VRef p = this.new_temp();
            this.emit_val(p);
            this.ps(" = phi i1 [ ");
            this.ps(is_and != 0 ? "false" : "true");
            this.ps(", ");
            this.emit_blk_ref(prev_inline, prev_idx);
            this.ps(" ], [ ");
            this.emit_val(rv);
            this.ps(", ");
            this.emit_blk_ref(rhs_inline, rhs_idx);
            this.ps(" ]");
            this.nl();
            return p;
        }
        if (this.streq(e.sval, ",")) {
            this.fail(e.line, e.col, "the comma operator is out of scope for H6.2a");
            return this.imm(0);
        }

        MExpr lhs;
        MExpr rhs;
        unsafe {
            lhs = this.mu->exprs[e.a];
            rhs = this.mu->exprs[e.b];
        }
        if (lhs.type.ptr_depth > 0 || rhs.type.ptr_depth > 0) {
            this.fail(e.line, e.col, "pointer arithmetic is out of scope for H6.2a");
            return this.imm(0);
        }

        VRef lv = this.lower_expr(e.a);
        VRef rv = this.lower_expr(e.b);

        const long is_unsigned = lhs.type.is_unsigned != 0 ? 1 : 0;
        // H6.2j: the oracle's isFloatType(v.lhs->type) decides the whole
        // operation family (fcmp/fadd/...); a pointer is never float.
        const long is_f =
            (lhs.type.ptr_depth == 0 && this.is_float_base(lhs.type.base)) ? 1 : 0;

        if (this.is_cmp_op(e.sval)) {
            VRef lc = this.emit_cast(lv, this.llvm_type(lhs.type, 1),
                                     this.llvm_type(lhs.type, 1), is_unsigned,
                                     e.line, e.col);
            VRef rc = this.emit_cast(rv, this.llvm_type(rhs.type, 1),
                                     this.llvm_type(lhs.type, 1),
                                     rhs.type.is_unsigned != 0 ? 1 : 0,
                                     e.line, e.col);
            VRef t = this.new_temp();
            this.emit_val(t);
            if (is_f != 0) {
                this.ps(" = fcmp ");
                this.ps(this.fcmp_name(e.sval));
            } else {
                this.ps(" = icmp ");
                this.ps(this.cmp_name(e.sval, is_unsigned));
            }
            this.ps(" ");
            this.ps(this.llvm_type(lhs.type, 1));
            this.ps(" ");
            this.emit_val(lc);
            this.ps(", ");
            this.emit_val(rc);
            this.nl();
            return t;
        }

        VRef lc = this.emit_cast(lv, this.llvm_type(lhs.type, 1),
                                 this.llvm_type(e.type, 0), is_unsigned,
                                 e.line, e.col);
        VRef rc = this.emit_cast(rv, this.llvm_type(rhs.type, 1),
                                 this.llvm_type(e.type, 0),
                                 rhs.type.is_unsigned != 0 ? 1 : 0,
                                 e.line, e.col);

        if (this.streq(e.sval, "+")) {
            return this.emit_binop(is_f != 0 ? "fadd" : "add",
                                   this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "-")) {
            return this.emit_binop(is_f != 0 ? "fsub" : "sub",
                                   this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "*")) {
            return this.emit_binop(is_f != 0 ? "fmul" : "mul",
                                   this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "/")) {
            return this.emit_binop(is_f != 0 ? "fdiv" :
                                   (is_unsigned != 0 ? "udiv" : "sdiv"),
                                   this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "%")) {
            return this.emit_binop(is_f != 0 ? "frem" :
                                   (is_unsigned != 0 ? "urem" : "srem"),
                                   this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "<<")) {
            return this.emit_binop("shl", this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, ">>")) {
            return this.emit_binop(is_unsigned != 0 ? "lshr" : "ashr",
                                   this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "&")) {
            return this.emit_binop("and", this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "|")) {
            return this.emit_binop("or", this.llvm_type(e.type, 0), lc, rc);
        }
        if (this.streq(e.sval, "^")) {
            return this.emit_binop("xor", this.llvm_type(e.type, 0), lc, rc);
        }
        this.fail(e.line, e.col, "binary operator is out of scope for H6.2a");
        return this.imm(0);
    }

    VRef lower_cast(MExpr e) {
        MExpr opnd;
        unsafe {
            opnd = this.mu->exprs[e.a];
        }
        VRef v = this.lower_expr(e.a);
        if (this.streq(this.llvm_type(opnd.type, 1), "ptr") &&
            this.streq(this.llvm_type(e.type, 1), "ptr")) {
            return v;
        }
        return this.emit_cast(v, this.llvm_type(opnd.type, 1),
                              this.llvm_type(e.type, 1),
                              opnd.type.is_unsigned != 0 ? 1 : 0,
                              e.line, e.col);
    }

    // Assignment used as a value (e.g. the increment of a `for` loop).  The
    // oracle's lowerExpr(Assign) lowers the lvalue, lowers the rhs, stores it
    // without an explicit cast and yields the stored value.
    VRef lower_assign(MExpr e) {
        MExpr lhs;
        unsafe {
            lhs = this.mu->exprs[e.a];
        }
        VRef p = this.lower_lvalue(e.a);
        VRef v = this.lower_expr(e.b);
        this.ps("store ");
        this.ps(this.llvm_type(lhs.type, 1));
        this.ps(" ");
        this.emit_val(v);
        this.ps(", ptr ");
        this.emit_val(p);
        this.nl();
        return v;
    }

    // H6.2k: the conditional operator `c ? a : b` (CodeGen::lowerExpr
    // Ternary).  Three inline blocks (then/else/merge) and a PHI in the merge
    // block; nested short-circuits/ternaries update the current block, so the
    // PHI predecessors are read back from the tracking fields.
    VRef lower_ternary(MExpr e) {
        VRef cond = this.lower_expr(e.a);
        long then_b = this.ib_;
        this.ib_ = this.ib_ + 1;
        long else_b = this.ib_;
        this.ib_ = this.ib_ + 1;
        long merge_b = this.ib_;
        this.ib_ = this.ib_ + 1;

        this.ps("br i1 ");
        this.emit_val(cond);
        this.ps(", label ");
        this.emit_blk_ref(1, then_b);
        this.ps(", label ");
        this.emit_blk_ref(1, else_b);
        this.nl();

        this.cur_blk_inline_ = 1;
        this.cur_blk_idx_ = then_b;
        this.emit_inline_label(then_b);
        VRef tv = this.lower_expr(e.b);
        long then_inline = this.cur_blk_inline_;
        long then_idx = this.cur_blk_idx_;
        this.ps("br label ");
        this.emit_blk_ref(1, merge_b);
        this.nl();

        this.cur_blk_inline_ = 1;
        this.cur_blk_idx_ = else_b;
        this.emit_inline_label(else_b);
        VRef ev = this.lower_expr(e.c);
        long else_inline = this.cur_blk_inline_;
        long else_idx = this.cur_blk_idx_;
        this.ps("br label ");
        this.emit_blk_ref(1, merge_b);
        this.nl();

        this.cur_blk_inline_ = 1;
        this.cur_blk_idx_ = merge_b;
        this.emit_inline_label(merge_b);

        VRef p = this.new_temp();
        this.emit_val(p);
        this.ps(" = phi ");
        this.ps(this.llvm_type(e.type, 0));
        this.ps(" [ ");
        this.emit_val(tv);
        this.ps(", ");
        this.emit_blk_ref(then_inline, then_idx);
        this.ps(" ], [ ");
        this.emit_val(ev);
        this.ps(", ");
        this.emit_blk_ref(else_inline, else_idx);
        this.ps(" ]");
        this.nl();
        return p;
    }

    // Mirror of the generic Call branch of CodeGen::lowerExpr: the arguments
    // are lowered left to right, each one cast to the callee's parameter type,
    // and only then is the result temporary allocated.  A void call prints
    // `call void ...` and yields no temporary.  The argument scratch is a
    // stack so a nested call used as an argument cannot clobber the arguments
    // its parent has already lowered.
    VRef lower_call(MExpr e) {
        if (this.is_io_print_name(e.sval)) {
            return this.lower_io_print(e);
        }
        long fi = this.find_fn(e.sval);
        if (fi < 0) {
            this.fail(e.line, e.col, "call to a function without a MIR entry is out of scope for H6.2b");
            return this.imm(0);
        }
        MFunction callee;
        unsafe {
            callee = this.mu->fns[fi];
        }
        if (!this.check_fn_signature(callee, e.line, e.col)) {
            return this.imm(0);
        }
        long an = e.an;
        long base = this.arg_sp_;
        if (base + an > this.arg_cap_) {
            this.fail(e.line, e.col, "too many call arguments for H6.2b");
            return this.imm(0);
        }
        this.arg_sp_ = base + an;
        long j = 0;
        while (j < an) {
            unsafe {
                long ai = this.mu->args[e.astart + j];
                if (ai < 0) {
                    this.fail(e.line, e.col, "internal: missing call argument");
                    this.arg_sp_ = base;
                    return this.imm(0);
                }
                MExpr a = this.mu->exprs[ai];
                if (a.type.array_size > 0) {
                    this.fail(e.line, e.col, "array arguments are out of scope for H6.2b");
                    this.arg_sp_ = base;
                    return this.imm(0);
                }
                if (a.type.ptr_depth > 0) {
                    this.fail(e.line, e.col, "pointer arguments are out of scope for H6.2b");
                    this.arg_sp_ = base;
                    return this.imm(0);
                }
                VRef v;
                const char* ty = "i8";
                if (j < callee.pn) {
                    MParam p = this.mu->params[callee.pstart + j];
                    if (p.type.is_ref != 0) {
                        // H6.2h: pass by reference - emit the address of the
                        // lvalue and pass it as `ptr` (CodeGen::lowerExpr's
                        // Call branch for a reference parameter).
                        v = this.lower_lvalue(ai);
                        ty = "ptr";
                    } else {
                        v = this.lower_expr(ai);
                        ty = this.llvm_type(a.type, 1);
                        const char* pty = this.llvm_type(p.type, 1);
                        if (!this.streq(pty, "void") && !this.streq(pty, ty)) {
                            v = this.emit_cast(v, ty, pty,
                                               a.type.is_unsigned != 0 ? 1 : 0,
                                               e.line, e.col);
                            ty = pty;
                        }
                    }
                } else {
                    v = this.lower_expr(ai);
                    ty = this.llvm_type(a.type, 1);
                }
                VRef* av = (VRef*) this.arg_vals_;
                av[base + j] = v;
                long* at = (long*) this.arg_tys_;
                at[base + j] = (long) ty;
            }
            j = j + 1;
        }
        if (this.streq(this.llvm_type(e.type, 0), "void")) {
            this.ps("call void @");
            this.emit_fn_symbol(e.sval, callee.is_extern_c, fi, e.line, e.col);
            this.ps("(");
            this.emit_call_args(base, an);
            this.ps(")");
            this.nl();
            this.arg_sp_ = base;
            return this.imm(0);
        }
        VRef t = this.new_temp();
        this.emit_val(t);
        this.ps(" = call ");
        this.ps(this.llvm_type(e.type, 0));
        this.ps(" @");
        this.emit_fn_symbol(e.sval, callee.is_extern_c, fi, e.line, e.col);
        this.ps("(");
        this.emit_call_args(base, an);
        this.ps(")");
        this.nl();
        this.arg_sp_ = base;
        if (e.type.is_ref != 0 && this.suppress_ref_load_ == 0) {
            // H6.2i: a reference-returning call yields a pointer; load the
            // value for an rvalue use (CodeGen::lowerExpr's Call branch).
            VRef loaded = this.new_temp();
            this.emit_val(loaded);
            this.ps(" = load ");
            this.ps(this.llvm_type(e.type, 1));
            this.ps(", ptr ");
            this.emit_val(t);
            this.nl();
            return loaded;
        }
        return t;
    }

    // H6.2i: mirror of CodeGen::lowerCallPtr - emit a reference-returning
    // call and return its raw pointer (no auto-load).  Used by lowerLValue
    // for a reference call (e.g. the initializer of `T& r = f();`).
    VRef lower_call_ptr(MExpr e) {
        this.suppress_ref_load_ = 1;
        VRef v = this.lower_call(e);
        this.suppress_ref_load_ = 0;
        return v;
    }

    void emit_call_args(long base, long an) {
        long j = 0;
        unsafe {
            long* at = (long*) this.arg_tys_;
            VRef* av = (VRef*) this.arg_vals_;
            while (j < an) {
                if (j > 0) {
                    this.ps(", ");
                }
                const char* ty = reinterpret_cast<const char*>(at[base + j]);
                this.ps(ty);
                this.ps(" ");
                VRef v = av[base + j];
                this.emit_val(v);
                j = j + 1;
            }
        }
    }

    // --- H6.2c: pre-pass collection ---------------------------------------

    bool is_io_print_name(const char* name) {
        return this.streq(name, "io::print") ||
               this.streq(name, "io::println") ||
               this.streq(name, "io::eprint") ||
               this.streq(name, "io::eprintln");
    }

    // Mirror of CodeGen::collectExpr.  The node itself is visited first (a
    // StringLit registers a global, a Call sets the io usage flag), then the
    // children in the oracle's order.  This order fixes the `@.str.N`
    // numbering across the whole unit.
    void collect_expr(long idx) {
        if (idx < 0) {
            return;
        }
        MExpr e;
        unsafe {
            e = this.mu->exprs[idx];
        }
        if (e.kind == 2) {
            this.intern_prepass(e.sval, e.line, e.col);
            return;
        }
        if (e.kind == 11) {
            if (this.is_io_print_name(e.sval)) {
                this.uses_io_print_ = 1;
            }
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.mu->args[e.astart + j];
                }
                this.collect_expr(ai);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 8 || e.kind == 13 || e.kind == 19) {
            this.collect_expr(e.a);
            return;
        }
        if (e.kind == 9 || e.kind == 12 || e.kind == 14) {
            this.collect_expr(e.a);
            this.collect_expr(e.b);
            return;
        }
        if (e.kind == 10) {
            this.collect_expr(e.a);
            this.collect_expr(e.b);
            this.collect_expr(e.c);
            return;
        }
        if (e.kind == 17 || e.kind == 18) {
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.mu->args[e.astart + j];
                }
                this.collect_expr(ai);
                j = j + 1;
            }
            return;
        }
    }

    // Mirror of CodeGen::collectFunction: only the expressions reachable from
    // an instruction are visited (a switch condition is not collected, like
    // the oracle).
    void collect_function(long fi) {
        MFunction f;
        unsafe {
            f = this.mu->fns[fi];
        }
        long bi = 0;
        while (bi < f.block_n) {
            MBlock b;
            unsafe {
                b = this.mu->blocks[f.block_start + bi];
            }
            long ii = b.first;
            while (ii >= 0) {
                MInst inst;
                unsafe {
                    inst = this.mu->insts[ii];
                }
                if (inst.kind == 0 || inst.kind == 2 || inst.kind == 3 ||
                    inst.kind == 4) {
                    this.collect_expr(inst.a);
                } else if (inst.kind == 1) {
                    this.collect_expr(inst.a);
                    this.collect_expr(inst.b);
                }
                ii = inst.next;
            }
            bi = bi + 1;
        }
    }

    void collect_all() {
        long fi = 0;
        while (fi < this.mu->fn_n) {
            this.collect_function(fi);
            fi = fi + 1;
        }
    }

    // --- H6.2c: io::print builtins ----------------------------------------

    void emit_io_runtime() {
        this.pl("declare void @__ivy_write_str(i32, ptr)");
        this.pl("declare void @__ivy_write_char(i32, i8)");
        this.pl("declare ptr @__ivy_fmt_int(i64)");
        this.pl("declare ptr @__ivy_fmt_float(double)");
        this.pl("declare ptr @__ivy_fmt_bool(i1)");
        this.pl("declare void @__ivy_write_newline(i32)");
    }

    void emit_write_str(long fd, VRef v) {
        this.ps("call void @__ivy_write_str(i32 ");
        io::print("{}", fd);
        this.ps(", ptr ");
        this.emit_val(v);
        this.ps(")");
        this.nl();
    }

    void emit_write_char(long fd, VRef v) {
        this.ps("call void @__ivy_write_char(i32 ");
        io::print("{}", fd);
        this.ps(", i8 ");
        this.emit_val(v);
        this.ps(")");
        this.nl();
    }

    // Mirror of one argument branch of CodeGen::lowerIoPrint.  The temporary
    // order is: lower the expression, then the extend temporary (if any),
    // then the `__ivy_fmt_*` result temporary.
    void lower_io_arg(long idx, long fd) {
        if (idx < 0) {
            return;
        }
        MExpr a;
        unsafe {
            a = this.mu->exprs[idx];
        }
        AType at = a.type;
        if (at.ptr_depth > 0) {
            VRef v = this.lower_expr(idx);
            this.emit_write_str(fd, v);
            return;
        }
        // H6.2l: a reference argument takes the same branch as its referent
        // (CodeGen::lowerIoArg never special-cases isReference).  The oracle
        // spells the operand type with llvmType(at), which is `ptr` for a
        // reference, so the extension line is reproduced verbatim even though
        // that IR is not valid for a later backend pass.
        if (this.streq(at.base, "char") || this.streq(at.base, "int8_t") ||
            this.streq(at.base, "uint8_t")) {
            VRef v = this.lower_expr(idx);
            this.emit_write_char(fd, v);
            return;
        }
        if (this.streq(at.base, "bool")) {
            VRef v = this.lower_expr(idx);
            VRef p = this.new_temp();
            this.emit_val(p);
            this.ps(" = call ptr @__ivy_fmt_bool(i1 ");
            this.emit_val(v);
            this.ps(")");
            this.nl();
            this.emit_write_str(fd, p);
            return;
        }
        if (this.is_float_base(at.base)) {
            // H6.2j: a float argument is widened to double for
            // __ivy_fmt_float (CodeGen::lowerIoArg).
            VRef v = this.lower_expr(idx);
            VRef ext = v;
            if (!this.streq(this.llvm_type(at, 0), "double")) {
                ext = this.new_temp();
                this.emit_val(ext);
                this.ps(" = fpext ");
                this.ps(this.llvm_type(at, 0));
                this.ps(" ");
                this.emit_val(v);
                this.ps(" to double");
                this.nl();
            }
            VRef p = this.new_temp();
            this.emit_val(p);
            this.ps(" = call ptr @__ivy_fmt_float(double ");
            this.emit_val(ext);
            this.ps(")");
            this.nl();
            this.emit_write_str(fd, p);
            return;
        }
        VRef v = this.lower_expr(idx);
        unsafe {
            const char* ty = this.llvm_type(at, 0);
            VRef ext = v;
            if (!this.streq(ty, "i64")) {
                ext = this.new_temp();
                this.emit_val(ext);
                this.ps(at.is_unsigned != 0 ? " = zext " : " = sext ");
                this.ps(ty);
                this.ps(" ");
                this.emit_val(v);
                this.ps(" to i64");
                this.nl();
            }
            VRef p = this.new_temp();
            this.emit_val(p);
            this.ps(" = call ptr @__ivy_fmt_int(i64 ");
            this.emit_val(ext);
            this.ps(")");
            this.nl();
            this.emit_write_str(fd, p);
        }
    }

    // Mirror of CodeGen::lowerIoPrint.  A leading string literal is a format
    // string split on `{}`; otherwise every argument is printed in sequence.
    // Literal segments go through the raw-bytes interning map (not the
    // pre-pass `"1:"` map), reproducing the duplicate-global quirk.
    VRef lower_io_print(MExpr e) {
        long fd = 1;
        long is_ln = 0;
        if (this.streq(e.sval, "io::println")) {
            is_ln = 1;
        } else if (this.streq(e.sval, "io::eprint")) {
            fd = 2;
        } else if (this.streq(e.sval, "io::eprintln")) {
            fd = 2;
            is_ln = 1;
        }

        long an = e.an;
        long has_fmt = 0;
        long fmtp = 0;
        long fmt_len = 0;
        if (an > 0) {
            long ai0 = -1;
            unsafe {
                ai0 = this.mu->args[e.astart];
            }
            if (ai0 >= 0) {
                MExpr a0;
                unsafe {
                    a0 = this.mu->exprs[ai0];
                }
                if (a0.kind == 2) {
                    fmtp = this.decode_string(a0.sval);
                    if (fmtp == 0) {
                        return this.imm(0);
                    }
                    has_fmt = 1;
                    fmt_len = this.dec_len_;
                }
            }
        }

        if (has_fmt != 0) {
            unsafe {
                const char* fp = reinterpret_cast<const char*>(fmtp);
                char* seg = (char*) __ivy_alloc(
                    (unsigned long long) (fmt_len + 1));
                long seg_len = 0;
                long arg_idx = 1;
                long i = 0;
                while (i < fmt_len) {
                    if (i + 1 < fmt_len && fp[i] == '{' && fp[i + 1] == '}') {
                        if (seg_len > 0) {
                            long gi = this.intern_segment(seg, seg_len);
                            VRef g = this.emit_string_gep(gi);
                            this.emit_write_str(fd, g);
                            seg_len = 0;
                        }
                        if (arg_idx < an) {
                            long ai = -1;
                            ai = this.mu->args[e.astart + arg_idx];
                            this.lower_io_arg(ai, fd);
                            arg_idx = arg_idx + 1;
                        }
                        i = i + 2;
                    } else {
                        seg[seg_len] = fp[i];
                        seg_len = seg_len + 1;
                        i = i + 1;
                    }
                }
                if (seg_len > 0) {
                    long gi = this.intern_segment(seg, seg_len);
                    VRef g = this.emit_string_gep(gi);
                    this.emit_write_str(fd, g);
                }
                __ivy_free(seg);
            }
        } else {
            long ai = 0;
            while (ai < an) {
                long axi = -1;
                unsafe {
                    axi = this.mu->args[e.astart + ai];
                }
                this.lower_io_arg(axi, fd);
                ai = ai + 1;
            }
        }

        if (is_ln != 0) {
            this.ps("call void @__ivy_write_newline(i32 ");
            io::print("{}", fd);
            this.ps(")");
            this.nl();
        }
        return this.imm(0);
    }

    VRef lower_string(MExpr e) {
        unsafe {
            long p = this.decode_string(e.sval);
            if (p == 0) {
                if (this.failed_ == 0) {
                    this.fail(e.line, e.col, "malformed string literal");
                }
                return this.imm(0);
            }
            long bl = this.dec_len_;
            long key = this.make_prefixed_key((char*) p, bl);
            long gi = this.map_get(this.pm_keys_, this.pm_klens_, this.pm_idx_,
                                   this.pm_n_, (char*) key, bl + 2);
            if (gi < 0) {
                this.fail(e.line, e.col,
                          "internal: string literal was not collected");
                return this.imm(0);
            }
            return this.emit_string_gep(gi);
        }
        return this.imm(0);
    }

    VRef lower_expr(long idx) {
        if (idx < 0) {
            this.fail(0, 0, "internal: missing expression");
            return this.imm(0);
        }
        MExpr e;
        unsafe {
            e = this.mu->exprs[idx];
        }
        if (e.kind == 0) {
            return this.imm(e.ival);
        }
        if (e.kind == 1) {
            return this.float_lit(e.fval);
        }
        if (e.kind == 2) {
            return this.lower_string(e);
        }
        if (e.kind == 3) {
            long cv = this.decode_char_value(e.sval);
            if (cv < 0) {
                return this.imm(0);
            }
            return this.imm(cv);
        }
        if (e.kind == 4) {
            return this.bool_ref(e.ival != 0 ? 1 : 0);
        }
        if (e.kind == 5) {
            return this.null_ref();
        }
        if (e.kind == 6) {
            return this.lower_ident(e);
        }
        if (e.kind == 8) {
            return this.lower_unary(e);
        }
        if (e.kind == 9) {
            return this.lower_binary(e);
        }
        if (e.kind == 10) {
            return this.lower_ternary(e);
        }
        if (e.kind == 11) {
            return this.lower_call(e);
        }
        if (e.kind == 12) {
            // Index as an rvalue: address + load of the element type.
            VRef gep = this.lower_index_addr(e);
            if (gep.kind == 0) {
                return gep;
            }
            VRef t = this.new_temp();
            this.emit_val(t);
            this.ps(" = load ");
            this.ps(this.llvm_type(e.type, 0));
            this.ps(", ptr ");
            this.emit_val(gep);
            this.nl();
            return t;
        }
        if (e.kind == 13) {
            // Member as an rvalue: address + load of the field type.
            VRef gep = this.lower_member_addr(e);
            if (gep.kind == 0) {
                return gep;
            }
            VRef t = this.new_temp();
            this.emit_val(t);
            this.ps(" = load ");
            this.ps(this.llvm_type(e.type, 0));
            this.ps(", ptr ");
            this.emit_val(gep);
            this.nl();
            return t;
        }
        if (e.kind == 14) {
            return this.lower_assign(e);
        }
        if (e.kind == 19) {
            return this.lower_cast(e);
        }
        this.fail(e.line, e.col, "expression kind is out of scope for H6.2a");
        return this.imm(0);
    }

    VRef lower_lvalue(long idx) {
        if (idx < 0) {
            this.fail(0, 0, "internal: missing lvalue");
            return this.imm(0);
        }
        MExpr e;
        unsafe {
            e = this.mu->exprs[idx];
        }
        if (e.kind == 6) {
            long slot = this.find_var(e.sval);
            if (slot < 0) {
                this.fail(e.line, e.col, "internal: lvalue is not in the variable table");
                return this.imm(0);
            }
            if (this.is_ref_var(e.sval) != 0 || e.type.is_ref != 0) {
                // H6.2h: a reference variable's slot holds the address of the
                // referenced object (CodeGen::lowerLValue's IdentRef case).
                VRef t = this.new_temp();
                this.emit_val(t);
                this.ps(" = load ptr, ptr ");
                this.emit_slot(e.sval, slot);
                this.nl();
                return t;
            }
            return this.slot_ref(e.sval, slot);
        }
        if (e.kind == 11) {
            if (e.type.is_ref != 0) {
                // H6.2i: a reference-returning call is an lvalue whose address
                // is the call's raw pointer result.
                return this.lower_call_ptr(e);
            }
            this.fail(e.line, e.col, "a by-value call is not an lvalue in H6.2i");
            return this.imm(0);
        }
        if (e.kind == 12) {
            return this.lower_index_addr(e);
        }
        if (e.kind == 13) {
            return this.lower_member_addr(e);
        }
        this.fail(e.line, e.col, "lvalue is out of scope for H6.2e");
        return this.imm(0);
    }

    // --- instruction / block lowering -------------------------------------

    void lower_inst(MInst inst) {
        // CodeGen::lowerInst propagates the instruction's unsafe flag to the
        // expression lowering of this instruction (bounds checks consult it).
        this.cur_in_unsafe_ = inst.in_unsafe;
        if (inst.kind == 0) {
            // Alloca: the slot itself was hoisted to the entry block; only
            // the initializer store runs here (mirror of lowerInst).
            long slot = this.find_var(inst.var);
            if (slot < 0) {
                this.fail(inst.line, inst.col, "internal: alloca is not in the variable table");
                return;
            }
            if (inst.type.is_ref != 0) {
                // H6.2h: a reference local aliases the referenced object; the
                // slot already holds a `ptr` and the init is an lvalue whose
                // address is stored (CodeGen::lowerInst's Alloca reference
                // branch).
                if (inst.a >= 0) {
                    VRef addr = this.lower_lvalue(inst.a);
                    this.ps("store ptr ");
                    this.emit_val(addr);
                    this.ps(", ptr ");
                    this.emit_slot(inst.var, slot);
                    this.nl();
                }
                return;
            }
            if (inst.type.array_size > 0) {
                // H6.2d: an uninitialized array is zero-initialized at the
                // declaration point (the alloca itself was hoisted).  An
                // initializer list is not in scope (the oracle rejects a
                // primitive array initializer in the frontend).
                if (inst.a >= 0) {
                    this.fail(inst.line, inst.col,
                              "array initializers are out of scope for H6.2d");
                    return;
                }
                this.ps("store ");
                this.ps(this.llvm_type(inst.type, 0));
                this.ps(" zeroinitializer, ptr ");
                this.emit_slot(inst.var, slot);
                this.nl();
                return;
            }
            // H6.2e: an uninitialized struct local is zero-initialized at the
            // declaration point (the alloca itself was hoisted).  A struct
            // initialized from another value goes through the generic store
            // below (a whole-struct load/store).
            if (this.is_struct_type(inst.type) && inst.a < 0) {
                this.ps("store ");
                this.ps(this.llvm_type(inst.type, 0));
                this.ps(" zeroinitializer, ptr ");
                this.emit_slot(inst.var, slot);
                this.nl();
                return;
            }
            if (inst.a < 0) {
                return;
            }
            MExpr init;
            unsafe {
                init = this.mu->exprs[inst.a];
            }
            if (init.kind == 17) {
                this.fail(inst.line, inst.col, "aggregate initializers are out of scope for H6.2a");
                return;
            }
            VRef v = this.lower_expr(inst.a);
            VRef c = this.emit_cast(v, this.llvm_type(init.type, 1),
                                    this.llvm_type(inst.type, 0),
                                    init.type.is_unsigned != 0 ? 1 : 0,
                                    inst.line, inst.col);
            this.ps("store ");
            this.ps(this.llvm_type(inst.type, 0));
            this.ps(" ");
            this.emit_val(c);
            this.ps(", ptr ");
            this.emit_slot(inst.var, slot);
            this.nl();
            return;
        }
        if (inst.kind == 1) {
            MExpr target;
            MExpr value;
            unsafe {
                target = this.mu->exprs[inst.a];
                value = this.mu->exprs[inst.b];
            }
            VRef p = this.lower_lvalue(inst.a);
            VRef v = this.lower_expr(inst.b);
            VRef c = this.emit_cast(v, this.llvm_type(value.type, 1),
                                    this.llvm_type(target.type, 1),
                                    value.type.is_unsigned != 0 ? 1 : 0,
                                    inst.line, inst.col);
            this.ps("store ");
            this.ps(this.llvm_type(target.type, 1));
            this.ps(" ");
            this.emit_val(c);
            this.ps(", ptr ");
            this.emit_val(p);
            this.nl();
            return;
        }
        if (inst.kind == 2) {
            if (inst.a >= 0) {
                this.lower_expr(inst.a);
            }
            return;
        }
        if (inst.kind == 3) {
            if (inst.a >= 0) {
                if (this.cur_ret_ref_ != 0) {
                    // H6.2i: a reference return yields the address of the
                    // returned lvalue (CodeGen::lowerInst's Ret branch).
                    VRef addr = this.lower_lvalue(inst.a);
                    this.ps("ret ptr ");
                    this.emit_val(addr);
                    this.nl();
                    return;
                }
                MExpr rv;
                unsafe {
                    rv = this.mu->exprs[inst.a];
                }
                VRef v = this.lower_expr(inst.a);
                VRef c = this.emit_cast(v, this.llvm_type(rv.type, 1), this.cur_ret_ty_,
                                        rv.type.is_unsigned != 0 ? 1 : 0,
                                        inst.line, inst.col);
                this.ps("ret ");
                this.ps(this.cur_ret_ty_);
                this.ps(" ");
                this.emit_val(c);
                this.nl();
            } else {
                this.pl("ret void");
            }
            return;
        }
        if (inst.kind == 4) {
            VRef c = this.lower_expr(inst.a);
            this.ps("br i1 ");
            this.emit_val(c);
            this.ps(", label ");
            this.emit_bb(inst.b);
            this.ps(", label ");
            this.emit_bb(inst.c);
            this.nl();
            return;
        }
        if (inst.kind == 5) {
            this.ps("br label ");
            this.emit_bb(inst.b);
            this.nl();
            return;
        }
        if (inst.kind == 6) {
            // H6.2k: `switch` (CodeGen::lowerInst Switch).  A missing
            // condition prints nothing (the oracle's `if (!sw.cond) return`).
            if (inst.a < 0) {
                return;
            }
            MExpr ce;
            unsafe {
                ce = this.mu->exprs[inst.a];
            }
            VRef c = this.lower_expr(inst.a);
            this.ps("switch ");
            this.ps(this.llvm_type(ce.type, 0));
            this.ps(" ");
            this.emit_val(c);
            this.ps(", label ");
            this.emit_bb(inst.b);
            this.ps(" [");
            this.nl();
            long k = 0;
            while (k < inst.an) {
                long av = 0;
                long ab = 0;
                unsafe {
                    av = this.mu->arm_val[inst.astart + k];
                    ab = this.mu->arm_blk[inst.astart + k];
                }
                this.ps("    ");
                this.ps(this.llvm_type(ce.type, 0));
                this.ps(" ");
                io::print("{}", av);
                this.ps(", label ");
                this.emit_bb(ab);
                this.nl();
                k = k + 1;
            }
            this.ps("  ]");
            this.nl();
            return;
        }
        this.fail(inst.line, inst.col, "instruction kind is out of scope for H6.2a");
    }

    void lower_block(long local_idx) {
        long global = this.cur_block_start_ + local_idx;
        this.cur_blk_inline_ = 0;
        this.cur_blk_idx_ = local_idx;
        io::print("bb{}:", local_idx);
        this.nl();
        MBlock b;
        unsafe {
            b = this.mu->blocks[global];
        }
        long i = b.first;
        long last_kind = -1;
        while (i >= 0) {
            MInst inst;
            unsafe {
                inst = this.mu->insts[i];
            }
            this.lower_inst(inst);
            last_kind = inst.kind;
            i = inst.next;
        }
        if (last_kind != 3 && last_kind != 4 && last_kind != 5 && last_kind != 6) {
            if (this.cur_is_void_ != 0) {
                this.pl("ret void");
            } else {
                this.pl("unreachable");
            }
        }
    }

    // --- function lowering ------------------------------------------------

    void lower_function(long fi) {
        MFunction func;
        unsafe {
            func = this.mu->fns[fi];
        }
        this.temp_ = 0;
        this.alloca_ = 0;
        this.arg_sp_ = 0;
        // H6.2d: `%tmp.N` and `bb.i<K>` both restart for every function.
        this.ib_ = 0;
        this.cur_in_unsafe_ = 0;
        this.clear_vars();
        this.cur_fi_ = fi;
        this.cur_block_start_ = func.block_start;
        this.cur_block_n_ = func.block_n;
        this.cur_ret_ty_ = this.llvm_type(func.ret, 1);
        this.cur_is_void_ = this.streq(this.llvm_type(func.ret, 0), "void") ? 1 : 0;
        this.cur_ret_ref_ = func.ret.is_ref != 0 ? 1 : 0;

        if (!this.check_fn_signature(func, 0, 0)) {
            return;
        }

        this.ps("define ");
        this.ps(this.llvm_type(func.ret, 0));
        this.ps(" @");
        this.emit_fn_symbol(func.name, func.is_extern_c, fi, 0, 0);
        this.ps("(");
        long i = 0;
        while (i < func.pn) {
            MParam p;
            unsafe {
                p = this.mu->params[func.pstart + i];
            }
            if (i > 0) {
                this.ps(", ");
            }
            this.ps(this.llvm_type(p.type, 0));
            io::print(" %arg{}", i);
            i = i + 1;
        }
        this.ps(") {");
        this.nl();

        // Prologue: parameters in alloca slots.
        i = 0;
        while (i < func.pn) {
            MParam p;
            unsafe {
                p = this.mu->params[func.pstart + i];
            }
            long slot = this.alloca_;
            this.alloca_ = this.alloca_ + 1;
            this.emit_slot(p.name, slot);
            this.ps(" = alloca ");
            this.ps(this.llvm_type(p.type, 0));
            this.nl();
            this.ps("store ");
            this.ps(this.llvm_type(p.type, 0));
            io::print(" %arg{}", i);
            this.ps(", ptr ");
            this.emit_slot(p.name, slot);
            this.nl();
            this.add_var(p.name, slot, p.type.is_ref != 0 ? 1 : 0);
            i = i + 1;
        }

        // Hoist every local slot to the entry block, in block/instruction
        // order.  This is what fixes the `%name.N` numbering.
        long bi = 0;
        while (bi < func.block_n) {
            MBlock b;
            unsafe {
                b = this.mu->blocks[func.block_start + bi];
            }
            long ii = b.first;
            while (ii >= 0) {
                MInst inst;
                unsafe {
                    inst = this.mu->insts[ii];
                }
                if (inst.kind == 0) {
                    long slot = this.alloca_;
                    this.alloca_ = this.alloca_ + 1;
                    this.emit_slot(inst.var, slot);
                    this.ps(" = alloca ");
                    if (inst.type.is_ref != 0) {
                        this.ps("ptr");
                    } else {
                        this.ps(this.llvm_type(inst.type, 0));
                    }
                    this.nl();
                    this.add_var(inst.var, slot, inst.type.is_ref != 0 ? 1 : 0);
                }
                ii = inst.next;
            }
            bi = bi + 1;
        }

        if (func.block_n > 0) {
            this.pl("br label %bb0");
        } else if (this.cur_is_void_ != 0) {
            this.pl("ret void");
        } else {
            this.pl("unreachable");
        }

        bi = 0;
        while (bi < func.block_n) {
            this.lower_block(bi);
            bi = bi + 1;
        }
        this.pl("}");
        this.nl();
    }

    // --- C entry point ----------------------------------------------------

    void emit_entry_point() {
        long fi = 0;
        long found = -1;
        while (fi < this.mu->fn_n) {
            MFunction func;
            unsafe {
                func = this.mu->fns[fi];
            }
            if (this.streq(func.name, "main") && func.has_body != 0) {
                found = fi;
                break;
            }
            fi = fi + 1;
        }
        if (found < 0) {
            return;
        }
        MFunction m;
        unsafe {
            m = this.mu->fns[found];
        }
        const long is_void = this.streq(this.llvm_type(m.ret, 0), "void") ? 1 : 0;
        this.pl("; C1: C entry point — calls ivy_main()");
        if (is_void != 0) {
            this.pl("define i32 @main() {");
            this.pl("  call void @ivy_main()");
            this.pl("  ret i32 0");
            this.pl("}");
        } else {
            this.ps("define ");
            this.ps(this.llvm_type(m.ret, 0));
            this.pl(" @main() {");
            this.ps("  %r = call ");
            this.ps(this.llvm_type(m.ret, 0));
            this.pl(" @ivy_main()");
            this.ps("  ret ");
            this.ps(this.llvm_type(m.ret, 0));
            this.pl(" %r");
            this.pl("}");
        }
        this.nl();
    }

    // --- declarations -----------------------------------------------------

    // H6.2e: the `%struct.Name = type { ... }` block printed immediately
    // after the module header (mirror of CodeGen::generate's struct loop).
    // Unused definitions are printed too; the order is the source order.
    void emit_struct_defs() {
        long i = 0;
        unsafe {
            while (i < this.mu->st_n) {
                MStruct s = this.mu->structs[i];
                this.ps("%struct.");
                this.ps(s.name);
                this.ps(" = type { ");
                long j = 0;
                while (j < s.nfields) {
                    if (j > 0) {
                        this.ps(", ");
                    }
                    this.ps(this.llvm_type(s.fields[j].type, 0));
                    j = j + 1;
                }
                this.ps(" }");
                this.nl();
                i = i + 1;
            }
            if (this.mu->st_n > 0) {
                this.nl();
            }
        }
    }

    // Mirror of the `declare` loops of CodeGen::generate(): the signature has
    // the parameter types only (no names) and extern "C" symbols are left
    // unmangled.  Declarations are emitted before every definition.
    void emit_declaration(long fi) {
        MFunction f;
        unsafe {
            f = this.mu->fns[fi];
        }
        if (!this.check_fn_signature(f, 0, 0)) {
            return;
        }
        this.ps("declare ");
        this.ps(this.llvm_type(f.ret, 0));
        this.ps(" @");
        this.emit_fn_symbol(f.name, f.is_extern_c, fi, 0, 0);
        this.ps("(");
        long j = 0;
        while (j < f.pn) {
            MParam p;
            unsafe {
                p = this.mu->params[f.pstart + j];
            }
            if (j > 0) {
                this.ps(", ");
            }
            this.ps(this.llvm_type(p.type, 0));
            j = j + 1;
        }
        this.ps(")");
        this.nl();
    }

    // --- driver entry -----------------------------------------------------

    // Emit the whole module.  Returns 0 on success and 1 when a construct
    // outside the H6.2b subset was found (the driver prints the diagnostic).
    long emit() {
        this.collect_all();
        if (this.failed_ != 0) {
            return 1;
        }
        this.pl("; LLVM IR emitted by ivy");
        this.emit_struct_defs();
        if (this.failed_ != 0) {
            return 1;
        }
        // CodeGen::generate() emits extern "C" declarations first, then the
        // declarations of bodyless non-extern functions, then the definitions.
        long fi = 0;
        while (fi < this.mu->fn_n) {
            MFunction func;
            unsafe {
                func = this.mu->fns[fi];
            }
            if (func.is_extern_c != 0 && func.has_body == 0) {
                this.emit_declaration(fi);
                if (this.failed_ != 0) {
                    return 1;
                }
            }
            fi = fi + 1;
        }
        fi = 0;
        while (fi < this.mu->fn_n) {
            MFunction func;
            unsafe {
                func = this.mu->fns[fi];
            }
            if (func.is_extern_c == 0 && func.has_body == 0) {
                this.emit_declaration(fi);
                if (this.failed_ != 0) {
                    return 1;
                }
            }
            fi = fi + 1;
        }
        fi = 0;
        while (fi < this.mu->fn_n) {
            MFunction func;
            unsafe {
                func = this.mu->fns[fi];
            }
            if (func.has_body != 0) {
                this.lower_function(fi);
                if (this.failed_ != 0) {
                    return 1;
                }
            }
            fi = fi + 1;
        }
        this.emit_entry_point();
        if (this.failed_ != 0) {
            return 1;
        }
        if (this.uses_io_print_ != 0) {
            this.emit_io_runtime();
        }
        this.emit_string_constants();
        if (this.failed_ != 0) {
            return 1;
        }
        // H6.2d: like CodeGen::generate(), the panic declaration follows the
        // string constants because emitBoundsCheck() adds its message globals
        // (and sets this flag) while functions are lowered.
        if (this.declared_panic_ != 0) {
            this.pl("declare void @__ivy_panic(ptr, i32)");
        }
        return 0;
    }
};
