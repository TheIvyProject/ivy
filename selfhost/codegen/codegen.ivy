// selfhost/codegen/codegen.ivy - H6.1 LLVM C API binding (`import c`).
//
// This module is the selfhost counterpart of the LLVM C++ API used by
// src/codegen/codegen.cpp. It binds the LLVM *C* API (LLVM 21.1.6) instead:
// every `extern "C"` declaration below mirrors the signature in
// D:\Cpp\Clang\include\llvm-c\*.h, with the opaque `LLVM*Ref` handles spelled
// as `void*` and `uint64_t`/`size_t` spelled as `unsigned long long`.
//
// `import c <header>` is declaration-only in Ivy: the header is never parsed
// or compiled, so the prototypes must be repeated here. The declarations are
// module-private; importers use the exported `LlvmC` facade (thin pass-through
// methods), because Ivy does not export `extern "C"` declarations.
//
// Calling convention for pointer arrays (`LLVMTypeRef *ParamTypes`,
// `LLVMValueRef *Args`, ...): Ivy has no `T[]` -> `T**` decay, so allocate a
// `void*` block with `__ivy_alloc` (8 bytes per element), cast it to `void**`,
// fill it, pass it, then free it. See H61_NOTES.md section 5.
//
// Binding layer only: no IR emission logic lives here yet.

#pragma ivy cnumber
export module codegen;

import c <llvm-c/Core.h>;
import c <llvm-c/Analysis.h>;
import c <llvm-c/Target.h>;
import c <llvm-c/TargetMachine.h>;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);

