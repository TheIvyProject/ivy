// ---------------------------------------------------------------------------
// Target and object emission (llvm-c/Target.h, llvm-c/TargetMachine.h)
//
// LLVMInitializeNativeTarget is a static inline helper in Target.h, not an
// exported symbol, so the host X86 initializers are bound directly. They are
// only resolved when H6.3 links the X86 target libraries.
// ---------------------------------------------------------------------------

extern "C" char* LLVMGetDefaultTargetTriple();
extern "C" char* LLVMGetHostCPUName();
extern "C" char* LLVMGetHostCPUFeatures();
extern "C" int   LLVMGetTargetFromTriple(const char* triple, void** target,
                                         char** error_message);
extern "C" void* LLVMCreateTargetMachine(void* target, const char* triple,
                                         const char* cpu, const char* features,
                                         int level, int reloc, int code_model);
extern "C" void  LLVMDisposeTargetMachine(void* target_machine);
extern "C" void* LLVMCreateTargetDataLayout(void* target_machine);
extern "C" void  LLVMSetModuleDataLayout(void* m, void* target_data);
extern "C" void  LLVMDisposeTargetData(void* target_data);
extern "C" int   LLVMTargetMachineEmitToFile(void* target_machine, void* m,
                                             const char* filename, int codegen,
                                             char** error_message);

extern "C" void LLVMInitializeX86TargetInfo();
extern "C" void LLVMInitializeX86Target();
extern "C" void LLVMInitializeX86TargetMC();
extern "C" void LLVMInitializeX86AsmPrinter();
extern "C" void LLVMInitializeX86AsmParser();

// ---------------------------------------------------------------------------
// Exported facade
//
// Ivy does not export `extern "C"` declarations, so importers (the H6.1 smoke
// driver and later emitter modules) go through this pass-through struct. The
// methods add no policy: each one forwards to the C API unchanged.
// ---------------------------------------------------------------------------

export struct LlvmC {
    long tag;

    void* context_create() {
        unsafe {
            return LLVMContextCreate();
        }
    }

    void context_dispose(void* c) {
        unsafe {
            LLVMContextDispose(c);
        }
    }

    void* module_create(const char* module_id, void* c) {
        unsafe {
            return LLVMModuleCreateWithNameInContext(module_id, c);
        }
    }

    void module_dispose(void* m) {
        unsafe {
            LLVMDisposeModule(m);
        }
    }

    char* module_print(void* m) {
        unsafe {
            return LLVMPrintModuleToString(m);
        }
    }

    void message_dispose(char* message) {
        unsafe {
            LLVMDisposeMessage(message);
        }
    }

    int module_verify(void* m, int action) {
        unsafe {
            char* err = (char*) 0;
            int bad = LLVMVerifyModule(m, action, &err);
            if (err != (char*) 0) {
                LLVMDisposeMessage(err);
            }
            return bad;
        }
    }

    void* void_type(void* c) {
        unsafe {
            return LLVMVoidTypeInContext(c);
        }
    }

    void* int32_type(void* c) {
        unsafe {
            return LLVMInt32TypeInContext(c);
        }
    }

    void* function_type(void* return_type, void** param_types,
                        unsigned int param_count, int is_var_arg) {
        unsafe {
            return LLVMFunctionType(return_type, param_types, param_count, is_var_arg);
        }
    }

    void* add_function(void* m, const char* name, void* function_ty) {
        unsafe {
            return LLVMAddFunction(m, name, function_ty);
        }
    }

    void* append_block(void* c, void* func, const char* name) {
        unsafe {
            return LLVMAppendBasicBlockInContext(c, func, name);
        }
    }

    void* create_builder(void* c) {
        unsafe {
            return LLVMCreateBuilderInContext(c);
        }
    }

    void position_at_end(void* builder, void* block) {
        unsafe {
            LLVMPositionBuilderAtEnd(builder, block);
        }
    }

    void dispose_builder(void* builder) {
        unsafe {
            LLVMDisposeBuilder(builder);
        }
    }

    void* build_ret_void(void* builder) {
        unsafe {
            return LLVMBuildRetVoid(builder);
        }
    }

    void* build_ret(void* builder, void* v) {
        unsafe {
            return LLVMBuildRet(builder, v);
        }
    }

    void* const_int(void* int_ty, unsigned long long n, int sign_extend) {
        unsafe {
            return LLVMConstInt(int_ty, n, sign_extend);
        }
    }

    // -----------------------------------------------------------------------
    // H6.3: IR parsing and native object emission (pass-through only).
    // -----------------------------------------------------------------------

    void* memory_buffer_copy(const char* input_data, unsigned long long n,
                             const char* buffer_name) {
        unsafe {
            return LLVMCreateMemoryBufferWithMemoryRangeCopy(input_data, n,
                                                             buffer_name);
        }
    }

    int parse_ir_in_context(void* context_ref, void* mem_buf, void** out_m,
                            char** out_message) {
        unsafe {
            return LLVMParseIRInContext(context_ref, mem_buf, out_m, out_message);
        }
    }

    void target_initialize() {
        unsafe {
            LLVMInitializeX86TargetInfo();
            LLVMInitializeX86Target();
            LLVMInitializeX86TargetMC();
            LLVMInitializeX86AsmPrinter();
            LLVMInitializeX86AsmParser();
        }
    }

    char* default_target_triple() {
        unsafe {
            return LLVMGetDefaultTargetTriple();
        }
    }

    int target_from_triple(const char* triple, void** target, char** error_message) {
        unsafe {
            return LLVMGetTargetFromTriple(triple, target, error_message);
        }
    }

    void* create_target_machine(void* target, const char* triple, const char* cpu,
                                const char* features, int level, int reloc,
                                int code_model) {
        unsafe {
            return LLVMCreateTargetMachine(target, triple, cpu, features, level,
                                           reloc, code_model);
        }
    }

    void dispose_target_machine(void* target_machine) {
        unsafe {
            LLVMDisposeTargetMachine(target_machine);
        }
    }

    void set_target(void* m, const char* triple) {
        unsafe {
            LLVMSetTarget(m, triple);
        }
    }

    void set_data_layout(void* m, const char* layout) {
        unsafe {
            LLVMSetDataLayout(m, layout);
        }
    }

    void* create_target_data_layout(void* target_machine) {
        unsafe {
            return LLVMCreateTargetDataLayout(target_machine);
        }
    }

    void set_module_data_layout(void* m, void* target_data) {
        unsafe {
            LLVMSetModuleDataLayout(m, target_data);
        }
    }

    void dispose_target_data(void* target_data) {
        unsafe {
            LLVMDisposeTargetData(target_data);
        }
    }

    int target_machine_emit_to_file(void* target_machine, void* m,
                                    const char* filename, int codegen,
                                    char** error_message) {
        unsafe {
            return LLVMTargetMachineEmitToFile(target_machine, m, filename, codegen,
                                               error_message);
        }
    }
};

// ---------------------------------------------------------------------------
// H6.3: native object emission
//
// Mirror of `CodeGen::emitObject` (src/codegen/codegen.cpp:2729-2804): parse
// the textual IR produced by the H6.2 emitter into a Module, configure the
// host TargetMachine exactly like the oracle (host triple, empty CPU/features,
// default relocation/code model, `CodeGenOptLevel::Default`), then write a
// COFF object file. The oracle links only the native target, so the X86
// initializers above are sufficient.
//
// Return codes: 0 success, 1 context, 2 memory buffer, 3 IR parse, 4 target
// lookup, 5 TargetMachine creation, 6 emit-to-file. `err()` exposes the
// LLVM-provided detail message (or a short fallback); it stays valid until the
// process exits. `code()` returns the same code for callers that want to
// prefix the oracle-style diagnostic.
// ---------------------------------------------------------------------------

export struct ObjEmit {
    long tag;
    const char* err_;
    long code_;

    int emit_text(const char* ir, unsigned long long len, const char* out_path) {
        unsafe {
            this.err_ = "";
            this.code_ = 0;
            LlvmC api;
            // 2) Initialize the native target. The oracle guards this with a
            // process-wide flag; the X86 entry points are idempotent.
            api.target_initialize();

            // 3) Parse the IR text into a Module.
            void* ctx = api.context_create();
            if (ctx == (void*) 0) {
                this.err_ = "LLVM context creation failed";
                this.code_ = 1;
                return 1;
            }
            void* buf = api.memory_buffer_copy(ir, len, "ivy-module");
            if (buf == (void*) 0) {
                api.context_dispose(ctx);
                this.err_ = "LLVM memory buffer creation failed";
                this.code_ = 2;
                return 2;
            }
            void* m = (void*) 0;
            char* perr = (char*) 0;
            int bad = api.parse_ir_in_context(ctx, buf, &m, &perr);
            if (bad != 0 || m == (void*) 0) {
                if (perr != (char*) 0) {
                    this.err_ = perr;
                } else {
                    this.err_ = "LLVM IR parse error";
                }
                api.context_dispose(ctx);
                this.code_ = 3;
                return 3;
            }

            // 4) Host triple; 5) target lookup; 6) TargetMachine.
            char* triple = api.default_target_triple();
            api.set_target(m, triple);
            api.set_data_layout(m, "");

            void* target = (void*) 0;
            char* terr = (char*) 0;
            int trc = api.target_from_triple(triple, &target, &terr);
            if (trc != 0 || target == (void*) 0) {
                if (terr != (char*) 0) {
                    this.err_ = terr;
                } else {
                    this.err_ = "LLVM target lookup failed";
                }
                api.message_dispose(triple);
                api.module_dispose(m);
                api.context_dispose(ctx);
                this.code_ = 4;
                return 4;
            }

            void* tm = api.create_target_machine(target, triple, "", "", 2, 0, 0);
            if (tm == (void*) 0) {
                this.err_ = "LLVM TargetMachine creation failed";
                api.message_dispose(triple);
                api.module_dispose(m);
                api.context_dispose(ctx);
                this.code_ = 5;
                return 5;
            }
            api.message_dispose(triple);

            void* td = api.create_target_data_layout(tm);
            api.set_module_data_layout(m, td);
            api.dispose_target_data(td);

            // 7) Emit the object file (LLVMCodeGenFileType::LLVMObjectFile = 1).
            char* eerr = (char*) 0;
            int erc = api.target_machine_emit_to_file(tm, m, out_path, 1, &eerr);
            if (erc != 0) {
                if (eerr != (char*) 0) {
                    this.err_ = eerr;
                } else {
                    this.err_ = "LLVM TargetMachine cannot emit object file for this target";
                }
                api.dispose_target_machine(tm);
                api.module_dispose(m);
                api.context_dispose(ctx);
                this.code_ = 6;
                return 6;
            }

            api.dispose_target_machine(tm);
            api.module_dispose(m);
            api.context_dispose(ctx);
            return 0;
        }
    }

    const char* err() {
        return this.err_;
    }

    long code() {
        return this.code_;
    }
};

// ---------------------------------------------------------------------------
// H6.4: growable byte buffer
//
// The Ivy CLI has no std::string, so command lines are assembled in this small
// growable buffer. `add` copies `n` bytes with `__ivy_memcpy` (the source may
// be a const string literal, a caller-owned path or the getenv() value).
// `str()` always returns a NUL-terminated buffer that stays valid until
// `release()` or the next mutation.
// ---------------------------------------------------------------------------

struct StrBuf {
    char* data_;
    unsigned long long len_;
    unsigned long long cap_;

    void setup(unsigned long long cap) {
        unsafe {
            if (cap < 32) {
                cap = 32;
            }
            this.data_ = (char*) __ivy_alloc(cap);
            this.len_ = 0;
            this.cap_ = cap;
            this.data_[0] = 0;
        }
    }

    void ensure(unsigned long long extra) {
        unsafe {
            unsigned long long need = this.len_ + extra + 1;
            if (need <= this.cap_) {
                return;
            }
            unsigned long long ncap = this.cap_ * 2;
            while (ncap < need) {
                ncap = ncap * 2;
            }
            char* grown = (char*) __ivy_alloc(ncap);
            __ivy_memcpy(grown, this.data_, this.len_ + 1);
            __ivy_free(this.data_);
            this.data_ = grown;
            this.cap_ = ncap;
        }
    }

    void add(const char* s) {
        unsafe {
            // The Ivy parser rejects `(const char*) 0`, so compare through a
            // `char*` view (the value is never written through it).
            char* p = (char*) s;
            if (p == (char*) 0) {
                return;
            }
            unsigned long long n = __ivy_strlen(s);
            this.ensure(n);
            __ivy_memcpy(this.data_ + this.len_, s, n);
            this.len_ = this.len_ + n;
            this.data_[this.len_] = 0;
        }
    }

    void add_char(char c) {
        unsafe {
            this.ensure(1);
            this.data_[this.len_] = c;
            this.len_ = this.len_ + 1;
            this.data_[this.len_] = 0;
        }
    }

    // Appends `"s"` - the oracle quotes every path it puts on the linker
    // command line (`codegen.cpp:2998-3011`).
    void add_quoted(const char* s) {
        this.add_char(34);
        this.add(s);
        this.add_char(34);
    }

    const char* str() {
        return this.data_;
    }

    long length() {
        unsafe {
            return (long) this.len_;
        }
    }

    void release() {
        unsafe {
            if (this.data_ != (char*) 0) {
                __ivy_free(this.data_);
            }
            this.data_ = (char*) 0;
            this.len_ = 0;
            this.cap_ = 0;
        }
    }
};

// ---------------------------------------------------------------------------
// H6.4: linker orchestration
//
// Mirror of `CodeGen::linkExecutable` (`src/codegen/codegen.cpp:2810-3063`)
// for the single-module subset of the selfhost port. Per run:
//
//   1. temp object path next to the exe: `<dir>/<stem>__tmp.obj`;
//   2. emit it through `ObjEmit` (the H6.3 `emitObject` mirror);
//   3. locate the linker: `IVY_LINKER`, else the first line of
//      `_popen("where clang++")`;
//   4. run `"<linker>" "<obj>" -o "<exe>" "<ivyrt>"` (every path quoted);
//   5. delete the temp object on success, keep it on failure.
//
// Out of subset (documented in H64_NOTES.md): `import cpp` / `import c` header
// objects, `-D1` module objects, `--crt-static`. The oracle appends those to
// the same command line; none of them exist in the H6 corpus.
//
// `code()` values: 0 success, 1 object emission failed, 2 no linker found,
// 3 linker exited non-zero. `emit_code()` is the `ObjEmit` code (1-6) when
// `code() == 1`. `link_rc()` is the linker process exit status when
// `code() == 3`. `err()` is the detail message (no path prefix) and `cmd()`
// is the exact command line handed to the linker (kept alive until the next
// `link_text` call; the driver prints it in the failure diagnostic).
// ---------------------------------------------------------------------------

export struct Linker {
    long tag;
    long code_;
    long emit_code_;
    long link_rc_;
    const char* err_;
    char* cmd_own_;
    // H8.1: the `.obj` files of the imported modules (D1).  The oracle
    // appends them to the command line right after the main object
    // (codegen.cpp:3005-3008); the driver fills them from the import list.
    char** mods_;
    long nmod_;
    long capmod_;
    // H9.4: `--self-link` extras (rendered fragments: paths keep their quotes,
    // flags stay bare), appended after the runtime in harness order.
    long self_link_;
    char** extra_;
    long nextra_;
    long capextra_;

    // `CodeGen::setModuleObjects` / `moduleObjPaths_.push_back` (D1).
    void add_module_object(const char* p) {
        unsafe {
            if (this.nmod_ >= this.capmod_) {
                long ncap = this.capmod_ * 2;
                if (ncap < 4) { ncap = 4; }
                char** nb = (char**) __ivy_alloc((unsigned long long) (ncap * 8));
                long k = 0;
                while (k < this.nmod_) {
                    // H9.4 workaround (oracle bug H29): an assignment through a
                    // `char**` element is emitted as an unscaled `i8` GEP,
                    // while the read is a correct `ptr` GEP.  Copy the pointer
                    // with __ivy_memcpy to avoid the buggy store path.
                    char* v = this.mods_[k];
                    __ivy_memcpy((void*) ((char*) nb + (k * 8)), (void*) &v, 8);
                    k = k + 1;
                }
                if (this.mods_ != (char**) 0) {
                    __ivy_free((void*) this.mods_);
                }
                this.mods_ = nb;
                this.capmod_ = ncap;
            }
            char* pv = (char*) p;
            __ivy_memcpy((void*) ((char*) this.mods_ + (this.nmod_ * 8)), (void*) &pv, 8);
            this.nmod_ = this.nmod_ + 1;
        }
    }

    // --- H9.4: self-link support -------------------------------------------
    //
    // `--self-link` makes the compiler link its own executable.  The oracle's
    // `linkExecutable` cannot do that: it appends only the program object(s)
    // and the Ivy runtime, while the compiler also needs the static LLVM
    // libraries and the Windows system libraries.  The driver collects those
    // with `llvm-config` (the same filtering as
    // `selfhost/app/bootstrap_smoke.ps1`) and hands the rendered fragments to
    // `add_extra`; when `self_link_` is set, `link_text` appends them after the
    // runtime and moves `-o` to the end, matching the harness link line.

    void set_self_link(long on) {
        this.self_link_ = on;
    }

    // Append one already-rendered fragment (paths include their quotes, flags
    // do not).  Never freed: the driver links once and exits.
    void add_extra(const char* frag) {
        unsafe {
            if (this.nextra_ >= this.capextra_) {
                long ncap = this.capextra_ * 2;
                if (ncap < 4) { ncap = 4; }
                char** nb = (char**) __ivy_alloc((unsigned long long) (ncap * 8));
                long k = 0;
                while (k < this.nextra_) {
                    // H9.4 workaround (oracle bug H29), same as
                    // `add_module_object`.
                    char* v = this.extra_[k];
                    __ivy_memcpy((void*) ((char*) nb + (k * 8)), (void*) &v, 8);
                    k = k + 1;
                }
                if (this.extra_ != (char**) 0) {
                    __ivy_free((void*) this.extra_);
                }
                this.extra_ = nb;
                this.capextra_ = ncap;
            }
            char* fv = (char*) frag;
            __ivy_memcpy((void*) ((char*) this.extra_ + (this.nextra_ * 8)), (void*) &fv, 8);
            this.nextra_ = this.nextra_ + 1;
        }
    }

    bool file_exists(const char* p) {
        return _access(p, 0) == 0;
    }

    // `<dir>\<name>`; LLVM on Windows keeps `bin\` and `lib\` under one root.
    char* join2(const char* dir, const char* name) {
        unsafe {
            long dl = (long) __ivy_strlen(dir);
            long nl = (long) __ivy_strlen(name);
            char* r = (char*) __ivy_alloc((unsigned long long) (dl + nl + 2));
            long k = 0;
            while (k < dl) { r[k] = dir[k]; k = k + 1; }
            r[dl] = 92;
            k = 0;
            while (k < nl) { r[dl + 1 + k] = name[k]; k = k + 1; }
            r[dl + 1 + nl] = 0;
            return r;
        }
        unsafe { return (char*)0; }
    }

    // `"<exe>" <arg>` for `_popen`.
    char* quote_join(const char* exe, const char* arg) {
        unsafe {
            StrBuf sb;
            sb.setup((unsigned long long) (__ivy_strlen(exe) + __ivy_strlen(arg) + 4));
            sb.add_char(34);
            sb.add(exe);
            sb.add_char(34);
            sb.add_char(32);
            sb.add(arg);
            char* out = __ivy_strdup(sb.str());
            sb.release();
            return out;
        }
        unsafe { return (char*)0; }
    }

    // Run `command`, return its stdout as an owned NUL-terminated buffer.
    char* capture_cmd(const char* command) {
        unsafe {
            void* pipe = _popen(command, "r");
            if (pipe == (void*) 0) {
                char* empty = (char*) __ivy_alloc(1);
                empty[0] = 0;
                return empty;
            }
            StrBuf sb;
            sb.setup(4096);
            char* line = (char*) __ivy_alloc(8192);
            char* got = fgets(line, 8192, pipe);
            while (got != (char*) 0) {
                sb.add(line);
                got = fgets(line, 8192, pipe);
            }
            __ivy_free(line);
            _pclose(pipe);
            char* out = __ivy_strdup(sb.str());
            sb.release();
            return out;
        }
        unsafe { return (char*)0; }
    }

    bool is_space(char c) {
        return c == 32 || c == 9 || c == 10 || c == 13;
    }

    // Trim trailing CR/LF/space/tab in place.
    void trim_end(char* s) {
        unsafe {
            long n = (long) __ivy_strlen(s);
            while (n > 0) {
                char c = s[n - 1];
                if (c == 10 || c == 13 || c == 32 || c == 9) {
                    n = n - 1;
                } else {
                    break;
                }
            }
            s[n] = 0;
        }
    }

    // LLVM root: `$LLVM_ROOT`, then the historical `D:\Cpp\Clang`, then
    // `llvm-config --prefix`.  Returns an owned string (possibly empty).
    char* llvm_root(const char* cfg) {
        unsafe {
            char* env = getenv("LLVM_ROOT");
            if (env != (char*) 0 && env[0] != 0) {
                return __ivy_strdup(env);
            }
            char* probe = this.join2((char*) "D:\\Cpp\\Clang", "bin\\llvm-config.exe");
            bool ok = this.file_exists(probe);
            __ivy_free(probe);
            if (ok) {
                return __ivy_strdup("D:\\Cpp\\Clang");
            }
            char* cmd = this.quote_join(cfg, "--prefix");
            char* out = this.capture_cmd(cmd);
            __ivy_free(cmd);
            this.trim_end(out);
            return out;
        }
        unsafe { return (char*)0; }
    }

    // Lowercase `s` into a fresh buffer (the SDK list is lowercase).
    char* lower_dup(const char* s) {
        unsafe {
            long n = (long) __ivy_strlen(s);
            char* r = (char*) __ivy_alloc((unsigned long long) (n + 1));
            long k = 0;
            while (k < n) {
                int c = (int) s[k];
                if (c >= 65 && c <= 90) { c = c + 32; }
                r[k] = (char) c;
                k = k + 1;
            }
            r[n] = 0;
            return r;
        }
        unsafe { return (char*)0; }
    }

    // `list` is a space-separated lowercase list; exact token match.
    bool in_list(const char* list, const char* name) {
        unsafe {
            long nl = (long) __ivy_strlen(name);
            long i = 0;
            while (list[i] != 0) {
                while (list[i] == 32) { i = i + 1; }
                long start = i;
                while (list[i] != 0 && list[i] != 32) { i = i + 1; }
                if (i - start == nl) {
                    bool same = true;
                    long k = 0;
                    while (k < nl) {
                        if (list[start + k] != name[k]) { same = false; break; }
                        k = k + 1;
                    }
                    if (same) { return true; }
                }
            }
        }
        return false;
    }

    // Case-insensitive `.lib` suffix (PowerShell's `-match` is insensitive).
    bool ends_with_lib(const char* s) {
        unsafe {
            long n = (long) __ivy_strlen(s);
            if (n < 4) { return false; }
            int a = (int) s[n - 4];
            int b = (int) s[n - 3];
            int c = (int) s[n - 2];
            int d = (int) s[n - 1];
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (d >= 65 && d <= 90) { d = d + 32; }
            return a == 46 && b == 108 && c == 105 && d == 98;
        }
        return false;
    }

    // One `llvm-config --system-libs` token: SDK libraries become `-l<base>`;
    // a non-SDK `.lib` that is not installed anywhere is dropped, exactly like
    // `bootstrap_smoke.ps1`.
    void collect_system_lib(const char* tok, const char* libdir) {
        unsafe {
            if (!this.ends_with_lib(tok)) {
                this.add_extra(__ivy_strdup(tok));
                return;
            }
            long n = (long) __ivy_strlen(tok);
            long bl = n - 4;
            char* base = (char*) __ivy_alloc((unsigned long long) (bl + 1));
            long k = 0;
            while (k < bl) { base[k] = tok[k]; k = k + 1; }
            base[bl] = 0;

            bool installed = false;
            char* cand = this.join2(libdir, tok);
            if (this.file_exists(cand)) { installed = true; }
            __ivy_free(cand);
            if (!installed) {
                char* env = getenv("LIB");
                if (env != (char*) 0 && env[0] != 0) {
                    long i = 0;
                    while (env[i] != 0 && !installed) {
                        while (env[i] == 59) { i = i + 1; }  // ';'
                        long start = i;
                        while (env[i] != 0 && env[i] != 59) { i = i + 1; }
                        if (i > start) {
                            char* dir = (char*) __ivy_alloc((unsigned long long) (i - start + 1));
                            long m = start;
                            long o = 0;
                            while (m < i) { dir[o] = env[m]; o = o + 1; m = m + 1; }
                            dir[o] = 0;
                            char* c2 = this.join2(dir, tok);
                            if (this.file_exists(c2)) { installed = true; }
                            __ivy_free(c2);
                            __ivy_free(dir);
                        }
                    }
                }
            }

            char* low = this.lower_dup(base);
            char* sdk = (char*) "advapi32 bcrypt comdlg32 crypt32 dbghelp gdi32 imm32 iphlpapi kernel32 mpr mfuuid netapi32 ntdll ole32 oleacc oleaut32 powrprof psapi secur32 setupapi shell32 shlwapi user32 uuid version wbemuuid winhttp winmm ws2_32 wsock32";
            if (!installed && !this.in_list(sdk, low)) {
                __ivy_free(low);
                __ivy_free(base);
                return;
            }
            __ivy_free(low);

            char* frag = (char*) __ivy_alloc((unsigned long long) (bl + 3));
            frag[0] = 45;   // '-'
            frag[1] = 108;  // 'l'
            k = 0;
            while (k < bl) { frag[2 + k] = base[k]; k = k + 1; }
            frag[bl + 2] = 0;
            this.add_extra(frag);
            __ivy_free(base);
        }
    }

    void add_quoted_extra(const char* p) {
        unsafe {
            StrBuf sb;
            sb.setup((unsigned long long) (__ivy_strlen(p) + 4));
            sb.add_char(34);
            sb.add(p);
            sb.add_char(34);
            this.add_extra(__ivy_strdup(sb.str()));
            sb.release();
        }
    }

    // Split `llvm-config` output on whitespace.  `system == 0`: `--libs x86`
    // (full library paths, always kept and quoted); `system != 0`:
    // `--system-libs` (filtered by `collect_system_lib`).
    void collect_libs(const char* text, const char* libdir, long system) {
        unsafe {
            long n = (long) __ivy_strlen(text);
            long i = 0;
            while (i < n) {
                while (i < n && this.is_space(text[i])) { i = i + 1; }
                long start = i;
                while (i < n && !this.is_space(text[i])) { i = i + 1; }
                if (i > start) {
                    long len = i - start;
                    char* tok = (char*) __ivy_alloc((unsigned long long) (len + 1));
                    long k = 0;
                    while (k < len) { tok[k] = text[start + k]; k = k + 1; }
                    tok[len] = 0;
                    if (system != 0) {
                        this.collect_system_lib(tok, libdir);
                    } else {
                        this.add_quoted_extra(tok);
                    }
                    __ivy_free(tok);
                }
            }
        }
    }

    // Mirror `bootstrap_smoke.ps1`'s link line: `llvm-config --libs x86`
    // (full paths), `llvm-config --system-libs` (SDK names become `-l<name>`,
    // missing non-SDK libraries are dropped), then `-Wl,/Brepro`.
    void collect_self_link() {
        unsafe {
            char* cfg = (char*)0;
            char* env = getenv("LLVM_ROOT");
            if (env != (char*) 0 && env[0] != 0) {
                char* cand = this.join2(env, "bin\\llvm-config.exe");
                if (this.file_exists(cand)) { cfg = cand; } else { __ivy_free(cand); }
            }
            if (cfg == (char*) 0) {
                char* cand = this.join2((char*) "D:\\Cpp\\Clang", "bin\\llvm-config.exe");
                if (this.file_exists(cand)) { cfg = cand; } else { __ivy_free(cand); }
            }
            if (cfg == (char*) 0) {
                cfg = __ivy_strdup("llvm-config");
            }
            char* root = this.llvm_root(cfg);
            char* libdir = this.join2(root, "lib");
            char* cmd = this.quote_join(cfg, "--libs x86");
            char* out = this.capture_cmd(cmd);
            this.collect_libs(out, libdir, 0);
            __ivy_free(out);
            __ivy_free(cmd);
            cmd = this.quote_join(cfg, "--system-libs");
            out = this.capture_cmd(cmd);
            this.collect_libs(out, libdir, 1);
            __ivy_free(out);
            __ivy_free(cmd);
            this.add_extra(__ivy_strdup("-Wl,/Brepro"));
            __ivy_free(libdir);
            __ivy_free(root);
            __ivy_free(cfg);
        }
    }

    // `<dir>/<stem>__tmp.obj`, mirroring `exeP.parent_path() / (stem +
    // "__tmp" + ".obj")` (codegen.cpp:2813-2822). Both separators are
    // accepted; the parent prefix is copied verbatim. A leading dot is not
    // treated as an extension, like std::filesystem::path::stem().
    char* temp_obj_path(const char* exe_path) {
        unsafe {
            long n = (long) __ivy_strlen(exe_path);
            long sep = -1;
            long i = 0;
            while (i < n) {
                if (exe_path[i] == 92 || exe_path[i] == 47) {
                    sep = i;
                }
                i = i + 1;
            }
            long start = sep + 1;
            long dot = -1;
            i = n;
            while (i > start) {
                i = i - 1;
                if (exe_path[i] == 46) {
                    dot = i;
                    break;
                }
            }
            if (dot == start) {
                dot = -1;
            }
            long stem_end = n;
            if (dot >= 0) {
                stem_end = dot;
            }

            char* out = (char*) __ivy_alloc((unsigned long long) (n + 16));
            long o = 0;
            i = 0;
            while (i < start) {
                out[o] = exe_path[i];
                o = o + 1;
                i = i + 1;
            }
            i = start;
            while (i < stem_end) {
                out[o] = exe_path[i];
                o = o + 1;
                i = i + 1;
            }
            const char* suffix = "__tmp.obj";
            i = 0;
            while (suffix[i] != 0) {
                out[o] = suffix[i];
                o = o + 1;
                i = i + 1;
            }
            out[o] = 0;
            return out;
        }
    }

    // `IVY_LINKER` first, then `where clang++` (codegen.cpp:2830-2860).
    // Returns an owned copy, or null when neither yields a path.
    char* find_linker() {
        unsafe {
            char* env = getenv("IVY_LINKER");
            if (env != (char*) 0 && env[0] != 0) {
                return __ivy_strdup(env);
            }

            void* pipe = _popen("where clang++", "r");
            if (pipe == (void*) 0) {
                return (char*) 0;
            }
            char* buf = (char*) __ivy_alloc(1024);
            char* got = fgets(buf, 1024, pipe);
            char* found = (char*) 0;
            if (got != (char*) 0) {
                long n = (long) __ivy_strlen(buf);
                while (n > 0 && (buf[n - 1] == 10 || buf[n - 1] == 13)) {
                    buf[n - 1] = 0;
                    n = n - 1;
                }
                if (n > 0) {
                    found = __ivy_strdup(buf);
                }
            }
            __ivy_free(buf);
            _pclose(pipe);
            return found;
        }
    }

    int link_text(const char* ir, unsigned long long len, const char* exe_path,
                  const char* ivyrt_lib) {
        unsafe {
            this.code_ = 0;
            this.emit_code_ = 0;
            this.link_rc_ = 0;
            this.err_ = "";
            // A previous command buffer is intentionally not freed: the
            // driver calls link_text once and exits.
            this.cmd_own_ = (char*) 0;

            char* obj_path = this.temp_obj_path(exe_path);

            // 2) Emit the object file.
            ObjEmit oe;
            int erc = oe.emit_text(ir, len, obj_path);
            if (erc != 0) {
                this.code_ = 1;
                this.emit_code_ = oe.code();
                this.err_ = oe.err();
                __ivy_free(obj_path);
                return 1;
            }

            // 3) Locate the linker.
            char* linker = this.find_linker();
            if (linker == (char*) 0 || linker[0] == 0) {
                if (linker != (char*) 0) {
                    __ivy_free(linker);
                }
                remove(obj_path);
                __ivy_free(obj_path);
                this.code_ = 2;
                this.err_ = "cannot locate a linker (clang++); set IVY_LINKER or add clang++ to PATH";
                return 2;
            }

            // 4) Build the command line: "linker" "obj" ["mods"...] -o "exe"
            //    ["ivyrt"], or with `--self-link` the harness spelling
            //    "linker" "obj" ["mods"...] "ivyrt" [extras] -o "exe".
            StrBuf cmd;
            cmd.setup(256);
            cmd.add_quoted(linker);
            cmd.add_char(32);
            cmd.add_quoted(obj_path);
            // D1: imported module objects, before `-o` (codegen.cpp:3005-3008).
            long mo = 0;
            while (mo < this.nmod_) {
                cmd.add_char(32);
                cmd.add_quoted(this.mods_[mo]);
                mo = mo + 1;
            }
            char* rt = (char*) ivyrt_lib;
            if (this.self_link_ != 0) {
                // H9.4: the harness link line is
                //   <objs> <rt.obj> <llvm libs> <system libs> -Wl,/Brepro -o <exe>
                // so `-o` moves to the end and the collected extras follow the
                // runtime.
                if (rt != (char*) 0 && rt[0] != 0) {
                    cmd.add_char(32);
                    cmd.add_quoted(ivyrt_lib);
                }
                long ex = 0;
                while (ex < this.nextra_) {
                    cmd.add_char(32);
                    cmd.add(this.extra_[ex]);
                    ex = ex + 1;
                }
                cmd.add(" -o ");
                cmd.add_quoted(exe_path);
            } else {
                cmd.add(" -o ");
                cmd.add_quoted(exe_path);
                if (rt != (char*) 0 && rt[0] != 0) {
                    cmd.add_char(32);
                    cmd.add_quoted(ivyrt_lib);
                }
            }
            // Keep the buffer (no release): `cmd()` must stay valid.
            this.cmd_own_ = (char*) cmd.str();

            // 5) Run it. system() goes through cmd.exe, which strips the
            // first and last quote when the command line holds more than two
            // quotes; wrapping the whole line in one extra pair makes cmd.exe
            // remove that pair and hand the real quoting to the linker. The
            // executed string is therefore `"<cmd>"`, while `cmd()` keeps the
            // oracle's un-wrapped spelling for diagnostics.
            StrBuf run;
            run.setup((unsigned long long) (cmd.length() + 8));
            run.add_char(34);
            run.add(this.cmd_own_);
            run.add_char(34);
            int rc = system(run.str());
            run.release();

            this.link_rc_ = (long) rc;
            if (rc != 0) {
                // Link failed - keep the temp object for debugging.
                this.code_ = 3;
                __ivy_free(linker);
                __ivy_free(obj_path);
                return 3;
            }

            // 6) Clean up the temporary object file.
            remove(obj_path);
            __ivy_free(linker);
            __ivy_free(obj_path);
            return 0;
        }
    }

    long code() {
        return this.code_;
    }

    long emit_code() {
        return this.emit_code_;
    }

    long link_rc() {
        return this.link_rc_;
    }

    const char* err() {
        return this.err_;
    }

    const char* cmd() {
        unsafe {
            if (this.cmd_own_ == (char*) 0) {
                return "";
            }
        }
        return this.cmd_own_;
    }
};
