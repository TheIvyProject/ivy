// ---------------------------------------------------------------------------
// Target and object emission (llvm-c/Target.h, llvm-c/TargetMachine.h)
//
// LLVMInitializeNativeTarget is a static inline helper in Target.h, not an
// exported symbol, so the host X86 initializers are bound directly. They are
// only resolved when H6.3 links the X86 target libraries.
// ---------------------------------------------------------------------------

extern "C" char* LLVMGetDefaultTargetTriple();
extern "C" char* LLVMGetHostCPUName();
extern "C" char* LLVMGetHostCPUFeatures();
extern "C" int   LLVMGetTargetFromTriple(const char* triple, void** target,
                                         char** error_message);
extern "C" void* LLVMCreateTargetMachine(void* target, const char* triple,
                                         const char* cpu, const char* features,
                                         int level, int reloc, int code_model);
extern "C" void  LLVMDisposeTargetMachine(void* target_machine);
extern "C" void* LLVMCreateTargetDataLayout(void* target_machine);
extern "C" void  LLVMSetModuleDataLayout(void* m, void* target_data);
extern "C" void  LLVMDisposeTargetData(void* target_data);
extern "C" int   LLVMTargetMachineEmitToFile(void* target_machine, void* m,
                                             const char* filename, int codegen,
                                             char** error_message);

extern "C" void LLVMInitializeX86TargetInfo();
extern "C" void LLVMInitializeX86Target();
extern "C" void LLVMInitializeX86TargetMC();
extern "C" void LLVMInitializeX86AsmPrinter();
extern "C" void LLVMInitializeX86AsmParser();

// ---------------------------------------------------------------------------
// Exported facade
//
// Ivy does not export `extern "C"` declarations, so importers (the H6.1 smoke
// driver and later emitter modules) go through this pass-through struct. The
// methods add no policy: each one forwards to the C API unchanged.
// ---------------------------------------------------------------------------

export struct LlvmC {
    long tag;

    void* context_create() {
        unsafe {
            return LLVMContextCreate();
        }
    }

    void context_dispose(void* c) {
        unsafe {
            LLVMContextDispose(c);
        }
    }

    void* module_create(const char* module_id, void* c) {
        unsafe {
            return LLVMModuleCreateWithNameInContext(module_id, c);
        }
    }

    void module_dispose(void* m) {
        unsafe {
            LLVMDisposeModule(m);
        }
    }

    char* module_print(void* m) {
        unsafe {
            return LLVMPrintModuleToString(m);
        }
    }

    void message_dispose(char* message) {
        unsafe {
            LLVMDisposeMessage(message);
        }
    }

    int module_verify(void* m, int action) {
        unsafe {
            char* err = (char*) 0;
            int bad = LLVMVerifyModule(m, action, &err);
            if (err != (char*) 0) {
                LLVMDisposeMessage(err);
            }
            return bad;
        }
    }

    void* void_type(void* c) {
        unsafe {
            return LLVMVoidTypeInContext(c);
        }
    }

    void* int32_type(void* c) {
        unsafe {
            return LLVMInt32TypeInContext(c);
        }
    }

    void* function_type(void* return_type, void** param_types,
                        unsigned int param_count, int is_var_arg) {
        unsafe {
            return LLVMFunctionType(return_type, param_types, param_count, is_var_arg);
        }
    }

    void* add_function(void* m, const char* name, void* function_ty) {
        unsafe {
            return LLVMAddFunction(m, name, function_ty);
        }
    }

    void* append_block(void* c, void* func, const char* name) {
        unsafe {
            return LLVMAppendBasicBlockInContext(c, func, name);
        }
    }

    void* create_builder(void* c) {
        unsafe {
            return LLVMCreateBuilderInContext(c);
        }
    }

    void position_at_end(void* builder, void* block) {
        unsafe {
            LLVMPositionBuilderAtEnd(builder, block);
        }
    }

    void dispose_builder(void* builder) {
        unsafe {
            LLVMDisposeBuilder(builder);
        }
    }

    void* build_ret_void(void* builder) {
        unsafe {
            return LLVMBuildRetVoid(builder);
        }
    }

    void* build_ret(void* builder, void* v) {
        unsafe {
            return LLVMBuildRet(builder, v);
        }
    }

    void* const_int(void* int_ty, unsigned long long n, int sign_extend) {
        unsafe {
            return LLVMConstInt(int_ty, n, sign_extend);
        }
    }
};
