    // The concept definitions of the translation unit.
    AConcept* concepts() {
        unsafe {
            return this.conpool_;
        }
    }

    long concept_count() {
        return this.con_n_;
    }

    AConcept get_concept(long i) {
        unsafe {
            if (i < this.con_n_) {
                return this.conpool_[i];
            }
            return this.conpool_[0];
        }
    }

    // The raw text of the `i`-th concept requirement.
    const char* requirement_text(long i) {
        unsafe {
            if (i < this.req_n_) {
                return reinterpret_cast<const char*>(this.reqpool_[i]);
            }
            return "";
        }
    }

    // --- declarations -----------------------------------------------------

    void parse_constexpr_spec() {
        this.ce_ = 0;
        this.cv_ = 0;
        while (this.kw("constexpr") || this.kw("consteval")) {
            if (this.kw("constexpr")) {
                this.ce_ = 1;
                this.next();
            } else {
                this.cv_ = 1;
                this.ce_ = 1;
                this.next();
            }
        }
    }

    // A5: parse `lifetime<$a, $b, ...>` — the declared lifetime names
    // (without the leading `$`).  The caller checks that the `lifetime`
    // keyword is the current token.
    ALifetimeList parse_lifetime_decl() {
        ALifetimeList res;
        unsafe {
            res.items = (ALifetime*)0;
        }
        res.n = 0;
        this.next();  // `lifetime`
        if (!this.at("<")) {
            this.error_at(this.peek(0), "expected '<' after 'lifetime'");
            return res;
        }
        this.next();
        long start = this.lt_n_;
        while (!this.at(">") && !this.at("eof")) {
            if (!this.at_lifetime()) {
                this.error_at(this.peek(0), "expected a lifetime variable ($name) in lifetime<...>");
                this.synchronize();
                unsafe {
                    res.items = this.ltpool_ + start;
                }
                res.n = this.lt_n_ - start;
                return res;
            }
            Token lt = this.next();
            unsafe {
                const char* name = this.intern_lifetime(lt);
                // A duplicated name is an error, but the declaration
                // continues.
                long i = 0;
                bool dup = false;
                while (i < this.lt_n_ - start) {
                    if (this.cstr_eq(this.ltpool_[start + i].name, name)) {
                        dup = true;
                    }
                    i = i + 1;
                }
                if (dup) {
                    this.error_at(this.peek(0), this.dup_lt_msg(name));
                } else {
                    this.push_lifetime(name);
                }
            }
            if (this.at(",")) {
                this.next();
            } else {
                break;
            }
        }
        this.expect(">", "expected '>' to close lifetime<...>");
        unsafe {
            res.items = this.ltpool_ + start;
        }
        res.n = this.lt_n_ - start;
        return res;
    }

    AParamList parse_params() {
        long start = this.pp_n_;
        long va = 0;
        while (!this.at(")") && !this.at("eof")) {
            if (this.at("...")) {
                this.next();
                va = 1;
                return this.make_param_list(start, va);
            }
            AParam p;
            Token pstart = this.peek(0);
            p.line = pstart.line;
            p.col = pstart.col;
            p.name = "";
            p.default_value = -1;
            unsafe {
                p.attrs = this.apool_;
            }
            p.nattrs = 0;
            unsafe {
                p.lt_names.items = (ALifetime*)0;
                p.lt_names.n = 0;
                p.legacy_lts.items = (ALegacyLifetime*)0;
                p.legacy_lts.n = 0;
            }
            p.type = this.parse_type();
            if (this.at("...")) {
                this.next();  // parameter pack marker
            }
            // A5: the native lifetime annotation of the parameter
            // (`const int32& $a x`).
            if (this.at_lifetime()) {
                Token lt = this.next();
                p.lt_names = this.one_lt(this.intern_lifetime(lt));
            }
            if (this.at("identifier")) {
                p.name = this.intern_tok(this.next());
            } else if (this.at("[") && this.kind_eq(this.peek(1), "[")) {
                // An attribute on an unnamed parameter: the name has to
                // come first.
                this.error_at(this.peek(0), "attribute must follow the parameter name");
            }
            long pa_start = this.ap_n_;
            AAttrList pa = this.parse_attrs();
            unsafe {
                p.attrs = this.apool_ + pa_start;
            }
            p.nattrs = this.ap_n_ - pa_start;
            this.validate_list(pa, "lt", "");
            // A5: the legacy lifetime annotation of the parameter
            // (`[[ivy::lt(a)]]`).
            p.legacy_lts = this.collect_legacy_lts(pa);
            // Default argument: `= expr` — fills in the missing argument
            // at the call site.
            if (this.at("=")) {
                this.next();
                p.default_value = this.parse_expr();
            }
            this.push_param(p);
            if (!this.at(")")) {
                this.expect(",", "expected ',' between parameters");
                if (this.at(")")) {
                    return this.make_param_list(start, va);
                }
            }
        }
        return this.make_param_list(start, va);
    }

    AParamList make_param_list(long start, long va) {
        AParamList l;
        unsafe {
            l.items = this.ppool_ + start;
        }
        l.n = this.pp_n_ - start;
        l.variadic = va;
        return l;
    }

    // --- expressions ------------------------------------------------------

    AType empty_type() {
        AType t;
        t.base = "";
        unsafe { t.tpl_args = (AType*)0; }
        t.tpl_n = 0;
        t.is_unsigned = 0;
        t.is_const = 0;
        t.is_ref = 0;
        t.ptr_depth = 0;
        t.array_size = 0;
        return t;
    }

    AExpr fresh(long kind) {
        AExpr e;
        e.kind = kind;
        e.ival = 0;
        e.sval = "";
        e.flag = 0;
        e.a = -1;
        e.b = -1;
        e.c = -1;
        e.astart = -1;
        e.an = 0;
        e.type = this.empty_type();
        e.is_scope = 0;
        e.line = 0;
        e.col = 0;
        e.fval = 0.0;
        unsafe { e.tpl_args = (AType*)0; }
        e.tpl_n = 0;
        return e;
    }

    AStmt fresh_stmt(long kind) {
        AStmt s;
        s.kind = kind;
        s.sval = "";
        s.type = this.empty_type();
        s.flag = 0;
        s.a = -1;
        s.b = -1;
        s.c = -1;
        s.sstart = -1;
        s.sn = 0;
        s.next = -1;
        s.line = 0;
        s.col = 0;
        return s;
    }

    long push_case(long value, long sstart, long sn) {
        long i = this.cp_n_;
        if (this.cp_n_ < this.cp_cap_) {
            unsafe {
                this.casepool_[this.cp_n_].value = value;
                this.casepool_[this.cp_n_].sstart = sstart;
                this.casepool_[this.cp_n_].sn = sn;
            }
            this.cp_n_ = this.cp_n_ + 1;
        }
        return i;
    }

    long push_expr(AExpr e) {
        long i = this.ep_n_;
        if (this.ep_n_ < this.ep_cap_) {
            unsafe {
                this.epool_[this.ep_n_] = e;
            }
            this.ep_n_ = this.ep_n_ + 1;
        }
