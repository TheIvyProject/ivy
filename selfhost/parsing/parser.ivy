            unsafe {
                this.spool_[this.sp_n_] = s;
            }
            this.sp_n_ = this.sp_n_ + 1;
        }
        return i;
    }

    void push_carg(long i) {
        if (this.ca_n_ < this.ca_cap_) {
            unsafe {
                this.cargs_[this.ca_n_] = i;
            }
            this.ca_n_ = this.ca_n_ + 1;
        }
    }

    void set_next(long i, long v) {
        unsafe {
            this.spool_[i].next = v;
        }
    }

    AExpr* exprs() {
        unsafe {
            return this.epool_;
        }
    }

    AStmt* stmts() {
        unsafe {
            return this.spool_;
        }
    }

    long* call_args() {
        unsafe {
            return this.cargs_;
        }
    }

    ACase* cases() {
        unsafe {
            return this.casepool_;
        }
    }

    // The `i`-th case clause of a switch statement.
    ACase get_case(long i) {
        unsafe {
            return this.casepool_[i];
        }
        ACase c;
        c.value = -1;
        c.sstart = -1;
        c.sn = 0;
        return c;
    }

    long digit_val(char c, long base) {
        if (c >= '0' && c <= '9') {
            long v = c - '0';
            if (v < base) {
                return v;
            }
            return -1;
        }
        if (base == 16) {
            if (c >= 'a' && c <= 'f') {
                return 10 + (c - 'a');
            }
            if (c >= 'A' && c <= 'F') {
                return 10 + (c - 'A');
            }
        }
        return -1;
    }

    long parse_int_tok(Token t) {
        long base = 10;
        long i = 0;
        long n = t.len;
        unsafe {
            if (n >= 2 && this.src_[t.off] == '0' &&
                (this.src_[t.off + 1] == 'x' || this.src_[t.off + 1] == 'X')) {
                base = 16;
                i = 2;
            } else if (n >= 2 && this.src_[t.off] == '0' &&
                       (this.src_[t.off + 1] == 'b' || this.src_[t.off + 1] == 'B')) {
                base = 2;
                i = 2;
            } else if (n > 1 && this.src_[t.off] == '0') {
                base = 8;
                i = 1;
            }
            long val = 0;
            while (i < n) {
                char c = this.src_[t.off + i];
                if (c == '\'') {
                    i = i + 1;
                    continue;
                }
                long d = this.digit_val(c, base);
                if (d < 0) {
                    break;
                }
                val = val * base + d;
                i = i + 1;
            }
            return val;
        }
        return 0;
    }

    long bin_prec() {
        Token t = this.peek(0);
        if (this.kind_eq(t, "||")) { return 1; }
        if (this.kind_eq(t, "&&")) { return 2; }
        if (this.kind_eq(t, "|")) { return 3; }
        if (this.kind_eq(t, "^")) { return 4; }
        if (this.kind_eq(t, "&")) { return 5; }
        if (this.kind_eq(t, "==")) { return 6; }
        if (this.kind_eq(t, "!=")) { return 6; }
        if (this.kind_eq(t, "<")) { return 7; }
        if (this.kind_eq(t, ">")) { return 7; }
        if (this.kind_eq(t, "<=")) { return 7; }
        if (this.kind_eq(t, ">=")) { return 7; }
        if (this.kind_eq(t, "<<")) { return 8; }
        if (this.kind_eq(t, ">>")) { return 8; }
        if (this.kind_eq(t, "+")) { return 9; }
        if (this.kind_eq(t, "-")) { return 9; }
        if (this.kind_eq(t, "*")) { return 10; }
        if (this.kind_eq(t, "/")) { return 10; }
        if (this.kind_eq(t, "%")) { return 10; }
        return -1;
    }

    bool is_assign_kind() {
        Token t = this.peek(0);
        return this.kind_eq(t, "=") || this.kind_eq(t, "+=") ||
               this.kind_eq(t, "-=") || this.kind_eq(t, "*=") ||
               this.kind_eq(t, "/=") || this.kind_eq(t, "%=") ||
               this.kind_eq(t, "&=") || this.kind_eq(t, "|=") ||
               this.kind_eq(t, "^=") || this.kind_eq(t, "<<=") ||
               this.kind_eq(t, ">>=");
    }

    bool is_prefix_op(Token t) {
        return this.kind_eq(t, "!") || this.kind_eq(t, "~") ||
               this.kind_eq(t, "-") || this.kind_eq(t, "+") ||
               this.kind_eq(t, "*") || this.kind_eq(t, "&") ||
               this.kind_eq(t, "++") || this.kind_eq(t, "--");
    }

    long parse_expr() {
        Token start = this.peek(0);
        long lhs = this.parse_conditional();
        if (this.is_assign_kind()) {
            Token op = this.next();
            long rhs = this.parse_expr();
            AExpr e = this.fresh(16);
            e.sval = this.intern_tok(op);
            e.a = lhs;
            e.b = rhs;
            e.line = start.line;
            e.col = start.col;
            return this.push_expr(e);
        }
        return lhs;
    }

    long parse_conditional() {
        Token start = this.peek(0);
        long cond = this.parse_binary(1);
        if (this.at("?")) {
            this.next();
            long thenB = this.parse_expr();
            this.expect(":", "expected ':' in conditional expression");
            long elseB = this.parse_conditional();
            AExpr e = this.fresh(12);
            e.a = cond;
            e.b = thenB;
            e.c = elseB;
            e.line = start.line;
            e.col = start.col;
            return this.push_expr(e);
        }
        return cond;
    }

    long parse_binary(long minprec) {
        long lhs = this.parse_unary();
        while (true) {
            long prec = this.bin_prec();
            if (prec < 0 || prec < minprec) {
                break;
            }
            Token op = this.next();
            long rhs = this.parse_binary(prec + 1);
            AExpr e = this.fresh(11);
            e.sval = this.intern_tok(op);
            e.a = lhs;
            e.b = rhs;
            e.line = op.line;
            e.col = op.col;
            lhs = this.push_expr(e);
        }
        return lhs;
    }

    long parse_unary() {
        Token t = this.peek(0);
        if (this.is_prefix_op(t)) {
            Token op = this.next();
            long operand = this.parse_unary();
            AExpr e = this.fresh(10);
            e.sval = this.intern_tok(op);
            e.flag = 1;
            e.a = operand;
            e.line = op.line;
            e.col = op.col;
            return this.push_expr(e);
        }
        return this.parse_postfix(this.parse_primary());
    }

    long parse_call_args() {
        long head = -1;
        long tail = -1;
        while (!this.at(")") && !this.at("eof")) {
            long arg = this.parse_expr();
            if (this.argn_n_ < this.argn_cap_) {
                long node = this.argn_n_;
                unsafe {
                    this.argn_idx_[node] = arg;
                    this.argn_next_[node] = -1;
                }
                if (tail >= 0) {
                    unsafe {
                        this.argn_next_[tail] = node;
                    }
                } else {
                    head = node;
                }
                tail = node;
                this.argn_n_ = node + 1;
            }
            if (!this.at(")")) {
                this.expect(",", "expected ',' between call arguments");
                if (this.at(")")) {
                    break;
                }
            }
        }
        this.expect(")", "expected ')' to close call");
        long astart = this.ca_n_;
        long cur = head;
        while (cur >= 0) {
            long idx = -1;
            long nxt = -1;
            unsafe {
                idx = this.argn_idx_[cur];
                nxt = this.argn_next_[cur];
            }
            this.push_carg(idx);
            cur = nxt;
        }
        return astart;
    }

    long parse_postfix(long lhs) {
        while (true) {
            Token start = this.peek(0);
            if (this.at("::")) {
                this.next();
                if (!this.at("identifier")) {
                    this.error_at(this.peek(0), "expected name after '::'");
                    return lhs;
                }
                AExpr e = this.fresh(15);
                e.sval = this.intern_tok(this.next());
                e.a = lhs;
                e.is_scope = 1;
                e.line = start.line;
                e.col = start.col;
                lhs = this.push_expr(e);
            } else if (this.at("(")) {
                this.next();
                long astart = this.parse_call_args();
                AExpr e = this.fresh(13);
                e.a = lhs;
                e.astart = astart;
                e.an = this.ca_n_ - astart;
                e.line = start.line;
                e.col = start.col;
                lhs = this.push_expr(e);
            } else if (this.at("<")) {
                // Potential explicit template arguments: `func<int>(args)`.
                // The arguments are parsed tentatively; if the list is not
                // followed by a call the position is restored and `<` is left
                // to the binary-operator parser.
                long save = this.pos_;
                long mark = this.argst_n_;
                long nargs = 0;
                this.next();
                long ok = 1;
                if (this.is_type_start() != 0) {
                    while (!this.at(">") && !this.at("eof")) {
                        if (this.is_type_start() == 0) {
                            ok = 0;
                            break;
                        }
                        AType ta = this.parse_type();
                        this.push_arg(ta);
                        nargs = nargs + 1;
                        if (this.at(",")) {
                            this.next();
                        } else {
                            break;
                        }
                    }
                    if (ok != 0 && this.at(">")) {
                        this.next();
                        if (this.at("(")) {
                            this.next();
                            long astart2 = this.parse_call_args();
                            AExpr e = this.fresh(13);
                            e.a = lhs;
                            e.astart = astart2;
                            e.an = this.ca_n_ - astart2;
                            e.tpl_args = this.take_args(mark, nargs);
                            e.tpl_n = nargs;
                            e.line = start.line;
                            e.col = start.col;
                            lhs = this.push_expr(e);
                            continue;
                        }
                    }
                }
                this.pos_ = save;
                this.argst_n_ = mark;
                break;
            } else if (this.at("[")) {
                this.next();
                long idx = this.parse_expr();
                this.expect("]", "expected ']' after index expression");
                AExpr e = this.fresh(14);
                e.a = lhs;
                e.b = idx;
                e.line = start.line;
                e.col = start.col;
                lhs = this.push_expr(e);
            } else if (this.at(".") || this.at("->")) {
                long arrow = this.at("->") ? 1 : 0;
                this.next();
                if (!this.at("identifier")) {
                    this.error_at(this.peek(0), "expected member name after '.' or '->'");
                    return lhs;
                }
                AExpr e = this.fresh(15);
                e.sval = this.intern_tok(this.next());
                e.flag = arrow;
                e.a = lhs;
                e.line = start.line;
                e.col = start.col;
                lhs = this.push_expr(e);
            } else if (this.at("++") || this.at("--")) {
                Token op = this.next();
                AExpr e = this.fresh(10);
                e.sval = this.intern_tok(op);
                e.a = lhs;
                e.line = start.line;
                e.col = start.col;
                lhs = this.push_expr(e);
            } else if (this.at("...")) {
                this.next();
                AExpr e = this.fresh(17);
                e.a = lhs;
                e.line = start.line;
                e.col = start.col;
                lhs = this.push_expr(e);
            } else {
                break;
            }
        }
        return lhs;
    }

    long parse_primary() {
        Token t = this.peek(0);
        if (this.at("integer")) {
            this.next();
            AExpr e = this.fresh(1);
            e.ival = this.parse_int_tok(t);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.at("float")) {
            this.next();
            AExpr e = this.fresh(2);
            e.sval = this.format_float(t);
            e.fval = this.fval_;
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.at("string")) {
            this.next();
            AExpr e = this.fresh(3);
            e.sval = this.intern_tok(t);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.at("char")) {
            this.next();
            AExpr e = this.fresh(4);
            e.sval = this.intern_tok(t);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("true") || this.kw("false")) {
            long b = this.kw("true") ? 1 : 0;
            this.next();
            AExpr e = this.fresh(5);
            e.flag = b;
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("nullptr")) {
            this.next();
            AExpr e = this.fresh(6);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("nullopt")) {
            this.next();
            AExpr e = this.fresh(7);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("sizeof")) {
            this.next();
            this.expect("(", "expected '(' after 'sizeof'");
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0),
                              "expected type after 'sizeof(' (sizeof(expression) is not supported)");
                this.synchronize();
                AExpr e0 = this.fresh(18);
                e0.line = t.line;
                e0.col = t.col;
                return this.push_expr(e0);
            }
            AType ty = this.parse_type();
            this.expect(")", "expected ')' after sizeof type");
            AExpr e = this.fresh(18);
            e.type = ty;
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("alignof")) {
            this.next();
            this.expect("(", "expected '(' after 'alignof'");
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected type after 'alignof('");
                this.synchronize();
                AExpr e0 = this.fresh(19);
                e0.line = t.line;
                e0.col = t.col;
                return this.push_expr(e0);
            }
            AType ty = this.parse_type();
            this.expect(")", "expected ')' after alignof type");
            AExpr e = this.fresh(19);
            e.type = ty;
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("static_cast") || this.kw("reinterpret_cast") || this.kw("const_cast")) {
            long ckind = 0;
            if (this.lexeme_eq(t.off, t.len, "reinterpret_cast")) {
                ckind = 1;
            } else if (this.lexeme_eq(t.off, t.len, "const_cast")) {
                ckind = 2;
            }
            this.next();
            this.expect("<", "expected '<' after cast keyword");
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected type after cast keyword");
                this.synchronize();
                AExpr e0 = this.fresh(1);
                e0.line = t.line;
                e0.col = t.col;
                return this.push_expr(e0);
            }
            AType ty = this.parse_type();
            this.expect(">", "expected '>' after cast target type");
            this.expect("(", "expected '(' in cast expression");
            long operand = this.parse_expr();
            this.expect(")", "expected ')' after cast expression");
            AExpr e = this.fresh(20);
            e.flag = ckind;
            e.type = ty;
            e.a = operand;
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.at("identifier")) {
            this.next();
            AExpr e = this.fresh(8);
            e.sval = this.intern_tok(t);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.kw("this")) {
            this.next();
            AExpr e = this.fresh(9);
            e.line = t.line;
            e.col = t.col;
            return this.push_expr(e);
        }
        if (this.at("(")) {
            this.next();
            long content = this.parse_conditional();
            this.expect(")", "expected ')' to close parenthesized expression");
            return content;
        }
        // Keywords that are unsupported in the Ivy subset get a targeted
        // message (the kUnsupported table of parser.cpp).
        if (this.kind_eq(t, "keyword")) {
            if (this.lexeme_eq(t.off, t.len, "union")) {
                this.error_at(t, "unions are not supported in the Ivy subset");
                this.next();
                AExpr eu = this.fresh(6);
                eu.line = t.line;
                eu.col = t.col;
                return this.push_expr(eu);
            }
            if (this.lexeme_eq(t.off, t.len, "constinit")) {
                this.error_at(t, "constinit is not supported in the Ivy subset yet");
                this.next();
                AExpr ec = this.fresh(6);
                ec.line = t.line;
                ec.col = t.col;
                return this.push_expr(ec);
            }
            if (this.lexeme_eq(t.off, t.len, "typedef")) {
                this.error_at(t, "use 'using' instead of 'typedef' in the Ivy subset");
                this.next();
                AExpr et = this.fresh(6);
                et.line = t.line;
                et.col = t.col;
                return this.push_expr(et);
            }
            if (this.lexeme_eq(t.off, t.len, "static_assert")) {
                this.error_at(t, "static_assert is not supported in the Ivy subset");
                this.next();
                AExpr es = this.fresh(6);
                es.line = t.line;
                es.col = t.col;
                return this.push_expr(es);
            }
            if (this.lexeme_eq(t.off, t.len, "try") || this.lexeme_eq(t.off, t.len, "catch") ||
                this.lexeme_eq(t.off, t.len, "throw")) {
                this.error_at(t, "exceptions are not supported in the Ivy subset");
                this.next();
                AExpr ex = this.fresh(6);
                ex.line = t.line;
                ex.col = t.col;
                return this.push_expr(ex);
            }
            if (this.lexeme_eq(t.off, t.len, "goto")) {
                this.error_at(t, "goto is not supported in the Ivy subset");
                this.next();
                AExpr eg = this.fresh(6);
                eg.line = t.line;
                eg.col = t.col;
                return this.push_expr(eg);
            }
        }
        this.error_at(t, "unexpected token in expression");
        this.next();
        AExpr e = this.fresh(6);
        e.line = t.line;
        e.col = t.col;
        return this.push_expr(e);
    }

    // --- statements -------------------------------------------------------

    long parse_statement() {
        Token start = this.peek(0);
        // A2: `unsafe { ... }` keyword block (preferred form)
        if (this.kw("unsafe")) {
            this.next();
            long body = -1;
            if (this.at("{")) {
                body = this.parse_compound();
            } else {
                body = this.parse_statement();
            }
            AStmt s = this.fresh_stmt(13);
            s.a = body;
            s.line = start.line;
            s.col = start.col;
            return this.push_stmt(s);
        }
        if (this.at("[") && this.kind_eq(this.peek(1), "[")) {
            Token start = this.peek(0);
            AAttrList st = this.parse_attrs();
            long i = 0;
            while (i < st.n) {
                AAttr a;
                unsafe {
                    a = st.items[i];
                }
                if (this.cstr_eq(a.name, "unsafe")) {
                    this.error_at(start, "[[ivy::unsafe]] is removed — use 'unsafe { }' instead");
                }
                i = i + 1;
            }
            this.validate_list(st, "", "");
        }
        if (this.kw("if")) {
            return this.parse_if();
        }
        if (this.kw("while")) {
            return this.parse_while();
        }
        if (this.kw("do")) {
            return this.parse_dowhile();
        }
        if (this.kw("for")) {
            return this.parse_for();
        }
        if (this.kw("return")) {
            return this.parse_return_stmt();
        }
        if (this.kw("break")) {
            this.next();
            this.expect(";", "expected ';' after 'break'");
            AStmt s = this.fresh_stmt(9);
            s.line = start.line;
            s.col = start.col;
            return this.push_stmt(s);
        }
        if (this.kw("continue")) {
            this.next();
            this.expect(";", "expected ';' after 'continue'");
            AStmt s = this.fresh_stmt(10);
            s.line = start.line;
            s.col = start.col;
            return this.push_stmt(s);
        }
        if (this.kw("nextcase")) {
            this.next();
            AStmt s = this.fresh_stmt(11);
            if (!this.at(";")) {
                if (!this.at("identifier")) {
                    this.error_at(this.peek(0), "expected case label after 'nextcase'");
                } else {
                    unsafe {
                        s.sval = this.intern_tok(this.peek(0));
                    }
                }
                this.next();
            }
            s.line = start.line;
            s.col = start.col;
            this.expect(";", "expected ';' after 'nextcase'");
            return this.push_stmt(s);
        }
        if (this.kw("switch")) {
            return this.parse_switch();
        }
        if (this.kw("goto")) {
            this.error_at(this.peek(0), "goto is not supported in the Ivy subset");
            this.synchronize();
            AStmt s = this.fresh_stmt(14);
            s.line = start.line;
            s.col = start.col;
            return this.push_stmt(s);
        }
        if (this.kw("try") || this.kw("throw")) {
            this.error_at(this.peek(0), "exceptions are not supported in the Ivy subset");
            this.synchronize();
            AStmt s = this.fresh_stmt(14);
            s.line = start.line;
            s.col = start.col;
            return this.push_stmt(s);
        }
        if (this.at("{")) {
            return this.parse_compound();
        }
        return this.parse_decl_or_expr_stmt();
    }

    long parse_compound() {
        Token start = this.peek(0);
        this.expect("{", "expected '{'");
        long first = -1;
        long last = -1;
        long count = 0;
        while (!this.at("}") && !this.at("eof")) {
            long st = this.parse_statement();
            if (first < 0) {
                first = st;
            } else {
                this.set_next(last, st);
            }
            last = st;
            count = count + 1;
        }
        this.expect("}", "expected '}' to close block");
        AStmt s = this.fresh_stmt(1);
        s.sstart = first;
        s.sn = count;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_return_stmt() {
        Token start = this.peek(0);
        this.next();
        long value = -1;
        if (!this.at(";")) {
            value = this.parse_expr();
        }
        this.expect(";", "expected ';' after return statement");
        AStmt s = this.fresh_stmt(8);
        s.a = value;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_if() {
        Token start = this.peek(0);
        this.next();  // if
        long is_constexpr = 0;
        if (this.kw("constexpr")) {
            is_constexpr = 1;
            this.next();
        }
        this.expect("(", "expected '(' after 'if'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after if condition");
        long thenb = this.parse_statement();
        long elseb = -1;
        if (this.kw("else")) {
            this.next();
            elseb = this.parse_statement();
        }
        AStmt s = this.fresh_stmt(3);
        s.a = cond;
        s.b = thenb;
        s.c = elseb;
        s.flag = is_constexpr;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_while() {
        Token start = this.peek(0);
        this.next();
        this.expect("(", "expected '(' after 'while'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after while condition");
        long body = this.parse_statement();
        AStmt s = this.fresh_stmt(4);
        s.a = cond;
        s.b = body;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_dowhile() {
        Token start = this.peek(0);
        this.next();
        long body = this.parse_statement();
        this.expect_kw("while", "expected 'while' after do-while body");
        this.expect("(", "expected '(' after 'while'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after do-while condition");
        this.expect(";", "expected ';' after do-while");
        AStmt s = this.fresh_stmt(5);
        s.a = body;
        s.b = cond;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_for() {
        Token start = this.peek(0);
        this.next();
        this.expect("(", "expected '(' after 'for'");

        // Range-based for: `for (T x : range)` / `for (T& x : range)`.
        if (this.is_type_start() != 0) {
            long save = this.pos_;
            AType type = this.parse_type();
            long is_ref = type.is_ref;
            if (this.at("identifier") && this.kind_eq(this.peek(1), ":")) {
                AStmt s = this.fresh_stmt(7);
                s.type = type;
                s.sval = this.intern_tok(this.next());
                this.next();  // ':'
                s.a = this.parse_expr();
                this.expect(")", "expected ')' after range-for range");
                s.b = this.parse_statement();
                s.flag = is_ref;
                s.line = start.line;
                s.col = start.col;
                return this.push_stmt(s);
            }
            this.pos_ = save;
        }

        long init = -1;
        if (this.at(";")) {
            AStmt sn = this.fresh_stmt(14);
            sn.line = start.line;
            sn.col = start.col;
            init = this.push_stmt(sn);
        } else if (this.is_type_start() != 0) {
            init = this.parse_decl(0);
        } else {
            AStmt si = this.fresh_stmt(12);
            si.a = this.parse_expr();
            si.line = start.line;
            si.col = start.col;
            init = this.push_stmt(si);
        }
        this.expect(";", "expected ';' after for-loop init");
        long cond = -1;
        if (!this.at(";")) {
            cond = this.parse_expr();
        }
        this.expect(";", "expected ';' after for-loop condition");
        long incr = -1;
        if (!this.at(")")) {
            incr = this.parse_expr();
        }
        this.expect(")", "expected ')' after for-loop increment");
        long body = this.parse_statement();
        AStmt s = this.fresh_stmt(6);
        s.a = init;
        s.b = cond;
        s.c = incr;
        s.sstart = body;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_switch() {
        Token start = this.peek(0);
        this.next();
        // A6: optional switch label — `switch LABEL: (cond) { }`
        if (!this.at("(")) {
            if (this.at("identifier") && this.kind_eq(this.peek(1), ":")) {
                this.next();
                this.next();
            } else {
                this.error_at(this.peek(0), "expected '(' after 'switch'");
            }
        }
        this.expect("(", "expected '(' after 'switch'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after switch condition");
        this.expect("{", "expected '{' to start switch body");

        long cstart = this.cp_n_;
        while (!this.at("}") && !this.at("eof")) {
            long value = -1;
            if (this.kw("case")) {
                this.next();
                // A6: optional case label — `case LABEL: value:` (two colons).
                if (this.at("identifier") && this.kind_eq(this.peek(1), ":")) {
                    long two = 0;
                    long cc = 0;
                    long i = 0;
                    while (i < 10 && !this.kind_eq(this.peek(i), "eof")) {
                        if (this.kind_eq(this.peek(i), ":")) {
                            cc = cc + 1;
                            if (cc >= 2) {
                                two = 1;
                                break;
                            }
                        }
                        if (this.kind_eq(this.peek(i), ";") || this.kind_eq(this.peek(i), "{")) {
                            break;
                        }
                        i = i + 1;
                    }
                    if (two != 0) {
                        this.next();
                        this.next();
                    }
                }
                value = this.parse_expr();
                this.expect(":", "expected ':' after case value");
            } else if (this.kw("default")) {
                this.next();
                this.expect(":", "expected ':' after 'default'");
                value = -1;
            } else {
                this.error_at(this.peek(0), "expected 'case' or 'default' inside switch");
                this.synchronize();
                break;
            }
            long first = -1;
            long last = -1;
            long count = 0;
            while (!this.at("}") && !this.at("eof") && !this.kw("case") && !this.kw("default")) {
                long st = this.parse_statement();
                if (first < 0) {
                    first = st;
                } else {
                    this.set_next(last, st);
                }
                last = st;
                count = count + 1;
            }
            this.push_case(value, first, count);
        }
        this.expect("}", "expected '}' to close switch");
        AStmt s = this.fresh_stmt(15);
        s.a = cond;
        s.sstart = cstart;
        s.sn = this.cp_n_ - cstart;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_decl_or_expr_stmt() {
        if (this.kw("constexpr")) {
            Token start = this.peek(0);
            this.parse_constexpr_spec();
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected a type after constexpr");
                this.synchronize();
                AStmt s = this.fresh_stmt(14);
                s.line = start.line;
                s.col = start.col;
                return this.push_stmt(s);
            }
            return this.parse_decl(1);
        }
        if (this.is_type_start() != 0) {
            return this.parse_decl(1);
        }
        return this.parse_expr_stmt();
    }

    long parse_expr_stmt() {
        Token start = this.peek(0);
        long value = this.parse_expr();
        this.expect(";", "expected ';' after expression");
        AStmt s = this.fresh_stmt(12);
        s.a = value;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_decl(long expect_semi) {
        Token start = this.peek(0);
        AType type = this.parse_type();
        if (this.cstr_len(type.base) == 0) {
            this.synchronize();
            AStmt sn = this.fresh_stmt(14);
            sn.line = start.line;
            sn.col = start.col;
            return this.push_stmt(sn);
        }
        long first = this.parse_declarator(type, start.line, start.col);
        if (!this.at(",")) {
            if (expect_semi != 0) {
                this.expect(";", "expected ';' after declaration");
            }
            return first;
        }
        long last = first;
        long count = 1;
        while (this.at(",")) {
            this.next();
            AType t2 = type;
            while (this.at("*")) {
                this.next();
                t2.ptr_depth = t2.ptr_depth + 1;
            }
            long d = this.parse_declarator(t2, start.line, start.col);
            this.set_next(last, d);
            last = d;
            count = count + 1;
        }
        if (expect_semi != 0) {
            this.expect(";", "expected ';' after declaration");
        }
        AStmt s = this.fresh_stmt(1);
        s.sstart = first;
        s.sn = count;
        s.line = start.line;
        s.col = start.col;
        return this.push_stmt(s);
    }

    long parse_declarator(AType t, long line, long col) {
        AStmt s = this.fresh_stmt(2);
        s.type = t;
        s.line = line;
        s.col = col;
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected variable name");
            return this.push_stmt(s);
        }
        s.sval = this.intern_tok(this.next());
        if (this.at("[")) {
            this.next();
            if (this.at("integer")) {
                Token it = this.peek(0);
                long n = this.parse_int_tok(it);
                this.next();
                if (n <= 0) {
                    this.error_at(it, "array size must be a positive integer");
                }
                s.type.array_size = n > 0 ? n : 1;
            } else {
                this.error_at(this.peek(0),
                              "array size must be an integer constant (variable-length arrays are not supported)");
                this.synchronize();
            }
            this.expect("]", "expected ']' after array size");
        }
        if (this.at("=")) {
            this.next();
            s.a = this.parse_expr();
        } else if (this.at("{")) {
            s.a = this.parse_primary();
        } else if (this.at("(")) {
            this.next();
            AExpr call = this.fresh(13);
            AExpr callee = this.fresh(8);
            // The synthesized callee is located at the first token of the
            // argument list (the oracle's `locOf(peek())`).
            callee.line = this.peek(0).line;
            callee.col = this.peek(0).col;
            callee.sval = t.base;
            call.a = this.push_expr(callee);
            long argstart = this.ca_n_;
            call.astart = argstart;
            while (!this.at(")") && !this.at("eof")) {
                long arg = this.parse_expr();
                this.push_carg(arg);
                if (this.at(",")) {
                    this.next();
                } else {
                    break;
                }
            }
            call.an = this.ca_n_ - argstart;
            this.expect(")", "expected ')' after constructor arguments");
            s.a = this.push_expr(call);
        }
        return this.push_stmt(s);
    }

    void build_function(AFunction f, long a_start, long a_end, AType ret, const char* name,
                        AParamList pl, long is_extern_c, long is_constexpr, long line, long col,
                        ATemplateParamList tpl, ALifetimeList declared, ALifetimeList ret_lts,
                        ALegacyLifetimeList legacy) {
        unsafe {
            f.attrs = this.apool_ + a_start;
        }
        f.nattrs = a_end - a_start;
        f.ret = ret;
        f.name = name;
        unsafe {
            f.params = pl.items;
        }
        f.nparams = pl.n;
        f.is_extern_c = is_extern_c;
        f.body = -1;
        f.line = line;
        f.col = col;
        f.is_constexpr = is_constexpr;
        f.is_virtual = 0;
        f.tpl_params = tpl.items;
        f.tpl_n = tpl.n;
        // A5: the lifetime annotations of the function.
        f.lt_names = declared;
        f.ret_lts = ret_lts;
        f.legacy_lts = legacy;
        if (this.at("{")) {
            f.body = this.parse_compound();
        } else {
            this.expect(";", "expected '{' for function body or ';' for a declaration");
        }
        this.push_fn(f);
    }

    // `dline`/`dcol` are the position of the first token of the function
    // declaration (the oracle's `Function::loc`): the leading attribute,
    // the `fn` keyword, the `template`/`export` keyword of the enclosing
    // declaration or the return type.
    void parse_function(AAttrList caller, long is_extern_c, long ce, long cv,
                        ATemplateParamList tpl, ALifetimeList declared,
                        long dline, long dcol) {
        unsafe {
            long a_start = this.copy_attrs(caller);
            AType ret = this.parse_type();
            if (this.cstr_len(ret.base) == 0) {
                this.synchronize();
                return;
            }
            // A5: the native return lifetime (`-> const int32& $a`).
            ALifetimeList ret_lts = this.no_lt();
            if (this.at_lifetime()) {
                Token lt = this.next();
                ret_lts = this.one_lt(this.intern_lifetime(lt));
            }
            this.parse_attrs();
            long a_end = this.ap_n_;
            AAttrList all;
            all.items = this.apool_ + a_start;
            all.n = a_end - a_start;
            this.validate_list(all, "lt_def", "lt_ret");
            // A5: the legacy lifetime annotations of the function.
            ALegacyLifetimeList legacy = this.collect_legacy_lts(all);
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected function name");
                this.synchronize();
                return;
            }
            const char* name = this.intern_tok(this.next());
            this.expect("(", this.fn_name_msg(name));
            AParamList pl = this.parse_params();
            this.expect(")", "expected ')' to close parameter list");
            AFunction f;
            this.build_function(f, a_start, a_end, ret, name, pl, is_extern_c, ce,
                                dline, dcol, tpl, declared, ret_lts, legacy);
        }
    }

    // `dline`/`dcol` are the position of the first token of the function
    // declaration (the oracle's `Function::loc`).
    void parse_fn_trailing(AAttrList caller, long is_extern_c, long ce, long cv,
                           ATemplateParamList tpl, ALifetimeList declared,
                           long dline, long dcol) {
        unsafe {
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected function name after 'fn'");
                this.synchronize();
                return;
            }
            const char* name = this.intern_tok(this.next());
            this.expect("(", this.fn_name_msg(name));
            AParamList pl = this.parse_params();
            this.expect(")", "expected ')' to close parameter list");
            if (!this.at("->")) {
                this.error_at(this.peek(0), "expected '->' after parameter list in 'fn' declaration");
                this.synchronize();
                return;
            }
            this.next();
            AType ret = this.parse_type();
            if (this.cstr_len(ret.base) == 0) {
                this.synchronize();
                return;
            }
            // A5: the native return lifetime (`-> const int32& $a`).
            ALifetimeList ret_lts = this.no_lt();
            if (this.at_lifetime()) {
                Token lt = this.next();
                ret_lts = this.one_lt(this.intern_lifetime(lt));
            }
            AAttrList mid = this.parse_attrs();
            // The function's attribute list is the caller's attributes
            // followed by the ones that follow the return type.  The
            // parameter attributes are not part of it: they were parsed
            // before the return type and are validated on their own.
            long a_start = this.ap_n_;
            this.copy_attrs(caller);
            this.copy_attrs(mid);
            long a_end = this.ap_n_;
            AAttrList all;
            all.items = this.apool_ + a_start;
            all.n = a_end - a_start;
            this.validate_list(all, "lt_def", "lt_ret");
            // A5: the legacy lifetime annotations of the function.
            ALegacyLifetimeList legacy = this.collect_legacy_lts(all);
            AFunction f;
            this.build_function(f, a_start, a_end, ret, name, pl, is_extern_c, ce,
                                dline, dcol, tpl, declared, ret_lts, legacy);
        }
    }

    // --- user-defined aggregate types (H3.4: struct / enum / class) -------

    long is_enum_int_base(const char* b) {
        if (this.cstr_eq(b, "int") || this.cstr_eq(b, "int8") || this.cstr_eq(b, "int16") ||
            this.cstr_eq(b, "int32") || this.cstr_eq(b, "int64") || this.cstr_eq(b, "int128") ||
            this.cstr_eq(b, "uint8") || this.cstr_eq(b, "uint16") || this.cstr_eq(b, "uint32") ||
            this.cstr_eq(b, "uint64") || this.cstr_eq(b, "uint128") ||
            this.cstr_eq(b, "char") || this.cstr_eq(b, "short") || this.cstr_eq(b, "long") ||
            this.cstr_eq(b, "bool") || this.cstr_eq(b, "int8_t") || this.cstr_eq(b, "int16_t") ||
            this.cstr_eq(b, "int32_t") || this.cstr_eq(b, "int64_t") || this.cstr_eq(b, "int128_t") ||
            this.cstr_eq(b, "uint8_t") || this.cstr_eq(b, "uint16_t") || this.cstr_eq(b, "uint32_t") ||
            this.cstr_eq(b, "uint64_t") || this.cstr_eq(b, "uint128_t") ||
            this.cstr_eq(b, "size_t") || this.cstr_eq(b, "ptrdiff_t") || this.cstr_eq(b, "uptr_t")) {
            return 1;
        }
        return 0;
    }

    // parseOperatorName in parser.cpp: consume the operator symbol and
    // return its canonical spelling.  The lexer names an operator token
    // after the symbol itself, so the token kind is the symbol.
    const char* skip_operator_name() {
        // On entry, positioned at the `operator` keyword.
        this.next();
        if (this.at("(") && this.kind_eq(this.peek(1), ")")) {
            this.next();
            this.next();
            return "()";
        }
        if (this.at("[") && this.kind_eq(this.peek(1), "]")) {
            this.next();
            this.next();
            return "[]";
        }
        Token t = this.peek(0);
        if (this.at("+") || this.at("-") || this.at("*") || this.at("/") || this.at("%") ||
            this.at("&") || this.at("|") || this.at("^") || this.at("~") || this.at("!") ||
            this.at("==") || this.at("!=") || this.at("<") || this.at(">") ||
            this.at("<=") || this.at(">=") || this.at("<<") || this.at(">>") ||
            this.at("&&") || this.at("||") || this.at("++") || this.at("--") ||
            this.at("->")) {
            this.next();
            unsafe {
                return t.kind;
            }
        }
        this.error_at(this.peek(0), "expected an operator symbol after 'operator'");
        this.next();
        return "";
    }

    void parse_ctor_inits() {
        this.next();  // ':'
        while (!this.at("{") && !this.at(";") && !this.at("eof")) {
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected member name in constructor initializer list");
                this.synchronize();
                return;
            }
            this.next();
            this.expect("(", "expected '(' after member name in initializer list");
            this.parse_expr();
            this.expect(")", "expected ')' to close member initializer");
            if (this.at(",")) {
                this.next();
            } else {
                return;
            }
        }
    }

    long parse_method_tail() {
        this.pure_virtual_ = 0;
        if (this.kw("const")) {
            this.next();
        }
        if (this.kw("override")) {
            this.next();
        }
        if (this.at("{")) {
            return this.parse_compound();
        }
        if (this.at("=")) {
            this.next();
            this.expect("integer", "expected '0' for pure virtual method");
            this.expect(";", "expected ';' after pure virtual method");
            this.pure_virtual_ = 1;
            return -1;
        }
        this.expect(";", "expected '{' for method body or ';' for a declaration");
        return -1;
    }

    void push_method_record(const char* name, AType ret, AParamList pl, long body,
                            long is_virtual, long line, long col) {
        AFunction m;
        m.attrs = this.apool_;
        m.nattrs = 0;
        m.ret = ret;
        m.name = name;
        m.params = pl.items;
        m.nparams = pl.n;
        m.is_extern_c = 0;
        m.body = body;
        m.line = line;
        m.col = col;
        m.is_constexpr = 0;
        m.is_virtual = is_virtual;
        unsafe { m.tpl_params = (ATemplateParam*)0; }
        m.tpl_n = 0;
        unsafe {
            m.lt_names.items = (ALifetime*)0;
            m.lt_names.n = 0;
            m.ret_lts.items = (ALifetime*)0;
            m.ret_lts.n = 0;
            m.legacy_lts.items = (ALegacyLifetime*)0;
            m.legacy_lts.n = 0;
        }
        this.push_method(m);
    }

    void parse_struct_members(const char* bare) {
      unsafe {
        while (!this.at("}") && !this.at("eof")) {
            if (this.kw("public") || this.kw("private") || this.kw("protected")) {
                this.next();
                if (this.at(":")) {
                    this.next();
                }
                continue;
            }
            long is_virtual = 0;
            if (this.kw("virtual")) {
                is_virtual = 1;
                this.next();
            }
            // Constructor: `Name(params) [: inits] { body }`.
            if (this.at("identifier") && this.lexeme_eq(this.peek(0).off, this.peek(0).len, bare) != 0 &&
                this.kind_eq(this.peek(1), "(")) {
                Token mstart = this.peek(0);
                this.next();
                this.next();
                AParamList pl = this.parse_params();
                this.expect(")", "expected ')' to close constructor parameter list");
                if (this.at(":")) {
                    this.parse_ctor_inits();
                }
                AType ret = this.empty_type();
                ret.base = "void";
                long body = -1;
                if (this.at("{")) {
                    body = this.parse_compound();
                } else {
                    this.expect(";", "expected '{' for constructor body or ';' for a declaration");
                }
                const char* qn = this.intern_join3(bare, "::", bare);
                this.push_method_record(qn, ret, pl, body, is_virtual, mstart.line, mstart.col);
                continue;
            }
            // Destructor: `~Name() { body }`.
            if (this.at("~") && this.kind_eq(this.peek(1), "identifier") &&
                this.lexeme_eq(this.peek(1).off, this.peek(1).len, bare) != 0 &&
                this.kind_eq(this.peek(2), "(")) {
                Token mstart = this.peek(0);
                this.next();
                this.next();
                this.next();
                AParamList pl = this.parse_params();
                this.expect(")", "expected ')' to close destructor parameter list");
                AType ret = this.empty_type();
                ret.base = "void";
                long body = -1;
                if (this.at("{")) {
                    body = this.parse_compound();
                } else if (this.at("=")) {
                    this.next();
                    this.expect("integer", "expected '0' for pure virtual destructor");
                    this.expect(";", "expected ';' after pure virtual destructor");
                } else {
                    this.expect(";", "expected '{' for destructor body or ';' for a declaration");
                }
                const char* qn = this.intern_join3(bare, "::~", bare);
                this.push_method_record(qn, ret, pl, body, is_virtual, mstart.line, mstart.col);
                continue;
            }
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected field or method declaration in struct body");
                this.synchronize();
                break;
            }
            AType ftype = this.parse_type();
            if (this.kw("operator")) {
                Token mstart = this.peek(0);
                const char* op = this.skip_operator_name();
                if (this.cstr_len(op) == 0) {
                    this.synchronize();
                    break;
                }
                this.expect("(", "expected '(' after operator name");
                AParamList pl = this.parse_params();
                this.expect(")", "expected ')' to close operator parameter list");
                long body = this.parse_method_tail();
                const char* qn = this.intern_join3(bare, "::operator", op);
                this.push_method_record(qn, ftype, pl, body,
                                        is_virtual != 0 ? 1 : this.pure_virtual_,
                                        mstart.line, mstart.col);
                continue;
            }
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected field or method name");
                this.synchronize();
                break;
            }
            Token nametok = this.peek(0);
            const char* member = this.intern_tok(this.next());
            if (this.at("(")) {
                this.next();
                AParamList pl = this.parse_params();
                this.expect(")", "expected ')' to close method parameter list");
                long body = this.parse_method_tail();
                const char* qn = this.intern_join3(bare, "::", member);
                this.push_method_record(qn, ftype, pl, body,
                                        is_virtual != 0 ? 1 : this.pure_virtual_,
                                        nametok.line, nametok.col);
                continue;
            }
            if (this.at("=")) {
                this.next();
                this.parse_expr();
            }
            this.expect(";", "expected ';' after field declaration");
            AField f;
            f.type = ftype;
            f.name = member;
            f.line = nametok.line;
            f.col = nametok.col;
            this.push_field(f);
        }
      }
    }

    void parse_struct(ATemplateParamList tpl) {
      unsafe {
        Token sstart = this.peek(0);
        long is_class = this.kw("class") ? 1 : 0;
        this.next();
        if (!this.at("identifier")) {
            if (is_class != 0) {
                this.error_at(this.peek(0), "expected class name after 'class'");
            } else {
                this.error_at(this.peek(0), "expected struct name after 'struct'");
            }
            this.synchronize();
            return;
        }
        const char* bare = this.intern_tok(this.next());
        if (this.kw("final")) {
            this.error_at(this.peek(0), "'final' is not supported in the Ivy subset");
            this.next();
        }
        long bstart = this.b_n_;
        if (this.at(":")) {
            this.next();
            while (true) {
                if (this.kw("public") || this.kw("private") || this.kw("protected")) {
                    this.next();
                }
                if (this.kw("virtual")) {
                    this.next();
                }
                if (this.is_type_start() == 0) {
                    this.error_at(this.peek(0), "expected base class name after ':'");
                    this.synchronize();
                    break;
                }
                AType bt = this.parse_type();
                this.push_base(bt.base);
                if (this.at(",")) {
                    this.next();
                    continue;
                }
                break;
            }
        }
        this.expect("{", "expected '{' to start struct body");
        this.register_type_name(bare);
        long fstart = this.fld_n_;
        long mstart = this.m_n_;
        this.parse_struct_members(bare);
        this.expect("}", "expected '}' to close struct body");
        this.expect(";", "expected ';' after struct definition");
        AStruct sd;
        sd.name = bare;
        sd.is_class = is_class;
        sd.fields = this.fldpool_ + fstart;
        sd.nfields = this.fld_n_ - fstart;
        sd.methods = this.mpool_ + mstart;
        sd.nmethods = this.m_n_ - mstart;
        sd.bstart = bstart;
        sd.nbases = this.b_n_ - bstart;
        sd.line = sstart.line;
        sd.col = sstart.col;
        sd.tpl_params = tpl.items;
        sd.tpl_n = tpl.n;
        this.push_struct(sd);
      }
    }

    void parse_enum() {
      unsafe {
        Token estart = this.peek(0);
        this.next();  // 'enum'
        long is_scoped = 0;
        if (this.kw("class") || this.kw("struct")) {
            is_scoped = 1;
            this.next();
        }
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected enum name after 'enum'");
            this.synchronize();
            return;
        }
        Token nametok = this.peek(0);
        const char* name = this.intern_tok(this.next());
        AType ut = this.empty_type();
        if (this.at(":")) {
            this.next();
            ut = this.parse_type();
            if (this.is_enum_int_base(ut.base) == 0) {
                this.error_at(this.peek(0), "enum underlying type must be an integer type");
            }
        }
        this.expect("{", "expected '{' to start enum body");
        long enustart = this.enu_n_;
        while (!this.at("}") && !this.at("eof")) {
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected enumerator name");
                this.synchronize();
                break;
            }
            Token etok = this.peek(0);
            const char* ename = this.intern_tok(this.next());
            long eval = -1;
            if (this.at("=")) {
                this.next();
                eval = this.parse_expr();
            }
            AEnumerator en;
            en.name = ename;
            en.value = eval;
            en.line = etok.line;
            en.col = etok.col;
            this.push_enumerator(en);
            if (!this.at("}")) {
                this.expect(",", "expected ',' between enumerators");
                if (this.at("}")) {
                    break;
                }
            }
        }
        this.expect("}", "expected '}' to close enum body");
        this.expect(";", "expected ';' after enum definition");
        this.register_type_name(name);
        AEnum ed;
        ed.name = name;
        ed.is_scoped = is_scoped;
        ed.underlying = ut;
        ed.enumerators = this.enupool_ + enustart;
        ed.nenumerators = this.enu_n_ - enustart;
        ed.line = estart.line;
        ed.col = estart.col;
        this.push_enum(ed);
      }
    }
    void parse_using() {
      unsafe {
        this.next();  // 'using'
        if (this.kw("namespace")) {
            this.error_at(this.peek(0), "'using namespace' is not supported in the Ivy subset");
            this.synchronize();
            return;
        }
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected alias name after 'using'");
            this.synchronize();
            return;
        }
        const char* name = this.intern_tok(this.next());
        if (this.at("=")) {
            this.next();
            AType target = this.parse_type();
            this.expect(";", "expected ';' after type alias");
            this.register_type_name(name);
            AAlias al;
            al.name = name;
            al.target = target;
            this.push_alias(al);
            return;
        }
        // using-declaration / using-enum — accepted and ignored.
        while (!this.at(";") && !this.at("eof")) {
            this.next();
        }
        this.expect(";", "expected ';' after using-declaration");
      }
    }

    // --- templates / concepts (H3.5) --------------------------------------

    // The empty template-parameter list (an ordinary, non-template
    // declaration).
    ATemplateParamList no_tpl() {
        ATemplateParamList l;
        unsafe { l.items = (ATemplateParam*)0; }
        l.n = 0;
        return l;
    }



    // --- template arguments (template-id types and template-id calls) -----
    //
    // The arguments of a template-id are parsed onto a scratch stack and are
    // then copied into a block of their own, so that the argument list of
    // every template-id ends up contiguous.  A nested template-id owns its
    // own block and leaves the stack unchanged, so `Box<Box<int32> >` keeps
    // two separate lists.

    void push_arg(AType t) {
        if (this.argst_n_ >= this.argst_cap_) {
            return;
        }
        unsafe {
            this.argstack_[this.argst_n_] = t;
        }
        this.argst_n_ = this.argst_n_ + 1;
    }

    // Copy the `n` argument types at stack index `mark` into a freshly
    // allocated block and pop them off the stack.
    AType* take_args(long mark, long n) {
        this.argst_n_ = mark;
        unsafe {
            if (n <= 0) {
                return (AType*)0;
            }
            AType* blk = (AType*) __ivy_alloc(n * 48);
            __ivy_memcpy(blk, (void*)(this.argstack_ + mark),
                         (unsigned long long)(n * 48));
            if (this.argblk_n_ < this.argblk_cap_) {
                this.argblk_[this.argblk_n_] = (long) blk;
                this.argblk_n_ = this.argblk_n_ + 1;
            }
            return blk;
        }
    }

    // parseTemplateArgs in parser.cpp: the argument list of a template-id
    // type (`Box<int32>`).  The leading `<` has been seen but not consumed.
    ATypeList parse_template_args() {
        this.next();  // '<'
        long mark = this.argst_n_;
        long n = 0;
        while (!this.at(">") && !this.at("eof")) {
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected a type in template argument list");
                this.synchronize();
                break;
            }
            AType a = this.parse_type();
            this.push_arg(a);
            n = n + 1;
            if (this.at(",")) {
                this.next();
            } else {
                break;
            }
        }
        this.expect(">", "expected '>' to close template argument list");
        ATypeList l;
        l.items = this.take_args(mark, n);
        l.n = n;
        return l;
    }

    // --- template declarations (H3.5 syntax, H4.4 data) ------------------

    // parseTemplateParams in parser.cpp: `typename T, int N, Concept U, ...`.
    // The parsed parameters are collected in the parser's template-parameter
    // pool and returned as a slice.
    //
    // `reg` controls whether the type-parameter names are added to the
    // template-parameter scope.  The oracle registers them in
    // `parseTemplate` (after the list has been parsed); the
    // `lifetime<...> template<...>` prefix parses the list without
    // registering the names, so `reg` is false there.
    ATemplateParamList parse_template_params(bool reg) {
        long start = this.tpp_n_;
        // The oracle's `expect(Lt, ...)` consumes the offending token when
        // the '<' is missing, so that the parse always progresses.
        if (!this.at("<")) {
            this.error_at(this.peek(0), "expected '<' to start template parameter list");
        }
        this.next();  // '<' (or the offending token)
        while (!this.at(">") && !this.at("eof")) {
            ATemplateParam tp;
            tp.name = "";
            tp.constraint = "";
            tp.is_typename = 0;
            tp.is_variadic = 0;
            tp.type = this.empty_type();
            tp.line = this.peek(0).line;
            tp.col = this.peek(0).col;
            if (this.kw("typename") || this.kw("class")) {
                this.next();
                tp.is_typename = 1;
            } else if (this.is_type_start() != 0) {
                tp.type = this.parse_type();  // non-type parameter: `int32 N`
            } else if (this.at("identifier")) {
                // constrained type parameter: `Addable T`
                tp.constraint = this.intern_tok(this.next());
                tp.is_typename = 1;
            } else {
                this.error_at(this.peek(0),
                              "expected 'typename', a concept name, or a type in template parameter list");
                this.synchronize();
                break;
            }
            if (this.at("...")) {
                this.next();  // `typename... Args`
                tp.is_variadic = 1;
            }
            if (this.at("identifier")) {
                tp.name = this.intern_tok(this.peek(0));
                if (tp.is_typename != 0 && reg) {
                    this.register_template_param(tp.name);
                }
                this.next();
            } else {
                this.error_at(this.peek(0), "expected template parameter name");
                this.synchronize();
                break;
            }
            if (this.at("...")) {
                this.next();  // `typename Args...`
                tp.is_variadic = 1;
            }
            this.push_template_param(tp);
            if (this.at(",")) {
                this.next();
            } else {
                break;
            }
        }
        this.expect(">", "expected '>' to close template parameter list");
        ATemplateParamList l;
        unsafe {
            l.items = this.tppool_ + start;
        }
        l.n = this.tpp_n_ - start;
        return l;
    }

    void parse_template(long dline, long dcol) {
        this.next();  // 'template'
        long saved = this.tp_n_;
        ATemplateParamList tpl = this.parse_template_params(true);
        if (this.kw("struct") || this.kw("class")) {
            this.parse_struct(tpl);
        } else if (this.kw("constexpr") || this.kw("consteval")) {
            this.parse_constexpr_spec();
            if (this.kw("fn")) {
                this.next();
                AAttrList a = this.parse_attrs();
                this.parse_fn_trailing(a, 0, this.ce_, this.cv_, tpl, this.no_lt(), dline, dcol);
            } else {
                AAttrList a2 = this.parse_attrs();
                this.parse_function(a2, 0, this.ce_, this.cv_, tpl, this.no_lt(), dline, dcol);
            }
        } else if (this.kw("fn")) {
            this.next();
            AAttrList a = this.parse_attrs();
            this.parse_fn_trailing(a, 0, 0, 0, tpl, this.no_lt(), dline, dcol);
        } else {
            AAttrList a = this.parse_attrs();
            this.parse_function(a, 0, 0, 0, tpl, this.no_lt(), dline, dcol);
        }
        this.tp_n_ = saved;
    }

    // parseConcept in parser.cpp: `concept Name = requires(T a, T b) { ... };`
    // The concept's type parameter and the raw text of every requirement are
    // kept so that the constraint check can look at them later.
    void parse_concept() {
      unsafe {
        this.next();  // 'concept'
        Token cstart = this.peek(0);
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected concept name");
            this.synchronize();
            return;
        }
        const char* cname = this.intern_tok(this.next());
        this.expect("=", "expected '=' in concept definition");
        this.expect_kw("requires", "expected 'requires' in concept definition");
        this.expect("(", "expected '(' after 'requires'");
        // The requires parameter list: `(T a, T b, ...)`.  The type of the
        // first parameter is the concept's type parameter; the type of every
        // parameter is the text between the start of the parameter and its
        // name.
        const char* param_name = "";
        long first_param = 1;
        long depth = 0;
        while (!this.at("eof")) {
            long type_start = this.pos_;
            long name_pos = this.pos_;
            while (!this.at("eof")) {
                if (this.at("(")) {
                    depth = depth + 1;
                    this.next();
                    continue;
                }
                if (this.at(")")) {
                    if (depth == 0) {
                        break;
                    }
                    depth = depth - 1;
                    this.next();
                    continue;
                }
                if (this.at(",") && depth == 0) {
                    break;
                }
                if (this.at("identifier")) {
                    name_pos = this.pos_;
                }
                this.next();
            }
            if (name_pos >= type_start && name_pos < this.pos_) {
                long ts = this.sb_n_;
                long i = type_start;
                long first = 1;
                while (i < name_pos) {
                    Token tk = this.token_at(i);
                    if (first == 0) {
                        this.sb_put_char(32);
                    }
                    first = 0;
                    this.sb_put_raw(this.src_ + tk.off, tk.len);
                    i = i + 1;
                }
                this.sb_end();
                if (first_param != 0 && this.sb_n_ - ts - 1 > 0) {
                    param_name = this.sbuf_ + ts;
                }
                first_param = 0;
            }
            if (this.at(",")) {
                this.next();
            } else {
                break;
            }
        }
        this.expect(")", "expected ')' to close requires parameter list");
        this.expect("{", "expected '{' to start requires body");
        long req_start = this.req_n_;
        long nreqs = 0;
        while (!this.at("}") && !this.at("eof")) {
            long rs = this.sb_n_;
            long first = 1;
            while (!this.at(";") && !this.at("}") && !this.at("eof")) {
                Token tk = this.peek(0);
                if (first == 0) {
                    this.sb_put_char(32);
                }
                first = 0;
                this.sb_put_raw(this.src_ + tk.off, tk.len);
                this.next();
            }
            this.sb_end();
            long len = this.sb_n_ - rs - 1;
            if (len > 0) {
                this.push_requirement(this.sbuf_ + rs);
                nreqs = nreqs + 1;
            }
            if (this.at(";")) {
                this.next();
            }
        }
        this.expect("}", "expected '}' to close requires body");
        if (this.at(";")) {
            this.next();
        }
        AConcept cd;
        cd.name = cname;
        cd.param_name = param_name;
        cd.req_start = req_start;
        cd.nreqs = nreqs;
        cd.line = cstart.line;
        cd.col = cstart.col;
        this.push_concept(cd);
      }
    }

    // --- modules / imports (H3.6) -----------------------------------------

    const char* module_name() {
        return this.module_name_;
    }

    long is_module_export() {
        return this.is_module_export_;
    }

    void parse_module_decl() {
        this.next();  // 'module'
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected module name after 'module'");
            this.synchronize();
            return;
        }
        this.module_name_ = this.intern_tok(this.next());
        this.is_module_export_ = 0;
        this.expect(";", "expected ';' after module declaration");
    }

    void parse_export(long dline, long dcol) {
        this.next();  // 'export'
        if (this.kw("module")) {
            this.next();
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected module name after 'export module'");
                this.synchronize();
                return;
            }
            this.module_name_ = this.intern_tok(this.next());
            this.is_module_export_ = 1;
            this.expect(";", "expected ';' after module declaration");
            return;
        }
        if (this.kw("struct") || this.kw("class")) {
            this.parse_struct(this.no_tpl());
            return;
        }
        if (this.kw("enum")) {
            this.parse_enum();
            return;
        }
        if (this.kw("using")) {
            this.parse_using();
            return;
        }
        if (this.kw("template")) {
            this.parse_template(dline, dcol);
            return;
        }
        if (this.kw("constexpr") || this.kw("consteval")) {
            this.parse_constexpr_spec();
            if (this.kw("fn")) {
                this.next();
                AAttrList a = this.parse_attrs();
                this.parse_fn_trailing(a, 0, this.ce_, this.cv_, this.no_tpl(), this.no_lt(), dline, dcol);
            } else {
                AAttrList a2 = this.parse_attrs();
                this.parse_function(a2, 0, this.ce_, this.cv_, this.no_tpl(), this.no_lt(), dline, dcol);
            }
            return;
        }
        if (this.kw("fn")) {
            this.next();
            AAttrList a = this.parse_attrs();
            this.parse_fn_trailing(a, 0, 0, 0, this.no_tpl(), this.no_lt(), dline, dcol);
            return;
        }
        if (this.is_type_start() == 0) {
            this.error_at(this.peek(0), "expected a declaration after 'export'");
            this.synchronize();
            return;
        }
        AAttrList a = this.parse_attrs();
        this.parse_function(a, 0, 0, 0, this.no_tpl(), this.no_lt(), dline, dcol);
    }

    void parse_import_header(const char* no_hdr_msg, const char* gt_msg) {
        if (this.at("<")) {
            this.next();
            while (!this.at(">") && !this.at("eof")) {
                this.next();
            }
            this.expect(">", gt_msg);
        } else if (this.at("string")) {
            this.next();
        } else {
            this.error_at(this.peek(0), no_hdr_msg);
            this.synchronize();
        }
    }

    void parse_import() {
        this.next();  // 'import'
        if (this.kw("cpp")) {
            this.next();
            this.parse_import_header("expected '<header>' or \"header\" after 'import cpp'",
                                     "expected '>' after C++ header name");
        } else if (this.at("identifier") && this.lexeme_eq(this.peek(0).off, this.peek(0).len, "c")) {
            this.next();
            this.parse_import_header("expected '<header>' or \"header\" after 'import c'",
                                     "expected '>' after C header name");
        } else if (this.at("string")) {
            this.next();
        } else if (this.at("identifier")) {
            this.next();
        } else {
            this.error_at(this.peek(0), "expected module name after 'import'");
            this.synchronize();
            return;
        }
        this.expect(";", "expected ';' after import");
    }

    void parse_extern_c(AAttrList attrs, long dline, long dcol) {
        if (this.at("{")) {
            this.next();
            while (!this.at("}") && !this.at("eof")) {
                AAttrList f = this.parse_attrs();
                // The oracle locates a function of an `extern "C"` block
                // at the token that follows its attributes.
                Token fd = this.peek(0);
                this.parse_function(f, 1, 0, 0, this.no_tpl(), this.no_lt(), fd.line, fd.col);
            }
            this.expect("}", "expected '}' to close extern \"C\" block");
            return;
        }
        this.parse_function(attrs, 1, 0, 0, this.no_tpl(), this.no_lt(), dline, dcol);
    }

    void parse_top() {
        while (!this.at("eof")) {
            if (this.at("#")) {
                this.error_at(this.peek(0), "unsupported preprocessor directive");
                this.synchronize();
                continue;
            }
            if (this.kw("extern")) {
                Token dstart = this.peek(0);  // the `extern` keyword
                this.next();
                if (this.at("string") && this.lexeme_eq(this.peek(0).off, this.peek(0).len, "\"C\"")) {
                    this.next();
                    AAttrList a = this.parse_attrs();
                    this.parse_extern_c(a, dstart.line, dstart.col);
                } else {
                    this.error_at(this.peek(0), "only 'extern \"C\"' is supported in the Ivy subset");
                    this.synchronize();
                }
                continue;
            }
            if (this.kw("constexpr") || this.kw("consteval")) {
                this.parse_constexpr_spec();
                if (this.kw("fn")) {
                    Token dstart = this.peek(0);  // the `fn` keyword
                    this.next();
                    AAttrList a = this.parse_attrs();
                    this.parse_fn_trailing(a, 0, this.ce_, this.cv_, this.no_tpl(), this.no_lt(),
                                           dstart.line, dstart.col);
                    continue;
                }
                if (this.is_type_start() == 0) {
                    this.error_at(this.peek(0), "expected a type after constexpr/consteval");
                    this.synchronize();
                    continue;
                }
                Token dstart = this.peek(0);  // the attributes or the type
                AAttrList a = this.parse_attrs();
                this.parse_function(a, 0, this.ce_, this.cv_, this.no_tpl(), this.no_lt(),
                                    dstart.line, dstart.col);
                continue;
            }
            // A5: `lifetime<$a, $b>` — the lifetime declaration prefix.
            // It must be followed by a function declaration.
            if (this.kw("lifetime")) {
                ALifetimeList lts = this.parse_lifetime_decl();
                if (this.kw("constexpr") || this.kw("consteval")) {
                    this.parse_constexpr_spec();
                    if (this.kw("fn")) {
                        Token dstart = this.peek(0);  // the `fn` keyword
                        this.next();
                        AAttrList a2 = this.parse_attrs();
                        this.parse_fn_trailing(a2, 0, this.ce_, this.cv_, this.no_tpl(), lts,
                                               dstart.line, dstart.col);
                        continue;
                    }
                    if (this.is_type_start() == 0) {
                        this.error_at(this.peek(0), "expected a function after lifetime<...> + constexpr");
                        this.synchronize();
                        continue;
                    }
                    Token dstart = this.peek(0);  // the attributes or the type
                    AAttrList a3 = this.parse_attrs();
                    this.parse_function(a3, 0, this.ce_, this.cv_, this.no_tpl(), lts,
                                        dstart.line, dstart.col);
                    continue;
                }
                if (this.kw("fn")) {
                    Token dstart = this.peek(0);  // the `fn` keyword
                    this.next();
                    AAttrList a4 = this.parse_attrs();
                    this.parse_fn_trailing(a4, 0, 0, 0, this.no_tpl(), lts, dstart.line, dstart.col);
                    continue;
                }
                // `lifetime<...> template<...> ...` — the template parameter
                // list follows the lifetime declaration.  The oracle does not
                // put the template parameter names into scope here (only
                // `parseTemplate` does), so the port does not either.
                if (this.kw("template")) {
                    this.next();  // 'template'
                    // The oracle consumes the '<' of the template parameter
                    // list here and then parses the parameter list, which
                    // expects the '<' again.  The port mirrors that, so that
                    // the diagnostics of the list match.
                    this.expect("<", "expected '<' after 'template'");
                    ATemplateParamList tpl = this.parse_template_params(false);
                    if (this.kw("fn")) {
                        Token floc = this.peek(0);  // the `fn` keyword
                        this.next();
                        AAttrList a = this.parse_attrs();
                        this.parse_fn_trailing(a, 0, 0, 0, tpl, lts, floc.line, floc.col);
                        continue;
                    }
                    if (this.is_type_start() == 0) {
                        this.error_at(this.peek(0), "expected a function after 'template<...>'");
                        this.synchronize();
                        continue;
                    }
                    Token floc = this.peek(0);  // the attributes or the type
                    AAttrList a = this.parse_attrs();
                    this.parse_function(a, 0, 0, 0, tpl, lts, floc.line, floc.col);
                    continue;
                }
                // `lifetime<...> [[attrs]] fn ...` or `lifetime<...> Type ...`
                Token dstart = this.peek(0);  // the attributes or the type
                AAttrList a5 = this.parse_attrs();
                if (this.kw("fn")) {
                    this.next();
                    AAttrList a6 = this.parse_attrs();
                    // The attributes before and after `fn` are adjacent in
                    // the attribute pool, so they form one list.
                    AAttrList am;
                    am.items = a5.items;
                    am.n = a5.n + a6.n;
                    this.parse_fn_trailing(am, 0, 0, 0, this.no_tpl(), lts, dstart.line, dstart.col);
                    continue;
                }
                if (this.is_type_start() == 0) {
                    this.error_at(this.peek(0), "expected a function declaration after lifetime<...>");
                    this.synchronize();
                    continue;
                }
                this.parse_function(a5, 0, 0, 0, this.no_tpl(), lts, dstart.line, dstart.col);
                continue;
            }
            if (this.kw("fn")) {
                Token dstart = this.peek(0);  // the `fn` keyword
                this.next();
                AAttrList a = this.parse_attrs();
                this.parse_fn_trailing(a, 0, 0, 0, this.no_tpl(), this.no_lt(),
                                       dstart.line, dstart.col);
                continue;
            }
            if (this.kw("enum")) {
                this.parse_enum();
                continue;
            }
            if (this.kw("struct") || this.kw("class")) {
                this.parse_struct(this.no_tpl());
                continue;
            }
            if (this.kw("using")) {
                this.parse_using();
                continue;
            }
            if (this.kw("template")) {
                Token dstart = this.peek(0);  // the `template` keyword
                this.parse_template(dstart.line, dstart.col);
                continue;
            }
            if (this.kw("concept")) {
                this.parse_concept();
                continue;
            }
            if (this.kw("import")) {
                this.parse_import();
                continue;
            }
            if (this.kw("module")) {
                this.parse_module_decl();
                continue;
            }
            if (this.kw("export")) {
                Token dstart = this.peek(0);  // the `export` keyword
                this.parse_export(dstart.line, dstart.col);
                continue;
            }
            Token dstart = this.peek(0);  // the attributes, `fn` or the type
            AAttrList a = this.parse_attrs();
            if (this.kw("fn")) {
                this.next();
                AAttrList m = this.parse_attrs();
                // The attributes before and after `fn` are adjacent in the
                // attribute pool, so they form one list.
                AAttrList am;
                am.items = a.items;
                am.n = a.n + m.n;
                this.parse_fn_trailing(am, 0, 0, 0, this.no_tpl(), this.no_lt(),
                                       dstart.line, dstart.col);
                continue;
            }
            this.parse_function(a, 0, 0, 0, this.no_tpl(), this.no_lt(), dstart.line, dstart.col);
        }
    }

    long failed() {
        return this.failed_;
    }

    void parse() {
        this.parse_top();
    }
};
