// selfhost/parsing/parser.ivy — Ivy self-host parser (H3.1: declarations).
//
// Feature-sliced port of src/parsing/parser.cpp. H3.1 covers the declaration
// grammar needed to reproduce the `ivy --ast` function dump:
//   - top-level functions (leading return type and `fn ... -> Type` form)
//   - parameters (named/unnamed, pointer/reference/const, variadic `...`,
//     native `$a` lifetimes, `Args...` packs)
//   - attributes `[[ivy::name(args)]]` on functions/parameters
//   - `extern "C"` (single declaration and `{ ... }` block)
//   - `constexpr` / `consteval` specifiers
//   - `lifetime<$a, ...>` declaration prefix
//   - Ivy fixed-width types (normalized to `_t` form), C-style types under
//     `#pragma ivy cnumber`, and `auto`
//   - function bodies: `{ }` (compound) or `;` (declaration only). Statement
//     parsing arrives in H3.3; H3.1 corpus uses empty bodies.
//
// Oracle: src/parsing/parser.cpp + dumpAst in src/app/main.cpp via `ivy --ast`.
// Harness: selfhost/difftest.ps1 -Oracle --ast -Modules token,lexer,preprocessor,parser -Driver astdrive

#pragma ivy cnumber
export module parser;
import token;
import lexer;
import preprocessor;
import ast;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);

// A parsed attribute list (slice of the parser attribute pool).
export struct AAttrList {
    AAttr* items;
    long n;
};

// A parsed parameter list (slice of the parser parameter pool).
export struct AParamList {
    AParam* items;
    long n;
    long variadic;
};

// sizeof fields: pointers are 8 bytes on the target. Pools use fixed record
// sizes (AAttr 24, AParam 64, AFunction 96) so `__ivy_alloc` can be used.
export struct Parser {
    Token* toks_;
    long n_;
    long pos_;
    long failed_;
    long cnumber_;
    char* src_;      // text arena (preprocessor output arena)

    // function pool
    AFunction* fpool_;
    long fn_n_;
    long fn_cap_;

    // attribute pool (shared by functions + params)
    AAttr* apool_;
    long ap_n_;
    long ap_cap_;

    // parameter pool
    AParam* ppool_;
    long pp_n_;
    long pp_cap_;

    // string intern buffer
    char* sbuf_;
    long sb_n_;
    long sb_cap_;

    // expression pool
    AExpr* epool_;
    long ep_n_;
    long ep_cap_;

    // statement pool
    AStmt* spool_;
    long sp_n_;
    long sp_cap_;

    // child stacks: call arguments (expr indices)
    long* cargs_;
    long ca_n_;
    long ca_cap_;

    // switch case pool
    ACase* casepool_;
    long cp_n_;
    long cp_cap_;

    // user-defined type names (struct/enum/class/using alias), stored as
    // interned pointers in a long* pool (avoids the Ivy const char** bug)
    long* tnames_;
    long tn_n_;
    long tn_cap_;

    // diagnostics
    long* dline_;
    long* dcol_;
    long* dmsg_;
    long dn_;
    long dcap_;

    long ce_;   // constexpr flag (scratch, set by parse_constexpr_spec)
    long cv_;   // consteval flag

    void setup(Token* input, long in_count, char* arena, long src_len) {
        this.toks_ = input;
        this.n_ = in_count;
        this.pos_ = 0;
        this.failed_ = 0;
        this.cnumber_ = 0;
        this.src_ = arena;
        this.fn_n_ = 0;
        this.fn_cap_ = in_count + 16;
        this.ap_n_ = 0;
        this.ap_cap_ = in_count + 16;
        this.pp_n_ = 0;
        this.pp_cap_ = in_count + 16;
        this.sb_n_ = 0;
        this.sb_cap_ = src_len + 8192;
        this.ep_n_ = 0;
        this.ep_cap_ = in_count * 8 + 256;
        this.sp_n_ = 0;
        this.sp_cap_ = in_count * 2 + 64;
        this.ca_n_ = 0;
        this.ca_cap_ = in_count + 64;
        this.cp_n_ = 0;
        this.cp_cap_ = in_count + 16;
        this.tn_n_ = 0;
        this.tn_cap_ = in_count + 16;
        this.dn_ = 0;
        this.dcap_ = in_count + 16;
        this.ce_ = 0;
        this.cv_ = 0;
        unsafe {
            this.fpool_ = (AFunction*) __ivy_alloc(this.fn_cap_ * 96);
            this.apool_ = (AAttr*) __ivy_alloc(this.ap_cap_ * 24);
            this.ppool_ = (AParam*) __ivy_alloc(this.pp_cap_ * 64);
            this.sbuf_ = (char*) __ivy_alloc(this.sb_cap_);
            this.epool_ = (AExpr*) __ivy_alloc(this.ep_cap_ * 112);
            this.spool_ = (AStmt*) __ivy_alloc(this.sp_cap_ * 112);
            this.cargs_ = (long*) __ivy_alloc(this.ca_cap_ * 8);
            this.casepool_ = (ACase*) __ivy_alloc(this.cp_cap_ * 24);
            this.dline_ = (long*) __ivy_alloc(this.dcap_ * 8);
            this.dcol_ = (long*) __ivy_alloc(this.dcap_ * 8);
            this.dmsg_ = (long*) __ivy_alloc(this.dcap_ * 8);
            this.tnames_ = (long*) __ivy_alloc(this.tn_cap_ * 8);
        }
    }

    void set_cnumber(long v) {
        this.cnumber_ = v;
    }

    void release() {
        unsafe {
            __ivy_free(this.fpool_);
            __ivy_free(this.apool_);
            __ivy_free(this.ppool_);
            __ivy_free(this.sbuf_);
            __ivy_free(this.epool_);
            __ivy_free(this.spool_);
            __ivy_free(this.cargs_);
            __ivy_free(this.casepool_);
            __ivy_free(this.dline_);
            __ivy_free(this.dcol_);
            __ivy_free((void*)this.dmsg_);
            __ivy_free(this.tnames_);
        }
    }

    // --- string helpers ---------------------------------------------------

    long cstr_len(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    bool cstr_eq(const char* a, const char* b) {
        unsafe {
            long i = 0;
            while (a[i] != 0) {
                if (b[i] != a[i]) {
                    return false;
                }
                if (b[i] == 0) {
                    return false;
                }
                i = i + 1;
            }
            return b[i] == 0;
        }
        return false;
    }

    bool kind_eq(Token t, const char* s) {
        unsafe {
            long i = 0;
            while (s[i] != 0) {
                if (t.kind[i] != s[i]) {
                    return false;
                }
                i = i + 1;
            }
            return t.kind[i] == 0;
        }
        return false;
    }

    bool lexeme_eq(long off, long len, const char* lit) {
        unsafe {
            long i = 0;
            while (lit[i] != 0) {
                if (i >= len) {
                    return false;
                }
                if (this.src_[off + i] != lit[i]) {
                    return false;
                }
                i = i + 1;
            }
            return i == len;
        }
        return false;
    }

    // --- user-defined type name registry ----------------------------------

    long token_is_type_name(Token t) {
        long i = 0;
        while (i < this.tn_n_) {
            unsafe {
                const char* nm = reinterpret_cast<const char*>(this.tnames_[i]);
                if (this.lexeme_eq(t.off, t.len, nm)) {
                    return 1;
                }
            }
            i = i + 1;
        }
        return 0;
    }

    void register_type_name(const char* s) {
        if (this.tn_n_ < this.tn_cap_) {
            unsafe {
                this.tnames_[this.tn_n_] = (long) s;
            }
            this.tn_n_ = this.tn_n_ + 1;
        }
    }

    Token eof_tok() {
        Token t;
        unsafe {
            t.kind = (char*)"eof";
        }
        t.line = 0;
        t.col = 0;
        t.off = 0;
        t.len = 0;
        return t;
    }

    Token peek(long k) {
        if (this.pos_ + k < this.n_) {
            unsafe {
                return this.toks_[this.pos_ + k];
            }
        }
        return this.eof_tok();
    }

    Token next() {
        Token t = this.peek(0);
        if (this.pos_ < this.n_) {
            this.pos_ = this.pos_ + 1;
        }
        return t;
    }

    bool at(const char* s) {
        return this.kind_eq(this.peek(0), s);
    }

    bool kw(const char* s) {
        Token t = this.peek(0);
        return this.kind_eq(t, "keyword") && this.lexeme_eq(t.off, t.len, s);
    }

    bool at_lifetime() {
        return this.kind_eq(this.peek(0), "lifetime");
    }

    // --- diagnostics ------------------------------------------------------

    void error_at(Token t, const char* msg) {
        if (this.failed_ != 0) {
            if (this.kind_eq(t, "eof")) {
                return;
            }
        }
        if (this.dn_ >= this.dcap_) {
            return;
        }
        unsafe {
            this.dline_[this.dn_] = t.line;
            this.dcol_[this.dn_] = t.col;
            this.dmsg_[this.dn_] = (long) msg;
        }
        this.dn_ = this.dn_ + 1;
        this.failed_ = 1;
    }

    long diag_count() {
        return this.dn_;
    }

    long diag_line(long i) {
        unsafe {
            return this.dline_[i];
        }
        return 0;
    }

    long diag_col(long i) {
        unsafe {
            return this.dcol_[i];
        }
        return 0;
    }

    const char* diag_msg(long i) {
        unsafe {
            return reinterpret_cast<const char*>(this.dmsg_[i]);
        }
        return "";
    }

    void expect(const char* kind, const char* msg) {
        if (this.at(kind)) {
            this.next();
            return;
        }
        this.error_at(this.peek(0), msg);
        this.next();
    }

    void expect_kw(const char* word, const char* msg) {
        if (this.kw(word)) {
            this.next();
            return;
        }
        this.error_at(this.peek(0), msg);
        this.next();
    }

    void synchronize() {
        if (this.at("eof")) {
            return;
        }
        long advanced = 0;
        while (!this.at(";") && !this.at("}") && !this.at("eof")) {
            this.next();
            advanced = 1;
        }
        if (this.at(";")) {
            this.next();
            advanced = 1;
        }
        if (advanced == 0) {
            this.next();
        }
    }

    // --- string interning -------------------------------------------------

    void sb_put(const char* s, long n) {
        if (this.sb_n_ + n + 1 > this.sb_cap_) {
            return;
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, s, (unsigned long long)n);
        }
        this.sb_n_ = this.sb_n_ + n;
    }

    void sb_put_raw(const char* s, long n) {
        if (this.sb_n_ + n + 1 > this.sb_cap_) {
            return;
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, s, (unsigned long long)n);
            this.sbuf_[this.sb_n_ + n] = 0;
        }
        this.sb_n_ = this.sb_n_ + n;
    }

    const char* intern(long off, long len) {
        long start = this.sb_n_;
        if (this.sb_n_ + len + 1 > this.sb_cap_) {
            return "";
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, this.src_ + off, (unsigned long long)len);
            this.sbuf_[this.sb_n_ + len] = 0;
        }
        this.sb_n_ = this.sb_n_ + len + 1;
        unsafe {
            return this.sbuf_ + start;
        }
        return "";
    }

    const char* intern_tok(Token t) {
        unsafe {
            return this.intern(t.off, t.len);
        }
        return "";
    }

    // --- type predicates --------------------------------------------------

    // Ivy-native type keyword -> canonical `_t` name ("" if not one).
    const char* ivy_base(Token t) {
        if (this.lexeme_eq(t.off, t.len, "int8")) { return "int8_t"; }
        if (this.lexeme_eq(t.off, t.len, "int16")) { return "int16_t"; }
        if (this.lexeme_eq(t.off, t.len, "int32")) { return "int32_t"; }
        if (this.lexeme_eq(t.off, t.len, "int64")) { return "int64_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint8")) { return "uint8_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint16")) { return "uint16_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint32")) { return "uint32_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint64")) { return "uint64_t"; }
        if (this.lexeme_eq(t.off, t.len, "int128")) { return "int128_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint128")) { return "uint128_t"; }
        if (this.lexeme_eq(t.off, t.len, "float16")) { return "float16_t"; }
        if (this.lexeme_eq(t.off, t.len, "float32")) { return "float32_t"; }
        if (this.lexeme_eq(t.off, t.len, "float64")) { return "float64_t"; }
        if (this.lexeme_eq(t.off, t.len, "float128")) { return "float128_t"; }
        if (this.lexeme_eq(t.off, t.len, "bfloat16")) { return "bfloat16_t"; }
        if (this.lexeme_eq(t.off, t.len, "iptr")) { return "ptrdiff_t"; }
        if (this.lexeme_eq(t.off, t.len, "uptr")) { return "uptr_t"; }
        if (this.lexeme_eq(t.off, t.len, "size")) { return "size_t"; }
        return "";
    }

    long ivy_unsign(const char* base) {
        if (this.cstr_eq(base, "uint8_t")) { return 1; }
        if (this.cstr_eq(base, "uint16_t")) { return 1; }
        if (this.cstr_eq(base, "uint32_t")) { return 1; }
        if (this.cstr_eq(base, "uint64_t")) { return 1; }
        if (this.cstr_eq(base, "uint128_t")) { return 1; }
        if (this.cstr_eq(base, "uptr_t")) { return 1; }
        if (this.cstr_eq(base, "size_t")) { return 1; }
        return 0;
    }

    bool is_ivy_type_kw(Token t) {
        return this.lexeme_eq(t.off, t.len, "int8") ||
               this.lexeme_eq(t.off, t.len, "int16") ||
               this.lexeme_eq(t.off, t.len, "int32") ||
               this.lexeme_eq(t.off, t.len, "int64") ||
               this.lexeme_eq(t.off, t.len, "uint8") ||
               this.lexeme_eq(t.off, t.len, "uint16") ||
               this.lexeme_eq(t.off, t.len, "uint32") ||
               this.lexeme_eq(t.off, t.len, "uint64") ||
               this.lexeme_eq(t.off, t.len, "int128") ||
               this.lexeme_eq(t.off, t.len, "uint128") ||
               this.lexeme_eq(t.off, t.len, "float16") ||
               this.lexeme_eq(t.off, t.len, "float32") ||
               this.lexeme_eq(t.off, t.len, "float64") ||
               this.lexeme_eq(t.off, t.len, "float128") ||
               this.lexeme_eq(t.off, t.len, "bfloat16") ||
               this.lexeme_eq(t.off, t.len, "iptr") ||
               this.lexeme_eq(t.off, t.len, "uptr") ||
               this.lexeme_eq(t.off, t.len, "size");
    }

    // E3: `_t`-suffixed keywords are recognized so parse_type can reject them.
    bool is_removed_t(Token t) {
        return this.lexeme_eq(t.off, t.len, "int8_t") ||
               this.lexeme_eq(t.off, t.len, "int16_t") ||
               this.lexeme_eq(t.off, t.len, "int32_t") ||
               this.lexeme_eq(t.off, t.len, "int64_t") ||
               this.lexeme_eq(t.off, t.len, "uint8_t") ||
               this.lexeme_eq(t.off, t.len, "uint16_t") ||
               this.lexeme_eq(t.off, t.len, "uint32_t") ||
               this.lexeme_eq(t.off, t.len, "uint64_t") ||
               this.lexeme_eq(t.off, t.len, "float16_t") ||
               this.lexeme_eq(t.off, t.len, "float32_t") ||
               this.lexeme_eq(t.off, t.len, "float64_t") ||
               this.lexeme_eq(t.off, t.len, "float128_t") ||
               this.lexeme_eq(t.off, t.len, "bfloat16_t") ||
               this.lexeme_eq(t.off, t.len, "size_t") ||
               this.lexeme_eq(t.off, t.len, "ptrdiff_t") ||
               this.lexeme_eq(t.off, t.len, "uptr_t") ||
               this.lexeme_eq(t.off, t.len, "int128_t") ||
               this.lexeme_eq(t.off, t.len, "uint128_t");
    }

    bool is_base_type_kw(Token t) {
        return this.lexeme_eq(t.off, t.len, "const") ||
               this.lexeme_eq(t.off, t.len, "unsigned") ||
               this.lexeme_eq(t.off, t.len, "signed") ||
               this.lexeme_eq(t.off, t.len, "void") ||
               this.lexeme_eq(t.off, t.len, "bool") ||
               this.lexeme_eq(t.off, t.len, "char") ||
               this.lexeme_eq(t.off, t.len, "short") ||
               this.lexeme_eq(t.off, t.len, "int") ||
               this.lexeme_eq(t.off, t.len, "long") ||
               this.lexeme_eq(t.off, t.len, "float") ||
               this.lexeme_eq(t.off, t.len, "double") ||
               this.lexeme_eq(t.off, t.len, "auto") ||
               this.lexeme_eq(t.off, t.len, "nullptr_t") ||
               this.lexeme_eq(t.off, t.len, "max_align_t") ||
               this.is_ivy_type_kw(t);
    }

    bool is_cstyle_kw(Token t) {
        return this.lexeme_eq(t.off, t.len, "unsigned") ||
               this.lexeme_eq(t.off, t.len, "signed") ||
               this.lexeme_eq(t.off, t.len, "char") ||
               this.lexeme_eq(t.off, t.len, "short") ||
               this.lexeme_eq(t.off, t.len, "int") ||
               this.lexeme_eq(t.off, t.len, "long") ||
               this.lexeme_eq(t.off, t.len, "float") ||
               this.lexeme_eq(t.off, t.len, "double");
    }

    long is_type_start() {
        Token t = this.peek(0);
        if (this.kind_eq(t, "identifier")) {
            return this.token_is_type_name(t);
        }
        if (!this.kind_eq(t, "keyword")) {
            return 0;
        }
        if (this.cnumber_ == 0) {
            if (this.is_cstyle_kw(t)) {
                return 0;
            }
        }
        if (this.is_base_type_kw(t)) {
            return 1;
        }
        if (this.is_removed_t(t)) {
            return 1;
        }
        return 0;
    }

    // --- parseType --------------------------------------------------------

    AType parse_type() {
        AType t;
        t.base = "";
        t.is_unsigned = 0;
        t.is_const = 0;
        t.is_ref = 0;
        t.ptr_depth = 0;
        if (this.kw("const")) {
            t.is_const = 1;
            this.next();
        }
        if (this.kw("auto")) {
            this.next();
            t.base = "auto";
            while (this.at("*")) {
                this.next();
                t.ptr_depth = t.ptr_depth + 1;
            }
            if (this.at("&")) {
                this.next();
                t.is_ref = 1;
            }
            return t;
        }
        if (this.at("identifier") && this.token_is_type_name(this.peek(0)) != 0) {
            Token u = this.peek(0);
            this.next();
            t.base = this.intern_tok(u);
            if (this.at("<")) {
                this.skip_angle_args();
            }
            while (this.at("*")) {
                this.next();
                t.ptr_depth = t.ptr_depth + 1;
                if (this.kw("const")) {
                    this.next();
                }
            }
            if (this.at("&")) {
                this.next();
                t.is_ref = 1;
                if (this.kw("const")) {
                    t.is_const = 1;
                    this.next();
                }
            }
            return t;
        }
        long saw = 0;
        if (this.kw("unsigned") || this.kw("signed")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type requires #pragma ivy cnumber; use a fixed-width type like int32/uint32");
            }
            t.is_unsigned = this.kw("unsigned") ? 1 : 0;
            saw = 1;
            this.next();
        }
        if (this.is_ivy_type_kw(this.peek(0))) {
            Token c = this.peek(0);
            t.base = this.ivy_base(c);
            this.next();
            if (saw == 0) {
                t.is_unsigned = this.ivy_unsign(t.base);
            }
        }
        if (this.kw("nullptr_t")) {
            this.next();
            t.base = "nullptr_t";
        }
        if (this.kw("max_align_t")) {
            this.next();
            t.base = "max_align_t";
        }
        if (this.kw("char")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'char' requires #pragma ivy cnumber; use int8/uint8");
            }
            this.next();
            t.base = "char";
        }
        if (this.kw("short")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'short' requires #pragma ivy cnumber; use int16/uint16");
            }
            this.next();
            if (this.kw("int")) {
                this.next();
            }
            t.base = "short";
        }
        if (this.kw("int")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'int' requires #pragma ivy cnumber; use int32/uint32");
            }
            this.next();
            t.base = "int";
        }
        if (this.kw("float")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'float' requires #pragma ivy cnumber; use float32");
            }
            this.next();
            t.base = "float";
        }
        if (this.kw("double")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'double' requires #pragma ivy cnumber; use float64");
            }
            this.next();
            t.base = "double";
        }
        if (this.kw("bool")) {
            this.next();
            t.base = "bool";
        }
        if (this.kw("void")) {
            this.next();
            t.base = "void";
        }
        if (this.kw("long")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'long' requires #pragma ivy cnumber; use int64");
            }
            this.next();
            if (this.kw("long")) {
                this.next();
                if (this.kw("int")) {
                    this.next();
                }
                t.base = "long long";
            } else {
                if (this.kw("double")) {
                    this.next();
                    t.base = "long double";
                } else {
                    if (this.kw("int")) {
                        this.next();
                    }
                    t.base = "long";
                }
            }
        }
        if (this.is_removed_t(this.peek(0))) {
            this.error_at(this.peek(0),
                          "_t-suffixed type is removed in .ivy files");
        }
        if (this.cstr_len(t.base) == 0) {
            if (saw == 0 && t.is_const == 0) {
                this.error_at(this.peek(0),
                              "expected a type (void, bool, int8, int16, int32, int64, uint8, ..., float32, float64, ...)");
            } else {
                t.base = "int";
            }
        }
        while (this.at("*")) {
            this.next();
            t.ptr_depth = t.ptr_depth + 1;
            if (this.kw("const")) {
                this.next();
            }
        }
        if (this.at("&")) {
            this.next();
            t.is_ref = 1;
            if (this.kw("const")) {
                t.is_const = 1;
                this.next();
            }
        }
        return t;
    }

    // --- attributes -------------------------------------------------------

    AAttrList parse_attrs() {
        AAttrList result;
        unsafe {
            long start = this.ap_n_;
            while (this.at("[") && this.kind_eq(this.peek(1), "[")) {
                this.next();
                this.next();
                const char* name = "";
                const char* ns = "";
                if (this.at("identifier") || this.at("keyword")) {
                    const char* first = this.intern_tok(this.next());
                    if (this.at("::")) {
                        this.next();
                        if (this.at("identifier") || this.at("keyword")) {
                            ns = first;
                            name = this.intern_tok(this.next());
                        } else {
                            this.error_at(this.peek(0), "expected attribute name after '::'");
                        }
                    } else {
                        name = first;
                    }
                } else {
                    this.error_at(this.peek(0), "expected attribute name");
                }
                long has_args = 0;
                const char* args = "";
                if (this.at("(")) {
                    this.next();
                    has_args = 1;
                    long ab = this.sb_n_;
                    long first2 = 1;
                    while (!this.at(")") && !this.at("eof")) {
                        if (first2 == 0) {
                            this.sb_put(", ", 2);
                        }
                        first2 = 0;
                        Token av = this.peek(0);
                        this.sb_put_raw(this.src_ + av.off, av.len);
                        this.next();
                        if (!this.at(")")) {
                            this.expect(",", "expected ',' in attribute argument list");
                        }
                    }
                    this.sbuf_[this.sb_n_] = 0;
                    args = this.sbuf_ + ab;
                    this.sb_n_ = this.sb_n_ + 1;
                    this.expect(")", "expected ')' to close attribute argument list");
                }
                this.expect("]", "expected ']'");
                this.expect("]", "expected ']'");
                if (!this.cstr_eq(ns, "") && !this.cstr_eq(ns, "ivy")) {
                    this.error_at(this.peek(0), "unknown attribute namespace: only ivy:: is supported");
                    continue;
                }
                AAttr a;
                a.name = name;
                a.args = args;
                a.has_args = has_args;
                if (this.ap_n_ < this.ap_cap_) {
                    this.apool_[this.ap_n_] = a;
                    this.ap_n_ = this.ap_n_ + 1;
                }
            }
            result.items = this.apool_ + start;
            result.n = this.ap_n_ - start;
        }
        return result;
    }

    // Copy a caller-provided attribute list into the pool; returns its index.
    long copy_attrs(AAttrList l) {
        long start = this.ap_n_;
        long i = 0;
        while (i < l.n) {
            if (this.ap_n_ < this.ap_cap_) {
                unsafe {
                    this.apool_[this.ap_n_] = l.items[i];
                }
                this.ap_n_ = this.ap_n_ + 1;
            }
            i = i + 1;
        }
        return start;
    }

    void push_fn(AFunction f) {
        if (this.fn_n_ >= this.fn_cap_) {
            return;
        }
        unsafe {
            this.fpool_[this.fn_n_] = f;
        }
        this.fn_n_ = this.fn_n_ + 1;
    }

    void push_param(AParam p) {
        if (this.pp_n_ >= this.pp_cap_) {
            return;
        }
        unsafe {
            this.ppool_[this.pp_n_] = p;
        }
        this.pp_n_ = this.pp_n_ + 1;
    }

    long fn_count() {
        return this.fn_n_;
    }

    AFunction get_fn(long i) {
        unsafe {
            if (i < this.fn_n_) {
                return this.fpool_[i];
            }
            return this.fpool_[0];
        }
    }

    // --- declarations -----------------------------------------------------

    void parse_constexpr_spec() {
        this.ce_ = 0;
        this.cv_ = 0;
        while (this.kw("constexpr") || this.kw("consteval")) {
            if (this.kw("constexpr")) {
                this.ce_ = 1;
                this.next();
            } else {
                this.cv_ = 1;
                this.ce_ = 1;
                this.next();
            }
        }
    }

    void parse_lifetime_decl() {
        this.next();  // `lifetime`
        if (!this.at("<")) {
            this.error_at(this.peek(0), "expected '<' after 'lifetime'");
            return;
        }
        this.next();
        while (!this.at(">") && !this.at("eof")) {
            if (!this.at_lifetime()) {
                this.error_at(this.peek(0), "expected a lifetime variable ($name) in lifetime<...>");
                this.synchronize();
                return;
            }
            this.next();
            if (this.at(",")) {
                this.next();
            }
        }
        this.expect(">", "expected '>' to close lifetime<...>");
    }

    AParamList parse_params() {
        long start = this.pp_n_;
        long va = 0;
        while (!this.at(")") && !this.at("eof")) {
            if (this.at("...")) {
                this.next();
                va = 1;
                return this.make_param_list(start, va);
            }
            AParam p;
            p.name = "";
            unsafe {
                p.attrs = this.apool_;
            }
            p.nattrs = 0;
            p.type = this.parse_type();
            if (this.at("...")) {
                this.next();  // parameter pack marker
            }
            if (this.at_lifetime()) {
                this.next();
            }
            if (this.at("identifier")) {
                p.name = this.intern_tok(this.next());
            }
            long pa_start = this.ap_n_;
            this.parse_attrs();
            unsafe {
                p.attrs = this.apool_ + pa_start;
            }
            p.nattrs = this.ap_n_ - pa_start;
            this.push_param(p);
            if (!this.at(")")) {
                this.expect(",", "expected ',' between parameters");
                if (this.at(")")) {
                    return this.make_param_list(start, va);
                }
            }
        }
        return this.make_param_list(start, va);
    }

    AParamList make_param_list(long start, long va) {
        AParamList l;
        unsafe {
            l.items = this.ppool_ + start;
        }
        l.n = this.pp_n_ - start;
        l.variadic = va;
        return l;
    }

    // --- expressions ------------------------------------------------------

    AType empty_type() {
        AType t;
        t.base = "";
        t.is_unsigned = 0;
        t.is_const = 0;
        t.is_ref = 0;
        t.ptr_depth = 0;
        return t;
    }

    AExpr fresh(long kind) {
        AExpr e;
        e.kind = kind;
        e.ival = 0;
        e.sval = "";
        e.flag = 0;
        e.a = -1;
        e.b = -1;
        e.c = -1;
        e.astart = -1;
        e.an = 0;
        e.type = this.empty_type();
        return e;
    }

    AStmt fresh_stmt(long kind) {
        AStmt s;
        s.kind = kind;
        s.sval = "";
        s.type = this.empty_type();
        s.flag = 0;
        s.a = -1;
        s.b = -1;
        s.c = -1;
        s.sstart = -1;
        s.sn = 0;
        s.next = -1;
        return s;
    }

    long push_case(long value, long sstart, long sn) {
        long i = this.cp_n_;
        if (this.cp_n_ < this.cp_cap_) {
            unsafe {
                this.casepool_[this.cp_n_].value = value;
                this.casepool_[this.cp_n_].sstart = sstart;
                this.casepool_[this.cp_n_].sn = sn;
            }
            this.cp_n_ = this.cp_n_ + 1;
        }
        return i;
    }

    long push_expr(AExpr e) {
        long i = this.ep_n_;
        if (this.ep_n_ < this.ep_cap_) {
            unsafe {
                this.epool_[this.ep_n_] = e;
            }
            this.ep_n_ = this.ep_n_ + 1;
        }
        return i;
    }

    long push_stmt(AStmt s) {
        long i = this.sp_n_;
        if (this.sp_n_ < this.sp_cap_) {
            unsafe {
                this.spool_[this.sp_n_] = s;
            }
            this.sp_n_ = this.sp_n_ + 1;
        }
        return i;
    }

    void push_carg(long i) {
        if (this.ca_n_ < this.ca_cap_) {
            unsafe {
                this.cargs_[this.ca_n_] = i;
            }
            this.ca_n_ = this.ca_n_ + 1;
        }
    }

    void set_next(long i, long v) {
        unsafe {
            this.spool_[i].next = v;
        }
    }

    AExpr* exprs() {
        unsafe {
            return this.epool_;
        }
    }

    AStmt* stmts() {
        unsafe {
            return this.spool_;
        }
    }

    long* call_args() {
        unsafe {
            return this.cargs_;
        }
    }

    ACase* cases() {
        unsafe {
            return this.casepool_;
        }
    }

    long digit_val(char c, long base) {
        if (c >= '0' && c <= '9') {
            long v = c - '0';
            if (v < base) {
                return v;
            }
            return -1;
        }
        if (base == 16) {
            if (c >= 'a' && c <= 'f') {
                return 10 + (c - 'a');
            }
            if (c >= 'A' && c <= 'F') {
                return 10 + (c - 'A');
            }
        }
        return -1;
    }

    long parse_int_tok(Token t) {
        long base = 10;
        long i = 0;
        long n = t.len;
        unsafe {
            if (n >= 2 && this.src_[t.off] == '0' &&
                (this.src_[t.off + 1] == 'x' || this.src_[t.off + 1] == 'X')) {
                base = 16;
                i = 2;
            } else if (n >= 2 && this.src_[t.off] == '0' &&
                       (this.src_[t.off + 1] == 'b' || this.src_[t.off + 1] == 'B')) {
                base = 2;
                i = 2;
            } else if (n > 1 && this.src_[t.off] == '0') {
                base = 8;
                i = 1;
            }
            long val = 0;
            while (i < n) {
                char c = this.src_[t.off + i];
                if (c == '\'') {
                    i = i + 1;
                    continue;
                }
                long d = this.digit_val(c, base);
                if (d < 0) {
                    break;
                }
                val = val * base + d;
                i = i + 1;
            }
            return val;
        }
        return 0;
    }

    long bin_prec() {
        Token t = this.peek(0);
        if (this.kind_eq(t, "||")) { return 1; }
        if (this.kind_eq(t, "&&")) { return 2; }
        if (this.kind_eq(t, "|")) { return 3; }
        if (this.kind_eq(t, "^")) { return 4; }
        if (this.kind_eq(t, "&")) { return 5; }
        if (this.kind_eq(t, "==")) { return 6; }
        if (this.kind_eq(t, "!=")) { return 6; }
        if (this.kind_eq(t, "<")) { return 7; }
        if (this.kind_eq(t, ">")) { return 7; }
        if (this.kind_eq(t, "<=")) { return 7; }
        if (this.kind_eq(t, ">=")) { return 7; }
        if (this.kind_eq(t, "<<")) { return 8; }
        if (this.kind_eq(t, ">>")) { return 8; }
        if (this.kind_eq(t, "+")) { return 9; }
        if (this.kind_eq(t, "-")) { return 9; }
        if (this.kind_eq(t, "*")) { return 10; }
        if (this.kind_eq(t, "/")) { return 10; }
        if (this.kind_eq(t, "%")) { return 10; }
        return -1;
    }

    bool is_assign_kind() {
        Token t = this.peek(0);
        return this.kind_eq(t, "=") || this.kind_eq(t, "+=") ||
               this.kind_eq(t, "-=") || this.kind_eq(t, "*=") ||
               this.kind_eq(t, "/=") || this.kind_eq(t, "%=") ||
               this.kind_eq(t, "&=") || this.kind_eq(t, "|=") ||
               this.kind_eq(t, "^=") || this.kind_eq(t, "<<=") ||
               this.kind_eq(t, ">>=");
    }

    bool is_prefix_op(Token t) {
        return this.kind_eq(t, "!") || this.kind_eq(t, "~") ||
               this.kind_eq(t, "-") || this.kind_eq(t, "+") ||
               this.kind_eq(t, "*") || this.kind_eq(t, "&") ||
               this.kind_eq(t, "++") || this.kind_eq(t, "--");
    }

    long parse_expr() {
        long lhs = this.parse_conditional();
        if (this.is_assign_kind()) {
            Token op = this.next();
            long rhs = this.parse_expr();
            AExpr e = this.fresh(16);
            e.sval = this.intern_tok(op);
            e.a = lhs;
            e.b = rhs;
            return this.push_expr(e);
        }
        return lhs;
    }

    long parse_conditional() {
        long cond = this.parse_binary(1);
        if (this.at("?")) {
            this.next();
            long thenB = this.parse_expr();
            this.expect(":", "expected ':' in conditional expression");
            long elseB = this.parse_conditional();
            AExpr e = this.fresh(12);
            e.a = cond;
            e.b = thenB;
            e.c = elseB;
            return this.push_expr(e);
        }
        return cond;
    }

    long parse_binary(long minprec) {
        long lhs = this.parse_unary();
        while (true) {
            long prec = this.bin_prec();
            if (prec < 0 || prec < minprec) {
                break;
            }
            Token op = this.next();
            long rhs = this.parse_binary(prec + 1);
            AExpr e = this.fresh(11);
            e.sval = this.intern_tok(op);
            e.a = lhs;
            e.b = rhs;
            lhs = this.push_expr(e);
        }
        return lhs;
    }

    long parse_unary() {
        Token t = this.peek(0);
        if (this.is_prefix_op(t)) {
            Token op = this.next();
            long operand = this.parse_unary();
            AExpr e = this.fresh(10);
            e.sval = this.intern_tok(op);
            e.flag = 1;
            e.a = operand;
            return this.push_expr(e);
        }
        return this.parse_postfix(this.parse_primary());
    }

    long parse_call_args() {
        long astart = this.ca_n_;
        while (!this.at(")") && !this.at("eof")) {
            long arg = this.parse_expr();
            this.push_carg(arg);
            if (!this.at(")")) {
                this.expect(",", "expected ',' between call arguments");
                if (this.at(")")) {
                    break;
                }
            }
        }
        this.expect(")", "expected ')' to close call");
        return astart;
    }

    long parse_postfix(long lhs) {
        while (true) {
            if (this.at("::")) {
                this.next();
                if (!this.at("identifier")) {
                    this.error_at(this.peek(0), "expected name after '::'");
                    return lhs;
                }
                AExpr e = this.fresh(15);
                e.sval = this.intern_tok(this.next());
                e.a = lhs;
                lhs = this.push_expr(e);
            } else if (this.at("(")) {
                this.next();
                long astart = this.parse_call_args();
                AExpr e = this.fresh(13);
                e.a = lhs;
                e.astart = astart;
                e.an = this.ca_n_ - astart;
                lhs = this.push_expr(e);
            } else if (this.at("<")) {
                long save = this.pos_;
                this.next();
                long ok = 1;
                if (this.is_type_start() != 0) {
                    while (!this.at(">") && !this.at("eof")) {
                        if (this.is_type_start() == 0) {
                            ok = 0;
                            break;
                        }
                        this.parse_type();
                        if (this.at(",")) {
                            this.next();
                        } else {
                            break;
                        }
                    }
                    if (ok != 0 && this.at(">")) {
                        this.next();
                        if (this.at("(")) {
                            this.next();
                            long astart2 = this.parse_call_args();
                            AExpr e = this.fresh(13);
                            e.a = lhs;
                            e.astart = astart2;
                            e.an = this.ca_n_ - astart2;
                            lhs = this.push_expr(e);
                            continue;
                        }
                    }
                }
                this.pos_ = save;
                break;
            } else if (this.at("[")) {
                this.next();
                long idx = this.parse_expr();
                this.expect("]", "expected ']' after index expression");
                AExpr e = this.fresh(14);
                e.a = lhs;
                e.b = idx;
                lhs = this.push_expr(e);
            } else if (this.at(".") || this.at("->")) {
                long arrow = this.at("->") ? 1 : 0;
                this.next();
                if (!this.at("identifier")) {
                    this.error_at(this.peek(0), "expected member name after '.' or '->'");
                    return lhs;
                }
                AExpr e = this.fresh(15);
                e.sval = this.intern_tok(this.next());
                e.flag = arrow;
                e.a = lhs;
                lhs = this.push_expr(e);
            } else if (this.at("++") || this.at("--")) {
                Token op = this.next();
                AExpr e = this.fresh(10);
                e.sval = this.intern_tok(op);
                e.a = lhs;
                lhs = this.push_expr(e);
            } else if (this.at("...")) {
                this.next();
                AExpr e = this.fresh(17);
                e.a = lhs;
                lhs = this.push_expr(e);
            } else {
                break;
            }
        }
        return lhs;
    }

    long parse_primary() {
        Token t = this.peek(0);
        if (this.at("integer")) {
            this.next();
            AExpr e = this.fresh(1);
            e.ival = this.parse_int_tok(t);
            return this.push_expr(e);
        }
        if (this.at("string")) {
            this.next();
            AExpr e = this.fresh(3);
            e.sval = this.intern_tok(t);
            return this.push_expr(e);
        }
        if (this.at("char")) {
            this.next();
            AExpr e = this.fresh(4);
            e.sval = this.intern_tok(t);
            return this.push_expr(e);
        }
        if (this.kw("true") || this.kw("false")) {
            long b = this.kw("true") ? 1 : 0;
            this.next();
            AExpr e = this.fresh(5);
            e.flag = b;
            return this.push_expr(e);
        }
        if (this.kw("nullptr")) {
            this.next();
            return this.push_expr(this.fresh(6));
        }
        if (this.kw("nullopt")) {
            this.next();
            return this.push_expr(this.fresh(7));
        }
        if (this.kw("sizeof")) {
            this.next();
            this.expect("(", "expected '(' after 'sizeof'");
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0),
                              "expected type after 'sizeof(' (sizeof(expression) is not supported)");
                this.synchronize();
                return this.push_expr(this.fresh(18));
            }
            AType ty = this.parse_type();
            this.expect(")", "expected ')' after sizeof type");
            AExpr e = this.fresh(18);
            e.type = ty;
            return this.push_expr(e);
        }
        if (this.kw("alignof")) {
            this.next();
            this.expect("(", "expected '(' after 'alignof'");
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected type after 'alignof('");
                this.synchronize();
                return this.push_expr(this.fresh(19));
            }
            AType ty = this.parse_type();
            this.expect(")", "expected ')' after alignof type");
            AExpr e = this.fresh(19);
            e.type = ty;
            return this.push_expr(e);
        }
        if (this.kw("static_cast") || this.kw("reinterpret_cast") || this.kw("const_cast")) {
            long ckind = 0;
            if (this.lexeme_eq(t.off, t.len, "reinterpret_cast")) {
                ckind = 1;
            } else if (this.lexeme_eq(t.off, t.len, "const_cast")) {
                ckind = 2;
            }
            this.next();
            this.expect("<", "expected '<' after cast keyword");
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected type after cast keyword");
                this.synchronize();
                return this.push_expr(this.fresh(1));
            }
            AType ty = this.parse_type();
            this.expect(">", "expected '>' after cast target type");
            this.expect("(", "expected '(' in cast expression");
            long operand = this.parse_expr();
            this.expect(")", "expected ')' after cast expression");
            AExpr e = this.fresh(20);
            e.flag = ckind;
            e.type = ty;
            e.a = operand;
            return this.push_expr(e);
        }
        if (this.at("identifier")) {
            this.next();
            AExpr e = this.fresh(8);
            e.sval = this.intern_tok(t);
            return this.push_expr(e);
        }
        if (this.kw("this")) {
            this.next();
            return this.push_expr(this.fresh(9));
        }
        if (this.at("(")) {
            this.next();
            long content = this.parse_conditional();
            this.expect(")", "expected ')' to close parenthesized expression");
            return content;
        }
        this.error_at(t, "unexpected token in expression");
        this.next();
        return this.push_expr(this.fresh(6));
    }

    // --- statements -------------------------------------------------------

    long parse_statement() {
        // A2: `unsafe { ... }` keyword block (preferred form)
        if (this.kw("unsafe")) {
            this.next();
            long body = -1;
            if (this.at("{")) {
                body = this.parse_compound();
            } else {
                body = this.parse_statement();
            }
            AStmt s = this.fresh_stmt(13);
            s.a = body;
            return this.push_stmt(s);
        }
        if (this.kw("if")) {
            return this.parse_if();
        }
        if (this.kw("while")) {
            return this.parse_while();
        }
        if (this.kw("do")) {
            return this.parse_dowhile();
        }
        if (this.kw("for")) {
            return this.parse_for();
        }
        if (this.kw("return")) {
            return this.parse_return_stmt();
        }
        if (this.kw("break")) {
            this.next();
            this.expect(";", "expected ';' after 'break'");
            return this.push_stmt(this.fresh_stmt(9));
        }
        if (this.kw("continue")) {
            this.next();
            this.expect(";", "expected ';' after 'continue'");
            return this.push_stmt(this.fresh_stmt(10));
        }
        if (this.kw("nextcase")) {
            this.next();
            AStmt s = this.fresh_stmt(11);
            if (!this.at(";")) {
                if (!this.at("identifier")) {
                    this.error_at(this.peek(0), "expected case label after 'nextcase'");
                } else {
                    unsafe {
                        s.sval = this.intern_tok(this.peek(0));
                    }
                }
                this.next();
            }
            this.expect(";", "expected ';' after 'nextcase'");
            return this.push_stmt(s);
        }
        if (this.kw("switch")) {
            return this.parse_switch();
        }
        if (this.kw("goto")) {
            this.error_at(this.peek(0), "goto is not supported in the Ivy subset");
            this.synchronize();
            return this.push_stmt(this.fresh_stmt(14));
        }
        if (this.kw("try") || this.kw("throw")) {
            this.error_at(this.peek(0), "exceptions are not supported in the Ivy subset");
            this.synchronize();
            return this.push_stmt(this.fresh_stmt(14));
        }
        if (this.at("{")) {
            return this.parse_compound();
        }
        return this.parse_decl_or_expr_stmt();
    }

    long parse_compound() {
        this.expect("{", "expected '{'");
        long first = -1;
        long last = -1;
        long count = 0;
        while (!this.at("}") && !this.at("eof")) {
            long st = this.parse_statement();
            if (first < 0) {
                first = st;
            } else {
                this.set_next(last, st);
            }
            last = st;
            count = count + 1;
        }
        this.expect("}", "expected '}' to close block");
        AStmt s = this.fresh_stmt(1);
        s.sstart = first;
        s.sn = count;
        return this.push_stmt(s);
    }

    long parse_return_stmt() {
        this.next();
        long value = -1;
        if (!this.at(";")) {
            value = this.parse_expr();
        }
        this.expect(";", "expected ';' after return statement");
        AStmt s = this.fresh_stmt(8);
        s.a = value;
        return this.push_stmt(s);
    }

    long parse_if() {
        this.next();  // if
        long is_constexpr = 0;
        if (this.kw("constexpr")) {
            is_constexpr = 1;
            this.next();
        }
        this.expect("(", "expected '(' after 'if'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after if condition");
        long thenb = this.parse_statement();
        long elseb = -1;
        if (this.kw("else")) {
            this.next();
            elseb = this.parse_statement();
        }
        AStmt s = this.fresh_stmt(3);
        s.a = cond;
        s.b = thenb;
        s.c = elseb;
        s.flag = is_constexpr;
        return this.push_stmt(s);
    }

    long parse_while() {
        this.next();
        this.expect("(", "expected '(' after 'while'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after while condition");
        long body = this.parse_statement();
        AStmt s = this.fresh_stmt(4);
        s.a = cond;
        s.b = body;
        return this.push_stmt(s);
    }

    long parse_dowhile() {
        this.next();
        long body = this.parse_statement();
        this.expect_kw("while", "expected 'while' after do-while body");
        this.expect("(", "expected '(' after 'while'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after do-while condition");
        this.expect(";", "expected ';' after do-while");
        AStmt s = this.fresh_stmt(5);
        s.a = body;
        s.b = cond;
        return this.push_stmt(s);
    }

    long parse_for() {
        this.next();
        this.expect("(", "expected '(' after 'for'");

        // Range-based for: `for (T x : range)` / `for (T& x : range)`.
        if (this.is_type_start() != 0) {
            long save = this.pos_;
            AType type = this.parse_type();
            long is_ref = type.is_ref;
            if (this.at("identifier") && this.kind_eq(this.peek(1), ":")) {
                AStmt s = this.fresh_stmt(7);
                s.type = type;
                s.sval = this.intern_tok(this.next());
                this.next();  // ':'
                s.a = this.parse_expr();
                this.expect(")", "expected ')' after range-for range");
                s.b = this.parse_statement();
                s.flag = is_ref;
                return this.push_stmt(s);
            }
            this.pos_ = save;
        }

        long init = -1;
        if (this.at(";")) {
            init = this.push_stmt(this.fresh_stmt(14));
        } else if (this.is_type_start() != 0) {
            init = this.parse_decl(0);
        } else {
            AStmt si = this.fresh_stmt(12);
            si.a = this.parse_expr();
            init = this.push_stmt(si);
        }
        this.expect(";", "expected ';' after for-loop init");
        long cond = -1;
        if (!this.at(";")) {
            cond = this.parse_expr();
        }
        this.expect(";", "expected ';' after for-loop condition");
        long incr = -1;
        if (!this.at(")")) {
            incr = this.parse_expr();
        }
        this.expect(")", "expected ')' after for-loop increment");
        long body = this.parse_statement();
        AStmt s = this.fresh_stmt(6);
        s.a = init;
        s.b = cond;
        s.c = incr;
        s.sstart = body;
        return this.push_stmt(s);
    }

    long parse_switch() {
        this.next();
        // A6: optional switch label — `switch LABEL: (cond) { }`
        if (!this.at("(")) {
            if (this.at("identifier") && this.kind_eq(this.peek(1), ":")) {
                this.next();
                this.next();
            } else {
                this.error_at(this.peek(0), "expected '(' after 'switch'");
            }
        }
        this.expect("(", "expected '(' after 'switch'");
        long cond = this.parse_expr();
        this.expect(")", "expected ')' after switch condition");
        this.expect("{", "expected '{' to start switch body");

        long cstart = this.cp_n_;
        while (!this.at("}") && !this.at("eof")) {
            long value = -1;
            if (this.kw("case")) {
                this.next();
                // A6: optional case label — `case LABEL: value:` (two colons).
                if (this.at("identifier") && this.kind_eq(this.peek(1), ":")) {
                    long two = 0;
                    long cc = 0;
                    long i = 0;
                    while (i < 10 && !this.kind_eq(this.peek(i), "eof")) {
                        if (this.kind_eq(this.peek(i), ":")) {
                            cc = cc + 1;
                            if (cc >= 2) {
                                two = 1;
                                break;
                            }
                        }
                        if (this.kind_eq(this.peek(i), ";") || this.kind_eq(this.peek(i), "{")) {
                            break;
                        }
                        i = i + 1;
                    }
                    if (two != 0) {
                        this.next();
                        this.next();
                    }
                }
                value = this.parse_expr();
                this.expect(":", "expected ':' after case value");
            } else if (this.kw("default")) {
                this.next();
                this.expect(":", "expected ':' after 'default'");
                value = -1;
            } else {
                this.error_at(this.peek(0), "expected 'case' or 'default' inside switch");
                this.synchronize();
                break;
            }
            long first = -1;
            long last = -1;
            long count = 0;
            while (!this.at("}") && !this.at("eof") && !this.kw("case") && !this.kw("default")) {
                long st = this.parse_statement();
                if (first < 0) {
                    first = st;
                } else {
                    this.set_next(last, st);
                }
                last = st;
                count = count + 1;
            }
            this.push_case(value, first, count);
        }
        this.expect("}", "expected '}' to close switch");
        AStmt s = this.fresh_stmt(15);
        s.a = cond;
        s.sstart = cstart;
        s.sn = this.cp_n_ - cstart;
        return this.push_stmt(s);
    }

    long parse_decl_or_expr_stmt() {
        if (this.kw("constexpr")) {
            this.parse_constexpr_spec();
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected a type after constexpr");
                this.synchronize();
                return this.push_stmt(this.fresh_stmt(14));
            }
            return this.parse_decl(1);
        }
        if (this.is_type_start() != 0) {
            return this.parse_decl(1);
        }
        return this.parse_expr_stmt();
    }

    long parse_expr_stmt() {
        long value = this.parse_expr();
        this.expect(";", "expected ';' after expression");
        AStmt s = this.fresh_stmt(12);
        s.a = value;
        return this.push_stmt(s);
    }

    long parse_decl(long expect_semi) {
        AType type = this.parse_type();
        if (this.cstr_len(type.base) == 0) {
            this.synchronize();
            return this.push_stmt(this.fresh_stmt(14));
        }
        long first = this.parse_declarator(type);
        if (!this.at(",")) {
            if (expect_semi != 0) {
                this.expect(";", "expected ';' after declaration");
            }
            return first;
        }
        long last = first;
        long count = 1;
        while (this.at(",")) {
            this.next();
            AType t2 = type;
            while (this.at("*")) {
                this.next();
                t2.ptr_depth = t2.ptr_depth + 1;
            }
            long d = this.parse_declarator(t2);
            this.set_next(last, d);
            last = d;
            count = count + 1;
        }
        if (expect_semi != 0) {
            this.expect(";", "expected ';' after declaration");
        }
        AStmt s = this.fresh_stmt(1);
        s.sstart = first;
        s.sn = count;
        return this.push_stmt(s);
    }

    long parse_declarator(AType t) {
        AStmt s = this.fresh_stmt(2);
        s.type = t;
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected variable name");
            return this.push_stmt(s);
        }
        s.sval = this.intern_tok(this.next());
        if (this.at("[")) {
            this.next();
            if (this.at("integer")) {
                Token it = this.peek(0);
                long n = this.parse_int_tok(it);
                this.next();
                if (n <= 0) {
                    this.error_at(it, "array size must be a positive integer");
                }
            } else {
                this.error_at(this.peek(0),
                              "array size must be an integer constant (variable-length arrays are not supported)");
                this.synchronize();
            }
            this.expect("]", "expected ']' after array size");
        }
        if (this.at("=")) {
            this.next();
            s.a = this.parse_expr();
        } else if (this.at("{")) {
            s.a = this.parse_primary();
        } else if (this.at("(")) {
            this.next();
            AExpr call = this.fresh(13);
            AExpr callee = this.fresh(8);
            callee.sval = t.base;
            call.a = this.push_expr(callee);
            long argstart = this.ca_n_;
            call.astart = argstart;
            while (!this.at(")") && !this.at("eof")) {
                long arg = this.parse_expr();
                this.push_carg(arg);
                if (this.at(",")) {
                    this.next();
                } else {
                    break;
                }
            }
            call.an = this.ca_n_ - argstart;
            this.expect(")", "expected ')' after constructor arguments");
            s.a = this.push_expr(call);
        }
        return this.push_stmt(s);
    }

    void build_function(AFunction f, long a_start, long a_end, AType ret, const char* name,
                        AParamList pl, long is_extern_c) {
        unsafe {
            f.attrs = this.apool_ + a_start;
        }
        f.nattrs = a_end - a_start;
        f.ret = ret;
        f.name = name;
        unsafe {
            f.params = pl.items;
        }
        f.nparams = pl.n;
        f.is_extern_c = is_extern_c;
        f.body = -1;
        if (this.at("{")) {
            f.body = this.parse_compound();
        } else {
            this.expect(";", "expected '{' for function body or ';' for a declaration");
        }
        this.push_fn(f);
    }

    void parse_function(AAttrList caller, long is_extern_c, long ce, long cv) {
        unsafe {
            long a_start = this.copy_attrs(caller);
            AType ret = this.parse_type();
            if (this.cstr_len(ret.base) == 0) {
                this.synchronize();
                return;
            }
            if (this.at_lifetime()) {
                this.next();
            }
            this.parse_attrs();
            long a_end = this.ap_n_;
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected function name");
                this.synchronize();
                return;
            }
            const char* name = this.intern_tok(this.next());
            this.expect("(", "expected '(' after function name");
            AParamList pl = this.parse_params();
            this.expect(")", "expected ')' to close parameter list");
            AFunction f;
            this.build_function(f, a_start, a_end, ret, name, pl, is_extern_c);
        }
    }

    void parse_fn_trailing(AAttrList caller, long is_extern_c, long ce, long cv) {
        unsafe {
            long a_start = this.copy_attrs(caller);
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected function name after 'fn'");
                this.synchronize();
                return;
            }
            const char* name = this.intern_tok(this.next());
            this.expect("(", "expected '(' after function name");
            AParamList pl = this.parse_params();
            this.expect(")", "expected ')' to close parameter list");
            if (!this.at("->")) {
                this.error_at(this.peek(0), "expected '->' after parameter list in 'fn' declaration");
                this.synchronize();
                return;
            }
            this.next();
            AType ret = this.parse_type();
            if (this.cstr_len(ret.base) == 0) {
                this.synchronize();
                return;
            }
            if (this.at_lifetime()) {
                this.next();
            }
            this.parse_attrs();
            long a_end = this.ap_n_;
            AFunction f;
            this.build_function(f, a_start, a_end, ret, name, pl, is_extern_c);
        }
    }

    // --- user-defined aggregate types (H3.4: struct / enum / class) -------

    long is_enum_int_base(const char* b) {
        if (this.cstr_eq(b, "int") || this.cstr_eq(b, "int8") || this.cstr_eq(b, "int16") ||
            this.cstr_eq(b, "int32") || this.cstr_eq(b, "int64") || this.cstr_eq(b, "int128") ||
            this.cstr_eq(b, "uint8") || this.cstr_eq(b, "uint16") || this.cstr_eq(b, "uint32") ||
            this.cstr_eq(b, "uint64") || this.cstr_eq(b, "uint128") ||
            this.cstr_eq(b, "char") || this.cstr_eq(b, "short") || this.cstr_eq(b, "long") ||
            this.cstr_eq(b, "bool") || this.cstr_eq(b, "int8_t") || this.cstr_eq(b, "int16_t") ||
            this.cstr_eq(b, "int32_t") || this.cstr_eq(b, "int64_t") || this.cstr_eq(b, "int128_t") ||
            this.cstr_eq(b, "uint8_t") || this.cstr_eq(b, "uint16_t") || this.cstr_eq(b, "uint32_t") ||
            this.cstr_eq(b, "uint64_t") || this.cstr_eq(b, "uint128_t") ||
            this.cstr_eq(b, "size_t") || this.cstr_eq(b, "ptrdiff_t") || this.cstr_eq(b, "uptr_t")) {
            return 1;
        }
        return 0;
    }

    void skip_angle_args() {
        // Consume a balanced `< ... >` template argument list, starting at '<'.
        this.next();
        long depth = 1;
        while (depth > 0 && !this.at("eof")) {
            if (this.at("<")) {
                depth = depth + 1;
                this.next();
            } else if (this.at(">")) {
                depth = depth - 1;
                this.next();
            } else if (this.at(">>")) {
                depth = depth - 2;
                this.next();
            } else {
                this.next();
            }
        }
    }

    long skip_operator_name() {
        // On entry, positioned at the `operator` keyword.
        this.next();
        if (this.at("(") && this.kind_eq(this.peek(1), ")")) {
            this.next();
            this.next();
            return 1;
        }
        if (this.at("[") && this.kind_eq(this.peek(1), "]")) {
            this.next();
            this.next();
            return 1;
        }
        if (this.at("+") || this.at("-") || this.at("*") || this.at("/") || this.at("%") ||
            this.at("&") || this.at("|") || this.at("^") || this.at("~") || this.at("!") ||
            this.at("==") || this.at("!=") || this.at("<") || this.at(">") ||
            this.at("<=") || this.at(">=") || this.at("<<") || this.at(">>") ||
            this.at("&&") || this.at("||") || this.at("++") || this.at("--") ||
            this.at("->")) {
            this.next();
            return 1;
        }
        this.error_at(this.peek(0), "expected an operator symbol after 'operator'");
        this.next();
        return 0;
    }

    void parse_ctor_inits() {
        this.next();  // ':'
        while (!this.at("{") && !this.at(";") && !this.at("eof")) {
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected member name in constructor initializer list");
                this.synchronize();
                return;
            }
            this.next();
            this.expect("(", "expected '(' after member name in initializer list");
            this.parse_expr();
            this.expect(")", "expected ')' to close member initializer");
            if (this.at(",")) {
                this.next();
            } else {
                return;
            }
        }
    }

    void parse_method_tail() {
        if (this.kw("const")) {
            this.next();
        }
        if (this.kw("override")) {
            this.next();
        }
        if (this.at("{")) {
            this.parse_compound();
            return;
        }
        if (this.at("=")) {
            this.next();
            this.expect("integer", "expected '0' for pure virtual method");
            this.expect(";", "expected ';' after pure virtual method");
            return;
        }
        this.expect(";", "expected '{' for method body or ';' for a declaration");
    }

    void parse_struct_members(const char* bare) {
        while (!this.at("}") && !this.at("eof")) {
            if (this.kw("public") || this.kw("private") || this.kw("protected")) {
                this.next();
                if (this.at(":")) {
                    this.next();
                }
                continue;
            }
            long is_virtual = 0;
            if (this.kw("virtual")) {
                is_virtual = 1;
                this.next();
            }
            // Constructor: `Name(params) [: inits] { body }`.
            if (this.at("identifier") && this.lexeme_eq(this.peek(0).off, this.peek(0).len, bare) != 0 &&
                this.kind_eq(this.peek(1), "(")) {
                this.next();
                this.next();
                this.parse_params();
                this.expect(")", "expected ')' to close constructor parameter list");
                if (this.at(":")) {
                    this.parse_ctor_inits();
                }
                if (this.at("{")) {
                    this.parse_compound();
                } else {
                    this.expect(";", "expected '{' for constructor body or ';' for a declaration");
                }
                continue;
            }
            // Destructor: `~Name() { body }`.
            if (this.at("~") && this.kind_eq(this.peek(1), "identifier") &&
                this.lexeme_eq(this.peek(1).off, this.peek(1).len, bare) != 0 &&
                this.kind_eq(this.peek(2), "(")) {
                this.next();
                this.next();
                this.next();
                this.parse_params();
                this.expect(")", "expected ')' to close destructor parameter list");
                if (this.at("{")) {
                    this.parse_compound();
                } else if (this.at("=")) {
                    this.next();
                    this.expect("integer", "expected '0' for pure virtual destructor");
                    this.expect(";", "expected ';' after pure virtual destructor");
                } else {
                    this.expect(";", "expected '{' for destructor body or ';' for a declaration");
                }
                continue;
            }
            if (this.is_type_start() == 0) {
                this.error_at(this.peek(0), "expected field or method declaration in struct body");
                this.synchronize();
                break;
            }
            this.parse_type();
            if (this.kw("operator")) {
                if (this.skip_operator_name() == 0) {
                    this.synchronize();
                    break;
                }
                this.expect("(", "expected '(' after operator name");
                this.parse_params();
                this.expect(")", "expected ')' to close operator parameter list");
                this.parse_method_tail();
                continue;
            }
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected field or method name");
                this.synchronize();
                break;
            }
            this.next();
            if (this.at("(")) {
                this.next();
                this.parse_params();
                this.expect(")", "expected ')' to close method parameter list");
                this.parse_method_tail();
                continue;
            }
            if (this.at("=")) {
                this.next();
                this.parse_expr();
            }
            this.expect(";", "expected ';' after field declaration");
        }
    }

    void parse_struct() {
      unsafe {
        long is_class = this.kw("class") ? 1 : 0;
        this.next();
        if (!this.at("identifier")) {
            if (is_class != 0) {
                this.error_at(this.peek(0), "expected class name after 'class'");
            } else {
                this.error_at(this.peek(0), "expected struct name after 'struct'");
            }
            this.synchronize();
            return;
        }
        const char* bare = this.intern_tok(this.next());
        if (this.kw("final")) {
            this.error_at(this.peek(0), "'final' is not supported in the Ivy subset");
            this.next();
        }
        if (this.at(":")) {
            this.next();
            while (true) {
                if (this.kw("public") || this.kw("private") || this.kw("protected")) {
                    this.next();
                }
                if (this.kw("virtual")) {
                    this.next();
                }
                if (this.is_type_start() == 0) {
                    this.error_at(this.peek(0), "expected base class name after ':'");
                    this.synchronize();
                    break;
                }
                this.parse_type();
                if (this.at(",")) {
                    this.next();
                    continue;
                }
                break;
            }
        }
        this.expect("{", "expected '{' to start struct body");
        this.register_type_name(bare);
        this.parse_struct_members(bare);
        this.expect("}", "expected '}' to close struct body");
        this.expect(";", "expected ';' after struct definition");
      }
    }

    void parse_enum() {
      unsafe {
        this.next();  // 'enum'
        if (this.kw("class") || this.kw("struct")) {
            this.next();
        }
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected enum name after 'enum'");
            this.synchronize();
            return;
        }
        const char* name = this.intern_tok(this.next());
        if (this.at(":")) {
            this.next();
            AType ut = this.parse_type();
            if (this.is_enum_int_base(ut.base) == 0) {
                this.error_at(this.peek(0), "enum underlying type must be an integer type");
            }
        }
        this.expect("{", "expected '{' to start enum body");
        while (!this.at("}") && !this.at("eof")) {
            if (!this.at("identifier")) {
                this.error_at(this.peek(0), "expected enumerator name");
                this.synchronize();
                break;
            }
            this.next();
            if (this.at("=")) {
                this.next();
                this.parse_expr();
            }
            if (!this.at("}")) {
                this.expect(",", "expected ',' between enumerators");
                if (this.at("}")) {
                    break;
                }
            }
        }
        this.expect("}", "expected '}' to close enum body");
        this.expect(";", "expected ';' after enum definition");
        this.register_type_name(name);
      }
    }

    void parse_using() {
      unsafe {
        this.next();  // 'using'
        if (this.kw("namespace")) {
            this.error_at(this.peek(0), "'using namespace' is not supported in the Ivy subset");
            this.synchronize();
            return;
        }
        if (!this.at("identifier")) {
            this.error_at(this.peek(0), "expected alias name after 'using'");
            this.synchronize();
            return;
        }
        const char* name = this.intern_tok(this.next());
        if (this.at("=")) {
            this.next();
            this.parse_type();
            this.expect(";", "expected ';' after type alias");
            this.register_type_name(name);
            return;
        }
        // using-declaration / using-enum — accepted and ignored.
        while (!this.at(";") && !this.at("eof")) {
            this.next();
        }
        this.expect(";", "expected ';' after using-declaration");
      }
    }

    void parse_extern_c(AAttrList attrs) {
        if (this.at("{")) {
            this.next();
            while (!this.at("}") && !this.at("eof")) {
                AAttrList f = this.parse_attrs();
                this.parse_function(f, 1, 0, 0);
            }
            this.expect("}", "expected '}' to close extern \"C\" block");
            return;
        }
        this.parse_function(attrs, 1, 0, 0);
    }

    void parse_top() {
        while (!this.at("eof")) {
            if (this.at("#")) {
                this.error_at(this.peek(0), "unsupported preprocessor directive");
                this.synchronize();
                continue;
            }
            if (this.kw("extern")) {
                this.next();
                if (this.at("string") && this.lexeme_eq(this.peek(0).off, this.peek(0).len, "\"C\"")) {
                    this.next();
                    AAttrList a = this.parse_attrs();
                    this.parse_extern_c(a);
                } else {
                    this.error_at(this.peek(0), "only 'extern \"C\"' is supported in the Ivy subset");
                    this.synchronize();
                }
                continue;
            }
            if (this.kw("constexpr") || this.kw("consteval")) {
                this.parse_constexpr_spec();
                if (this.kw("fn")) {
                    this.next();
                    AAttrList a = this.parse_attrs();
                    this.parse_fn_trailing(a, 0, this.ce_, this.cv_);
                    continue;
                }
                if (this.is_type_start() == 0) {
                    this.error_at(this.peek(0), "expected a type after constexpr/consteval");
                    this.synchronize();
                    continue;
                }
                AAttrList a = this.parse_attrs();
                this.parse_function(a, 0, this.ce_, this.cv_);
                continue;
            }
            if (this.kw("lifetime")) {
                this.parse_lifetime_decl();
                if (this.kw("constexpr") || this.kw("consteval")) {
                    this.parse_constexpr_spec();
                    if (this.kw("fn")) {
                        this.next();
                        AAttrList a2 = this.parse_attrs();
                        this.parse_fn_trailing(a2, 0, this.ce_, this.cv_);
                        continue;
                    }
                    AAttrList a3 = this.parse_attrs();
                    this.parse_function(a3, 0, this.ce_, this.cv_);
                    continue;
                }
                if (this.kw("fn")) {
                    this.next();
                    AAttrList a4 = this.parse_attrs();
                    this.parse_fn_trailing(a4, 0, 0, 0);
                    continue;
                }
                AAttrList a5 = this.parse_attrs();
                this.parse_function(a5, 0, 0, 0);
                continue;
            }
            if (this.kw("fn")) {
                this.next();
                AAttrList a = this.parse_attrs();
                this.parse_fn_trailing(a, 0, 0, 0);
                continue;
            }
            if (this.kw("enum")) {
                this.parse_enum();
                continue;
            }
            if (this.kw("struct") || this.kw("class")) {
                this.parse_struct();
                continue;
            }
            if (this.kw("using")) {
                this.parse_using();
                continue;
            }
            AAttrList a = this.parse_attrs();
            if (this.kw("fn")) {
                this.next();
                AAttrList m = this.parse_attrs();
                this.parse_fn_trailing(a, 0, 0, 0);
                continue;
            }
            this.parse_function(a, 0, 0, 0);
        }
    }

    long failed() {
        return this.failed_;
    }

    void parse() {
        this.parse_top();
    }
};
