// selfhost/parsing/parser.ivy — Ivy self-host parser (H3.1: declarations).
//
// Feature-sliced port of src/parsing/parser.cpp. H3.1 covers the declaration
// grammar needed to reproduce the `ivy --ast` function dump:
//   - top-level functions (leading return type and `fn ... -> Type` form)
//   - parameters (named/unnamed, pointer/reference/const, variadic `...`,
//     native `$a` lifetimes, `Args...` packs)
//   - attributes `[[ivy::name(args)]]` on functions/parameters
//   - `extern "C"` (single declaration and `{ ... }` block)
//   - `constexpr` / `consteval` specifiers
//   - `lifetime<$a, ...>` declaration prefix
//   - Ivy fixed-width types (normalized to `_t` form), C-style types under
//     `#pragma ivy cnumber`, and `auto`
//   - function bodies: `{ }` (compound) or `;` (declaration only). Statement
//     parsing arrives in H3.3; H3.1 corpus uses empty bodies.
//
// Oracle: src/parsing/parser.cpp + dumpAst in src/app/main.cpp via `ivy --ast`.
// Harness: selfhost/difftest.ps1 -Oracle --ast -Modules token,lexer,preprocessor,ast,parser -Driver astdrive

#pragma ivy cnumber
export module parser;
import token;
import lexer;
import preprocessor;
import ast;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);
// The C library's decimal-to-double conversion: the oracle parses float
// literals with std::stod, which is correctly rounded, so the port needs
// the same value for compile-time constant folding.
extern "C" double strtod(const char* s, char** end);

// A parsed attribute list (slice of the parser attribute pool).
export struct AAttrList {
    AAttr* items;
    long n;
};

// A parsed parameter list (slice of the parser parameter pool).
export struct AParamList {
    AParam* items;
    long n;
    long variadic;
};

// sizeof fields: pointers are 8 bytes on the target. Pools use fixed record
// sizes (AAttr 40, AParam 128, AFunction 200, AExpr 168, AStruct 96,
// ATemplateParam 96, AConcept 48, AType 48, ALifetime 8, ALegacyLifetime 40)
// so `__ivy_alloc` can be used.
export struct Parser {
    Token* toks_;
    long n_;
    long pos_;
    long failed_;
    long cnumber_;
    char* src_;      // text arena (preprocessor output arena)

    // function pool
    AFunction* fpool_;
    long fn_n_;
    long fn_cap_;

    // attribute pool (shared by functions + params)
    AAttr* apool_;
    long ap_n_;
    long ap_cap_;

    // parameter pool
    AParam* ppool_;
    long pp_n_;
    long pp_cap_;

    // string intern buffer
    char* sbuf_;
    long sb_n_;
    long sb_cap_;

    // float-literal scratch buffer (cleaned text) and the exact value of
    // the last float literal
    char* fbuf_;
    long fb_n_;
    long fb_cap_;
    double fval_;

    // expression pool
    AExpr* epool_;
    long ep_n_;
    long ep_cap_;

    // statement pool
    AStmt* spool_;
    long sp_n_;
    long sp_cap_;

    // child stacks: call arguments (expr indices)
    long* cargs_;
    long ca_n_;
    long ca_cap_;

    // staging for call-argument indices: a linked list so nested calls do not
    // interleave their arguments with this call's contiguous slice
    long* argn_idx_;
    long* argn_next_;
    long argn_n_;
    long argn_cap_;

    // switch case pool
    ACase* casepool_;
    long cp_n_;
    long cp_cap_;

    // user-defined type names (struct/enum/class/using alias), stored as
    // interned pointers in a long* pool (avoids the Ivy const char** bug)
    long* tnames_;
    long tn_n_;
    long tn_cap_;

    // template type-parameter names currently in scope (mirrors
    // templateParamNames_ in src/parsing/parser.h); interned long* pool
    long* tpnames_;
    long tp_n_;
    long tp_cap_;

    // struct/class pool (H4.1 name resolution metadata)
    AStruct* stpool_;
    long st_n_;
    long st_cap_;

    // struct field pool
    AField* fldpool_;
    long fld_n_;
    long fld_cap_;

    // method pool (AFunction records owned by their struct)
    AFunction* mpool_;
    long m_n_;
    long m_cap_;

    // enum pool
    AEnum* enpool_;
    long en_n_;
    long en_cap_;

    // enumerator pool
    AEnumerator* enupool_;
    long enu_n_;
    long enu_cap_;

    // using-alias pool
    AAlias* alpool_;
    long al_n_;
    long al_cap_;

    // template-parameter pool (shared by function and struct templates)
    ATemplateParam* tppool_;
    long tpp_n_;
    long tpp_cap_;

    // concept pool
    AConcept* conpool_;
    long con_n_;
    long con_cap_;

    // concept requirement texts (interned pointers, stored as long)
    long* reqpool_;
    long req_n_;
    long req_cap_;

    // lifetime name pool: the names of the native `lifetime<$a, $b>`
    // declarations and the arguments of the legacy lifetime attributes
    ALifetime* ltpool_;
    long lt_n_;
    long lt_cap_;

    // legacy lifetime annotation pool: one record per `[[ivy::lt(x)]]`,
    // `[[ivy::lt_ret(x)]]` and `[[ivy::lt_def(a, b)]]` attribute
    ALegacyLifetime* llpool_;
    long ll_n_;
    long ll_cap_;

    // template-argument scratch stack: the arguments of a template-id are
    // parsed onto this stack and then copied into their own block, so that
    // every argument list ends up contiguous (a nested template-id owns its
    // own block and leaves the stack untouched).
    AType* argstack_;
    long argst_n_;
    long argst_cap_;

    // the blocks that hold the parsed template-argument lists (freed on
    // release); the pointers are stored as long
    long* argblk_;
    long argblk_n_;
    long argblk_cap_;

    // base-class name pool (struct inheritance)
    long* bpool_;
    long b_n_;
    long b_cap_;

    // H3.6 module state: `export module NAME;` interface unit + name.
    // module_name_ is an interned pointer (or ""), for the driver's
    // "module interface written" message (mirrors TranslationUnit::moduleName).
    const char* module_name_;
    long is_module_export_;

    // diagnostics
    long* dline_;
    long* dcol_;
    long* dmsg_;
    long dn_;
    long dcap_;

    long ce_;   // constexpr flag (scratch, set by parse_constexpr_spec)
    long cv_;   // consteval flag
    long pure_virtual_;  // set by parse_method_tail for `= 0` methods

    void setup(Token* input, long in_count, char* arena, long src_len) {
        this.toks_ = input;
        this.n_ = in_count;
        this.pos_ = 0;
        this.failed_ = 0;
        this.cnumber_ = 0;
        this.src_ = arena;
        this.fn_n_ = 0;
        this.fn_cap_ = in_count + 16;
        this.ap_n_ = 0;
        this.ap_cap_ = in_count + 16;
        this.pp_n_ = 0;
        this.pp_cap_ = in_count + 16;
        this.sb_n_ = 0;
        // The intern arena holds every interned string.  It is never
        // reallocated (an interned pointer must stay valid for the whole
        // parse), so it is sized up front.  A source byte can be interned
        // more than once: the identifier/type names once, the attribute
        // argument texts once (in `parse_attrs`) and a second time when
        // `record_attr_args` splits them into the individual lifetime
        // names, and the native `lifetime<...>` names once more.  Four
        // times the source length plus a fixed slack covers those copies.
        this.sb_cap_ = src_len * 4 + 65536;
        this.ep_n_ = 0;
        this.ep_cap_ = in_count * 8 + 256;
        this.sp_n_ = 0;
        this.sp_cap_ = in_count * 2 + 64;
        this.ca_n_ = 0;
        this.ca_cap_ = in_count + 64;
        this.argn_n_ = 0;
        this.argn_cap_ = in_count * 4 + 64;
        this.cp_n_ = 0;
        this.cp_cap_ = in_count + 16;
        this.tn_n_ = 0;
        this.tn_cap_ = in_count + 16;
        this.tp_n_ = 0;
        this.tp_cap_ = in_count + 16;
        this.st_n_ = 0;
        this.st_cap_ = in_count + 16;
        this.fld_n_ = 0;
        this.fld_cap_ = in_count * 2 + 64;
        this.m_n_ = 0;
        this.m_cap_ = in_count + 16;
        this.en_n_ = 0;
        this.en_cap_ = in_count + 16;
        this.enu_n_ = 0;
        this.enu_cap_ = in_count * 2 + 64;
        this.al_n_ = 0;
        this.al_cap_ = in_count + 16;
        this.tpp_n_ = 0;
        this.tpp_cap_ = in_count + 16;
        this.con_n_ = 0;
        this.con_cap_ = in_count + 16;
        this.req_n_ = 0;
        this.req_cap_ = in_count * 4 + 64;
        this.lt_n_ = 0;
        this.lt_cap_ = in_count + 16;
        this.ll_n_ = 0;
        this.ll_cap_ = in_count + 16;
        this.argst_n_ = 0;
        this.argst_cap_ = in_count * 2 + 64;
        this.argblk_n_ = 0;
        this.argblk_cap_ = in_count + 16;
        this.b_n_ = 0;
        this.b_cap_ = in_count + 16;
        this.module_name_ = "";
        this.is_module_export_ = 0;
        this.dn_ = 0;
        this.dcap_ = in_count + 16;
        this.ce_ = 0;
        this.cv_ = 0;
        this.pure_virtual_ = 0;
        unsafe {
        this.fpool_ = (AFunction*) __ivy_alloc(this.fn_cap_ * 200);
        this.apool_ = (AAttr*) __ivy_alloc(this.ap_cap_ * 40);
        this.ppool_ = (AParam*) __ivy_alloc(this.pp_cap_ * 128);
        this.sbuf_ = (char*) __ivy_alloc(this.sb_cap_);
        // The float scratch buffer holds the cleaned text of a float
        // literal: it must be able to hold the whole literal, otherwise the
        // value of the literal would be computed from a truncated text.
        this.fb_cap_ = src_len + 16;
        this.fbuf_ = (char*) __ivy_alloc(this.fb_cap_);
        this.fb_n_ = 0;
        this.fval_ = 0.0;
        this.epool_ = (AExpr*) __ivy_alloc(this.ep_cap_ * 168);
        this.spool_ = (AStmt*) __ivy_alloc(this.sp_cap_ * 136);
        this.cargs_ = (long*) __ivy_alloc(this.ca_cap_ * 8);
        this.argn_idx_ = (long*) __ivy_alloc(this.argn_cap_ * 8);
        this.argn_next_ = (long*) __ivy_alloc(this.argn_cap_ * 8);
        this.casepool_ = (ACase*) __ivy_alloc(this.cp_cap_ * 24);
        this.dline_ = (long*) __ivy_alloc(this.dcap_ * 8);
        this.dcol_ = (long*) __ivy_alloc(this.dcap_ * 8);
        this.dmsg_ = (long*) __ivy_alloc(this.dcap_ * 8);
        this.tnames_ = (long*) __ivy_alloc(this.tn_cap_ * 8);
        this.tpnames_ = (long*) __ivy_alloc(this.tp_cap_ * 8);
        this.stpool_ = (AStruct*) __ivy_alloc(this.st_cap_ * 96);
        this.fldpool_ = (AField*) __ivy_alloc(this.fld_cap_ * 72);
        this.mpool_ = (AFunction*) __ivy_alloc(this.m_cap_ * 200);
        this.enpool_ = (AEnum*) __ivy_alloc(this.en_cap_ * 96);
        this.enupool_ = (AEnumerator*) __ivy_alloc(this.enu_cap_ * 32);
        this.alpool_ = (AAlias*) __ivy_alloc(this.al_cap_ * 56);
        this.tppool_ = (ATemplateParam*) __ivy_alloc(this.tpp_cap_ * 96);
        this.conpool_ = (AConcept*) __ivy_alloc(this.con_cap_ * 48);
        this.ltpool_ = (ALifetime*) __ivy_alloc(this.lt_cap_ * 8);
        this.llpool_ = (ALegacyLifetime*) __ivy_alloc(this.ll_cap_ * 40);
        this.reqpool_ = (long*) __ivy_alloc(this.req_cap_ * 8);
        this.argstack_ = (AType*) __ivy_alloc(this.argst_cap_ * 48);
        this.argblk_ = (long*) __ivy_alloc(this.argblk_cap_ * 8);
        this.bpool_ = (long*) __ivy_alloc(this.b_cap_ * 8);
        }
    }

    void set_cnumber(long v) {
        this.cnumber_ = v;
    }

    void release() {
        unsafe {
            __ivy_free(this.fpool_);
            __ivy_free(this.apool_);
            __ivy_free(this.ppool_);
            __ivy_free(this.sbuf_);
            __ivy_free(this.fbuf_);
            __ivy_free(this.epool_);
            __ivy_free(this.spool_);
            __ivy_free(this.cargs_);
        __ivy_free(this.argn_idx_);
        __ivy_free(this.argn_next_);
            __ivy_free(this.casepool_);
            __ivy_free(this.dline_);
            __ivy_free(this.dcol_);
            __ivy_free((void*)this.dmsg_);
            __ivy_free(this.tnames_);
            __ivy_free(this.tpnames_);
            __ivy_free(this.stpool_);
            __ivy_free(this.fldpool_);
            __ivy_free(this.mpool_);
            __ivy_free(this.enpool_);
            __ivy_free(this.enupool_);
            __ivy_free(this.alpool_);
            __ivy_free(this.tppool_);
            __ivy_free(this.conpool_);
            __ivy_free(this.ltpool_);
            __ivy_free(this.llpool_);
            __ivy_free(this.reqpool_);
            __ivy_free(this.argstack_);
            unsafe {
                long bi = 0;
                while (bi < this.argblk_n_) {
                    __ivy_free((void*) this.argblk_[bi]);
                    bi = bi + 1;
                }
            }
            __ivy_free(this.argblk_);
            __ivy_free((void*)this.bpool_);
        }
    }

    // --- string helpers ---------------------------------------------------

    long cstr_len(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    bool cstr_eq(const char* a, const char* b) {
        unsafe {
            long i = 0;
            while (a[i] != 0) {
                if (b[i] != a[i]) {
                    return false;
                }
                if (b[i] == 0) {
                    return false;
                }
                i = i + 1;
            }
            return b[i] == 0;
        }
        return false;
    }

    bool kind_eq(Token t, const char* s) {
        unsafe {
            long i = 0;
            while (s[i] != 0) {
                if (t.kind[i] != s[i]) {
                    return false;
                }
                i = i + 1;
            }
            return t.kind[i] == 0;
        }
        return false;
    }

    bool lexeme_eq(long off, long len, const char* lit) {
        unsafe {
            long i = 0;
            while (lit[i] != 0) {
                if (i >= len) {
                    return false;
                }
                if (this.src_[off + i] != lit[i]) {
                    return false;
                }
                i = i + 1;
            }
            return i == len;
        }
        return false;
    }

    // --- user-defined type name registry ----------------------------------

    long token_is_type_name(Token t) {
        long i = 0;
        while (i < this.tn_n_) {
            unsafe {
                const char* nm = reinterpret_cast<const char*>(this.tnames_[i]);
                if (this.lexeme_eq(t.off, t.len, nm)) {
                    return 1;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < this.tp_n_) {
            unsafe {
                const char* nm = reinterpret_cast<const char*>(this.tpnames_[i]);
                if (this.lexeme_eq(t.off, t.len, nm)) {
                    return 1;
                }
            }
            i = i + 1;
        }
        return 0;
    }

    void register_template_param(const char* s) {
        if (this.tp_n_ < this.tp_cap_) {
            unsafe {
                this.tpnames_[this.tp_n_] = (long) s;
            }
            this.tp_n_ = this.tp_n_ + 1;
        }
    }

    void register_type_name(const char* s) {
        if (this.tn_n_ < this.tn_cap_) {
            unsafe {
                this.tnames_[this.tn_n_] = (long) s;
            }
            this.tn_n_ = this.tn_n_ + 1;
        }
    }

    Token eof_tok() {
        Token t;
        unsafe {
            t.kind = (char*)"eof";
        }
        t.line = 0;
        t.col = 0;
        t.off = 0;
        t.len = 0;
        return t;
    }

    Token peek(long k) {
        if (this.pos_ + k < this.n_) {
            unsafe {
                return this.toks_[this.pos_ + k];
            }
        }
        return this.eof_tok();
    }

    // The token at an absolute index (used when a raw token range has to be
    // rendered, e.g. a concept's parameter type).
    Token token_at(long i) {
        if (i < 0 || i >= this.n_) {
            return this.eof_tok();
        }
        unsafe {
            return this.toks_[i];
        }
    }

    Token next() {
        Token t = this.peek(0);
        if (this.pos_ < this.n_) {
            this.pos_ = this.pos_ + 1;
        }
        return t;
    }

    bool at(const char* s) {
        return this.kind_eq(this.peek(0), s);
    }

    bool kw(const char* s) {
        Token t = this.peek(0);
        return this.kind_eq(t, "keyword") && this.lexeme_eq(t.off, t.len, s);
    }

    bool at_lifetime() {
        return this.kind_eq(this.peek(0), "lifetime");
    }

    // --- diagnostics ------------------------------------------------------

    void error_at(Token t, const char* msg) {
        if (this.failed_ != 0) {
            if (this.kind_eq(t, "eof")) {
                return;
            }
        }
        if (this.dn_ >= this.dcap_) {
            return;
        }
        unsafe {
            this.dline_[this.dn_] = t.line;
            this.dcol_[this.dn_] = t.col;
            this.dmsg_[this.dn_] = (long) msg;
        }
        this.dn_ = this.dn_ + 1;
        this.failed_ = 1;
    }

    long diag_count() {
        return this.dn_;
    }

    long diag_line(long i) {
        unsafe {
            return this.dline_[i];
        }
        return 0;
    }

    long diag_col(long i) {
        unsafe {
            return this.dcol_[i];
        }
        return 0;
    }

    const char* diag_msg(long i) {
        unsafe {
            return reinterpret_cast<const char*>(this.dmsg_[i]);
        }
        return "";
    }

    void expect(const char* kind, const char* msg) {
        if (this.at(kind)) {
            this.next();
            return;
        }
        this.error_at(this.peek(0), msg);
        this.next();
    }

    void expect_kw(const char* word, const char* msg) {
        if (this.kw(word)) {
            this.next();
            return;
        }
        this.error_at(this.peek(0), msg);
        this.next();
    }

    // Build the "expected '(' after function name '<name>'" message in the
    // intern buffer (the oracle names the function in the diagnostic).
    const char* fn_name_msg(const char* name) {
        long start = this.sb_n_;
        this.sb_put_raw("expected '(' after function name '",
                       this.cstr_len("expected '(' after function name '"));
        this.sb_put_raw(name, this.cstr_len(name));
        this.sb_put_char(39);
        this.sb_end();
        unsafe {
            return this.sbuf_ + start;
        }
        return "";
    }
    void synchronize() {
        if (this.at("eof")) {
            return;
        }
        long advanced = 0;
        while (!this.at(";") && !this.at("}") && !this.at("eof")) {
            this.next();
            advanced = 1;
        }
        if (this.at(";")) {
            this.next();
            advanced = 1;
        }
        if (advanced == 0) {
            this.next();
        }
    }

    // --- string interning -------------------------------------------------

    void sb_put(const char* s, long n) {
        if (this.sb_n_ + n + 1 > this.sb_cap_) {
            return;
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, s, (unsigned long long)n);
        }
        this.sb_n_ = this.sb_n_ + n;
    }

    void sb_put_raw(const char* s, long n) {
        if (this.sb_n_ + n + 1 > this.sb_cap_) {
            return;
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, s, (unsigned long long)n);
            this.sbuf_[this.sb_n_ + n] = 0;
        }
        this.sb_n_ = this.sb_n_ + n;
    }

    // Terminate the current string and advance past the NUL so later appends
    // do not overwrite the terminator of a previously interned message.
    void sb_end() {
        if (this.sb_n_ + 1 > this.sb_cap_) {
            return;
        }
        unsafe {
            this.sbuf_[this.sb_n_] = 0;
        }
        this.sb_n_ = this.sb_n_ + 1;
    }

    const char* intern(long off, long len) {
        long start = this.sb_n_;
        if (this.sb_n_ + len + 1 > this.sb_cap_) {
            return "";
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, this.src_ + off, (unsigned long long)len);
            this.sbuf_[this.sb_n_ + len] = 0;
        }
        this.sb_n_ = this.sb_n_ + len + 1;
        unsafe {
            return this.sbuf_ + start;
        }
        return "";
    }

    const char* intern_tok(Token t) {
        unsafe {
            return this.intern(t.off, t.len);
        }
        return "";
    }

    // Copy `len` bytes of an arbitrary buffer into the intern buffer and
    // return the interned copy.
    const char* intern_buf(const char* s, long len) {
        long start = this.sb_n_;
        if (this.sb_n_ + len + 1 > this.sb_cap_) {
            return "";
        }
        unsafe {
            __ivy_memcpy(this.sbuf_ + this.sb_n_, s, (unsigned long long)len);
            this.sbuf_[this.sb_n_ + len] = 0;
        }
        this.sb_n_ = this.sb_n_ + len + 1;
        unsafe {
            return this.sbuf_ + start;
        }
        return "";
    }

    // The name of a lifetime token (`$a`) without the leading `$`.
    const char* intern_lifetime(Token t) {
        long off = t.off;
        long len = t.len;
        unsafe {
            if (len > 0 && this.src_[off] == 36) {
                off = off + 1;
                len = len - 1;
            }
            return this.intern(off, len);
        }
        return "";
    }

    // The "duplicate lifetime '$a'" message (the oracle names the lifetime
    // in the diagnostic).
    const char* dup_lt_msg(const char* name) {
        long start = this.sb_n_;
        unsafe {
            const char* p1 = "duplicate lifetime '$";
            this.sb_put(p1, this.cstr_len(p1));
            this.sb_put(name, this.cstr_len(name));
            this.sb_put_char(39);
            this.sb_end();
            return this.sbuf_ + start;
        }
        return "";
    }

    // --- floating-point literals -----------------------------------------
    //
    // The oracle prints a float literal with `operator<<(ostream&, double)`,
    // i.e. printf("%g") with 6 significant digits (C locale).  The Ivy
    // runtime formats doubles differently, so the port renders the literal
    // itself: the mantissa digits are rounded to 6 significant decimal
    // digits and then printed in %g layout (fixed when -4 <= exp < 6,
    // scientific otherwise).

    // Append one character to the intern buffer.
    void sb_put_char(char c) {
        if (this.sb_n_ + 1 > this.sb_cap_) {
            return;
        }
        unsafe {
            this.sbuf_[this.sb_n_] = c;
        }
        this.sb_n_ = this.sb_n_ + 1;
    }

    // Append a non-negative integer in decimal, padded to `minw` digits.
    void sb_put_uint_pad(long v, long minw) {
        long start = this.sb_n_;
        if (v == 0) {
            this.sb_put_char(48);
        }
        while (v > 0) {
            this.sb_put_char(48 + (v % 10));
            v = v / 10;
        }
        long len = this.sb_n_ - start;
        while (len < minw) {
            this.sb_put_char(48);
            len = len + 1;
        }
        // reverse the digits in place
        long i = this.sb_n_ - 1;
        long j = start;
        while (i > j) {
            unsafe {
                char swtmp = this.sbuf_[i];
                this.sbuf_[i] = this.sbuf_[j];
                this.sbuf_[j] = swtmp;
            }
            i = i - 1;
            j = j + 1;
        }
    }

    // Append one character to the float-literal scratch buffer.
    void fb_put_char(char c) {
        if (this.fb_n_ + 2 > this.fb_cap_) {
            return;
        }
        unsafe {
            this.fbuf_[this.fb_n_] = c;
        }
        this.fb_n_ = this.fb_n_ + 1;
    }

    // Render the floating-point literal `t` and return the interned text.
    // The exact double value of the literal is left in `this.fval_` (the
    // oracle parses the literal with std::stod, so the value must be the
    // correctly rounded one, not the 6-digit rendering).
    const char* format_float(Token t) {
        long dig_start = this.sb_n_;
        long neg = 0;
        long frac = 0;
        long expv = 0;
        long expneg = 0;
        long in_exp = 0;
        long seen_dot = 0;
        long ndig = 0;
        long i = 0;
        this.fb_n_ = 0;
        unsafe {
            while (i < t.len) {
                char c = this.src_[t.off + i];
                i = i + 1;
                if (c == 39) {
                    continue;
                }
                if (c == 'f' || c == 'F' || c == 'l' || c == 'L') {
                    break;
                }
                if (in_exp != 0) {
                    if (c == '-') {
                        expneg = 1;
                        this.fb_put_char(c);
                        continue;
                    }
                    if (c == '+') {
                        this.fb_put_char(c);
                        continue;
                    }
                    if (c < '0' || c > '9') {
                        break;
                    }
                    expv = expv * 10 + (c - 48);
                    this.fb_put_char(c);
                    continue;
                }
                if (c == 'e' || c == 'E') {
                    in_exp = 1;
                    this.fb_put_char(c);
                    continue;
                }
                if (c == '.') {
                    if (seen_dot != 0) {
                        break;
                    }
                    seen_dot = 1;
                    this.fb_put_char(c);
                    continue;
                }
                if (c == '-') {
                    if (ndig == 0 && seen_dot == 0) {
                        neg = 1;
                        this.fb_put_char(c);
                    }
                    continue;
                }
                if (c == '+') {
                    continue;
                }
                if (c < '0' || c > '9') {
                    break;
                }
                this.sb_put_char(c);
                this.fb_put_char(c);
                ndig = ndig + 1;
                if (seen_dot != 0) {
                    frac = frac + 1;
                }
            }
        }
        // The exact value of the literal (the oracle parses it with
        // std::stod, which is correctly rounded).
        unsafe {
            this.fbuf_[this.fb_n_] = 0;
        }
        unsafe {
            this.fval_ = strtod(this.fbuf_, (char**)0);
        }
        if (expneg != 0) {
            expv = -expv;
        }
        // Locate the first significant digit.
        long lead = 0;
        while (lead < ndig) {
            unsafe {
                if (this.sbuf_[dig_start + lead] != 48) {
                    break;
                }
            }
            lead = lead + 1;
        }
        long out_start = this.sb_n_;
        if (lead >= ndig) {
            // The value is zero.
            if (neg != 0) {
                this.sb_put_char(45);
            }
            this.sb_put_char(48);
            this.sb_end();
            unsafe {
                return this.sbuf_ + out_start;
            }
            return "";
        }
        long sig = ndig - lead;
        long exp10 = (ndig - frac) - lead - 1 + expv;
        if (sig > 6) {
            // Round to 6 significant digits (round half away from zero on the
            // exact decimal value).
            long roundup = 0;
            long d7 = 0;
            unsafe {
                d7 = this.sbuf_[dig_start + lead + 6] - 48;
            }
            if (d7 > 5) {
                roundup = 1;
            } else if (d7 == 5) {
                roundup = 0;
                long k = lead + 7;
                while (k < ndig) {
                    unsafe {
                        if (this.sbuf_[dig_start + k] != 48) {
                            roundup = 1;
                            break;
                        }
                    }
                    k = k + 1;
                }
                if (roundup == 0) {
                    // An exact tie is rounded to even, like the C library
                    // that formats the oracle's float literals.
                    unsafe {
                        if ((this.sbuf_[dig_start + lead + 5] - 48) % 2 != 0) {
                            roundup = 1;
                        }
                    }
                }
            }
            if (roundup != 0) {
                long p = lead + 5;
                long overflow = 0;
                while (p >= lead) {
                    long d = 0;
                    unsafe {
                        d = this.sbuf_[dig_start + p] - 48 + 1;
                    }
                    if (d <= 9) {
                        unsafe {
                            this.sbuf_[dig_start + p] = 48 + d;
                        }
                        break;
                    }
                    unsafe {
                        this.sbuf_[dig_start + p] = 48;
                    }
                    p = p - 1;
                }
                if (p < lead) {
                    // 999999 + 1 -> 1000000
                    overflow = 1;
                    unsafe {
                        this.sbuf_[dig_start + lead] = 49;
                        this.sbuf_[dig_start + lead + 1] = 48;
                        this.sbuf_[dig_start + lead + 2] = 48;
                        this.sbuf_[dig_start + lead + 3] = 48;
                        this.sbuf_[dig_start + lead + 4] = 48;
                        this.sbuf_[dig_start + lead + 5] = 48;
                    }
                    exp10 = exp10 + 1;
                }
                if (overflow != 0) {
                    sig = 6;
                }
            }
            sig = 6;
        }
        if (neg != 0) {
            this.sb_put_char(45);
        }
        if (exp10 < -4 || exp10 >= 6) {
            // Scientific layout: d.dddde+XX
            unsafe {
                this.sb_put_char(this.sbuf_[dig_start + lead]);
            }
            long frac_digits = sig - 1;
            while (frac_digits > 0) {
                long d = 0;
                unsafe {
                    d = this.sbuf_[dig_start + lead + frac_digits] - 48;
                }
                if (d != 0) {
                    break;
                }
                frac_digits = frac_digits - 1;
            }
            if (frac_digits > 0) {
                this.sb_put_char(46);
                long k = 1;
                while (k <= frac_digits) {
                    unsafe {
                        this.sb_put_char(this.sbuf_[dig_start + lead + k]);
                    }
                    k = k + 1;
                }
            }
            this.sb_put_char(101);
            if (exp10 < 0) {
                this.sb_put_char(45);
                this.sb_put_uint_pad(0 - exp10, 2);
            } else {
                this.sb_put_char(43);
                this.sb_put_uint_pad(exp10, 2);
            }
        } else {
            // Fixed layout: ddd.ddd — the fraction carries 5-exp10 digits.
            long int_digits = exp10 + 1;
            if (int_digits <= 0) {
                this.sb_put_char(48);
            } else {
                long k = 0;
                while (k < int_digits) {
                    if (k < sig) {
                        unsafe {
                            this.sb_put_char(this.sbuf_[dig_start + lead + k]);
                        }
                    } else {
                        this.sb_put_char(48);
                    }
                    k = k + 1;
                }
            }
            long want = 5 - exp10;
            long frac_start = exp10 + 1;
            long keep = want;
            while (keep > 0) {
                long idx = frac_start + keep - 1;
                long d = 0;
                if (idx >= 0 && idx < sig) {
                    unsafe {
                        d = this.sbuf_[dig_start + lead + idx] - 48;
                    }
                }
                if (d != 0) {
                    break;
                }
                keep = keep - 1;
            }
            if (keep > 0) {
                this.sb_put_char(46);
                long k = 0;
                while (k < keep) {
                    long idx = frac_start + k;
                    if (idx >= 0 && idx < sig) {
                        unsafe {
                            this.sb_put_char(this.sbuf_[dig_start + lead + idx]);
                        }
                    } else {
                        this.sb_put_char(48);
                    }
                    k = k + 1;
                }
            }
        }
        this.sb_end();
        unsafe {
            return this.sbuf_ + out_start;
        }
        return "";
    }

    // Concatenate two NUL-terminated strings into the intern buffer.
    const char* intern_join2(const char* a, const char* b) {
        long start = this.sb_n_;
        this.sb_put(a, this.cstr_len(a));
        this.sb_put(b, this.cstr_len(b));
        this.sb_end();
        unsafe {
            return this.sbuf_ + start;
        }
        return "";
    }

    const char* intern_join3(const char* a, const char* b, const char* c) {
        long start = this.sb_n_;
        this.sb_put(a, this.cstr_len(a));
        this.sb_put(b, this.cstr_len(b));
        this.sb_put(c, this.cstr_len(c));
        this.sb_end();
        unsafe {
            return this.sbuf_ + start;
        }
        return "";
    }

    // --- type predicates --------------------------------------------------

    // Ivy-native type keyword -> canonical `_t` name ("" if not one).
    const char* ivy_base(Token t) {
        if (this.lexeme_eq(t.off, t.len, "int8")) { return "int8_t"; }
        if (this.lexeme_eq(t.off, t.len, "int16")) { return "int16_t"; }
        if (this.lexeme_eq(t.off, t.len, "int32")) { return "int32_t"; }
        if (this.lexeme_eq(t.off, t.len, "int64")) { return "int64_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint8")) { return "uint8_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint16")) { return "uint16_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint32")) { return "uint32_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint64")) { return "uint64_t"; }
        if (this.lexeme_eq(t.off, t.len, "int128")) { return "int128_t"; }
        if (this.lexeme_eq(t.off, t.len, "uint128")) { return "uint128_t"; }
        if (this.lexeme_eq(t.off, t.len, "float16")) { return "float16_t"; }
        if (this.lexeme_eq(t.off, t.len, "float32")) { return "float32_t"; }
        if (this.lexeme_eq(t.off, t.len, "float64")) { return "float64_t"; }
        if (this.lexeme_eq(t.off, t.len, "float128")) { return "float128_t"; }
        if (this.lexeme_eq(t.off, t.len, "bfloat16")) { return "bfloat16_t"; }
        if (this.lexeme_eq(t.off, t.len, "iptr")) { return "ptrdiff_t"; }
        if (this.lexeme_eq(t.off, t.len, "uptr")) { return "uptr_t"; }
        if (this.lexeme_eq(t.off, t.len, "size")) { return "size_t"; }
        return "";
    }

    long ivy_unsign(const char* base) {
        if (this.cstr_eq(base, "uint8_t")) { return 1; }
        if (this.cstr_eq(base, "uint16_t")) { return 1; }
        if (this.cstr_eq(base, "uint32_t")) { return 1; }
        if (this.cstr_eq(base, "uint64_t")) { return 1; }
        if (this.cstr_eq(base, "uint128_t")) { return 1; }
        if (this.cstr_eq(base, "uptr_t")) { return 1; }
        if (this.cstr_eq(base, "size_t")) { return 1; }
        return 0;
    }

    bool is_ivy_type_kw(Token t) {
        return this.lexeme_eq(t.off, t.len, "int8") ||
               this.lexeme_eq(t.off, t.len, "int16") ||
               this.lexeme_eq(t.off, t.len, "int32") ||
               this.lexeme_eq(t.off, t.len, "int64") ||
               this.lexeme_eq(t.off, t.len, "uint8") ||
               this.lexeme_eq(t.off, t.len, "uint16") ||
               this.lexeme_eq(t.off, t.len, "uint32") ||
               this.lexeme_eq(t.off, t.len, "uint64") ||
               this.lexeme_eq(t.off, t.len, "int128") ||
               this.lexeme_eq(t.off, t.len, "uint128") ||
               this.lexeme_eq(t.off, t.len, "float16") ||
               this.lexeme_eq(t.off, t.len, "float32") ||
               this.lexeme_eq(t.off, t.len, "float64") ||
               this.lexeme_eq(t.off, t.len, "float128") ||
               this.lexeme_eq(t.off, t.len, "bfloat16") ||
               this.lexeme_eq(t.off, t.len, "iptr") ||
               this.lexeme_eq(t.off, t.len, "uptr") ||
               this.lexeme_eq(t.off, t.len, "size");
    }

    // E3: `_t`-suffixed keywords are recognized so parse_type can reject them.
    bool is_removed_t(Token t) {
        return this.lexeme_eq(t.off, t.len, "int8_t") ||
               this.lexeme_eq(t.off, t.len, "int16_t") ||
               this.lexeme_eq(t.off, t.len, "int32_t") ||
               this.lexeme_eq(t.off, t.len, "int64_t") ||
               this.lexeme_eq(t.off, t.len, "uint8_t") ||
               this.lexeme_eq(t.off, t.len, "uint16_t") ||
               this.lexeme_eq(t.off, t.len, "uint32_t") ||
               this.lexeme_eq(t.off, t.len, "uint64_t") ||
               this.lexeme_eq(t.off, t.len, "float16_t") ||
               this.lexeme_eq(t.off, t.len, "float32_t") ||
               this.lexeme_eq(t.off, t.len, "float64_t") ||
               this.lexeme_eq(t.off, t.len, "float128_t") ||
               this.lexeme_eq(t.off, t.len, "bfloat16_t") ||
               this.lexeme_eq(t.off, t.len, "size_t") ||
               this.lexeme_eq(t.off, t.len, "ptrdiff_t") ||
               this.lexeme_eq(t.off, t.len, "uptr_t") ||
               this.lexeme_eq(t.off, t.len, "int128_t") ||
               this.lexeme_eq(t.off, t.len, "uint128_t");
    }

    bool is_base_type_kw(Token t) {
        return this.lexeme_eq(t.off, t.len, "const") ||
               this.lexeme_eq(t.off, t.len, "unsigned") ||
               this.lexeme_eq(t.off, t.len, "signed") ||
               this.lexeme_eq(t.off, t.len, "void") ||
               this.lexeme_eq(t.off, t.len, "bool") ||
               this.lexeme_eq(t.off, t.len, "char") ||
               this.lexeme_eq(t.off, t.len, "short") ||
               this.lexeme_eq(t.off, t.len, "int") ||
               this.lexeme_eq(t.off, t.len, "long") ||
               this.lexeme_eq(t.off, t.len, "float") ||
               this.lexeme_eq(t.off, t.len, "double") ||
               this.lexeme_eq(t.off, t.len, "auto") ||
               this.lexeme_eq(t.off, t.len, "nullptr_t") ||
               this.lexeme_eq(t.off, t.len, "max_align_t") ||
               this.is_ivy_type_kw(t);
    }

    bool is_cstyle_kw(Token t) {
        return this.lexeme_eq(t.off, t.len, "unsigned") ||
               this.lexeme_eq(t.off, t.len, "signed") ||
               this.lexeme_eq(t.off, t.len, "char") ||
               this.lexeme_eq(t.off, t.len, "short") ||
               this.lexeme_eq(t.off, t.len, "int") ||
               this.lexeme_eq(t.off, t.len, "long") ||
               this.lexeme_eq(t.off, t.len, "float") ||
               this.lexeme_eq(t.off, t.len, "double");
    }

    long is_type_start() {
        Token t = this.peek(0);
        if (this.kind_eq(t, "identifier")) {
            return this.token_is_type_name(t);
        }
        if (!this.kind_eq(t, "keyword")) {
            return 0;
        }
        if (this.cnumber_ == 0) {
            if (this.is_cstyle_kw(t)) {
                return 0;
            }
        }
        if (this.is_base_type_kw(t)) {
            return 1;
        }
        if (this.is_removed_t(t)) {
            return 1;
        }
        return 0;
    }

    // --- parseType --------------------------------------------------------

    AType parse_type() {
        AType t;
        t.base = "";
        unsafe { t.tpl_args = (AType*)0; }
        t.tpl_n = 0;
        t.is_unsigned = 0;
        t.is_const = 0;
        t.is_ref = 0;
        t.ptr_depth = 0;
        t.array_size = 0;
        if (this.kw("const")) {
            t.is_const = 1;
            this.next();
        }
        if (this.kw("auto")) {
            this.next();
            t.base = "auto";
            while (this.at("*")) {
                this.next();
                t.ptr_depth = t.ptr_depth + 1;
            }
            if (this.at("&")) {
                this.next();
                t.is_ref = 1;
            }
            return t;
        }
        if (this.at("identifier") && this.token_is_type_name(this.peek(0)) != 0) {
            Token u = this.peek(0);
            this.next();
            t.base = this.intern_tok(u);
            // Template-id type: `Box<int32>` — keep the argument list.
            if (this.at("<")) {
                ATypeList al = this.parse_template_args();
                t.tpl_args = al.items;
                t.tpl_n = al.n;
            }
            while (this.at("*")) {
                this.next();
                t.ptr_depth = t.ptr_depth + 1;
                if (this.kw("const")) {
                    this.next();
                }
            }
            if (this.at("&")) {
                this.next();
                t.is_ref = 1;
                if (this.kw("const")) {
                    t.is_const = 1;
                    this.next();
                }
            }
            return t;
        }
        long saw = 0;
        if (this.kw("unsigned") || this.kw("signed")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type requires #pragma ivy cnumber; use a fixed-width type like int32/uint32");
            }
            t.is_unsigned = this.kw("unsigned") ? 1 : 0;
            saw = 1;
            this.next();
        }
        if (this.is_ivy_type_kw(this.peek(0))) {
            Token c = this.peek(0);
            t.base = this.ivy_base(c);
            this.next();
            if (saw == 0) {
                t.is_unsigned = this.ivy_unsign(t.base);
            }
        }
        if (this.kw("nullptr_t")) {
            this.next();
            t.base = "nullptr_t";
        }
        if (this.kw("max_align_t")) {
            this.next();
            t.base = "max_align_t";
        }
        if (this.kw("char")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'char' requires #pragma ivy cnumber; use int8/uint8");
            }
            this.next();
            t.base = "char";
        }
        if (this.kw("short")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'short' requires #pragma ivy cnumber; use int16/uint16");
            }
            this.next();
            if (this.kw("int")) {
                this.next();
            }
            t.base = "short";
        }
        if (this.kw("int")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'int' requires #pragma ivy cnumber; use int32/uint32");
            }
            this.next();
            t.base = "int";
        }
        if (this.kw("float")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'float' requires #pragma ivy cnumber; use float32");
            }
            this.next();
            t.base = "float";
        }
        if (this.kw("double")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'double' requires #pragma ivy cnumber; use float64");
            }
            this.next();
            t.base = "double";
        }
        if (this.kw("bool")) {
            this.next();
            t.base = "bool";
        }
        if (this.kw("void")) {
            this.next();
            t.base = "void";
        }
        if (this.kw("long")) {
            if (this.cnumber_ == 0) {
                this.error_at(this.peek(0),
                              "C-style type 'long' requires #pragma ivy cnumber; use int64");
            }
            this.next();
            if (this.kw("long")) {
                this.next();
                if (this.kw("int")) {
                    this.next();
                }
                t.base = "long long";
            } else {
                if (this.kw("double")) {
                    this.next();
                    t.base = "long double";
                } else {
                    if (this.kw("int")) {
                        this.next();
                    }
                    t.base = "long";
                }
            }
        }
        long e3 = 0;
        if (this.kind_eq(this.peek(0), "keyword") && this.is_removed_t(this.peek(0)) != 0) {
            Token c = this.peek(0);
            unsafe {
                long m0 = this.sb_n_;
                const char* p1 = "_t-suffixed type '";
                this.sb_put(p1, this.cstr_len(p1));
                this.sb_put_raw(this.src_ + c.off, c.len);
                const char* p2 = "' is removed — use '";
                this.sb_put(p2, this.cstr_len(p2));
                if (this.lexeme_eq(c.off, c.len, "ptrdiff_t")) {
                    this.sb_put("iptr", 4);
                } else {
                    this.sb_put_raw(this.src_ + c.off, c.len - 2);
                }
                const char* p3 = "' instead";
                this.sb_put(p3, this.cstr_len(p3));
                this.sb_end();
                this.error_at(c, this.sbuf_ + m0);
            }
            e3 = 1;
        }
        if (this.cstr_len(t.base) == 0) {
            if (e3 == 0) {
                // The oracle rejects a bare `signed` (only `unsigned` and
                // `const` alone are accepted), so the check follows the
                // resulting unsigned flag, not the presence of the keyword.
                if (t.is_unsigned == 0 && t.is_const == 0) {
                    this.error_at(this.peek(0),
                                  "expected a type (void, bool, int8, int16, int32, int64, uint8, ..., float32, float64, ...)");
                } else {
                    t.base = "int";
                }
            }
        }
        while (this.at("*")) {
            this.next();
            t.ptr_depth = t.ptr_depth + 1;
            if (this.kw("const")) {
                this.next();
            }
        }
        if (this.at("&")) {
            this.next();
            t.is_ref = 1;
            if (this.kw("const")) {
                t.is_const = 1;
                this.next();
            }
        }
        return t;
    }

    // --- attributes -------------------------------------------------------

    AAttrList parse_attrs() {
        AAttrList result;
        unsafe {
            long start = this.ap_n_;
            while (this.at("[") && this.kind_eq(this.peek(1), "[")) {
                Token attrStart = this.peek(0);
                this.next();
                this.next();
                const char* name = "";
                const char* ns = "";
                if (this.at("identifier") || this.at("keyword")) {
                    const char* first = this.intern_tok(this.next());
                    if (this.at("::")) {
                        this.next();
                        if (this.at("identifier") || this.at("keyword")) {
                            ns = first;
                            name = this.intern_tok(this.next());
                        } else {
                            this.error_at(this.peek(0), "expected attribute name after '::'");
                        }
                    } else {
                        name = first;
                    }
                } else {
                    this.error_at(this.peek(0), "expected attribute name");
                }
                long has_args = 0;
                const char* args = "";
                if (this.at("(")) {
                    this.next();
                    has_args = 1;
                    long ab = this.sb_n_;
                    long first2 = 1;
                    while (!this.at(")") && !this.at("eof")) {
                        if (first2 == 0) {
                            this.sb_put(", ", 2);
                        }
                        first2 = 0;
                        Token av = this.peek(0);
                        this.sb_put_raw(this.src_ + av.off, av.len);
                        this.next();
                        if (!this.at(")")) {
                            this.expect(",", "expected ',' in attribute argument list");
                        }
                    }
                    this.sbuf_[this.sb_n_] = 0;
                    args = this.sbuf_ + ab;
                    this.sb_n_ = this.sb_n_ + 1;
                    this.expect(")", "expected ')' to close attribute argument list");
                }
                this.expect("]", "expected ']'");
                this.expect("]", "expected ']'");
                if (!this.cstr_eq(ns, "") && !this.cstr_eq(ns, "ivy")) {
                    long m0 = this.sb_n_;
                    const char* p1 = "unknown attribute namespace '";
                    this.sb_put(p1, this.cstr_len(p1));
                    this.sb_put(ns, this.cstr_len(ns));
                    const char* p2 = "': only ivy:: attributes are supported in the Ivy subset";
                    this.sb_put(p2, this.cstr_len(p2));
                    this.sb_end();
                    this.error_at(attrStart, this.sbuf_ + m0);
                    continue;
                }
                AAttr a;
                a.name = name;
                a.args = args;
                a.has_args = has_args;
                a.line = attrStart.line;
                a.col = attrStart.col;
                if (this.ap_n_ < this.ap_cap_) {
                    this.apool_[this.ap_n_] = a;
                    this.ap_n_ = this.ap_n_ + 1;
                }
            }
            result.items = this.apool_ + start;
            result.n = this.ap_n_ - start;
        }
        return result;
    }

    void error_at_ll(long line, long col, const char* msg) {
        if (this.dn_ >= this.dcap_) {
            return;
        }
        unsafe {
            this.dline_[this.dn_] = line;
            this.dcol_[this.dn_] = col;
            this.dmsg_[this.dn_] = (long) msg;
        }
        this.dn_ = this.dn_ + 1;
        this.failed_ = 1;
    }

    void validate_list(AAttrList l, const char* a0, const char* a1) {
        long i = 0;
        while (i < l.n) {
            AAttr a;
            unsafe {
                a = l.items[i];
            }
            long ok = 0;
            if (this.cstr_len(a0) > 0 && this.cstr_eq(a.name, a0)) {
                ok = 1;
            }
            if (this.cstr_len(a1) > 0 && this.cstr_eq(a.name, a1)) {
                ok = 1;
            }
            if (ok == 0) {
                unsafe {
                    long m0 = this.sb_n_;
                    const char* p1 = "unknown Ivy attribute 'ivy::";
                    this.sb_put(p1, this.cstr_len(p1));
                    this.sb_put(a.name, this.cstr_len(a.name));
                    const char* p2 = "' in this position";
                    this.sb_put(p2, this.cstr_len(p2));
                    this.sb_end();
                    this.error_at_ll(a.line, a.col, this.sbuf_ + m0);
                }
            }
            i = i + 1;
        }
    }

    // Copy a caller-provided attribute list into the pool; returns its index.
    long copy_attrs(AAttrList l) {
        long start = this.ap_n_;
        long i = 0;
        while (i < l.n) {
            if (this.ap_n_ < this.ap_cap_) {
                unsafe {
                    this.apool_[this.ap_n_] = l.items[i];
                }
                this.ap_n_ = this.ap_n_ + 1;
            }
            i = i + 1;
        }
        return start;
    }

    void push_fn(AFunction f) {
        if (this.fn_n_ >= this.fn_cap_) {
            return;
        }
        unsafe {
            this.fpool_[this.fn_n_] = f;
        }
        this.fn_n_ = this.fn_n_ + 1;
    }

    void push_param(AParam p) {
        if (this.pp_n_ >= this.pp_cap_) {
            return;
        }
        unsafe {
            this.ppool_[this.pp_n_] = p;
        }
        this.pp_n_ = this.pp_n_ + 1;
    }

    // Append a lifetime name to the lifetime pool.
    void push_lifetime(const char* name) {
        if (this.lt_n_ >= this.lt_cap_) {
            return;
        }
        unsafe {
            this.ltpool_[this.lt_n_].name = name;
        }
        this.lt_n_ = this.lt_n_ + 1;
    }

    // A one-element lifetime list: the native lifetime of a parameter or
    // of a return type.
    ALifetimeList one_lt(const char* name) {
        ALifetimeList l;
        this.push_lifetime(name);
        unsafe {
            l.items = this.ltpool_ + this.lt_n_ - 1;
        }
        l.n = 1;
        return l;
    }

    // The empty lifetime list: no lifetime annotation at all.
    ALifetimeList no_lt() {
        ALifetimeList l;
        unsafe { l.items = (ALifetime*)0; }
        l.n = 0;
        return l;
    }

    // Append a legacy lifetime annotation to the legacy-lifetime pool.
    void push_legacy_lt(ALegacyLifetime ll) {
        if (this.ll_n_ >= this.ll_cap_) {
            return;
        }
        unsafe {
            this.llpool_[this.ll_n_] = ll;
        }
        this.ll_n_ = this.ll_n_ + 1;
    }

    // Split an attribute's argument list (the parser joins the argument
    // texts with ", ") into the individual argument names and record them
    // in the lifetime pool.  An attribute without an argument list has
    // no arguments at all.
    ALifetimeList record_attr_args(const char* args) {
        ALifetimeList res;
        long start = this.lt_n_;
        long len = this.cstr_len(args);
        unsafe {
            long i = 0;
            long argb = 0;
            while (i < len) {
                if (args[i] == 44 && i + 1 < len && args[i + 1] == 32) {
                    this.push_lifetime(this.intern_buf(args + argb, i - argb));
                    i = i + 2;
                    argb = i;
                    continue;
                }
                i = i + 1;
            }
            if (argb < len) {
                this.push_lifetime(this.intern_buf(args + argb, len - argb));
            }
            res.items = this.ltpool_ + start;
        }
        res.n = this.lt_n_ - start;
        return res;
    }

    // Collect the legacy lifetime annotations of an attribute list:
    // `[[ivy::lt(x)]]` (kind 1) on a parameter, `[[ivy::lt_ret(x)]]`
    // (kind 2) and `[[ivy::lt_def(a, b)]]` (kind 3) on a function.  The
    // annotations keep their attribute order.
    ALegacyLifetimeList collect_legacy_lts(AAttrList l) {
        ALegacyLifetimeList res;
        long start = this.ll_n_;
        long i = 0;
        while (i < l.n) {
            AAttr a;
            unsafe {
                a = l.items[i];
            }
            long kind = 0;
            if (this.cstr_eq(a.name, "lt")) {
                kind = 1;
            } else if (this.cstr_eq(a.name, "lt_ret")) {
                kind = 2;
            } else if (this.cstr_eq(a.name, "lt_def")) {
                kind = 3;
            }
            if (kind != 0) {
                ALegacyLifetime ll;
                ll.args = this.record_attr_args(a.args);
                ll.kind = kind;
                ll.line = a.line;
                ll.col = a.col;
                this.push_legacy_lt(ll);
            }
            i = i + 1;
        }
        unsafe {
            res.items = this.llpool_ + start;
        }
        res.n = this.ll_n_ - start;
        return res;
    }

    long fn_count() {
        return this.fn_n_;
    }

    AFunction get_fn(long i) {
        unsafe {
            if (i < this.fn_n_) {
                return this.fpool_[i];
            }
            return this.fpool_[0];
        }
    }

