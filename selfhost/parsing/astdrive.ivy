// selfhost/parsing/astdrive.ivy — H3.x differential-test driver for the parser
// port.
//
// Reads file paths from stdin (one per line), lexes + preprocesses each with
// the Ivy ports, parses with the Ivy parser, and prints `=== path ===` + the
// `ivy --ast` AST dump (functions + bodies, mirroring dumpAst/dumpStmt/dumpExpr).
// Preprocessor and parser diagnostics are printed in the oracle format and
// gate the dump. Used by selfhost/difftest.ps1
//   (-Oracle --ast -Modules token,lexer,preprocessor,parser,ast -Driver astdrive).

#pragma ivy cnumber
import token;
import lexer;
import preprocessor;
import ast;
import parser;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);
extern "C" unsigned long long __ivy_strlen(const char* s);

// Free functions cannot take raw-pointer parameters, so the printer is a
// struct whose fields hold them.
struct Dumper {
    AExpr* ep;
    AStmt* sp;
    long* ca;
    ACase* cp;

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    void pad(long depth) {
        long i = 0;
        while (i < depth) {
            io::print("  ");
            i = i + 1;
        }
    }

    void dump_type(AType t) {
        if (t.is_const != 0) {
            io::print("const ");
        }
        if (t.is_unsigned != 0) {
            io::print("unsigned ");
        }
        io::print(t.base);
        long i = 0;
        while (i < t.ptr_depth) {
            io::print("*");
            i = i + 1;
        }
    }

    void dump_attrs(AAttr* attrs, long n) {
        long i = 0;
        while (i < n) {
            AAttr a;
            unsafe {
                a = attrs[i];
            }
            io::print("[[ivy::");
            io::print(a.name);
            if (a.has_args != 0) {
                io::print("(");
                io::print(a.args);
                io::print(")");
            }
            io::print("]]");
            i = i + 1;
        }
    }

    void dump_expr(long idx, long depth) {
        AExpr e;
        unsafe {
            e = this.ep[idx];
        }
        this.pad(depth);
        if (e.kind == 1) {
            io::print("int {}", e.ival);
            return;
        }
        if (e.kind == 3) {
            io::print("string {}", e.sval);
            return;
        }
        if (e.kind == 4) {
            io::print("char {}", e.sval);
            return;
        }
        if (e.kind == 5) {
            if (e.flag != 0) {
                io::print("bool true");
            } else {
                io::print("bool false");
            }
            return;
        }
        if (e.kind == 6) {
            io::print("nullptr");
            return;
        }
        if (e.kind == 7) {
            io::print("nullopt");
            return;
        }
        if (e.kind == 8) {
            io::print("ident {}", e.sval);
            return;
        }
        if (e.kind == 9) {
            io::print("this");
            return;
        }
        if (e.kind == 10) {
            if (e.flag != 0) {
                io::println("prefix {}", e.sval);
            } else {
                io::println("postfix {}", e.sval);
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 11) {
            io::println("binary {}", e.sval);
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 12) {
            io::println("ternary ?:");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            this.dump_expr(e.c, depth + 1);
            return;
        }
        if (e.kind == 13) {
            io::println("call");
            this.dump_expr(e.a, depth + 1);
            long j = 0;
            while (j < e.an) {
                long ai = 0;
                unsafe {
                    ai = this.ca[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 14) {
            io::println("index");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 15) {
            if (e.flag != 0) {
                io::println("member -> {}", e.sval);
            } else {
                io::println("member . {}", e.sval);
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 16) {
            io::println("assign {}", e.sval);
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 17) {
            io::println("pack-expansion");
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 18) {
            io::println("sizeof({})", e.type.base);
            return;
        }
        if (e.kind == 19) {
            io::println("alignof({})", e.type.base);
            return;
        }
        if (e.kind == 20) {
            if (e.flag == 1) {
                io::print("reinterpret_cast");
            } else if (e.flag == 2) {
                io::print("const_cast");
            } else if (e.flag == 3) {
                io::print("C-cast");
            } else {
                io::print("static_cast");
            }
            io::println("<{}>(", e.type.base);
            this.dump_expr(e.a, depth + 1);
            this.pad(depth);
            io::println(")");
            return;
        }
    }

    void dump_compound(long idx, long depth) {
        AStmt s;
        unsafe {
            s = this.sp[idx];
        }
        this.pad(depth);
        io::println("block");
        long k = s.sstart;
        while (k >= 0) {
            this.dump_stmt(k, depth + 1);
            unsafe {
                k = this.sp[k].next;
            }
        }
    }

    void dump_stmt(long idx, long depth) {
        AStmt s;
        unsafe {
            s = this.sp[idx];
        }
        if (s.kind == 1) {
            this.dump_compound(idx, depth);
            return;
        }
        this.pad(depth);
        if (s.kind == 2) {
            io::print("decl ");
            this.dump_type(s.type);
            io::print(" {}", s.sval);
            if (s.a >= 0) {
                io::println(" =");
                this.dump_expr(s.a, depth + 1);
            } else {
                io::println("");
            }
            return;
        }
        if (s.kind == 3) {
            io::println("if");
            this.dump_expr(s.a, depth + 1);
            this.pad(depth);
            io::println("  then");
            if (s.b >= 0) {
                this.dump_stmt(s.b, depth + 1);
            }
            if (s.c >= 0) {
                this.pad(depth);
                io::println("  else");
                this.dump_stmt(s.c, depth + 1);
            }
            return;
        }
        if (s.kind == 4) {
            io::println("while");
            this.dump_expr(s.a, depth + 1);
            this.dump_stmt(s.b, depth + 1);
            return;
        }
        if (s.kind == 5) {
            io::println("do-while");
            this.dump_stmt(s.a, depth + 1);
            this.dump_expr(s.b, depth + 1);
            return;
        }
        if (s.kind == 6) {
            io::println("for");
            this.pad(depth);
            io::println("  init");
            this.dump_stmt(s.a, depth + 1);
            this.pad(depth);
            io::println("  cond");
            if (s.b >= 0) {
                this.dump_expr(s.b, depth + 1);
            }
            this.pad(depth);
            io::println("  incr");
            if (s.c >= 0) {
                this.dump_expr(s.c, depth + 1);
            }
            this.pad(depth);
            io::println("  body");
            this.dump_stmt(s.sstart, depth + 1);
            return;
        }
        if (s.kind == 7) {
            if (s.flag != 0) {
                io::println("range-for ref");
            } else {
                io::println("range-for");
            }
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            if (s.b >= 0) {
                this.dump_stmt(s.b, depth + 1);
            }
            return;
        }
        if (s.kind == 8) {
            io::println("return");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            return;
        }
        if (s.kind == 9) {
            io::println("break");
            return;
        }
        if (s.kind == 10) {
            io::println("continue");
            return;
        }
        if (s.kind == 11) {
            if (this.slen(s.sval) > 0) {
                io::println("nextcase {}", s.sval);
            } else {
                io::println("nextcase");
            }
            return;
        }
        if (s.kind == 12) {
            io::println("expr");
            this.dump_expr(s.a, depth + 1);
            return;
        }
        if (s.kind == 13) {
            io::println("unsafe");
            this.dump_stmt(s.a, depth + 1);
            return;
        }
        if (s.kind == 14) {
            io::println("null");
            return;
        }
        if (s.kind == 15) {
            io::println("switch");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            long j = 0;
            while (j < s.sn) {
                ACase c;
                unsafe {
                    c = this.cp[s.sstart + j];
                }
                if (c.value >= 0) {
                    this.pad(depth);
                    io::println("  case");
                    this.dump_expr(c.value, depth + 2);
                } else {
                    this.pad(depth);
                    io::println("  default");
                }
                long k = c.sstart;
                while (k >= 0) {
                    this.dump_stmt(k, depth + 2);
                    unsafe {
                        k = this.sp[k].next;
                    }
                }
                j = j + 1;
            }
            return;
        }
    }

    void emit(AFunction f) {
        io::print("function ");
        if (f.is_extern_c != 0) {
            io::print("[extern \"C\"] ");
        }
        this.dump_attrs(f.attrs, f.nattrs);
        io::println("");
        io::print("  return ");
        this.dump_type(f.ret);
        io::print(" ");
        io::print(f.name);
        io::print("(");
        long j = 0;
        while (j < f.nparams) {
            if (j > 0) {
                io::print(", ");
            }
            AParam p;
            unsafe {
                p = f.params[j];
            }
            this.dump_type(p.type);
            if (this.slen(p.name) > 0) {
                io::print(" ");
                io::print(p.name);
            }
            if (p.nattrs > 0) {
                io::print(" ");
                this.dump_attrs(p.attrs, p.nattrs);
            }
            j = j + 1;
        }
        io::println(")");
        if (f.body >= 0) {
            this.dump_stmt(f.body, 1);
        } else {
            io::println("  (declaration only)");
        }
        io::println("");
    }
};

void run() {
    while (true) {
        unsafe {
            char* line = io::read_line();
            if (line == (char*)0) {
                break;
            }
            uint64 np = __ivy_strlen(line);
            if (np > 0 && line[np - 1] == 13) {
                line[np - 1] = 0;
            }
            io::println("=== {} ===", line);
            char* content = io::read_file(line);
            if (content != (char*)0) {
                uint64 len = __ivy_strlen(content);
                long cap = (long)len + 16;

                Lexer lx;
                lx.setup(content, len, line);
                lx.lex_all(cap);

                if (!lx.had_error()) {
                    long in_n = lx.token_count();
                    long out_cap = in_n * 8 + 256;
                    Preprocessor pp;
                    pp.setup(lx.tokens(), in_n, content, (long)len, line, (long)np,
                             out_cap, 1024);
                    pp.run();
                    long dc = pp.diag_count();
                    long di = 0;
                    bool pp_failed = false;
                    char* fname = line;
                    if (pp.has_line_file() != 0) {
                        fname = pp.line_file();
                    }
                    while (di < dc) {
                        long w = pp.diag_warn(di);
                        if (w == 0) {
                            pp_failed = true;
                        }
                        io::print(fname);
                        io::print(":{}", pp.diag_line(di));
                        io::print(":{}", pp.diag_col(di));
                        if (w != 0) {
                            io::print(": warning: ");
                        } else {
                            io::print(": error: ");
                        }
                        io::println("{}", pp.diag_msg(di));
                        di = di + 1;
                    }
                    if (!pp_failed) {
                        Parser pa;
                        pa.setup(pp.output(), pp.output_count(), pp.arena(), (long)len);
                        pa.set_cnumber(pp.cnumber_enabled());
                        pa.parse();
                        if (pa.failed() != 0) {
                            long nd = pa.diag_count();
                            long k = 0;
                            while (k < nd) {
                                io::print(fname);
                                io::print(":{}", pa.diag_line(k));
                                io::print(":{}", pa.diag_col(k));
                                io::print(": error: ");
                                io::println("{}", pa.diag_msg(k));
                                k = k + 1;
                            }
                        } else {
                            if (pa.is_module_export() != 0) {
                                long slash = -1;
                                long qi = 0;
                                while (line[qi] != 0) {
                                    if (line[qi] == 47 || line[qi] == 92) {
                                        slash = qi;
                                    }
                                    qi = qi + 1;
                                }
                                if (slash >= 0) {
                                    line[slash] = 0;
                                }
                                io::print("ivy: module interface written to '");
                                io::print(line);
                                io::print("\\");
                                io::print(pa.module_name());
                                io::println(".ivm'");
                            }
                            Dumper d;
                            d.ep = pa.exprs();
                            d.sp = pa.stmts();
                            d.ca = pa.call_args();
                            d.cp = pa.cases();
                            long n = pa.fn_count();
                            long i = 0;
                            while (i < n) {
                                AFunction f = pa.get_fn(i);
                                d.emit(f);
                                i = i + 1;
                            }
                        }
                        pa.release();
                    }
                    pp.release();
                }
                lx.release();
                __ivy_free(content);
            }
            __ivy_free(line);
        }
    }
}

int32 main() {
    run();
    return 0;
}
