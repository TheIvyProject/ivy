// selfhost/parsing/preprocessor.ivy ? Ivy self-host preprocessor (H2.x).
//
// Feature-sliced port of src/parsing/preprocessor.cpp.
//   H2.1: object-like `#define NAME body...` + recursive replacement with a
//         self-reference cycle guard.
//   H2.2: function-like `#define NAME(params) body...`, fixed-arity and
//         variadic (`...` + `__VA_ARGS__`). Arguments are pre-expanded before
//         substitution (mirrors expandFunctionLike), the substituted body is
//         then rescanned (mirrors expandTokenVector).
//   H2.3: conditionals `#ifdef`/`#ifndef`/`#if`/`#elif`/`#else`/`#endif` and
//         `#undef`, with the `#if` constant-expression evaluator (precedence
//         climbing over `long long`, `defined NAME`/`defined(NAME)`, one-level
//         object-like macro expansion, undefined identifiers -> 0).
//   H2.4: `#` (stringify) and `##` (token paste) in macro bodies, via
//         substituteBody over raw + expanded argument token buffers (object-
//         and function-like). Synthetic lexemes (pasted/stringified text) are
//         stored in a unified text arena that also holds a copy of the source,
//         so the printer and macro-name lookups read them uniformly.
//   H2.5: predefined macros (`__LINE__`/`__FILE__` context-sensitive;
//         `__cplusplus`/`__ivy__`/`__DATE__`/`__TIME__` object-like at 0:0),
//         `#pragma ivy cnumber`, unknown-pragma / redefine-predefined /
//         #undef-predefined diagnostics, and the pp diagnostics stream
//         (emitted by the driver, gates the token dump on failure). Predefined
//         body tokens live in an extended copy of the input token buffer.
//
// Still H2.6+: `#line`, `#error`/`#warning`, `#include`, and the remaining pp
// diagnostics. The corpus (selfhost/corpus/pp/*) avoids those. An unrecognized
// directive is emitted verbatim (`#` + rest of the line, object-like macros
// expanded), exactly as the C++ generic path does.
//
// Mirrors the oracle exactly: expanded body tokens keep the *definition-site*
// line/col of the body token; substituted arguments keep the *call-site*
// line/col; the synthetic `__VA_ARGS__` join comma takes the macro name's
// line/col but the lexeme of the call-site separator; and the output stream
// ends with a synthetic `eof` token at 0:0.
//
// Oracle: src/parsing/preprocessor.cpp via `ivy --tokens`.
// Harness: selfhost/difftest.ps1 -Oracle --tokens -Driver ppdrive

#pragma ivy cnumber
export module preprocessor;
import token;
import lexer;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);

// sizeof(MacroRec): 8 * 8 = 64 bytes.
export struct MacroRec {
    long name_off;
    long name_len;
    long body_start;
    long body_count;
    long param_start;
    long param_cnt;
    long is_fn;
    long is_va;
};

// sizeof(CondRec): 4 * 8 = 32 bytes. One `#if`/`#ifdef` nesting frame.
export struct CondRec {
    long taken;
    long seen_else;
    long parent_active;
    long any_taken;
};

// sizeof(ETok): 4 * 8 = 32 bytes. One entry of the flattened `#if` expression
// stream used by the evaluator: a kind code, a precomputed integer value, and
// the source lexeme slice.
export struct ETok {
    long kind;
    long val;
    long off;
    long len;
};

// Saved output-buffer state for the argument-capture swap (mirrors the
// `std::swap(output_, out)` dance in expandFunctionLike).
export struct Preprocessor {
    Token* in_;
    long in_n_;
    char* src_;
    Token* out_;
    long out_cap_;
    long out_n_;
    MacroRec* macros_;
    long macro_cap_;
    long macro_n_;
    long* param_off_;
    long* param_len_;
    long param_cap_;
    long param_n_;
    long* stack_;   // (off,len) pairs for the expansion cycle guard
    long stack_n_;
    long stack_cap_;
    CondRec* conds_;
    long cond_cap_;
    long cond_n_;
    ETok* ex_;
    long ex_cap_;
    long ex_n_;
    long ex_pos_;
    long src_n_;      // arena cursor (bytes appended past the original source)
    long arena_cap_;  // total capacity of src_ (source copy + synthetic text)
    Token* sub_p_;    // out-param: buffer built by substitute_body
    long next_;     // out-param: index after a consumed directive/invocation
    bool cnumber_;
    bool has_error_;
    long in_cap_;     // capacity of in_ (input tokens + synthetic body tokens)
    long xt_n_;       // cursor for synthetic body tokens appended to in_
    char* file_;      // copy of the main file path (for `__FILE__`)
    long file_len_;
    char* dtxt_;      // diagnostic message text arena
    long dtxt_cap_;
    long dtxt_n_;
    long* dline_;
    long* dcol_;
    long* dtoff_;
    long* dtlen_;
    long* dwarn_;
    long dcap_;
    long dn_;

    void setup(Token* input, long in_count, char* src, long src_len,
               char* path, long path_len, long out_cap, long macro_cap) {
        this.in_n_ = in_count;
        this.in_cap_ = in_count + 256;
        this.xt_n_ = in_count;
        // Unified text arena: a copy of the original source at offset 0
        // (so all input token offsets stay valid), followed by appended
        // synthetic lexemes produced by `#` stringify and `##` paste.
        this.arena_cap_ = src_len + 1048576;
        this.file_len_ = path_len;
        unsafe {
            this.src_ = (char*) __ivy_alloc(this.arena_cap_);
            __ivy_memcpy(this.src_, src, (unsigned long long)src_len);
            this.src_[src_len] = 0;
            // Extended token buffer: the input tokens followed by room for
            // synthetic macro-body tokens (predefined macros' bodies).
            this.in_ = (Token*) __ivy_alloc(this.in_cap_ * 32);
            __ivy_memcpy(this.in_, input, (unsigned long long)(in_count * 32));
            this.file_ = (char*) __ivy_alloc(path_len + 1);
            __ivy_memcpy(this.file_, path, (unsigned long long)path_len);
            this.file_[path_len] = 0;
            this.out_ = (Token*) __ivy_alloc(out_cap * 32);
            this.macros_ = (MacroRec*) __ivy_alloc(macro_cap * 64);
            this.stack_ = (long*) __ivy_alloc(macro_cap * 16);
            this.param_off_ = (long*) __ivy_alloc(8192 * 8);
            this.param_len_ = (long*) __ivy_alloc(8192 * 8);
            this.conds_ = (CondRec*) __ivy_alloc(256 * 32);
            this.ex_ = (ETok*) __ivy_alloc(65536 * 32);
            this.dtxt_ = (char*) __ivy_alloc(65536);
            this.dline_ = (long*) __ivy_alloc(256 * 8);
            this.dcol_ = (long*) __ivy_alloc(256 * 8);
            this.dtoff_ = (long*) __ivy_alloc(256 * 8);
            this.dtlen_ = (long*) __ivy_alloc(256 * 8);
            this.dwarn_ = (long*) __ivy_alloc(256 * 8);
        }
        this.src_n_ = src_len;
        unsafe {
            this.sub_p_ = (Token*) 0;
        }
        this.out_cap_ = out_cap;
        this.out_n_ = 0;
        this.macro_cap_ = macro_cap;
        this.macro_n_ = 0;
        this.param_cap_ = 8192;
        this.param_n_ = 0;
        this.stack_cap_ = macro_cap;
        this.stack_n_ = 0;
        this.cond_cap_ = 256;
        this.cond_n_ = 0;
        this.ex_cap_ = 65536;
        this.ex_n_ = 0;
        this.ex_pos_ = 0;
        this.next_ = 0;
        this.cnumber_ = false;
        this.has_error_ = false;
        this.dtxt_cap_ = 65536;
        this.dtxt_n_ = 0;
        this.dcap_ = 256;
        this.dn_ = 0;
    }

    Token* output() {
        return this.out_;
    }

    long output_count() {
        return this.out_n_;
    }

    // Base of the unified text arena (source + synthetic lexemes). The printer
    // must read token lexemes from here, not from the original source buffer.
    char* arena() {
        return this.src_;
    }

    void release() {
        unsafe {
            __ivy_free(this.out_);
            __ivy_free(this.macros_);
            __ivy_free(this.stack_);
            __ivy_free(this.param_off_);
            __ivy_free(this.param_len_);
            __ivy_free(this.conds_);
            __ivy_free(this.ex_);
            __ivy_free(this.src_);
            __ivy_free(this.in_);
            __ivy_free(this.file_);
            __ivy_free(this.dtxt_);
            __ivy_free(this.dline_);
            __ivy_free(this.dcol_);
            __ivy_free(this.dtoff_);
            __ivy_free(this.dtlen_);
            __ivy_free(this.dwarn_);
        }
    }

    // Append the decimal digits of `v` (non-negative) to the arena,
    // NUL-terminated, returning the offset. Used for `__LINE__`.
    long syn_put_int(long v) {
        long start = this.src_n_;
        if (start + 24 > this.arena_cap_) {
            return 0;
        }
        long d = 0;
        long x = v;
        if (v == 0) {
            unsafe {
                this.src_[start] = '0';
            }
            d = 1;
        } else {
            long y = v;
            while (y > 0) {
                d = d + 1;
                y = y / 10;
            }
            long i = d;
            while (i > 0) {
                i = i - 1;
                unsafe {
                    this.src_[start + i] = (char)(48 + (x % 10));
                }
                x = x / 10;
            }
        }
        unsafe {
            this.src_[start + d] = 0;
        }
        this.src_n_ = start + d;
        return start;
    }

    // Append `n` bytes to the arena (NUL-terminated), returning the offset.
    long syn_puts(char* s, long n) {
        if (this.src_n_ + n + 1 > this.arena_cap_) {
            return 0;
        }
        unsafe {
            __ivy_memcpy(this.src_ + this.src_n_, s, (unsigned long long)n);
            this.src_[this.src_n_ + n] = 0;
        }
        long off = this.src_n_;
        this.src_n_ = this.src_n_ + n;
        return off;
    }

    // --- low-level helpers ------------------------------------------------

    // Safe accessors over the input buffer (pointer indexing lives in unsafe).
    Token at(long i) {
        unsafe {
            return this.in_[i];
        }
        Token t;
        return t;
    }

    int tok_line(long i) {
        unsafe {
            return this.in_[i].line;
        }
        return 0;
    }

    int tok_col(long i) {
        unsafe {
            return this.in_[i].col;
        }
        return 0;
    }

    bool tok_eof(long i) {
        unsafe {
            return this.kind_eq(this.in_[i], "eof");
        }
        return false;
    }

    bool kind_eq(Token t, const char* s) {
        return this.kind_str_eq(t.kind, s);
    }

    bool kind_str_eq(char* k, const char* s) {
        unsafe {
            long i = 0;
            while (s[i] != 0) {
                if (k[i] != s[i]) {
                    return false;
                }
                i = i + 1;
            }
            return k[i] == 0;
        }
        return false;
    }

    // `toks[i].kind == s` with a raw token pointer (used for slices).
    bool kat(Token* toks, long i, const char* s) {
        unsafe {
            return this.kind_eq(toks[i], s);
        }
        return false;
    }

    // Compare token lexeme [off,len) against a NUL-terminated literal.
    bool lexeme_eq(long off, long len, const char* lit) {
        unsafe {
            long i = 0;
            while (lit[i] != 0) {
                if (i >= len) {
                    return false;
                }
                if (this.src_[off + i] != lit[i]) {
                    return false;
                }
                i = i + 1;
            }
            return i == len;
        }
        return false;
    }

    // Compare two lexeme ranges in src_.
    bool name_eq(long o1, long l1, long o2, long l2) {
        if (l1 != l2) {
            return false;
        }
        unsafe {
            long i = 0;
            while (i < l1) {
                if (this.src_[o1 + i] != this.src_[o2 + i]) {
                    return false;
                }
                i = i + 1;
            }
        }
        return true;
    }

    void out_push(Token t) {
        if (this.out_n_ >= this.out_cap_) {
            return;
        }
        unsafe {
            this.out_[this.out_n_].kind = t.kind;
            this.out_[this.out_n_].line = t.line;
            this.out_[this.out_n_].col = t.col;
            this.out_[this.out_n_].off = t.off;
            this.out_[this.out_n_].len = t.len;
        }
        this.out_n_ = this.out_n_ + 1;
    }

    void out_push_raw(const char* kind, int line, int col, long off, long n) {
        if (this.out_n_ >= this.out_cap_) {
            return;
        }
        unsafe {
            this.out_[this.out_n_].kind = (char*)kind;
            this.out_[this.out_n_].line = line;
            this.out_[this.out_n_].col = col;
            this.out_[this.out_n_].off = off;
            this.out_[this.out_n_].len = n;
        }
        this.out_n_ = this.out_n_ + 1;
    }

    // --- macro table ------------------------------------------------------

    long find_macro(long off, long len) {
        long i = 0;
        while (i < this.macro_n_) {
            unsafe {
                if (this.name_eq(this.macros_[i].name_off, this.macros_[i].name_len,
                                 off, len)) {
                    return i;
                }
            }
            i = i + 1;
        }
        return -1;
    }

    long register_macro(long off, long len, long body_start, long body_count,
                        long param_start, long param_cnt, bool is_fn, bool is_va) {
        long i = this.find_macro(off, len);
        if (i < 0) {
            if (this.macro_n_ >= this.macro_cap_) {
                return -1;
            }
            i = this.macro_n_;
            this.macro_n_ = this.macro_n_ + 1;
        }
        unsafe {
            this.macros_[i].name_off = off;
            this.macros_[i].name_len = len;
            this.macros_[i].body_start = body_start;
            this.macros_[i].body_count = body_count;
            this.macros_[i].param_start = param_start;
            this.macros_[i].param_cnt = param_cnt;
            this.macros_[i].is_fn = is_fn ? 1 : 0;
            this.macros_[i].is_va = is_va ? 1 : 0;
        }
        return i;
    }

    // Length of a NUL-terminated C string (string literal or arena slice).
    long cstr_len(const char* s) {
        unsafe {
            long n = 0;
            while (s[n] != 0) {
                n = n + 1;
            }
            return n;
        }
        return 0;
    }

    // Append a synthetic token to the extended input buffer, returning its
    // index. Used to give predefined macros a body not present in the source.
    long append_token(const char* kind, int line, int col, long off, long len) {
        if (this.xt_n_ >= this.in_cap_) {
            return this.in_n_;
        }
        long idx = this.xt_n_;
        unsafe {
            this.in_[idx].kind = (char*)kind;
            this.in_[idx].line = line;
            this.in_[idx].col = col;
            this.in_[idx].off = off;
            this.in_[idx].len = len;
        }
        this.xt_n_ = this.xt_n_ + 1;
        return idx;
    }

    // Register an object-like predefined macro whose body is a single token
    // of kind `kind` and lexeme `lex`, positioned at 0:0 (as the C++ oracle
    // does for __cplusplus / __ivy__ / __DATE__ / __TIME__).
    void register_predefined(const char* name, const char* kind, const char* lex) {
        long nl = this.cstr_len(name);
        long ll = this.cstr_len(lex);
        long noff = 0;
        long loff = 0;
        unsafe {
            noff = this.syn_puts((char*)name, nl);
            loff = this.syn_puts((char*)lex, ll);
        }
        long bidx = this.append_token(kind, 0, 0, loff, ll);
        this.register_macro(noff, nl, bidx, 1, 0, 0, false, false);
    }

    // The six predefined macro names (C++ `isPredefined`).
    bool is_predefined(long off, long len) {
        return this.lexeme_eq(off, len, "__LINE__") ||
               this.lexeme_eq(off, len, "__FILE__") ||
               this.lexeme_eq(off, len, "__DATE__") ||
               this.lexeme_eq(off, len, "__TIME__") ||
               this.lexeme_eq(off, len, "__cplusplus") ||
               this.lexeme_eq(off, len, "__ivy__");
    }

    long int_digits(long v) {
        if (v == 0) {
            return 1;
        }
        long d = 0;
        while (v > 0) {
            d = d + 1;
            v = v / 10;
        }
        return d;
    }

    // Expand the context-sensitive predefined macros `__LINE__`/`__FILE__`
    // (the others are ordinary object-like macros in the table). Returns true
    // when `t` was expanded into out_.
    bool try_expand_predefined(Token t) {
        if (!this.kind_eq(t, "identifier")) {
            return false;
        }
        if (this.lexeme_eq(t.off, t.len, "__LINE__")) {
            long off = this.syn_put_int(t.line);
            this.out_push_raw("integer", t.line, t.col, off, this.int_digits(t.line));
            return true;
        }
        if (this.lexeme_eq(t.off, t.len, "__FILE__")) {
            long qoff = 0;
            unsafe {
                qoff = this.syn_puts((char*)"\"", 1);
                this.syn_puts(this.file_, this.file_len_);
                this.syn_puts((char*)"\"", 1);
            }
            this.out_push_raw("string", t.line, t.col, qoff, this.file_len_ + 2);
            return true;
        }
        return false;
    }

    // --- diagnostics ------------------------------------------------------

    // Record a diagnostic whose message is `prefix` + the arena slice
    // [aoff, aoff+alen). A negative `aoff` means no suffix.
    void diag_add(long line, long col, const char* prefix, long aoff, long alen,
                  bool warn) {
        if (this.dn_ >= this.dcap_) {
            return;
        }
        long off = this.dtxt_n_;
        long n = this.cstr_len(prefix);
        if (aoff < 0) {
            alen = 0;
        }
        if (off + n + alen + 1 > this.dtxt_cap_) {
            return;
        }
        unsafe {
            long i = 0;
            while (i < n) {
                this.dtxt_[off + i] = prefix[i];
                i = i + 1;
            }
            long j = 0;
            while (j < alen) {
                this.dtxt_[off + n + j] = this.src_[aoff + j];
                j = j + 1;
            }
            this.dtxt_[off + n + alen] = 0;
        }
        this.dtxt_n_ = off + n + alen + 1;
        long idx = this.dn_;
        unsafe {
            this.dline_[idx] = line;
            this.dcol_[idx] = col;
            this.dtoff_[idx] = off;
            this.dtlen_[idx] = n + alen;
            this.dwarn_[idx] = warn ? 1 : 0;
        }
        this.dn_ = this.dn_ + 1;
    }

    long diag_count() {
        return this.dn_;
    }

    int diag_line(long i) {
        unsafe {
            return (int)this.dline_[i];
        }
        return 0;
    }

    int diag_col(long i) {
        unsafe {
            return (int)this.dcol_[i];
        }
        return 0;
    }

    long diag_warn(long i) {
        unsafe {
            return this.dwarn_[i];
        }
        return 0;
    }

    char* diag_msg(long i) {
        unsafe {
            return this.dtxt_ + this.dtoff_[i];
        }
        unsafe {
            return (char*)0;
        }
    }

    void register_param(long off, long len) {
        if (this.param_n_ >= this.param_cap_) {
            return;
        }
        unsafe {
            this.param_off_[this.param_n_] = off;
            this.param_len_[this.param_n_] = len;
        }
        this.param_n_ = this.param_n_ + 1;
    }

    // Local index of the body token `bt` among macro `mi`'s named params,
    // or -1 when it is not a parameter name.
    long find_param_slot(long mi, Token bt) {
        long pstart = 0;
        long pcnt = 0;
        unsafe {
            pstart = this.macros_[mi].param_start;
            pcnt = this.macros_[mi].param_cnt;
        }
        long i = 0;
        while (i < pcnt) {
            long po = 0;
            long pl = 0;
            unsafe {
                po = this.param_off_[pstart + i];
                pl = this.param_len_[pstart + i];
            }
            if (this.name_eq(po, pl, bt.off, bt.len)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // --- expansion cycle guard (stack of names) --------------------------

    bool in_stack(long off, long len) {
        long i = 0;
        while (i < this.stack_n_) {
            unsafe {
                if (this.name_eq(this.stack_[2 * i], this.stack_[2 * i + 1],
                                 off, len)) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    void push_stack(long off, long len) {
        if (this.stack_n_ >= this.stack_cap_) {
            return;
        }
        unsafe {
            this.stack_[2 * this.stack_n_] = off;
            this.stack_[2 * this.stack_n_ + 1] = len;
        }
        this.stack_n_ = this.stack_n_ + 1;
    }

    void pop_stack() {
        if (this.stack_n_ > 0) {
            this.stack_n_ = this.stack_n_ - 1;
        }
    }

    // --- expansion core ---------------------------------------------------

    // Recursively expand tokens [start,end) of `toks`, appending to out_.
    // Mirrors Preprocessor::expandTokenVector.
    void expand_range(Token* toks, long n, long start, long end) {
        long i = start;
        while (i < end) {
            Token t;
            unsafe {
                t = toks[i];
            }
            if (this.kind_eq(t, "eof")) {
                return;
            }
            if (this.kind_eq(t, "identifier")) {
                if (this.try_expand_predefined(t)) {
                    i = i + 1;
                    continue;
                }
                long mi = this.find_macro(t.off, t.len);
                if (mi >= 0) {
                    long is_fn = 0;
                    unsafe {
                        is_fn = this.macros_[mi].is_fn;
                    }
                    if (is_fn != 0) {
                        this.expand_function_like(toks, n, i, t, mi);
                        i = this.next_;
                        continue;
                    }
                    this.expand_object(t, mi);
                    i = i + 1;
                    continue;
                }
            }
            this.out_push(t);
            i = i + 1;
        }
    }

    // Mirrors expandObjectLike + the empty-paramMap substituteBody.
    void expand_object(Token nameTok, long mi) {
      unsafe {
        if (this.in_stack(nameTok.off, nameTok.len)) {
            this.out_push(nameTok);
            return;
        }
        if (this.stack_n_ >= 100) {
            this.has_error_ = true;
            this.out_push(nameTok);
            return;
        }
        this.push_stack(nameTok.off, nameTok.len);
        long bs = 0;
        long bc = 0;
        unsafe {
            bs = this.macros_[mi].body_start;
            bc = this.macros_[mi].body_count;
        }
        long sub_n = this.substitute_body(this.in_, this.in_n_, bs, bc, mi,
                                          (Token*)0, (long*)0, (long*)0,
                                          (Token*)0, (long*)0, (long*)0,
                                          0, nameTok);
        Token* sub = this.sub_p_;
        this.expand_range(sub, sub_n, 0, sub_n);
        __ivy_free(sub);
        this.pop_stack();
      }
    }

    // Mirrors Preprocessor::expandFunctionLike: parse the actual argument
    // list, pre-expand each argument, substitute into the body, rescan.
    void expand_function_like(Token* toks, long n, long pos, Token nameTok, long mi) {
      unsafe {
        long p0 = pos + 1;
        if (p0 >= n || !this.kat(toks, p0, "(")) {
            // Not invoked (no `(`) ? emit the name verbatim.
            this.out_push(nameTok);
            this.next_ = pos + 1;
            return;
        }

        long pcnt = 0;
        long is_va = 0;
        unsafe {
            pcnt = this.macros_[mi].param_cnt;
            is_va = this.macros_[mi].is_va;
        }

        // --- parse actual arguments: balanced parens, comma-separated. -----
        long maxargs = n + 2;
        long* as = (long*) __ivy_alloc(maxargs * 8);
        long* ae = (long*) __ivy_alloc(maxargs * 8);
        long* so = (long*) __ivy_alloc(maxargs * 8);  // separator comma offsets
        long* sl = (long*) __ivy_alloc(maxargs * 8);

        long p = p0 + 1;  // past `(`
        long cur_start = p;
        long depth = 1;
        long nargs = 0;
        while (p < n && depth > 0) {
            if (this.kat(toks, p, "(")) {
                depth = depth + 1;
                p = p + 1;
                continue;
            }
            if (this.kat(toks, p, ")")) {
                depth = depth - 1;
                if (depth == 0) {
                    if (p > cur_start || nargs > 0) {
                        unsafe {
                            as[nargs] = cur_start;
                            ae[nargs] = p;
                        }
                        nargs = nargs + 1;
                    }
                    p = p + 1;
                    break;
                }
                p = p + 1;
                continue;
            }
            if (this.kat(toks, p, ",") && depth == 1) {
                Token cm;
                unsafe {
                    cm = toks[p];
                }
                unsafe {
                    as[nargs] = cur_start;
                    ae[nargs] = p;
                    so[nargs] = cm.off;
                    sl[nargs] = cm.len;
                }
                nargs = nargs + 1;
                p = p + 1;
                cur_start = p;
                continue;
            }
            p = p + 1;
        }
        if (depth != 0) {
            // Unterminated argument list.
            this.has_error_ = true;
            this.next_ = p;
            unsafe {
                __ivy_free(as); __ivy_free(ae); __ivy_free(so); __ivy_free(sl);
            }
            return;
        }

        // --- arity check ---------------------------------------------------
        if (is_va != 0) {
            if (nargs < pcnt) {
                this.has_error_ = true;
                this.next_ = p;
                unsafe {
                    __ivy_free(as); __ivy_free(ae); __ivy_free(so); __ivy_free(sl);
                }
                return;
            }
        } else if (nargs != pcnt) {
            this.has_error_ = true;
            this.next_ = p;
            unsafe {
                __ivy_free(as); __ivy_free(ae); __ivy_free(so); __ivy_free(sl);
            }
            return;
        }

        // --- materialize raw + pre-expanded argument token buffers. --------
        // Mirrors the `paramMap` (raw + expanded) built by C++
        // expandFunctionLike, including the synthetic `,` join tokens for
        // `__VA_ARGS__`. `raw` is used by `#` (stringify) and `##` (paste);
        // `exp` is used by normal parameter substitution.
        long slots = pcnt + (is_va != 0 ? 1 : 0);
        long body_start = 0;
        long body_count = 0;
        unsafe {
            body_start = this.macros_[mi].body_start;
            body_count = this.macros_[mi].body_count;
        }

        long acap = (n + body_count) * 16 + 1024;
        Token* raw = (Token*) __ivy_alloc(acap * 32);
        Token* exp = (Token*) __ivy_alloc(acap * 32);
        long* rawo = (long*) __ivy_alloc((slots + 1) * 8);
        long* rawc = (long*) __ivy_alloc((slots + 1) * 8);
        long* expo = (long*) __ivy_alloc((slots + 1) * 8);
        long* expc = (long*) __ivy_alloc((slots + 1) * 8);
        long raw_n = 0;

        long si = 0;
        while (si < pcnt) {
            unsafe {
                rawo[si] = raw_n;
            }
            long ai = as[si];
            while (ai < ae[si] && raw_n < acap) {
                unsafe {
                    raw[raw_n] = toks[ai];
                }
                raw_n = raw_n + 1;
                ai = ai + 1;
            }
            unsafe {
                rawc[si] = raw_n - rawo[si];
            }
            si = si + 1;
        }
        if (is_va != 0) {
            long vs = pcnt;
            unsafe {
                rawo[vs] = raw_n;
            }
            long ei = pcnt;
            while (ei < nargs) {
                if (ei > pcnt) {
                    if (raw_n < acap) {
                        unsafe {
                            raw[raw_n].kind = (char*)"comma";
                            raw[raw_n].line = nameTok.line;
                            raw[raw_n].col = nameTok.col;
                            raw[raw_n].off = so[ei - 1];
                            raw[raw_n].len = sl[ei - 1];
                        }
                        raw_n = raw_n + 1;
                    }
                }
                long ai = as[ei];
                while (ai < ae[ei] && raw_n < acap) {
                    unsafe {
                        raw[raw_n] = toks[ai];
                    }
                    raw_n = raw_n + 1;
                    ai = ai + 1;
                }
                ei = ei + 1;
            }
            unsafe {
                rawc[vs] = raw_n - rawo[vs];
            }
        }

        // Pre-expand the arguments into `exp` (mirrors the per-argument
        // expandTokenVector pass), redirecting out_ into the scratch buffer.
        Token* sav_buf = this.out_;
        long sav_cap = this.out_cap_;
        long sav_n = this.out_n_;
        this.out_ = exp;
        this.out_cap_ = acap;
        this.out_n_ = 0;
        si = 0;
        while (si < pcnt) {
            unsafe {
                expo[si] = this.out_n_;
            }
            this.expand_range(toks, n, as[si], ae[si]);
            unsafe {
                expc[si] = this.out_n_ - expo[si];
            }
            si = si + 1;
        }
        if (is_va != 0) {
            long vs = pcnt;
            unsafe {
                expo[vs] = this.out_n_;
            }
            long ei = pcnt;
            while (ei < nargs) {
                if (ei > pcnt) {
                    long co = 0;
                    long cl = 0;
                    unsafe {
                        co = so[ei - 1];
                        cl = sl[ei - 1];
                    }
                    this.out_push_raw(",", nameTok.line, nameTok.col, co, cl);
                }
                this.expand_range(toks, n, as[ei], ae[ei]);
                ei = ei + 1;
            }
            unsafe {
                expc[vs] = this.out_n_ - expo[vs];
            }
        }
        this.out_ = sav_buf;
        this.out_cap_ = sav_cap;
        this.out_n_ = sav_n;

        // --- cycle + depth guard (after arg pre-expansion, per C++ order). --
        if (this.in_stack(nameTok.off, nameTok.len)) {
            this.out_push(nameTok);
            this.next_ = p;
            unsafe {
                __ivy_free(as); __ivy_free(ae); __ivy_free(so); __ivy_free(sl);
                __ivy_free(raw); __ivy_free(exp); __ivy_free(rawo); __ivy_free(rawc);
                __ivy_free(expo); __ivy_free(expc);
            }
            return;
        }
        if (this.stack_n_ >= 100) {
            this.has_error_ = true;
            this.out_push(nameTok);
            this.next_ = p;
            unsafe {
                __ivy_free(as); __ivy_free(ae); __ivy_free(so); __ivy_free(sl);
                __ivy_free(raw); __ivy_free(exp); __ivy_free(rawo); __ivy_free(rawc);
                __ivy_free(expo); __ivy_free(expc);
            }
            return;
        }
        this.push_stack(nameTok.off, nameTok.len);

        // --- substitute the body (#, ##, params), then rescan. -------------
        long sub_n = this.substitute_body(this.in_, this.in_n_, body_start,
                                          body_count, mi, raw, rawo, rawc,
                                          exp, expo, expc, slots, nameTok);
        Token* sub = this.sub_p_;
        this.expand_range(sub, sub_n, 0, sub_n);
        this.pop_stack();
        __ivy_free(sub);

        __ivy_free(as); __ivy_free(ae); __ivy_free(so); __ivy_free(sl);
        __ivy_free(raw); __ivy_free(exp); __ivy_free(rawo); __ivy_free(rawc);
        __ivy_free(expo); __ivy_free(expc);
        this.next_ = p;
      }
    }

    // --- # stringify and ## paste (8.7) ----------------------------------

    bool is_va_of(long mi) {
        unsafe {
            return this.macros_[mi].is_va != 0;
        }
        return false;
    }

    // Slot index of body token `bt` (named param or `__VA_ARGS__`), or -1.
    long param_slot(long mi, long slots, Token bt) {
        long slot = this.find_param_slot(mi, bt);
        if (slot < 0 && slots > 0 && this.is_va_of(mi) &&
            this.lexeme_eq(bt.off, bt.len, "__VA_ARGS__")) {
            slot = slots - 1;
        }
        return slot;
    }

    // Mirrors Preprocessor::stringifyTokens: join raw token lexemes with
    // single spaces, escape `\` and `"`, wrap in double quotes. The result is
    // a `string` token at (line,col) with its lexeme stored in the arena.
    Token stringify(Token* toks, long off, long cnt, int line, int col) {
      unsafe {
        long total = 0;
        long k = 0;
        while (k < cnt) {
            Token t;
            unsafe {
                t = toks[off + k];
            }
            total = total + t.len;
            if (k > 0) {
                total = total + 1;
            }
            k = k + 1;
        }
        char* buf = (char*) __ivy_alloc(total * 2 + 4);
        long n = 0;
        unsafe {
            buf[n] = 34;  // opening quote
        }
        n = n + 1;
        k = 0;
        while (k < cnt) {
            Token t;
            unsafe {
                t = toks[off + k];
            }
            if (k > 0) {
                unsafe {
                    buf[n] = 32;  // space
                }
                n = n + 1;
            }
            long j = 0;
            while (j < t.len) {
                char c = 0;
                unsafe {
                    c = this.src_[t.off + j];
                }
                if (c == 92 || c == 34) {
                    unsafe {
                        buf[n] = 92;  // backslash
                    }
                    n = n + 1;
                }
                unsafe {
                    buf[n] = c;
                }
                n = n + 1;
                j = j + 1;
            }
            k = k + 1;
        }
        unsafe {
            buf[n] = 34;  // closing quote
        }
        n = n + 1;
        unsafe {
            buf[n] = 0;
        }
        long soff = this.syn_puts(buf, n);
        __ivy_free(buf);
        Token st;
        unsafe {
            st.kind = (char*)"string";
        }
        st.line = line;
        st.col = col;
        st.off = soff;
        st.len = n;
        return st;
      }
    }

    // Mirrors Preprocessor::pasteTokens: paste lexemes, re-lex to determine
    // the resulting kind. On an invalid paste, emit an Identifier.
    Token paste(Token left, Token right) {
      unsafe {
        long llen = left.len;
        long rlen = right.len;
        char* buf = (char*) __ivy_alloc(llen + rlen + 1);
        unsafe {
            __ivy_memcpy(buf, this.src_ + left.off, (unsigned long long)llen);
            __ivy_memcpy(buf + llen, this.src_ + right.off, (unsigned long long)rlen);
            buf[llen + rlen] = 0;
        }
        Token result;
        unsafe {
            result.kind = (char*)"identifier";
        }
        result.line = left.line;
        result.col = left.col;
        result.len = llen + rlen;

        Lexer lx;
        lx.setup(buf, (uint64)(llen + rlen), (char*)"");
        lx.lex_all(64);
        long ln = lx.token_count();
        if (ln == 0 || this.kind_str_eq(lx.tokens()[0].kind, "eof")) {
            // Invalid paste -> Identifier.
            this.has_error_ = true;
        } else if (ln > 1 && !this.kind_str_eq(lx.tokens()[1].kind, "eof")) {
            // Multiple tokens -> still use the first (lenient).
            this.has_error_ = true;
            unsafe {
                result.kind = lx.tokens()[0].kind;
            }
        } else {
            unsafe {
                result.kind = lx.tokens()[0].kind;
            }
        }
        lx.release();
        result.off = this.syn_puts(buf, llen + rlen);
        __ivy_free(buf);
        return result;
      }
    }

    // Mirrors Preprocessor::substituteBody: one pass over the macro body
    // performing `#` stringify, `##` paste, and parameter substitution.
    // Returns the number of tokens; the buffer is left in `this.sub_p_`.
    long substitute_body(Token* toks, long bn, long bs, long bc, long mi,
                         Token* raw, long* rawo, long* rawc,
                         Token* exp, long* expo, long* expc,
                         long slots, Token nameTok) {
      unsafe {
        long cap = bc * 8 + 4096;
        Token* res = (Token*) __ivy_alloc(cap * 32);
        long rn = 0;
        long i = 0;
        while (i < bc) {
            Token bt;
            unsafe {
                bt = toks[bs + i];
            }

            // `#` stringify (only with params/variadic).
            if (this.kind_eq(bt, "#") && slots > 0) {
                bool did = false;
                if (i + 1 < bc) {
                    Token nx;
                    unsafe {
                        nx = toks[bs + i + 1];
                    }
                    if (this.kind_eq(nx, "identifier")) {
                        long slot = this.param_slot(mi, slots, nx);
                        if (slot >= 0) {
                            long ro = 0;
                            long rc = 0;
                            unsafe {
                                ro = rawo[slot];
                                rc = rawc[slot];
                            }
                            Token st = this.stringify(raw, ro, rc, bt.line, bt.col);
                            if (rn < cap) {
                                unsafe {
                                    res[rn] = st;
                                }
                                rn = rn + 1;
                            }
                            i = i + 2;
                            did = true;
                        }
                    }
                }
                if (did) {
                    continue;
                }
                if (rn < cap) {
                    unsafe {
                        res[rn] = bt;
                    }
                    rn = rn + 1;
                }
                i = i + 1;
                continue;
            }

            // `##` token paste.
            if (this.kind_eq(bt, "##")) {
                long adv = 1;  // consume the `##` itself
                if (rn == 0) {
                    this.has_error_ = true;
                    i = i + 1;
                    continue;
                }
                rn = rn - 1;
                Token leftTok;
                unsafe {
                    leftTok = res[rn];
                }
                bool hasRight = false;
                bool placemark = false;
                Token rightTok;
                if (i + 1 < bc) {
                    Token nx;
                    unsafe {
                        nx = toks[bs + i + 1];
                    }
                    if (this.kind_eq(nx, "identifier") && slots > 0) {
                        long slot = this.param_slot(mi, slots, nx);
                        if (slot >= 0) {
                            long rc = 0;
                            unsafe {
                                rc = rawc[slot];
                            }
                            if (rc > 0) {
                                long ro = 0;
                                unsafe {
                                    ro = rawo[slot];
                                }
                                unsafe {
                                    rightTok = raw[ro + rc - 1];
                                }
                                hasRight = true;
                            } else {
                                placemark = true;
                            }
                            adv = 2;  // consume the parameter too
                        }
                    }
                    if (!hasRight && !placemark) {
                        rightTok = nx;
                        hasRight = true;
                        adv = 2;  // consume the right operand too
                    }
                }
                if (placemark) {
                    if (rn < cap) {
                        unsafe {
                            res[rn] = leftTok;
                        }
                        rn = rn + 1;
                    }
                    i = i + adv;
                    continue;
                }
                Token outTok;
                if (hasRight) {
                    outTok = this.paste(leftTok, rightTok);
                } else {
                    outTok = leftTok;
                }
                if (rn < cap) {
                    unsafe {
                        res[rn] = outTok;
                    }
                    rn = rn + 1;
                }
                i = i + adv;
                continue;
            }

            // Normal parameter substitution (expanded argument tokens).
            if (this.kind_eq(bt, "identifier") && slots > 0) {
                long slot = this.param_slot(mi, slots, bt);
                if (slot >= 0) {
                    long eo = 0;
                    long ec = 0;
                    unsafe {
                        eo = expo[slot];
                        ec = expc[slot];
                    }
                    long t = 0;
                    while (t < ec && rn < cap) {
                        unsafe {
                            res[rn] = exp[eo + t];
                        }
                        rn = rn + 1;
                        t = t + 1;
                    }
                    i = i + 1;
                    continue;
                }
            }

            if (rn < cap) {
                unsafe {
                    res[rn] = bt;
                }
                rn = rn + 1;
            }
            i = i + 1;
        }
        this.sub_p_ = res;
        return rn;
      }
    }

    // --- conditionals (#if / #ifdef / ...) -------------------------------

    // True when every frame on the conditional stack is `taken`. Mirrors
    // Preprocessor::active.
    bool active() {
        long i = 0;
        while (i < this.cond_n_) {
            long tk = 0;
            unsafe {
                tk = this.conds_[i].taken;
            }
            if (tk == 0) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    void push_cond(long taken, long seen_else, long parent_active, long any_taken) {
        if (this.cond_n_ >= this.cond_cap_) {
            return;
        }
        unsafe {
            this.conds_[this.cond_n_].taken = taken;
            this.conds_[this.cond_n_].seen_else = seen_else;
            this.conds_[this.cond_n_].parent_active = parent_active;
            this.conds_[this.cond_n_].any_taken = any_taken;
        }
        this.cond_n_ = this.cond_n_ + 1;
    }

    // True when the token at `pos + 1` is an Identifier or Keyword whose
    // lexeme equals the NUL-terminated `s` (directive-name test).
    bool dir_is(long pos, const char* s) {
        if (pos + 1 >= this.in_n_) {
            return false;
        }
        unsafe {
            Token d = this.in_[pos + 1];
            if (!this.kind_eq(d, "identifier") && !this.kind_eq(d, "keyword")) {
                return false;
            }
            return this.lexeme_eq(d.off, d.len, s);
        }
        return false;
    }

    // Index of the first token past the line containing `pos` (skipLine).
    long line_end(long pos) {
        long ln = this.tok_line(pos);
        long p = pos;
        while (p < this.in_n_ && !this.tok_eof(p) && this.tok_line(p) == ln) {
            p = p + 1;
        }
        return p;
    }

    // Remove macro slot `mi` (swap-with-last).
    void erase_macro(long mi) {
        if (mi < 0 || mi >= this.macro_n_) {
            return;
        }
        long last = this.macro_n_ - 1;
        if (mi != last) {
            unsafe {
                this.macros_[mi].name_off = this.macros_[last].name_off;
                this.macros_[mi].name_len = this.macros_[last].name_len;
                this.macros_[mi].body_start = this.macros_[last].body_start;
                this.macros_[mi].body_count = this.macros_[last].body_count;
                this.macros_[mi].param_start = this.macros_[last].param_start;
                this.macros_[mi].param_cnt = this.macros_[last].param_cnt;
                this.macros_[mi].is_fn = this.macros_[last].is_fn;
                this.macros_[mi].is_va = this.macros_[last].is_va;
            }
        }
        this.macro_n_ = this.macro_n_ - 1;
    }

    // Mirrors Preprocessor::parseConditional. `pos` points at `#`. Returns
    // true and sets `next_` when it consumed a conditional directive.
    bool parse_conditional(long pos) {
        bool is_ifdef = this.dir_is(pos, "ifdef");
        bool is_ifndef = this.dir_is(pos, "ifndef");
        bool is_if = this.dir_is(pos, "if");
        bool is_elif = this.dir_is(pos, "elif");
        bool is_else = this.dir_is(pos, "else");
        bool is_endif = this.dir_is(pos, "endif");
        bool is_undef = this.dir_is(pos, "undef");
        if (!is_ifdef && !is_ifndef && !is_if && !is_elif && !is_else &&
            !is_endif && !is_undef) {
            return false;
        }
        long hline = this.tok_line(pos);

        if (is_undef) {
            long p = pos + 2;
            if (this.active() && p < this.in_n_ && !this.tok_eof(p) &&
                this.kat(this.in_, p, "identifier")) {
                Token nt;
                unsafe {
                    nt = this.in_[p];
                }
                if (this.is_predefined(nt.off, nt.len)) {
                    this.diag_add(nt.line, nt.col,
                                  "cannot #undef predefined macro: ",
                                  nt.off, nt.len, false);
                } else {
                    this.erase_macro(this.find_macro(nt.off, nt.len));
                }
            }
            this.next_ = this.line_end(pos);
            return true;
        }

        if (is_if || is_elif) {
            long p = pos + 2;
            long es = p;
            while (p < this.in_n_ && !this.tok_eof(p) && this.tok_line(p) == hline) {
                p = p + 1;
            }
            long ee = p;
            bool parent_active = this.active();
            if (is_if) {
                bool cond = false;
                if (parent_active) {
                    long v = this.eval_expr(es, ee, hline, this.tok_col(pos));
                    cond = v != 0;
                }
                this.push_cond(parent_active && cond, false, parent_active,
                               parent_active && cond);
            } else {
                if (this.cond_n_ == 0) {
                    this.has_error_ = true;
                } else {
                    long idx = this.cond_n_ - 1;
                    long seen_else = 0;
                    long pa = 0;
                    long anyt = 0;
                    unsafe {
                        seen_else = this.conds_[idx].seen_else;
                        pa = this.conds_[idx].parent_active;
                        anyt = this.conds_[idx].any_taken;
                    }
                    if (seen_else != 0) {
                        this.has_error_ = true;
                    } else if (pa == 0) {
                        unsafe {
                            this.conds_[idx].taken = 0;
                        }
                    } else if (anyt != 0) {
                        unsafe {
                            this.conds_[idx].taken = 0;
                        }
                    } else {
                        long v = this.eval_expr(es, ee, hline, this.tok_col(pos));
                        long tk = v != 0 ? 1 : 0;
                        unsafe {
                            this.conds_[idx].taken = tk;
                            if (tk != 0) {
                                this.conds_[idx].any_taken = 1;
                            }
                        }
                    }
                }
            }
            this.next_ = p;
            return true;
        }

        if (is_ifdef || is_ifndef) {
            long p = pos + 2;
            bool cond = false;
            bool parent_active = this.active();
            if (p < this.in_n_ && !this.tok_eof(p) && this.kat(this.in_, p, "identifier")) {
                Token nt;
                unsafe {
                    nt = this.in_[p];
                }
                bool def = this.find_macro(nt.off, nt.len) >= 0 ||
                           this.is_predefined(nt.off, nt.len);
                cond = is_ifdef ? def : !def;
            } else {
                this.has_error_ = true;
            }
            this.next_ = this.line_end(pos);
            bool taken = parent_active && cond;
            this.push_cond(taken, false, parent_active, taken);
            return true;
        }

        if (is_else) {
            this.next_ = this.line_end(pos);
            if (this.cond_n_ == 0) {
                this.has_error_ = true;
                return true;
            }
            long idx = this.cond_n_ - 1;
            long seen_else = 0;
            long pa = 0;
            long anyt = 0;
            unsafe {
                seen_else = this.conds_[idx].seen_else;
                pa = this.conds_[idx].parent_active;
                anyt = this.conds_[idx].any_taken;
            }
            if (seen_else != 0) {
                this.has_error_ = true;
            }
            unsafe {
                this.conds_[idx].seen_else = 1;
                if (pa != 0 && anyt == 0) {
                    this.conds_[idx].taken = 1;
                    this.conds_[idx].any_taken = 1;
                } else {
                    this.conds_[idx].taken = 0;
                }
            }
            return true;
        }

        // is_endif
        this.next_ = this.line_end(pos);
        if (this.cond_n_ == 0) {
            this.has_error_ = true;
            return true;
        }
        this.cond_n_ = this.cond_n_ - 1;
        return true;
    }

    // Mirrors Preprocessor::parsePragma. `pos` points at `#`. Processed even
    // when inactive (a pragma flag persists regardless of conditional state).
    // Unknown pragmas always warn; `#pragma ivy cnumber` only sets the flag
    // when active.
    bool parse_pragma(long pos) {
        if (!this.dir_is(pos, "pragma")) {
            return false;
        }
        long e = this.line_end(pos);
        long q = pos + 2;
        long nargs = e - q;
        bool recognized = false;
        if (nargs >= 2) {
            Token a0;
            Token a1;
            unsafe {
                a0 = this.in_[q];
                a1 = this.in_[q + 1];
            }
            if (this.lexeme_eq(a0.off, a0.len, "ivy") &&
                this.lexeme_eq(a1.off, a1.len, "cnumber")) {
                recognized = true;
                if (this.active()) {
                    this.cnumber_ = true;
                }
            }
        }
        if (!recognized) {
            long hl = this.tok_line(pos);
            long hc = this.tok_col(pos);
            long aoff = -1;
            long alen = 0;
            if (nargs >= 1) {
                unsafe {
                    aoff = this.in_[q].off;
                    alen = this.in_[q].len;
                }
            }
            this.diag_add(hl, hc, "unknown #pragma: ", aoff, alen, false);
        }
        this.next_ = e;
        return true;
    }

    // --- #if constant-expression evaluation ------------------------------

    long digit_val(long c) {
        if (c >= 48 && c <= 57) {
            return c - 48;
        }
        if (c >= 97 && c <= 102) {
            return c - 97 + 10;
        }
        if (c >= 65 && c <= 70) {
            return c - 65 + 10;
        }
        return 0;
    }

    // Mirrors parseIntLiteral: decimal / 0x / 0b / octal with an optional
    // suffix (suffix stripped, value stored as a 64-bit signed integer).
    long parse_int(long off, long len) {
        if (len <= 0) {
            return 0;
        }
        long base = 10;
        long i = 0;
        long c0 = 0;
        long c1 = 0;
        unsafe {
            c0 = this.src_[off];
            if (len >= 2) {
                c1 = this.src_[off + 1];
            }
        }
        if (len >= 2 && c0 == 48 && (c1 == 120 || c1 == 88)) {
            base = 16;
            i = 2;
        } else if (len >= 2 && c0 == 48 && (c1 == 98 || c1 == 66)) {
            base = 2;
            i = 2;
        } else if (len >= 2 && c0 == 48 && c1 != 46) {
            base = 8;
            i = 1;
        }
        long e = i;
        while (e < len) {
            long c = 0;
            unsafe {
                c = this.src_[off + e];
            }
            bool digit = false;
            if (base == 10 && c >= 48 && c <= 57) {
                digit = true;
            } else if (base == 16 && ((c >= 48 && c <= 57) ||
                                      (c >= 97 && c <= 102) ||
                                      (c >= 65 && c <= 70))) {
                digit = true;
            } else if (base == 8 && c >= 48 && c <= 55) {
                digit = true;
            } else if (base == 2 && (c == 48 || c == 49)) {
                digit = true;
            }
            if (!digit) {
                break;
            }
            e = e + 1;
        }
        if (e == i) {
            return 0;
        }
        long v = 0;
        long k = i;
        while (k < e) {
            long c = 0;
            unsafe {
                c = this.src_[off + k];
            }
            v = v * base + this.digit_val(c);
            k = k + 1;
        }
        return v;
    }

    // Map a token to a small integer kind code for the expression stream.
    long op_code(Token t) {
        if (this.kind_eq(t, "integer")) return 1;
        if (this.kind_eq(t, "(")) return 2;
        if (this.kind_eq(t, ")")) return 3;
        if (this.kind_eq(t, "?")) return 4;
        if (this.kind_eq(t, ":")) return 5;
        if (this.kind_eq(t, "||")) return 6;
        if (this.kind_eq(t, "&&")) return 7;
        if (this.kind_eq(t, "|")) return 8;
        if (this.kind_eq(t, "^")) return 9;
        if (this.kind_eq(t, "&")) return 10;
        if (this.kind_eq(t, "==")) return 11;
        if (this.kind_eq(t, "!=")) return 12;
        if (this.kind_eq(t, "<")) return 13;
        if (this.kind_eq(t, ">")) return 14;
        if (this.kind_eq(t, "<=")) return 15;
        if (this.kind_eq(t, ">=")) return 16;
        if (this.kind_eq(t, "<<")) return 17;
        if (this.kind_eq(t, ">>")) return 18;
        if (this.kind_eq(t, "+")) return 19;
        if (this.kind_eq(t, "-")) return 20;
        if (this.kind_eq(t, "*")) return 21;
        if (this.kind_eq(t, "/")) return 22;
        if (this.kind_eq(t, "%")) return 23;
        if (this.kind_eq(t, "!")) return 24;
        if (this.kind_eq(t, "~")) return 25;
        return 0;
    }

    long int_val(Token t) {
        if (!this.kind_eq(t, "integer")) {
            return 0;
        }
        return this.parse_int(t.off, t.len);
    }

    void ex_push(long k, long v, long off, long len) {
        if (this.ex_n_ >= this.ex_cap_) {
            return;
        }
        unsafe {
            this.ex_[this.ex_n_].kind = k;
            this.ex_[this.ex_n_].val = v;
            this.ex_[this.ex_n_].off = off;
            this.ex_[this.ex_n_].len = len;
        }
        this.ex_n_ = this.ex_n_ + 1;
    }

    long ex_peek() {
        if (this.ex_pos_ >= this.ex_n_) {
            return -1;
        }
        unsafe {
            return this.ex_[this.ex_pos_].kind;
        }
        return -1;
    }

    bool ex_check(long k) {
        return this.ex_peek() == k;
    }

    bool ex_consume(long k) {
        if (!this.ex_check(k)) {
            return false;
        }
        this.ex_pos_ = this.ex_pos_ + 1;
        return true;
    }

    long ex_expr() {
        return this.ex_ternary();
    }

    long ex_ternary() {
        long c = this.ex_lor();
        if (this.ex_consume(4)) {
            long tv = this.ex_ternary();
            if (!this.ex_consume(5)) {
                this.has_error_ = true;
                return 0;
            }
            long ev = this.ex_ternary();
            return c != 0 ? tv : ev;
        }
        return c;
    }

    long ex_lor() {
        long v = this.ex_land();
        while (this.ex_check(6)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_land();
            v = (v != 0 || r != 0) ? 1 : 0;
        }
        return v;
    }

    long ex_land() {
        long v = this.ex_bor();
        while (this.ex_check(7)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_bor();
            v = (v != 0 && r != 0) ? 1 : 0;
        }
        return v;
    }

    long ex_bor() {
        long v = this.ex_bxor();
        while (this.ex_check(8)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_bxor();
            v = v | r;
        }
        return v;
    }

    long ex_bxor() {
        long v = this.ex_band();
        while (this.ex_check(9)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_band();
            v = v ^ r;
        }
        return v;
    }

    long ex_band() {
        long v = this.ex_eq();
        while (this.ex_check(10)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_eq();
            v = v & r;
        }
        return v;
    }

    long ex_eq() {
        long v = this.ex_rel();
        while (this.ex_check(11) || this.ex_check(12)) {
            long op = this.ex_peek();
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_rel();
            if (op == 11) {
                v = v == r ? 1 : 0;
            } else {
                v = v != r ? 1 : 0;
            }
        }
        return v;
    }

    long ex_rel() {
        long v = this.ex_shift();
        while (this.ex_check(13) || this.ex_check(14) ||
               this.ex_check(15) || this.ex_check(16)) {
            long op = this.ex_peek();
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_shift();
            if (op == 13) {
                v = v < r ? 1 : 0;
            } else if (op == 15) {
                v = v <= r ? 1 : 0;
            } else if (op == 14) {
                v = v > r ? 1 : 0;
            } else {
                v = v >= r ? 1 : 0;
            }
        }
        return v;
    }

    long ex_shift() {
        long v = this.ex_add();
        while (this.ex_check(17) || this.ex_check(18)) {
            long op = this.ex_peek();
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_add();
            if (op == 17) {
                v = v << r;
            } else {
                v = v >> r;
            }
        }
        return v;
    }

    long ex_add() {
        long v = this.ex_mul();
        while (this.ex_check(19) || this.ex_check(20)) {
            long op = this.ex_peek();
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_mul();
            if (op == 19) {
                v = v + r;
            } else {
                v = v - r;
            }
        }
        return v;
    }

    long ex_mul() {
        long v = this.ex_unary();
        while (this.ex_check(21) || this.ex_check(22) || this.ex_check(23)) {
            long op = this.ex_peek();
            this.ex_pos_ = this.ex_pos_ + 1;
            long r = this.ex_unary();
            if (op == 21) {
                v = v * r;
            } else if (op == 22) {
                if (r == 0) {
                    this.has_error_ = true;
                    v = 0;
                } else {
                    v = v / r;
                }
            } else {
                if (r == 0) {
                    this.has_error_ = true;
                    v = 0;
                } else {
                    v = v % r;
                }
            }
        }
        return v;
    }

    long ex_unary() {
        if (this.ex_check(24)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            long v = this.ex_unary();
            return v == 0 ? 1 : 0;
        }
        if (this.ex_check(20)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            return -this.ex_unary();
        }
        if (this.ex_check(19)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            return this.ex_unary();
        }
        if (this.ex_check(25)) {
            this.ex_pos_ = this.ex_pos_ + 1;
            return ~this.ex_unary();
        }
        return this.ex_primary();
    }

    long ex_primary() {
        if (this.ex_consume(2)) {
            long v = this.ex_expr();
            if (!this.ex_consume(3)) {
                this.has_error_ = true;
                return 0;
            }
            return v;
        }
        if (this.ex_pos_ >= this.ex_n_) {
            this.has_error_ = true;
            return 0;
        }
        if (this.ex_peek() == 1) {
            long v = 0;
            unsafe {
                v = this.ex_[this.ex_pos_].val;
            }
            this.ex_pos_ = this.ex_pos_ + 1;
            return v;
        }
        this.has_error_ = true;
        this.ex_pos_ = this.ex_pos_ + 1;
        return 0;
    }

    // One non-recursive substitution pass over macro `mi`'s body, appended to
    // the flattened expression stream. Mirrors evalConstExpr step 2 (inserted
    // tokens are not re-examined).
    void emit_body_one(long mi) {
        long bs = 0;
        long bc = 0;
        unsafe {
            bs = this.macros_[mi].body_start;
            bc = this.macros_[mi].body_count;
        }
        long k = 0;
        while (k < bc) {
            Token bt;
            unsafe {
                bt = this.in_[bs + k];
            }
            if (this.kind_eq(bt, "identifier")) {
                long mi2 = this.find_macro(bt.off, bt.len);
                long isfn2 = 0;
                if (mi2 >= 0) {
                    unsafe {
                        isfn2 = this.macros_[mi2].is_fn;
                    }
                }
                if (mi2 >= 0 && isfn2 == 0 && !this.in_stack(bt.off, bt.len)) {
                    long bs2 = 0;
                    long bc2 = 0;
                    unsafe {
                        bs2 = this.macros_[mi2].body_start;
                        bc2 = this.macros_[mi2].body_count;
                    }
                    long t = 0;
                    while (t < bc2) {
                        Token s;
                        unsafe {
                            s = this.in_[bs2 + t];
                        }
                        this.ex_push(this.op_code(s), this.int_val(s), s.off, s.len);
                        t = t + 1;
                    }
                    k = k + 1;
                    continue;
                }
            }
            this.ex_push(this.op_code(bt), this.int_val(bt), bt.off, bt.len);
            k = k + 1;
        }
    }

    // Mirrors Preprocessor::evalConstExpr over the token slice [es, ee).
    long eval_expr(long es, long ee, int line, int col) {
        this.ex_n_ = 0;
        this.ex_pos_ = 0;
        long i = es;
        while (i < ee) {
            Token t;
            unsafe {
                t = this.in_[i];
            }
            bool is_ident = this.kind_eq(t, "identifier");
            bool is_kw = this.kind_eq(t, "keyword");
            if ((is_ident || is_kw) && this.lexeme_eq(t.off, t.len, "defined")) {
                long j = i + 1;
                bool have_paren = false;
                if (j < ee && this.kat(this.in_, j, "(")) {
                    have_paren = true;
                    j = j + 1;
                }
                if (j >= ee || (!this.kat(this.in_, j, "identifier") &&
                                !this.kat(this.in_, j, "keyword"))) {
                    this.has_error_ = true;
                    i = i + 1;
                    continue;
                }
                Token nt;
                unsafe {
                    nt = this.in_[j];
                }
                bool def = this.find_macro(nt.off, nt.len) >= 0 ||
                           this.is_predefined(nt.off, nt.len);
                j = j + 1;
                if (have_paren) {
                    if (j >= ee || !this.kat(this.in_, j, ")")) {
                        this.has_error_ = true;
                    } else {
                        j = j + 1;
                    }
                }
                this.ex_push(1, def ? 1 : 0, t.off, t.len);
                i = j;
                continue;
            }
            if (is_ident) {
                long mi = this.find_macro(t.off, t.len);
                long isfn = 0;
                if (mi >= 0) {
                    unsafe {
                        isfn = this.macros_[mi].is_fn;
                    }
                }
                if (mi >= 0 && isfn == 0) {
                    this.emit_body_one(mi);
                } else {
                    this.ex_push(1, 0, t.off, t.len);
                }
                i = i + 1;
                continue;
            }
            if (is_kw) {
                long v = 0;
                if (this.lexeme_eq(t.off, t.len, "true")) {
                    v = 1;
                }
                this.ex_push(1, v, t.off, t.len);
                i = i + 1;
                continue;
            }
            this.ex_push(this.op_code(t), this.int_val(t), t.off, t.len);
            i = i + 1;
        }
        return this.ex_expr();
    }

    // --- directive parsing ------------------------------------------------

    // `pos` points at `#`. Returns true and sets `next_` past the directive
    // line when it was a `#define`; false leaves `pos` for the caller.
    bool parse_define(long pos) {
        long hline = 0;
        unsafe {
            hline = this.in_[pos].line;
        }
        if (pos + 1 >= this.in_n_) {
            return false;
        }
        unsafe {
            Token dir = this.in_[pos + 1];
            if (!this.kind_eq(dir, "identifier")) {
                return false;
            }
            if (!this.lexeme_eq(dir.off, dir.len, "define")) {
                return false;
            }
        }

        long p = pos + 2;
        long name_off = 0;
        long name_len = 0;
        long name_line = 0;
        long name_col = 0;
        bool have_name = false;
        if (p < this.in_n_ && !this.tok_eof(p)) {
            unsafe {
                if (this.kind_eq(this.in_[p], "identifier")) {
                    name_off = this.in_[p].off;
                    name_len = this.in_[p].len;
                    name_line = this.in_[p].line;
                    name_col = this.in_[p].col;
                    have_name = true;
                }
            }
        }
        if (!have_name) {
            // Malformed `#define` ? diagnostic + skip line (H2.6 refines).
            this.has_error_ = true;
            long q = p;
            while (q < this.in_n_ && !this.tok_eof(q) && this.tok_line(q) == hline) {
                q = q + 1;
            }
            this.next_ = q;
            return true;
        }

        // Predefined macros cannot be redefined by the user.
        if (this.is_predefined(name_off, name_len)) {
            this.diag_add(name_line, name_col,
                          "cannot redefine predefined macro: ",
                          name_off, name_len, false);
            long q2 = p;
            while (q2 < this.in_n_ && !this.tok_eof(q2) && this.tok_line(q2) == hline) {
                q2 = q2 + 1;
            }
            this.next_ = q2;
            return true;
        }

        // Function-like detection: `(` immediately after the name (no
        // whitespace) ? column adjacency (lexer dropped the trivia).
        bool function_like = false;
        if (p + 1 < this.in_n_ && !this.tok_eof(p + 1)) {
            unsafe {
                Token lp = this.in_[p + 1];
                if (this.kind_eq(lp, "(") && lp.line == name_line &&
                    lp.col == name_col + (int)name_len) {
                    function_like = true;
                }
            }
        }

        long pstart = this.param_n_;
        long pcnt = 0;
        bool is_va = false;
        if (function_like) {
            long q = p + 1;  // at `(`
            q = q + 1;       // consume `(`
            while (q < this.in_n_ && !this.tok_eof(q) && !this.kat(this.in_, q, ")")) {
                if (this.kat(this.in_, q, "...")) {
                    is_va = true;
                    q = q + 1;
                    break;
                }
                if (this.kat(this.in_, q, "identifier")) {
                    unsafe {
                        this.register_param(this.in_[q].off, this.in_[q].len);
                    }
                    q = q + 1;
                    if (q < this.in_n_ && !this.tok_eof(q) && this.kat(this.in_, q, "...")) {
                        is_va = true;
                        q = q + 1;
                        break;
                    }
                    if (q < this.in_n_ && !this.tok_eof(q) && this.kat(this.in_, q, ",")) {
                        q = q + 1;
                        continue;
                    }
                    continue;
                }
                if (this.kat(this.in_, q, ",")) {
                    q = q + 1;
                    continue;
                }
                // Unexpected token in the parameter list ? skip it.
                q = q + 1;
            }
            if (q >= this.in_n_ || this.tok_eof(q) || !this.kat(this.in_, q, ")")) {
                // Unterminated macro parameter list ? diagnostic + skip line.
                this.has_error_ = true;
                long z = p;
                while (z < this.in_n_ && !this.tok_eof(z) && this.tok_line(z) == hline) {
                    z = z + 1;
                }
                this.next_ = z;
                return true;
            }
            q = q + 1;  // consume `)`
            p = q;      // body starts here
            pcnt = this.param_n_ - pstart;
        } else {
            p = p + 1;  // consume the name (object-like)
        }

        // Collect body tokens until end of the directive line.
        long b = p;
        while (b < this.in_n_ && !this.tok_eof(b) && this.tok_line(b) == hline) {
            b = b + 1;
        }
        long body_count = b - p;
        this.register_macro(name_off, name_len, p, body_count, pstart, pcnt,
                            function_like, is_va);
        this.next_ = b;
        return true;
    }

    // --- main loop --------------------------------------------------------

    // Emit the token at `i` verbatim, expanding object-like macros only
    // (function-like names without args are verbatim). Mirrors emitToken
    // for the unrecognized-directive path.
    void emit_at(long i) {
        Token t = this.at(i);
        if (!this.kind_eq(t, "identifier")) {
            this.out_push(t);
            return;
        }
        if (this.try_expand_predefined(t)) {
            return;
        }
        long mi = this.find_macro(t.off, t.len);
        if (mi < 0) {
            this.out_push(t);
            return;
        }
        long is_fn = 0;
        unsafe {
            is_fn = this.macros_[mi].is_fn;
        }
        if (is_fn != 0) {
            this.out_push(t);
            return;
        }
        this.expand_object(t, mi);
    }

    // Process a single non-directive token; sets next_.
    void step(long i) {
        Token t = this.at(i);
        if (this.kind_eq(t, "identifier")) {
            if (this.try_expand_predefined(t)) {
                this.next_ = i + 1;
                return;
            }
            long mi = this.find_macro(t.off, t.len);
            if (mi >= 0) {
                long is_fn = 0;
                unsafe {
                    is_fn = this.macros_[mi].is_fn;
                }
                if (is_fn != 0) {
                    this.expand_function_like(this.in_, this.in_n_, i, t, mi);
                    return;
                }
                this.expand_object(t, mi);
                this.next_ = i + 1;
                return;
            }
        }
        this.out_push(t);
        this.next_ = i + 1;
    }

    void run() {
        this.out_n_ = 0;
        this.macro_n_ = 0;
        this.param_n_ = 0;
        this.stack_n_ = 0;
        this.cond_n_ = 0;
        this.ex_n_ = 0;
        this.ex_pos_ = 0;
        this.cnumber_ = false;
        this.has_error_ = false;
        this.dn_ = 0;
        this.dtxt_n_ = 0;
        // Register the predefined object-like macros (bodies at 0:0). The
        // context-sensitive `__LINE__`/`__FILE__` are handled separately.
        this.register_predefined("__cplusplus", "integer", "202302L");
        this.register_predefined("__ivy__", "integer", "202604L");
        this.register_predefined("__DATE__", "string", "\"\"");
        this.register_predefined("__TIME__", "string", "\"\"");
        long i = 0;
        while (i < this.in_n_ && !this.tok_eof(i)) {
            Token t = this.at(i);
            if (this.kind_eq(t, "#")) {
                long before = i;
                if (this.active() && this.parse_define(before)) {
                    i = this.next_;
                    continue;
                }
                // Conditionals are processed even when inactive so nesting is
                // tracked and the right branch is picked on #else/#endif.
                if (this.parse_conditional(before)) {
                    i = this.next_;
                    continue;
                }
                // Pragmas are processed even when inactive.
                if (this.parse_pragma(before)) {
                    i = this.next_;
                    continue;
                }
                // Unrecognized directive. If active, emit `#` + rest of the
                // line; if inactive, skip the line.
                if (this.active()) {
                    this.emit_at(i);
                    i = i + 1;
                    while (i < this.in_n_ && !this.tok_eof(i) && this.tok_line(i) == t.line) {
                        this.emit_at(i);
                        i = i + 1;
                    }
                } else {
                    i = this.line_end(before);
                }
                continue;
            }
            if (!this.active()) {
                i = i + 1;
                continue;
            }
            this.step(i);
            i = this.next_;
        }
        if (this.cond_n_ != 0) {
            this.has_error_ = true;
            this.cond_n_ = 0;
        }
        this.out_push_raw("eof", 0, 0, 0, 0);
    }
};
