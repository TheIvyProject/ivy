// selfhost/parsing/ppdrive.ivy — H2.x differential-test driver for the
// preprocessor port.
//
// Reads file paths from stdin (one per line), lexes + preprocesses each with
// the Ivy ports, and prints `=== path ===` + the post-preprocessor token
// stream in the `ivy --tokens` format. Used by selfhost/difftest.ps1
// (-Oracle --tokens -Module preprocessor -Driver ppdrive).

#pragma ivy cnumber
// H7.4: direct import so the oracle's linker pulls in diagnostic.obj (the
// linker only links the objects of modules this file imports).
import diagnostic;
import token;
import lexer;
import preprocessor;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);
extern "C" unsigned long long __ivy_strlen(const char* s);

// H9.2: the `--tokens` printer is shared with the real driver
// (`preprocessor.TokenPrinter`), so this driver only feeds it.

void run() {
    while (true) {
        unsafe {
            char* line = io::read_line();
            if (line == (char*)0) {
                break;
            }
            uint64 np = __ivy_strlen(line);
            if (np > 0 && line[np - 1] == 13) {
                line[np - 1] = 0;  // strip trailing CR (read_line strips LF only)
            }
            io::println("=== {} ===", line);
            char* content = io::read_file(line);
            if (content != (char*)0) {
                uint64 len = __ivy_strlen(content);
                long cap = (long)len + 16;

                Lexer lx;
                lx.setup(content, len, line);
                lx.lex_all(cap);

                if (lx.had_error()) {
                    // H7.4: the lexer only collects; print like `ivy --tokens`
                    // (quoted path, no token dump after a lex error).
                    lx.print_diags_out();
                } else {
                    long in_n = lx.token_count();
                    long out_cap = in_n * 8 + 256;
                    Preprocessor pp;
                    pp.setup(lx.tokens(), in_n, content, (long)len, line, (long)np,
                             out_cap, 1024);
                    pp.run();
                    bool failed = false;
                    char* fname = line;
                    if (pp.has_line_file() != 0) {
                        fname = pp.line_file();
                    }
                    // H7.4: the shared Diags printer (stdout: the harness merges
                    // both streams and the `=== path ===` marker is ours).
                    pp.print_diags_out(fname);
                    if (pp.diag_failed() != 0) {
                        failed = true;
                    }
                    if (!failed) {
                        TokenPrinter pr;
                        pr.out = pp.output();
                        pr.n = pp.output_count();
                        pr.src = pp.arena();
                        pr.show();
                        // The printer ends at the `eof` token without a newline
                        // (like `ivy --tokens`); separate the files of a
                        // multi-file stdin run.
                        io::println("");
                    }
                    pp.release();
                }
                lx.release();
                __ivy_free(content);
            }
            __ivy_free(line);
        }
    }
}

int32 main() {
    run();
    return 0;
}
