// selfhost/parsing/ast.ivy — AST node model for the self-host parser port.
//
// Mirror of the subset of src/parsing/ast.h that H3.1 (declarations) needs:
// function/parameter/type/attribute records sufficient to reproduce the
// `ivy --ast` dump (`dumpAst` in src/app/main.cpp). Strings are stored as
// NUL-terminated `char*` into either a parser-interned buffer or a static
// literal (canonical Ivy type names are normalized to their `_t` form).

#pragma ivy cnumber
export module ast;

// A resolved type: canonical base name plus const/unsigned/reference/pointer
// qualifiers. `base` is "" when no type could be parsed.
// `array_size` is 0 for a scalar/pointer type and > 0 for `T[N]`.
//
// Template-id types (`Box<int32>`) keep their argument list: `tpl_args`
// points at a contiguous run of `tpl_n` argument types owned by the parser
// and `tpl_n` is 0 for an ordinary (non-template-id) type.  The run is
// immutable — a consumer that substitutes into the arguments must build a
// fresh run instead of writing through this pointer.
//
// sizeof(AType) is 48 bytes: the three qualifier flags are `bool` (1 byte
// each) so that the two template fields fit without growing the record.
// The qualifier flags mirror `ast::Type` in src/parsing/ast.h.
export struct AType {
    const char* base;
    AType* tpl_args;      // template-id arguments (null when not a template-id)
    long tpl_n;           // number of template arguments
    bool is_unsigned;
    bool is_const;
    bool is_ref;
    long ptr_depth;
    long array_size;
};

// A slice of template-argument types (the argument list of a template-id).
export struct ATypeList {
    AType* items;
    long n;
};

// A template parameter of a template declaration:
//   `typename T` / `class T`  -> is_typename = 1, type empty
//   `Concept T`                -> is_typename = 1, constraint = "Concept"
//   `int32 N` / `auto V`       -> is_typename = 0, type = the parameter type
//   `typename... Args`         -> is_variadic = 1
// `constraint` is the concept name of a constrained type parameter and ""
// when the parameter is unconstrained.  Mirrors `ast::TemplateParam`
// (src/parsing/ast.h); the oracle has no default template argument and no
// trailing `requires` clause, so neither is representable here.
export struct ATemplateParam {
    const char* name;
    AType type;              // the type of a non-type parameter
    const char* constraint;   // concept name ("" when unconstrained)
    long is_typename;
    long is_variadic;
    long line;
    long col;
};

// A slice of template parameters (the parameter list of a template
// declaration).  `items` points into the parser's template-parameter pool.
export struct ATemplateParamList {
    ATemplateParam* items;
    long n;
};

// A concept definition: `concept Name = requires(T a, T b) { a + b; };`.
// `param_name` is the concept's type parameter (e.g. "T") and the
// requirements are the raw token texts of the requires-expression body,
// joined per requirement.  `req_start`/`nreqs` delimit a contiguous run in
// the parser's requirement-text pool.  Mirrors `ast::ConceptDecl`
// (src/parsing/ast.h).
export struct AConcept {
    const char* name;
    const char* param_name;
    long req_start;     // first requirement index in the requirement pool
    long nreqs;         // number of requirements (0 => `req_start` unused)
    long line;
    long col;
};

// An `[[ivy::name(args)]]` attribute. `args` is the argument list already
// joined with ", " (as `dumpAttrs` prints it); `has_args` distinguishes an
// empty argument list from no argument list.
export struct AAttr {
    const char* name;
    const char* args;
    long has_args;
    long line;
    long col;
};

// One lifetime name.  `name` is the lifetime name without the leading
// `$` (native `lifetime<$a>`) or without the attribute brackets (legacy
// `[[ivy::lt_def(a)]]`).  A name is never NULL; an empty name means the
// annotation carried no name text.
export struct ALifetime {
    const char* name;
};

// A list of lifetime names: a contiguous run of the parser's lifetime
// pool.  `items` is NULL when the list is absent, which is distinct from
// an empty list (`items` non-NULL, `n == 0`).
export struct ALifetimeList {
    ALifetime* items;
    long n;
};

// A legacy lifetime annotation: `[[ivy::lt(x)]]` on a parameter,
// `[[ivy::lt_ret(x)]]` or `[[ivy::lt_def(a, b)]]` on a function.
// `kind` is 1 for `lt`, 2 for `lt_ret` and 3 for `lt_def`.  `args` are
// the annotation's arguments in source order; `args.items` is NULL when
// the annotation carries no argument list at all, which is distinct from
// an empty argument list.  `line`/`col` locate the attribute.
export struct ALegacyLifetime {
    ALifetimeList args;
    long kind;
    long line;
    long col;
};

// A list of legacy lifetime annotations: a contiguous run of the parser's
// legacy-lifetime pool.  `items` is NULL when the declaration carries no
// such annotation at all, which is distinct from an empty list.
export struct ALegacyLifetimeList {
    ALegacyLifetime* items;
    long n;
};

// A function parameter: type, optional name, and attributes.
// `default_value` is the expression-pool index of the parameter's default
// value, or -1 when the parameter has none.
//
// Lifetime annotations (A5).  A parameter may carry a native lifetime
// (`const int32& $a x`) and/or a legacy one (`[[ivy::lt(a)]]` after the
// name).  `lt_names` holds the native names (at most one) and
// `legacy_lts` the legacy annotations of the parameter; both forms are
// kept so that the HIR stage can apply the precedence rules.  A list
// whose `items` is NULL is absent, which is distinct from an empty list.
export struct AParam {
    AType type;
    const char* name;
    AAttr* attrs;
    long nattrs;
    long line;
    long col;
    long default_value;
    ALifetimeList lt_names;
    ALegacyLifetimeList legacy_lts;
};

// A top-level function declaration or definition. `body` is a statement-pool
// index for the root Compound, or -1 for a declaration only.
// `tpl_params`/`tpl_n` hold the template parameter list of a template
// function (empty for an ordinary function).
//
// Lifetime annotations (A5).  `lt_names` is the native `lifetime<$a, $b>`
// declaration in declaration order, `ret_lts` the native `$a` on the
// return type (at most one) and `legacy_lts` the legacy
// `[[ivy::lt_ret(x)]]` / `[[ivy::lt_def(a, b)]]` annotations.  Both the
// native and the legacy forms are kept so that the HIR stage can apply
// the precedence rules.
export struct AFunction {
    AAttr* attrs;
    long nattrs;
    AType ret;
    const char* name;
    AParam* params;
    long nparams;
    long is_extern_c;
    long body;
    long line;
    long col;
    long is_constexpr;   // `constexpr` / `consteval` function
    // H7.3: `consteval` is a distinct flag in the oracle AST
    // (`Function::isConsteval`), and the `.ivm` writer serializes it
    // separately from `isConstexpr` (a `consteval` function sets both).
    long is_consteval;
    long is_virtual;     // `virtual` or pure-virtual method
    ATemplateParam* tpl_params;
    long tpl_n;
    ALifetimeList lt_names;
    ALifetimeList ret_lts;
    ALegacyLifetimeList legacy_lts;
    // H6.2p: the parameter list ends in `...` (a variadic declaration such
    // as `extern "C" int printf(const char* fmt, ...);`).
    long is_variadic;
    // H6.2s: the constructor member initializer list (`: x(42), y(3)`).
    // `minit_start`/`minit_n` index a slice of the parser's member-init pool
    // (field name + initializer expression); the HIR synthesizes
    // `this.field = arg` assignments at the head of the body.
    long minit_start;
    long minit_n;
    // H6.2y: the `override` marker and the pure-virtual `= 0` marker.  The
    // oracle distinguishes these from plain `virtual` when it builds the
    // vtable (an override replaces the base slot; a pure virtual emits a
    // null function pointer).
    long is_override;
    long is_pure_virtual;
};

// A struct/class field declaration.
export struct AField {
    AType type;
    const char* name;
    long line;
    long col;
};

// An enum enumerator. `value` is an expression-pool index for an explicit
// value, or -1 when the value is implicit.
export struct AEnumerator {
    const char* name;
    long value;
    long line;
    long col;
};

// A struct/class definition. `fields` and `methods` point into contiguous
// runs of the parser's field/method pools. Method names are qualified as
// `StructName::methodName`. `bstart`/`nbases` delimit the base-class names
// in the parser's base-name pool.  `tpl_params`/`tpl_n` hold the template
// parameter list of a template struct/class (empty otherwise).
export struct AStruct {
    const char* name;
    long is_class;
    AField* fields;
    long nfields;
    AFunction* methods;
    long nmethods;
    long bstart;
    long nbases;
    long line;
    long col;
    ATemplateParam* tpl_params;
    long tpl_n;
};

// An enum definition. `enumerators` points into a contiguous run of the
// parser's enumerator pool.
export struct AEnum {
    const char* name;
    long is_scoped;     // `enum class` / `enum struct`
    AType underlying;
    AEnumerator* enumerators;
    long nenumerators;
    long line;
    long col;
};

// A `using Name = Type;` alias.
export struct AAlias {
    const char* name;
    AType target;
};

// An expression node in the expression pool. Child fields hold pool indices
// (-1 when absent); `astart`/`an` delimit a contiguous run of child
// expression indices in the argument-stack pool.
//
// kind codes (mirror dumpExpr in src/app/main.cpp):
//   1 int  2 float  3 string  4 char  5 bool  6 nullptr  7 nullopt
//   8 ident  9 this  10 unary  11 binary  12 ternary  13 call  14 index
//   15 member  16 assign  17 sizeofpack  18 sizeof  19 alignof  20 cast
//   21 new  22 delete  23 init-list
//
// H6.2v: kind 17 is a pack expansion (`expr...`); kind 24 is
// `sizeof...(pack)` (the pack name is in `sval`) and kind 25 is a fold
// expression (`sval` is the operator, `a`/`b` the operands with -1 for the
// absent side, `flag` is 1 for the unary-left form).
//
// H6.2n: `new T(args)` stores the target type in `type` and its arguments
// as a run of `astart`/`an` indices in the call-argument pool (the same
// staging used by calls).  `delete[] expr` stores `isArray` in `flag` and
// the operand in `a`.
//
// H6.2o: a braced aggregate initializer `{ expr, .field = expr, ... }`
// stores its elements as a run of `astart`/`an` indices in the
// call-argument pool and the matching field designators (the interned field
// name, or 0 for a positional element) as a run of `dstart`/`an` entries in
// the parser's designator pool (`Parser::desigs()`).  The parser never
// records a missing element: the `<zero-init>` placeholders of the oracle's
// HIR list are synthesized by the HIR builder.
//
// `tpl_args`/`tpl_n` hold the explicit template arguments of a template-id
// call (`f<int32>(x)`); they are empty for an ordinary call.
export struct AExpr {
    long kind;
    long ival;          // integer literal value (kind 1)
    const char* sval;   // raw lexeme / ident / op / member name
    long flag;          // isPrefix(10) | isArrow(15) | isScope(15) | castkind(20)
    long a;             // operand / lhs / cond / base / callee / pattern
    long b;             // rhs / then / index
    long c;             // else
    long astart;        // first call-arg / index expr index (-1 none)
    long an;            // call-arg count / init-list element count
    AType type;         // sizeof/alignof/cast/new target type
    long is_scope;      // member(15): `::` scope resolution (vs `.`/`->`)
    long line;
    long col;
    double fval;        // exact value of a float literal (kind 2)
    AType* tpl_args;    // explicit template arguments of a template-id call
    long tpl_n;
    long dstart;        // init-list(23): first designator index (-1 none)
};

// A statement node in the statement pool.
//
// kind codes (mirror dumpStmt in src/app/main.cpp):
//   1 compound  2 decl  3 if  4 while  5 dowhile  6 for  7 rangefor
//   8 return  9 break  10 continue  11 nextcase  12 exprstmt  13 unsafe
//   14 null  15 switch  16 structbind
//
// H6.2w: a structured binding (`auto [a, b] = expr;`) stores its initializer
// in `a` and its names as a run of `sn` interned name pointers starting at
// `sstart` in the parser's structured binding name pool (`Parser::sbnms()`).
export struct AStmt {
    long kind;
    const char* sval;   // decl name / nextcase target
    AType type;         // decl type / rangefor element type
    long flag;          // rangefor isRef (7) | if isConstexpr (3)
    long a;             // expr index (cond / return value / exprstmt value)
                        // or stmt index (for init(6) / unsafe body(13))
    long b;             // stmt index (then / body / for cond is expr)
    long c;             // stmt index (else) / for incr is expr
    long sstart;        // first child stmt index (compound(1) children walk via
                        // `next`; for(6) body is a stmt; switch(15) first case)
    long sn;            // child stmt count
    long next;          // next sibling stmt index (-1) for linked child lists
    long line;
    long col;
};

// A `case`/`default` clause of a switch statement. `value` is the case
// expression pool index, or -1 for `default`. `sstart` is the index of the
// first statement of the clause body (the body is a chain of statements
// linked by their `next` field).
//
// `next` is the index of the next clause of the SAME switch (-1 for the
// last one).  The clauses of a switch are a linked list and not a
// contiguous run of the pool: a switch that is nested in a case body pushes
// its own clauses into the same pool, so the pool order and the source
// order differ.
//
// `label` is the A6 case label of `case LABEL: value:` (the empty string
// when the clause carries no label).  The oracle keeps it in
// `ast::Stmt::CaseClause::caseLabel` and the HIR builder copies it into
// `hir::Stmt::CaseClause::caseLabel`, where the MIR builder uses it to
// resolve `nextcase LABEL;`.  The label is interned by the parser, so the
// pointer stays valid for the whole parse.
//
// sizeof(ACase): value(8) + sstart(8) + next(8) + label(8) = 32 bytes.
export struct ACase {
    long value;
    long sstart;
    long next;
    const char* label;
};

// --- H9.2: the `--ast` printer -------------------------------------------
//
// Moved verbatim from astdrive.ivy so the real driver (app/main.ivy) and the
// differential driver share one implementation.  The fields point into the
// parser's pools; the caller sets them and walks the function pool in
// declaration order (emit per function).
// Free functions cannot take raw-pointer parameters, so the printer is a
// struct whose fields hold them.
export struct AstDumper {
    AExpr* ep;
    AStmt* sp;
    long* ca;
    ACase* cp;
    long* sbnm;

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    void pad(long depth) {
        long i = 0;
        while (i < depth) {
            io::print("  ");
            i = i + 1;
        }
    }

    void dump_type(AType t) {
        if (t.is_const != 0) {
            io::print("const ");
        }
        if (t.is_unsigned != 0) {
            io::print("unsigned ");
        }
        io::print(t.base);
        long i = 0;
        while (i < t.ptr_depth) {
            io::print("*");
            i = i + 1;
        }
    }

    void dump_attrs(AAttr* attrs, long n) {
        long i = 0;
        while (i < n) {
            AAttr a;
            unsafe {
                a = attrs[i];
            }
            io::print("[[ivy::");
            io::print(a.name);
            if (a.has_args != 0) {
                io::print("(");
                io::print(a.args);
                io::print(")");
            }
            io::print("]]");
            i = i + 1;
        }
    }

    void dump_expr(long idx, long depth) {
        AExpr e;
        unsafe {
            e = this.ep[idx];
        }
        this.pad(depth);
        if (e.kind == 1) {
            io::print("int {}", e.ival);
            return;
        }
        if (e.kind == 2) {
            io::print("float {}", e.sval);
            return;
        }
        if (e.kind == 3) {
            io::print("string {}", e.sval);
            return;
        }
        if (e.kind == 4) {
            io::print("char {}", e.sval);
            return;
        }
        if (e.kind == 5) {
            if (e.flag != 0) {
                io::print("bool true");
            } else {
                io::print("bool false");
            }
            return;
        }
        if (e.kind == 6) {
            io::print("nullptr");
            return;
        }
        if (e.kind == 7) {
            io::print("nullopt");
            return;
        }
        if (e.kind == 8) {
            io::print("ident {}", e.sval);
            return;
        }
        if (e.kind == 9) {
            io::print("this");
            return;
        }
        if (e.kind == 10) {
            if (e.flag != 0) {
                io::println("prefix {}", e.sval);
            } else {
                io::println("postfix {}", e.sval);
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 11) {
            io::println("binary {}", e.sval);
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 12) {
            io::println("ternary ?:");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            this.dump_expr(e.c, depth + 1);
            return;
        }
        if (e.kind == 13) {
            io::println("call");
            this.dump_expr(e.a, depth + 1);
            long j = 0;
            while (j < e.an) {
                long ai = 0;
                unsafe {
                    ai = this.ca[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 14) {
            io::println("index");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 15) {
            if (e.flag != 0) {
                io::println("member -> {}", e.sval);
            } else {
                io::println("member . {}", e.sval);
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 16) {
            io::println("assign {}", e.sval);
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 17) {
            io::println("pack-expansion");
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 18) {
            io::println("sizeof({})", e.type.base);
            return;
        }
        if (e.kind == 19) {
            io::println("alignof({})", e.type.base);
            return;
        }
        if (e.kind == 20) {
            if (e.flag == 1) {
                io::print("reinterpret_cast");
            } else if (e.flag == 2) {
                io::print("const_cast");
            } else if (e.flag == 3) {
                io::print("C-cast");
            } else {
                io::print("static_cast");
            }
            io::println("<{}>(", e.type.base);
            this.dump_expr(e.a, depth + 1);
            this.pad(depth);
            io::println(")");
            return;
        }
        if (e.kind == 21) {
            io::print("new ");
            this.dump_type(e.type);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.ca[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 22) {
            if (e.flag != 0) {
                io::println("delete[]");
            } else {
                io::println("delete");
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 23) {
            io::println("init-list ({})", e.an);
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.ca[e.astart + j];
                }
                if (ai >= 0) {
                    this.dump_expr(ai, depth + 1);
                } else {
                    this.pad(depth);
                    io::println("  <zero-init>");
                }
                j = j + 1;
            }
            return;
        }
        if (e.kind == 24) {
            io::println("sizeof...({})", e.sval);
            return;
        }
        if (e.kind == 25) {
            if (e.flag != 0) {
                io::println("fold op='{}' isLeftPack=true", e.sval);
            } else {
                io::println("fold op='{}' isLeftPack=false", e.sval);
            }
            if (e.a >= 0) {
                this.dump_expr(e.a, depth + 1);
            } else {
                this.pad(depth);
                io::println("  <null lhs>");
            }
            if (e.b >= 0) {
                this.dump_expr(e.b, depth + 1);
            } else {
                this.pad(depth);
                io::println("  <null rhs>");
            }
            return;
        }
    }

    void dump_compound(long idx, long depth) {
        AStmt s;
        unsafe {
            s = this.sp[idx];
        }
        this.pad(depth);
        io::println("block");
        long k = s.sstart;
        while (k >= 0) {
            this.dump_stmt(k, depth + 1);
            unsafe {
                k = this.sp[k].next;
            }
        }
    }

    void dump_stmt(long idx, long depth) {
        AStmt s;
        unsafe {
            s = this.sp[idx];
        }
        if (s.kind == 1) {
            this.dump_compound(idx, depth);
            return;
        }
        this.pad(depth);
        if (s.kind == 2) {
            io::print("decl ");
            this.dump_type(s.type);
            io::print(" {}", s.sval);
            if (s.a >= 0) {
                io::println(" =");
                this.dump_expr(s.a, depth + 1);
            } else {
                io::println("");
            }
            return;
        }
        if (s.kind == 3) {
            io::println("if");
            this.dump_expr(s.a, depth + 1);
            this.pad(depth);
            io::println("  then");
            if (s.b >= 0) {
                this.dump_stmt(s.b, depth + 1);
            }
            if (s.c >= 0) {
                this.pad(depth);
                io::println("  else");
                this.dump_stmt(s.c, depth + 1);
            }
            return;
        }
        if (s.kind == 4) {
            io::println("while");
            this.dump_expr(s.a, depth + 1);
            this.dump_stmt(s.b, depth + 1);
            return;
        }
        if (s.kind == 5) {
            io::println("do-while");
            this.dump_stmt(s.a, depth + 1);
            this.dump_expr(s.b, depth + 1);
            return;
        }
        if (s.kind == 6) {
            io::println("for");
            this.pad(depth);
            io::println("  init");
            this.dump_stmt(s.a, depth + 1);
            this.pad(depth);
            io::println("  cond");
            if (s.b >= 0) {
                this.dump_expr(s.b, depth + 1);
            }
            this.pad(depth);
            io::println("  incr");
            if (s.c >= 0) {
                this.dump_expr(s.c, depth + 1);
            }
            this.pad(depth);
            io::println("  body");
            this.dump_stmt(s.sstart, depth + 1);
            return;
        }
        if (s.kind == 7) {
            if (s.flag != 0) {
                io::println("range-for ref");
            } else {
                io::println("range-for");
            }
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            if (s.b >= 0) {
                this.dump_stmt(s.b, depth + 1);
            }
            return;
        }
        if (s.kind == 8) {
            io::println("return");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            return;
        }
        if (s.kind == 9) {
            io::println("break");
            return;
        }
        if (s.kind == 10) {
            io::println("continue");
            return;
        }
        if (s.kind == 11) {
            if (this.slen(s.sval) > 0) {
                io::println("nextcase {}", s.sval);
            } else {
                io::println("nextcase");
            }
            return;
        }
        if (s.kind == 12) {
            io::println("expr");
            this.dump_expr(s.a, depth + 1);
            return;
        }
        if (s.kind == 13) {
            io::println("unsafe");
            this.dump_stmt(s.a, depth + 1);
            return;
        }
        if (s.kind == 14) {
            io::println("null");
            return;
        }
        if (s.kind == 15) {
            io::println("switch");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            // The clauses of a switch are a linked list (a switch that is
            // nested in a case body pushes its own clauses into the same
            // pool, so the pool order and the source order differ).
            long j = s.sstart;
            while (j >= 0) {
                ACase c;
                unsafe {
                    c = this.cp[j];
                }
                if (c.value >= 0) {
                    this.pad(depth);
                    io::println("  case");
                    this.dump_expr(c.value, depth + 2);
                } else {
                    this.pad(depth);
                    io::println("  default");
                }
                long k = c.sstart;
                while (k >= 0) {
                    this.dump_stmt(k, depth + 2);
                    unsafe {
                        k = this.sp[k].next;
                    }
                }
                unsafe {
                    j = c.next;
                }
            }
            return;
        }
        if (s.kind == 16) {
            io::print("structured-binding [");
            long k = 0;
            while (k < s.sn) {
                if (k > 0) {
                    io::print(", ");
                }
                unsafe {
                    io::print("{}", (char*) this.sbnm[s.sstart + k]);
                }
                k = k + 1;
            }
            io::println("]");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            return;
        }
    }

    void emit(AFunction f) {
        io::print("function ");
        if (f.is_extern_c != 0) {
            io::print("[extern \"C\"] ");
        }
        this.dump_attrs(f.attrs, f.nattrs);
        io::println("");
        io::print("  return ");
        this.dump_type(f.ret);
        io::print(" ");
        io::print(f.name);
        io::print("(");
        long j = 0;
        while (j < f.nparams) {
            if (j > 0) {
                io::print(", ");
            }
            AParam p;
            unsafe {
                p = f.params[j];
            }
            this.dump_type(p.type);
            if (this.slen(p.name) > 0) {
                io::print(" ");
                io::print(p.name);
            }
            if (p.nattrs > 0) {
                io::print(" ");
                this.dump_attrs(p.attrs, p.nattrs);
            }
            j = j + 1;
        }
        io::println(")");
        if (f.body >= 0) {
            this.dump_stmt(f.body, 1);
        } else {
            io::println("  (declaration only)");
        }
        io::println("");
    }
};
