// selfhost/parsing/ast.ivy — AST node model for the self-host parser port.
//
// Mirror of the subset of src/parsing/ast.h that H3.1 (declarations) needs:
// function/parameter/type/attribute records sufficient to reproduce the
// `ivy --ast` dump (`dumpAst` in src/app/main.cpp). Strings are stored as
// NUL-terminated `char*` into either a parser-interned buffer or a static
// literal (canonical Ivy type names are normalized to their `_t` form).

#pragma ivy cnumber
export module ast;

// A resolved type: canonical base name plus const/unsigned/reference/pointer
// qualifiers. `base` is "" when no type could be parsed.
// `array_size` is 0 for a scalar/pointer type and > 0 for `T[N]`.
//
// Template-id types (`Box<int32>`) keep their argument list: `tpl_args`
// points at a contiguous run of `tpl_n` argument types owned by the parser
// and `tpl_n` is 0 for an ordinary (non-template-id) type.  The run is
// immutable — a consumer that substitutes into the arguments must build a
// fresh run instead of writing through this pointer.
//
// sizeof(AType) is 48 bytes: the three qualifier flags are `bool` (1 byte
// each) so that the two template fields fit without growing the record.
// The qualifier flags mirror `ast::Type` in src/parsing/ast.h.
export struct AType {
    const char* base;
    AType* tpl_args;      // template-id arguments (null when not a template-id)
    long tpl_n;           // number of template arguments
    bool is_unsigned;
    bool is_const;
    bool is_ref;
    long ptr_depth;
    long array_size;
};

// A slice of template-argument types (the argument list of a template-id).
export struct ATypeList {
    AType* items;
    long n;
};

// A template parameter of a template declaration:
//   `typename T` / `class T`  -> is_typename = 1, type empty
//   `Concept T`                -> is_typename = 1, constraint = "Concept"
//   `int32 N` / `auto V`       -> is_typename = 0, type = the parameter type
//   `typename... Args`         -> is_variadic = 1
// `constraint` is the concept name of a constrained type parameter and ""
// when the parameter is unconstrained.  Mirrors `ast::TemplateParam`
// (src/parsing/ast.h); the oracle has no default template argument and no
// trailing `requires` clause, so neither is representable here.
export struct ATemplateParam {
    const char* name;
    AType type;              // the type of a non-type parameter
    const char* constraint;   // concept name ("" when unconstrained)
    long is_typename;
    long is_variadic;
    long line;
    long col;
};

// A slice of template parameters (the parameter list of a template
// declaration).  `items` points into the parser's template-parameter pool.
export struct ATemplateParamList {
    ATemplateParam* items;
    long n;
};

// A concept definition: `concept Name = requires(T a, T b) { a + b; };`.
// `param_name` is the concept's type parameter (e.g. "T") and the
// requirements are the raw token texts of the requires-expression body,
// joined per requirement.  `req_start`/`nreqs` delimit a contiguous run in
// the parser's requirement-text pool.  Mirrors `ast::ConceptDecl`
// (src/parsing/ast.h).
export struct AConcept {
    const char* name;
    const char* param_name;
    long req_start;     // first requirement index in the requirement pool
    long nreqs;         // number of requirements (0 => `req_start` unused)
    long line;
    long col;
};

// An `[[ivy::name(args)]]` attribute. `args` is the argument list already
// joined with ", " (as `dumpAttrs` prints it); `has_args` distinguishes an
// empty argument list from no argument list.
export struct AAttr {
    const char* name;
    const char* args;
    long has_args;
    long line;
    long col;
};

// A function parameter: type, optional name, and attributes.
// `default_value` is the expression-pool index of the parameter's default
// value, or -1 when the parameter has none.
export struct AParam {
    AType type;
    const char* name;
    AAttr* attrs;
    long nattrs;
    long line;
    long col;
    long default_value;
};

// A top-level function declaration or definition. `body` is a statement-pool
// index for the root Compound, or -1 for a declaration only.
// `tpl_params`/`tpl_n` hold the template parameter list of a template
// function (empty for an ordinary function).
export struct AFunction {
    AAttr* attrs;
    long nattrs;
    AType ret;
    const char* name;
    AParam* params;
    long nparams;
    long is_extern_c;
    long body;
    long line;
    long col;
    long is_constexpr;   // `constexpr` / `consteval` function
    long is_virtual;     // `virtual` or pure-virtual method
    ATemplateParam* tpl_params;
    long tpl_n;
};

// A struct/class field declaration.
export struct AField {
    AType type;
    const char* name;
    long line;
    long col;
};

// An enum enumerator. `value` is an expression-pool index for an explicit
// value, or -1 when the value is implicit.
export struct AEnumerator {
    const char* name;
    long value;
    long line;
    long col;
};

// A struct/class definition. `fields` and `methods` point into contiguous
// runs of the parser's field/method pools. Method names are qualified as
// `StructName::methodName`. `bstart`/`nbases` delimit the base-class names
// in the parser's base-name pool.  `tpl_params`/`tpl_n` hold the template
// parameter list of a template struct/class (empty otherwise).
export struct AStruct {
    const char* name;
    long is_class;
    AField* fields;
    long nfields;
    AFunction* methods;
    long nmethods;
    long bstart;
    long nbases;
    long line;
    long col;
    ATemplateParam* tpl_params;
    long tpl_n;
};

// An enum definition. `enumerators` points into a contiguous run of the
// parser's enumerator pool.
export struct AEnum {
    const char* name;
    long is_scoped;     // `enum class` / `enum struct`
    AType underlying;
    AEnumerator* enumerators;
    long nenumerators;
    long line;
    long col;
};

// A `using Name = Type;` alias.
export struct AAlias {
    const char* name;
    AType target;
};

// An expression node in the expression pool. Child fields hold pool indices
// (-1 when absent); `astart`/`an` delimit a contiguous run of child
// expression indices in the argument-stack pool.
//
// kind codes (mirror dumpExpr in src/app/main.cpp):
//   1 int  2 float  3 string  4 char  5 bool  6 nullptr  7 nullopt
//   8 ident  9 this  10 unary  11 binary  12 ternary  13 call  14 index
//   15 member  16 assign  17 sizeofpack  18 sizeof  19 alignof  20 cast
//
// `tpl_args`/`tpl_n` hold the explicit template arguments of a template-id
// call (`f<int32>(x)`); they are empty for an ordinary call.
export struct AExpr {
    long kind;
    long ival;          // integer literal value (kind 1)
    const char* sval;   // raw lexeme / ident / op / member name
    long flag;          // isPrefix(10) | isArrow(15) | isScope(15) | castkind(20)
    long a;             // operand / lhs / cond / base / callee / pattern
    long b;             // rhs / then / index
    long c;             // else
    long astart;        // first call-arg / index expr index (-1 none)
    long an;            // call-arg count
    AType type;         // sizeof/alignof/cast/new target type
    long is_scope;      // member(15): `::` scope resolution (vs `.`/`->`)
    long line;
    long col;
    double fval;        // exact value of a float literal (kind 2)
    AType* tpl_args;    // explicit template arguments of a template-id call
    long tpl_n;
};

// A statement node in the statement pool.
//
// kind codes (mirror dumpStmt in src/app/main.cpp):
//   1 compound  2 decl  3 if  4 while  5 dowhile  6 for  7 rangefor
//   8 return  9 break  10 continue  11 nextcase  12 exprstmt  13 unsafe
//   14 null  15 switch  16 structbind
export struct AStmt {
    long kind;
    const char* sval;   // decl name / nextcase target
    AType type;         // decl type / rangefor element type
    long flag;          // rangefor isRef (7) | if isConstexpr (3)
    long a;             // expr index (cond / return value / exprstmt value)
                        // or stmt index (for init(6) / unsafe body(13))
    long b;             // stmt index (then / body / for cond is expr)
    long c;             // stmt index (else) / for incr is expr
    long sstart;        // first child stmt index (compound(1) children walk via
                        // `next`; for(6) body is a stmt; switch(15) first case)
    long sn;            // child stmt count
    long next;          // next sibling stmt index (-1) for linked child lists
    long line;
    long col;
};

// A `case`/`default` clause of a switch statement. `value` is the case
// expression pool index, or -1 for `default`. `sstart`/`sn` delimit the
// clause body stmt indices in the stmt-stack pool.
export struct ACase {
    long value;
    long sstart;
    long sn;
};
