// selfhost/parsing/ast.ivy — AST node model for the self-host parser port.
//
// Mirror of the subset of src/parsing/ast.h that H3.1 (declarations) needs:
// function/parameter/type/attribute records sufficient to reproduce the
// `ivy --ast` dump (`dumpAst` in src/app/main.cpp). Strings are stored as
// NUL-terminated `char*` into either a parser-interned buffer or a static
// literal (canonical Ivy type names are normalized to their `_t` form).

#pragma ivy cnumber
export module ast;

// A resolved type: canonical base name plus const/unsigned/reference/pointer
// qualifiers. `base` is "" when no type could be parsed.
export struct AType {
    const char* base;
    long is_unsigned;
    long is_const;
    long is_ref;
    long ptr_depth;
};

// An `[[ivy::name(args)]]` attribute. `args` is the argument list already
// joined with ", " (as `dumpAttrs` prints it); `has_args` distinguishes an
// empty argument list from no argument list.
export struct AAttr {
    const char* name;
    const char* args;
    long has_args;
};

// A function parameter: type, optional name, and attributes.
export struct AParam {
    AType type;
    const char* name;
    AAttr* attrs;
    long nattrs;
};

// A top-level function declaration or definition. `body` is a statement-pool
// index for the root Compound, or -1 for a declaration only.
export struct AFunction {
    AAttr* attrs;
    long nattrs;
    AType ret;
    const char* name;
    AParam* params;
    long nparams;
    long is_extern_c;
    long body;
};

// An expression node in the expression pool. Child fields hold pool indices
// (-1 when absent); `astart`/`an` delimit a contiguous run of child
// expression indices in the argument-stack pool.
//
// kind codes (mirror dumpExpr in src/app/main.cpp):
//   1 int  2 float  3 string  4 char  5 bool  6 nullptr  7 nullopt
//   8 ident  9 this  10 unary  11 binary  12 ternary  13 call  14 index
//   15 member  16 assign  17 sizeofpack  18 sizeof  19 alignof  20 cast
export struct AExpr {
    long kind;
    long ival;          // integer literal value (kind 1)
    const char* sval;   // raw lexeme / ident / op / member name
    long flag;          // isPrefix(10) | isArrow(15) | isScope(15) | castkind(20)
    long a;             // operand / lhs / cond / base / callee / pattern
    long b;             // rhs / then / index
    long c;             // else
    long astart;        // first call-arg / index expr index (-1 none)
    long an;            // call-arg count
    AType type;         // sizeof/alignof/cast/new target type
};

// A statement node in the statement pool.
//
// kind codes (mirror dumpStmt in src/app/main.cpp):
//   1 compound  2 decl  3 if  4 while  5 dowhile  6 for  7 rangefor
//   8 return  9 break  10 continue  11 nextcase  12 exprstmt  13 unsafe
//   14 null  15 switch  16 structbind
export struct AStmt {
    long kind;
    const char* sval;   // decl name / nextcase target
    AType type;         // decl type / rangefor element type
    long a;             // expr index (cond / return value / exprstmt value)
    long b;             // stmt index (then / body)
    long c;             // stmt index (else)
    long sstart;        // first child stmt index in the stmt-stack pool
    long sn;            // child stmt count
};
