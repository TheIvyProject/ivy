// selfhost/app/pipeline.ivy - H8.1: the shared frontend pipeline.
//
// `Cg` is the `run()` frontend of src/app/main.cpp (lexer -> preprocessor ->
// parser -> HIR -> MIR), extracted from selfhost/codegen/cgdrive.ivy so the IR
// differential driver (`cgdrive`) and the unified CLI (`app/main.ivy`) share
// one implementation:
//
//   * pre-scan the preprocessed tokens for `import` declarations, resolve and
//     read each `.ivm`, and predeclare its struct/enum/alias names before the
//     parser runs;
//   * after parsing, merge the imported declarations into the translation unit
//     (functions appended, types deduped by name);
//   * for imported template structs, parse the module's `.ivy` source and
//     splice its method bodies into the bodyless `.ivm` methods;
//   * write the `.ivm` interface when the source is a module interface unit
//     (`-o` decides where, mirroring main.cpp:1280-1301);
//   * run HIR and MIR and keep the resulting `MUnit` alive for the backends.
//
// The parser is held in a field of `Cg` because an Ivy struct *argument* is
// passed by value: a helper taking `Parser` would mutate a copy, so every step
// that changes the parser is a method of `Cg` (`this.pa`).

#pragma ivy cnumber
export module pipeline;

import token;
import lexer;
import preprocessor;
import ast;
import parser;
import module_io;
import imports;
import cli;
import hir;
import hir_builder;
import mir;
import mir_builder;
import io;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);
export struct Cg {
    Parser pa;
    Imports im;

    // Destination structs whose template methods still need a body (the
    // oracle's `tplStructs` map, src/app/main.cpp:1075-1086).
    long* tpl_;
    long tpl_n_;

    // H8.1: the stage state that must outlive `compile()` because the MIR
    // names point into the preprocessor arena and the merged declarations
    // point into the `.ivm` buffers. `release()` frees them in the oracle's
    // order (MIR, HIR, module units, parser, preprocessor, lexer).
    Lexer lx_;
    Preprocessor pp_;
    HirBuilder hb_;
    MirBuilder mb_;
    long has_mb_;
    ModuleUnit* mods_;
    long nmod_;
    // The diagnostic file name `compile()` settled on (`#line` remapping, or
    // the source path), exposed for the backends' diagnostics.
    char* fname_;
    // H9.2: the source buffer, needed by the `--lex` dump (the lexer's token
    // offsets index it).
    char* content_;

    // H9.8: the local headers named by `import cpp` / `import c`, resolved
    // exactly like `main.cpp:1207-1260` (source directory first, then the `-I`
    // directories; a header that is not on disk is a system header and stays
    // declaration-only).  Owned here and read by the driver at link time.
    char** cpph_;
    long ncpph_;
    long capcpph_;
    char** ch_;
    long nch_;
    long capch_;

    // --- small string helpers ----------------------------------------------

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) { i = i + 1; }
        }
        return i;
    }

    bool seq(const char* a, const char* b) {
        unsafe {
            long i = 0;
            while (a[i] != 0 && b[i] != 0) {
                if (a[i] != b[i]) { return false; }
                i = i + 1;
            }
            return a[i] == b[i];
        }
        return false;
    }

    // Offset of the part after the last `::` (0 when the name is unqualified).
    long bare_off(const char* s) {
        unsafe {
            long n = this.slen(s);
            long i = n - 1;
            while (i >= 1) {
                if (s[i - 1] == 58 && s[i] == 58) { return i + 1; }
                i = i - 1;
            }
        }
        return 0;
    }

    bool bare_eq(const char* a, const char* b) {
        unsafe {
            long ao = this.bare_off(a);
            long bo = this.bare_off(b);
            return this.seq(a + ao, b + bo);
        }
        return false;
    }

    // `dstBare == srcBare` + same parameter count + same parameter type
    // signature (`main.cpp:1124-1151`).  The signature is base + `const` +
    // `*` per pointer level + `&` for a reference; the other type fields are
    // ignored, exactly like the oracle's `buildSig`.
    bool type_sig_eq(AType a, AType b) {
        if (!this.seq(a.base, b.base)) { return false; }
        if (a.is_const != b.is_const) { return false; }
        if (a.ptr_depth != b.ptr_depth) { return false; }
        if (a.is_ref != b.is_ref) { return false; }
        return true;
    }

    bool method_match(AFunction dst, AFunction src) {
        if (!this.bare_eq(dst.name, src.name)) { return false; }
        if (dst.nparams != src.nparams) { return false; }
        unsafe {
            long k = 0;
            while (k < dst.nparams) {
                AParam a = dst.params[k];
                AParam b = src.params[k];
                if (!this.type_sig_eq(a.type, b.type)) { return false; }
                k = k + 1;
            }
        }
        return true;
    }

    // `<name> == <sname>::<sname>` (a constructor).
    bool is_ctor(const char* name, const char* sname) {
        long sl = this.slen(sname);
        long nl = this.slen(name);
        if (nl != sl * 2 + 2) { return false; }
        unsafe {
            long k = 0;
            while (k < sl) {
                if (name[k] != sname[k]) { return false; }
                k = k + 1;
            }
            if (name[sl] != 58 || name[sl + 1] != 58) { return false; }
            k = 0;
            while (k < sl) {
                if (name[sl + 2 + k] != sname[k]) { return false; }
                k = k + 1;
            }
        }
        return true;
    }

    // --- module unit lifetime ----------------------------------------------

    long read_unit(ModuleUnit* mu, const char* path) {
        unsafe {
            mu->read_module(path);
            return mu->ok;
        }
        return 0;
    }

    void release_unit(ModuleUnit* mu) {
        unsafe {
            mu->release();
        }
    }

    // --- pre-scan: predeclare the imported type names ----------------------

    void predeclare(ModuleUnit* mu) {
        unsafe {
            long i = 0;
            while (i < mu->nstructs) {
                this.pa.register_type_name(mu->structs[i].name);
                i = i + 1;
            }
            i = 0;
            while (i < mu->nenums) {
                this.pa.register_type_name(mu->enums[i].name);
                i = i + 1;
            }
            i = 0;
            while (i < mu->nusings) {
                this.pa.register_type_name(mu->usings[i].name);
                i = i + 1;
            }
        }
    }

    // --- post-parse merge --------------------------------------------------

    long find_struct_upto(const char* name, long upto) {
        long i = 0;
        while (i < upto) {
            AStruct s = this.pa.get_struct(i);
            if (this.seq(s.name, name)) { return i; }
            i = i + 1;
        }
        return -1;
    }

    bool has_struct(const char* name) {
        return this.find_struct_upto(name, this.pa.struct_count()) >= 0;
    }

    bool has_enum(const char* name) {
        long i = 0;
        while (i < this.pa.enum_count()) {
            AEnum e = this.pa.get_enum(i);
            if (this.seq(e.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool has_alias(const char* name) {
        long i = 0;
        while (i < this.pa.alias_count()) {
            AAlias a = this.pa.get_alias(i);
            if (this.seq(a.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool has_concept(const char* name) {
        long i = 0;
        while (i < this.pa.concept_count()) {
            AConcept c = this.pa.get_concept(i);
            if (this.seq(c.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool has_fn(const char* name) {
        long i = 0;
        while (i < this.pa.fn_count()) {
            AFunction f = this.pa.get_fn(i);
            if (this.seq(f.name, name)) { return true; }
            i = i + 1;
        }
        return false;
    }

    void push_params(ModParam* params, long nparams) {
        unsafe {
            long k = 0;
            while (k < nparams) {
                ModParam mp = params[k];
                AParam ap;
                ap.type = mp.type;
                ap.name = mp.name;
                ap.attrs = (AAttr*)0;
                ap.nattrs = 0;
                ap.line = 0;
                ap.col = 0;
                ap.default_value = -1;
                ap.lt_names.items = (ALifetime*)0;
                ap.lt_names.n = 0;
                ap.legacy_lts.items = (ALegacyLifetime*)0;
                ap.legacy_lts.n = 0;
                this.pa.push_param(ap);
                k = k + 1;
            }
        }
    }

    // A declaration record shared by free functions and methods: every field
    // that the `.ivm` interface does not carry is cleared.
    AFunction blank_fn(AType ret, const char* name, AParam* params,
                       long nparams, long is_extern_c) {
        AFunction f;
        unsafe {
            f.attrs = (AAttr*)0;
            f.lt_names.items = (ALifetime*)0;
            f.ret_lts.items = (ALifetime*)0;
            f.legacy_lts.items = (ALegacyLifetime*)0;
            f.tpl_params = (ATemplateParam*)0;
        }
        f.nattrs = 0;
        f.ret = ret;
        f.name = name;
        f.params = params;
        f.nparams = nparams;
        f.is_extern_c = is_extern_c;
        f.body = -1;
        f.line = 0;
        f.col = 0;
        f.is_constexpr = 0;
        f.is_consteval = 0;
        f.is_virtual = 0;
        f.tpl_n = 0;
        f.lt_names.n = 0;
        f.ret_lts.n = 0;
        f.legacy_lts.n = 0;
        f.is_variadic = 0;
        f.minit_start = 0;
        f.minit_n = 0;
        f.is_override = 0;
        f.is_pure_virtual = 0;
        return f;
    }

    void merge_unit(ModuleUnit* mu) {
        unsafe {
            long i = 0;
            while (i < mu->nfuncs) {
                ModFunc mf = mu->funcs[i];
                long pstart = this.pa.param_count();
                this.push_params(mf.params, mf.nparams);
                AFunction f = this.blank_fn(mf.ret, mf.name,
                                            this.pa.param_at(pstart),
                                            mf.nparams, mf.is_extern_c);
                f.is_constexpr = mf.is_constexpr;
                f.is_consteval = mf.is_consteval;
                this.pa.push_fn(f);
                this.pa.mark_fn_exported(this.pa.fn_count() - 1);
                i = i + 1;
            }

            i = 0;
            while (i < mu->nstructs) {
                ModStruct ms = mu->structs[i];
                if (!this.has_struct(ms.name)) {
                    AStruct s;
                    long fstart = this.pa.field_count();
                    long k = 0;
                    while (k < ms.nfields) {
                        AField fld = ms.fields[k];
                        this.pa.push_field(fld);
                        k = k + 1;
                    }
                    s.name = ms.name;
                    s.is_class = ms.is_class;
                    s.fields = this.pa.field_at(fstart);
                    s.nfields = this.pa.field_count() - fstart;

                    long mstart = this.pa.method_count();
                    k = 0;
                    while (k < ms.nmethods) {
                        ModMethod mm = ms.methods[k];
                        long pstart = this.pa.param_count();
                        this.push_params(mm.params, mm.nparams);
                        AFunction m = this.blank_fn(mm.ret, mm.name,
                                                    this.pa.param_at(pstart),
                                                    mm.nparams, 0);
                        this.pa.push_method(m);
                        k = k + 1;
                    }
                    s.methods = this.pa.method_at(mstart);
                    s.nmethods = this.pa.method_count() - mstart;

                    long bstart = this.pa.base_count();
                    k = 0;
                    while (k < ms.nbases) {
                        AType bt = ms.bases[k];
                        this.pa.push_base(bt.base);
                        k = k + 1;
                    }
                    s.bstart = bstart;
                    s.nbases = this.pa.base_count() - bstart;

                    long tstart = this.pa.tpl_count();
                    k = 0;
                    while (k < ms.ntpl) {
                        ATemplateParam tp = ms.tpl[k];
                        this.pa.push_template_param(tp);
                        k = k + 1;
                    }
                    s.tpl_params = this.pa.tpl_param_at(tstart);
                    s.tpl_n = this.pa.tpl_count() - tstart;
                    s.line = 0;
                    s.col = 0;
                    this.pa.push_struct(s);
                    this.pa.mark_struct_exported(this.pa.struct_count() - 1);
                }
                i = i + 1;
            }

            i = 0;
            while (i < mu->nenums) {
                ModEnum me = mu->enums[i];
                if (!this.has_enum(me.name)) {
                    AEnum e;
                    long estart = this.pa.enumerator_count();
                    long k = 0;
                    while (k < me.nens) {
                        AEnumerator en = me.ens[k];
                        this.pa.push_enumerator(en);
                        k = k + 1;
                    }
                    e.name = me.name;
                    e.is_scoped = me.is_scoped;
                    e.underlying = me.underlying;
                    e.enumerators = this.pa.enumerator_at(estart);
                    e.nenumerators = this.pa.enumerator_count() - estart;
                    e.line = 0;
                    e.col = 0;
                    this.pa.push_enum(e);
                    this.pa.mark_enum_exported(this.pa.enum_count() - 1);
                }
                i = i + 1;
            }

            i = 0;
            while (i < mu->nusings) {
                ModUsing mw = mu->usings[i];
                if (!this.has_alias(mw.name)) {
                    AAlias a;
                    a.name = mw.name;
                    a.target = mw.target;
                    this.pa.push_alias(a);
                }
                i = i + 1;
            }

            i = 0;
            while (i < mu->nconcepts) {
                ModConcept mc = mu->concepts[i];
                if (!this.has_concept(mc.name)) {
                    AConcept c;
                    c.name = mc.name;
                    c.param_name = mc.param_name;
                    c.req_start = this.pa.requirement_count();
                    c.nreqs = 0;
                    c.line = 0;
                    c.col = 0;
                    long k = 0;
                    while (k < mc.nreqs) {
                        this.pa.push_requirement(
                            reinterpret_cast<const char*>(mu->reqpool[mc.req_start + k]));
                        k = k + 1;
                    }
                    c.nreqs = this.pa.requirement_count() - c.req_start;
                    this.pa.push_concept(c);
                }
                i = i + 1;
            }
        }
    }

    // --- template method body splice ---------------------------------------

    bool has_bodyless_method(AStruct s) {
        unsafe {
            long j = 0;
            while (j < s.nmethods) {
                AFunction m = s.methods[j];
                if (m.body < 0) { return true; }
                j = j + 1;
            }
        }
        return false;
    }

    // Collect the destination structs that need bodies (`tplStructs`).
    void prepare_splice() {
        unsafe {
            long n = this.pa.struct_count();
            this.tpl_ = (long*)__ivy_alloc((n + 8) * 8);
            this.tpl_n_ = 0;
            long i = 0;
            while (i < n) {
                AStruct s = this.pa.get_struct(i);
                if (s.tpl_n > 0 && this.pa.struct_exported(i) != 0 &&
                    this.has_bodyless_method(s)) {
                    this.tpl_[this.tpl_n_] = i;
                    this.tpl_n_ = this.tpl_n_ + 1;
                }
                i = i + 1;
            }
        }
    }

    long find_tpl(const char* name) {
        unsafe {
            long i = 0;
            while (i < this.tpl_n_) {
                long si = this.tpl_[i];
                AStruct s = this.pa.get_struct(si);
                if (this.seq(s.name, name)) { return si; }
                i = i + 1;
            }
        }
        return -1;
    }

    // Copy the `extern "C"` declarations of the just-parsed source module into
    // the main unit.  `poff[k]` is the param-pool offset of source function
    // `main_fn + k`; the records are still readable after `end_module_source`
    // rolled the counts back.
    void splice_extern_c(long main_fn, long src_fn_end, long* poff) {
        unsafe {
            long i = main_fn;
            while (i < src_fn_end) {
                AFunction sf = this.pa.raw_fn(i);
                if (sf.is_extern_c != 0 && !this.has_fn(sf.name)) {
                    long pstart = this.pa.param_count();
                    long base = poff[i - main_fn];
                    long k = 0;
                    while (k < sf.nparams) {
                        AParam p = this.pa.raw_param(base + k);
                        this.pa.push_param(p);
                        k = k + 1;
                    }
                    AFunction d = this.blank_fn(sf.ret, sf.name,
                                                this.pa.param_at(pstart),
                                                sf.nparams, 1);
                    d.line = sf.line;
                    d.col = sf.col;
                    d.is_variadic = sf.is_variadic;
                    this.pa.push_fn(d);
                }
                i = i + 1;
            }
        }
    }

    // Parse one module source into the main parser's pools and splice its
    // method bodies.  The declaration pools are rolled back afterwards; the
    // expression / statement / member-init pools stay, so a spliced body is a
    // plain pool index (the oracle deep-clones the AST instead).
    void splice_module(char* src_path) {
        unsafe {
            char* text = io::read_file(src_path);
            if (text == (char*)0) { return; }
            long len = (long)__ivy_strlen(text);

            Lexer slx;
            slx.setup(text, len, src_path);
            slx.lex_all(len + 16);
            long in_n = slx.token_count();
            long out_cap = in_n * 8 + 256;
            Preprocessor spp;
            spp.setup(slx.tokens(), in_n, text, len, src_path,
                      (long)__ivy_strlen(src_path), out_cap, 1024);
            spp.run();

            long main_st = this.pa.struct_count();
            long main_fn = this.pa.fn_count();
            this.pa.begin_module_source(spp.output(), spp.output_count(),
                                        spp.arena());
            this.pa.set_cnumber(spp.cnumber_enabled());
            this.pa.parse();
            long src_st_end = this.pa.struct_count();
            long src_fn_end = this.pa.fn_count();

            long nsf = src_fn_end - main_fn;
            long* poff = (long*)__ivy_alloc((nsf + 8) * 8);
            long fi = main_fn;
            while (fi < src_fn_end) {
                AFunction sf = this.pa.get_fn(fi);
                poff[fi - main_fn] = this.pa.param_offset(sf.params);
                fi = fi + 1;
            }

            // Splice the method bodies of the imported template structs.
            long si = main_st;
            while (si < src_st_end) {
                AStruct src_s = this.pa.get_struct(si);
                long di = this.find_tpl(src_s.name);
                if (di >= 0) {
                    AStruct dst = this.pa.get_struct(di);
                    long mj = 0;
                    while (mj < dst.nmethods) {
                        AFunction dm = dst.methods[mj];
                        if (dm.body < 0) {
                            long sk = 0;
                            while (sk < src_s.nmethods) {
                                AFunction sm = src_s.methods[sk];
                                if (sm.body >= 0 && this.method_match(dm, sm)) {
                                    long ms = 0;
                                    long mn = 0;
                                    if (this.is_ctor(sm.name, src_s.name)) {
                                        ms = sm.minit_start;
                                        mn = sm.minit_n;
                                    }
                                    this.pa.set_method_body(di, mj, sm.body, ms, mn);
                                    sk = src_s.nmethods;
                                } else {
                                    sk = sk + 1;
                                }
                            }
                        }
                        mj = mj + 1;
                    }
                }
                si = si + 1;
            }

            long src_failed = this.pa.end_module_source();
            if (src_failed == 0) {
                this.splice_extern_c(main_fn, src_fn_end, poff);
            }
            __ivy_free(poff);
            spp.release();
            slx.release();
            __ivy_free(text);
        }
    }

    void splice_all() {
        this.prepare_splice();
        if (this.tpl_n_ > 0) {
            unsafe {
                ImportRec* r = this.im.head;
                while (r != (ImportRec*)0) {
                    char* sp = this.im.resolve_source(r->name, (CliPath*)0);
                    if (sp != (char*)0) {
                        this.splice_module(sp);
                        __ivy_free(sp);
                    }
                    r = r->next;
                }
            }
        }
        unsafe {
            __ivy_free(this.tpl_);
            this.tpl_ = (long*)0;
            this.tpl_n_ = 0;
        }
    }

    // --- module interface output -------------------------------------------

    char* parent_path(const char* p) {
        unsafe {
            long n = this.slen(p);
            long i = n - 1;
            while (i >= 0) {
                if (p[i] == 92 || p[i] == 47) { break; }
                i = i - 1;
            }
            if (i < 0) {
                char* e = (char*)__ivy_alloc(1);
                e[0] = 0;
                return e;
            }
            char* r = (char*)__ivy_alloc(i + 1);
            long k = 0;
            while (k < i) { r[k] = p[k]; k = k + 1; }
            r[i] = 0;
            return r;
        }
        unsafe { return (char*)0; }
    }

    // H8.1: `std::filesystem::path::has_extension()` on the `-o` value:
    // true when the file name has a dot that is not its first character.
    bool out_has_ext(const char* p) {
        unsafe {
            long n = this.slen(p);
            long sep = -1;
            long i = 0;
            while (i < n) {
                if (p[i] == 92 || p[i] == 47) { sep = i; }
                i = i + 1;
            }
            long start = sep + 1;
            i = n;
            while (i > start) {
                i = i - 1;
                if (p[i] == 46) { return i != start; }
            }
            return false;
        }
        return false;
    }

    // `std::filesystem::path::replace_extension(ext)` on `p`: drop the final
    // extension when the file name has one, then append `ext`.
    char* replace_ext(const char* p, const char* ext) {
        unsafe {
            long n = this.slen(p);
            long end = n;
            if (this.out_has_ext(p)) {
                long i = n;
                while (i > 0) {
                    i = i - 1;
                    if (p[i] == 46) { end = i; break; }
                }
            }
            char* r = (char*) __ivy_alloc(n + 8);
            long o = 0;
            long k = 0;
            while (k < end) {
                r[o] = p[k];
                o = o + 1;
                k = k + 1;
            }
            k = 0;
            while (ext[k] != 0) {
                r[o] = ext[k];
                o = o + 1;
                k = k + 1;
            }
            r[o] = 0;
            return r;
        }
        unsafe { return (char*)0; }
    }

    // `<out_dir>/<out_stem>.ivm` when `-o` has an extension, `<out>.ivm`
    // otherwise (`ivmOut.replace_extension(".ivm")`).
    char* ivm_from_out(const char* p) {
        unsafe {
            char* r = this.replace_ext(p, ".ivm");
            return r;
        }
        unsafe { return (char*)0; }
    }

    // H8.1: the number of resolved imports (the oracle's
    // `importedModules.size()`); the driver walks them to find module objects.
    long import_count() {
        return this.im.count;
    }

    // H8.1: the `.obj` path of import `i` when that file exists (D1 module
    // objects, main.cpp:969-982 / 1003-1016). Returns an owned string or NULL.
    char* module_object(long i) {
        unsafe {
            ImportRec* r = this.im.head;
            long k = 0;
            while (r != (ImportRec*)0 && k < i) {
                r = r->next;
                k = k + 1;
            }
            if (r == (ImportRec*)0) { return (char*)0; }
            char* obj = this.replace_ext(r->path, ".obj");
            if (!this.im.exists(obj)) {
                __ivy_free(obj);
                return (char*)0;
            }
            return obj;
        }
        unsafe { return (char*)0; }
    }

    // --- H9.8: `import cpp` / `import c` headers ----------------------------

    // `std::filesystem::path::parent_path()` as Windows spells it: drop a
    // trailing separator, then cut after the last one; no separator means the
    // empty path.  A drive root keeps its separator (`C:\a` -> `C:\`).
    char* parent_dir(const char* p) {
        unsafe {
            long n = (long) __ivy_strlen(p);
            while (n > 1 && (p[n - 1] == 92 || p[n - 1] == 47)) { n = n - 1; }
            long cut = -1;
            long i = 0;
            while (i < n) {
                if (p[i] == 92 || p[i] == 47) { cut = i; }
                i = i + 1;
            }
            long keep = 0;
            if (cut > 0) {
                keep = cut;
                if (cut == 2 && p[1] == 58) { keep = 3; }
            } else if (cut == 0) {
                keep = 1;
            }
            char* r = (char*) __ivy_alloc((unsigned long long) (keep + 1));
            i = 0;
            while (i < keep) { r[i] = p[i]; i = i + 1; }
            r[keep] = 0;
            return r;
        }
        unsafe { return (char*)0; }
    }

    void add_cpp_header(const char* p) {
        unsafe {
            if (this.ncpph_ >= this.capcpph_) {
                long ncap = this.capcpph_ * 2;
                if (ncap < 4) { ncap = 4; }
                char** nb = (char**) __ivy_alloc((unsigned long long) (ncap * 8));
                long k = 0;
                while (k < this.ncpph_) {
                    nb[k] = this.cpph_[k];
                    k = k + 1;
                }
                if (this.cpph_ != (char**) 0) {
                    __ivy_free((void*) this.cpph_);
                }
                this.cpph_ = nb;
                this.capcpph_ = ncap;
            }
            char* pv = (char*) p;
            this.cpph_[this.ncpph_] = pv;
            this.ncpph_ = this.ncpph_ + 1;
        }
    }

    void add_c_header(const char* p) {
        unsafe {
            if (this.nch_ >= this.capch_) {
                long ncap = this.capch_ * 2;
                if (ncap < 4) { ncap = 4; }
                char** nb = (char**) __ivy_alloc((unsigned long long) (ncap * 8));
                long k = 0;
                while (k < this.nch_) {
                    nb[k] = this.ch_[k];
                    k = k + 1;
                }
                if (this.ch_ != (char**) 0) {
                    __ivy_free((void*) this.ch_);
                }
                this.ch_ = nb;
                this.capch_ = ncap;
            }
            char* pv = (char*) p;
            this.ch_[this.nch_] = pv;
            this.nch_ = this.nch_ + 1;
        }
    }

    // Resolve every recorded header the way `main.cpp:1207-1260` does:
    // `<source dir>/<name>` first, then each `-I` directory in order.  A name
    // that is not on disk is a system header and contributes no object.
    void collect_headers(const char* path, CliPath* dirs) {
        unsafe {
            this.ncpph_ = 0;
            this.nch_ = 0;
            char* pc = this.parent_dir(path);
            HdrRec* h = this.im.hhead;
            while (h != (HdrRec*)0) {
                char* found = (char*)0;
                char* c = this.im.join(pc, h->name, "");
                if (this.im.exists(c)) {
                    found = c;
                } else {
                    __ivy_free(c);
                }
                if (found == (char*)0) {
                    CliPath* d = dirs;
                    while (d != (CliPath*)0) {
                        char* c2 = this.im.join(d->value, h->name, "");
                        if (this.im.exists(c2)) {
                            found = c2;
                            break;
                        }
                        __ivy_free(c2);
                        d = d->next;
                    }
                }
                if (found != (char*)0) {
                    if (h->is_cpp != 0) {
                        this.add_cpp_header(found);
                    } else {
                        this.add_c_header(found);
                    }
                }
                h = h->next;
            }
            __ivy_free(pc);
        }
    }

    long cpp_header_count() {
        return this.ncpph_;
    }

    char* cpp_header(long i) {
        unsafe {
            return this.cpph_[i];
        }
        unsafe { return (char*)0; }
    }

    long c_header_count() {
        return this.nch_;
    }

    char* c_header(long i) {
        unsafe {
            return this.ch_[i];
        }
        unsafe { return (char*)0; }
    }

    // Mirror of main.cpp:1280-1301: the `.ivm` goes next to the source, or
    // next to `-o` (same stem) when an output path is given.
    void write_ivm(const char* path, const char* out_path) {
        unsafe {
            char* out = (char*)0;
            char* parent = (char*)0;
            if (out_path != (char*)0 && out_path[0] != 0) {
                out = this.ivm_from_out(out_path);
            } else {
                parent = this.parent_path(path);
                out = this.im.join(parent, this.pa.module_name(), ".ivm");
            }
            ModuleUnit w;
            w.from_parser(this.pa);
            bool ok = w.write(out);
            w.release();
            if (ok) {
                io::eprintln("ivy: module interface written to '{}'", out);
            } else {
                io::eprintln("ivy: warning: failed to write module interface '{}'", out);
            }
            __ivy_free(out);
            if (parent != (char*)0) {
                __ivy_free(parent);
            }
        }
    }

    // --- H8.1/H9.2: the frontend stages ------------------------------------
    //
    // The real driver runs these stages in the oracle's order and prints a
    // dump between them (`--ast` before the HIR build, `--hir` before the MIR
    // build, ...), so `compile()` below is just the full chain used by the
    // backends and cgdrive.

    // 1. Lexer. Diagnostics go to stderr with the quoted path, exactly like
    // `main.cpp:842-845`.
    long lex_stage(char* path, char* content, long len) {
        this.content_ = content;
        this.lx_.setup(content, len, path);
        this.lx_.lex_all(len + 16);
        if (this.lx_.had_error()) {
            this.lx_.print_diags();
            return 1;
        }
        return 0;
    }

    // 2. Preprocessor (requires a clean `lex_stage`). Prints its diagnostics
    // and returns 1 when a non-warning one was reported (`main.cpp:874-892`).
    long pp_stage(char* path, long len) {
        long pp_failed = 0;
        unsafe {
            char* fname = path;
            long in_n = this.lx_.token_count();
            long out_cap = in_n * 8 + 256;
            this.pp_.setup(this.lx_.tokens(), in_n, this.content_, len, path,
                           this.slen(path), out_cap, 1024);
            this.pp_.run();
            if (this.pp_.has_line_file() != 0) {
                fname = this.pp_.line_file();
            }
            this.fname_ = fname;
            long dc = this.pp_.diag_count();
            long di = 0;
            while (di < dc) {
                long w = this.pp_.diag_warn(di);
                if (w == 0) { pp_failed = 1; }
                io::eprint(fname);
                io::eprint(":");
                io::eprint("{}", this.pp_.diag_line(di));
                io::eprint(":");
                io::eprint("{}", this.pp_.diag_col(di));
                if (w != 0) {
                    io::eprint(": warning: ");
                } else {
                    io::eprint(": error: ");
                }
                io::eprintln("{}", this.pp_.diag_msg(di));
                di = di + 1;
            }
        }
        return pp_failed;
    }

    // 3. Import pre-scan, parser, merge, splice and the `.ivm` write
    // (`main.cpp:915-1301`). Returns 1 when a diagnostic was printed.
    long parse_stage(char* path, long len, CliPath* includes, char* out_path) {
        long result = 1;
        unsafe {
            this.pa.setup(this.pp_.output(), this.pp_.output_count(),
                          this.pp_.arena(), len);
            this.pa.set_cnumber(this.pp_.cnumber_enabled());
            this.im.init();
            this.im.scan(this.pp_.output(), this.pp_.output_count(),
                         this.pp_.arena(), includes);
            if (this.im.failed != 0) {
                return 1;
            }
            // H9.8: resolve the `import cpp` / `import c` headers (the oracle
            // does this after parsing; nothing here depends on the AST).
            this.collect_headers(path, includes);

            long nmod = this.im.count;
            ModuleUnit* mods = (ModuleUnit*) __ivy_alloc((nmod + 1) * 448);
            this.mods_ = mods;
            long nm = 0;
            long bad = 0;
            ImportRec* r = this.im.head;
            while (r != (ImportRec*)0) {
                long ok = this.read_unit(mods + nm, r->path);
                if (ok == 0) {
                    bad = 1;
                    break;
                }
                this.predeclare(mods + nm);
                nm = nm + 1;
                r = r->next;
            }
            this.nmod_ = nm;

            if (bad == 0) {
                this.pa.parse();
                if (this.pa.failed() != 0) {
                    long nd = this.pa.diag_count();
                    long k = 0;
                    while (k < nd) {
                        io::eprint(this.fname_);
                        io::eprint(":");
                        io::eprint("{}", this.pa.diag_line(k));
                        io::eprint(":");
                        io::eprint("{}", this.pa.diag_col(k));
                        io::eprintln(": error: {}", this.pa.diag_msg(k));
                        k = k + 1;
                    }
                    return 1;
                }

                long mi = 0;
                while (mi < nm) {
                    this.merge_unit(mods + mi);
                    mi = mi + 1;
                }
                this.splice_all();

                if (this.pa.module_name()[0] != 0 &&
                    this.pa.is_module_export() != 0) {
                    this.write_ivm(path, out_path);
                }
                result = 0;
            }
        }
        return result;
    }

    // 4. HIR build (`main.cpp:1305-1311`).
    long hir_stage() {
        long result = 1;
        unsafe {
            this.hb_.setup(this.pa, this.pp_.output_count());
            this.hb_.build();
            long hd = this.hb_.diag_count();
            long k = 0;
            while (k < hd) {
                io::eprint(this.fname_);
                io::eprint(":");
                io::eprint("{}", this.hb_.diag_line(k));
                io::eprint(":");
                io::eprint("{}", this.hb_.diag_col(k));
                io::eprintln(": error: {}", this.hb_.diag_msg(k));
                k = k + 1;
            }
            if (hd == 0) {
                result = 0;
            }
        }
        return result;
    }

    // 5. MIR build (`main.cpp:1315-1321`).
    long mir_stage() {
        long result = 1;
        unsafe {
            HUnit u = this.hb_.unit();
            this.mb_.setup(u);
            this.mb_.build();
            this.has_mb_ = 1;
            long md = this.mb_.diag_count();
            long k = 0;
            while (k < md) {
                io::eprint(this.fname_);
                io::eprint(":");
                io::eprint("{}", this.mb_.diag_line(k));
                io::eprint(":");
                io::eprint("{}", this.mb_.diag_col(k));
                io::eprintln(": error: {}", this.mb_.diag_msg(k));
                k = k + 1;
            }
            if (md == 0) {
                result = 0;
            }
        }
        return result;
    }

    // Runs lexer -> preprocessor -> import pre-scan -> parser -> merge ->
    // splice -> `.ivm` -> HIR -> MIR. Returns 0 on success and 1 when a
    // diagnostic was printed. The stage state stays alive until `release()`
    // so the backends can read the `MUnit` returned by `unit()`.
    long compile(char* path, char* content, long len, CliPath* includes,
                 char* out_path) {
        if (this.lex_stage(path, content, len) != 0) { return 1; }
        if (this.pp_stage(path, len) != 0) { return 1; }
        if (this.parse_stage(path, len, includes, out_path) != 0) { return 1; }
        if (this.hir_stage() != 0) { return 1; }
        if (this.mir_stage() != 0) { return 1; }
        return 0;
    }

    // --- H9.2: dumps shared with the differential drivers ------------------

    // `--lex`: the pre-preprocessor token stream (directives visible), with
    // the lexer's own eof position.
    void dump_lex() {
        TokenPrinter tp;
        tp.out = this.lx_.tokens();
        tp.n = this.lx_.token_count();
        tp.src = this.content_;
        tp.show();
    }

    // `--tokens`: the post-preprocessor token stream.
    void dump_tokens() {
        TokenPrinter tp;
        tp.out = this.pp_.output();
        tp.n = this.pp_.output_count();
        tp.src = this.pp_.arena();
        tp.show();
    }

    // `-o *.i|*.ii`: write the reconstructed preprocessed source. Returns 0
    // on success (the oracle's `std::ofstream` failure path returns 2).
    long write_preprocessed(char* out_path) {
        long rc = 1;
        unsafe {
            char* text = this.pp_.reconstruct_source();
            long n = this.slen(text);
            // The oracle writes the text through a `std::ofstream` in text
            // mode, which expands every '\n' to CRLF on Windows.
            long crlf = 0;
            long i = 0;
            while (i < n) {
                if (text[i] == 10) { crlf = crlf + 1; }
                i = i + 1;
            }
            char* out = (char*) __ivy_alloc((unsigned long long) (n + crlf) + 1);
            long o = 0;
            i = 0;
            while (i < n) {
                char c = text[i];
                if (c == 10) {
                    out[o] = 13;
                    o = o + 1;
                }
                out[o] = c;
                o = o + 1;
                i = i + 1;
            }
            out[o] = 0;
            int w = io::write_file(out_path, out, o);
            rc = (long) w;
            __ivy_free((void*) out);
            __ivy_free((void*) text);
        }
        return rc;
    }

    // `--ast`: the parser's function pool in declaration order.
    void dump_ast() {
        AstDumper d;
        d.ep = this.pa.exprs();
        d.sp = this.pa.stmts();
        d.ca = this.pa.call_args();
        d.cp = this.pa.cases();
        d.sbnm = this.pa.sbnms();
        long n = this.pa.fn_count();
        long i = 0;
        while (i < n) {
            d.emit(this.pa.get_fn(i));
            i = i + 1;
        }
    }

    // `--hir`: the HIR unit's function pool in order.
    void dump_hir() {
        HUnit u = this.hb_.unit();
        HirDumper d;
        d.fp = u.fns;
        d.ep = u.exprs;
        d.sp = u.stmts;
        d.pp = u.params;
        d.cp = u.cases;
        d.ap = u.args;
        d.ltn = u.ltnames;
        long i = 0;
        while (i < u.fn_n) {
            HFunction f;
            unsafe {
                f = d.fp[i];
            }
            d.emit(f);
            i = i + 1;
        }
    }

    // `--mir`: the MIR unit's functions in order.
    void dump_mir() {
        MUnit mu = this.unit();
        MirDumper d;
        d.mu = mu;
        d.dump_unit();
    }

    // The MIR unit built by `compile()`; valid until `release()`.
    MUnit unit() {
        return this.mb_.unit();
    }

    // The diagnostic file name for the backends (`#line` remapping or the
    // source path), mirroring the oracle's `diagFile`.
    char* diag_file() {
        return this.fname_;
    }

    // Frees everything `compile()` allocated, in the order cgdrive used:
    // MIR, HIR, module units, parser, preprocessor, lexer.
    void release() {
        unsafe {
            if (this.has_mb_ != 0) {
                this.mb_.release();
                this.has_mb_ = 0;
            }
            this.hb_.release();
            if (this.mods_ != (ModuleUnit*)0) {
                long mi = 0;
                while (mi < this.nmod_) {
                    this.release_unit(this.mods_ + mi);
                    mi = mi + 1;
                }
                __ivy_free(this.mods_);
                this.mods_ = (ModuleUnit*)0;
                this.nmod_ = 0;
            }
            this.pa.release();
            this.pp_.release();
            this.lx_.release();
        }
    }
};
