#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

struct Vec2 {
    int32 x;
    int32 y;

    Vec2 operator+(Vec2 other) {
        Vec2 r;
        r.x = this.x + other.x;
        r.y = this.y + other.y;
        return r;
    }

    int32 operator[](int32 i) {
        if (i == 0) { return this.x; }
        return this.y;
    }
};

Vec2 make() {
    Vec2 v;
    v.x = 10;
    v.y = 20;
    return v;
}

int32 main() {
    Vec2 b;
    b.x = 1;
    b.y = 2;

    // A by-value struct call used as the receiver of an operator: the call
    // result is materialized into an entry-block temporary.
    Vec2 c = make() + b;
    printf("c = (%d, %d)\n", c.x, c.y);

    // The same materialization feeds an `operator[]` receiver.
    printf("(b + c)[1] = %d\n", (b + c)[1]);
    return 0;
}
