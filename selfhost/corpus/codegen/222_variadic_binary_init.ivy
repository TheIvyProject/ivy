#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

template <typename... Args>
int sum_from(int init, Args... args) {
    return (init + ... + args);
}

int32 main() {
    printf("%d\n", sum_from(10));
    printf("%d\n", sum_from(10, 1));
    printf("%d\n", sum_from(10, 1, 2, 3));
    return 0;
}
