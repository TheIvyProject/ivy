#pragma ivy cnumber

struct Guard {
    int32 n;
    Guard(int32 v) : n(v) {}
    ~Guard() {
        this.n = 0;
    }
};

// The return expression is not a plain local: it is evaluated into a
// synthesized `__ret` temporary before the destructors run.
int32 compute() {
    Guard g(5);
    return g.n + 1;
}

int32 main() {
    return compute();
}
