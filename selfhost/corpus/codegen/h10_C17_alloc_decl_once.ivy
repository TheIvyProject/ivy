#pragma ivy cnumber

// H10.5 (C17): many `new`/`delete` sites still produce a single
// `declare ptr @__ivy_alloc(i64)` / `declare void @__ivy_free(ptr)` pair.
int32 one() {
    unsafe {
        int32* p = new int32(1);
        int32 v = *p;
        delete p;
        return v;
    }
    return 0;
}

int32 two(int32 n) {
    unsafe {
        int32* p = new int32(n);
        int32 v = *p;
        delete p;
        return v;
    }
    return 0;
}

int32 main() {
    int32 v = one() + two(2);
    io::println("{}", v);
    return 0;
}
