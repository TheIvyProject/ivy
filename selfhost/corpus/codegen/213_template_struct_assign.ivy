#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

template <typename T>
struct Box {
    T value;

    T get() { return this.value; }
};

int32 main() {
    Box<int32> a;
    a.value = 3;
    Box<int32> b;
    b = a;
    printf("a=%d b=%d\n", a.get(), b.get());
    return 0;
}
