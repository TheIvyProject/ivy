struct Pair { int64 a; int64 b; };

Pair make(int64 base) {
    Pair p;
    p.a = base;
    p.b = base + 1;
    return p;
}

int32 main() {
    Pair keep;
    keep.a = 100;
    keep.b = 200;
    Pair pad1;
    pad1.a = 1;
    pad1.b = 2;
    Pair pad2;
    pad2.a = 3;
    pad2.b = 4;
    Pair pad3;
    pad3.a = 5;
    pad3.b = 6;
    Pair got = make(7);
    if (keep.a != 100) { return 1; }
    if (keep.b != 200) { return 2; }
    if (pad1.a != 1) { return 3; }
    if (pad2.b != 4) { return 4; }
    if (pad3.a != 5) { return 5; }
    if (got.a != 7) { return 6; }
    if (got.b != 8) { return 7; }
    return 15;
}
