// H10.16 (I1): a CFG self-edge restarts the block at its first instruction.
//
// `nextcase here` jumps back to its own clause, so clause 1 ends with a
// self-jump: [i = i + 1; x = 10 / (i - 2); jump self].  Taking that edge loops
// forever under the fixed semantics, and no `.ivy` source produces a
// *conditional* self-edge, so the observable before/after difference cannot be
// observed from source at all.  `main` therefore never selects clause 1: this
// fixture locks the shape and proves the fix leaves ordinary execution alone.
// The terminating variant is built by hand in selfhost/mir/selfedgeprobe.ivy.
int32 loop_clause(int32 n) {
    int32 i = 0;
    int32 x = 0;
    switch (n) {
        case here: 1:
            i = i + 1;
            x = 10 / (i - 2);
            nextcase here;
        default:
            break;
    }
    return i + x;
}

int32 main() {
    io::println("loop_clause(2)={}", loop_clause(2));
    if (loop_clause(2) != 0) {
        return 1;
    }
    return 0;
}
