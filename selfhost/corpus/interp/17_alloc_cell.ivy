#pragma ivy cnumber

extern "C" void* __ivy_alloc(unsigned long long n);

int32 main() {
    int32 ok = 0;
    unsafe {
        void* raw = __ivy_alloc(4);
        int32* p = static_cast<int32*>(raw);
        if (p != nullptr && *p == 0) {
            ok = 1;
        }
    }
    if (ok == 1) {
        return 0;
    }
    return 1;
}
