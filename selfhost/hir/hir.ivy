// selfhost/hir/hir.ivy - HIR model for the self-host port (H4.1).
//
// Mirror of the parts of src/hir/hir.h needed to reproduce the `ivy --hir`
// dump: functions, params, statements and expressions. Expressions are stored
// in a flat pool; child fields are pool indices (-1 when absent). Call
// arguments are a contiguous run of expression indices in `args`.

#pragma ivy cnumber
export module hir;
import ast;

// Expression kinds (internal codes used by the port):
//   1 int  2 float  3 string  4 char  5 bool  6 nullptr  7 this  8 ident
//   9 unary  10 binary  11 ternary  12 call  13 index  14 member  15 assign
//   16 sizeof  17 alignof  18 cast  19 init-list  20 new  21 delete
export struct HExpr {
    long kind;
    long ival;          // integer literal value (1) / bool value (5)
    const char* sval;   // string/char raw, ident name, operator, member name
    long flag;          // unary isPrefix (9) | member isArrow (14)
    AType type;
    long a;             // operand / lhs / cond / base / callee
    long b;             // rhs / then / index
    long c;             // else
    long astart;        // first call-argument index in HUnit.args (-1 none)
    long an;            // call-argument count
    long line;          // source line (for diagnostics)
    long col;           // source column (for diagnostics)
    double fval;        // exact value of a float literal (2)
    // H6.2y: for a call (12), the bare method name when the call is a
    // virtual dispatch (`flag` = 1, `ival` = vtable slot); "" otherwise.
    const char* msval;
    // H10.9 (H14): for a call (12), the callee's declared return lifetime
    // (the oracle's `call.returnLifetime`, taken from the resolved target);
    // "" when the call has no target or the target declares none.
    const char* retlt;
};

// Statement kinds (mirror dumpHirStmt in src/app/main.cpp):
//   1 compound  2 decl  3 if  4 while  5 dowhile  6 for  7 return
//   8 break  9 continue  10 nextcase  11 exprstmt  12 unsafe  13 null
//   14 switch
export struct HStmt {
    long kind;
    const char* sval;   // decl name / nextcase target
    AType type;         // decl type
    long flag;
    long a;             // expr index or stmt index (kind-dependent)
    long b;             // stmt/expr index
    long c;             // expr index
    long sstart;        // first child stmt index
    long sn;            // child stmt count
    long next;          // next sibling stmt index (-1)
    long line;          // source line of the statement (G7: MIR diagnostics)
    long col;           // source column of the statement
};

// A switch case clause: `value` is an expression index or -1 for default.
// `sstart` is the index of the first statement of the clause body (the
// body is a chain of statements linked by their `next` field).
//
// `next` is the index of the next clause of the SAME switch (-1 for the
// last one).  The clauses are a linked list and not a contiguous run of the
// pool: a switch that is nested in a case body pushes its own clauses into
// the same pool.
//
// `label` is the A6 case label of `case LABEL: value:` (the empty string
// when the clause carries no label); the MIR builder resolves
// `nextcase LABEL;` with it.
//
// sizeof(HCase): value(8) + sstart(8) + next(8) + label(8) = 32 bytes.
export struct HCase {
    long value;
    long sstart;
    long next;
    const char* label;
};

// A parameter of a HIR function.  `lt` is the name of the parameter's
// lifetime (the native `$a` or the legacy `[[ivy::lt(a)]]`) and is NULL
// when the parameter carries no lifetime.  The name is owned by the
// parser (the lifetime names are interned there).  (`lifetime` is a
// keyword, so the field cannot be called that.)
export struct HParam {
    AType type;
    const char* name;
    long line;
    long col;
    long default_value;   // AST expression index of the default value (-1 none)
    const char* lt;       // the parameter's lifetime name (NULL when none)
};

// A struct/class field in HIR.  The type is already alias/template resolved,
// so the MIR and the emitter can read the layout directly.  The name is
// owned by the parser.
export struct HField {
    const char* name;
    AType type;
};

// A struct/class definition in HIR.  `fields` points into the contiguous
// `HUnit.fields` pool.  Struct templates and duplicate declarations are not
// recorded (the oracle drops them in HirBuilder::buildStructs).
export struct HStruct {
    const char* name;
    HField* fields;
    long nfields;
    long line;
    long col;
    // H6.2y: the struct is polymorphic (a vptr is laid out at offset 0) and
    // the base-class names live in the `HUnit.bnames` pool
    // (`bstart`..`bstart + nbases`).
    long is_poly;
    long nbases;
    long bstart;
};

// H6.2m: an enum definition in HIR.  Only what the codegen needs survives the
// HIR stage (the enumerator values are folded to integer literals): the name,
// the `enum class` flag and the underlying integer type.  Duplicate
// declarations are not recorded (the oracle drops them in
// HirBuilder::buildEnum).
export struct HEnum {
    const char* name;
    long is_scoped;
    AType underlying;
};

// A HIR function.  The declared lifetimes are the native `lifetime<$a, $b>`
// names first, then the legacy `[[ivy::lt_def(a, b)]]` names; they are
// stored in the `HUnit.ltnames` pool and `lt_start`/`lt_n` delimit the
// run.  `lt_start` is -1 when the function declares no lifetime at all
// (an absent declaration), which is distinct from a declaration that is
// present but carries no name (`lt_n == 0`).
export struct HFunction {
    const char* name;
    AType ret;
    long is_extern_c;
    long body;          // root HStmt index, or -1 for declaration only
    long pstart;        // first HParam index
    long pn;            // HParam count
    long is_constexpr;  // `constexpr` / `consteval` function
    // H8.2: `consteval` is distinct from `constexpr` in codegen.  H10.10
    // (H23): the flag is kept in MIR, but the emitter now emits the function
    // so an unfolded call has a definition (the oracle skipped it in the
    // declare/definition loops, codegen.cpp:2674/2695).
    long is_consteval;
    long lt_start;      // first lifetime name index (-1 when absent)
    long lt_n;          // number of declared lifetime names
    const char* return_lifetime;  // the return lifetime name (NULL when none)
    // H6.2p: the declaration's parameter list ends in `...`.
    long is_variadic;
    // H6.2y: the method is dispatched through a vtable (`is_virtual`), is a
    // pure virtual (`is_pure`), and the struct whose vtable it is an entry
    // of (`vtable_of`, "" for a non-virtual function).
    long is_virtual;
    long is_pure;
    const char* vtable_of;
};

// A whole HIR translation unit. Flat pools are owned by HirBuilder.
export struct HUnit {
    HFunction* fns;
    long fn_n;
    long fn_cap;
    HExpr* exprs;
    long ex_n;
    long ex_cap;
    HStmt* stmts;
    long st_n;
    long st_cap;
    HParam* params;
    long p_n;
    long p_cap;
    HCase* cases;
    long c_n;
    long c_cap;
    long* args;
    long a_n;
    long a_cap;
    // The declared lifetime names of every function: a contiguous run the
    // `HFunction.lt_start` / `HFunction.lt_n` fields index into.  The
    // names are stored as `(long) const char*` (the port keeps the
    // pointers of the symbol pool in a `long` array).
    long* ltnames;
    long lt_n;
    // H6.2e: the struct/class definitions of the unit (source order) and the
    // contiguous field run their `HStruct.fields` pointers index into.
    HStruct* structs;
    long struct_n;
    long struct_cap;
    HField* fields;
    long fld_n;
    long fld_cap;
    // H6.2y: the base-class names of every exported struct (the
    // `HStruct.bstart` / `HStruct.nbases` fields index into this run).
    long* bnames;
    long bn_n;
    long bn_cap;
    // H6.2m: the enum definitions of the unit (source order).
    HEnum* enums;
    long enum_n;
    long enum_cap;
};

// --- H9.2: the `--hir` printer -------------------------------------------
//
// Moved verbatim from hirdrive.ivy so the real driver (app/main.ivy) and the
// differential driver share one implementation.  The fields point into the HIR
// unit's pools; the caller sets them and walks the function pool in
// declaration order (`emit` per function).
// Free functions cannot take raw-pointer parameters, so the printer is a
// struct whose fields hold them.
export struct HirDumper {
    HFunction* fp;
    HExpr* ep;
    HStmt* sp;
    HParam* pp;
    HCase* cp;
    long* ap;
    long* ltn;   // the lifetime names of the functions

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    void pad(long depth) {
        long i = 0;
        while (i < depth) {
            io::print("  ");
            i = i + 1;
        }
    }

    void dump_type(AType t) {
        if (t.is_const != 0) {
            io::print("const ");
        }
        if (t.is_unsigned != 0) {
            io::print("unsigned ");
        }
        io::print(t.base);
        long i = 0;
        while (i < t.ptr_depth) {
            io::print("*");
            i = i + 1;
        }
        if (t.is_ref != 0) {
            io::print("&");
        }
    }

    void header_plain(HExpr e, long depth, const char* kind) {
        io::print(kind);
        io::print(" : ");
        this.dump_type(e.type);
        io::println("");
    }

    void header_op(HExpr e, long depth, const char* kind, const char* op) {
        io::print(kind);
        io::print(" '");
        io::print(op);
        io::print("' : ");
        this.dump_type(e.type);
        io::println("");
    }

    // H6.2y: `virtual_call '<method>' slot=<n> : <ret>`.
    void header_vcall(HExpr e, long depth) {
        io::print("virtual_call '{}' slot={} : ", e.msval, e.ival);
        this.dump_type(e.type);
        io::println("");
    }

    void dump_expr(long idx, long depth) {
        HExpr e;
        unsafe {
            e = this.ep[idx];
        }
        this.pad(depth);
        if (e.kind == 1) {
            io::println("int {}", e.ival);
            return;
        }
        if (e.kind == 2) {
            io::println("float {}", e.sval);
            return;
        }
        if (e.kind == 3) {
            io::println("string {}", e.sval);
            return;
        }
        if (e.kind == 4) {
            io::println("char {}", e.sval);
            return;
        }
        if (e.kind == 5) {
            if (e.ival != 0) {
                io::println("bool true");
            } else {
                io::println("bool false");
            }
            return;
        }
        if (e.kind == 6) {
            io::println("nullptr");
            return;
        }
        if (e.kind == 7) {
            io::println("this");
            return;
        }
        if (e.kind == 8) {
            io::println("ident {}", e.sval);
            return;
        }
        if (e.kind == 9) {
            if (e.flag != 0) {
                this.header_op(e, depth, "prefix", e.sval);
            } else {
                this.header_op(e, depth, "postfix", e.sval);
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 10) {
            this.header_op(e, depth, "binary", e.sval);
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 11) {
            this.header_plain(e, depth, "ternary ?:");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            this.dump_expr(e.c, depth + 1);
            return;
        }
        if (e.kind == 12) {
            if (e.flag != 0) {
                this.header_vcall(e, depth);
            } else {
                this.header_op(e, depth, "call", e.sval);
            }
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.ap[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 13) {
            this.header_plain(e, depth, "index");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 14) {
            if (e.flag != 0) {
                io::println("member -> {}", e.sval);
            } else {
                io::println("member . {}", e.sval);
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 15) {
            this.header_op(e, depth, "assign", e.sval);
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 16) {
            io::println("sizeof = {}", e.ival);
            return;
        }
        if (e.kind == 17) {
            io::println("alignof = {}", e.ival);
            return;
        }
        if (e.kind == 18) {
            if (e.flag == 1) {
                io::println("reinterpret_cast");
            } else if (e.flag == 2) {
                io::println("const_cast");
            } else if (e.flag == 3) {
                io::println("C-cast");
            } else {
                io::println("static_cast");
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 19) {
            io::print("init-list : ");
            this.dump_type(e.type);
            io::print(" ({})", e.an);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.ap[e.astart + j];
                }
                if (ai >= 0) {
                    this.dump_expr(ai, depth + 1);
                } else {
                    this.pad(depth + 1);
                    io::println("<zero-init>");
                }
                j = j + 1;
            }
            return;
        }
        if (e.kind == 20) {
            io::print("new : ");
            this.dump_type(e.type);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.ap[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 21) {
            if (e.flag != 0) {
                io::println("delete[]");
            } else {
                io::println("delete");
            }
            this.dump_expr(e.a, depth + 1);
            return;
        }
    }

    void dump_compound(long idx, long depth) {
        HStmt s;
        unsafe {
            s = this.sp[idx];
        }
        this.pad(depth);
        io::println("block");
        long k = s.sstart;
        while (k >= 0) {
            this.dump_stmt(k, depth + 1);
            unsafe {
                k = this.sp[k].next;
            }
        }
    }

    void dump_stmt(long idx, long depth) {
        HStmt s;
        unsafe {
            s = this.sp[idx];
        }
        if (s.kind == 1) {
            this.dump_compound(idx, depth);
            return;
        }
        this.pad(depth);
        if (s.kind == 2) {
            io::print("decl ");
            this.dump_type(s.type);
            io::print(" {}", s.sval);
            if (s.a >= 0) {
                io::println(" =");
                this.dump_expr(s.a, depth + 1);
            } else {
                io::println("");
            }
            return;
        }
        if (s.kind == 3) {
            io::println("if");
            this.dump_expr(s.a, depth + 1);
            if (s.b >= 0) {
                this.dump_stmt(s.b, depth + 1);
            }
            if (s.c >= 0) {
                this.dump_stmt(s.c, depth + 1);
            }
            return;
        }
        if (s.kind == 4) {
            io::println("while");
            this.dump_expr(s.a, depth + 1);
            this.dump_stmt(s.b, depth + 1);
            return;
        }
        if (s.kind == 5) {
            io::println("do-while");
            this.dump_stmt(s.a, depth + 1);
            this.dump_expr(s.b, depth + 1);
            return;
        }
        if (s.kind == 6) {
            io::println("for");
            if (s.a >= 0) {
                this.dump_stmt(s.a, depth + 1);
            }
            if (s.b >= 0) {
                this.dump_expr(s.b, depth + 1);
            }
            if (s.c >= 0) {
                this.dump_expr(s.c, depth + 1);
            }
            this.dump_stmt(s.sstart, depth + 1);
            return;
        }
        if (s.kind == 7) {
            io::println("return");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            return;
        }
        if (s.kind == 8) {
            io::println("break");
            return;
        }
        if (s.kind == 9) {
            io::println("continue");
            return;
        }
        if (s.kind == 10) {
            if (this.slen(s.sval) > 0) {
                io::println("nextcase {}", s.sval);
            } else {
                io::println("nextcase");
            }
            return;
        }
        if (s.kind == 11) {
            io::println("expr");
            this.dump_expr(s.a, depth + 1);
            return;
        }
        if (s.kind == 12) {
            io::println("unsafe");
            this.dump_stmt(s.a, depth + 1);
            return;
        }
        if (s.kind == 13) {
            io::println("null");
            return;
        }
        if (s.kind == 14) {
            io::println("switch");
            if (s.a >= 0) {
                this.dump_expr(s.a, depth + 1);
            }
            // The clauses of a switch are a linked list (a switch that is
            // nested in a case body pushes its own clauses into the same
            // pool, so the pool order and the source order differ).
            long j = s.sstart;
            while (j >= 0) {
                HCase c;
                unsafe {
                    c = this.cp[j];
                }
                this.pad(depth);
                if (c.value >= 0) {
                    io::println("  case");
                    this.dump_expr(c.value, depth + 2);
                } else {
                    io::println("  default");
                }
                long k = c.sstart;
                while (k >= 0) {
                    this.dump_stmt(k, depth + 2);
                    unsafe {
                        k = this.sp[k].next;
                    }
                }
                unsafe {
                    j = c.next;
                }
            }
            return;
        }
    }

    void emit(HFunction f) {
        io::print("function {}", f.name);
        if (f.is_extern_c != 0) {
            io::print(" [extern \"C\"]");
        }
        io::println("");
        io::print("  return ");
        this.dump_type(f.ret);
        io::print("(");
        long j = 0;
        while (j < f.pn) {
            if (j > 0) {
                io::print(", ");
            }
            HParam p;
            unsafe {
                p = this.pp[f.pstart + j];
            }
            this.dump_type(p.type);
            if (this.slen(p.name) > 0) {
                io::print(" {}", p.name);
            }
            bool has_lt = false;
            unsafe {
                has_lt = p.lt != (char*)0;
            }
            if (has_lt) {
                io::print(" [lt:{}]", p.lt);
            }
            j = j + 1;
        }
        io::println(")");
        // The declared lifetimes of the function (the native names first,
        // then the legacy ones).  The line is printed only when the
        // function declares at least one lifetime.
        if (f.lt_n > 0) {
            io::print("  lifetimes:");
            long k = 0;
            while (k < f.lt_n) {
                unsafe {
                    const char* nm = (char*)this.ltn[f.lt_start + k];
                    io::print(" {}", nm);
                }
                k = k + 1;
            }
            io::println("");
        }
        bool has_ret_lt = false;
        unsafe {
            has_ret_lt = f.return_lifetime != (char*)0;
        }
        if (has_ret_lt) {
            io::println("  return lifetime: {}", f.return_lifetime);
        }
        if (f.body >= 0) {
            this.dump_compound(f.body, 1);
        } else {
            io::println("  (declaration only)");
        }
        io::println("");
    }
};
