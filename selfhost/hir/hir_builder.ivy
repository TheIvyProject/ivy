    // Append a decimal integer to the message scratch buffer.
    void db_put_num(long v) {
        long x = v;
        if (x < 0) {
            this.db_put_char('-');
            x = -x;
        }
        if (x == 0) {
            this.db_put_char('0');
            return;
        }
        long start = this.db_n_;
        while (x > 0) {
            this.db_put_char(48 + (x % 10));
            x = x / 10;
        }
        long i = this.db_n_ - 1;
        long j = start;
        while (i > j) {
            unsafe {
                char t = this.dbuf_[i];
                this.dbuf_[i] = this.dbuf_[j];
                this.dbuf_[j] = t;
            }
            i = i - 1;
            j = j + 1;
        }
    }

    // requireUnsafe in hir_builder.cpp: report `what` when not inside an
    // `unsafe` block.
    void require_unsafe(long line, long col, const char* what) {
        if (this.unsafe_depth_ == 0) {
            this.db_start_ = this.db_n_;
            this.db_put(what);
            this.db_put(" requires an unsafe block");
            this.diag(line, col, this.db_end());
        }
    }

