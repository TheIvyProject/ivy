// selfhost/hir/hir_builder.ivy - HIR builder for the self-host port (H4.1).
//
// Name-resolution subset of src/hir/hir_builder.cpp: signatures, local
// scopes, shadowing, enum constants (folded to integer literals), struct
// fields, methods/`this`, calls, and the name-related diagnostics. Types are
// propagated just far enough to reproduce the `ivy --hir` dump.

#pragma ivy cnumber
export module hir_builder;
import ast;
import parser;
import hir;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" void  __ivy_memcpy(void* dst, const void* src, unsigned long long n);

export struct HirBuilder {
    Parser pa;
    HUnit u;
    AExpr* ep_;
    AStmt* sp_;

    // variable scopes: flat symbol stack + scope start markers
    long* snm_;          // (long) const char* names
    AType* sty_;
    long* scope_;
    long s_n_;
    long s_cap_;
    long sc_n_;
    long sc_cap_;

    // Move-state tracking (A4 in hir_builder.cpp): the move state of every
    // symbol, parallel to `snm_` / `sty_`.  0 = Initialized, 1 = MovedOut.
    // The state belongs to the *binding*, not to the name: a shadowing
    // declaration has its own state.
    long* smv_;
    // The assignment left-hand side bypass flag (the oracle's
    // `inAssignLhs_`): while it is set the use-after-move check is
    // disabled for every identifier of the left-hand side expression.
    long in_assign_lhs_;

    // unscoped enum constants
    long* ecnm_;
    long* ecval_;
    long ec_n_;
    long ec_cap_;

    // struct layout (size / alignment / polymorphism) per struct index
    long* ssize_;
    long* salign_;
    long* spoly_;

    // compile-time constant evaluation state (evalConstExpr in
    // hir_builder.cpp): the last evaluated constant value
    long cst_is_int_;
    long cst_i_;
    double cst_f_;

    // the parameters bound to the arguments of the constexpr call that is
    // currently being folded
    long* cst_bname_;
    long* cst_bint_;
    long* cst_bi_;
    double* cst_bf_;
    long cst_bn_;

    // The pool of rendered float texts and the scratch buffer they are
    // built in.  The pool is a list of fixed-size chunks: a chunk is never
    // reallocated (a folded literal keeps the pointer to its text), so a
    // full chunk is not reused but a new one is added.
    char** fchunks_;
    long fchunk_n_;
    long fchunk_cap_;
    char* fcur_;
    long fcur_n_;
    long fchunk_size_;
    long fok_;            // 1 when the current chunk is usable
    char* fbuf_;
    long fbuf_cap_;

    // all enumerator values (parallel to parser enumerator pool order)
    long* evnm_;
    long* evval_;
    long* evstart_;      // first ev index for each enum
    long* evend_;        // one past the last ev index for each enum
    long ev_n_;
    long ev_cap_;

    // enumerator value evaluation (buildEnum in hir_builder.cpp)
    long enum_val_;          // value of the last evaluated constant expression
    long enum_found_;        // 1 when the last constant lookup succeeded
    long enum_missing_;      // 1 when an undefined constant was referenced
    const char* enum_missing_name_;

    // expected<T, E> / optional<T> field types (B5 / B6 in
    // hir_builder.cpp); filled in by is_expected_struct / is_optional_struct.
    AType expected_t_;
    AType expected_e_;
    AType optional_t_;

    // the struct that declares a matched `operator<op>` method and the
    // qualified name of that method
    const char* op_owner_;
    const char* op_name_;

    // diagnostics
    long* dline_;
    long* dcol_;
    long* dmsg_;
    long dn_;
    long dcap_;
    long failed_;

    // message scratch buffer
    char* dbuf_;
    long db_n_;
    long db_cap_;
    long db_start_;

    long cur_fn_;
    AType cur_ret_;
    long eval_hit_;
    const char* tmp_;
    long* abuf_;
    long ab_n_;
    long ab_cap_;
    long unsafe_depth_;   // nesting depth of `unsafe` blocks
    long has_return_;     // current function body contains a `return`
    AField found_field_;  // last field matched by lookup_field
    const char* base_name_;  // scratch: current base-class name
    long* ovl_;           // scratch: overload candidate indices
    long ovl_cap_;

    // --- template instantiation (H4.4) ---
    //
    // The function-template registry: the AST function index of every
    // template, with its name.  A second template with the same name
    // replaces the first one (the oracle keys `templates_` by name).
    long* tpl_ast_;
    long* tpl_name_;
    long tpl_n_;
    long tpl_cap_;

    // The instantiated specializations: the mangled name and the HIR
    // function index of every specialization built so far.  A second use
    // of a specialization reuses the entry (the oracle's `instantiated_`).
    long* inst_name_;
    long* inst_idx_;
    long inst_n_;
    long inst_cap_;

    // The template-parameter mapping of the specialization that is being
    // built: the parameter name and the concrete type it maps to.
    long* map_name_;
    AType* map_type_;
    long map_n_;
    long map_cap_;

    // Stable storage for the strings that must outlive their scratch
    // buffer: the mangled names, the synthesized pack parameter names and
    // the diagnostic messages.  Every allocation is remembered so that it
    // can be freed in `release`.
    long* strs_;
    long strs_n_;
    long strs_cap_;

    // The scratch buffer the mangled names are built in.
    char* sb_;
    long sb_n_;
    long sb_cap_;

    // The pool of substituted template-argument lists.  It is a list of
    // fixed-size chunks: a chunk is never reallocated (a substituted type
    // keeps the pointer to its argument list), so a full chunk is not
    // reused but a new one is added.
    long* tpchunks_;
    long tpchunk_n_;
    long tpblk_cap_;
    AType* tpcur_;
    long tpcur_n_;
    long tpchunk_size_;
    long tpok_;
    long* tpbig_;
    long tpbig_n_;
    long tpbig_cap_;

    // The pack of the specialization whose body is being built.  A frame
    // is a run of four longs in `packdata_`:
    //   0: the template parameter name (a pointer)
    //   1: the function parameter name (a pointer)
    //   2: the number of elements
    //   3: the index of the first element in the function's parameters
    // The frames form a stack: a nested instantiation pushes its own
    // frame and pops it when its body has been built.
    long* packdata_;
    long packdata_n_;
    long packdata_cap_;
    long packframe_;
    long pack_first_;

    // --- class/struct template instantiation (H4.4) ---
    //
    // The struct-template registry: the AST struct index of every struct
    // template, with its name.  A second template with the same name
    // replaces the first one (the oracle keys `structTemplates_` by name).
    long* stpl_ast_;
    long* stpl_name_;
    long stpl_n_;
    long stpl_cap_;

    // The struct specializations: the mangled name and the synthetic
    // struct record (with the substituted fields) of every specialization
    // built so far.  A second use of a specialization reuses the entry
    // (the oracle's `instantiatedStructs_`).  The layout of a
    // specialization is kept in `spc_size_` / `spc_align_` / `spc_poly_`.
    long* spc_name_;
    AStruct* spc_rec_;
    long spc_n_;
    long spc_cap_;
    long* spc_size_;
    long* spc_align_;
    long* spc_poly_;

    // The field arrays of the specializations.  Every array is allocated
    // separately and remembered here so that it can be freed in `release`.
    long* spcfld_;
    long spcfld_n_;
    long spcfld_cap_;

    // The stack of the HIR function indices of the methods of a struct
    // specialization: the signatures of all the methods are built first,
    // their bodies afterwards.
    long* spcfns_;
    long spcfns_n_;
    long spcfns_cap_;

    // The base index in `map_` of the type mapping that is currently
    // active (the oracle's `currentTypeMapping_`).  It is set while a
    // struct template is instantiated and restored afterwards; -1 when
    // there is no active mapping.
    long gmap_base_;

    // --- lifetime lowering (H4.5) ---
    //
    // The declared lifetime names of every function: a contiguous pool the
    // `HFunction.lt_start` / `HFunction.lt_n` fields index into.  The
    // names themselves are owned by the parser (they are interned there),
    // so the pool only holds their addresses.
    long* ltnm_;
    long ltn_n_;
    long ltn_cap_;

    // The lifetime lowering of the function that is currently built:
    // the first index of its names in `ltnm_`, the number of names, and
    // the address of its return lifetime name (0 when it has none).
    long cur_lt_start_;
    long cur_lt_n_;
    long cur_ret_lt_;

    // The lifetime addresses of the parameters of the function that is
    // currently built (one entry per parameter).  The array is a scratch
    // buffer that every function reuses.
    long* pltn_;
    long pltn_cap_;



    void setup(Parser p, long ntoks) {
        unsafe {
            this.pa = p;
            this.ep_ = p.exprs();
            this.sp_ = p.stmts();
            this.u.fn_cap = ntoks + 64;
            this.u.fns = (HFunction*) __ivy_alloc(this.u.fn_cap * 120);
            this.u.fn_n = 0;
            this.u.ex_cap = ntoks * 8 + 256;
            this.u.exprs = (HExpr*) __ivy_alloc(this.u.ex_cap * 144);
            this.u.ex_n = 0;
            this.u.st_cap = ntoks * 3 + 128;
            this.u.stmts = (HStmt*) __ivy_alloc(this.u.st_cap * 120);
            this.u.st_n = 0;
            this.u.p_cap = ntoks * 2 + 64;
            this.u.params = (HParam*) __ivy_alloc(this.u.p_cap * 88);
            this.u.p_n = 0;
            this.u.c_cap = ntoks + 16;
            this.u.cases = (HCase*) __ivy_alloc(this.u.c_cap * 24);
            this.u.c_n = 0;
            this.u.a_cap = ntoks * 4 + 64;
            this.u.args = (long*) __ivy_alloc(this.u.a_cap * 8);
            this.u.a_n = 0;

            this.s_cap_ = ntoks * 4 + 64;
            this.snm_ = (long*) __ivy_alloc(this.s_cap_ * 8);
            this.sty_ = (AType*) __ivy_alloc(this.s_cap_ * 48);
            this.smv_ = (long*) __ivy_alloc(this.s_cap_ * 8);
            this.s_n_ = 0;
            this.sc_cap_ = ntoks + 64;
            this.scope_ = (long*) __ivy_alloc(this.sc_cap_ * 8);
            this.sc_n_ = 0;

            this.ec_cap_ = ntoks * 2 + 64;
            this.ecnm_ = (long*) __ivy_alloc(this.ec_cap_ * 8);
            this.ecval_ = (long*) __ivy_alloc(this.ec_cap_ * 8);
            this.ec_n_ = 0;

            long nstructs = this.pa.struct_count();
            this.ssize_ = (long*) __ivy_alloc((nstructs + 1) * 8);
            this.salign_ = (long*) __ivy_alloc((nstructs + 1) * 8);
            this.spoly_ = (long*) __ivy_alloc((nstructs + 1) * 8);
            // The allocator does not zero its memory: initialise the layout
            // tables so that a struct without a computed layout never reads
            // an undefined size or alignment.
            long li = 0;
            while (li <= nstructs) {
                unsafe {
                    this.ssize_[li] = 0;
                    this.salign_[li] = 0;
                    this.spoly_[li] = 0;
                }
                li = li + 1;
            }

            this.cst_bname_ = (long*) __ivy_alloc((ntoks + 16) * 8);
            this.cst_bint_ = (long*) __ivy_alloc((ntoks + 16) * 8);
            this.cst_bi_ = (long*) __ivy_alloc((ntoks + 16) * 8);
            this.cst_bf_ = (double*) __ivy_alloc((ntoks + 16) * 8);
            this.cst_bn_ = 0;

            this.fchunk_size_ = 4096;
            this.fchunk_cap_ = 16;
            this.fchunks_ = (char**) __ivy_alloc(this.fchunk_cap_ * 8);
            this.fchunk_n_ = 0;
            this.fcur_ = (char*)0;
            this.fcur_n_ = 0;
            this.fok_ = 0;
            this.fbuf_cap_ = 64;
            this.fbuf_ = (char*) __ivy_alloc(this.fbuf_cap_);

            this.ev_cap_ = ntoks * 2 + 64;
            this.evnm_ = (long*) __ivy_alloc(this.ev_cap_ * 8);
            this.evval_ = (long*) __ivy_alloc(this.ev_cap_ * 8);
            this.ev_n_ = 0;
            this.evstart_ = (long*) __ivy_alloc((ntoks + 16) * 8);
            this.evend_ = (long*) __ivy_alloc((ntoks + 16) * 8);
            this.ab_cap_ = ntoks * 4 + 64;
            this.abuf_ = (long*) __ivy_alloc((ntoks * 4 + 64) * 8);
            this.ab_n_ = 0;

            this.dcap_ = ntoks + 64;
            this.dline_ = (long*) __ivy_alloc(this.dcap_ * 8);
            this.dcol_ = (long*) __ivy_alloc(this.dcap_ * 8);
            this.dmsg_ = (long*) __ivy_alloc(this.dcap_ * 8);
            this.dn_ = 0;
            this.failed_ = 0;

            this.db_cap_ = ntoks * 16 + 16384;
            this.dbuf_ = (char*) __ivy_alloc(this.db_cap_);
            this.db_n_ = 0;
            this.db_start_ = 0;

        this.cur_fn_ = -1;
        this.tmp_ = "";
        this.cur_ret_ = this.ty_void();
        this.eval_hit_ = 0;
        this.enum_val_ = 0;
        this.enum_found_ = 0;
        this.enum_missing_ = 0;
        this.enum_missing_name_ = "";
        this.op_owner_ = "";
        this.op_name_ = "";
            this.unsafe_depth_ = 0;
            this.has_return_ = 0;
            this.in_assign_lhs_ = 0;
            this.ovl_cap_ = ntoks + 64;
            this.ovl_ = (long*) __ivy_alloc(this.ovl_cap_ * 8);

            this.tpl_cap_ = ntoks + 16;
            this.tpl_ast_ = (long*) __ivy_alloc(this.tpl_cap_ * 8);
            this.tpl_name_ = (long*) __ivy_alloc(this.tpl_cap_ * 8);
            this.tpl_n_ = 0;

            this.inst_cap_ = ntoks + 16;
            this.inst_name_ = (long*) __ivy_alloc(this.inst_cap_ * 8);
            this.inst_idx_ = (long*) __ivy_alloc(this.inst_cap_ * 8);
            this.inst_n_ = 0;

            this.map_cap_ = ntoks + 16;
            this.map_name_ = (long*) __ivy_alloc(this.map_cap_ * 8);
            this.map_type_ = (AType*) __ivy_alloc(this.map_cap_ * 48);
            this.map_n_ = 0;

            this.strs_cap_ = ntoks + 16;
            this.strs_ = (long*) __ivy_alloc(this.strs_cap_ * 8);
            this.strs_n_ = 0;

            this.sb_cap_ = 256;
            this.sb_ = (char*) __ivy_alloc(this.sb_cap_);
            this.sb_n_ = 0;

            this.tpblk_cap_ = 16;
            this.tpchunks_ = (long*) __ivy_alloc(this.tpblk_cap_ * 8);
            this.tpchunk_n_ = 0;
            this.tpchunk_size_ = 64;
            this.tpcur_ = (AType*)0;
            this.tpcur_n_ = 0;
            this.tpok_ = 0;
            this.tpbig_cap_ = 8;
            this.tpbig_ = (long*) __ivy_alloc(this.tpbig_cap_ * 8);
            this.tpbig_n_ = 0;

            this.packdata_cap_ = ntoks * 4 + 64;
            this.packdata_ = (long*) __ivy_alloc(this.packdata_cap_ * 8);
            this.packdata_n_ = 0;
            this.packframe_ = -1;
            this.pack_first_ = 0;

            this.stpl_cap_ = ntoks + 16;
            this.stpl_ast_ = (long*) __ivy_alloc(this.stpl_cap_ * 8);
            this.stpl_name_ = (long*) __ivy_alloc(this.stpl_cap_ * 8);
            this.stpl_n_ = 0;

            this.spc_cap_ = ntoks + 16;
            this.spc_name_ = (long*) __ivy_alloc(this.spc_cap_ * 8);
            this.spc_rec_ = (AStruct*) __ivy_alloc(this.spc_cap_ * 96);
            this.spc_size_ = (long*) __ivy_alloc(this.spc_cap_ * 8);
            this.spc_align_ = (long*) __ivy_alloc(this.spc_cap_ * 8);
            this.spc_poly_ = (long*) __ivy_alloc(this.spc_cap_ * 8);
            this.spc_n_ = 0;

            this.spcfld_cap_ = ntoks + 16;
            this.spcfld_ = (long*) __ivy_alloc(this.spcfld_cap_ * 8);
            this.spcfld_n_ = 0;

            this.spcfns_cap_ = ntoks + 16;
            this.spcfns_ = (long*) __ivy_alloc(this.spcfns_cap_ * 8);
            this.spcfns_n_ = 0;

            this.gmap_base_ = -1;

            this.ltn_cap_ = ntoks + 16;
            this.ltnm_ = (long*) __ivy_alloc(this.ltn_cap_ * 8);
            this.ltn_n_ = 0;
            this.u.ltnames = this.ltnm_;
            this.u.lt_n = 0;
            this.cur_lt_start_ = -1;
            this.cur_lt_n_ = 0;
            this.cur_ret_lt_ = 0;
            this.pltn_ = (long*)0;
            this.pltn_cap_ = 0;
        }
    }

    void release() {
        unsafe {
            __ivy_free(this.u.fns);
            __ivy_free(this.u.exprs);
            __ivy_free(this.u.stmts);
            __ivy_free(this.u.params);
            __ivy_free(this.u.cases);
            __ivy_free(this.u.args);
            __ivy_free(this.snm_);
            __ivy_free(this.sty_);
            __ivy_free(this.smv_);
            __ivy_free(this.scope_);
            __ivy_free(this.ecnm_);
            __ivy_free(this.ecval_);
            __ivy_free(this.ssize_);
            __ivy_free(this.salign_);
            __ivy_free(this.spoly_);
            __ivy_free(this.cst_bname_);
            __ivy_free(this.cst_bint_);
            __ivy_free(this.cst_bi_);
            __ivy_free(this.cst_bf_);
            long fc = 0;
            while (fc < this.fchunk_n_) {
                unsafe {
                    __ivy_free(this.fchunks_[fc]);
                }
                fc = fc + 1;
            }
            __ivy_free((void*)this.fchunks_);
            __ivy_free(this.fbuf_);
            __ivy_free(this.evnm_);
            __ivy_free(this.evval_);
            __ivy_free(this.evstart_);
            __ivy_free(this.evend_);
            __ivy_free(this.abuf_);
            __ivy_free(this.dline_);
            __ivy_free(this.dcol_);
            __ivy_free((void*)this.dmsg_);
            __ivy_free(this.dbuf_);
            __ivy_free(this.ovl_);
            __ivy_free(this.tpl_ast_);
            __ivy_free((void*)this.tpl_name_);
            __ivy_free((void*)this.inst_name_);
            __ivy_free(this.inst_idx_);
            __ivy_free((void*)this.map_name_);
            __ivy_free(this.map_type_);
            long si = 0;
            while (si < this.strs_n_) {
                unsafe {
                    __ivy_free((void*)this.strs_[si]);
                }
                si = si + 1;
            }
            __ivy_free((void*)this.strs_);
            __ivy_free(this.sb_);
            long tc = 0;
            while (tc < this.tpchunk_n_) {
                unsafe {
                    __ivy_free((void*)this.tpchunks_[tc]);
                }
                tc = tc + 1;
            }
            __ivy_free((void*)this.tpchunks_);
            long tb = 0;
            while (tb < this.tpbig_n_) {
                unsafe {
                    __ivy_free((void*)this.tpbig_[tb]);
                }
                tb = tb + 1;
            }
            __ivy_free((void*)this.tpbig_);
            __ivy_free(this.packdata_);
            __ivy_free(this.stpl_ast_);
            __ivy_free((void*)this.stpl_name_);
            __ivy_free((void*)this.spc_name_);
            __ivy_free(this.spc_rec_);
            __ivy_free(this.spc_size_);
            __ivy_free(this.spc_align_);
            __ivy_free(this.spc_poly_);
            long sf = 0;
            while (sf < this.spcfld_n_) {
                unsafe {
                    __ivy_free((void*)this.spcfld_[sf]);
                }
                sf = sf + 1;
            }
            __ivy_free((void*)this.spcfld_);
            __ivy_free(this.spcfns_);
            __ivy_free((void*)this.ltnm_);
            __ivy_free((void*)this.pltn_);
        }
    }

    HUnit unit() {
        return this.u;
    }

    long diag_count() {
        return this.dn_;
    }

    long diag_line(long i) {
        unsafe {
            return this.dline_[i];
        }
        return 0;
    }

    long diag_col(long i) {
        unsafe {
            return this.dcol_[i];
        }
        return 0;
    }

    const char* diag_msg(long i) {
        unsafe {
            return (char*)this.dmsg_[i];
        }
        return "";
    }

    // --- strings / diagnostics -------------------------------------------

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    bool seq(const char* a, const char* b) {
        unsafe {
            long i = 0;
            while (a[i] != 0) {
                if (b[i] != a[i]) {
                    return false;
                }
                i = i + 1;
            }
            return b[i] == 0;
        }
        return false;
    }

    // True when `hay` contains `needle` (an empty needle is contained).
    bool has_sub(const char* hay, const char* needle) {
        long nl = this.slen(needle);
        if (nl == 0) {
            return true;
        }
        long hl = this.slen(hay);
        long i = 0;
        while (i + nl <= hl) {
            long j = 0;
            while (j < nl) {
                unsafe {
                    if (hay[i + j] != needle[j]) {
                        break;
                    }
                }
                j = j + 1;
            }
            if (j == nl) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // True when `s` starts with `prefix`.
    bool starts_with(const char* s, const char* prefix) {
        long n = this.slen(prefix);
        long i = 0;
        while (i < n) {
            unsafe {
                if (s[i] != prefix[i]) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    // True when `s` ends with `suffix`.
    bool ends_with(const char* s, const char* suffix) {
        long sn = this.slen(suffix);
        long n = this.slen(s);
        if (sn > n) {
            return false;
        }
        long i = 0;
        while (i < sn) {
            unsafe {
                if (s[n - sn + i] != suffix[i]) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    bool is_builtin_fn(const char* name) {
        return this.seq(name, "move") ||
               this.seq(name, "printf") || this.seq(name, "puts") ||
               this.seq(name, "putchar") || this.seq(name, "exit") ||
               this.seq(name, "abort") || this.seq(name, "malloc") ||
               this.seq(name, "free") ||
               this.seq(name, "ivy::print") || this.seq(name, "ivy::println") ||
               this.seq(name, "ivy::print_int") || this.seq(name, "ivy::print_float") ||
               this.seq(name, "ivy::print_str") || this.seq(name, "ivy::print_char") ||
               this.seq(name, "ivy::println_int") || this.seq(name, "ivy::println_float") ||
               this.seq(name, "ivy::println_str") || this.seq(name, "ivy::println_char") ||
               this.seq(name, "io::print") || this.seq(name, "io::println") ||
               this.seq(name, "io::eprint") || this.seq(name, "io::eprintln") ||
               this.seq(name, "io::read_line") || this.seq(name, "io::read_file") ||
               this.seq(name, "io::write_file");
    }

    AType builtin_ret(const char* name) {
        if (this.seq(name, "printf") || this.seq(name, "puts") ||
            this.seq(name, "putchar") || this.seq(name, "io::write_file")) {
            return this.ty_int();
        }
        if (this.seq(name, "io::read_line") || this.seq(name, "io::read_file")) {
            AType t = this.ty_char();
            t.ptr_depth = 1;
            return t;
        }
        return this.ty_void();
    }

    void db_put(const char* s) {
        long n = this.slen(s);
        if (this.db_n_ + n + 1 > this.db_cap_) {
            return;
        }
        unsafe {
            __ivy_memcpy(this.dbuf_ + this.db_n_, s, (unsigned long long)n);
        }
        this.db_n_ = this.db_n_ + n;
    }

    void db_put_char(char c) {
        if (this.db_n_ + 2 > this.db_cap_) {
            return;
        }
        unsafe {
            this.dbuf_[this.db_n_] = c;
        }
        this.db_n_ = this.db_n_ + 1;
    }

    // The message is built in the scratch buffer `dbuf_` and copied into a
    // stable allocation by `db_end`: the diagnostic keeps the pointer, so
    // the scratch buffer is reused for the next message.  (Keeping every
    // message in the scratch buffer would truncate it once the buffer is
    // full, and the diagnostic would show a cut-off message.)
    const char* db_end() {
        long n = this.db_n_ - this.db_start_;
        if (n < 0) {
            n = 0;
        }
        unsafe {
            char* p = (char*) __ivy_alloc((unsigned long long)(n + 1));
            if (p == (char*)0) {
                this.db_n_ = 0;
                this.db_start_ = 0;
                return "";
            }
            __ivy_memcpy((void*)p, (void*)(this.dbuf_ + this.db_start_),
                         (unsigned long long)n);
            p[n] = 0;
            this.strs_grow();
            this.strs_[this.strs_n_] = (long)p;
            this.strs_n_ = this.strs_n_ + 1;
            this.db_n_ = 0;
            this.db_start_ = 0;
            return p;
        }
        return "";
    }

    void diag(long line, long col, const char* msg) {
        if (this.dn_ >= this.dcap_) {
            return;
        }
        unsafe {
            this.dline_[this.dn_] = line;
            this.dcol_[this.dn_] = col;
            this.dmsg_[this.dn_] = (long) msg;
        }
        this.dn_ = this.dn_ + 1;
        this.failed_ = 1;
    }

    void err_undeclared(long line, long col, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put("undeclared identifier '");
        this.db_put(name);
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

