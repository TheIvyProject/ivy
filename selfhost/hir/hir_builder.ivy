    }


    // type printing for diagnostics (mirrors typeToString: no '&')
    void db_type_name(AType t) {
        if (t.is_const != 0) {
            this.db_put("const ");
        }
        if (t.is_unsigned != 0) {
            this.db_put("unsigned ");
        }
        this.db_put(t.base);
        long i = 0;
        while (i < t.ptr_depth) {
            this.db_put("*");
            i = i + 1;
        }
    }

    // --- types -----------------------------------------------------------

    AType ty_empty() {
        AType t;
        t.base = "";
        t.is_unsigned = 0;
        t.is_const = 0;
        t.is_ref = 0;
        t.ptr_depth = 0;
        t.array_size = 0;
        // The template-argument list of a type that is not a template-id.
        // The allocator does not zero its memory, so the new fields have
        // to be initialised before they are read.
        unsafe { t.tpl_args = (AType*)0; }
        t.tpl_n = 0;
        return t;
    }

    AType ty_void() {
        AType t = this.ty_empty();
        t.base = "void";
        return t;
    }

    AType ty_int() {
        AType t = this.ty_empty();
        t.base = "int";
        return t;
    }

    AType ty_double() {
        AType t = this.ty_empty();
        t.base = "double";
        return t;
    }

    AType ty_bool() {
        AType t = this.ty_empty();
        t.base = "bool";
        return t;
    }

    AType ty_char() {
        AType t = this.ty_empty();
        t.base = "char";
        return t;
    }

    AType ty_int64() {
        AType t = this.ty_empty();
        t.base = "int64_t";
        return t;
    }

    AType ty_nullptr() {
        AType t = this.ty_empty();
        t.base = "nullptr";
        return t;
    }

    // --- struct layout (8.3 in hir_builder.cpp) ---------------------------

    // Round `v` up to a multiple of the alignment `a`.
    long align_up(long v, long a) {
        if (a <= 1) {
            return v;
        }
        long r = v % a;
        if (r == 0) {
            return v;
        }
        return v + (a - r);
    }

    // typeSize in hir_builder.cpp: the byte size of a type.  Pointers and
    // references are 8 bytes; the primitive sizes follow the same table as
    // the code generator; a struct uses its computed layout.
    long type_size(AType t) {
        if (t.ptr_depth > 0 || t.is_ref != 0) {
            return 8;
        }
        if (this.seq(t.base, "bool") || this.seq(t.base, "char") ||
            this.seq(t.base, "int8_t") || this.seq(t.base, "uint8_t")) {
            return 1;
        }
        if (this.seq(t.base, "short") || this.seq(t.base, "int16_t") ||
            this.seq(t.base, "uint16_t") || this.seq(t.base, "float16_t") ||
            this.seq(t.base, "bfloat16_t")) {
            return 2;
        }
        if (this.seq(t.base, "int") || this.seq(t.base, "unsigned") ||
            this.seq(t.base, "int32_t") || this.seq(t.base, "uint32_t") ||
            this.seq(t.base, "float") || this.seq(t.base, "float32_t")) {
            return 4;
        }
        if (this.seq(t.base, "size_t") || this.seq(t.base, "ptrdiff_t") ||
            this.seq(t.base, "uptr_t")) {
            return 8;
        }
        if (this.seq(t.base, "long") || this.seq(t.base, "long long") ||
            this.seq(t.base, "int64_t") || this.seq(t.base, "uint64_t") ||
            this.seq(t.base, "double") || this.seq(t.base, "long double") ||
            this.seq(t.base, "float64_t")) {
            return 8;
        }
        if (this.seq(t.base, "float128_t") || this.seq(t.base, "int128_t") ||
            this.seq(t.base, "uint128_t")) {
            return 16;
        }
        long si = this.find_struct(t.base);
        if (si >= 0) {
            return this.struct_size(si);
        }
        if (t.array_size > 0) {
            AType elem = t;
            elem.array_size = 0;
            return this.type_size(elem) * t.array_size;
        }
        return 4;
    }

    // typeAlign in hir_builder.cpp: the alignment of a type.  A struct uses
    // its computed alignment, an array the alignment of its element type and
    // a scalar its own size.
    long type_align(AType t) {
        if (t.ptr_depth > 0 || t.is_ref != 0) {
            return 8;
        }
        long si = this.find_struct(t.base);
        if (si >= 0) {
            return this.struct_align(si);
        }
        if (t.array_size > 0) {
            AType elem = t;
            elem.array_size = 0;
            return this.type_align(elem);
        }
        return this.type_size(t);
    }

    // Compute the field layout of a struct (buildStruct in hir_builder.cpp):
    // an optional vptr, then the base subobjects, then the fields.  Every
    // component is aligned to its natural alignment and the size is rounded
    // up to the alignment of the struct.
    void layout_struct(long si) {
        AStruct sd = this.get_struct(si);
        long offset = 0;
        long align = 1;
        long poly = 0;
        long j = 0;
        while (j < sd.nmethods) {
            AFunction mf;
            unsafe {
                mf = sd.methods[j];
            }
            if (mf.is_virtual != 0) {
                poly = 1;
            }
            j = j + 1;
        }
        long k = 0;
        while (k < sd.nbases) {
            this.load_base(sd, k);
            long bi = this.find_struct(this.base_name_);
            if (bi >= 0) {
                if (this.struct_poly(bi) != 0) {
                    poly = 1;
                }
            }
            k = k + 1;
        }
        if (poly != 0) {
            offset = 8;
            align = 8;
        }
        k = 0;
        while (k < sd.nbases) {
            this.load_base(sd, k);
            long bi = this.find_struct(this.base_name_);
            if (bi >= 0) {
                long bsize = this.struct_size(bi);
                long balign = this.struct_align(bi);
                offset = this.align_up(offset, balign);
                offset = offset + bsize;
                if (balign > align) {
                    align = balign;
                }
            }
            k = k + 1;
        }
        long i = 0;
        while (i < sd.nfields) {
            AField f;
            unsafe {
                f = sd.fields[i];
            }
            AType ft = this.resolve_template_struct_type(this.resolve_alias(f.type),
                                                           f.line, f.col);
            long fsz = this.type_size(ft);
            long fal = this.type_align(ft);
            offset = this.align_up(offset, fal);
            offset = offset + fsz;
            if (fal > align) {
                align = fal;
            }
            i = i + 1;
        }
        long total = this.align_up(offset, align);
        unsafe {
            this.ssize_[si] = total;
            this.salign_[si] = align;
            this.spoly_[si] = poly;
        }
    }


    AType ty_dummy() {
        return this.ty_int();
    }

    bool is_integer_base(const char* b) {
        return this.seq(b, "bool") || this.seq(b, "char") || this.seq(b, "short") ||
               this.seq(b, "int") || this.seq(b, "long") || this.seq(b, "long long") ||
               this.seq(b, "int8_t") || this.seq(b, "int16_t") || this.seq(b, "int32_t") ||
               this.seq(b, "int64_t") || this.seq(b, "int128_t") ||
               this.seq(b, "uint8_t") || this.seq(b, "uint16_t") || this.seq(b, "uint32_t") ||
               this.seq(b, "uint64_t") || this.seq(b, "uint128_t") ||
               this.seq(b, "size_t") || this.seq(b, "ptrdiff_t") || this.seq(b, "uptr_t");
    }

    bool is_float_base(const char* b) {
        return this.seq(b, "float") || this.seq(b, "double") ||
               this.seq(b, "long double") || this.seq(b, "float16_t") ||
               this.seq(b, "float32_t") || this.seq(b, "float64_t") ||
               this.seq(b, "float128_t") || this.seq(b, "bfloat16_t");
    }

    bool is_numeric(AType t) {
        if (t.ptr_depth > 0) {
            return false;
        }
        if (this.seq(t.base, "void") || this.seq(t.base, "nullptr")) {
            return false;
        }
        return this.is_integer_base(t.base) || this.is_float_base(t.base);
    }

    long type_rank(const char* b) {
        if (this.seq(b, "bool")) { return 0; }
        if (this.seq(b, "char")) { return 1; }
        if (this.seq(b, "int8_t") || this.seq(b, "uint8_t")) { return 1; }
        if (this.seq(b, "short")) { return 2; }
        if (this.seq(b, "int16_t") || this.seq(b, "uint16_t")) { return 2; }
        if (this.seq(b, "int") || this.seq(b, "unsigned")) { return 3; }
        if (this.seq(b, "int32_t") || this.seq(b, "uint32_t")) { return 3; }
        if (this.seq(b, "long") || this.seq(b, "int64_t") || this.seq(b, "uint64_t")) { return 4; }
        if (this.seq(b, "long long")) { return 4; }
        if (this.seq(b, "size_t") || this.seq(b, "ptrdiff_t") || this.seq(b, "uptr_t")) { return 4; }
        if (this.seq(b, "float16_t") || this.seq(b, "bfloat16_t")) { return 5; }
        if (this.seq(b, "float") || this.seq(b, "float32_t")) { return 6; }
        if (this.seq(b, "double") || this.seq(b, "long double") || this.seq(b, "float64_t")) { return 7; }
        if (this.seq(b, "float128_t")) { return 8; }
        if (this.seq(b, "int128_t") || this.seq(b, "uint128_t")) { return 9; }
        return -1;
    }

    bool is_ivy_unsigned(const char* b) {
        return this.seq(b, "uint8_t") || this.seq(b, "uint16_t") ||
               this.seq(b, "uint32_t") || this.seq(b, "uint64_t") ||
               this.seq(b, "uint128_t") || this.seq(b, "size_t") ||
               this.seq(b, "uptr_t");
    }

    AType strip_ref(AType t) {
        t.is_ref = 0;
        return t;
    }

    AType resolve_alias(AType t) {
        long guard = 0;
        while (guard < 16) {
            if (this.slen(t.base) == 0) {
                return t;
            }
            // The active type mapping (the oracle's `currentTypeMapping_`):
            // inside a struct-template instantiation the template parameters
            // are replaced by their concrete types before the aliases are
            // resolved.  The qualifiers of the usage site are kept, the
            // pointer depth is added.
            if (this.gmap_base_ >= 0) {
                long mi = this.map_find(t.base, this.gmap_base_);
                if (mi >= 0) {
                    AType subst;
                    unsafe {
                        subst = this.map_type_[mi];
                    }
                    if (t.is_const != 0) { subst.is_const = 1; }
                    if (t.is_ref != 0) { subst.is_ref = 1; }
                    subst.ptr_depth = subst.ptr_depth + t.ptr_depth;
                    t = subst;
                    guard = guard + 1;
                    continue;
                }
            }
            long found = -1;
            long n = this.pa.alias_count();
            long i = 0;
            while (i < n) {
                AAlias a = this.pa.get_alias(i);
                if (this.seq(a.name, t.base)) {
                    found = i;
                    break;
                }
                i = i + 1;
            }
            if (found < 0) {
                return t;
            }
            AAlias al = this.pa.get_alias(found);
            AType exp = al.target;
            if (t.is_const != 0) { exp.is_const = 1; }
            if (t.is_ref != 0) { exp.is_ref = 1; }
            exp.ptr_depth = exp.ptr_depth + t.ptr_depth;
            t = exp;
            guard = guard + 1;
        }
        return t;
    }

    // Usual arithmetic conversions (promoteTypes in hir_builder.cpp).
    // Aliases are NOT expanded here — the oracle relies on operands
    // already carrying resolved types (declare() expands them).
    AType promote(AType aIn, AType bIn) {
        AType a = this.strip_ref(aIn);
        AType b = this.strip_ref(bIn);
        if (a.ptr_depth > 0 && b.ptr_depth > 0 && !this.seq(a.base, b.base)) { return a; }
        if (a.ptr_depth > 0 && b.ptr_depth == 0) { return a; }
        if (b.ptr_depth > 0 && a.ptr_depth == 0) { return b; }
        if (this.seq(a.base, "nullptr")) { return b; }
        if (this.seq(b.base, "nullptr")) { return a; }
        bool af = this.is_float_base(a.base);
        bool bf = this.is_float_base(b.base);
        if (af || bf) {
            if (af && bf) {
                if (this.type_rank(a.base) >= this.type_rank(b.base)) { return a; }
                return b;
            }
            if (af) { return a; }
            return b;
        }
        if (this.is_integer_base(a.base) && this.is_integer_base(b.base)) {
            long ra = this.type_rank(a.base);
            long rb = this.type_rank(b.base);
            bool au = a.is_unsigned != 0 || this.is_ivy_unsigned(a.base);
            bool bu = b.is_unsigned != 0 || this.is_ivy_unsigned(b.base);
            AType r = a;
            if (rb > ra) { r = b; }
            r.is_unsigned = 0;
            if (au || bu) { r.is_unsigned = 1; }
            return r;
        }
        return a;
    }

    // isIntegerLike in hir_builder.cpp: integer base and not a pointer.
    bool is_integer_like(AType t) {
        if (t.ptr_depth > 0) {
            return false;
        }
        return this.is_integer_base(t.base);
    }

    // True when `name` names a struct/class known to the translation unit.
    bool is_struct_name(const char* name) {
        return this.find_struct(name) >= 0;
    }

    // isExpectedStruct in hir_builder.cpp: a struct with the field layout
    // [hasValue: bool, value: T, error: E] behaves like expected<T, E>.
    // The field types are returned in `expected_t_` / `expected_e_`.
    bool is_expected_struct(AType t) {
        if (t.ptr_depth > 0) {
            return false;
        }
        long si = this.find_struct(t.base);
        if (si < 0) {
            return false;
        }
        AStruct sd = this.get_struct(si);
        if (sd.nfields != 3) {
            return false;
        }
        AField f0;
        AField f1;
        AField f2;
        unsafe {
            f0 = sd.fields[0];
            f1 = sd.fields[1];
            f2 = sd.fields[2];
        }
        if (!this.seq(f0.name, "hasValue") || !this.seq(f1.name, "value") ||
            !this.seq(f2.name, "error")) {
            return false;
        }
        this.expected_t_ = this.resolve_alias(f1.type);
        this.expected_e_ = this.resolve_alias(f2.type);
        return true;
    }

    // isOptionalStruct in hir_builder.cpp: a struct with the field layout
    // [hasValue: bool, value: T] behaves like optional<T>.  The field type
    // is returned in `optional_t_`.
    bool is_optional_struct(AType t) {
        if (t.ptr_depth > 0) {
            return false;
        }
        long si = this.find_struct(t.base);
        if (si < 0) {
            return false;
        }
        AStruct sd = this.get_struct(si);
        if (sd.nfields != 2) {
            return false;
        }
        AField f0;
        AField f1;
        unsafe {
            f0 = sd.fields[0];
            f1 = sd.fields[1];
        }
        if (!this.seq(f0.name, "hasValue") || !this.seq(f1.name, "value")) {
            return false;
        }
        this.optional_t_ = this.resolve_alias(f1.type);
        return true;
    }

    // True when `name` names an enum known to the translation unit.
    bool is_enum_name(const char* name) {
        return this.find_enum(name) >= 0;
    }

    // Load the name of base class `i` of struct `sd` into `base_name_`.
    void load_base(AStruct sd, long i) {
        unsafe {
            this.base_name_ = this.pa.base_at(sd.bstart + i);
        }
    }

    // True when `name` is a direct base class of the struct `from` (the
    // derived-to-base reference binding rule of isAssignable only looks at
    // the direct base list).
    bool derives_from(const char* from, const char* name) {
        long si = this.find_struct(from);
        if (si < 0) {
            return false;
        }
        AStruct sd = this.get_struct(si);
        long k = 0;
        while (k < sd.nbases) {
            this.load_base(sd, k);
            if (this.seq(this.base_name_, name)) {
                return true;
            }
            k = k + 1;
        }
        return false;
    }

    // isAssignable in hir_builder.cpp: can a value of type `from` be
    // stored in a location of type `to`?
    bool is_assignable(AType to, AType from) {
        if (this.seq(from.base, "nullptr")) {
            return to.ptr_depth > 0 || to.is_ref != 0;
        }
        // B5: implicit conversion T -> expected<T, E> and E -> expected<T, E>.
        if (to.ptr_depth == 0 && !this.seq(to.base, from.base)) {
            if (this.is_expected_struct(to)) {
                AType tArg = this.expected_t_;
                AType eArg = this.expected_e_;
                bool tExact = this.seq(tArg.base, from.base) &&
                              tArg.ptr_depth == from.ptr_depth;
                bool eExact = this.seq(eArg.base, from.base) &&
                              eArg.ptr_depth == from.ptr_depth;
                if (eExact && !tExact && !this.seq(eArg.base, tArg.base)) {
                    return true;
                }
                if (tExact) {
                    return true;
                }
                if (this.is_assignable(tArg, from)) {
                    return true;
                }
                if (this.is_assignable(eArg, from)) {
                    return true;
                }
            }
        }
        // B6: implicit conversion T -> optional<T>.
        if (to.ptr_depth == 0 && !this.seq(to.base, from.base)) {
            if (this.is_optional_struct(to)) {
                AType tArg = this.optional_t_;
                if (this.is_assignable(tArg, from)) {
                    return true;
                }
            }
        }
        // B6: nullopt -> optional<T> (an empty optional).
        if (this.seq(from.base, "nullopt") && to.ptr_depth == 0) {
            if (this.is_optional_struct(to)) {
                return true;
            }
        }
        if (from.is_ref != 0) {
            if (to.is_ref != 0 && this.seq(to.base, from.base) &&
                (to.is_const != 0 || from.is_const == 0) &&
                to.ptr_depth == from.ptr_depth) {
                return true;
            }
        }
        if (to.is_ref != 0) {
            if (to.ptr_depth == 0 && from.ptr_depth == 0) {
                if (this.is_numeric(to) && this.is_numeric(from)) {
                    return true;
                }
                if (this.is_struct_name(to.base) && this.seq(to.base, from.base)) {
                    return true;
                }
                if (this.is_struct_name(from.base) && this.derives_from(from.base, to.base)) {
                    return true;
                }
            }
            if (to.ptr_depth == from.ptr_depth && this.seq(to.base, from.base) &&
                (to.is_const != 0 || from.is_const == 0)) {
                return true;
            }
        }
        if (to.ptr_depth == 0 && from.ptr_depth == 0) {
            if (this.is_struct_name(to.base) && this.seq(to.base, from.base) &&
                (to.is_const == 0) == (from.is_const == 0)) {
                return true;
            }
            if (this.is_enum_name(to.base)) {
                return this.seq(to.base, from.base) || this.is_numeric(from);
            }
            if (this.is_enum_name(from.base) && this.is_numeric(to)) {
                return true;
            }
            return this.is_numeric(to) && this.is_numeric(from);
        }
        if (to.ptr_depth != from.ptr_depth) {
            return false;
        }
        if (to.ptr_depth > 0 && this.seq(to.base, "void")) {
            return true;
        }
        if (!this.seq(to.base, from.base)) {
            return false;
        }
        if (to.is_const == 0 && from.is_const != 0) {
            return false;
        }
        return true;
    }

    // --- struct/enum/function lookup -------------------------------------

    // The global struct index: the AST structs come first (0..n-1), the
    // struct-template specializations follow them (n..n+k-1).
    long find_struct(const char* name) {
        long n = this.pa.struct_count();
        long i = 0;
        while (i < n) {
            AStruct sd = this.get_struct(i);
            // A struct template is not a struct: it is instantiated on
            // demand and only its specializations enter the registry.
            if (sd.tpl_n == 0 && this.seq(sd.name, name)) {
                return i;
            }
            i = i + 1;
        }
        long k = 0;
        while (k < this.spc_n_) {
            unsafe {
                if (this.seq((char*)this.spc_name_[k], name)) {
                    return n + k;
                }
            }
            k = k + 1;
        }
        return -1;
    }

    // The struct record of the global struct index `gidx`.
    AStruct get_struct(long gidx) {
        long n = this.pa.struct_count();
        if (gidx < 0) {
            AStruct empty;
            empty.name = "";
            empty.is_class = 0;
            unsafe { empty.fields = (AField*)0; }
            empty.nfields = 0;
            unsafe { empty.methods = (AFunction*)0; }
            empty.nmethods = 0;
            empty.bstart = 0;
            empty.nbases = 0;
            empty.line = 0;
            empty.col = 0;
            unsafe { empty.tpl_params = (ATemplateParam*)0; }
            empty.tpl_n = 0;
            return empty;
        }
        if (gidx < n) {
            return this.pa.get_struct(gidx);
        }
        long k = gidx - n;
        if (k < this.spc_n_) {
            unsafe {
                return this.spc_rec_[k];
            }
        }
        AStruct empty;
        empty.name = "";
        empty.is_class = 0;
        unsafe { empty.fields = (AField*)0; }
        empty.nfields = 0;
        unsafe { empty.methods = (AFunction*)0; }
        empty.nmethods = 0;
        empty.bstart = 0;
        empty.nbases = 0;
        empty.line = 0;
        empty.col = 0;
        unsafe { empty.tpl_params = (ATemplateParam*)0; }
        empty.tpl_n = 0;
        return empty;
    }

    // The computed layout of the struct with the global index `gidx`.
    long struct_size(long gidx) {
        long n = this.pa.struct_count();
        if (gidx < n) {
            unsafe {
                return this.ssize_[gidx];
            }
        }
        long k = gidx - n;
        if (k >= 0 && k < this.spc_n_) {
            unsafe {
                return this.spc_size_[k];
            }
        }
        return 0;
    }

    long struct_align(long gidx) {
        long n = this.pa.struct_count();
        if (gidx < n) {
            unsafe {
                return this.salign_[gidx];
            }
        }
        long k = gidx - n;
        if (k >= 0 && k < this.spc_n_) {
            unsafe {
                return this.spc_align_[k];
            }
        }
        return 0;
    }

    long struct_poly(long gidx) {
        long n = this.pa.struct_count();
        if (gidx < n) {
            unsafe {
                return this.spoly_[gidx];
            }
        }
        long k = gidx - n;
        if (k >= 0 && k < this.spc_n_) {
            unsafe {
                return this.spc_poly_[k];
            }
        }
        return 0;
    }

    long find_enum(const char* name) {
        long n = this.pa.enum_count();
        long i = 0;
        while (i < n) {
            AEnum ed = this.pa.get_enum(i);
            if (this.seq(ed.name, name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // Look up a field in a struct or in any of its base classes (the
    // oracle merges inherited fields into the derived struct's field map).
    // The matching field is stored in `found_field_`.
    bool lookup_field(AStruct sd, const char* name) {
        long i = 0;
        while (i < sd.nfields) {
            AField f;
            unsafe {
                f = sd.fields[i];
            }
            if (this.seq(f.name, name)) {
                this.found_field_ = f;
                return true;
            }
            i = i + 1;
        }
        long k = 0;
        while (k < sd.nbases) {
            this.load_base(sd, k);
            long bi = this.find_struct(this.base_name_);
            if (bi >= 0) {
                AStruct bs = this.get_struct(bi);
                if (this.lookup_field(bs, name)) {
                    return true;
                }
            }
            k = k + 1;
        }
        return false;
    }

    long find_fn(const char* name) {
        long i = 0;
        while (i < this.u.fn_n) {
            HFunction f;
            unsafe {
                f = this.u.fns[i];
            }
            if (this.seq(f.name, name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // Number of HIR functions registered under `name` (overload set size).
    long count_fns(const char* name) {
        long n = 0;
        long i = 0;
        while (i < this.u.fn_n) {
            HFunction f;
            unsafe {
                f = this.u.fns[i];
            }
            if (this.seq(f.name, name)) {
                n = n + 1;
            }
            i = i + 1;
        }
        return n;
    }

    // --- scopes ----------------------------------------------------------

    void enter_scope() {
        if (this.sc_n_ >= this.sc_cap_) {
            return;
        }
        unsafe {
            this.scope_[this.sc_n_] = this.s_n_;
        }
        this.sc_n_ = this.sc_n_ + 1;
    }

    void leave_scope() {
        if (this.sc_n_ <= 0) {
            return;
        }
        this.sc_n_ = this.sc_n_ - 1;
        unsafe {
            this.s_n_ = this.scope_[this.sc_n_];
        }
    }

    long find_sym(const char* name) {
        long i = this.s_n_;
        while (i > 0) {
            i = i - 1;
            unsafe {
                const char* nm = (char*)this.snm_[i];
                if (this.seq(nm, name)) {
                    return i;
                }
            }
        }
        return -1;
    }

    AType sym_type(long i) {
        unsafe {
            return this.sty_[i];
        }
        return this.ty_dummy();
    }

    // The move state of a symbol: 0 = Initialized, 1 = MovedOut.
    long sym_moved(long i) {
        unsafe {
            return this.smv_[i];
        }
        return 0;
    }

    void set_sym_moved(long i, long moved) {
        unsafe {
            this.smv_[i] = moved;
        }
    }

    // A4 in hir_builder.cpp: mark the variable `name` as moved-out
    // (hir_builder.cpp:2941-2950).  The oracle searches the move-state
    // scopes from the inside out, so the *innermost binding* of the name is
    // marked; the flat symbol stack resolves the name the same way (the
    // innermost symbol with that name is the innermost scope that declares
    // it).  A variable that is already moved-out raises the "already
    // moved-out" diagnostic at the call's location.  A name that is not a
    // variable at all is not marked and raises no diagnostic.
    void mark_moved_out(const char* name, long line, long col) {
        long si = this.find_sym(name);
        if (si < 0) {
            return;
        }
        if (this.sym_moved(si) != 0) {
            this.err_already_moved_out(line, col, name);
        }
        this.set_sym_moved(si, 1);
    }

    // A4 in hir_builder.cpp: a plain assignment re-initializes a moved-out
    // variable (a compound assignment does not) - hir_builder.cpp:3684-3695.
    void reinitialize(const char* name) {
        long si = this.find_sym(name);
        if (si < 0) {
            return;
        }
        this.set_sym_moved(si, 0);
    }

    void declare(const char* name, AType t, long line, long col) {
        long start = 0;
        if (this.sc_n_ > 0) {
            unsafe {
                start = this.scope_[this.sc_n_ - 1];
            }
        }
        long i = start;
        while (i < this.s_n_) {
            unsafe {
                const char* nm = (char*)this.snm_[i];
                if (this.seq(nm, name)) {
                    this.err_redef(line, col, name);
                    return;
                }
            }
            i = i + 1;
        }
        t = this.resolve_alias(t);
        if (this.s_n_ < this.s_cap_) {
            unsafe {
                this.snm_[this.s_n_] = (long) name;
                this.sty_[this.s_n_] = t;
            }
            this.s_n_ = this.s_n_ + 1;
            // A4: a new variable starts in the Initialized move state.
            this.set_sym_moved(this.s_n_ - 1, 0);
        }
    }

    long find_global_enum(const char* name) {
        long i = this.ec_n_;
        while (i > 0) {
            i = i - 1;
            unsafe {
                const char* nm = (char*)this.ecnm_[i];
                if (this.seq(nm, name)) {
                    return i;
                }
            }
        }
        return -1;
    }

    long global_enum_value(long i) {
        unsafe {
            return this.ecval_[i];
        }
        return 0;
    }

    // --- HIR pool helpers ------------------------------------------------

    long push_expr(HExpr e) {
        long i = this.u.ex_n;
        if (i < this.u.ex_cap) {
            unsafe {
                this.u.exprs[i] = e;
            }
            this.u.ex_n = i + 1;
        }
        return i;
    }

    long push_stmt(HStmt s) {
        long i = this.u.st_n;
        if (i < this.u.st_cap) {
            unsafe {
                this.u.stmts[i] = s;
            }
            this.u.st_n = i + 1;
        }
        return i;
    }

    long push_arg(long e) {
        long i = this.u.a_n;
        if (i < this.u.a_cap) {
            unsafe {
                this.u.args[i] = e;
            }
            this.u.a_n = i + 1;
        }
        return i;
    }

    long push_hcase(HCase c) {
        long i = this.u.c_n;
        if (i < this.u.c_cap) {
            unsafe {
                this.u.cases[i] = c;
            }
            this.u.c_n = i + 1;
        }
        return i;
    }

    HExpr new_expr(long kind, long line, long col) {
        HExpr e;
        e.kind = kind;
        e.ival = 0;
        e.sval = "";
        e.flag = 0;
        e.type = this.ty_dummy();
        e.a = -1;
        e.b = -1;
        e.c = -1;
        e.astart = -1;
        e.an = 0;
        e.line = line;
        e.col = col;
        e.fval = 0.0;
        return e;
    }

    HStmt new_stmt(long kind, long line, long col) {
        HStmt s;
        s.kind = kind;
        s.sval = "";
        s.type = this.ty_empty();
        s.flag = 0;
        s.a = -1;
        s.b = -1;
        s.c = -1;
        s.sstart = -1;
        s.sn = 0;
        s.next = -1;
        return s;
    }

    AExpr get_expr(long i) {
        unsafe {
            return this.ep_[i];
        }
        AExpr e;
        e.kind = 6;
        e.ival = 0;
        e.sval = "";
        e.flag = 0;
        e.a = -1;
        e.b = -1;
        e.c = -1;
        e.astart = -1;
        e.an = 0;
        e.type = this.ty_empty();
        e.is_scope = 0;
        e.line = 0;
        e.col = 0;
        e.fval = 0.0;
        unsafe { e.tpl_args = (AType*)0; }
        e.tpl_n = 0;
        return e;
    }

    AStmt get_stmt(long i) {
        unsafe {
            return this.sp_[i];
        }
        AStmt s;
        s.kind = 14;
        s.sval = "";
        s.type = this.ty_empty();
        s.flag = 0;
        s.a = -1;
        s.b = -1;
        s.c = -1;
        s.sstart = -1;
        s.sn = 0;
        s.next = -1;
        s.line = 0;
        s.col = 0;
        return s;
    }

    // --- enum registration ----------------------------------------------

    // --- enumerator constant evaluation (buildEnum in hir_builder.cpp) ----

    // Look up an enumerator constant of the enum currently being built
    // (indices >= cur_start).  Sets `enum_found_`; returns the value.
    long enum_lookup_local(const char* name, long cur_start) {
        this.enum_found_ = 0;
        long i = this.ev_n_;
        while (i > cur_start) {
            i = i - 1;
            unsafe {
                const char* nm = (char*)this.evnm_[i];
                if (this.seq(nm, name)) {
                    this.enum_found_ = 1;
                    return this.evval_[i];
                }
            }
        }
        return 0;
    }

    // Look up an enumerator constant of the enum currently being built or
    // of any unscoped enum declared before it (the oracle's `def.constants`
    // and `enumConstants_` lookups).
    long enum_lookup_any(const char* name, long cur_start) {
        this.enum_found_ = 0;
        long i = this.ev_n_;
        while (i > cur_start) {
            i = i - 1;
            unsafe {
                const char* nm = (char*)this.evnm_[i];
                if (this.seq(nm, name)) {
                    this.enum_found_ = 1;
                    return this.evval_[i];
                }
            }
        }
        long k = 0;
        while (k < this.ec_n_) {
            unsafe {
                const char* nm = (char*)this.ecnm_[k];
                if (this.seq(nm, name)) {
                    this.enum_found_ = 1;
                    return this.ecval_[k];
                }
            }
            k = k + 1;
        }
        return 0;
    }

    // Evaluate a nested constant expression: integer literals, enumerator
    // constants, unary -/+/~ and the binary arithmetic/bitwise operators.
    // Returns 1 on success; the value is left in `enum_val_`.
    bool eval_enum_operand(long eidx, long cur_start) {
        AExpr e = this.get_expr(eidx);
        if (e.kind == 1) {
            this.enum_val_ = e.ival;
            return true;
        }
        if (e.kind == 8) {
            long v = this.enum_lookup_any(e.sval, cur_start);
            if (this.enum_found_ == 0) {
                return false;
            }
            this.enum_val_ = v;
            return true;
        }
        if (e.kind == 10) {
            long v = 0;
            if (this.eval_enum_operand(e.a, cur_start) == 0) {
                return false;
            }
            v = this.enum_val_;
            if (this.seq(e.sval, "-")) { this.enum_val_ = -v; return true; }
            if (this.seq(e.sval, "+")) { this.enum_val_ = v; return true; }
            if (this.seq(e.sval, "~")) { this.enum_val_ = ~v; return true; }
            return false;
        }
        if (e.kind == 11) {
            long l = 0;
            long r = 0;
            if (this.eval_enum_operand(e.a, cur_start) == 0) {
                return false;
            }
            l = this.enum_val_;
            if (this.eval_enum_operand(e.b, cur_start) == 0) {
                return false;
            }
            r = this.enum_val_;
            if (this.seq(e.sval, "+")) { this.enum_val_ = l + r; return true; }
            if (this.seq(e.sval, "-")) { this.enum_val_ = l - r; return true; }
            if (this.seq(e.sval, "*")) { this.enum_val_ = l * r; return true; }
            if (this.seq(e.sval, "/")) {
                if (r == 0) { return false; }
                this.enum_val_ = l / r;
                return true;
            }
            if (this.seq(e.sval, "%")) {
                if (r == 0) { return false; }
                this.enum_val_ = l % r;
                return true;
            }
            if (this.seq(e.sval, "|")) { this.enum_val_ = l | r; return true; }
            if (this.seq(e.sval, "&")) { this.enum_val_ = l & r; return true; }
            if (this.seq(e.sval, "^")) { this.enum_val_ = l ^ r; return true; }
            if (this.seq(e.sval, "<<")) { this.enum_val_ = l << r; return true; }
            if (this.seq(e.sval, ">>")) { this.enum_val_ = l >> r; return true; }
            return false;
        }
        return false;
    }

    // Evaluate an enumerator's explicit value.  The oracle accepts an
    // integer literal, a unary -/+ of an integer literal, a unary - of a
    // constant of the same enum, a reference to a constant of the same enum
    // and a binary constant expression.  Returns 1 when the value is a
    // constant; otherwise the matching diagnostic is reported.
    bool eval_enum_value(long eidx, long cur_start, long line, long col,
                         const char* ename) {
        this.enum_missing_ = 0;
        AExpr e = this.get_expr(eidx);
        if (e.kind == 1) {
            this.enum_val_ = e.ival;
            return true;
        }
        if (e.kind == 10) {
            AExpr o = this.get_expr(e.a);
            if (o.kind == 1) {
                if (this.seq(e.sval, "-")) { this.enum_val_ = -o.ival; return true; }
                if (this.seq(e.sval, "+")) { this.enum_val_ = o.ival; return true; }
                this.err_enum_not_const(line, col, ename);
                return false;
            }
            if (o.kind == 8 && this.seq(e.sval, "-")) {
                long v = this.enum_lookup_local(o.sval, cur_start);
                if (this.enum_found_ != 0) {
                    this.enum_val_ = -v;
                    return true;
                }
                this.err_enum_not_const(line, col, ename);
                return false;
            }
            this.err_enum_not_const(line, col, ename);
            return false;
        }
        if (e.kind == 8) {
            long v = this.enum_lookup_local(e.sval, cur_start);
            if (this.enum_found_ != 0) {
                this.enum_val_ = v;
                return true;
            }
            this.err_enum_undef_const(line, col, ename, e.sval);
            return false;
        }
        if (e.kind == 11) {
            if (this.eval_enum_operand(eidx, cur_start) == 0) {
                this.err_enum_not_const(line, col, ename);
                return false;
            }
            return true;
        }
        this.err_enum_not_const(line, col, ename);
        return false;
    }


    void build_enums() {
        long n = this.pa.enum_count();
        long ei = 0;
        while (ei < n) {
            AEnum ed = this.pa.get_enum(ei);
            unsafe {
                this.evstart_[ei] = this.ev_n_;
                this.evend_[ei] = this.ev_n_;
            }
            // Reject a duplicate enum name: the oracle skips the whole
            // declaration, so none of its enumerators are registered.
            long prev = 0;
            long dup = 0;
            while (prev < ei) {
                AEnum pe = this.pa.get_enum(prev);
                if (this.seq(pe.name, ed.name)) {
                    dup = 1;
                }
                prev = prev + 1;
            }
            if (dup != 0) {
                this.err_redef_enum(ed.line, ed.col, ed.name);
                ei = ei + 1;
                continue;
            }
            long start = this.ev_n_;
            long next = 0;
            long j = 0;
            while (j < ed.nenumerators) {
                AEnumerator en;
                unsafe {
                    en = ed.enumerators[j];
                }
                long val = next;
                if (en.value >= 0) {
                    if (this.eval_enum_value(en.value, start, en.line, en.col, en.name)) {
                        val = this.enum_val_;
                    }
                }
                // Reject a duplicate enumerator name inside the same enum:
                // the oracle keeps the first declaration and does not
                // advance the implicit value.
                long k = 0;
                long seen = 0;
                while (k < j) {
                    AEnumerator pe;
                    unsafe {
                        pe = ed.enumerators[k];
                    }
                    if (this.seq(pe.name, en.name)) {
                        seen = 1;
                    }
                    k = k + 1;
                }
                if (seen != 0) {
                    this.err_redef_enumerator(en.line, en.col, en.name);
                    j = j + 1;
                    continue;
                }
                if (this.ev_n_ < this.ev_cap_) {
                    unsafe {
                        this.evnm_[this.ev_n_] = (long) en.name;
                        this.evval_[this.ev_n_] = val;
                    }
                    this.ev_n_ = this.ev_n_ + 1;
                }
                if (ed.is_scoped == 0 && this.ec_n_ < this.ec_cap_) {
                    unsafe {
                        this.ecnm_[this.ec_n_] = (long) en.name;
                        this.ecval_[this.ec_n_] = val;
                    }
                    this.ec_n_ = this.ec_n_ + 1;
                }
                next = val + 1;
                j = j + 1;
            }
            unsafe {
                this.evend_[ei] = this.ev_n_;
            }
            ei = ei + 1;
        }
    }

    long enum_const_value(long ei, const char* name) {
        this.eval_hit_ = 0;
        long base = 0;
        long end = 0;
        unsafe {
            base = this.evstart_[ei];
            end = this.evend_[ei];
        }
        long i = base;
        while (i < end) {
            unsafe {
                const char* nm = (char*)this.evnm_[i];
                if (this.seq(nm, name)) {
                    this.eval_hit_ = 1;
                    return this.evval_[i];
                }
            }
            i = i + 1;
        }
        return 0;
    }


    // --- signatures ------------------------------------------------------

    // --- lifetime lowering (H4.5) ---
    //
    // Mirror of `lowerLifetimeAttributes` / `lowerParamAttribute` in
    // src/hir/hir_builder.cpp.
    //
    // The lifetime names are owned by the parser (they are interned
    // there), so they are passed around as their address (`long`), like
    // the names of the symbol pool.

    // Grow the lifetime-name pool.
    void ltnm_grow() {
        long ncap = this.ltn_cap_ * 2;
        unsafe {
            long* np = (long*) __ivy_alloc(ncap * 8);
            if (np != (long*)0) {
                __ivy_memcpy((void*)np, (void*)this.ltnm_,
                             (unsigned long long)(this.ltn_n_ * 8));
                __ivy_free((void*)this.ltnm_);
                this.ltnm_ = np;
                this.ltn_cap_ = ncap;
                this.u.ltnames = np;
            }
        }
    }

    // Make room for the lifetime addresses of `n` parameters.
    void pltn_reserve(long n) {
        if (n <= this.pltn_cap_) {
            return;
        }
        unsafe {
            long* np = (long*) __ivy_alloc(n * 8);
            if (np == (long*)0) {
                this.pltn_ = (long*)0;
                this.pltn_cap_ = 0;
                return;
            }
            __ivy_free((void*)this.pltn_);
            this.pltn_ = np;
            this.pltn_cap_ = n;
        }
    }

    // Append a lifetime name to the pool.
    void ltnm_push(long name) {
        if (this.ltn_n_ >= this.ltn_cap_) {
            this.ltnm_grow();
            if (this.ltn_n_ >= this.ltn_cap_) {
                return;
            }
        }
        unsafe {
            this.ltnm_[this.ltn_n_] = name;
        }
        this.ltn_n_ = this.ltn_n_ + 1;
        this.u.lt_n = this.ltn_n_;
    }

    // The address of the name of the `i`-th lifetime of an AST lifetime
    // list (0 when there is none).
    long lt_name(ALifetimeList l, long i) {
        unsafe {
            if (l.items == (ALifetime*)0 || i < 0 || i >= l.n) {
                return 0;
            }
            return (long) l.items[i].name;
        }
        return 0;
    }

    // The `i`-th legacy lifetime annotation of an AST legacy list.
    ALegacyLifetime legacy_lt(ALegacyLifetimeList l, long i) {
        ALegacyLifetime r;
        unsafe {
            r.args.items = (ALifetime*)0;
        }
        r.args.n = 0;
        r.kind = 0;
        r.line = 0;
        r.col = 0;
        unsafe {
            if (l.items != (ALegacyLifetime*)0 && i >= 0 && i < l.n) {
                r = l.items[i];
            }
        }
        return r;
    }

    // True when the two lifetime names are the same string.
    bool lt_eq(long a, long b) {
        if (a == 0 || b == 0) {
            return a == b;
        }
        unsafe {
            return this.seq((char*)a, (char*)b);
        }
        return false;
    }

    // True when `name` is one of the `n` lifetime names that start at
    // `start` in the lifetime-name pool.
    bool lt_declared(long start, long n, long name) {
        long i = 0;
        while (i < n) {
            long other = 0;
            unsafe {
                other = this.ltnm_[start + i];
            }
            if (this.lt_eq(other, name)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // `duplicate lifetime '$a'` - the native declaration repeats a name.
    void err_lt_dup_native(long line, long col, long name) {
        this.db_start_ = this.db_n_;
        this.db_put("duplicate lifetime '$");
        unsafe {
            this.db_put((char*)name);
        }
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

    // `duplicate lifetime 'a'` - the legacy `[[ivy::lt_def(a)]]` repeats a
    // name.
    void err_lt_dup_legacy(long line, long col, long name) {
        this.db_start_ = this.db_n_;
        this.db_put("duplicate lifetime '");
        unsafe {
            this.db_put((char*)name);
        }
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

    // `[[ivy::lt_ret]] expects exactly one lifetime argument`.
    void err_lt_ret_arity(long line, long col) {
        this.diag(line, col, "[[ivy::lt_ret]] expects exactly one lifetime argument");
    }

    // `[[ivy::lt]] expects exactly one lifetime argument`.
    void err_lt_arity(long line, long col) {
        this.diag(line, col, "[[ivy::lt]] expects exactly one lifetime argument");
    }

    // `return lifetime '$b' is not declared in lifetime<...>`.
    void err_ret_lt_undeclared(long line, long col, long name) {
        this.db_start_ = this.db_n_;
        this.db_put("return lifetime '$");
        unsafe {
            this.db_put((char*)name);
        }
        this.db_put("' is not declared in lifetime<...>");
        this.diag(line, col, this.db_end());
    }

    // `lifetime '$b' is not declared in lifetime<...>`.
    void err_lt_undeclared(long line, long col, long name) {
        this.db_start_ = this.db_n_;
        this.db_put("lifetime '$");
        unsafe {
            this.db_put((char*)name);
        }
        this.db_put("' is not declared in lifetime<...>");
        this.diag(line, col, this.db_end());
    }

    // `lifetime annotation requires a reference or pointer parameter`.
    void err_lt_needs_ref(long line, long col) {
        this.diag(line, col,
                  "lifetime annotation requires a reference or pointer parameter");
    }

    // `[[ivy::lt(b)]]: lifetime 'b' is not declared via [[ivy::lt_def(...)]]`.
    void err_legacy_lt_undeclared(long line, long col, long name) {
        this.db_start_ = this.db_n_;
        this.db_put("[[ivy::lt(");
        unsafe {
            this.db_put((char*)name);
        }
        this.db_put(")]]: lifetime '");
        unsafe {
            this.db_put((char*)name);
        }
        this.db_put("' is not declared via [[ivy::lt_def(...)]]");
        this.diag(line, col, this.db_end());
    }

    // `[[ivy::lt]] requires a reference or pointer parameter`.
    void err_legacy_lt_needs_ref(long line, long col) {
        this.diag(line, col, "[[ivy::lt]] requires a reference or pointer parameter");
    }

    // `function 'f' returns a pointer but has no return lifetime - use
    // `lifetime<$a>` and annotate the return type with $a`  (the dash is an
    // em dash, like in the oracle).
    void err_ptr_ret_no_lt(long line, long col, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put("function '");
        this.db_put(name);
        this.db_put("' returns a pointer but has no return lifetime — ");
        this.db_put("use `lifetime<$a>` and annotate the return type with $a");
        this.diag(line, col, this.db_end());
    }

    // lowerLifetimeAttributes in src/hir/hir_builder.cpp: the declared
    // lifetime names of a function and its return lifetime.
    //
    // The native `lifetime<$a, $b>` names come first, then the legacy
    // `[[ivy::lt_def(a, b)]]` names.  The legacy `[[ivy::lt_ret(x)]]`
    // wins over the native return lifetime (the code, not the comment
    // above it).  Returns the index of the first name in the pool; -1
    // when the function carries no lifetime declaration at all.
    long lower_lifetime_attributes(AFunction af) {
        this.cur_lt_start_ = -1;
        this.cur_lt_n_ = 0;
        this.cur_ret_lt_ = 0;
        long start = this.ltn_n_;
        long present = 0;
        // The native declaration.
        unsafe {
            if (af.lt_names.items != (ALifetime*)0) {
                present = 1;
            }
        }
        long i = 0;
        while (i < af.lt_names.n) {
            long nm = this.lt_name(af.lt_names, i);
            if (this.lt_declared(start, this.ltn_n_ - start, nm)) {
                this.err_lt_dup_native(af.line, af.col, nm);
            } else {
                this.ltnm_push(nm);
            }
            i = i + 1;
        }
        // The legacy attributes, in attribute order.
        long j = 0;
        while (j < af.legacy_lts.n) {
            ALegacyLifetime ll = this.legacy_lt(af.legacy_lts, j);
            if (ll.kind == 3) {
                // `[[ivy::lt_def(a, b)]]` declares the lifetimes.
                present = 1;
                long k = 0;
                while (k < ll.args.n) {
                    long nm = this.lt_name(ll.args, k);
                    if (this.lt_declared(start, this.ltn_n_ - start, nm)) {
                        this.err_lt_dup_legacy(ll.line, ll.col, nm);
                    } else {
                        this.ltnm_push(nm);
                    }
                    k = k + 1;
                }
            } else if (ll.kind == 2) {
                // `[[ivy::lt_ret(x)]]` sets the return lifetime.
                if (ll.args.n != 1) {
                    this.err_lt_ret_arity(ll.line, ll.col);
                } else if (this.cur_ret_lt_ == 0) {
                    this.cur_ret_lt_ = this.lt_name(ll.args, 0);
                }
            }
            j = j + 1;
        }
        // The native return lifetime (`-> T $a`): the legacy one wins.
        if (this.cur_ret_lt_ == 0 && af.ret_lts.n > 0) {
            this.cur_ret_lt_ = this.lt_name(af.ret_lts, 0);
        }
        // The return lifetime must name a declared lifetime.
        if (this.cur_ret_lt_ != 0) {
            if (!this.lt_declared(start, this.ltn_n_ - start, this.cur_ret_lt_)) {
                this.err_ret_lt_undeclared(af.line, af.col, this.cur_ret_lt_);
            }
        }
        this.cur_lt_n_ = this.ltn_n_ - start;
        if (present != 0) {
            this.cur_lt_start_ = start;
        }
        return this.cur_lt_start_;
    }

    // lowerParamAttribute in src/hir/hir_builder.cpp: the lifetime of a
    // parameter.  The native `$a` wins over the legacy `[[ivy::lt(x)]]`.
    // Returns the address of the lifetime name, 0 when the parameter
    // carries no lifetime.
    long lower_param_attribute(long lt_start, long lt_n, AParam ap) {
        if (ap.lt_names.n > 0) {
            long nm = this.lt_name(ap.lt_names, 0);
            if (!this.lt_declared(lt_start, lt_n, nm)) {
                this.err_lt_undeclared(ap.line, ap.col, nm);
                return 0;
            }
            if (ap.type.ptr_depth == 0 && ap.type.is_ref == 0) {
                this.err_lt_needs_ref(ap.line, ap.col);
                return 0;
            }
            return nm;
        }
        long j = 0;
        while (j < ap.legacy_lts.n) {
            ALegacyLifetime ll = this.legacy_lt(ap.legacy_lts, j);
            if (ll.kind == 1) {
                if (ll.args.n != 1) {
                    this.err_lt_arity(ll.line, ll.col);
                } else {
                    long nm = this.lt_name(ll.args, 0);
                    if (!this.lt_declared(lt_start, lt_n, nm)) {
                        this.err_legacy_lt_undeclared(ll.line, ll.col, nm);
                    } else if (ap.type.ptr_depth == 0 && ap.type.is_ref == 0) {
                        this.err_legacy_lt_needs_ref(ll.line, ll.col);
                    } else {
                        return nm;
                    }
                }
            }
            j = j + 1;
        }
        return 0;
    }

    void push_param(AType t, const char* name, long line, long col) {
        if (this.u.p_n >= this.u.p_cap) {
            return;
        }
        unsafe {
            this.u.params[this.u.p_n].type = t;
            this.u.params[this.u.p_n].name = name;
            this.u.params[this.u.p_n].line = line;
            this.u.params[this.u.p_n].col = col;
            this.u.params[this.u.p_n].default_value = -1;
            this.u.params[this.u.p_n].lt = (char*)0;
        }
        this.u.p_n = this.u.p_n + 1;
    }

    // Record the default-value expression of a parameter (the AST expression
    // index, -1 when the parameter has no default).
    void set_param_default(long idx, long def) {
        if (idx < 0 || idx >= this.u.p_n) {
            return;
        }
        unsafe {
            this.u.params[idx].default_value = def;
        }
    }

    // Record the lifetime name of a parameter (the address of the name,
    // 0 when the parameter has none).
    void set_param_lifetime(long idx, long name) {
        if (idx < 0 || idx >= this.u.p_n) {
            return;
        }
        unsafe {
            this.u.params[idx].lt = (char*)name;
        }
    }

    long add_function(const char* name, AType ret, long is_ext, long is_constexpr) {
        return this.add_function_at(name, ret, is_ext, is_constexpr, this.u.p_n,
                                    -1, 0, 0);
    }

    // Add a function whose parameters were already pushed into the
    // parameter pool: `pstart` is the index of its first parameter.
    // `lt_start`/`lt_n` are the declared lifetime names of the function
    // (-1 when it declares none) and `ret_lt` is the address of its return
    // lifetime name (0 when it has none).
    long add_function_at(const char* name, AType ret, long is_ext, long is_constexpr,
                         long pstart, long lt_start, long lt_n,
                         long ret_lt) {
        HFunction f;
        f.name = name;
        f.ret = ret;
        f.is_extern_c = is_ext;
        f.body = -1;
        f.pstart = pstart;
        f.pn = 0;
        f.is_constexpr = is_constexpr;
        f.lt_start = lt_start;
        f.lt_n = lt_n;
        unsafe {
            f.return_lifetime = (char*)ret_lt;
        }
        long idx = this.u.fn_n;
        if (this.u.fn_n < this.u.fn_cap) {
            unsafe {
                this.u.fns[this.u.fn_n] = f;
            }
            this.u.fn_n = this.u.fn_n + 1;
        }
        return idx;
    }

    void finish_function(long idx) {
        if (idx < this.u.fn_n) {
            long start = 0;
            unsafe {
                start = this.u.fns[idx].pstart;
            }
            unsafe {
                this.u.fns[idx].pn = this.u.p_n - start;
            }
        }
    }

    void build_free_signature(AFunction af, long astIdx) {
        // A template definition is not registered as a function: it is
        // stored in the template registry and instantiated on demand.
        // Its body is never type checked.
        if (af.tpl_n > 0) {
            this.register_template(astIdx);
            return;
        }
        // The return type and the parameter types are resolved before the
        // parameters are pushed: a template-id type instantiates its
        // specialization, whose methods are added to the function pool
        // first, and the parameters of a function must stay contiguous.
        AType ret = this.resolve_template_struct_type(this.resolve_alias(af.ret),
                                                        af.line, af.col);
        // The declared lifetimes of the function and its return lifetime
        // (lowerLifetimeAttributes).
        long lt_start = this.lower_lifetime_attributes(af);
        long lt_n = this.cur_lt_n_;
        long ret_lt = this.cur_ret_lt_;
        // B4: a nullptr_t or a raw pointer return type requires an unsafe
        // block unless the function is a declaration only.
        if (af.body >= 0 && this.seq(ret.base, "nullptr_t")) {
            this.require_unsafe(af.line, af.col, "return type 'nullptr_t'");
        }
        if (af.body >= 0 && ret.ptr_depth > 0) {
            this.require_unsafe(af.line, af.col, "raw pointer return type");
        }
        long np = af.nparams;
        long pstart = 0;
        this.pltn_reserve(np);
        unsafe {
            AType* ptypes = (AType*)0;
            if (np > 0) {
                ptypes = this.alloc_types(np);
            }
            long j = 0;
            while (j < np) {
                AParam p = af.params[j];
                AType pt = this.resolve_template_struct_type(
                    this.resolve_alias(p.type), p.line, p.col);
                ptypes[j] = pt;
                // The lifetime of the parameter (lowerParamAttribute): the
                // native `$a` wins over the legacy `[[ivy::lt(x)]]`.  The
                // oracle lowers the lifetime of a parameter right after it
                // resolves the parameter's type, so the diagnostics of the
                // two steps keep that order.
                long plt = this.lower_param_attribute(lt_start, lt_n, p);
                if (af.body >= 0 && this.seq(pt.base, "nullptr_t")) {
                    this.require_unsafe(p.line, p.col, "parameter type 'nullptr_t'");
                }
                if (af.body >= 0 && pt.ptr_depth > 0) {
                    this.require_unsafe(p.line, p.col, "raw pointer parameter type");
                }
                if (this.pltn_ != (long*)0) {
                    this.pltn_[j] = plt;
                }
                j = j + 1;
            }
            pstart = this.u.p_n;
            long k = 0;
            while (k < np) {
                AParam p = af.params[k];
                AType pt = ptypes[k];
                this.push_param(pt, p.name, p.line, p.col);
                this.set_param_default(this.u.p_n - 1, p.default_value);
                if (this.pltn_ != (long*)0) {
                    this.set_param_lifetime(this.u.p_n - 1, this.pltn_[k]);
                }
                k = k + 1;
            }
        }
        // A function definition that returns a pointer must declare the
        // returned pointer's lifetime.  (Declarations - e.g. extern "C" C
        // APIs like malloc - are exempt.)
        if (af.body >= 0 && ret.ptr_depth > 0 && ret_lt == 0) {
            this.err_ptr_ret_no_lt(af.line, af.col, af.name);
        }
        long idx = this.add_function_at(af.name, ret, af.is_extern_c, af.is_constexpr,
                                        pstart, lt_start, lt_n, ret_lt);
        this.finish_function(idx);
    }

    void build_method_signature(AStruct sd, AFunction mf) {
        // The return type and the parameter types are resolved before the
        // parameters are pushed (see build_free_signature).
        AType ret = this.resolve_template_struct_type(this.resolve_alias(mf.ret),
                                                        mf.line, mf.col);
        long np = mf.nparams;
        long pstart = 0;
        this.pltn_reserve(np);
        unsafe {
            AType* ptypes = (AType*)0;
            if (np > 0) {
                ptypes = this.alloc_types(np);
            }
            long j = 0;
            while (j < np) {
                AParam p = mf.params[j];
                AType pt = this.resolve_template_struct_type(
                    this.resolve_alias(p.type), p.line, p.col);
                ptypes[j] = pt;
                // A method declares no lifetime, so a parameter lifetime is
                // always undeclared (buildStruct in hir_builder.cpp calls
                // lowerParamAttribute with an empty lifetime list).
                long plt = this.lower_param_attribute(-1, 0, p);
                if (this.pltn_ != (long*)0) {
                    this.pltn_[j] = plt;
                }
                j = j + 1;
            }
            // The implicit `this` parameter comes first.
            AType tt = this.ty_empty();
            tt.base = sd.name;
            tt.is_ref = 1;
            pstart = this.u.p_n;
            this.push_param(tt, "this", mf.line, mf.col);
            long k = 0;
            while (k < np) {
                AParam p = mf.params[k];
                AType pt = ptypes[k];
                this.push_param(pt, p.name, p.line, p.col);
                this.set_param_default(this.u.p_n - 1, p.default_value);
                if (this.pltn_ != (long*)0) {
                    this.set_param_lifetime(this.u.p_n - 1, this.pltn_[k]);
                }
                k = k + 1;
            }
        }
        long idx = this.add_function_at(mf.name, ret, 0, mf.is_constexpr, pstart,
                                        -1, 0, 0);
        this.finish_function(idx);
    }

    void build_structs() {
        long n = this.pa.struct_count();
        long i = 0;
        while (i < n) {
            AStruct sd = this.get_struct(i);
            // A struct/class template is not built: it is registered and
            // instantiated on demand when a template-id type is used.
            if (sd.tpl_n > 0) {
                this.register_struct_template(i);
                i = i + 1;
                continue;
            }
            // Reject a duplicate struct name: the oracle skips the whole
            // declaration, so none of its methods are registered.  A
            // struct template never occupies the struct registry, so it
            // never clashes with an ordinary struct.
            long prev = 0;
            long dup = 0;
            while (prev < i) {
                AStruct ps = this.get_struct(prev);
                if (ps.tpl_n == 0 && this.seq(ps.name, sd.name)) {
                    dup = 1;
                }
                prev = prev + 1;
            }
            if (dup != 0) {
                this.err_redef_struct(sd.line, sd.col, sd.name);
                i = i + 1;
                continue;
            }
            // The field layout is needed by `sizeof` / `alignof`.
            this.layout_struct(i);
            long j = 0;
            while (j < sd.nmethods) {
                AFunction mf;
                unsafe {
                    mf = sd.methods[j];
                }
                this.build_method_signature(sd, mf);
                j = j + 1;
            }
            i = i + 1;
        }
    }


    // The name of the function whose body is currently being built.
    const char* current_fn_name() {
        if (this.cur_fn_ < 0 || this.cur_fn_ >= this.u.fn_n) {
            return "";
        }
        HFunction f;
        unsafe {
            f = this.u.fns[this.cur_fn_];
        }
        return f.name;
    }

    // --- statements ------------------------------------------------------

    void build_body(long fnidx, AFunction af, long locLine, long locCol) {
        // The scope stack of the caller is saved and restored: a template
        // that is instantiated from inside another function's body must
        // not clobber the caller's scopes.  The parameter scope is pushed
        // on top of the current stack, so the caller's scope markers stay
        // intact.
        long saved_s = this.s_n_;
        long saved_sc = this.sc_n_;
        long saved_fn = this.cur_fn_;
        AType saved_ret = this.cur_ret_;
        long saved_hasret = this.has_return_;
        this.cur_fn_ = fnidx;
        this.has_return_ = 0;
        HFunction hf;
        unsafe {
            hf = this.u.fns[fnidx];
        }
        this.cur_ret_ = hf.ret;
        this.enter_scope();
        long i = 0;
        while (i < hf.pn) {
            HParam p;
            unsafe {
                p = this.u.params[hf.pstart + i];
            }
            if (this.slen(p.name) > 0) {
                this.declare(p.name, p.type, p.line, p.col);
            }
            i = i + 1;
        }
        long root = this.build_stmt(af.body);
        this.leave_scope();
        unsafe {
            this.u.fns[fnidx].body = root;
        }
        // A non-void function must not fall off the end of its body.
        if (hf.ret.is_const == 0 && hf.ret.ptr_depth == 0 &&
            !this.seq(hf.ret.base, "void") && this.has_return_ == 0) {
            this.err_may_reach_end(locLine, locCol, hf.name);
        }
        this.s_n_ = saved_s;
        this.sc_n_ = saved_sc;
        this.cur_fn_ = saved_fn;
        this.cur_ret_ = saved_ret;
        this.has_return_ = saved_hasret;
    }

    long build_compound(long idx) {
        AStmt a = this.get_stmt(idx);
        this.enter_scope();
        long first = -1;
        long last = -1;
        long count = 0;
        long cur = a.sstart;
        while (cur >= 0) {
            AStmt child = this.get_stmt(cur);
            long nxt = child.next;
            long h = this.build_stmt(cur);
            if (first < 0) {
                first = h;
            } else if (last >= 0) {
                unsafe {
                    this.u.stmts[last].next = h;
                }
            }
            last = h;
            count = count + 1;
            cur = nxt;
        }
        this.leave_scope();
        HStmt s = this.new_stmt(1, a.line, a.col);
        s.sstart = first;
        s.sn = count;
        return this.push_stmt(s);
    }

    // B5 / B6 in buildDeclaration and buildExpr(Assign): materialise an
    // expected<T, E> / optional<T> target from a plain value.  Returns the
    // expression index of the value to store (unchanged when no wrapping
    // applies).
    long wrap_value(AType to, long initIdx, long line, long col) {
        HExpr ie;
        unsafe {
            ie = this.u.exprs[initIdx];
        }
        AType from = ie.type;
        if (this.seq(to.base, from.base)) {
            return initIdx;
        }
        // B5: expected<T, E>.
        if (this.is_expected_struct(to)) {
            AType tArg = this.expected_t_;
            AType eArg = this.expected_e_;
            bool tExact = this.seq(tArg.base, from.base) &&
                          tArg.ptr_depth == from.ptr_depth;
            bool eExact = this.seq(eArg.base, from.base) &&
                          eArg.ptr_depth == from.ptr_depth;
            if (eExact && !tExact && !this.seq(eArg.base, tArg.base)) {
                return this.build_expected_list(to, initIdx, 2, line, col);
            }
            if (tExact) {
                return this.build_expected_list(to, initIdx, 1, line, col);
            }
            if (this.is_assignable(tArg, from)) {
                return this.build_expected_list(to, initIdx, 1, line, col);
            }
            if (this.is_assignable(eArg, from)) {
                return this.build_expected_list(to, initIdx, 2, line, col);
            }
        }
        // B6: optional<T>.
        if (this.is_optional_struct(to)) {
            AType tArg = this.optional_t_;
            if (this.seq(from.base, "nullopt")) {
                return this.build_optional_list(to, -1, 0, line, col);
            }
            if (this.is_assignable(tArg, from)) {
                return this.build_optional_list(to, initIdx, 1, line, col);
            }
        }
        return initIdx;
    }

    // Build a bool literal expression (hir::Expr::BoolLit).
    long build_bool_literal(long v, long line, long col) {
        HExpr e = this.new_expr(5, line, col);
        e.ival = v;
        e.type = this.ty_bool();
        return this.push_expr(e);
    }

    // Build an `init-list` expression (hir::Expr::InitList).  The elements
    // are stored as a run of expression indices in the args pool; an element
    // index of -1 marks a zero-initialized field.
    long build_init_list(AType t, long line, long col, long n,
                         long e0, long e1, long e2) {
        HExpr e = this.new_expr(19, line, col);
        e.type = t;
        long start = this.u.a_n;
        this.push_arg(e0);
        if (n > 1) {
            this.push_arg(e1);
        }
        if (n > 2) {
            this.push_arg(e2);
        }
        e.astart = start;
        e.an = n;
        return this.push_expr(e);
    }

    // wrapExpectedValue in hir_builder.cpp: the list is
    // [hasValue, value, error] with the wrapped value in the `value`
    // (mode 1) or `error` (mode 2) slot.
    long build_expected_list(AType to, long valueIdx, long mode, long line, long col) {
        long has = this.build_bool_literal(mode == 1, line, col);
        long val = -1;
        long err = -1;
        if (mode == 1) {
            val = valueIdx;
        } else {
            err = valueIdx;
        }
        return this.build_init_list(to, line, col, 3, has, val, err);
    }

    // wrapOptionalValue in hir_builder.cpp: the list is [hasValue, value];
    // a value index of -1 leaves the value field zero-initialized.
    long build_optional_list(AType to, long valueIdx, long hasValue, long line, long col) {
        long has = this.build_bool_literal(hasValue, line, col);
        return this.build_init_list(to, line, col, 2, has, valueIdx, -1);
    }

    long build_decl(AStmt a) {
        AType t = this.resolve_template_struct_type(this.resolve_alias(a.type),
                                                    a.line, a.col);
        long init = -1;
        if (t.ptr_depth == 0 && this.seq(t.base, "void")) {
            this.db_start_ = this.db_n_;
            this.db_put("variable '");
            this.db_put(a.sval);
            this.db_put("' cannot have type void");
            this.diag(a.line, a.col, this.db_end());
        }
        if (t.ptr_depth > 0) {
            this.require_unsafe(a.line, a.col, "raw pointer variable declaration");
        }
        if (this.seq(t.base, "nullptr_t")) {
            this.require_unsafe(a.line, a.col, "type 'nullptr_t'");
        }
        if (this.seq(t.base, "auto")) {
            if (a.a < 0) {
                this.db_start_ = this.db_n_;
                this.db_put("'auto' variable '");
                this.db_put(a.sval);
                this.db_put("' must have an initializer");
                this.diag(a.line, a.col, this.db_end());
                this.declare(a.sval, t, a.line, a.col);
                HStmt s0 = this.new_stmt(2, a.line, a.col);
                s0.type = t;
                s0.sval = a.sval;
                s0.a = -1;
                return this.push_stmt(s0);
            }
            init = this.build_expr(a.a);
            if (init >= 0) {
                HExpr ie;
                unsafe {
                    ie = this.u.exprs[init];
                }
                t = ie.type;
                t.ptr_depth = t.ptr_depth + a.type.ptr_depth;
                if (a.type.is_ref != 0) { t.is_ref = 1; }
                if (a.type.is_const != 0) { t.is_const = 1; }
                if (a.type.is_ref == 0) { t.is_ref = 0; }
            }
            if (t.ptr_depth > 0) {
                this.require_unsafe(a.line, a.col, "raw pointer variable declaration");
            }
            this.declare(a.sval, t, a.line, a.col);
            HStmt s = this.new_stmt(2, a.line, a.col);
            s.type = t;
            s.sval = a.sval;
            s.a = init;
            return this.push_stmt(s);
        }
        if (a.a >= 0) {
            init = this.build_expr(a.a);
            if (init >= 0) {
                HExpr ie;
                unsafe {
                    ie = this.u.exprs[init];
                }
                if (this.is_assignable(t, ie.type) == 0) {
                    this.err_init_types(a.line, a.col, a.sval, t, ie.type);
                } else {
                    init = this.wrap_value(t, init, a.line, a.col);
                }
            }
        } else {
            if (t.array_size == 0 && this.is_struct_name(t.base) == 0) {
                this.db_start_ = this.db_n_;
                this.db_put("variable '");
                this.db_put(a.sval);
                this.db_put("' must be initialized (uninitialized variables are not allowed)");
                this.diag(a.line, a.col, this.db_end());
            }
        }
        this.declare(a.sval, t, a.line, a.col);
        HStmt s = this.new_stmt(2, a.line, a.col);
        s.type = t;
        s.sval = a.sval;
        s.a = init;
        return this.push_stmt(s);
    }

    // checkCondition in hir_builder.cpp: a condition must be numeric, a
    // pointer, or nullptr.
    void check_condition(long exprIdx) {
        if (exprIdx < 0) {
            return;
        }
        HExpr e;
        unsafe {
            e = this.u.exprs[exprIdx];
        }
        AType t = e.type;
        if (this.is_numeric(t) || t.ptr_depth > 0 || this.seq(t.base, "nullptr")) {
            return;
        }
        this.err_condition(e.line, e.col, t);
    }

    // buildReturn in hir_builder.cpp: check the returned value against the
    // declared return type.
    long build_return(AStmt a) {
        this.has_return_ = 1;
        long val = -1;
        AType rt = this.cur_ret_;
        if (a.a >= 0) {
            val = this.build_expr(a.a);
            if (rt.ptr_depth == 0 && this.seq(rt.base, "void")) {
                this.diag(a.line, a.col, "void function cannot return a value");
            } else if (val >= 0) {
                HExpr ve;
                unsafe {
                    ve = this.u.exprs[val];
                }
                if (this.is_assignable(rt, ve.type) == 0) {
                    this.err_return_types(a.line, a.col, rt, ve.type);
                }
            }
        } else {
            if (rt.ptr_depth == 0 && !this.seq(rt.base, "void")) {
                this.err_must_return_value(a.line, a.col, this.current_fn_name(), rt);
            }
        }
        HStmt s = this.new_stmt(7, a.line, a.col);
        s.a = val;
        return this.push_stmt(s);
    }

    // True when the statement ends a case clause: `break`, `return`,
    // `continue` or `nextcase` (a block ending with one of them counts
    // too, like the oracle's isTerminator helper).
    bool is_terminator(long idx) {
        if (idx < 0) {
            return false;
        }
        HStmt s;
        unsafe {
            s = this.u.stmts[idx];
        }
        if (s.kind == 7 || s.kind == 8 || s.kind == 9 || s.kind == 10) {
            return true;
        }
        if (s.kind == 1) {
            long k = s.sstart;
            long last = -1;
            while (k >= 0) {
                last = k;
                unsafe {
                    k = this.u.stmts[k].next;
                }
            }
            if (last < 0) {
                return false;
            }
            return this.is_terminator(last);
        }
        return false;
    }

    // The switch condition must have an integral type (buildStmt in
    // hir_builder.cpp): `bool`, `char`, the C-style integer types and every
    // fixed-width integer type.  The floating-point and pointer types are
    // not integral.
    bool is_switch_integral(AType t) {
        if (t.ptr_depth > 0 || t.is_ref != 0) {
            return false;
        }
        if (this.seq(t.base, "")) {
            return false;
        }
        if (this.seq(t.base, "bool") || this.seq(t.base, "char") ||
            this.seq(t.base, "short") || this.seq(t.base, "int") ||
            this.seq(t.base, "long") || this.seq(t.base, "long long") ||
            this.seq(t.base, "unsigned") || this.seq(t.base, "unsigned long") ||
            this.seq(t.base, "unsigned long long")) {
            return true;
        }
        return this.has_sub(t.base, "int") || this.has_sub(t.base, "char");
    }

    // buildStmt in hir_builder.cpp: a switch statement.  The condition must
    // have an integral type, there may be at most one `default` case and
    // every case must end with a terminator statement (Ivy has no implicit
    // fallthrough).
    long build_switch(AStmt a) {
        long cond = this.build_expr(a.a);
        if (cond >= 0) {
            HExpr ce;
            unsafe {
                ce = this.u.exprs[cond];
            }
            if (this.is_switch_integral(ce.type) == 0) {
                this.err_switch_cond_type(a.line, a.col);
            }
        }
        long cstart = this.u.c_n;
        long ncases = 0;
        long has_default = 0;
        long j = 0;
        while (j < a.sn) {
            ACase ac = this.pa.get_case(a.sstart + j);
            long value = -1;
            if (ac.value >= 0) {
                value = this.build_expr(ac.value);
            } else {
                if (has_default != 0) {
                    this.err_switch_dup_default(a.line, a.col);
                }
                has_default = 1;
            }
            // The statements of the case, in source order.
            long first = -1;
            long last = -1;
            long count = 0;
            long cur = ac.sstart;
            while (cur >= 0) {
                AStmt child = this.get_stmt(cur);
                long nxt = child.next;
                long h = this.build_stmt(cur);
                if (first < 0) {
                    first = h;
                } else if (last >= 0) {
                    unsafe {
                        this.u.stmts[last].next = h;
                    }
                }
                last = h;
                count = count + 1;
                cur = nxt;
            }
            if (count > 0 && this.is_terminator(last) == 0) {
                this.err_switch_fallthrough(a.line, a.col);
            }
            HCase hc;
            hc.value = value;
            hc.sstart = first;
            hc.sn = count;
            this.push_hcase(hc);
            ncases = ncases + 1;
            j = j + 1;
        }
        HStmt s = this.new_stmt(14, a.line, a.col);
        s.a = cond;
        s.sstart = cstart;
        s.sn = ncases;
        return this.push_stmt(s);
    }

    long build_stmt(long idx) {
        AStmt a = this.get_stmt(idx);
        if (a.kind == 1) {
            return this.build_compound(idx);
        }
        if (a.kind == 2) {
            return this.build_decl(a);
        }
        if (a.kind == 3) {
            long cond = this.build_expr(a.a);
            this.check_condition(cond);
            long thenb = -1;
            long elseb = -1;
            // `if constexpr`: evaluate the condition at compile time and
            // build only the taken branch.  The discarded branch is not
            // built at all, so it is neither resolved nor type checked.
            if (a.flag != 0 && cond >= 0) {
                this.cst_reset();
            }
            if (a.flag != 0 && cond >= 0 && this.eval_const_expr(cond)) {
                long taken = 0;
                if (this.cst_is_int_ != 0) {
                    taken = this.cst_i_ != 0 ? 1 : 0;
                } else {
                    taken = this.cst_f_ != 0.0 ? 1 : 0;
                }
                if (taken != 0) {
                    if (a.b >= 0) { thenb = this.build_stmt(a.b); }
                } else {
                    if (a.c >= 0) { elseb = this.build_stmt(a.c); }
                }
                HStmt sc = this.new_stmt(3, a.line, a.col);
                sc.a = cond;
                sc.b = thenb;
                sc.c = elseb;
                return this.push_stmt(sc);
            }
            if (a.b >= 0) { thenb = this.build_stmt(a.b); }
            if (a.c >= 0) { elseb = this.build_stmt(a.c); }
            HStmt s = this.new_stmt(3, a.line, a.col);
            s.a = cond;
            s.b = thenb;
            s.c = elseb;
            return this.push_stmt(s);
        }
        if (a.kind == 4) {
            long cond = this.build_expr(a.a);
            this.check_condition(cond);
            long body = this.build_stmt(a.b);
            HStmt s = this.new_stmt(4, a.line, a.col);
            s.a = cond;
            s.b = body;
            return this.push_stmt(s);
        }
        if (a.kind == 5) {
            long body = this.build_stmt(a.a);
            long cond = this.build_expr(a.b);
            this.check_condition(cond);
            HStmt s = this.new_stmt(5, a.line, a.col);
            s.a = body;
            s.b = cond;
            return this.push_stmt(s);
        }
        if (a.kind == 6) {
            this.enter_scope();
            long init = -1;
            if (a.a >= 0) { init = this.build_stmt(a.a); }
            long cond = -1;
            if (a.b >= 0) {
                cond = this.build_expr(a.b);
                this.check_condition(cond);
            }
            long incr = -1;
            if (a.c >= 0) { incr = this.build_expr(a.c); }
            long body = this.build_stmt(a.sstart);
            this.leave_scope();
            HStmt s = this.new_stmt(6, a.line, a.col);
            s.a = init;
            s.b = cond;
            s.c = incr;
            s.sstart = body;
            return this.push_stmt(s);
        }
        if (a.kind == 7) {
            HStmt s = this.new_stmt(13, a.line, a.col);
            return this.push_stmt(s);
        }
        if (a.kind == 8) {
            return this.build_return(a);
        }
        if (a.kind == 9) {
            HStmt s = this.new_stmt(8, a.line, a.col);
            return this.push_stmt(s);
        }
        if (a.kind == 10) {
            HStmt s = this.new_stmt(9, a.line, a.col);
            return this.push_stmt(s);
        }
        if (a.kind == 11) {
            HStmt s = this.new_stmt(10, a.line, a.col);
            s.sval = a.sval;
            return this.push_stmt(s);
        }
        if (a.kind == 12) {
            long val = this.build_expr(a.a);
            HStmt s = this.new_stmt(11, a.line, a.col);
            s.a = val;
            return this.push_stmt(s);
        }
        if (a.kind == 13) {
            this.unsafe_depth_ = this.unsafe_depth_ + 1;
            long body = this.build_stmt(a.a);
            this.unsafe_depth_ = this.unsafe_depth_ - 1;
            HStmt s = this.new_stmt(12, a.line, a.col);
            s.a = body;
            return this.push_stmt(s);
        }
        if (a.kind == 14) {
            HStmt s = this.new_stmt(13, a.line, a.col);
            return this.push_stmt(s);
        }
        if (a.kind == 15) {
            return this.build_switch(a);
        }
        HStmt s = this.new_stmt(13, a.line, a.col);
        return this.push_stmt(s);
    }

    // --- expressions -----------------------------------------------------

    long build_ident(AExpr a) {
        long si = this.find_sym(a.sval);
        // A4: the use-after-move check.  It fires for every identifier that
        // resolves to a variable whose move state is `MovedOut`; the
        // location is the identifier's own location.  The check is skipped
        // while the left-hand side of an assignment is built (a
        // re-assignment re-initializes a moved-out variable).
        if (si >= 0 && this.in_assign_lhs_ == 0 && this.sym_moved(si) != 0) {
            this.err_use_moved_out(a.line, a.col, a.sval);
        }
        HExpr e = this.new_expr(8, a.line, a.col);
        e.sval = a.sval;
        if (si >= 0) {
            e.type = this.sym_type(si);
            return this.push_expr(e);
        }
        long gi = this.find_global_enum(a.sval);
        if (gi >= 0) {
            HExpr lit = this.new_expr(1, a.line, a.col);
            lit.ival = this.global_enum_value(gi);
            lit.type = this.ty_int();
            return this.push_expr(lit);
        }
        if (this.find_fn(a.sval) >= 0) {
            this.err_fn_value(a.line, a.col, a.sval);
        } else {
            this.err_undeclared(a.line, a.col, a.sval);
        }
        e.type = this.ty_dummy();
        return this.push_expr(e);
    }

    long build_this(AExpr a) {
        long si = this.find_sym("this");
        HExpr e = this.new_expr(7, a.line, a.col);
        if (si >= 0) {
            e.type = this.sym_type(si);
            return this.push_expr(e);
        }
        this.err_this(a.line, a.col);
        e.type = this.ty_dummy();
        return this.push_expr(e);
    }

    // The recovery node for a member access that failed to resolve (the
    // `->` on a non-pointer, the member access on a non-struct and the
    // unknown member).  The oracle (src/hir/hir_builder.cpp:3550-3577)
    // reports the diagnostic and then returns the default-constructed
    // `hir::Expr` with only `out->type = dummyType()` set - the node
    // variant keeps its default alternative, which is `IntegerLit` (the
    // first alternative of the variant, src/hir/hir.h:106-109).  The
    // recovered expression is therefore NOT a member expression, so
    // `build_assign` sees a non-assignable left-hand side and emits the
    // second diagnostic ("left-hand side of assignment is not assignable")
    // at the assignment's location.  The port must reproduce that node
    // kind exactly: kind 1 is the port's integer literal.  A member node
    // (kind 14) here would swallow the second diagnostic.
    HExpr failed_member(long line, long col) {
        HExpr bad = this.new_expr(1, line, col);
        bad.type = this.ty_dummy();
        return bad;
    }

    long build_member(AExpr a) {
        if (a.flag == 0 && a.is_scope != 0) {
            this.db_start_ = this.db_n_;
            if (this.flatten_chain(a.a) != 0) {
                this.tmp_ = this.db_end();
                long ei = this.find_enum(this.tmp_);
                if (ei >= 0) {
                    long val = this.enum_const_value(ei, a.sval);
                    if (this.eval_hit_ != 0) {
                        HExpr lit = this.new_expr(1, a.line, a.col);
                        lit.ival = val;
                        AType t = this.ty_empty();
                        AEnum ed = this.pa.get_enum(ei);
                        t.base = ed.name;
                        lit.type = t;
                        return this.push_expr(lit);
                    }
                    this.err_no_enumerator(a.line, a.col, this.tmp_, a.sval);
                    HExpr bad = this.new_expr(1, a.line, a.col);
                    bad.type = this.ty_dummy();
                    return this.push_expr(bad);
                }
            }
        }

        long base = this.build_expr(a.a);
        HExpr be;
        unsafe {
            be = this.u.exprs[base];
        }
        AType bt = be.type;
        if (a.flag != 0) {
            if (bt.ptr_depth == 0) {
                this.err_arrow(a.line, a.col, bt);
                HExpr bad = this.failed_member(a.line, a.col);
                return this.push_expr(bad);
            }
            bt.ptr_depth = bt.ptr_depth - 1;
        } else {
            bt.is_ref = 0;
        }
        long si = this.find_struct(bt.base);
        if (si < 0) {
            this.err_not_struct(a.line, a.col, bt, "access member", a.sval);
            HExpr bad = this.failed_member(a.line, a.col);
            return this.push_expr(bad);
        }
        AStruct sd = this.get_struct(si);
        if (this.lookup_field(sd, a.sval) == 0) {
            this.err_no_member(a.line, a.col, sd.name, a.sval);
            HExpr bad = this.failed_member(a.line, a.col);
            return this.push_expr(bad);
        }
        AField f = this.found_field_;
        HExpr e = this.new_expr(14, a.line, a.col);
        e.sval = a.sval;
        e.flag = a.flag;
        e.a = base;
        e.type = this.resolve_alias(f.type);
        return this.push_expr(e);
    }

    long flatten_chain(long idx) {
        AExpr e = this.get_expr(idx);
        if (e.kind == 8) {
            this.db_put(e.sval);
            return 1;
        }
        if (e.kind == 15 && e.is_scope != 0) {
            if (this.flatten_chain(e.a) == 0) {
                return 0;
            }
            this.db_put("::");
            this.db_put(e.sval);
            return 1;
        }
        return 0;
    }

    // Type identity (Type::operator== in ast.h).  The template arguments
    // are part of the identity: a `Box<int32_t>` is not the same type as
    // a plain `Box`.
    bool same_type(AType a, AType b) {
        if (!this.seq(a.base, b.base)) { return false; }
        if (a.is_unsigned != b.is_unsigned) { return false; }
        if (a.is_const != b.is_const) { return false; }
        if (a.ptr_depth != b.ptr_depth) { return false; }
        if (a.array_size != b.array_size) { return false; }
        if (a.tpl_n != b.tpl_n) { return false; }
        long i = 0;
        while (i < a.tpl_n) {
            AType x;
            AType y;
            unsafe {
                x = a.tpl_args[i];
                y = b.tpl_args[i];
            }
            if (this.same_type(x, y) == 0) { return false; }
            i = i + 1;
        }
        return true;
    }

    // Approximate bit width of a numeric base name (typeWidth in
    // hir_builder.cpp) — used to rank overload candidates.
    long type_width(const char* b) {
        if (this.seq(b, "bool") || this.seq(b, "char") || this.seq(b, "int8_t") ||
            this.seq(b, "uint8_t") || this.seq(b, "signed char") ||
            this.seq(b, "unsigned char")) { return 8; }
        if (this.seq(b, "short") || this.seq(b, "int16_t") || this.seq(b, "uint16_t")) { return 16; }
        if (this.seq(b, "int") || this.seq(b, "int32_t") || this.seq(b, "uint32_t") ||
            this.seq(b, "float") || this.seq(b, "float32_t") || this.seq(b, "bfloat16_t") ||
            this.seq(b, "float16_t")) { return 32; }
        if (this.seq(b, "long") || this.seq(b, "int64_t") || this.seq(b, "uint64_t") ||
            this.seq(b, "size_t") || this.seq(b, "ptrdiff_t") || this.seq(b, "uptr_t") ||
            this.seq(b, "long long") || this.seq(b, "double") || this.seq(b, "float64_t")) { return 64; }
        if (this.seq(b, "long double") || this.seq(b, "float128_t") ||
            this.seq(b, "int128_t") || this.seq(b, "uint128_t")) { return 128; }
        return 0;
    }

    AType arg_type(long argIdx) {
        long ai = -1;
        unsafe {
            ai = this.u.args[argIdx];
        }
        HExpr ae;
        unsafe {
            ae = this.u.exprs[ai];
        }
        return ae.type;
    }

    // Rank an overload candidate against the argument types
    // (resolveOverload in hir_builder.cpp).  0 means "does not match".
    long rank_overload(long fi, long argstart, long argcount) {
        HFunction hf;
        unsafe {
            hf = this.u.fns[fi];
        }
        long expected = hf.pn;
        long actual = argcount;
        if (expected > actual) {
            // A candidate can only take the call when every missing
            // parameter has a default value.
            long m = actual;
            while (m < expected) {
                HParam mp;
                unsafe {
                    mp = this.u.params[hf.pstart + m];
                }
                if (mp.default_value < 0) {
                    return 0;
                }
                m = m + 1;
            }
        } else if (hf.is_extern_c == 0 && expected != actual) {
            return 0;
        }
        long score = 0;
        long i = 0;
        while (i < expected) {
            HParam p;
            unsafe {
                p = this.u.params[hf.pstart + i];
            }
            if (i >= actual) {
                score = score + 80;
                i = i + 1;
                continue;
            }
            AType pt = p.type;
            pt.is_ref = 0;
            AType at = this.arg_type(argstart + i);
            at.is_ref = 0;
            if (this.same_type(pt, at)) {
                score = score + 100;
            } else if (this.is_numeric(pt) && this.is_numeric(at)) {
                long pw = this.type_width(pt.base);
                long aw = this.type_width(at.base);
                if (pw > 0 && aw > 0) {
                    long d = 0;
                    if (pw > aw) { d = pw - aw; } else { d = aw - pw; }
                    score = score + (90 - d);
                } else {
                    score = score + 50;
                }
            } else if (this.is_assignable(pt, at)) {
                score = score + 1;
            } else {
                return 0;
            }
            i = i + 1;
        }
        return score;
    }

    // Resolve a call to one of the overloads named `name`
    // (resolveOverload in hir_builder.cpp).  Returns the HIR function index
    // or -1 when no candidate matches.
    long resolve_overload(const char* name, long argstart, long argcount, long line, long col) {
        long n = 0;
        long i = 0;
        while (i < this.u.fn_n) {
            HFunction f;
            unsafe {
                f = this.u.fns[i];
            }
            if (this.seq(f.name, name)) {
                if (n < this.ovl_cap_) {
                    unsafe {
                        this.ovl_[n] = i;
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        if (n == 0) {
            return -1;
        }
        if (n == 1) {
            long only = -1;
            unsafe {
                only = this.ovl_[0];
            }
            return only;
        }
        long best = -1;
        long best_score = 0;
        long ambiguous = 0;
        long k = 0;
        while (k < n) {
            long fi = -1;
            unsafe {
                fi = this.ovl_[k];
            }
            long score = this.rank_overload(fi, argstart, argcount);
            if (score > best_score) {
                best_score = score;
                best = fi;
                ambiguous = 0;
            } else if (score == best_score && score > 0) {
                ambiguous = 1;
            }
            k = k + 1;
        }
        if (ambiguous != 0) {
            this.diag(line, col, "ambiguous call to overloaded function");
            return -1;
        }
        if (best < 0) {
            this.diag(line, col, "no matching overload for argument types");
            return -1;
        }
        return best;
    }

    // checkCall in hir_builder.cpp: verify the argument count and the
    // argument types against the callee signature.  Missing arguments with
    // a default value are filled in at the call site; the new argument
    // count is returned.
    long check_call(long fnIdx, long argstart, long argcount, long line, long col) {
        if (fnIdx < 0) {
            return argcount;
        }
        HFunction hf;
        unsafe {
            hf = this.u.fns[fnIdx];
        }
        long expected = hf.pn;
        long actual = argcount;
        long variadic = hf.is_extern_c;
        if (actual < expected && variadic == 0) {
            long i = actual;
            while (i < expected) {
                HParam p;
                unsafe {
                    p = this.u.params[hf.pstart + i];
                }
                if (p.default_value < 0) {
                    this.err_call_missing_arg(line, col, hf.name, i + 1, p.name);
                    return actual;
                }
                long de = this.build_expr(p.default_value);
                this.push_arg(de);
                actual = actual + 1;
                i = i + 1;
            }
        }
        if (expected > actual || (variadic == 0 && expected != actual)) {
            this.err_call_arity(line, col, hf.name, expected, actual);
            return actual;
        }
        long i = 0;
        while (i < expected && i < actual) {
            HParam p;
            unsafe {
                p = this.u.params[hf.pstart + i];
            }
            long ai = -1;
            unsafe {
                ai = this.u.args[argstart + i];
            }
            HExpr ae;
            unsafe {
                ae = this.u.exprs[ai];
            }
            if (this.is_assignable(p.type, ae.type) == 0) {
                this.err_call_arg_type(ae.line, ae.col, hf.name, i + 1, p.type, ae.type);
            }
            i = i + 1;
        }
        return actual;
    }

    long build_call(AExpr a) {
        HExpr e = this.new_expr(12, a.line, a.col);
        AExpr ca = this.get_expr(a.a);

        if (ca.kind == 15 && ca.is_scope == 0) {
            // Method call: obj.method(args) / obj->method(args).
            // Arguments are built before the receiver (matches the oracle).
            long total = a.an + 1;
            long slot = this.ab_n_;
            this.ab_n_ = this.ab_n_ + total;
            long j = 0;
            while (j < a.an) {
                long ai = -1;
                unsafe {
                    ai = this.pa.call_args()[a.astart + j];
                }
                long he = this.build_expr(ai);
                unsafe {
                    this.abuf_[slot + 1 + j] = he;
                }
                j = j + 1;
            }
            long base = this.build_expr(ca.a);
            long recv = base;
            HExpr be;
            unsafe {
                be = this.u.exprs[base];
            }
            AType bt = be.type;
            long arrow_bad = 0;
            long mfn = -1;
            long si = -1;
            if (ca.flag == 0) {
                bt.is_ref = 0;
            } else if (bt.ptr_depth > 0) {
                bt.ptr_depth = bt.ptr_depth - 1;
            } else {
                this.err_arrow_operand(a.line, a.col);
                arrow_bad = 1;
            }
            if (arrow_bad == 0) {
                if (ca.flag != 0) {
                    HExpr r = this.new_expr(14, ca.line, ca.col);
                    r.sval = ca.sval;
                    r.flag = 1;
                    r.a = base;
                    r.type = bt;
                    recv = this.push_expr(r);
                }
                long si2 = this.find_struct(bt.base);
                si = si2;
                if (si < 0) {
                    this.err_not_struct(a.line, a.col, bt, "call method", ca.sval);
                } else {
                    AStruct sd = this.get_struct(si);
                    this.find_method_owner(sd, ca.sval);
                }
            }
            unsafe {
                this.abuf_[slot] = recv;
            }
            e.astart = this.u.a_n;
            long k = 0;
            while (k < total) {
                long ix = -1;
                unsafe {
                    ix = this.abuf_[slot + k];
                }
                this.push_arg(ix);
                k = k + 1;
            }
            e.an = total;
            if (arrow_bad == 0 && si >= 0) {
                // Resolve the method once the argument list is complete: the
                // receiver is passed as the implicit `this` argument.
                long fi = this.resolve_overload(this.tmp_, e.astart, e.an, a.line, a.col);
                if (fi >= 0) {
                    mfn = fi;
                    HFunction hf;
                    unsafe {
                        hf = this.u.fns[fi];
                    }
                    e.sval = hf.name;
                    e.type = hf.ret;
                } else if (this.count_fns(this.tmp_) == 0) {
                    AStruct sd = this.get_struct(si);
                    this.err_no_method(a.line, a.col, sd.name, ca.sval);
                }
            }
            if (mfn >= 0) {
                e.an = this.check_call(mfn, e.astart, e.an, a.line, a.col);
            }
            return this.push_expr(e);
        }

        // Arguments are built before callee resolution (matches the oracle).
        // A pack expansion in an argument position is expanded into one
        // argument per pack element.
        long total = a.an;
        long n1 = 0;
        while (n1 < a.an) {
            long ai1 = -1;
            unsafe {
                ai1 = this.pa.call_args()[a.astart + n1];
            }
            long pat1 = this.arg_pack_pattern(ai1);
            if (pat1 >= 0) {
                long cnt1 = this.pack_expand_count(pat1);
                if (cnt1 >= 0) {
                    total = total + cnt1 - 1;
                } else {
                    // An unknown pack expands to nothing: the argument is
                    // dropped (the oracle pushes no argument for it).
                    total = total - 1;
                }
            }
            n1 = n1 + 1;
        }
        // The scratch buffer must hold every expanded argument.
        if (this.ab_n_ + total > this.ab_cap_) {
            total = a.an;
        }
        long slot = this.ab_n_;
        this.ab_n_ = this.ab_n_ + total;
        long wrote = slot;
        long n2 = 0;
        while (n2 < a.an) {
            long ai2 = -1;
            unsafe {
                ai2 = this.pa.call_args()[a.astart + n2];
            }
            long patIdx = this.arg_pack_pattern(ai2);
            if (patIdx >= 0) {
                // A pack expansion: the pattern is built (the oracle
                // reports the undeclared identifier) and one argument per
                // pack element is spliced into the argument list.
                long pat = this.build_expr(patIdx);
                long cnt = this.pack_expand_count(patIdx);
                if (cnt < 0) {
                    // An unknown pack expands to nothing: the argument is
                    // dropped (the oracle pushes no argument for it).
                } else {
                    long k = 0;
                    while (k < cnt) {
                        HExpr id = this.new_expr(8, a.line, a.col);
                        HFunction cf;
                        HParam hp;
                        unsafe {
                            cf = this.u.fns[this.cur_fn_];
                            hp = this.u.params[cf.pstart + this.pack_first_ + k];
                        }
                        id.sval = hp.name;
                        id.type = hp.type;
                        unsafe {
                            this.abuf_[wrote] = this.push_expr(id);
                        }
                        wrote = wrote + 1;
                        k = k + 1;
                    }
                }
            } else {
                long he = this.build_expr(ai2);
                unsafe {
                    this.abuf_[wrote] = he;
                }
                wrote = wrote + 1;
            }
            n2 = n2 + 1;
        }
        e.astart = this.u.a_n;
        long k = 0;
        while (k < total) {
            long ix = -1;
            unsafe {
                ix = this.abuf_[slot + k];
            }
            this.push_arg(ix);
            k = k + 1;
        }
        e.an = total;

        // A4/B3: the `move(expr)` builtin (hir_builder.cpp:2932-2963).  It is
        // recognised *before* any callee resolution, so it shadows a
        // user-defined function, a template or a local variable named
        // `move` - the oracle checks the builtin at :2937, before the
        // operator-overload probe (:2969), the template-id call (:3044) and
        // the ordinary overload resolution (:3119).  It applies only when
        // the callee is the bare name `move`, the call has exactly one
        // *built* argument and that argument is an identifier.  The call node
        // is kept (the dump shows `call 'move' : <operand type>`) and the
        // operand is marked as moved-out.
        if (ca.kind == 8 && this.seq(ca.sval, "move") && e.an == 1) {
            long ai = -1;
            unsafe {
                ai = this.abuf_[slot];
            }
            HExpr ae;
            unsafe {
                ae = this.u.exprs[ai];
            }
            if (ae.kind == 8) {
                this.mark_moved_out(ae.sval, a.line, a.col);
                e.sval = ca.sval;
                e.type = ae.type;
                return this.push_expr(e);
            }
        }

        if (ca.kind == 8) {
            // A template-id call: `func<T>(args)`.
            if (a.tpl_n > 0) {
                // The oracle looks up the struct-template registry BEFORE the
                // function-template registry (buildCall in hir_builder.cpp),
                // so a name that is both a struct template and a function
                // template is resolved as the struct template.
                long stplIdx = this.find_struct_template(ca.sval);
                if (stplIdx >= 0) {
                    // The struct template is instantiated with the explicit
                    // arguments (substituted with the active type mapping,
                    // like the oracle's `currentTypeMapping_`).
                    unsafe {
                        AType* targs = this.alloc_types(a.tpl_n);
                        long k = 0;
                        while (k < a.tpl_n && targs != (AType*)0) {
                            AType ta = a.tpl_args[k];
                            targs[k] = this.substitute_type(ta, this.gmap_base_);
                            k = k + 1;
                        }
                        this.instantiate_struct_template(stplIdx, ca.sval, targs,
                                                         a.tpl_n, a.line, a.col);
                    }
                    // The oracle resolves the constructor of the
                    // specialization.  The port has no constructor
                    // resolution (deferred), so the call stays unresolved:
                    // the callee keeps the bare name and the type is the
                    // dummy type - exactly what the oracle produces for a
                    // specialization without a constructor.
                    e.sval = ca.sval;
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                long tplIdx = this.find_template(ca.sval);
                if (tplIdx < 0) {
                    // The oracle builds the callee expression (which reports
                    // the undeclared identifier) and then reports that the
                    // name is not a template.
                    if (this.count_fns(ca.sval) == 0 &&
                        this.find_sym(ca.sval) < 0 &&
                        this.find_global_enum(ca.sval) < 0) {
                        this.err_undeclared(ca.line, ca.col, ca.sval);
                    }
                    this.err_not_a_template(a.line, a.col, ca.sval);
                    e.sval = ca.sval;
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                // The explicit template arguments.  Inside a struct
                // template the arguments are substituted with the active
                // type mapping (the oracle's `currentTypeMapping_`), so
                // `id<T>(x)` instantiates `id<int32_t>`.
                long fi = -1;
                unsafe {
                    AType* targs = this.alloc_types(a.tpl_n);
                    long k = 0;
                    while (k < a.tpl_n && targs != (AType*)0) {
                        AType ta = a.tpl_args[k];
                        targs[k] = this.substitute_type(ta, this.gmap_base_);
                        k = k + 1;
                    }
                    fi = this.instantiate_template(tplIdx, targs, a.tpl_n,
                                                  a.line, a.col);
                }
                if (fi < 0) {
                    this.err_failed_instantiate(a.line, a.col, ca.sval);
                    e.sval = ca.sval;
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                HFunction hf;
                unsafe {
                    hf = this.u.fns[fi];
                }
                e.sval = hf.name;
                e.type = hf.ret;
                e.an = this.check_call(fi, e.astart, e.an, a.line, a.col);
                long folded = this.try_fold_constexpr_call(fi, e.astart, e.an,
                                                          a.line, a.col);
                if (folded >= 0) {
                    return folded;
                }
                return this.push_expr(e);
            }
            long fi = this.resolve_overload(ca.sval, e.astart, e.an, a.line, a.col);
            if (fi >= 0) {
                HFunction hf;
                unsafe {
                    hf = this.u.fns[fi];
                }
                e.sval = hf.name;
                e.type = hf.ret;
                e.an = this.check_call(fi, e.astart, e.an, a.line, a.col);
                // --- constexpr folding ---
                long folded = this.try_fold_constexpr_call(fi, e.astart, e.an,
                                                          a.line, a.col);
                if (folded >= 0) {
                    return folded;
                }
                return this.push_expr(e);
            }
            if (this.count_fns(ca.sval) != 0) {
                // Overload resolution already reported the problem.
                e.sval = ca.sval;
                e.type = this.ty_dummy();
                return this.push_expr(e);
            }
            // An implicit instantiation: `func(args)` where `func` is a
            // template and there is no ordinary overload.
            long tplIdx = this.find_template(ca.sval);
            if (tplIdx >= 0) {
                AFunction tpl = this.pa.get_fn(tplIdx);
                long cap = tpl.tpl_n + e.an + 4;
                long dedN = -1;
                long tfi = -1;
                unsafe {
                    AType* ded = this.alloc_types(cap);
                    if (ded != (AType*)0) {
                        dedN = this.deduce_template_args(tplIdx, e.astart, e.an,
                                                         ded, cap);
                    }
                    if (dedN >= 0) {
                        tfi = this.instantiate_template(tplIdx, ded, dedN,
                                                         a.line, a.col);
                    }
                }
                if (dedN < 0) {
                    this.err_cannot_deduce(a.line, a.col, ca.sval);
                    e.sval = ca.sval;
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                if (tfi < 0) {
                    this.err_failed_to_deduce(a.line, a.col, ca.sval);
                    e.sval = ca.sval;
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                HFunction hf;
                unsafe {
                    hf = this.u.fns[tfi];
                }
                e.sval = hf.name;
                e.type = hf.ret;
                e.an = this.check_call(tfi, e.astart, e.an, a.line, a.col);
                long folded = this.try_fold_constexpr_call(tfi, e.astart, e.an,
                                                          a.line, a.col);
                if (folded >= 0) {
                    return folded;
                }
                return this.push_expr(e);
            }
            if (this.find_sym(ca.sval) < 0 && this.find_global_enum(ca.sval) < 0 &&
                this.find_struct_template(ca.sval) < 0) {
                // A struct template is not an identifier: the oracle does
                // not build the callee expression for it, so there is no
                // "undeclared identifier" diagnostic.
                this.err_undeclared(ca.line, ca.col, ca.sval);
            }
            if (this.is_builtin_fn(ca.sval) == 0) {
                this.err_call_undeclared(ca.line, ca.col, ca.sval);
            }
            e.sval = ca.sval;
            if (this.is_builtin_fn(ca.sval) != 0) {
                e.type = this.builtin_ret(ca.sval);
            } else {
                e.type = this.ty_dummy();
            }
            return this.push_expr(e);
        }
        if (ca.kind == 15 && ca.is_scope != 0) {
            this.db_start_ = this.db_n_;
            if (this.flatten_chain(a.a) != 0) {
                this.tmp_ = this.db_end();
                long fi = this.resolve_overload(this.tmp_, e.astart, e.an, a.line, a.col);
                if (fi >= 0) {
                    HFunction hf;
                    unsafe {
                        hf = this.u.fns[fi];
                    }
                    e.sval = hf.name;
                    e.type = hf.ret;
                    e.an = this.check_call(fi, e.astart, e.an, a.line, a.col);
                    return this.push_expr(e);
                }
                if (this.count_fns(this.tmp_) != 0) {
                    e.sval = this.tmp_;
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                if (this.is_builtin_fn(this.tmp_) != 0) {
                    e.sval = this.tmp_;
                    e.type = this.builtin_ret(this.tmp_);
                    return this.push_expr(e);
                }
                this.err_call_undeclared(ca.line, ca.col, this.tmp_);
                e.sval = this.tmp_;
                e.type = this.ty_dummy();
                return this.push_expr(e);
            }
        }
        this.diag(ca.line, ca.col, "callee must be a function name");
        e.type = this.ty_dummy();
        return this.push_expr(e);
    }

    long build_expr(long idx) {
        AExpr a = this.get_expr(idx);
        if (a.kind == 1) {
            HExpr e = this.new_expr(1, a.line, a.col);
            e.ival = a.ival;
            e.type = this.ty_int();
            return this.push_expr(e);
        }
        if (a.kind == 2) {
            HExpr e = this.new_expr(2, a.line, a.col);
            e.sval = a.sval;
            e.fval = a.fval;
            e.type = this.ty_double();
            return this.push_expr(e);
        }
        if (a.kind == 3) {
            HExpr e = this.new_expr(3, a.line, a.col);
            e.sval = a.sval;
            AType t = this.ty_empty();
            t.base = "char";
            t.is_const = 1;
            t.ptr_depth = 1;
            e.type = t;
            return this.push_expr(e);
        }
        if (a.kind == 4) {
            HExpr e = this.new_expr(4, a.line, a.col);
            e.sval = a.sval;
            e.type = this.ty_char();
            return this.push_expr(e);
        }
        if (a.kind == 5) {
            HExpr e = this.new_expr(5, a.line, a.col);
            e.ival = a.flag;
            e.type = this.ty_bool();
            return this.push_expr(e);
        }
        if (a.kind == 6) {
            HExpr e = this.new_expr(6, a.line, a.col);
            this.require_unsafe(a.line, a.col, "'nullptr' literal");
            e.type = this.ty_nullptr();
            return this.push_expr(e);
        }
        if (a.kind == 7) {
            HExpr e = this.new_expr(6, a.line, a.col);
            AType t = this.ty_empty();
            t.base = "nullopt";
            e.type = t;
            return this.push_expr(e);
        }
        if (a.kind == 8) {
            return this.build_ident(a);
        }
        if (a.kind == 9) {
            return this.build_this(a);
        }
        if (a.kind == 10) {
            return this.build_unary(a);
        }
        if (a.kind == 11) {
            return this.build_binary(a);
        }
        if (a.kind == 12) {
            return this.build_ternary(a);
        }
        if (a.kind == 13) {
            return this.build_call(a);
        }
        if (a.kind == 14) {
            return this.build_index(a);
        }
        if (a.kind == 15) {
            return this.build_member(a);
        }
        if (a.kind == 17) {
            // A pack expansion: `expr...`.  The pattern is built (the
            // pack name is not a scope name, so the oracle reports an
            // undeclared identifier).  A call splices the pack elements
            // into its argument list; everywhere else the expansion has
            // the dummy type.
            long pat = this.build_expr(a.a);
            HExpr pe;
            unsafe {
                pe = this.u.exprs[pat];
            }
            HExpr e = this.new_expr(8, a.line, a.col);
            e.sval = pe.sval;
            e.type = this.ty_dummy();
            return this.push_expr(e);
        }
        if (a.kind == 16) {
            return this.build_assign(a);
        }
        if (a.kind == 18) {
            // 8.3: sizeof(type) folds to an integer literal at build time.
            AType t = this.resolve_alias(a.type);
            HExpr e = this.new_expr(1, a.line, a.col);
            e.ival = this.type_size(t);
            e.type = this.ty_int64();
            return this.push_expr(e);
        }
        if (a.kind == 19) {
            // 8.3: alignof(type) folds to an integer literal at build time.
            AType t = this.resolve_alias(a.type);
            HExpr e = this.new_expr(1, a.line, a.col);
            e.ival = this.type_align(t);
            e.type = this.ty_int64();
            return this.push_expr(e);
        }
        if (a.kind == 20) {
            return this.build_cast(a);
        }
        HExpr e = this.new_expr(8, a.line, a.col);
        e.type = this.ty_dummy();
        return this.push_expr(e);
    }

    // Find the method `name` in the struct's method table or in one of its
    // base classes (the oracle copies the base method tables into the
    // derived struct).  The qualified method name is left in `this.tmp_`.
    // Returns 1 when the method was found.
    bool find_method_owner(AStruct sd, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put(sd.name);
        this.db_put("::");
        this.db_put(name);
        this.tmp_ = this.db_end();
        if (this.count_fns(this.tmp_) != 0) {
            return true;
        }
        long k = 0;
        while (k < sd.nbases) {
            this.load_base(sd, k);
            long bi = this.find_struct(this.base_name_);
            if (bi >= 0) {
                AStruct bs = this.get_struct(bi);
                if (this.find_method_owner(bs, name)) {
                    return true;
                }
            }
            k = k + 1;
        }
        return false;
    }

    // Find the struct in the inheritance chain that declares the
    // `operator<op>` method.  The oracle copies the base method tables
    // into the derived struct, so an inherited operator is found through
    // the base.  Returns 1 when an owner was found; the qualified method
    // name is left in `op_name_`.
    bool find_operator_owner(AStruct sd, const char* op) {
        this.db_start_ = this.db_n_;
        this.db_put(sd.name);
        this.db_put("::operator");
        this.db_put(op);
        this.op_name_ = this.db_end();
        if (this.count_fns(this.op_name_) != 0) {
            this.op_owner_ = sd.name;
            return true;
        }
        long k = 0;
        while (k < sd.nbases) {
            this.load_base(sd, k);
            long bi = this.find_struct(this.base_name_);
            if (bi >= 0) {
                AStruct bs = this.get_struct(bi);
                if (this.find_operator_owner(bs, op)) {
                    return true;
                }
            }
            k = k + 1;
        }
        return false;
    }

    // tryOperatorOverload in hir_builder.cpp: rewrite `base op rhs` as a
    // call to the struct's `operator<op>` method with the base injected as
    // the implicit `this` argument.  Returns the call expression index, or
    // -1 when the struct declares no matching operator.
    long try_operator_overload(long baseIdx, const char* op, long rhsIdx,
                               long line, long col) {
        HExpr be;
        unsafe {
            be = this.u.exprs[baseIdx];
        }
        AType bt = be.type;
        bt.is_ref = 0;
        // D4: no operator overload on pointers-to-struct.
        if (bt.ptr_depth > 0) {
            return -1;
        }
        long si = this.find_struct(bt.base);
        if (si < 0) {
            return -1;
        }
        AStruct sd = this.get_struct(si);
        if (this.find_operator_owner(sd, op) == 0) {
            return -1;
        }
        // Build the argument list: the base is the implicit `this`.
        long start = this.u.a_n;
        this.push_arg(baseIdx);
        long n = 1;
        if (rhsIdx >= 0) {
            this.push_arg(rhsIdx);
            n = 2;
        }
        long fi = this.resolve_overload(this.op_name_, start, n, line, col);
        if (fi < 0) {
            return -1;
        }
        HFunction hf;
        unsafe {
            hf = this.u.fns[fi];
        }
        HExpr e = this.new_expr(12, line, col);
        e.sval = hf.name;
        e.type = hf.ret;
        e.astart = start;
        e.an = n;
        long idx = this.push_expr(e);
        long cnt = this.check_call(fi, start, n, line, col);
        if (cnt != n) {
            unsafe {
                this.u.exprs[idx].an = cnt;
            }
        }
        return idx;
    }

    // Unary operators (buildExpr / Expr::Unary in hir_builder.cpp).
    long build_unary(AExpr a) {
        long opnd = this.build_expr(a.a);
        HExpr oe;
        unsafe {
            oe = this.u.exprs[opnd];
        }
        AType ot = oe.type;
        HExpr e = this.new_expr(9, a.line, a.col);
        e.sval = a.sval;
        e.flag = a.flag;
        e.a = opnd;
        if (ot.ptr_depth == 0 && this.is_struct_name(ot.base)) {
            // A struct operand needs an operator overload (7.4).
            long callIdx = this.try_operator_overload(opnd, a.sval, -1, a.line, a.col);
            if (callIdx >= 0) {
                return callIdx;
            }
            this.err_no_operator(a.line, a.col, ot, a.sval);
            e.type = this.ty_dummy();
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "!")) {
            if (this.is_numeric(ot) == 0 && ot.ptr_depth == 0) {
                this.err_unary_operand(a.line, a.col, "'!' expects a numeric or pointer operand");
            }
            e.type = this.ty_bool();
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "~")) {
            if (this.is_integer_like(ot) == 0) {
                this.err_unary_operand(a.line, a.col, "'~' expects an integer operand");
            }
            e.type = this.strip_ref(ot);
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "-") || this.seq(a.sval, "+")) {
            if (this.is_numeric(ot) == 0) {
                this.err_unary_op(a.line, a.col, "numeric", a.sval);
            }
            e.type = this.strip_ref(ot);
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "*")) {
            if (ot.ptr_depth == 0) {
                this.err_unary_operand(a.line, a.col, "'*' expects a pointer operand");
                e.type = this.ty_dummy();
                return this.push_expr(e);
            }
            this.require_unsafe(a.line, a.col, "pointer dereference");
            ot.ptr_depth = ot.ptr_depth - 1;
            e.type = ot;
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "&")) {
            if (oe.kind != 8) {
                this.err_unary_operand(a.line, a.col,
                    "'&' is only supported on variables in the Ivy subset");
                e.type = this.ty_dummy();
                return this.push_expr(e);
            }
            this.require_unsafe(a.line, a.col,
                "address-of operator '&' taking raw pointer");
            ot.ptr_depth = ot.ptr_depth + 1;
            e.type = ot;
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "++") || this.seq(a.sval, "--")) {
            if (ot.ptr_depth > 0) {
                this.require_unsafe(a.line, a.col, "pointer increment/decrement");
            } else if (this.is_numeric(ot) == 0) {
                this.db_start_ = this.db_n_;
                this.db_put("'");
                this.db_put(a.sval);
                this.db_put("' expects a numeric or pointer operand");
                this.diag(a.line, a.col, this.db_end());
            }
            e.type = ot;
            return this.push_expr(e);
        }
        e.type = this.ty_dummy();
        return this.push_expr(e);
    }

    // Binary operators (buildExpr / Expr::Binary in hir_builder.cpp).
    long build_binary(AExpr a) {
        long lhs = this.build_expr(a.a);
        long rhs = this.build_expr(a.b);
        HExpr le;
        HExpr re;
        unsafe {
            le = this.u.exprs[lhs];
            re = this.u.exprs[rhs];
        }
        AType lt = le.type;
        AType rt = re.type;
        HExpr e = this.new_expr(10, a.line, a.col);
        e.sval = a.sval;
        e.a = lhs;
        e.b = rhs;
        bool lnum = this.is_numeric(lt);
        bool rnum = this.is_numeric(rt);
        bool lptr = lt.ptr_depth > 0;
        bool rptr = rt.ptr_depth > 0;
        bool lnull = this.seq(lt.base, "nullptr");
        bool rnull = this.seq(rt.base, "nullptr");

        if (lt.ptr_depth == 0 && this.is_struct_name(lt.base)) {
            // A struct operand needs an operator overload (7.4).
            long callIdx = this.try_operator_overload(lhs, a.sval, rhs, a.line, a.col);
            if (callIdx >= 0) {
                return callIdx;
            }
            this.err_no_operator(a.line, a.col, lt, a.sval);
            e.type = this.ty_dummy();
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "==") || this.seq(a.sval, "!=")) {
            bool ok = (lnum && rnum) || (lptr && rptr) ||
                      (lnull && rptr) || (rnull && lptr);
            if (ok == 0) {
                this.err_binary_incompatible(a.line, a.col, a.sval);
            }
            e.type = this.ty_bool();
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "<") || this.seq(a.sval, ">") ||
            this.seq(a.sval, "<=") || this.seq(a.sval, ">=")) {
            if (lptr || rptr) {
                if (lptr == 0 || rptr == 0) {
                    this.err_binary_ptr_mixed(a.line, a.col, a.sval);
                }
            } else if (lnum == 0 || rnum == 0) {
                this.err_binary_expects(a.line, a.col, a.sval, "numeric");
            }
            e.type = this.ty_bool();
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "&&") || this.seq(a.sval, "||")) {
            if ((lnum || lptr) == 0 || (rnum || rptr) == 0) {
                this.err_binary_expects(a.line, a.col, a.sval, "numeric or pointer");
            }
            e.type = this.ty_bool();
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "<<") || this.seq(a.sval, ">>") ||
            this.seq(a.sval, "&") || this.seq(a.sval, "|") ||
            this.seq(a.sval, "^")) {
            if (lnum == 0 || rnum == 0) {
                this.err_binary_expects(a.line, a.col, a.sval, "integer");
            }
            e.type = this.promote(lt, rt);
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "+") || this.seq(a.sval, "-")) {
            if (lptr || rptr) {
                this.require_unsafe(a.line, a.col, "pointer arithmetic");
                if (lptr && rptr) {
                    this.diag(a.line, a.col,
                        "pointer subtraction is not supported in the Ivy subset");
                    e.type = this.ty_dummy();
                    return this.push_expr(e);
                }
                if (lptr && rnum == 0) {
                    this.err_ptr_non_numeric(a.line, a.col, a.sval);
                }
                if (rptr && lnum == 0) {
                    this.err_ptr_non_numeric(a.line, a.col, a.sval);
                }
                if (lptr) { e.type = lt; } else { e.type = rt; }
                return this.push_expr(e);
            }
            if (lnum == 0 || rnum == 0) {
                this.err_binary_expects(a.line, a.col, a.sval, "numeric");
                e.type = this.ty_dummy();
                return this.push_expr(e);
            }
            e.type = this.promote(lt, rt);
            return this.push_expr(e);
        }
        if (this.seq(a.sval, "*") || this.seq(a.sval, "/") ||
            this.seq(a.sval, "%")) {
            if (lnum == 0 || rnum == 0) {
                this.err_binary_expects(a.line, a.col, a.sval, "numeric");
                e.type = this.ty_dummy();
                return this.push_expr(e);
            }
            if (this.seq(a.sval, "%") &&
                (this.is_integer_like(lt) == 0 || this.is_integer_like(rt) == 0)) {
                this.err_binary_expects(a.line, a.col, "%", "integer");
            }
            e.type = this.promote(lt, rt);
            return this.push_expr(e);
        }
        e.type = this.ty_dummy();
        return this.push_expr(e);
    }

    // Ternary operator (buildExpr / Expr::Ternary in hir_builder.cpp).
    long build_ternary(AExpr a) {
        long cond = this.build_expr(a.a);
        this.check_condition(cond);
        long thenb = this.build_expr(a.b);
        long elseb = this.build_expr(a.c);
        HExpr te;
        HExpr ee;
        unsafe {
            te = this.u.exprs[thenb];
            ee = this.u.exprs[elseb];
        }
        HExpr e = this.new_expr(11, a.line, a.col);
        e.a = cond;
        e.b = thenb;
        e.c = elseb;
        AType t = this.promote(te.type, ee.type);
        if (this.seq(t.base, "char") || this.seq(t.base, "bool") ||
            this.seq(t.base, "void") || this.slen(t.base) == 0) {
            t = te.type;
        }
        e.type = t;
        return this.push_expr(e);
    }

    // Subscript operator (buildExpr / Expr::Index in hir_builder.cpp).
    long build_index(AExpr a) {
        long base = this.build_expr(a.a);
        long index = this.build_expr(a.b);
        HExpr be;
        unsafe {
            be = this.u.exprs[base];
        }
        AType t = be.type;
        HExpr e = this.new_expr(13, a.line, a.col);
        e.a = base;
        e.b = index;
        if (t.array_size == 0 && t.ptr_depth == 0 && this.is_struct_name(t.base)) {
            // A struct operand needs an `operator[]` overload (7.4).
            long callIdx = this.try_operator_overload(base, "[]", index, a.line, a.col);
            if (callIdx >= 0) {
                return callIdx;
            }
            this.err_no_operator(a.line, a.col, t, "[]");
            e.type = this.ty_dummy();
        } else if (t.array_size > 0) {
            t.array_size = 0;
            e.type = t;
        } else if (t.ptr_depth > 0) {
            this.require_unsafe(a.line, a.col, "pointer indexing");
            t.ptr_depth = t.ptr_depth - 1;
            e.type = t;
        } else {
            this.diag(a.line, a.col, "'[]' requires an array or pointer operand");
            e.type = this.ty_dummy();
        }
        if (index >= 0) {
            HExpr ie;
            unsafe {
                ie = this.u.exprs[index];
            }
            if (this.is_numeric(ie.type) == 0) {
                this.diag(ie.line, ie.col, "index expression must be numeric");
            }
        }
        return this.push_expr(e);
    }

    // Assignment (buildExpr / Expr::Assign in hir_builder.cpp).
    long build_assign(AExpr a) {
        // A4: the left-hand side of an assignment bypasses the
        // use-after-move check - for every identifier in the left-hand side
        // expression, at any nesting depth.  The right-hand side is always
        // checked.
        this.in_assign_lhs_ = 1;
        long lhs = this.build_expr(a.a);
        this.in_assign_lhs_ = 0;
        long rhs = this.build_expr(a.b);
        HExpr le;
        HExpr re;
        unsafe {
            le = this.u.exprs[lhs];
            re = this.u.exprs[rhs];
        }
        HExpr e = this.new_expr(15, a.line, a.col);
        e.sval = a.sval;
        e.a = lhs;
        e.b = rhs;
        e.type = le.type;
        bool lhs_var = le.kind == 8;
        bool lhs_idx = le.kind == 13;
        bool lhs_mem = le.kind == 14;
        bool lhs_deref = false;
        if (le.kind == 9 && le.flag != 0 && this.seq(le.sval, "*")) {
            lhs_deref = true;
        }
        bool lhs_call_ref = false;
        if (le.kind == 12 && le.type.is_ref != 0) {
            lhs_call_ref = true;
        }
        if (lhs_var == 0 && lhs_idx == 0 && lhs_mem == 0 &&
            lhs_deref == 0 && lhs_call_ref == 0) {
            this.diag(a.line, a.col, "left-hand side of assignment is not assignable");
        } else if (this.seq(a.sval, "=")) {
            if (le.type.is_const != 0 && le.type.ptr_depth == 0) {
                this.diag(a.line, a.col, "cannot assign to const variable");
            } else if (this.is_assignable(le.type, re.type) == 0) {
                this.err_assign_types(a.line, a.col, le.type, re.type);
            } else {
                // B5 / B6: materialise an expected<T, E> / optional<T>.
                e.b = this.wrap_value(le.type, rhs, a.line, a.col);
            }
        } else {
            if (this.is_numeric(le.type) == 0 || this.is_numeric(re.type) == 0) {
                this.err_compound_assign(a.line, a.col, a.sval);
            }
        }
        // A4: a re-assignment re-initializes a moved-out variable.  Only the
        // plain `=` operator does, and only when the left-hand side is a
        // plain identifier.
        if (this.seq(a.sval, "=") && le.kind == 8) {
            this.reinitialize(le.sval);
        }
        return this.push_expr(e);
    }

    // Explicit cast (buildExpr / Expr::Cast in hir_builder.cpp).
    long build_cast(AExpr a) {
        AType target = this.resolve_alias(a.type);
        target.is_ref = 0;
        long opnd = this.build_expr(a.a);
        HExpr oe;
        unsafe {
            oe = this.u.exprs[opnd];
        }
        AType from = oe.type;
        from.is_ref = 0;
        HExpr e = this.new_expr(18, a.line, a.col);
        e.a = opnd;
        e.flag = a.flag;
        e.type = target;
        if (a.flag == 1) {
            // reinterpret_cast / C-style cast
            this.require_unsafe(a.line, a.col,
                a.flag == 1 ? "reinterpret_cast" : "C-style cast");
            bool ok = false;
            if (target.ptr_depth > 0 && from.ptr_depth > 0) {
                ok = true;
            } else if (target.ptr_depth > 0 && this.is_integer_base(from.base)) {
                ok = true;
            } else if (this.is_integer_base(target.base) && from.ptr_depth > 0) {
                ok = true;
            } else if (this.is_numeric(target) && this.is_numeric(from)) {
                ok = true;
            }
            if (ok == 0) {
                this.err_cast_convert(a.line, a.col, "reinterpret_cast", from, target);
            }
            return this.push_expr(e);
        }
        if (a.flag == 2) {
            // const_cast
            this.require_unsafe(a.line, a.col, "const_cast");
            if (!this.seq(target.base, from.base) ||
                target.ptr_depth != from.ptr_depth) {
                this.diag(a.line, a.col,
                    "const_cast: target type must match source type except for const qualifier");
            }
            return this.push_expr(e);
        }
        // static_cast
        bool ok = false;
        if (this.is_numeric(target) && this.is_numeric(from)) {
            ok = true;
        } else if (target.ptr_depth > 0 && from.ptr_depth > 0) {
            ok = this.seq(target.base, from.base) ||
                 this.seq(target.base, "void") || this.seq(from.base, "void");
        } else if (target.ptr_depth > 0 &&
                   (this.seq(from.base, "nullptr") || this.seq(from.base, "nullptr_t"))) {
            ok = true;
        } else if (target.ptr_depth > 0 && this.is_integer_base(from.base)) {
            ok = true;
        } else if (this.is_integer_base(target.base) && from.ptr_depth > 0) {
            ok = true;
        } else if (this.is_integer_base(target.base) && this.is_enum_name(from.base)) {
            ok = true;
        } else if (this.is_enum_name(target.base) && this.is_integer_base(from.base)) {
            ok = true;
        }
        if (ok == 0) {
            this.err_cast_convert(a.line, a.col, "static_cast", from, target);
        }
        return this.push_expr(e);
    }

    // --- compile-time constant evaluation ---------------------------------
    //
    // evalConstExpr / tryEvalConstexprCall in hir_builder.cpp: a tree
    // walking evaluator over the HIR expressions.  Only integer and float
    // literals, unary/binary arithmetic, the conditional operator and the
    // parameters of the constexpr function being folded are constants;
    // everything else (pointers, structs, strings, calls) fails gracefully.

    // IEEE negation of a double.  The code generator lowers the unary '-'
    // operator on a float to `0.0 - x`, which turns a negative zero into a
    // positive one; multiplying by -1.0 is the exact negation and keeps the
    // sign of zero (the oracle's constant folder negates the value).
    double neg_double(double v) {
        return v * -1.0;
    }

    // Add a chunk to the float text pool and make it the current one.
    void fchunk_add() {
        if (this.fchunk_n_ >= this.fchunk_cap_) {
            long ncap = this.fchunk_cap_ * 2;
            unsafe {
                char** np = (char**) __ivy_alloc(ncap * 8);
                if (np != (char**)0) {
                    __ivy_memcpy((void*)np, (void*)this.fchunks_,
                                 (unsigned long long)(this.fchunk_n_ * 8));
                    __ivy_free((void*)this.fchunks_);
                    this.fchunks_ = np;
                    this.fchunk_cap_ = ncap;
                }
            }
            if (this.fchunk_n_ >= this.fchunk_cap_) {
                this.fok_ = 0;
                return;
            }
        }
        unsafe {
            char* c = (char*) __ivy_alloc(this.fchunk_size_);
            if (c == (char*)0) {
                this.fok_ = 0;
                return;
            }
            this.fchunks_[this.fchunk_n_] = c;
            this.fchunk_n_ = this.fchunk_n_ + 1;
            this.fcur_ = c;
            this.fcur_n_ = 0;
            this.fok_ = 1;
        }
    }

    // Copy `n` bytes of `s` into the float text pool and return the copy.
    // The pool grows by adding a chunk: a truncated text would silently
    // change the folded value in the HIR dump.
    const char* intern_float_text(const char* s, long n) {
        if (this.fok_ == 0 || this.fcur_n_ + n + 1 > this.fchunk_size_) {
            this.fchunk_add();
            if (this.fok_ == 0) {
                return "";
            }
        }
        unsafe {
            __ivy_memcpy(this.fcur_ + this.fcur_n_, s, (unsigned long long)n);
            this.fcur_[this.fcur_n_ + n] = 0;
        }
        long start = this.fcur_n_;
        this.fcur_n_ = this.fcur_n_ + n + 1;
        unsafe {
            return this.fcur_ + start;
        }
        return "";
    }

    // The `i`-th digit (0 = most significant) of the six-digit number `d`.
    long digit_at(long d, long i) {
        if (i < 0 || i >= 6) {
            return 0;
        }
        long p = 100000;
        long k = 0;
        while (k < i) {
            p = p / 10;
            k = k + 1;
        }
        return (d / p) % 10;
    }

    // Render a double the way the oracle prints a float literal
    // (operator<<(ostream&, double), i.e. printf("%g") with six significant
    // digits in the C locale).  The result is interned in the float text
    // pool.
    const char* fmt_double(double v) {
        long n = 0;
        long neg = 0;
        if (v < 0.0) {
            neg = 1;
            v = -v;
        }
        if (v == 0.0) {
            // A negative zero keeps its sign: the C library prints "-0" for
            // it, and `-0.0 < 0.0` is false, so the sign is recovered from
            // 1.0 / v (which is -inf for a negative zero).
            if (neg == 0 && (1.0 / v) < 0.0) {
                neg = 1;
            }
            unsafe {
                if (neg != 0) {
                    this.fbuf_[0] = 45;
                    this.fbuf_[1] = 48;
                    this.fbuf_[2] = 0;
                } else {
                    this.fbuf_[0] = 48;
                    this.fbuf_[1] = 0;
                }
            }
            n = neg != 0 ? 2 : 1;
        } else {
            // The decimal exponent: 10^e <= v < 10^(e + 1).
            long e = 0;
            double p = 1.0;
            if (v >= 1.0) {
                while (v >= p * 10.0) {
                    p = p * 10.0;
                    e = e + 1;
                }
            } else {
                while (v < p) {
                    p = p * 0.1;
                    e = e - 1;
                }
            }
            // Scale the value to six significant digits.  The power of ten
            // is exact for the common exponents, so the scaled value carries
            // the full precision of the double.
            long k = 5 - e;
            double f = 1.0;
            if (k >= 0) {
                while (k > 0) {
                    f = f * 10.0;
                    k = k - 1;
                }
            } else {
                while (k < 0) {
                    f = f * 0.1;
                    k = k + 1;
                }
            }
            double scaled = v * f;
            // Round to the nearest integer, ties to even (like the C
            // library that formats the oracle's float literals).
            long d = static_cast<long>(scaled);
            double frac = scaled - static_cast<double>(d);
            if (frac > 0.5) {
                d = d + 1;
            } else if (frac == 0.5 && (d % 2) != 0) {
                d = d + 1;
            }
            if (d >= 1000000) {
                d = 100000;
                e = e + 1;
            }
            unsafe {
                if (neg != 0) {
                    this.fbuf_[n] = 45;
                    n = n + 1;
                }
                if (e < -4 || e >= 6) {
                    // Scientific layout: d.ddde+XX
                    this.fbuf_[n] = 48 + this.digit_at(d, 0);
                    n = n + 1;
                    long last = 5;
                    while (last > 1 && this.digit_at(d, last) == 0) {
                        last = last - 1;
                    }
                    if (last > 1) {
                        this.fbuf_[n] = 46;
                        n = n + 1;
                        long i = 1;
                        while (i <= last) {
                            this.fbuf_[n] = 48 + this.digit_at(d, i);
                            n = n + 1;
                            i = i + 1;
                        }
                    }
                    this.fbuf_[n] = 101;
                    n = n + 1;
                    if (e < 0) {
                        this.fbuf_[n] = 45;
                        n = n + 1;
                        e = 0 - e;
                    } else {
                        this.fbuf_[n] = 43;
                        n = n + 1;
                    }
                    if (e < 10) {
                        this.fbuf_[n] = 48;
                        n = n + 1;
                        this.fbuf_[n] = 48 + e;
                        n = n + 1;
                    } else if (e < 100) {
                        this.fbuf_[n] = 48 + (e / 10);
                        n = n + 1;
                        this.fbuf_[n] = 48 + (e % 10);
                        n = n + 1;
                    } else {
                        this.fbuf_[n] = 48 + (e / 100);
                        n = n + 1;
                        this.fbuf_[n] = 48 + ((e / 10) % 10);
                        n = n + 1;
                        this.fbuf_[n] = 48 + (e % 10);
                        n = n + 1;
                    }
                } else {
                    // Fixed layout: the point follows the first (e + 1) digits.
                    long point = e + 1;
                    if (point <= 0) {
                        this.fbuf_[n] = 48;
                        n = n + 1;
                        this.fbuf_[n] = 46;
                        n = n + 1;
                        long z = 0 - point;
                        while (z > 0) {
                            this.fbuf_[n] = 48;
                            n = n + 1;
                            z = z - 1;
                        }
                        long last = 5;
                        while (last >= 0 && this.digit_at(d, last) == 0) {
                            last = last - 1;
                        }
                        long i = 0;
                        while (i <= last) {
                            this.fbuf_[n] = 48 + this.digit_at(d, i);
                            n = n + 1;
                            i = i + 1;
                        }
                    } else if (point >= 6) {
                        long i = 0;
                        while (i < 6) {
                            this.fbuf_[n] = 48 + this.digit_at(d, i);
                            n = n + 1;
                            i = i + 1;
                        }
                    } else {
                        long i = 0;
                        while (i < point) {
                            this.fbuf_[n] = 48 + this.digit_at(d, i);
                            n = n + 1;
                            i = i + 1;
                        }
                        long last = 5;
                        while (last >= point && this.digit_at(d, last) == 0) {
                            last = last - 1;
                        }
                        if (last >= point) {
                            this.fbuf_[n] = 46;
                            n = n + 1;
                            i = point;
                            while (i <= last) {
                                this.fbuf_[n] = 48 + this.digit_at(d, i);
                                n = n + 1;
                                i = i + 1;
                            }
                        }
                    }
                }
                this.fbuf_[n] = 0;
            }
        }
        unsafe {
            return this.intern_float_text(this.fbuf_, n);
        }
        return "";
    }

    // Look up `name` in the parameters bound to the constexpr call that is
    // being folded.  Returns false when the name is not a bound parameter.
    bool eval_bound_param(const char* name) {
        long i = 0;
        while (i < this.cst_bn_) {
            unsafe {
                const char* nm = (char*)this.cst_bname_[i];
                if (this.seq(nm, name)) {
                    if (this.cst_bint_[i] != 0) {
                        this.cst_is_int_ = 1;
                        this.cst_i_ = this.cst_bi_[i];
                        this.cst_f_ = 0.0;
                    } else {
                        // A float keeps the integer field of the value it
                        // replaces (the oracle's ConstValue does the same).
                        this.cst_is_int_ = 0;
                        this.cst_f_ = this.cst_bf_[i];
                    }
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    // Reset the constant value.  The oracle evaluates every value that is
    // not shared with the caller in a fresh `ConstValue`, whose integer
    // field starts at zero.
    void cst_reset() {
        this.cst_is_int_ = 0;
        this.cst_i_ = 0;
        this.cst_f_ = 0.0;
    }

    // Evaluate the HIR expression `idx` as a compile-time constant.  The
    // value is left in cst_is_int_ / cst_i_ / cst_f_.
    bool eval_const_expr(long idx) {
        if (idx < 0) {
            return false;
        }
        HExpr e;
        unsafe {
            e = this.u.exprs[idx];
        }
        if (e.kind == 1) {
            this.cst_is_int_ = 1;
            this.cst_i_ = e.ival;
            this.cst_f_ = 0.0;
            return true;
        }
        if (e.kind == 2) {
            // A float literal keeps the integer field of the value it
            // replaces: the oracle's ConstValue is a single value that is
            // reused, and its integer field is only written by an integer
            // operation.  `!` and the condition of a conditional operator
            // read that field, so the two must agree.
            this.cst_is_int_ = 0;
            this.cst_f_ = e.fval;
            return true;
        }
        if (e.kind == 5) {
            this.cst_is_int_ = 1;
            this.cst_i_ = e.ival != 0 ? 1 : 0;
            this.cst_f_ = 0.0;
            return true;
        }
        if (e.kind == 6) {
            this.cst_is_int_ = 1;
            this.cst_i_ = 0;
            this.cst_f_ = 0.0;
            return true;
        }
        if (e.kind == 8) {
            // An identifier is only a constant when it is a parameter of the
            // constexpr function being folded; enum constants are folded to
            // integer literals by the builder.
            return this.eval_bound_param(e.sval);
        }
        if (e.kind == 9) {
            if (this.eval_const_expr(e.a) == 0) {
                return false;
            }
            if (e.flag != 0 && (this.seq(e.sval, "++") || this.seq(e.sval, "--"))) {
                return false;
            }
            if (this.seq(e.sval, "-")) {
                // Negate the value itself: the sign of a zero must be kept
                // (the oracle folds `-0.0` to a negative zero).
                this.cst_i_ = 0 - this.cst_i_;
                this.cst_f_ = this.neg_double(this.cst_f_);
                return true;
            }
            if (this.seq(e.sval, "+")) {
                return true;
            }
            if (this.seq(e.sval, "!")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = this.cst_i_ != 0 ? 0 : 1;
                return true;
            }
            if (this.seq(e.sval, "~")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = ~this.cst_i_;
                this.cst_f_ = 0.0;
                return true;
            }
            return false;
        }
        if (e.kind == 10) {
            if (this.seq(e.sval, "&&") || this.seq(e.sval, "||")) {
                // The left operand is evaluated in a fresh value (the
                // oracle's `lhs`), so its integer field starts at zero; the
                // right operand is evaluated in the value of the operator.
                long keep_int = this.cst_is_int_;
                long keep_i = this.cst_i_;
                double keep_f = this.cst_f_;
                this.cst_is_int_ = 0;
                this.cst_i_ = 0;
                this.cst_f_ = 0.0;
                long lok = this.eval_const_expr(e.a);
                long lb = this.cst_i_;
                this.cst_is_int_ = keep_int;
                this.cst_i_ = keep_i;
                this.cst_f_ = keep_f;
                if (lok == 0) {
                    return false;
                }
                if (this.seq(e.sval, "&&") && lb == 0) {
                    this.cst_is_int_ = 1;
                    this.cst_i_ = 0;
                    this.cst_f_ = 0.0;
                    return true;
                }
                if (this.seq(e.sval, "||") && lb != 0) {
                    this.cst_is_int_ = 1;
                    this.cst_i_ = 1;
                    this.cst_f_ = 0.0;
                    return true;
                }
                if (this.eval_const_expr(e.b) == 0) {
                    return false;
                }
                this.cst_is_int_ = 1;
                this.cst_i_ = this.cst_i_ != 0 ? 1 : 0;
                this.cst_f_ = 0.0;
                return true;
            }
            if (this.eval_const_expr(e.a) == 0) {
                return false;
            }
            long li = this.cst_i_;
            double lf = this.cst_f_;
            long lint = this.cst_is_int_;
            if (this.eval_const_expr(e.b) == 0) {
                return false;
            }
            long ri = this.cst_i_;
            double rf = this.cst_f_;
            long rint = this.cst_is_int_;
            if (lint != 0 && rint != 0) {
                this.cst_is_int_ = 1;
                this.cst_f_ = 0.0;
                if (this.seq(e.sval, "+")) { this.cst_i_ = li + ri; return true; }
                if (this.seq(e.sval, "-")) { this.cst_i_ = li - ri; return true; }
                if (this.seq(e.sval, "*")) { this.cst_i_ = li * ri; return true; }
                if (this.seq(e.sval, "/")) {
                    if (ri == 0) { return false; }
                    this.cst_i_ = li / ri;
                    return true;
                }
                if (this.seq(e.sval, "%")) {
                    if (ri == 0) { return false; }
                    this.cst_i_ = li % ri;
                    return true;
                }
                if (this.seq(e.sval, "==")) { this.cst_i_ = li == ri ? 1 : 0; return true; }
                if (this.seq(e.sval, "!=")) { this.cst_i_ = li != ri ? 1 : 0; return true; }
                if (this.seq(e.sval, "<")) { this.cst_i_ = li < ri ? 1 : 0; return true; }
                if (this.seq(e.sval, "<=")) { this.cst_i_ = li <= ri ? 1 : 0; return true; }
                if (this.seq(e.sval, ">")) { this.cst_i_ = li > ri ? 1 : 0; return true; }
                if (this.seq(e.sval, ">=")) { this.cst_i_ = li >= ri ? 1 : 0; return true; }
                if (this.seq(e.sval, "&")) { this.cst_i_ = li & ri; return true; }
                if (this.seq(e.sval, "|")) { this.cst_i_ = li | ri; return true; }
                if (this.seq(e.sval, "^")) { this.cst_i_ = li ^ ri; return true; }
                if (this.seq(e.sval, "<<")) { this.cst_i_ = li << ri; return true; }
                if (this.seq(e.sval, ">>")) { this.cst_i_ = li >> ri; return true; }
                return false;
            }
            double lv = lint != 0 ? static_cast<double>(li) : lf;
            double rv = rint != 0 ? static_cast<double>(ri) : rf;
            // A float result keeps the integer field of the value it
            // replaces (the oracle's ConstValue is reused).
            this.cst_is_int_ = 0;
            if (this.seq(e.sval, "+")) { this.cst_f_ = lv + rv; return true; }
            if (this.seq(e.sval, "-")) { this.cst_f_ = lv - rv; return true; }
            if (this.seq(e.sval, "*")) { this.cst_f_ = lv * rv; return true; }
            if (this.seq(e.sval, "/")) {
                if (rv == 0.0) { return false; }
                this.cst_f_ = lv / rv;
                return true;
            }
            if (this.seq(e.sval, "==")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = lv == rv ? 1 : 0;
                return true;
            }
            if (this.seq(e.sval, "!=")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = lv != rv ? 1 : 0;
                return true;
            }
            if (this.seq(e.sval, "<")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = lv < rv ? 1 : 0;
                return true;
            }
            if (this.seq(e.sval, "<=")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = lv <= rv ? 1 : 0;
                return true;
            }
            if (this.seq(e.sval, ">")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = lv > rv ? 1 : 0;
                return true;
            }
            if (this.seq(e.sval, ">=")) {
                this.cst_is_int_ = 1;
                this.cst_i_ = lv >= rv ? 1 : 0;
                return true;
            }
            return false;
        }
        if (e.kind == 11) {
            if (this.eval_const_expr(e.a) == 0) {
                return false;
            }
            if (this.cst_i_ != 0) {
                return this.eval_const_expr(e.b);
            }
            return this.eval_const_expr(e.c);
        }
        // A call inside a constexpr body is never folded.
        return false;
    }

    // Evaluate the HIR statement `idx` looking for the return statement of a
    // constexpr function body.
    bool eval_const_stmt(long idx) {
        HStmt s;
        unsafe {
            s = this.u.stmts[idx];
        }
        if (s.kind == 1) {
            long k = s.sstart;
            while (k >= 0) {
                if (this.eval_const_stmt(k)) {
                    return true;
                }
                unsafe {
                    k = this.u.stmts[k].next;
                }
            }
            return false;
        }
        if (s.kind == 7) {
            if (s.a < 0) {
                this.cst_is_int_ = 1;
                this.cst_i_ = 0;
                this.cst_f_ = 0.0;
                return true;
            }
            return this.eval_const_expr(s.a);
        }
        if (s.kind == 3) {
            // The condition is evaluated in a fresh value (the oracle's
            // `cond`), so its integer field starts at zero.
            long keep_int = this.cst_is_int_;
            long keep_i = this.cst_i_;
            double keep_f = this.cst_f_;
            this.cst_is_int_ = 0;
            this.cst_i_ = 0;
            this.cst_f_ = 0.0;
            long cok = this.eval_const_expr(s.a);
            long cond_i = this.cst_i_;
            this.cst_is_int_ = keep_int;
            this.cst_i_ = keep_i;
            this.cst_f_ = keep_f;
            if (cok == 0) {
                return false;
            }
            if (cond_i != 0) {
                if (s.b >= 0) {
                    return this.eval_const_stmt(s.b);
                }
                return false;
            }
            if (s.c >= 0) {
                return this.eval_const_stmt(s.c);
            }
            return false;
        }
        return false;
    }

    // tryEvalConstexprCall in hir_builder.cpp: evaluate a call to a
    // constexpr function at compile time and replace it with the resulting
    // literal.  Returns the index of the folded expression or -1.
    long try_fold_constexpr_call(long fnIdx, long argstart, long argcount,
                                  long line, long col) {
        HFunction hf;
        unsafe {
            hf = this.u.fns[fnIdx];
        }
        if (hf.is_constexpr == 0 || hf.body < 0 || argcount <= 0) {
            return -1;
        }
        // Every argument must be a literal.
        long i = 0;
        while (i < argcount) {
            long ai = -1;
            unsafe {
                ai = this.u.args[argstart + i];
            }
            HExpr ae;
            unsafe {
                ae = this.u.exprs[ai];
            }
            if (ae.kind != 1 && ae.kind != 2 && ae.kind != 5) {
                return -1;
            }
            i = i + 1;
        }
        // Bind the parameters to the argument values.
        long np = hf.pn;
        if (argcount < np) {
            np = argcount;
        }
        long save_bn = this.cst_bn_;
        this.cst_bn_ = 0;
        i = 0;
        while (i < np) {
            long ai = -1;
            unsafe {
                ai = this.u.args[argstart + i];
            }
            HExpr ae;
            unsafe {
                ae = this.u.exprs[ai];
            }
            HParam p;
            unsafe {
                p = this.u.params[hf.pstart + i];
                this.cst_bname_[this.cst_bn_] = (long)p.name;
                if (ae.kind == 2) {
                    this.cst_bint_[this.cst_bn_] = 0;
                    this.cst_bi_[this.cst_bn_] = 0;
                    this.cst_bf_[this.cst_bn_] = ae.fval;
                } else {
                    this.cst_bint_[this.cst_bn_] = 1;
                    if (ae.kind == 5) {
                        this.cst_bi_[this.cst_bn_] = ae.ival != 0 ? 1 : 0;
                    } else {
                        this.cst_bi_[this.cst_bn_] = ae.ival;
                    }
                    this.cst_bf_[this.cst_bn_] = 0.0;
                }
            }
            this.cst_bn_ = this.cst_bn_ + 1;
            i = i + 1;
        }
        // Look for the return statement in the body.  The value of the fold
        // starts fresh (the oracle's `result`).
        this.cst_reset();
        HStmt root;
        unsafe {
            root = this.u.stmts[hf.body];
        }
        long ok = 0;
        long k = root.sstart;
        while (k >= 0) {
            if (this.eval_const_stmt(k)) {
                ok = 1;
                break;
            }
            unsafe {
                k = this.u.stmts[k].next;
            }
        }
        this.cst_bn_ = save_bn;
        if (ok == 0) {
            return -1;
        }
        HExpr e = this.new_expr(1, line, col);
        e.type = hf.ret;
        if (this.cst_is_int_ != 0) {
            e.ival = this.cst_i_;
        } else {
            e.kind = 2;
            e.sval = this.fmt_double(this.cst_f_);
            e.fval = this.cst_f_;
        }
        return this.push_expr(e);
    }

    // --- the pack of the specialization that is being built -------------

    // Push the pack frame of a specialization.  The elements are the
    // parameters `first` .. `first + n` of the function.
    void push_pack_frame(const char* tname, const char* pname, long n, long first) {
        if (this.packdata_n_ + 4 > this.packdata_cap_) {
            return;
        }
        unsafe {
            this.packdata_[this.packdata_n_] = (long)tname;
            this.packdata_[this.packdata_n_ + 1] = (long)pname;
            this.packdata_[this.packdata_n_ + 2] = n;
            this.packdata_[this.packdata_n_ + 3] = first;
        }
        this.packframe_ = this.packdata_n_;
        this.packdata_n_ = this.packdata_n_ + 4;
    }

    // The number of elements of the pack named `name`, or -1 when there is
    // no such pack.  `pack_first_` is set to the index of the first
    // element in the parameters of the function that is being built.
    long pack_find(const char* name) {
        if (this.packframe_ < 0) {
            return -1;
        }
        long f = this.packframe_;
        unsafe {
            const char* tname = (char*)this.packdata_[f];
            const char* pname = (char*)this.packdata_[f + 1];
            if (!this.seq(name, tname) && !this.seq(name, pname)) {
                return -1;
            }
            this.pack_first_ = this.packdata_[f + 3];
            return this.packdata_[f + 2];
        }
        return -1;
    }

    // The number of elements a pack expansion expands to, or -1 when the
    // pack is unknown.
    long pack_expand_count(long patIdx) {
        AExpr pat = this.get_expr(patIdx);
        if (pat.kind != 8) {
            return -1;
        }
        return this.pack_find(pat.sval);
    }

    // The index of the pattern of a pack expansion argument, or -1 when
    // the argument is not a pack expansion.
    long arg_pack_pattern(long ai) {
        AExpr ae = this.get_expr(ai);
        if (ae.kind != 17) {
            return -1;
        }
        return ae.a;
    }

    // --- template instantiation (H4.4) -----------------------------------
    //
    // The oracle keeps the function templates in `templates_`, the built
    // specializations in `instantiated_` and the template-parameter
    // mapping of the specialization that is being built in a local
    // variable of `instantiateTemplate`.  The port mirrors that: the
    // mapping is only alive while the *signature* is substituted, so the
    // body of a function template is built without it (the oracle does not
    // set `currentTypeMapping_` for a function template either).

    // --- pooled strings -------------------------------------------------

    void sb_reset() {
        this.sb_n_ = 0;
    }

    // Make room for `need` bytes plus a terminating NUL.
    void sb_grow(long need) {
        if (this.sb_n_ + need + 1 <= this.sb_cap_) {
            return;
        }
        long ncap = this.sb_cap_ * 2;
        while (ncap < this.sb_n_ + need + 1) {
            ncap = ncap * 2;
        }
        unsafe {
            char* np = (char*) __ivy_alloc((unsigned long long)ncap);
            if (np == (char*)0) {
                return;
            }
            __ivy_memcpy((void*)np, (void*)this.sb_, (unsigned long long)this.sb_n_);
            __ivy_free(this.sb_);
            this.sb_ = np;
            this.sb_cap_ = ncap;
        }
    }

    void sb_put_char(char c) {
        this.sb_grow(1);
        unsafe {
            this.sb_[this.sb_n_] = c;
            this.sb_[this.sb_n_ + 1] = 0;
        }
        this.sb_n_ = this.sb_n_ + 1;
    }

    void sb_put(const char* s) {
        long n = this.slen(s);
        this.sb_grow(n);
        unsafe {
            __ivy_memcpy(this.sb_ + this.sb_n_, s, (unsigned long long)n);
            this.sb_[this.sb_n_ + n] = 0;
        }
        this.sb_n_ = this.sb_n_ + n;
    }

    void sb_put_num(long v) {
        long x = v;
        if (x < 0) {
            this.sb_put_char('-');
            x = 0 - x;
        }
        if (x == 0) {
            this.sb_put_char('0');
            return;
        }
        long start = this.sb_n_;
        while (x > 0) {
            this.sb_put_char(48 + (x % 10));
            x = x / 10;
        }
        long i = this.sb_n_ - 1;
        long j = start;
        while (i > j) {
            unsafe {
                char t = this.sb_[i];
                this.sb_[i] = this.sb_[j];
                this.sb_[j] = t;
            }
            i = i - 1;
            j = j + 1;
        }
    }

    // Make room for one more stable string in `strs_`.  The pool holds
    // pointers, so it can be reallocated.
    void strs_grow() {
        if (this.strs_n_ < this.strs_cap_) {
            return;
        }
        long ncap = this.strs_cap_ * 2;
        if (ncap < 64) {
            ncap = 64;
        }
        unsafe {
            long* np = (long*) __ivy_alloc((unsigned long long)(ncap * 8));
            if (np == (long*)0) {
                return;
            }
            __ivy_memcpy((void*)np, (void*)this.strs_,
                         (unsigned long long)(this.strs_n_ * 8));
            __ivy_free((void*)this.strs_);
            this.strs_ = np;
            this.strs_cap_ = ncap;
        }
    }

    // Copy the scratch buffer into a stable allocation and return it.
    const char* sb_save() {
        long n = this.sb_n_;
        unsafe {
            char* p = (char*) __ivy_alloc((unsigned long long)(n + 1));
            if (p == (char*)0) {
                return "";
            }
            __ivy_memcpy((void*)p, (void*)this.sb_, (unsigned long long)n);
            p[n] = 0;
            this.strs_grow();
            this.strs_[this.strs_n_] = (long)p;
            this.strs_n_ = this.strs_n_ + 1;
            return p;
        }
        return "";
    }

    // --- the pool of substituted template-argument lists ----------------

    void tpchunk_add() {
        if (this.tpchunk_n_ >= this.tpblk_cap_) {
            long ncap = this.tpblk_cap_ * 2;
            unsafe {
                long* np = (long*) __ivy_alloc((unsigned long long)(ncap * 8));
                if (np == (long*)0) {
                    this.tpok_ = 0;
                    return;
                }
                __ivy_memcpy((void*)np, (void*)this.tpchunks_,
                             (unsigned long long)(this.tpchunk_n_ * 8));
                __ivy_free((void*)this.tpchunks_);
                this.tpchunks_ = np;
                this.tpblk_cap_ = ncap;
            }
        }
        unsafe {
            AType* c = (AType*) __ivy_alloc((unsigned long long)(this.tpchunk_size_ * 48));
            if (c == (AType*)0) {
                this.tpok_ = 0;
                return;
            }
            this.tpchunks_[this.tpchunk_n_] = (long)c;
            this.tpchunk_n_ = this.tpchunk_n_ + 1;
            this.tpcur_ = c;
            this.tpcur_n_ = 0;
            this.tpok_ = 1;
        }
    }

    // Allocate `n` contiguous AType values in the pool.  The memory is
    // never reused: a substituted type keeps the pointer to its argument
    // list for the whole run of the builder.
    AType* alloc_types(long n) {
        unsafe {
            if (n <= 0) {
                return (AType*)0;
            }
            if (n > this.tpchunk_size_) {
                AType* p = (AType*) __ivy_alloc((unsigned long long)(n * 48));
                if (p == (AType*)0) {
                    return (AType*)0;
                }
                if (this.tpbig_n_ < this.tpbig_cap_) {
                    this.tpbig_[this.tpbig_n_] = (long)p;
                    this.tpbig_n_ = this.tpbig_n_ + 1;
                }
                return p;
            }
            if (this.tpok_ == 0 || this.tpcur_n_ + n > this.tpchunk_size_) {
                this.tpchunk_add();
                if (this.tpok_ == 0) {
                    return (AType*)0;
                }
            }
            AType* p = this.tpcur_ + this.tpcur_n_;
            this.tpcur_n_ = this.tpcur_n_ + n;
            return p;
        }
    }

    // --- the template-parameter mapping ---------------------------------

    // The index of the mapping entry for `name` in [base, map_n_), or -1.
    long map_find(const char* name, long base) {
        if (base < 0) {
            return -1;
        }
        long i = base;
        while (i < this.map_n_) {
            unsafe {
                if (this.seq((char*)this.map_name_[i], name)) {
                    return i;
                }
            }
            i = i + 1;
        }
        return -1;
    }

    // Map `name` to `t`.  An existing entry is replaced.
    void map_set(const char* name, AType t, long base) {
        long i = this.map_find(name, base);
        if (i >= 0) {
            unsafe {
                this.map_type_[i] = t;
            }
            return;
        }
        if (this.map_n_ < this.map_cap_) {
            unsafe {
                this.map_name_[this.map_n_] = (long)name;
                this.map_type_[this.map_n_] = t;
            }
            this.map_n_ = this.map_n_ + 1;
        }
    }

    // --- the template registry ------------------------------------------

    // The AST function index of the template named `name`, or -1.
    long find_template(const char* name) {
        long i = this.tpl_n_ - 1;
        while (i >= 0) {
            unsafe {
                if (this.seq((char*)this.tpl_name_[i], name)) {
                    return this.tpl_ast_[i];
                }
            }
            i = i - 1;
        }
        return -1;
    }

    // Register the template `astIdx`.  A second template with the same
    // name replaces the first one (the oracle keys `templates_` by name).
    void register_template(long astIdx) {
        AFunction af = this.pa.get_fn(astIdx);
        long i = 0;
        while (i < this.tpl_n_) {
            unsafe {
                if (this.seq((char*)this.tpl_name_[i], af.name)) {
                    this.tpl_ast_[i] = astIdx;
                    return;
                }
            }
            i = i + 1;
        }
        if (this.tpl_n_ < this.tpl_cap_) {
            unsafe {
                this.tpl_name_[this.tpl_n_] = (long)af.name;
                this.tpl_ast_[this.tpl_n_] = astIdx;
            }
            this.tpl_n_ = this.tpl_n_ + 1;
        }
    }

    // The HIR function index of the specialization `mangled`, or -1.
    long find_instantiated(const char* mangled) {
        long i = 0;
        while (i < this.inst_n_) {
            unsafe {
                if (this.seq((char*)this.inst_name_[i], mangled)) {
                    return this.inst_idx_[i];
                }
            }
            i = i + 1;
        }
        return -1;
    }

    void add_instantiated(const char* mangled, long idx) {
        if (this.inst_n_ < this.inst_cap_) {
            unsafe {
                this.inst_name_[this.inst_n_] = (long)mangled;
                this.inst_idx_[this.inst_n_] = idx;
            }
            this.inst_n_ = this.inst_n_ + 1;
        }
    }

    // The i-th template parameter of a function template.
    ATemplateParam get_tpl_param(AFunction af, long i) {
        unsafe {
            if (i < af.tpl_n) {
                return af.tpl_params[i];
            }
        }
        ATemplateParam tp;
        tp.name = "";
        tp.constraint = "";
        tp.is_typename = 0;
        tp.is_variadic = 0;
        tp.type = this.ty_empty();
        tp.line = 0;
        tp.col = 0;
        return tp;
    }

    // The i-th parameter of a function.
    AParam get_param(AFunction af, long i) {
        unsafe {
            if (i < af.nparams) {
                return af.params[i];
            }
        }
        AParam p;
        p.type = this.ty_empty();
        p.name = "";
        unsafe { p.attrs = (AAttr*)0; }
        p.nattrs = 0;
        p.line = 0;
        p.col = 0;
        p.default_value = -1;
        // A5: no lifetime annotation on a missing parameter.
        unsafe {
            p.lt_names.items = (ALifetime*)0;
            p.lt_names.n = 0;
            p.legacy_lts.items = (ALegacyLifetime*)0;
            p.legacy_lts.n = 0;
        }
        return p;
    }

    // The mangled name of a specialization: "<name><arg,arg,...>".  An
    // argument is the base name, " unsigned", " const" and the pointer
    // stars; the arguments are separated by a comma without a space.
    const char* mangle_args(const char* name, AType* args, long n) {
        unsafe {
        this.sb_reset();
        this.sb_put(name);
        this.sb_put("<");
        long i = 0;
        while (i < n) {
            AType a = args[i];
            if (i > 0) {
                this.sb_put(",");
            }
            this.sb_put(a.base);
            if (a.is_unsigned != 0) {
                this.sb_put(" unsigned");
            }
            if (a.is_const != 0) {
                this.sb_put(" const");
            }
            long d = 0;
            while (d < a.ptr_depth) {
                this.sb_put("*");
                d = d + 1;
            }
            i = i + 1;
        }
        this.sb_put(">");
        return this.sb_save();
        }
        return "";
    }

    // substituteType in hir_builder.cpp: replace the base name of a type
    // when it is a template parameter and recurse into the template
    // arguments.  The pointer depth, the reference-ness and the const
    // qualifier of the *declaration* are re-applied to the substituted
    // type (so a `T` deduced as `char const*` becomes a plain `char`).
    AType substitute_type(AType t, long base) {
        AType result = t;
        if (result.tpl_n > 0) {
            unsafe {
                AType* args = this.alloc_types(result.tpl_n);
                if (args != (AType*)0) {
                    long i = 0;
                    while (i < result.tpl_n) {
                        AType a = result.tpl_args[i];
                        AType s = this.substitute_type(a, base);
                        args[i] = s;
                        i = i + 1;
                    }
                    result.tpl_args = args;
                }
            }
        }
        long mi = this.map_find(result.base, base);
        if (mi >= 0) {
            AType sub;
            unsafe { sub = this.map_type_[mi]; }
            sub.ptr_depth = result.ptr_depth;
            sub.is_ref = result.is_ref;
            sub.is_const = result.is_const;
            return sub;
        }
        return result;
    }

    // deduceTemplateArgs in hir_builder.cpp: deduce the template
    // arguments of an implicit call.  The only deduction is "the
    // parameter type is exactly a type parameter"; the argument type is
    // taken as it is, so an integer literal deduces `int` (not `int32_t`).
    // Returns the number of deduced arguments, or -1 on failure.
    long deduce_template_args(long tplAstIdx, long argstart, long argcount,
                              AType* out, long outcap) {
        unsafe {
        AFunction tpl = this.pa.get_fn(tplAstIdx);
        long base = this.map_n_;
        // The type parameters: a non-type parameter is never deduced.
        long ntp = 0;
        long i = 0;
        while (i < tpl.tpl_n) {
            ATemplateParam tp = this.get_tpl_param(tpl, i);
            if (tp.is_typename != 0) {
                ntp = ntp + 1;
            }
            i = i + 1;
        }
        if (ntp == 0) {
            this.map_n_ = base;
            return -1;
        }
        // The variadic pack, if any.
        bool hasVariadic = false;
        long variadicIdx = 0;
        const char* vName = "";
        i = 0;
        while (i < tpl.tpl_n) {
            ATemplateParam tp = this.get_tpl_param(tpl, i);
            if (tp.is_variadic != 0 && tp.is_typename != 0) {
                hasVariadic = true;
                variadicIdx = i;
                vName = tp.name;
                break;
            }
            i = i + 1;
        }
        // The number of fixed function parameters: the parameter that
        // carries the pack is the one whose type or name matches the
        // variadic template parameter.
        long fixedParamCount = tpl.nparams;
        if (hasVariadic) {
            long j = 0;
            while (j < tpl.nparams) {
                AParam p = this.get_param(tpl, j);
                if (this.seq(p.type.base, vName) || this.seq(p.name, vName)) {
                    fixedParamCount = j;
                    break;
                }
                j = j + 1;
            }
        }
        if (hasVariadic) {
            if (argcount < fixedParamCount) {
                this.map_n_ = base;
                return -1;
            }
        } else {
            if (argcount < tpl.nparams) {
                long j = argcount;
                while (j < tpl.nparams) {
                    AParam p = this.get_param(tpl, j);
                    if (p.default_value < 0) {
                        this.map_n_ = base;
                        return -1;
                    }
                    j = j + 1;
                }
            }
        }
        // Match the fixed parameters against the leading arguments.
        long fixedMatch = argcount;
        if (fixedMatch > fixedParamCount) {
            fixedMatch = fixedParamCount;
        }
        long k = 0;
        while (k < fixedMatch) {
            AParam ap = this.get_param(tpl, k);
            AType paramType = this.resolve_alias(ap.type);
            paramType.is_ref = 0;
            AType argType = this.arg_type(argstart + k);
            argType.is_ref = 0;
            bool isTypeParam = false;
            long q = 0;
            while (q < tpl.tpl_n) {
                ATemplateParam tp = this.get_tpl_param(tpl, q);
                if (tp.is_typename != 0 && this.seq(paramType.base, tp.name)) {
                    isTypeParam = true;
                    break;
                }
                q = q + 1;
            }
            if (isTypeParam) {
                AType d = argType;
                if (paramType.is_const != 0) {
                    d.is_const = 0;
                }
                if (paramType.ptr_depth > 0) {
                    if (argType.ptr_depth != paramType.ptr_depth) {
                        this.map_n_ = base;
                        return -1;
                    }
                    d.ptr_depth = 0;
                }
                long mi = this.map_find(paramType.base, base);
                if (mi >= 0) {
                    AType existing;
                    unsafe { existing = this.map_type_[mi]; }
                    existing.is_const = 0;
                    d.is_const = 0;
                    if (this.same_type(existing, d) == 0) {
                        this.map_n_ = base;
                        return -1;
                    }
                } else {
                    this.map_set(paramType.base, d, base);
                }
                k = k + 1;
                continue;
            }
            // An array parameter: only handled when the argument's base
            // already equals the parameter name.
            if (paramType.array_size > 0 && paramType.ptr_depth == 0) {
                bool baseIsTp = false;
                q = 0;
                while (q < tpl.tpl_n) {
                    ATemplateParam tp = this.get_tpl_param(tpl, q);
                    if (tp.is_typename != 0 && this.seq(paramType.base, tp.name)) {
                        baseIsTp = true;
                        break;
                    }
                    q = q + 1;
                }
                if (baseIsTp && argType.ptr_depth == 1 &&
                    this.seq(argType.base, paramType.base)) {
                    AType d = this.ty_empty();
                    d.base = argType.base;
                    d.is_unsigned = argType.is_unsigned;
                    long mi = this.map_find(paramType.base, base);
                    if (mi >= 0) {
                        AType existing;
                        unsafe { existing = this.map_type_[mi]; }
                        if (this.same_type(existing, d) == 0) {
                            this.map_n_ = base;
                            return -1;
                        }
                    } else {
                        this.map_set(paramType.base, d, base);
                    }
                }
                k = k + 1;
                continue;
            }
            // The parameter does not mention a type parameter: nothing is
            // deduced from this argument.
            k = k + 1;
        }
        // The deduced arguments, in the order of the template parameters.
        long n = 0;
        i = 0;
        while (i < tpl.tpl_n) {
            ATemplateParam tp = this.get_tpl_param(tpl, i);
            if (tp.is_typename == 0) {
                i = i + 1;
                continue;
            }
            if (tp.is_variadic != 0) {
                long j = fixedParamCount;
                while (j < argcount) {
                    AType at = this.arg_type(argstart + j);
                    at.is_ref = 0;
                    if (n >= outcap) {
                        this.map_n_ = base;
                        return -1;
                    }
                    unsafe { out[n] = at; }
                    n = n + 1;
                    j = j + 1;
                }
            } else {
                long mi = this.map_find(tp.name, base);
                if (mi < 0) {
                    this.map_n_ = base;
                    return -1;
                }
                AType d;
                unsafe { d = this.map_type_[mi]; }
                if (n >= outcap) {
                    this.map_n_ = base;
                    return -1;
                }
                unsafe { out[n] = d; }
                n = n + 1;
            }
            i = i + 1;
        }
        this.map_n_ = base;
        return n;
        }
        return -1;
    }

    // instantiateTemplate in hir_builder.cpp: build the specialization of
    // a function template.  The signature is substituted with the
    // template-parameter mapping; the body is the template's body, built
    // without the mapping (the oracle does not set `currentTypeMapping_`
    // for a function template).  Returns the HIR function index.
    long instantiate_template(long tplAstIdx, AType* args, long n,
                              long line, long col) {
        unsafe {
        AFunction tpl = this.pa.get_fn(tplAstIdx);
        // The mangled name of the specialization.
        const char* mangled = this.mangle_args(tpl.name, args, n);
        // A specialization that was already built is reused.
        long cached = this.find_instantiated(mangled);
        if (cached >= 0) {
            return cached;
        }
        // The variadic pack, if any.
        long variadicIdx = -1;
        long i = 0;
        while (i < tpl.tpl_n) {
            ATemplateParam tp = this.get_tpl_param(tpl, i);
            if (tp.is_variadic != 0) {
                variadicIdx = i;
                break;
            }
            i = i + 1;
        }
        // The mapping: the non-variadic parameters consume the arguments
        // one to one, a variadic pack takes all the remaining ones.  A
        // non-type parameter is never bound.
        long nonVariadic = tpl.tpl_n;
        if (variadicIdx >= 0) {
            nonVariadic = variadicIdx;
        }
        long mbase = this.map_n_;
        long m = 0;
        while (m < nonVariadic && m < n) {
            ATemplateParam tp = this.get_tpl_param(tpl, m);
            if (tp.is_typename != 0) {
                AType a = args[m];
                this.map_set(tp.name, a, mbase);
                // A constrained parameter is checked at instantiation time.
                if (this.slen(tp.constraint) > 0) {
                    if (this.check_constraint(tp.constraint, a, line, col) == 0) {
                        this.map_n_ = mbase;
                        return -1;
                    }
                }
            }
            m = m + 1;
        }
        // The function parameter that carries the pack and the name the
        // synthesized pack parameters are built from.
        const char* packBase = "";
        if (variadicIdx >= 0) {
            ATemplateParam vtp = this.get_tpl_param(tpl, variadicIdx);
            packBase = vtp.name;
            long j = 0;
            while (j < tpl.nparams) {
                AParam p = this.get_param(tpl, j);
                if (this.seq(p.type.base, vtp.name) || this.seq(p.name, vtp.name)) {
                    if (this.slen(p.name) > 0) {
                        packBase = p.name;
                    }
                    break;
                }
                j = j + 1;
            }
        }
        // The pack elements: the arguments from the variadic parameter on.
        long packN = 0;
        if (variadicIdx >= 0 && n > variadicIdx) {
            packN = n - variadicIdx;
        }
        AType* packTypes = (AType*)0;
        if (packN > 0) {
            packTypes = this.alloc_types(packN);
            long pk = 0;
            while (pk < packN && packTypes != (AType*)0) {
                packTypes[pk] = args[variadicIdx + pk];
                pk = pk + 1;
            }
        }
        // The substituted signature.
        AType ret = this.substitute_type(tpl.ret, mbase);
        long idx = this.add_function(mangled, ret, tpl.is_extern_c, tpl.is_constexpr);
        long j = 0;
        long pushed = 0;
        long firstElem = -1;
        while (j < tpl.nparams) {
            AParam p = this.get_param(tpl, j);
            bool isPack = false;
            if (variadicIdx >= 0) {
                ATemplateParam vtp = this.get_tpl_param(tpl, variadicIdx);
                if (this.seq(p.type.base, vtp.name) || this.seq(p.name, vtp.name)) {
                    isPack = true;
                }
            }
            if (isPack) {
                if (firstElem < 0) {
                    firstElem = pushed;
                }
                long k = 0;
                while (k < packN) {
                    AType pt = packTypes[k];
                    // The synthesized parameter name: __<name><index>.
                    this.sb_reset();
                    this.sb_put("__");
                    this.sb_put(packBase);
                    this.sb_put_num(k);
                    const char* pn = this.sb_save();
                    this.push_param(pt, pn, p.line, p.col);
                    pushed = pushed + 1;
                    k = k + 1;
                }
            } else {
                AType pt = this.substitute_type(p.type, mbase);
                this.push_param(pt, p.name, p.line, p.col);
                pushed = pushed + 1;
            }
            j = j + 1;
        }
        this.finish_function(idx);
        this.add_instantiated(mangled, idx);
        // The mapping is only used for the signature: the body of the
        // specialization is built without it.
        this.map_n_ = mbase;
        // The pack of this specialization is visible while its body is
        // built (the oracle registers it in `currentPackMapping_`).
        long savedFrame = this.packframe_;
        if (variadicIdx >= 0 && firstElem >= 0) {
            ATemplateParam vtp = this.get_tpl_param(tpl, variadicIdx);
            this.push_pack_frame(vtp.name, packBase, packN, firstElem);
        }
        if (tpl.body >= 0) {
            this.build_body(idx, tpl, line, col);
        }
        this.packframe_ = savedFrame;
        return idx;
        }
        return -1;
    }

    // --- class/struct template instantiation (H4.4) ----------------------

    // The AST struct index of the struct template named `name`, or -1.
    long find_struct_template(const char* name) {
        long i = this.stpl_n_ - 1;
        while (i >= 0) {
            unsafe {
                if (this.seq((char*)this.stpl_name_[i], name)) {
                    return this.stpl_ast_[i];
                }
            }
            i = i - 1;
        }
        return -1;
    }

    // Register the struct template `astIdx`.  A second template with the
    // same name replaces the first one (the oracle keys `structTemplates_`
    // by name).
    void register_struct_template(long astIdx) {
        AStruct sd = this.get_struct(astIdx);
        long i = 0;
        while (i < this.stpl_n_) {
            unsafe {
                if (this.seq((char*)this.stpl_name_[i], sd.name)) {
                    this.stpl_ast_[i] = astIdx;
                    return;
                }
            }
            i = i + 1;
        }
        if (this.stpl_n_ < this.stpl_cap_) {
            unsafe {
                this.stpl_name_[this.stpl_n_] = (long)sd.name;
                this.stpl_ast_[this.stpl_n_] = astIdx;
            }
            this.stpl_n_ = this.stpl_n_ + 1;
        }
    }

    // The i-th template parameter of a struct template.
    ATemplateParam get_struct_tpl_param(AStruct sd, long i) {
        unsafe {
            if (i < sd.tpl_n) {
                return sd.tpl_params[i];
            }
        }
        ATemplateParam tp;
        tp.name = "";
        tp.constraint = "";
        tp.is_typename = 0;
        tp.is_variadic = 0;
        tp.type = this.ty_empty();
        tp.line = 0;
        tp.col = 0;
        return tp;
    }

    // The global struct index of the specialization `mangled`, or -1.
    long find_spec(const char* mangled) {
        long i = 0;
        while (i < this.spc_n_) {
            unsafe {
                if (this.seq((char*)this.spc_name_[i], mangled)) {
                    return this.pa.struct_count() + i;
                }
            }
            i = i + 1;
        }
        return -1;
    }

    // The name of the specialization with the global struct index `gidx`.
    const char* spec_name(long gidx) {
        long k = gidx - this.pa.struct_count();
        if (k < 0 || k >= this.spc_n_) {
            return "";
        }
        unsafe {
            return (char*)this.spc_name_[k];
        }
        return "";
    }

    // Register the specialization `rec` under the name `mangled` and
    // return its global struct index.
    long add_spec(const char* mangled, AStruct rec) {
        long k = this.spc_n_;
        if (k < this.spc_cap_) {
            unsafe {
                this.spc_name_[k] = (long)mangled;
                this.spc_rec_[k] = rec;
                this.spc_size_[k] = 0;
                this.spc_align_[k] = 0;
                this.spc_poly_[k] = 0;
            }
            this.spc_n_ = this.spc_n_ + 1;
        }
        return this.pa.struct_count() + k;
    }

    // The length of the bare method name: the part of a qualified name
    // after the last "::" (the oracle's `mf.name.rfind("::")`).
    long bare_method_len(const char* q) {
        long n = this.slen(q);
        long i = n - 1;
        while (i > 0) {
            unsafe {
                if (q[i] == ':') {
                    return n - i - 1;
                }
            }
            i = i - 1;
        }
        return n;
    }

    // The layout of a struct specialization: the fields are already
    // substituted, the base classes are lost (the oracle never copies
    // them into the clone).  The methods are not copied into the record
    // either, so the polymorphism is taken from the template.
    void layout_spec(long gidx, AStruct tpl) {
        AStruct sd = this.get_struct(gidx);
        long offset = 0;
        long align = 1;
        long poly = 0;
        long j = 0;
        while (j < tpl.nmethods) {
            AFunction mf;
            unsafe {
                mf = tpl.methods[j];
            }
            if (mf.is_virtual != 0) {
                poly = 1;
            }
            j = j + 1;
        }
        if (poly != 0) {
            // The vptr of a polymorphic struct (buildStruct in
            // hir_builder.cpp).
            offset = 8;
            align = 8;
        }
        long i = 0;
        while (i < sd.nfields) {
            AField f;
            unsafe {
                f = sd.fields[i];
            }
            long fsz = this.type_size(f.type);
            long fal = this.type_align(f.type);
            offset = this.align_up(offset, fal);
            offset = offset + fsz;
            if (fal > align) {
                align = fal;
            }
            i = i + 1;
        }
        long total = this.align_up(offset, align);
        long k = gidx - this.pa.struct_count();
        if (k >= 0 && k < this.spc_n_) {
            unsafe {
                this.spc_size_[k] = total;
                this.spc_align_[k] = align;
                this.spc_poly_[k] = poly;
            }
        }
    }

    // The index of the concept named `name`, or -1.
    long find_concept(const char* name) {
        long n = this.pa.concept_count();
        long i = 0;
        while (i < n) {
            AConcept cd = this.pa.get_concept(i);
            if (this.seq(cd.name, name)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // The builtin arithmetic types (the `typeIsArithmetic` helper of
    // checkConstraint): a pointer is never arithmetic, a base name that
    // ends with "_t" always is.
    bool type_is_arithmetic(AType t) {
        if (t.ptr_depth != 0) {
            return false;
        }
        if (this.slen(t.base) == 0) {
            return false;
        }
        if (this.ends_with(t.base, "_t")) {
            return true;
        }
        return this.seq(t.base, "char") || this.seq(t.base, "bool") ||
               this.seq(t.base, "int") || this.seq(t.base, "long") ||
               this.seq(t.base, "short") || this.seq(t.base, "unsigned") ||
               this.seq(t.base, "signed") || this.seq(t.base, "float") ||
               this.seq(t.base, "double");
    }

    // True when a function whose name starts with "operator" takes the
    // concrete type as its first two parameters (the operator-overload
    // check of checkConstraint).
    bool has_operator_overload(AType concrete) {
        long si = this.find_struct(concrete.base);
        if (si < 0) {
            return false;
        }
        long i = 0;
        while (i < this.u.fn_n) {
            HFunction f;
            unsafe {
                f = this.u.fns[i];
            }
            if (this.starts_with(f.name, "operator") && f.pn >= 2) {
                HParam p0;
                HParam p1;
                unsafe {
                    p0 = this.u.params[f.pstart];
                    p1 = this.u.params[f.pstart + 1];
                }
                if (this.same_type(p0.type, concrete) &&
                    this.same_type(p1.type, concrete)) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    // checkConstraint in hir_builder.cpp: verify that the concrete type
    // satisfies the concept.  The check runs only at instantiation time.
    // An unknown concept name is assumed to be satisfied; a requirement
    // that mentions a binary operator needs an arithmetic type or an
    // operator overload; every other requirement is not checked at all.
    bool check_constraint(const char* conceptName, AType concrete,
                          long line, long col) {
        long ci = this.find_concept(conceptName);
        if (ci < 0) {
            // Unknown concept - can't check, assume satisfied.
            return true;
        }
        AConcept cd = this.pa.get_concept(ci);
        long r = 0;
        while (r < cd.nreqs) {
            unsafe {
            const char* req = this.pa.requirement_text(cd.req_start + r);
            long len = this.slen(req);
            long opLen = 0;
            long opPos = -1;
            long i = 0;
            // The two-character operators are looked for first.
            while (i + 1 < len) {
                char c0 = 0;
                char c1 = 0;
                unsafe {
                    c0 = req[i];
                    c1 = req[i + 1];
                }
                if ((c0 == '=' && c1 == '=') || (c0 == '!' && c1 == '=') ||
                    (c0 == '<' && c1 == '=') || (c0 == '>' && c1 == '=')) {
                    opLen = 2;
                    opPos = i;
                    break;
                }
                i = i + 1;
            }
            if (opPos < 0) {
                i = 0;
                while (i < len) {
                    char c = 0;
                    unsafe {
                        c = req[i];
                    }
                    if (c == '+' || c == '-' || c == '*' || c == '/' ||
                        c == '<' || c == '>') {
                        if (i > 0) {
                            char prev = 0;
                            unsafe {
                                prev = req[i - 1];
                            }
                            if (prev == '-') {
                                i = i + 1;
                                continue;
                            }
                        }
                        opLen = 1;
                        opPos = i;
                        break;
                    }
                    i = i + 1;
                }
            }
            if (opLen > 0) {
                if (this.type_is_arithmetic(concrete) == 0) {
                    if (this.has_operator_overload(concrete) == 0) {
                        this.err_concept_not_satisfied(line, col, cd.name,
                                                      concrete, req, opPos, opLen);
                        return false;
                    }
                }
            }
            }
            r = r + 1;
        }
        return true;
    }

    // instantiateStructTemplate in hir_builder.cpp: build the
    // specialization of a struct template.  The field types are
    // substituted, the methods are renamed to "<Spec>::<method>" and their
    // bodies are built with the type mapping active.  The base classes are
    // lost (the oracle never copies them into the clone).  Returns the
    // global struct index of the specialization, or -1 when a constraint is
    // not satisfied.
    long instantiate_struct_template(long tplAstIdx, const char* tplName,
                                     AType* args, long n, long line, long col) {
        unsafe {
        const char* mangled = this.mangle_args(tplName, args, n);
        long cached = this.find_spec(mangled);
        if (cached >= 0) {
            return cached;
        }
        AStruct tpl = this.get_struct(tplAstIdx);
        long mbase = this.map_n_;
        // The type mapping: the template parameters consume the arguments
        // one to one; a non-type parameter is never bound.
        long i = 0;
        while (i < tpl.tpl_n && i < n) {
            ATemplateParam tp = this.get_struct_tpl_param(tpl, i);
            if (tp.is_typename != 0) {
                this.map_set(tp.name, args[i], mbase);
                if (this.slen(tp.constraint) > 0) {
                    if (this.check_constraint(tp.constraint, args[i], line, col) == 0) {
                        // The constraint is not satisfied: the error was
                        // already reported.
                        this.map_n_ = mbase;
                        return -1;
                    }
                }
            }
            i = i + 1;
        }
        // The template name itself maps to the specialization name, so that
        // a parameter of the template's own type is substituted.
        AType specTy = this.ty_empty();
        specTy.base = mangled;
        this.map_set(tplName, specTy, mbase);
        // The mapping is active while the fields, the method signatures and
        // the method bodies are built (the oracle's `currentTypeMapping_`).
        long savedG = this.gmap_base_;
        this.gmap_base_ = mbase;
        // The substituted fields.  The base classes are lost: the oracle
        // never copies them into the clone of the template.
        long nf = tpl.nfields;
        AStruct rec;
        rec.name = mangled;
        rec.is_class = tpl.is_class;
        rec.nfields = nf;
        rec.methods = (AFunction*)0;
        rec.nmethods = 0;
        rec.bstart = 0;
        rec.nbases = 0;
        rec.line = tpl.line;
        rec.col = tpl.col;
        rec.tpl_params = (ATemplateParam*)0;
        rec.tpl_n = 0;
        AField* flds = (AField*)0;
        if (nf > 0) {
            flds = (AField*) __ivy_alloc((unsigned long long)(nf * 72));
            if (flds != (AField*)0) {
                if (this.spcfld_n_ < this.spcfld_cap_) {
                    this.spcfld_[this.spcfld_n_] = (long)flds;
                    this.spcfld_n_ = this.spcfld_n_ + 1;
                }
                long k = 0;
                while (k < nf) {
                    AField f = tpl.fields[k];
                    AField cf;
                    cf.type = this.resolve_template_struct_type(
                        this.substitute_type(this.resolve_alias(f.type), mbase),
                        f.line, f.col);
                    cf.name = f.name;
                    cf.line = f.line;
                    cf.col = f.col;
                    flds[k] = cf;
                    k = k + 1;
                }
            }
        }
        rec.fields = flds;
        long gidx = this.add_spec(mangled, rec);
        this.layout_spec(gidx, tpl);
        // The methods of the specialization.
        long nm = tpl.nmethods;
        long fnbase = this.spcfns_n_;
        long j = 0;
        while (j < nm) {
            AFunction mf = tpl.methods[j];
            // The qualified name of the method: "<Spec>::<method>".
            this.sb_reset();
            this.sb_put(mangled);
            this.sb_put("::");
            long mflen = this.slen(mf.name);
            long blen = this.bare_method_len(mf.name);
            long k = 0;
            while (k < blen) {
                this.sb_put_char(mf.name[mflen - blen + k]);
                k = k + 1;
            }
            const char* qname = this.sb_save();
            AType ret = this.resolve_template_struct_type(
                this.substitute_type(this.resolve_alias(mf.ret), mbase),
                mf.line, mf.col);
            // The implicit `this` parameter has the type "<Spec>&".
            AType tt = this.ty_empty();
            tt.base = mangled;
            tt.is_ref = 1;
            long np = mf.nparams;
            long pstart = 0;
            AType* ptypes = (AType*)0;
            if (np > 0) {
                ptypes = this.alloc_types(np);
            }
            long p = 0;
            while (p < np) {
                AParam ap = mf.params[p];
                AType pt = this.resolve_template_struct_type(
                    this.substitute_type(this.resolve_alias(ap.type), mbase),
                    ap.line, ap.col);
                ptypes[p] = pt;
                p = p + 1;
            }
            pstart = this.u.p_n;
            this.push_param(tt, "this", mf.line, mf.col);
            p = 0;
            while (p < np) {
                AParam ap = mf.params[p];
                AType pt = ptypes[p];
                this.push_param(pt, ap.name, ap.line, ap.col);
                this.set_param_default(this.u.p_n - 1, ap.default_value);
                p = p + 1;
            }
            long idx = this.add_function_at(qname, ret, 0, mf.is_constexpr, pstart,
                                            -1, 0, 0);
            this.finish_function(idx);
            if (this.spcfns_n_ < this.spcfns_cap_) {
                this.spcfns_[this.spcfns_n_] = idx;
                this.spcfns_n_ = this.spcfns_n_ + 1;
            }
            j = j + 1;
        }
        // The method bodies are built now: the specialization is not in the
        // AST, so the body pass never walks it.
        j = 0;
        while (j < nm) {
            AFunction mf = tpl.methods[j];
            if (mf.body >= 0) {
                long fi = this.spcfns_[fnbase + j];
                this.build_body(fi, mf, mf.line, mf.col);
            }
            j = j + 1;
        }
        this.spcfns_n_ = fnbase;
        this.gmap_base_ = savedG;
        this.map_n_ = mbase;
        return gidx;
        }
    }

    // resolveTemplateStructType in hir_builder.cpp: a template-id type is
    // replaced by the name of its specialization.  A type that names no
    // struct template is left as it is.
    AType resolve_template_struct_type(AType t, long line, long col) {
        if (t.tpl_n <= 0) {
            return t;
        }
        long tplIdx = this.find_struct_template(t.base);
        if (tplIdx < 0) {
            return t;
        }
        long spec = this.instantiate_struct_template(tplIdx, t.base, t.tpl_args,
                                                      t.tpl_n, line, col);
        AType r = t;
        unsafe { r.tpl_args = (AType*)0; }
        r.tpl_n = 0;
        if (spec >= 0) {
            r.base = this.spec_name(spec);
        } else {
            // The constraint was not satisfied: the oracle falls back to
            // the unmangled template name.
            r.base = t.base;
        }
        return r;
    }

    // --- template diagnostics -------------------------------------------

    // "'X' is not a template"
    void err_not_a_template(long line, long col, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put("'");
        this.db_put(name);
        this.db_put("' is not a template");
        this.diag(line, col, this.db_end());
    }

    // "failed to instantiate template 'X'"
    void err_failed_instantiate(long line, long col, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put("failed to instantiate template '");
        this.db_put(name);
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

    // "cannot deduce template arguments for 'X'"
    void err_cannot_deduce(long line, long col, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put("cannot deduce template arguments for '");
        this.db_put(name);
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

    // "failed to deduce template arguments for 'X'"
    void err_failed_to_deduce(long line, long col, const char* name) {
        this.db_start_ = this.db_n_;
        this.db_put("failed to deduce template arguments for '");
        this.db_put(name);
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

    // "concept 'X' not satisfied: type 'T' does not support operator 'OP'"
    void err_concept_not_satisfied(long line, long col, const char* conceptName,
                                   AType concrete, const char* req,
                                   long opPos, long opLen) {
        this.db_start_ = this.db_n_;
        this.db_put("concept '");
        this.db_put(conceptName);
        this.db_put("' not satisfied: type '");
        // The name of the concrete type (typeNameStr in checkConstraint):
        // the base name, " unsigned", " const" and the pointer stars.
        this.db_put(concrete.base);
        if (concrete.is_unsigned != 0) {
            this.db_put(" unsigned");
        }
        if (concrete.is_const != 0) {
            this.db_put(" const");
        }
        long d = 0;
        while (d < concrete.ptr_depth) {
            this.db_put("*");
            d = d + 1;
        }
        this.db_put("' does not support operator '");
        long k = 0;
        while (k < opLen) {
            char c = 0;
            unsafe {
                c = req[opPos + k];
            }
            this.db_put_char(c);
            k = k + 1;
        }
        this.db_put("'");
        this.diag(line, col, this.db_end());
    }

    // --- entry point -----------------------------------------------------

    // Find the HIR function that matches an AST function by name and
    // parameter types (the oracle matches the body to its signature).
    // `skip` is the number of leading HIR parameters to ignore (1 for a
    // method, whose first parameter is the implicit `this`).
    long find_fn_sig(AFunction af, long skip) {
        long i = 0;
        while (i < this.u.fn_n) {
            HFunction f;
            unsafe {
                f = this.u.fns[i];
            }
            if (this.seq(f.name, af.name) && f.pn == af.nparams + skip) {
                long k = 0;
                long ok = 1;
                while (k < af.nparams && ok != 0) {
                    AParam p;
                    unsafe {
                        p = af.params[k];
                    }
                    AType a = this.resolve_template_struct_type(
                        this.resolve_alias(p.type), p.line, p.col);
                    a.is_ref = 0;
                    HParam hp;
                    unsafe {
                        hp = this.u.params[f.pstart + skip + k];
                    }
                    AType b = hp.type;
                    b.is_ref = 0;
                    if (this.same_type(a, b) == 0) {
                        ok = 0;
                    }
                    k = k + 1;
                }
                if (ok != 0) {
                    return i;
                }
            }
            i = i + 1;
        }
        return -1;
    }

    void build() {
        this.build_enums();
        this.build_structs();
        long n = this.pa.fn_count();
        long i = 0;
        while (i < n) {
            AFunction f = this.pa.get_fn(i);
            if (f.is_extern_c != 0) {
                this.build_free_signature(f, i);
            }
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            AFunction f = this.pa.get_fn(i);
            if (f.is_extern_c == 0) {
                this.build_free_signature(f, i);
            }
            i = i + 1;
        }
        i = 0;
        while (i < n) {
            AFunction f = this.pa.get_fn(i);
            if (f.body >= 0 && f.tpl_n == 0) {
                long fi = this.find_fn_sig(f, 0);
                if (fi >= 0) {
                    this.build_body(fi, f, f.line, f.col);
                }
            }
            i = i + 1;
        }
        long sn = this.pa.struct_count();
        long si = 0;
        while (si < sn) {
            AStruct sd = this.get_struct(si);
            long j = 0;
            while (j < sd.nmethods) {
                AFunction mf;
                unsafe {
                    mf = sd.methods[j];
                }
                if (mf.body >= 0 && mf.tpl_n == 0) {
                    long fi = this.find_fn_sig(mf, 1);
                    if (fi >= 0) {
                        this.build_body(fi, mf, mf.line, mf.col);
                    }
                }
                j = j + 1;
            }
            si = si + 1;
        }
    }
};








