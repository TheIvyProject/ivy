// selfhost/mir/interpdrive.ivy - H5.4 P6: chạy một tệp nguồn .ivy qua frontend
// selfhost (lexer → preprocessor → parser → HIR → MIR), sau đó diễn giải
// hàm "main" bằng InterpreterModel. In nội dung buffer stdout/stderr nội
// bộ của trình diễn ra host stdout/stderr và thoát với mã trạng thái của
// chương trình được diễn giải, để so sánh byte với oracle `ivy --run`.
//
// Dùng:
//   ivy.exe selfhost\\mir\\interpdrive.ivy -I selfhost\\parsing -I selfhost\\hir -I selfhost\\mir -I std -o interpdrive.exe
//   interpdrive.exe < fixture.ivy
//
// Pipeline gương --mir path của src/app/main.cpp:
//   lexer -> preprocessor -> parser -> HIR builder -> MIR builder -> interpreter
//
// Ivy cấm tham số/trả về con trỏ thraw tại cấp file, nên:
//   - in buffer qua struct method StreamPrinter::print (không phải hàm tự do);
//   - lấy MUnit* bằng cách sao chép MUnit lên heap (__ivy_alloc) và cast
//     (không dùng &mu, Ivy không cho phép lấy địa chỉ struct).

#pragma ivy cnumber
import token;
import lexer;
import preprocessor;
import ast;
import parser;
import hir;
import hir_builder;
import mir;
import mir_builder;
import interpreter;
import io;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);

// In một buffer có độ dài rõ ràng lên host stdout (is_err == 0) hoặc stderr
// (is_err != 0).  Trình diễn không bắt buộc kết thúc NUL stdout_bytes, nên
// sao chép sang bộ đệm tạm NUL-terminated rồi in (không thêm ký tự dư).
struct StreamPrinter {
    void print(long len, const char* bytes, long is_err) {
        if (len <= 0) {
            return;
        }
        unsafe {
            char* buf = (char*) __ivy_alloc((unsigned long long)len + 1);
            if (buf == (char*) 0) {
                return;
            }
            long i = 0;
            while (i < len) {
                buf[i] = bytes[i];
                i = i + 1;
            }
            buf[len] = 0;
            if (is_err != 0) {
                io::eprint("{}", buf);
            } else {
                io::print("{}", buf);
            }
            __ivy_free((void*) buf);
        }
    }
};

long run() {
    long result = 1;
    unsafe {
        char* path = io::read_line();
        if (path == (char*) 0) {
            io::eprintln("interpdrive: khong co duong dan tren stdin");
            return 1;
        }
        uint64 np = __ivy_strlen(path);
        while (np > 0 && (path[np - 1] == 13 || path[np - 1] == 10)) {
            path[np - 1] = 0;
            np = np - 1;
        }

        char* content = io::read_file(path);
        if (content == (char*) 0) {
            io::eprint("ivy: error: cannot open file '");
            io::eprint(path);
            io::eprintln("'");
            __ivy_free(path);
            return 2;
        }

        uint64 len = __ivy_strlen(content);
        long cap = (long)len + 16;

        Lexer lx;
        lx.setup(content, (long)len, path);
        lx.lex_all(cap);

        long failed = 0;
        char* fname = path;

        if (!lx.had_error()) {
            long in_n = lx.token_count();
            long out_cap = in_n * 8 + 256;
            Preprocessor pp;
            pp.setup(lx.tokens(), in_n, content, (long)len, path, (long)np,
                     out_cap, 1024);
            pp.run();
            long dc = pp.diag_count();
            long di = 0;
            bool pp_failed = false;
            if (pp.has_line_file() != 0) {
                fname = pp.line_file();
            }
            while (di < dc) {
                long w = pp.diag_warn(di);
                if (w == 0) {
                    pp_failed = true;
                }
                io::eprint(fname);
                io::eprint(":");
                io::eprint("{}", pp.diag_line(di));
                io::eprint(":");
                io::eprint("{}", pp.diag_col(di));
                if (w != 0) {
                    io::eprint(": warning: ");
                } else {
                    io::eprint(": error: ");
                }
                io::eprintln("{}", pp.diag_msg(di));
                di = di + 1;
            }

            if (!pp_failed) {
                Parser pa;
                pa.setup(pp.output(), pp.output_count(), pp.arena(), (long)len);
                pa.set_cnumber(pp.cnumber_enabled());
                pa.parse();
                if (pa.failed() != 0) {
                    failed = 1;
                    long nd = pa.diag_count();
                    long k = 0;
                    while (k < nd) {
                        io::eprint(fname);
                        io::eprint(":");
                        io::eprint("{}", pa.diag_line(k));
                        io::eprint(":");
                        io::eprint("{}", pa.diag_col(k));
                        io::eprintln(": error: {}", pa.diag_msg(k));
                        k = k + 1;
                    }
                } else {
                    HirBuilder hb;
                    hb.setup(pa, pp.output_count());
                    hb.build();
                    long hd = hb.diag_count();
                    long k = 0;
                    while (k < hd) {
                        failed = 1;
                        io::eprint(fname);
                        io::eprint(":");
                        io::eprint("{}", hb.diag_line(k));
                        io::eprint(":");
                        io::eprint("{}", hb.diag_col(k));
                        io::eprintln(": error: {}", hb.diag_msg(k));
                        k = k + 1;
                    }
                    if (hd == 0) {
                        HUnit u = hb.unit();
                        MirBuilder mb;
                        mb.setup(u);
                        mb.build();
                        long md = mb.diag_count();
                        k = 0;
                        while (k < md) {
                            failed = 1;
                            io::eprint(fname);
                            io::eprint(":");
                            io::eprint("{}", mb.diag_line(k));
                            io::eprint(":");
                            io::eprint("{}", mb.diag_col(k));
                            io::eprintln(": error: {}", mb.diag_msg(k));
                            k = k + 1;
                        }

                        if (md == 0) {
                            MUnit mu = mb.unit();
                            InterpreterModel im;
                            if (im.setup() == 0) {
                                io::eprintln("interpdrive: khoi tao interpreter that bai");
                            } else {
                                // MUnit khong the lay dia chi (&mu bi c ban cua Ivy),
                                // nen sao chep len heap va truyen con tro gia tri.
                                unsafe {
                                    void* raw = __ivy_alloc(256);
                                    MUnit* muptr = (MUnit*)raw;
                                    muptr->fns = mu.fns;
                                    muptr->fn_n = mu.fn_n;
                                    muptr->fn_cap = mu.fn_cap;
                                    muptr->exprs = mu.exprs;
                                    muptr->ex_n = mu.ex_n;
                                    muptr->ex_cap = mu.ex_cap;
                                    muptr->insts = mu.insts;
                                    muptr->in_n = mu.in_n;
                                    muptr->in_cap = mu.in_cap;
                                    muptr->blocks = mu.blocks;
                                    muptr->bl_n = mu.bl_n;
                                    muptr->bl_cap = mu.bl_cap;
                                    muptr->params = mu.params;
                                    muptr->pa_n = mu.pa_n;
                                    muptr->pa_cap = mu.pa_cap;
                                    muptr->lts = mu.lts;
                                    muptr->lt_n = mu.lt_n;
                                    muptr->lt_cap = mu.lt_cap;
                                    muptr->args = mu.args;
                                    muptr->a_n = mu.a_n;
                                    muptr->a_cap = mu.a_cap;
                                    muptr->arm_val = mu.arm_val;
                                    muptr->arm_blk = mu.arm_blk;
                                    muptr->arm_n = mu.arm_n;
                                    muptr->arm_cap = mu.arm_cap;

                                    StreamPrinter sp;
                                    IResult r = im.call_by_name(muptr, "main", -1, 0);

                                    sp.print(im.stdout_length(), im.stdout_bytes(), 0);
                                    sp.print(im.stderr_length(), im.stderr_bytes(), 1);

                                    if (r.state == 3) {
                                        result = r.status;
                                    } else if (r.state == 2) {
                                        result = 1;
                                    } else {
                                        result = 0;
                                    }

                                    im.release();
                                    __ivy_free(raw);
                                }
                            }
                            mb.release();
                        }
                        hb.release();
                    }
                    pa.release();
                }
                pp.release();
            }
            lx.release();
        }

        __ivy_free(content);
        __ivy_free(path);
    }
    return result;
}

int32 main() {
    long r = run();
    unsafe {
        return (int32) r;
    }
    return 0;
}
