// selfhost/mir/interpreter.ivy - H5.3 P0 interpreter data model and pools.
//
// This module defines storage and lookup foundations only. It does not
// evaluate MIR expressions, instructions, calls, or control flow.

#pragma ivy cnumber
export module interpreter;
import mir;

// Wrapper structs for raw pointer parameters (ivy forbids raw pointer params).
export struct StrBuf { char* p; };
export struct LongPtr { long* p; };
export struct PtrBuf { char** p; };
export struct UnitPtr { MUnit* u; };

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);

// IValue kind tags. The numeric order is intentionally stable.
// 0 Void, 1 Int, 2 Float, 3 Ptr, 4 Struct, 5 Str.
// Pointer provenance is descriptive metadata; it is not a memory-safety
// check and does not imply oracle parity for lifetime diagnostics.
export struct IValue {
    long kind;
    long int_value;
    double float_value;
    long cell_index;
    long pointer_is_null;
    long provenance_kind;
    long provenance_id;
    const char* provenance_name;
    long struct_index;
    const char* string_bytes;
    long string_length;
};

// Cell identity is an append-only index in InterpreterModel.cells. The value
// index can change on a write; aliases retain the same cell index forever.
export struct ICell {
    long value_index;
};

// Interpreter-local aggregate description. It does not extend MUnit and is
// descriptive only until the aggregate metadata phase.
export struct IStruct {
    const char* name;
    long field_count;
};

// Fields are appended in registration order. `order` is per struct, so
// interleaved registration of different structs still preserves each order.
export struct IField {
    long struct_index;
    long order;
    const char* name;
    long cell_index;
};

// Frame indices are stable for this model's lifetime. Popping marks a frame
// inactive but does not recycle its index or its cells/local records.
export struct IFrame {
    long function_index;
    long caller_index;
    long continuation_block;
    long continuation_inst;
    long block_index;
    long inst_index;
    long return_state;
    long return_value;
    long active;
};

// Local mappings are append-only. Lookup searches newest-to-oldest to permit
// a later binding to shadow an earlier name in the same frame.
export struct ILocal {
    long frame_index;
    const char* name;
    long cell_index;
};

// Result schema only; P0 does not execute a function or map process status.
// State codes reserved here: 0 pending, 1 returned, 2 failed, 3 terminated.
export struct IResult {
    long state;
    long value_index;
    long status;
};

// The query carries the existing MIR metadata as a struct parameter, avoiding
// a new target field in MExpr/MUnit. P0 uses exact name matches only; params
// are retained for a later signature-aware resolution phase.
export struct IFunctionQuery {
    MFunction* functions;
    long function_count;
    MParam* params;
    long parameter_count;
    const char* name;
};

// Resolution states: 0 unresolved, 1 unique name, 2 ambiguous name.
// No executable overload selection is performed in P0.
export struct IFunctionResolution {
    long state;
    long function_index;
    long candidate_count;
};

// Shared control block for InterpreterModel instances. Survives shallow struct
// copies (e.g. `InterpreterModel b = a; a.release(); b.release();`) by sharing
// the released tombstone flag across all copies, preventing double-free heap
// corruption (0xC0000374).
// P4: the internal stream buffers also live here, so every shallow copy of an
// InterpreterModel observes the same stdout/stderr byte streams. Buffers use
// explicit lengths (not C strings), so embedded NUL bytes survive.
export struct InterpreterControl {
    long released;
    long ref_count;
    char* out_buf;
    long out_len;
    long out_cap;
    char* err_buf;
    long err_len;
    long err_cap;
};

// String and character literal decoding helpers matching oracle mir_builder.cpp:41-137.
// Free functions use wrapper structs for all pointer parameters (ivy forbids raw pointer params).
export bool decode_body(StrBuf body, long body_len, StrBuf out_buf, LongPtr out_len) {
    unsafe {
        if (out_buf.p == (char*) 0 || out_len.p == (long*) 0) {
            return false;
        }
        if (body.p == (char*) 0) {
            return false;
        }
        long out_pos = 0;
        long i = 0;
        while (i < body_len) {
            char c = body.p[i];
            if (c != 92) { // '\\'
                out_buf.p[out_pos] = c;
                out_pos = out_pos + 1;
                i = i + 1;
            } else {
                i = i + 1;
                if (i >= body_len) {
                    return false;
                }
                char esc = body.p[i];
                if (esc == 110) { // 'n'
                    out_buf.p[out_pos] = 10;
                    out_pos = out_pos + 1;
                } else if (esc == 116) { // 't'
                    out_buf.p[out_pos] = 9;
                    out_pos = out_pos + 1;
                } else if (esc == 114) { // 'r'
                    out_buf.p[out_pos] = 13;
                    out_pos = out_pos + 1;
                } else if (esc == 97) { // 'a'
                    out_buf.p[out_pos] = 7;
                    out_pos = out_pos + 1;
                } else if (esc == 98) { // 'b'
                    out_buf.p[out_pos] = 8;
                    out_pos = out_pos + 1;
                } else if (esc == 102) { // 'f'
                    out_buf.p[out_pos] = 12;
                    out_pos = out_pos + 1;
                } else if (esc == 118) { // 'v'
                    out_buf.p[out_pos] = 11;
                    out_pos = out_pos + 1;
                } else if (esc == 92) { // '\\'
                    out_buf.p[out_pos] = 92;
                    out_pos = out_pos + 1;
                } else if (esc == 39) { // '\''
                    out_buf.p[out_pos] = 39;
                    out_pos = out_pos + 1;
                } else if (esc == 34) { // '\"'
                    out_buf.p[out_pos] = 34;
                    out_pos = out_pos + 1;
                } else if (esc == 63) { // '?'
                    out_buf.p[out_pos] = 63;
                    out_pos = out_pos + 1;
                } else if (esc == 120) { // 'x' hex
                    // Mirrors the oracle loop exactly: when two hex digits are
                    // consumed, the oracle's `while (++i < size && count < 2)`
                    // advances `i` once more and the surrounding loop advances
                    // again, so the character after the last digit is skipped.
                    long v = 0;
                    long count = 0;
                    long maxed = 0;
                    while (i + 1 < body_len) {
                        i = i + 1;
                        char h = body.p[i];
                        bool is_hex = false;
                        if (h >= 48 && h <= 57) { // '0'..'9'
                            v = v * 16 + (h - 48);
                            is_hex = true;
                        } else if (h >= 97 && h <= 102) { // 'a'..'f'
                            v = v * 16 + (h - 97 + 10);
                            is_hex = true;
                        } else if (h >= 65 && h <= 70) { // 'A'..'F'
                            v = v * 16 + (h - 65 + 10);
                            is_hex = true;
                        }
                        if (!is_hex) {
                            i = i - 1;
                            break;
                        }
                        count = count + 1;
                        if (count >= 2) {
                            maxed = 1;
                            break;
                        }
                    }
                    if (maxed != 0) {
                        i = i + 1;
                    }
                    out_buf.p[out_pos] = (char) v;
                    out_pos = out_pos + 1;
                } else if (esc >= 48 && esc <= 55) { // '0'..'7' octal
                    long v = esc - 48;
                    long count = 1;
                    long maxed = 0;
                    while (i + 1 < body_len) {
                        i = i + 1;
                        char o = body.p[i];
                        if (o >= 48 && o <= 55) {
                            v = v * 8 + (o - 48);
                            count = count + 1;
                            if (count >= 3) {
                                maxed = 1;
                                break;
                            }
                        } else {
                            i = i - 1;
                            break;
                        }
                    }
                    if (maxed != 0) {
                        i = i + 1;
                    }
                    out_buf.p[out_pos] = (char) v;
                    out_pos = out_pos + 1;
                } else {
                    out_buf.p[out_pos] = esc;
                    out_pos = out_pos + 1;
                }
                i = i + 1;
            }
        }
        out_buf.p[out_pos] = 0;
        out_len.p[0] = out_pos;
    }
    return true;
}

export bool decode_string_literal(StrBuf raw, StrBuf out_buf, LongPtr out_len) {
    unsafe {
        if (raw.p == (char*) 0 || out_buf.p == (char*) 0 || out_len.p == (long*) 0) {
            return false;
        }
        long len = 0;
        while (raw.p[len] != 0) {
            len = len + 1;
        }
        long start = 0;
        // Strip prefix: u8, L, u, U (oracle stripStringPrefix).
        if (len - start >= 2 && raw.p[start] == 117 && raw.p[start + 1] == 56) { // u8
            start = start + 2;
        } else if (len - start >= 1) {
            char p = raw.p[start];
            if (p == 76 || p == 117 || p == 85) { // 'L', 'u', 'U'
                start = start + 1;
            }
        }
        // Raw string: R"delim(...)delim" — bytes between the first '(' and
        // the last ')' are copied verbatim (no escapes).
        if (len - start >= 3 && raw.p[start] == 82 && raw.p[start + 1] == 34) { // R"
            long open = -1;
            long close = -1;
            long k = start;
            while (k < len) {
                if (raw.p[k] == 40 && open < 0) { // '('
                    open = k;
                }
                if (raw.p[k] == 41) { // ')'
                    close = k;
                }
                k = k + 1;
            }
            if (open < 0 || close < 0 || close <= open) {
                return false;
            }
            long rpos = 0;
            k = open + 1;
            while (k < close) {
                out_buf.p[rpos] = raw.p[k];
                rpos = rpos + 1;
                k = k + 1;
            }
            out_buf.p[rpos] = 0;
            out_len.p[0] = rpos;
            return true;
        }
        if (len - start < 2 || raw.p[start] != 34 || raw.p[len - 1] != 34) { // '"'
            return false;
        }
        StrBuf body;
        body.p = raw.p + start + 1;
        return interpreter::decode_body(body, (len - start) - 2, out_buf, out_len);
    }
    return false;
}

export bool decode_char_literal(StrBuf raw, LongPtr out_val) {
    unsafe {
        if (raw.p == (char*) 0 || out_val.p == (long*) 0) {
            return false;
        }
        long len = 0;
        while (raw.p[len] != 0) {
            len = len + 1;
        }
        long start = 0;
        if (len - start >= 1) {
            char p = raw.p[start];
            if (p == 76 || p == 117 || p == 85) { // 'L', 'u', 'U'
                start = start + 1;
            }
        }
        if (len - start < 2 || raw.p[start] != 39 || raw.p[len - 1] != 39) { // '\''
            return false;
        }
        long body_len = (len - start) - 2;
        // The decoded char literal is at most body_len bytes; use a heap
        // scratch buffer because Ivy forbids taking the address of a local
        // array element.
        char* scratch = (char*) __ivy_alloc(body_len + 2);
        if (scratch == (char*) 0) {
            return false;
        }
        StrBuf body;
        body.p = raw.p + start + 1;
        StrBuf tmpbuf;
        tmpbuf.p = scratch;
        long dec_len = 0;
        LongPtr lenptr;
        lenptr.p = &dec_len;
        bool ok = interpreter::decode_body(body, body_len, tmpbuf, lenptr);
        long value = 0;
        if (ok && dec_len > 0) {
            value = (long) (uint8) scratch[0];
        }
        __ivy_free((void*) scratch);
        if (!ok || dec_len == 0) {
            return false;
        }
        out_val.p[0] = value;
        return true;
    }
    return false;
}

export struct InterpreterModel {
    IValue* values;
    long value_count;
    long value_capacity;

    ICell* cells;
    long cell_count;
    long cell_capacity;

    IStruct* structs;
    long struct_count;
    long struct_capacity;

    IField* fields;
    long field_count;
    long field_capacity;

    IFrame* frames;
    long frame_count;
    long frame_capacity;

    ILocal* locals;
    long local_count;
    long local_capacity;

    // Each string value owns one separate byte buffer. This makes the
    // IValue.string_bytes pointer stable when any metadata pool grows.
    // Store pointer bits in long slots (the host long/pointer width is 64-bit).
    // This mirrors the selfhost pools' established pointer-as-long convention;
    // allocation still uses sizeof(char*) as the ABI stride.
    long* string_buffers;
    long string_buffer_count;
    long string_buffer_capacity;

    long* dline_;
    long* dcol_;
    long* dmsg_;
    long diag_count_;
    long diag_capacity_;

    long current_frame;
    long setup_done;
    long released;
    // Latched when native storage allocation fails. Existing data remains
    // readable, but subsequent allocating/mutating operations fail cleanly.
    long allocation_failed;
    // Oracle parity: diagnostics set `failed_` (src/mir/interpreter.cpp:101).
    // call_by_name() clears it on entry and maps it to IResult state 2.
    long failed_;
    // P4: interpreted allocation ids (a monotonic model-local sequence) and
    // the termination record. termination_kind: 0 none, 1 exit, 2 abort.
    // termination_status is the status P6 must hand to the host process.
    long next_heap_alloc_id_;
    long termination_kind_;
    long termination_status_;
    IResult result;
    InterpreterControl* control;

    bool is_released() {
        if (this.released != 0) {
            return true;
        }
        unsafe {
            if (this.control != (InterpreterControl*) 0 && this.control->released != 0) {
                return true;
            }
        }
        return false;
    }

    void retain() {
        unsafe {
            if (this.control != (InterpreterControl*) 0) {
                this.control->ref_count = this.control->ref_count + 1;
            }
        }
    }

    long signed_long_max() {
        uint64 unsigned_max = 0;
        long answer = 0;
        unsafe {
            unsigned_max = (uint64)0 - 1;
            answer = (long)(unsigned_max >> 1);
        }
        return answer;
    }

    bool valid_pool_allocation(long capacity, long stride) {
        if (capacity <= 0 || stride <= 0) {
            return false;
        }
        return capacity <= this.signed_long_max() / stride;
    }

    bool valid_pool_growth(long capacity, long stride) {
        if (capacity <= 0 || stride <= 0 || stride > this.signed_long_max()) {
            return false;
        }
        return capacity <= (this.signed_long_max() / stride) / 2;
    }

    // The allocator strides use sizeof(the actual Ivy record), rather than
    // hand-estimated ABI constants. Record sizes are recorded in H53_NOTES.
    long setup() {
        if (this.setup_done != 0) {
            if (this.is_released() || this.allocation_failed != 0) {
                return 0;
            }
            return 1;
        }
        // Mark the model initialized before allocating so release() can
        // safely unwind a partially completed setup.
        this.setup_done = 1;
        this.released = 0;
        this.allocation_failed = 0;
        this.failed_ = 0;
        this.next_heap_alloc_id_ = 0;
        this.termination_kind_ = 0;
        this.termination_status_ = 0;
        this.value_capacity = 4;
        this.cell_capacity = 4;
        this.struct_capacity = 4;
        this.field_capacity = 4;
        this.frame_capacity = 4;
        this.local_capacity = 4;
        this.string_buffer_capacity = 4;
        this.diag_capacity_ = 4;
        unsafe {
            this.values = (IValue*) 0;
            this.cells = (ICell*) 0;
            this.structs = (IStruct*) 0;
            this.fields = (IField*) 0;
            this.frames = (IFrame*) 0;
            this.locals = (ILocal*) 0;
            this.string_buffers = (long*) 0;
            this.dline_ = (long*) 0;
            this.dcol_ = (long*) 0;
            this.dmsg_ = (long*) 0;
            this.control = (InterpreterControl*) 0;
        }
        this.value_count = 0;
        this.cell_count = 0;
        this.struct_count = 0;
        this.field_count = 0;
        this.frame_count = 0;
        this.local_count = 0;
        this.string_buffer_count = 0;
        this.diag_count_ = 0;
        this.current_frame = -1;
        this.result.state = 0;
        this.result.value_index = -1;
        this.result.status = 0;
        if (!this.valid_pool_allocation(this.value_capacity, sizeof(IValue)) ||
            !this.valid_pool_allocation(this.cell_capacity, sizeof(ICell)) ||
            !this.valid_pool_allocation(this.struct_capacity, sizeof(IStruct)) ||
            !this.valid_pool_allocation(this.field_capacity, sizeof(IField)) ||
            !this.valid_pool_allocation(this.frame_capacity, sizeof(IFrame)) ||
            !this.valid_pool_allocation(this.local_capacity, sizeof(ILocal)) ||
            !this.valid_pool_allocation(this.string_buffer_capacity, sizeof(char*)) ||
            !this.valid_pool_allocation(this.diag_capacity_, sizeof(long))) {
            this.allocation_failed = 1;
            this.release();
            return 0;
        }
        unsafe {
            this.control = (InterpreterControl*) __ivy_alloc(sizeof(InterpreterControl));
            if (this.control == (InterpreterControl*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.control->released = 0;
            this.control->ref_count = 1;
            this.control->out_buf = (char*) 0;
            this.control->out_len = 0;
            this.control->out_cap = 0;
            this.control->err_buf = (char*) 0;
            this.control->err_len = 0;
            this.control->err_cap = 0;

            this.values = (IValue*) __ivy_alloc(this.value_capacity * sizeof(IValue));
            if (this.values == (IValue*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.cells = (ICell*) __ivy_alloc(this.cell_capacity * sizeof(ICell));
            if (this.cells == (ICell*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.structs = (IStruct*) __ivy_alloc(this.struct_capacity * sizeof(IStruct));
            if (this.structs == (IStruct*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.fields = (IField*) __ivy_alloc(this.field_capacity * sizeof(IField));
            if (this.fields == (IField*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.frames = (IFrame*) __ivy_alloc(this.frame_capacity * sizeof(IFrame));
            if (this.frames == (IFrame*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.locals = (ILocal*) __ivy_alloc(this.local_capacity * sizeof(ILocal));
            if (this.locals == (ILocal*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.string_buffers = (long*) __ivy_alloc(this.string_buffer_capacity * sizeof(char*));
            if (this.string_buffers == (long*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.dline_ = (long*) __ivy_alloc(this.diag_capacity_ * sizeof(long));
            if (this.dline_ == (long*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.dcol_ = (long*) __ivy_alloc(this.diag_capacity_ * sizeof(long));
            if (this.dcol_ == (long*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
            this.dmsg_ = (long*) __ivy_alloc(this.diag_capacity_ * sizeof(long));
            if (this.dmsg_ == (long*) 0) {
                this.allocation_failed = 1;
                this.release();
                return 0;
            }
        }
        return 1;
    }

    bool ensure_values() {
        if (this.allocation_failed != 0 || this.is_released()) {
            return false;
        }
        if (this.value_count < this.value_capacity) {
            return true;
        }
        long old_capacity = this.value_capacity;
        if (!this.valid_pool_growth(old_capacity, sizeof(IValue))) {
            this.allocation_failed = 1;
            return false;
        }
        long new_capacity = old_capacity * 2;
        unsafe {
            IValue* old_values = this.values;
            IValue* new_values = (IValue*) __ivy_alloc(new_capacity * sizeof(IValue));
            if (new_values == (IValue*) 0) {
                this.allocation_failed = 1;
                return false;
            }
            long i = 0;
            while (i < this.value_count) {
                new_values[i] = old_values[i];
                i = i + 1;
            }
            __ivy_free(old_values);
            this.values = new_values;
        }
        this.value_capacity = new_capacity;
        return true;
    }

    bool ensure_cells() {
        if (this.allocation_failed != 0 || this.is_released()) {
            return false;
        }
        if (this.cell_count < this.cell_capacity) {
            return true;
        }
        if (!this.valid_pool_growth(this.cell_capacity, sizeof(ICell))) {
            this.allocation_failed = 1;
            return false;
        }
        long new_capacity = this.cell_capacity * 2;
        unsafe {
            ICell* old_cells = this.cells;
            ICell* new_cells = (ICell*) __ivy_alloc(new_capacity * sizeof(ICell));
            if (new_cells == (ICell*) 0) {
                this.allocation_failed = 1;
                return false;
            }
            long i = 0;
            while (i < this.cell_count) {
                new_cells[i] = old_cells[i];
                i = i + 1;
            }
            __ivy_free(old_cells);
            this.cells = new_cells;
        }
        this.cell_capacity = new_capacity;
        return true;
    }

    bool ensure_structs() {
        if (this.allocation_failed != 0 || this.is_released()) {
            return false;
        }
        if (this.struct_count < this.struct_capacity) {
            return true;
        }
        if (!this.valid_pool_growth(this.struct_capacity, sizeof(IStruct))) {
            this.allocation_failed = 1;
            return false;
        }
        long new_capacity = this.struct_capacity * 2;
        unsafe {
            IStruct* old_structs = this.structs;
            IStruct* new_structs = (IStruct*) __ivy_alloc(new_capacity * sizeof(IStruct));
            if (new_structs == (IStruct*) 0) {
                this.allocation_failed = 1;
                return false;
            }
            long i = 0;
            while (i < this.struct_count) {
                new_structs[i] = old_structs[i];
                i = i + 1;
            }
            __ivy_free(old_structs);
            this.structs = new_structs;
        }
        this.struct_capacity = new_capacity;
        return true;
    }

    bool ensure_fields() {
        if (this.allocation_failed != 0 || this.is_released()) {
            return false;
        }
        if (this.field_count < this.field_capacity) {
            return true;
        }
        if (!this.valid_pool_growth(this.field_capacity, sizeof(IField))) {
            this.allocation_failed = 1;
            return false;
        }
        long new_capacity = this.field_capacity * 2;
        unsafe {
            IField* old_fields = this.fields;
            IField* new_fields = (IField*) __ivy_alloc(new_capacity * sizeof(IField));
            if (new_fields == (IField*) 0) {
                this.allocation_failed = 1;
                return false;
            }
            long i = 0;
            while (i < this.field_count) {
                new_fields[i] = old_fields[i];
                i = i + 1;
            }
            __ivy_free(old_fields);
            this.fields = new_fields;
        }
        this.field_capacity = new_capacity;
        return true;
    }

    bool ensure_frames() {
        if (this.allocation_failed != 0 || this.is_released()) {
            return false;
        }
        if (this.frame_count < this.frame_capacity) {
            return true;
        }
        if (!this.valid_pool_growth(this.frame_capacity, sizeof(IFrame))) {
            this.allocation_failed = 1;
            return false;
        }
        long new_capacity = this.frame_capacity * 2;
        unsafe {
            IFrame* old_frames = this.frames;
            IFrame* new_frames = (IFrame*) __ivy_alloc(new_capacity * sizeof(IFrame));
            if (new_frames == (IFrame*) 0) {
                this.allocation_failed = 1;
                return false;
            }
            long i = 0;
            while (i < this.frame_count) {
