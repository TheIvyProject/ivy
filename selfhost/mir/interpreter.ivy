    // Create one fresh "__array" instance of `size` zero-valued element
    // cells and return the cell index that holds the array value.  Each call
    // registers a distinct IStruct, so two arrays never share element cells.
    // Element fields are positional (order 0..size-1) and unnamed because the
    // interpreter indexes them by order.
    long make_array(long count) {
        if (this.setup_done == 0 || this.is_released() || this.allocation_failed != 0 ||
            count < 0) {
            return -1;
