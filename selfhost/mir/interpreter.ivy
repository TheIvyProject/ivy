                return 0;
            }
            this.frames[frame_index].block_index = block_index;
            this.frames[frame_index].inst_index = inst_index;
        }
        return 1;
    }

    long set_frame_return(long frame_index, long state, long value_index) {
        if (frame_index < 0 || frame_index >= this.frame_count ||
            (value_index >= this.value_count) || (value_index < -1) || this.is_released() ||
            this.allocation_failed != 0 || state < 0 || state > 3) {
            return 0;
        }
        unsafe {
            if (this.frames[frame_index].active == 0) {
                return 0;
            }
            this.frames[frame_index].return_state = state;
            this.frames[frame_index].return_value = value_index;
        }
        return 1;
    }

    long current_local(const char* name) {
        return this.find_local(this.current_frame, name);
    }

    IFunctionResolution resolve_function(IFunctionQuery query) {
        IFunctionResolution answer;
        answer.state = 0;
        answer.function_index = -1;
        answer.candidate_count = 0;
        if (this.is_null_name(query.name) || query.function_count < 0) {
            return answer;
        }
        bool functions_null = false;
        unsafe {
            functions_null = query.functions == (MFunction*) 0;
        }
        if (functions_null) {
            return answer;
        }
        long i = 0;
        while (i < query.function_count) {
            bool matches = false;
            unsafe {
                const char* candidate_name = query.functions[i].name;
                matches = this.same_name(candidate_name, query.name);
            }
            if (matches) {
                answer.candidate_count = answer.candidate_count + 1;
                answer.function_index = i;
            }
            i = i + 1;
        }
        if (answer.candidate_count == 0) {
            answer.state = 0;
            answer.function_index = -1;
        } else if (answer.candidate_count == 1) {
            answer.state = 1;
        } else {
            answer.state = 2;
            answer.function_index = -1;
        }
        return answer;
    }

    long set_result(long state, long value_index, long status) {
        if (this.setup_done == 0 || this.is_released() || this.allocation_failed != 0 ||
            state < 0 || state > 3 || value_index < -1 || value_index >= this.value_count) {
            return 0;
        }
        this.result.state = state;
        this.result.value_index = value_index;
        this.result.status = status;
        return 1;
    }

    bool is_float_base(const char* b) {
        return this.same_name(b, "float") || this.same_name(b, "double") ||
               this.same_name(b, "long double") || this.same_name(b, "float16_t") ||
               this.same_name(b, "float32_t") || this.same_name(b, "float64_t") ||
               this.same_name(b, "float128_t") || this.same_name(b, "bfloat16_t");
    }

    bool is_integer_base(const char* b) {
        return this.same_name(b, "bool") || this.same_name(b, "char") ||
               this.same_name(b, "short") || this.same_name(b, "int") ||
               this.same_name(b, "long") || this.same_name(b, "long long") ||
               this.same_name(b, "int8_t") || this.same_name(b, "int16_t") ||
               this.same_name(b, "int32_t") || this.same_name(b, "int64_t") ||
               this.same_name(b, "int128_t") || this.same_name(b, "uint8_t") ||
               this.same_name(b, "uint16_t") || this.same_name(b, "uint32_t") ||
               this.same_name(b, "uint64_t") || this.same_name(b, "uint128_t") ||
               this.same_name(b, "size_t") || this.same_name(b, "ptrdiff_t") ||
               this.same_name(b, "uptr_t");
    }

    // The oracle compares `Value::asStr()` for either operand.  A non-string
    // Value's `str` payload is empty, so a non-string operand behaves like an
    // empty byte string in the oracle's string branch.  Mirror that.
    long string_length_loose(long value_index) {
        if (this.value_kind(value_index) == 5) {
            return this.read_string_length(value_index);
        }
        return 0;
    }

    long string_byte_loose(long value_index, long byte_index) {
        if (this.value_kind(value_index) == 5) {
            return this.read_string_byte(value_index, byte_index);
        }
        return -1;
    }

    bool equal_strings(long left_val, long right_val) {
        long llen = this.string_length_loose(left_val);
        long rlen = this.string_length_loose(right_val);
        if (llen != rlen) {
            return false;
        }
        long i = 0;
        while (i < llen) {
            if (this.string_byte_loose(left_val, i) != this.string_byte_loose(right_val, i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    bool format_long(long val, char* buf, long* out_len) {
        unsafe {
            if (buf == (char*) 0 || out_len == (long*) 0) {
                return false;
            }
            char digits[32];
            long pos = 0;
            uint64 mag = 0;
            if (val < 0) {
                mag = (uint64)0 - (uint64)val;
            } else {
                mag = (uint64)val;
            }
            if (mag == 0) {
                digits[0] = 48; // '0'
                pos = 1;
            } else {
                while (mag > 0) {
                    long d = (long)(mag % 10);
                    digits[pos] = (char)(48 + d);
                    pos = pos + 1;
                    mag = mag / 10;
                }
            }
            long out_pos = 0;
            if (val < 0) {
                buf[0] = 45; // '-'
                out_pos = 1;
            }
            long i = pos - 1;
            while (i >= 0) {
                buf[out_pos] = digits[i];
                out_pos = out_pos + 1;
                i = i - 1;
            }
            buf[out_pos] = 0;
            out_len[0] = out_pos;
        }
        return true;
    }

    // Append the decimal form of `val` to a NUL-terminated message buffer.
    void append_long(char* out, long* out_len, long val) {
        unsafe {
            if (out == (char*) 0 || out_len == (long*) 0) {
                return;
            }
            char digits[32];
            long pos = 0;
            uint64 mag = 0;
            if (val < 0) {
                mag = (uint64)0 - (uint64)val;
            } else {
                mag = (uint64)val;
            }
            if (mag == 0) {
                digits[0] = 48; // '0'
                pos = 1;
            } else {
                while (mag > 0) {
                    long d = (long)(mag % 10);
                    digits[pos] = (char)(48 + d);
                    pos = pos + 1;
                    mag = mag / 10;
                }
            }
            long cur = out_len[0];
            if (val < 0) {
                out[cur] = 45; // '-'
                cur = cur + 1;
            }
            long i = pos - 1;
            while (i >= 0) {
                out[cur] = digits[i];
                cur = cur + 1;
                i = i - 1;
            }
            out[cur] = 0;
            out_len[0] = cur;
        }
    }

    void append_to_msg(char* out, long* out_len, const char* str) {
        unsafe {
            if (out == (char*) 0 || out_len == (long*) 0 || str == (char*) 0) {
                return;
            }
            long cur = out_len[0];
            long i = 0;
            while (str[i] != 0) {
                out[cur] = str[i];
                cur = cur + 1;
                i = i + 1;
            }
            out[cur] = 0;
            out_len[0] = cur;
        }
    }

    // Diagnostic messages are built in a short-lived heap scratch buffer and
    // then interned (copied) by error(), so no caller buffer escapes. The
    // scratch size is derived from the dynamic parts so a long identifier or
    // operator can never overrun a fixed buffer.
    long diagnostic_scratch_size(const char* part) {
        return 64 + this.slen(part);
    }

    void error_undefined_var(long line, long col, const char* name) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(name));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "undefined variable '");
            this.append_to_msg(msg, &len, name);
            this.append_to_msg(msg, &len, "'");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    void error_unsupported_unary(long line, long col, const char* op) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(op));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "IvyInterpret v0.2: unsupported unary op '");
            this.append_to_msg(msg, &len, op);
            this.append_to_msg(msg, &len, "'");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    void error_unsupported_binary(long line, long col, const char* op) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(op));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "IvyInterpret v0.2: unsupported binary op '");
            this.append_to_msg(msg, &len, op);
            this.append_to_msg(msg, &len, "'");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    void error_index_out_of_bounds(long line, long col, long idx, long sz) {
        unsafe {
            char* msg = (char*) __ivy_alloc(128);
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "index out of bounds: index ");
            this.append_long(msg, &len, idx);
            this.append_to_msg(msg, &len, " out of range [0, ");
            this.append_long(msg, &len, sz);
            this.append_to_msg(msg, &len, ")");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    // True when `op` is exactly `plain` followed by one character, e.g.
    // plain "+" matches "+=" (the oracle strips the trailing '=' of a
    // compound assignment operator).  This replaces copying into a local
    // char array, which the Ivy subset cannot pass as a pointer.
    bool compound_plain_is(const char* op, const char* plain) {
        if (this.is_null_name(op) || this.is_null_name(plain)) {
            return false;
        }
        long plen = this.slen(plain);
        if (this.slen(op) != plen + 1) {
            return false;
        }
        long i = 0;
        unsafe {
            while (i < plen) {
                if (op[i] != plain[i]) {
                    return false;
                }
                i = i + 1;
            }
        }
        return true;
    }

    long lookup_local_cell(const char* name) {
        if (this.is_null_name(name) || this.current_frame < 0) {
            return -1;
        }
        long f = this.current_frame;
        while (f >= 0 && f < this.frame_count) {
            long c = this.find_local(f, name);
            if (c >= 0) {
                return c;
            }
            unsafe {
                f = this.frames[f].caller_index;
            }
        }
        return -1;
    }

    long lvalue_cell(MUnit* u, long expr_idx) {
        if (this.is_released()) {
            return -1;
        }
        unsafe {
            if (u == (MUnit*) 0 || expr_idx < 0 || expr_idx >= u->ex_n) {
                return -1;
            }
            long kind = u->exprs[expr_idx].kind;
            long a_idx = u->exprs[expr_idx].a;
            long b_idx = u->exprs[expr_idx].b;
            long line = u->exprs[expr_idx].line;
            long col = u->exprs[expr_idx].col;
            const char* sval = u->exprs[expr_idx].sval;
            if (kind == 6) { // IdentRef
                long c = this.lookup_local_cell(sval);
                if (c < 0) {
                    return -1;
                }
                long val_idx = this.cell_value(c);
                if (this.value_kind(val_idx) == 3 && this.pointer_is_null(val_idx) == 0) {
                    return this.pointer_cell(val_idx);
                }
                return c;
            }
            if (kind == 7) { // This
                long c = this.lookup_local_cell("this");
                if (c < 0) {
                    return -1;
                }
                long val_idx = this.cell_value(c);
                if (this.value_kind(val_idx) == 3 && this.pointer_is_null(val_idx) == 0) {
                    return this.pointer_cell(val_idx);
                }
                return c;
            }
            if (kind == 8) { // Unary
                if (this.same_name(sval, "*")) {
                    long v = this.eval_expr(u, a_idx);
                    if (this.value_kind(v) == 3 && this.pointer_is_null(v) == 0) {
                        return this.pointer_cell(v);
                    }
                    return -1;
                }
                return -1;
            }
            if (kind == 12) { // Index
                long arrCell = this.lvalue_cell(u, a_idx);
                long idxVal = this.eval_expr(u, b_idx);
                long i = 0;
                if (this.value_kind(idxVal) == 1) {
                    i = this.read_int(idxVal);
                }
                if (arrCell >= 0) {
                    long arrVal = this.cell_value(arrCell);
                    if (this.value_kind(arrVal) == 4) {
                        long st_idx = this.read_struct_index(arrVal);
                        if (st_idx >= 0 && st_idx < this.struct_count) {
                            const char* sname = (char*) 0;
                            long sz = 0;
                            sname = this.structs[st_idx].name;
                            sz = this.structs[st_idx].field_count;
                            if (this.same_name(sname, "__array")) {
                                if (i < 0 || i >= sz) {
                                    this.error_index_out_of_bounds(line, col, i, sz);
                                    return -1;
                                }
                                return this.lookup_field_order(st_idx, i);
                            }
                        }
                    }
                }
                return -1;
            }
        }
        return -1;
    }

    long eval_expr(MUnit* u, long expr_idx) {
        if (this.is_released()) {
            return this.make_void();
        }
        unsafe {
            if (u == (MUnit*) 0 || expr_idx < 0 || expr_idx >= u->ex_n) {
                return this.make_void();
            }
            long kind = u->exprs[expr_idx].kind;
            long ival = u->exprs[expr_idx].ival;
            double fval = u->exprs[expr_idx].fval;
            long flag = u->exprs[expr_idx].flag;
            long a_idx = u->exprs[expr_idx].a;
            long b_idx = u->exprs[expr_idx].b;
            long c_idx = u->exprs[expr_idx].c;
            long line = u->exprs[expr_idx].line;
            long col = u->exprs[expr_idx].col;
            const char* sval = u->exprs[expr_idx].sval;
            const char* type_base = u->exprs[expr_idx].type.base;
            long type_array_size = u->exprs[expr_idx].type.array_size;
            long type_ptr_depth = u->exprs[expr_idx].type.ptr_depth;
            bool type_is_ref = u->exprs[expr_idx].type.is_ref;

        if (kind == 0) { // IntegerLit
            return this.make_int(ival);
        }
        if (kind == 1) { // FloatLit
            return this.make_float(fval);
        }
        if (kind == 2) { // StringLit
            long raw_len = this.slen(sval);
            char* buf = (char*) __ivy_alloc(raw_len + 1);
            if (buf == (char*) 0) {
                this.allocation_failed = 1;
                return this.make_void();
            }
            StrBuf rawb;
            rawb.p = (char*) sval;
            StrBuf outb;
            outb.p = buf;
            long dec_len = 0;
            LongPtr lenp;
            lenp.p = &dec_len;
            bool ok = interpreter::decode_string_literal(rawb, outb, lenp);
            long res = -1;
            if (ok) {
                res = this.make_string(buf, dec_len);
            } else {
                res = this.make_string(buf, 0);
            }
            __ivy_free((void*) buf);
            return res;
        }
        if (kind == 3) { // CharLit
            long char_val = 0;
            StrBuf rawb;
            rawb.p = (char*) sval;
            LongPtr valp;
            valp.p = &char_val;
            interpreter::decode_char_literal(rawb, valp);
            return this.make_int(char_val);
        }
        if (kind == 4) { // BoolLit
            return this.make_int(ival != 0 ? 1 : 0);
        }
        if (kind == 5) { // NullptrLit
            return this.make_null_pointer();
        }
        if (kind == 6) { // IdentRef
            long c = this.lookup_local_cell(sval);
            if (c < 0) {
                this.error_undefined_var(line, col, sval);
                return this.make_void();
            }
            if (type_array_size > 0) {
                return this.cell_value(c);
            }
            if (type_ptr_depth > 0 && !type_is_ref) {
                return this.make_cell_pointer(c);
            }
            if (type_is_ref) {
                long cv = this.cell_value(c);
                if (this.value_kind(cv) == 3 && this.pointer_is_null(cv) == 0) {
                    long pc = this.pointer_cell(cv);
                    if (pc >= 0) {
                        return this.cell_value(pc);
                    }
                }
            }
            return this.cell_value(c);
        }
        if (kind == 7) { // This
            long c = this.lookup_local_cell("this");
            if (c < 0) {
                this.error(line, col, "'this' is only valid inside a method");
                return this.make_void();
            }
            if (type_is_ref) {
                long cv = this.cell_value(c);
                if (this.value_kind(cv) == 3 && this.pointer_is_null(cv) == 0) {
                    long pc = this.pointer_cell(cv);
                    if (pc >= 0) {
                        return this.cell_value(pc);
                    }
                }
            }
            return this.cell_value(c);
        }
        if (kind == 8) { // Unary
            if (this.same_name(sval, "&")) {
                long c = this.lvalue_cell(u, a_idx);
                if (c < 0) {
                    this.error(line, col, "cannot take address");
                    return this.make_void();
                }
                return this.make_cell_pointer(c);
            }
            if (this.same_name(sval, "*")) {
                long op_val = this.eval_expr(u, a_idx);
                if (this.value_kind(op_val) != 3) {
                    this.error(line, col, "dereference of non-pointer");
                    return this.make_void();
                }
                if (this.pointer_is_null(op_val) != 0) {
                    this.error(line, col, "null pointer dereference");
                    return this.make_void();
                }
                long pc = this.pointer_cell(op_val);
                if (pc >= 0) {
                    return this.cell_value(pc);
                }
                return this.make_void();
            }
            bool is_prefix = flag != 0;
            if (is_prefix && (this.same_name(sval, "++") || this.same_name(sval, "--"))) {
                long c = this.lvalue_cell(u, a_idx);
                if (c >= 0) {
                    long cv = this.cell_value(c);
                    if (this.value_kind(cv) == 1) {
                        long cur = this.read_int(cv);
                        long delta = this.same_name(sval, "++") ? 1 : -1;
                        long nv = this.make_int(cur + delta);
                        this.cell_write(c, nv);
                        return nv;
                    }
                }
            }
            if (!is_prefix && (this.same_name(sval, "++") || this.same_name(sval, "--"))) {
                long c = this.lvalue_cell(u, a_idx);
                if (c >= 0) {
                    long cv = this.cell_value(c);
                    if (this.value_kind(cv) == 1) {
                        long cur = this.read_int(cv);
                        long delta = this.same_name(sval, "++") ? 1 : -1;
                        long nv = this.make_int(cur + delta);
                        this.cell_write(c, nv);
                        return cv;
                    }
                }
            }
            long v = this.eval_expr(u, a_idx);
            if (this.same_name(sval, "-")) {
                if (this.value_kind(v) == 1) {
                    return this.make_int(-this.read_int(v));
                }
                if (this.value_kind(v) == 2) {
                    return this.make_float(-this.read_float(v));
                }
            }
            if (this.same_name(sval, "!") || this.same_name(sval, "not")) {
                long bv = 0;
                if (this.value_kind(v) == 1) {
                    bv = this.read_int(v);
                } else if (this.value_kind(v) == 2) {
                    bv = (this.read_float(v) != 0.0) ? 1 : 0;
                }
                return this.make_int(bv == 0 ? 1 : 0);
            }
            if (this.same_name(sval, "~") && this.value_kind(v) == 1) {
                return this.make_int(~this.read_int(v));
            }
            if (this.same_name(sval, "+")) {
                return v;
            }
            this.error_unsupported_unary(line, col, sval);
            return this.make_void();
        }
        if (kind == 9) { // Binary
            if (this.same_name(sval, "&&")) {
                long lv = this.eval_expr(u, a_idx);
                if (this.value_kind(lv) == 1 && this.read_int(lv) == 0) {
                    return this.make_int(0);
                }
                long rv = this.eval_expr(u, b_idx);
                long r_truth = 0;
                if (this.value_kind(rv) == 1) {
                    r_truth = (this.read_int(rv) != 0) ? 1 : 0;
                } else if (this.value_kind(rv) == 2) {
                    r_truth = (this.read_float(rv) != 0.0) ? 1 : 0;
                }
                return this.make_int(r_truth);
            }
            if (this.same_name(sval, "||")) {
                long lv = this.eval_expr(u, a_idx);
                if (this.value_kind(lv) == 1 && this.read_int(lv) != 0) {
                    return this.make_int(1);
                }
                long rv = this.eval_expr(u, b_idx);
                long r_truth = 0;
                if (this.value_kind(rv) == 1) {
                    r_truth = (this.read_int(rv) != 0) ? 1 : 0;
                } else if (this.value_kind(rv) == 2) {
                    r_truth = (this.read_float(rv) != 0.0) ? 1 : 0;
                }
                return this.make_int(r_truth);
            }
            if (this.same_name(sval, ",")) {
                this.eval_expr(u, a_idx);
                return this.eval_expr(u, b_idx);
            }
            long lv = this.eval_expr(u, a_idx);
            long rv = this.eval_expr(u, b_idx);
            long lk = this.value_kind(lv);
            long rk = this.value_kind(rv);

            if (lk == 1 && rk == 1) {
                long l = this.read_int(lv);
                long r = this.read_int(rv);
                if (this.same_name(sval, "+")) return this.make_int(l + r);
                if (this.same_name(sval, "-")) return this.make_int(l - r);
                if (this.same_name(sval, "*")) return this.make_int(l * r);
                if (this.same_name(sval, "/")) {
                    if (r == 0) {
                        this.error(line, col, "division by zero");
                        return this.make_int(0);
                    }
                    return this.make_int(l / r);
                }
                if (this.same_name(sval, "%")) {
                    if (r == 0) {
                        this.error(line, col, "modulo by zero");
                        return this.make_int(0);
                    }
                    return this.make_int(l % r);
                }
                if (this.same_name(sval, "==")) return this.make_int(l == r ? 1 : 0);
                if (this.same_name(sval, "!=")) return this.make_int(l != r ? 1 : 0);
                if (this.same_name(sval, "<"))  return this.make_int(l <  r ? 1 : 0);
                if (this.same_name(sval, "<=")) return this.make_int(l <= r ? 1 : 0);
                if (this.same_name(sval, ">"))  return this.make_int(l >  r ? 1 : 0);
                if (this.same_name(sval, ">=")) return this.make_int(l >= r ? 1 : 0);
                if (this.same_name(sval, "&"))  return this.make_int(l & r);
                if (this.same_name(sval, "|"))  return this.make_int(l | r);
                if (this.same_name(sval, "^"))  return this.make_int(l ^ r);
                if (this.same_name(sval, "<<")) return this.make_int(l << r);
                if (this.same_name(sval, ">>")) return this.make_int(l >> r);
            }
            if (lk == 2 || rk == 2) {
                double l = (lk == 2) ? this.read_float(lv) : (double) this.read_int(lv);
                double r = (rk == 2) ? this.read_float(rv) : (double) this.read_int(rv);
                if (this.same_name(sval, "+")) return this.make_float(l + r);
                if (this.same_name(sval, "-")) return this.make_float(l - r);
                if (this.same_name(sval, "*")) return this.make_float(l * r);
                if (this.same_name(sval, "/")) return this.make_float(l / r);
                if (this.same_name(sval, "==")) return this.make_int(l == r ? 1 : 0);
                if (this.same_name(sval, "!=")) return this.make_int(l != r ? 1 : 0);
                if (this.same_name(sval, "<"))  return this.make_int(l <  r ? 1 : 0);
                if (this.same_name(sval, "<=")) return this.make_int(l <= r ? 1 : 0);
                if (this.same_name(sval, ">"))  return this.make_int(l >  r ? 1 : 0);
                if (this.same_name(sval, ">=")) return this.make_int(l >= r ? 1 : 0);
            }
            if (lk == 5 || rk == 5) {
                if (this.same_name(sval, "==")) {
                    return this.make_int(this.equal_strings(lv, rv) ? 1 : 0);
                }
                if (this.same_name(sval, "!=")) {
                    return this.make_int(this.equal_strings(lv, rv) ? 0 : 1);
                }
            }
            if (lk == 3 || rk == 3) {
                bool lnull = (lk == 3) ? (this.pointer_is_null(lv) != 0) : (lk == 1 ? (this.read_int(lv) == 0) : false);
                bool rnull = (rk == 3) ? (this.pointer_is_null(rv) != 0) : (rk == 1 ? (this.read_int(rv) == 0) : false);
                if (this.same_name(sval, "==")) return this.make_int(lnull == rnull ? 1 : 0);
                if (this.same_name(sval, "!=")) return this.make_int(lnull != rnull ? 1 : 0);
            }
            this.error_unsupported_binary(line, col, sval);
            return this.make_void();
        }
        if (kind == 10) { // Ternary
            long cond = this.eval_expr(u, a_idx);
            bool taken = false;
            if (this.value_kind(cond) == 1) {
                taken = (this.read_int(cond) != 0);
            } else if (this.value_kind(cond) == 2) {
                taken = (this.read_float(cond) != 0.0);
            }
            return this.eval_expr(u, taken ? b_idx : c_idx);
        }
        if (kind == 12) { // Index
            long baseVal = this.eval_expr(u, a_idx);
            long idxVal = this.eval_expr(u, b_idx);
            long idx = 0;
            if (this.value_kind(idxVal) == 1) {
                idx = this.read_int(idxVal);
            }
            if (this.value_kind(baseVal) == 4) {
                long st_idx = this.read_struct_index(baseVal);
                if (st_idx >= 0 && st_idx < this.struct_count) {
                    const char* sname = this.structs[st_idx].name;
                    long sz = this.structs[st_idx].field_count;
                    if (this.same_name(sname, "__array")) {
                        if (idx < 0 || idx >= sz) {
                            this.error_index_out_of_bounds(line, col, idx, sz);
                            return this.make_void();
                        }
                        long fc = this.lookup_field_order(st_idx, idx);
                        if (fc >= 0) {
                            return this.cell_value(fc);
                        }
                        return this.make_int(0);
                    }
                }
            }
            this.error(line, col, "IvyInterpret v0.2: pointer index not yet supported");
            return this.make_void();
        }
        if (kind == 14) { // Assign
            long c = this.lvalue_cell(u, a_idx);
            if (c < 0) {
                this.error(line, col, "cannot assign to expression");
                return this.make_void();
            }
            long cv = this.cell_value(c);
            long target = c;
            if (this.value_kind(cv) == 3 && this.pointer_is_null(cv) == 0) {
                target = this.pointer_cell(cv);
            }
            long rhs = this.eval_expr(u, b_idx);
            if (this.same_name(sval, "=")) {
                this.cell_write(target, rhs);
                return this.cell_value(target);
            }
            long lv = this.cell_value(target);
            if (this.value_kind(lv) == 1 && this.value_kind(rhs) == 1) {
                long l = this.read_int(lv);
                long r = this.read_int(rhs);
                long res = l;
                if (this.compound_plain_is(sval, "+")) res = l + r;
                else if (this.compound_plain_is(sval, "-")) res = l - r;
                else if (this.compound_plain_is(sval, "*")) res = l * r;
                else if (this.compound_plain_is(sval, "/") && r != 0) res = l / r;
                else if (this.compound_plain_is(sval, "%") && r != 0) res = l % r;
                else if (this.compound_plain_is(sval, "&")) res = l & r;
                else if (this.compound_plain_is(sval, "|")) res = l | r;
                else if (this.compound_plain_is(sval, "^")) res = l ^ r;
                else if (this.compound_plain_is(sval, "<<")) res = l << r;
                else if (this.compound_plain_is(sval, ">>")) res = l >> r;
                else {
                    this.error(line, col, "unsupported compound op");
                    return this.make_void();
                }
                long nw = this.make_int(res);
                this.cell_write(target, nw);
                return nw;
            }
            if (this.value_kind(lv) == 2 || this.value_kind(rhs) == 2) {
                double l = (this.value_kind(lv) == 2) ? this.read_float(lv) : (double) this.read_int(lv);
                double r = (this.value_kind(rhs) == 2) ? this.read_float(rhs) : (double) this.read_int(rhs);
                double res = l;
                if (this.compound_plain_is(sval, "+")) res = l + r;
                else if (this.compound_plain_is(sval, "-")) res = l - r;
                else if (this.compound_plain_is(sval, "*")) res = l * r;
                else if (this.compound_plain_is(sval, "/")) res = l / r;
                else {
                    this.error(line, col, "unsupported compound float op");
                    return this.make_void();
                }
                long nw = this.make_float(res);
                this.cell_write(target, nw);
                return nw;
            }
            this.error(line, col, "unsupported compound assignment");
            return this.make_void();
        }
        if (kind == 19) { // Cast
            long operand = this.eval_expr(u, a_idx);
            long op_k = this.value_kind(operand);
            if (op_k == 1) { // int
                if (this.is_float_base(type_base)) {
                    return this.make_float((double) this.read_int(operand));
                }
                return this.make_int(this.read_int(operand));
            }
            if (op_k == 2) { // float
                if (this.is_float_base(type_base)) {
                    return this.make_float(this.read_float(operand));
                }
                if (this.is_integer_base(type_base)) {
                    return this.make_int((long) this.read_float(operand));
                }
                return this.make_float(this.read_float(operand));
            }
            if (op_k == 3) { // pointer
                if (type_ptr_depth > 0) {
                    return operand;
                }
                if (this.is_integer_base(type_base)) {
                    return this.make_int(this.pointer_is_null(operand) != 0 ? 0 : 1);
                }
                return operand;
            }
            return operand;
        }

        this.error(line, col, "IvyInterpret v0.2: unsupported expression");
        return this.make_void();
        }
    }

    void release() {
        if (this.setup_done == 0 || this.is_released()) {
            this.released = 1;
            return;
        }
        unsafe {
            if (this.control != (InterpreterControl*) 0) {
                this.control->released = 1;
            }
            long i = 0;
            while (i < this.string_buffer_count) {
                __ivy_free((void*) this.string_buffers[i]);
                i = i + 1;
            }
            if (this.string_buffers != (long*) 0) {
                __ivy_free((void*) this.string_buffers);
            }
            if (this.locals != (ILocal*) 0) {
                __ivy_free(this.locals);
            }
            if (this.frames != (IFrame*) 0) {
                __ivy_free(this.frames);
            }
            if (this.fields != (IField*) 0) {
                __ivy_free(this.fields);
            }
            if (this.structs != (IStruct*) 0) {
                __ivy_free(this.structs);
            }
            if (this.cells != (ICell*) 0) {
                __ivy_free(this.cells);
            }
            if (this.values != (IValue*) 0) {
                __ivy_free(this.values);
            }
            if (this.dline_ != (long*) 0) {
                __ivy_free(this.dline_);
            }
            if (this.dcol_ != (long*) 0) {
                __ivy_free(this.dcol_);
            }
            if (this.dmsg_ != (long*) 0) {
                __ivy_free((void*) this.dmsg_);
            }
        }
        unsafe {
            this.values = (IValue*) 0;
            this.cells = (ICell*) 0;
            this.structs = (IStruct*) 0;
            this.fields = (IField*) 0;
            this.frames = (IFrame*) 0;
            this.locals = (ILocal*) 0;
            this.string_buffers = (long*) 0;
            this.dline_ = (long*) 0;
            this.dcol_ = (long*) 0;
            this.dmsg_ = (long*) 0;
        }
        this.value_count = 0;
        this.cell_count = 0;
        this.struct_count = 0;
        this.field_count = 0;
        this.frame_count = 0;
        this.local_count = 0;
        this.string_buffer_count = 0;
        this.diag_count_ = 0;
        this.value_capacity = 0;
        this.cell_capacity = 0;
        this.struct_capacity = 0;
        this.field_capacity = 0;
        this.frame_capacity = 0;
        this.local_capacity = 0;
        this.string_buffer_capacity = 0;
        this.diag_capacity_ = 0;
        this.current_frame = -1;
        this.result.state = 0;
        this.result.value_index = -1;
        this.result.status = 0;
        this.released = 1;
        // Keep setup_done set so this released model cannot be reinitialised
        // with recycled cell/frame identities.
    }
};
