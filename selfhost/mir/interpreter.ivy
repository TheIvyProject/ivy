            return -1;
        }
        if (!this.ensure_locals()) {
            return -1;
        }
        long index = this.local_count;
        unsafe {
            this.locals[index].frame_index = frame_index;
            this.locals[index].name = name;
            this.locals[index].cell_index = cell_index;
        }
        this.local_count = this.local_count + 1;
        return index;
    }

    long find_local(long frame_index, const char* name) {
        if (this.setup_done == 0 || frame_index < 0 || frame_index >= this.frame_count ||
            this.is_null_name(name) || this.is_released()) {
            return -1;
        }
        long active = 0;
        unsafe {
            active = this.frames[frame_index].active;
        }
        if (active == 0) {
            return -1;
        }
        long i = this.local_count - 1;
        while (i >= 0) {
            long owner = -1;
            long cell_index = -1;
            bool matches = false;
            unsafe {
                owner = this.locals[i].frame_index;
                cell_index = this.locals[i].cell_index;
                const char* local_name = this.locals[i].name;
                matches = this.same_name(local_name, name);
            }
            if (owner == frame_index && matches) {
                return cell_index;
            }
            i = i - 1;
        }
        return -1;
    }

    long set_frame_position(long frame_index, long block_index, long inst_index) {
        if (frame_index < 0 || frame_index >= this.frame_count || this.is_released() ||
            this.allocation_failed != 0) {
            return 0;
        }
        unsafe {
            if (this.frames[frame_index].active == 0) {
                return 0;
            }
            this.frames[frame_index].block_index = block_index;
            this.frames[frame_index].inst_index = inst_index;
        }
        return 1;
    }

    // Records a CFG edge. A self-edge reproduces the oracle's execBlock quirk
    // (interpreter.cpp:162-171): execInst resets curInst to 0 and execBlock
    // then increments it, so execution resumes at the block's second
    // instruction. inst_index = 1 marks that resume for the runner.
    long set_frame_edge(long frame_index, long dest) {
        long marker = -1;
        if (frame_index >= 0 && frame_index < this.frame_count) {
            unsafe {
                if (this.frames[frame_index].active != 0 &&
                    this.frames[frame_index].block_index == dest) {
                    marker = 1;
                }
            }
        }
        return this.set_frame_position(frame_index, dest, marker);
    }

    long set_frame_return(long frame_index, long state, long value_index) {
        if (frame_index < 0 || frame_index >= this.frame_count ||
            (value_index >= this.value_count) || (value_index < -1) || this.is_released() ||
            this.allocation_failed != 0 || state < 0 || state > 3) {
            return 0;
        }
        unsafe {
            if (this.frames[frame_index].active == 0) {
                return 0;
            }
            this.frames[frame_index].return_state = state;
            this.frames[frame_index].return_value = value_index;
        }
        return 1;
    }

    long current_local(const char* name) {
        return this.find_local(this.current_frame, name);
    }

    IFunctionResolution resolve_function(IFunctionQuery query) {
        IFunctionResolution answer;
        answer.state = 0;
        answer.function_index = -1;
        answer.candidate_count = 0;
        if (this.is_null_name(query.name) || query.function_count < 0) {
            return answer;
        }
        bool functions_null = false;
        unsafe {
            functions_null = query.functions == (MFunction*) 0;
        }
        if (functions_null) {
            return answer;
        }
        long i = 0;
        while (i < query.function_count) {
            bool matches = false;
            unsafe {
                const char* candidate_name = query.functions[i].name;
                matches = this.same_name(candidate_name, query.name);
            }
            if (matches) {
                answer.candidate_count = answer.candidate_count + 1;
                answer.function_index = i;
            }
            i = i + 1;
        }
        if (answer.candidate_count == 0) {
            answer.state = 0;
            answer.function_index = -1;
        } else if (answer.candidate_count == 1) {
            answer.state = 1;
        } else {
            answer.state = 2;
            answer.function_index = -1;
        }
        return answer;
    }

    long set_result(long state, long value_index, long status) {
        if (this.setup_done == 0 || this.is_released() || this.allocation_failed != 0 ||
            state < 0 || state > 3 || value_index < -1 || value_index >= this.value_count) {
            return 0;
        }
        this.result.state = state;
        this.result.value_index = value_index;
        this.result.status = status;
        return 1;
    }

    bool is_float_base(const char* b) {
        return this.same_name(b, "float") || this.same_name(b, "double") ||
               this.same_name(b, "long double") || this.same_name(b, "float16_t") ||
               this.same_name(b, "float32_t") || this.same_name(b, "float64_t") ||
               this.same_name(b, "float128_t") || this.same_name(b, "bfloat16_t");
    }

    // Oracle printValueTo renders these three bases as a character.
    bool is_char_base(const char* b) {
        return this.same_name(b, "char") || this.same_name(b, "int8_t") ||
               this.same_name(b, "uint8_t");
    }

    bool is_integer_base(const char* b) {
        return this.same_name(b, "bool") || this.same_name(b, "char") ||
               this.same_name(b, "short") || this.same_name(b, "int") ||
               this.same_name(b, "long") || this.same_name(b, "long long") ||
               this.same_name(b, "int8_t") || this.same_name(b, "int16_t") ||
               this.same_name(b, "int32_t") || this.same_name(b, "int64_t") ||
               this.same_name(b, "int128_t") || this.same_name(b, "uint8_t") ||
               this.same_name(b, "uint16_t") || this.same_name(b, "uint32_t") ||
               this.same_name(b, "uint64_t") || this.same_name(b, "uint128_t") ||
               this.same_name(b, "size_t") || this.same_name(b, "ptrdiff_t") ||
               this.same_name(b, "uptr_t");
    }

    // The oracle compares `Value::asStr()` for either operand.  A non-string
    // Value's `str` payload is empty, so a non-string operand behaves like an
    // empty byte string in the oracle's string branch.  Mirror that.
    long string_length_loose(long value_index) {
        if (this.value_kind(value_index) == 5) {
            return this.read_string_length(value_index);
        }
        return 0;
    }

    long string_byte_loose(long value_index, long byte_index) {
        if (this.value_kind(value_index) == 5) {
            return this.read_string_byte(value_index, byte_index);
        }
        return -1;
    }

    bool equal_strings(long left_val, long right_val) {
        long llen = this.string_length_loose(left_val);
        long rlen = this.string_length_loose(right_val);
        if (llen != rlen) {
            return false;
        }
        long i = 0;
        while (i < llen) {
            if (this.string_byte_loose(left_val, i) != this.string_byte_loose(right_val, i)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    bool format_long(long val, char* buf, long* out_len) {
        unsafe {
            if (buf == (char*) 0 || out_len == (long*) 0) {
                return false;
            }
            char digits[32];
            long pos = 0;
            uint64 mag = 0;
            if (val < 0) {
                mag = (uint64)0 - (uint64)val;
            } else {
                mag = (uint64)val;
            }
            if (mag == 0) {
                digits[0] = 48; // '0'
                pos = 1;
            } else {
                while (mag > 0) {
                    long d = (long)(mag % 10);
                    digits[pos] = (char)(48 + d);
                    pos = pos + 1;
                    mag = mag / 10;
                }
            }
            long out_pos = 0;
            if (val < 0) {
                buf[0] = 45; // '-'
                out_pos = 1;
            }
            long i = pos - 1;
            while (i >= 0) {
                buf[out_pos] = digits[i];
                out_pos = out_pos + 1;
                i = i - 1;
            }
            buf[out_pos] = 0;
            out_len[0] = out_pos;
        }
        return true;
    }

    // Append the decimal form of `val` to a NUL-terminated message buffer.
    void append_long(char* out, long* out_len, long val) {
        unsafe {
            if (out == (char*) 0 || out_len == (long*) 0) {
                return;
            }
            char digits[32];
            long pos = 0;
            uint64 mag = 0;
            if (val < 0) {
                mag = (uint64)0 - (uint64)val;
            } else {
                mag = (uint64)val;
            }
            if (mag == 0) {
                digits[0] = 48; // '0'
                pos = 1;
            } else {
                while (mag > 0) {
                    long d = (long)(mag % 10);
                    digits[pos] = (char)(48 + d);
                    pos = pos + 1;
                    mag = mag / 10;
                }
            }
            long cur = out_len[0];
            if (val < 0) {
                out[cur] = 45; // '-'
                cur = cur + 1;
            }
            long i = pos - 1;
            while (i >= 0) {
                out[cur] = digits[i];
                cur = cur + 1;
                i = i - 1;
            }
            out[cur] = 0;
            out_len[0] = cur;
        }
    }

    void append_to_msg(char* out, long* out_len, const char* str) {
        unsafe {
            if (out == (char*) 0 || out_len == (long*) 0 || str == (char*) 0) {
                return;
            }
            long cur = out_len[0];
            long i = 0;
            while (str[i] != 0) {
                out[cur] = str[i];
                cur = cur + 1;
                i = i + 1;
            }
            out[cur] = 0;
            out_len[0] = cur;
        }
    }

    // ---- P4: internal stdout/stderr byte buffers ----
    // The buffers live in the shared control block, so a shallow copy of the
    // model aliases the same streams (writes through either copy are visible
    // through both) and release() frees them exactly once; after any copy
    // releases, every copy reports empty streams. Lengths are explicit, so
    // embedded NUL bytes survive and are never treated as terminators.

    bool ensure_stream(long is_err, long extra) {
        if (this.setup_done == 0 || this.is_released() ||
            this.allocation_failed != 0 || extra < 0) {
            return false;
        }
        unsafe {
            if (this.control == (InterpreterControl*) 0) {
                return false;
            }
            long cap = this.control->out_cap;
            long len = this.control->out_len;
            char* old = this.control->out_buf;
            if (is_err != 0) {
                cap = this.control->err_cap;
                len = this.control->err_len;
                old = this.control->err_buf;
            }
            if (len > this.signed_long_max() - extra) {
                this.allocation_failed = 1;
                return false;
            }
            long need = len + extra;
            if (need <= cap) {
                return true;
            }
            long new_cap = 64;
            if (cap > 0) {
                new_cap = cap;
            }
            while (new_cap < need) {
                if (!this.valid_pool_growth(new_cap, 1)) {
                    this.allocation_failed = 1;
                    return false;
                }
                new_cap = new_cap * 2;
            }
            char* fresh = (char*) __ivy_alloc(new_cap);
            if (fresh == (char*) 0) {
                this.allocation_failed = 1;
                return false;
            }
            long i = 0;
            while (i < len && old != (char*) 0) {
                fresh[i] = old[i];
                i = i + 1;
            }
            if (old != (char*) 0) {
                __ivy_free((void*) old);
            }
            if (is_err != 0) {
                this.control->err_buf = fresh;
                this.control->err_cap = new_cap;
            } else {
                this.control->out_buf = fresh;
                this.control->out_cap = new_cap;
            }
        }
        return true;
    }

    void stream_write(long is_err, const char* bytes, long length) {
        if (length <= 0 || this.null_str(bytes)) {
            return;
        }
        if (!this.ensure_stream(is_err, length)) {
            return;
        }
        unsafe {
            long len = this.control->out_len;
            char* buf = this.control->out_buf;
            if (is_err != 0) {
                len = this.control->err_len;
                buf = this.control->err_buf;
            }
            long i = 0;
            while (i < length) {
                buf[len + i] = bytes[i];
                i = i + 1;
            }
            if (is_err != 0) {
                this.control->err_len = len + length;
            } else {
                this.control->out_len = len + length;
            }
        }
    }

    void stream_byte(long is_err, long byte) {
        if (!this.ensure_stream(is_err, 1)) {
            return;
        }
        unsafe {
            long len = this.control->out_len;
            char* buf = this.control->out_buf;
            if (is_err != 0) {
                len = this.control->err_len;
                buf = this.control->err_buf;
            }
            buf[len] = (char) byte;
            if (is_err != 0) {
                this.control->err_len = len + 1;
            } else {
                this.control->out_len = len + 1;
            }
        }
    }

    void stream_text(long is_err, const char* text) {
        this.stream_write(is_err, text, this.slen(text));
    }

    // Decimal (signed) emission without libc.
    void stream_long(long is_err, long value) {
        unsafe {
            char digits[32];
            long pos = 0;
            uint64 mag = 0;
            if (value < 0) {
                mag = (uint64) 0 - (uint64) value;
            } else {
                mag = (uint64) value;
            }
            if (mag == 0) {
                digits[0] = 48; // '0'
                pos = 1;
            } else {
                while (mag > 0) {
                    long d = (long) (mag % 10);
                    digits[pos] = (char) (48 + d);
                    pos = pos + 1;
                    mag = mag / 10;
                }
            }
            if (!this.ensure_stream(is_err, pos + 1)) {
                return;
            }
            long len = this.control->out_len;
            char* buf = this.control->out_buf;
            if (is_err != 0) {
                len = this.control->err_len;
                buf = this.control->err_buf;
            }
            if (value < 0) {
                buf[len] = 45; // '-'
                len = len + 1;
            }
            long i = pos - 1;
            while (i >= 0) {
                buf[len] = digits[i];
                len = len + 1;
                i = i - 1;
            }
            if (is_err != 0) {
                this.control->err_len = len;
            } else {
                this.control->out_len = len;
            }
        }
    }

    // Unsigned decimal digits into `out`; returns the digit count.
    long format_uint(uint64 value, char* out) {
        unsafe {
            if (out == (char*) 0) {
                return 0;
            }
            if (value == 0) {
                out[0] = 48;
                return 1;
            }
            char rev[32];
            long pos = 0;
            while (value > 0) {
                rev[pos] = (char) (48 + (long) (value % 10));
                value = value / 10;
                pos = pos + 1;
            }
            long i = 0;
            while (i < pos) {
                out[i] = rev[pos - 1 - i];
                i = i + 1;
            }
            return pos;
        }
        return 0;
    }

    // ---- P4: hand-written %g / %e / %f (no libc) ----
    // %g: 6 significant digits by default; exponential form when the decimal
    // exponent is < -4 or >= precision; trailing zeros and a trailing '.'
    // are stripped unless the `#` flag is present. Subnormals are pre-scaled
    // by 1e300 so six significant digits remain representable. The routines
    // return the byte count, or -1 for a spec the port deliberately gates.

    double pow10d(long e) {
        unsafe {
            if (e >= 0) {
                double r = 1.0;
                long i = 0;
                while (i < e) {
                    r = r * 10.0;
                    i = i + 1;
                }
                return r;
            }
            double p = this.pow10d(-e);
            return 1.0 / p;
        }
        return 1.0;
    }

    long pow10i(long e) {
        long r = 1;
        long i = 0;
        while (i < e) {
            r = r * 10;
            i = i + 1;
        }
        return r;
    }

    // Rounded n significant decimal digits of the non-negative finite `v`.
    // Returns 0 and writes `digits[0..n-1]` plus the decimal exponent, or -1
    // when the scaled value would exceed the signed-64 range. Guard digits
    // (two) drive half-even rounding; an exact 50 guard is a tie.
    long decimal_digits(double v, long n, long* exp_out, char* digits) {
        unsafe {
            if (v < 0.0 || n <= 0 || n > 15 ||
                exp_out == (long*) 0 || digits == (char*) 0) {
                return -1;
            }
            long e = 0;
            double a = v;
            if (v != 0.0) {
                while (a >= 10.0 && e < 400) {
                    a = a / 10.0;
                    e = e + 1;
                }
                while (a < 1.0 && e > -400) {
                    a = a * 10.0;
                    e = e - 1;
                }
            }
            long attempt = 0;
            while (attempt < 3) {
                double scaled = 0.0;
                long k = n + 1 - e;
                if (k > 308 || k < -308) {
                    // Extreme exponent: scale the normalized mantissa, whose
                    // magnitude is safely in [1, 10).
                    scaled = a * this.pow10d(n + 1);
                } else {
                    scaled = v * this.pow10d(k);
                }
                if (scaled >= 9.0e18) {
                    return -1;
                }
                long ip = 0;
                if (scaled > 0.0) {
                    ip = (long) scaled;
                }
                double frac = scaled - (double) ip;
                long rem = ip % 100;
                long keep = ip / 100;
                long low = this.pow10i(n - 1);
                long limit = low * 10;
                if (keep < low && attempt < 2 && k <= 308 && k >= -308) {
                    // The exponent estimate was one too high.
                    e = e - 1;
                    attempt = attempt + 1;
                } else {
                    if (keep < low && attempt < 2 && (k > 308 || k < -308)) {
                        // The normalized fallback cannot change with e.
                        return -1;
                    }
                    long d1 = rem / 10;
                    long rest = rem % 10;
                    long up = 0;
                    if (d1 > 5) {
                        up = 1;
                    } else if (d1 == 5) {
                        if (rest > 0 || frac > 1e-9) {
                            up = 1;
                        } else if ((keep % 2) != 0) {
                            up = 1;
                        }
                    }
                    if (up != 0) {
                        keep = keep + 1;
                    }
                    if (keep >= limit) {
                        keep = keep / 10;
                        e = e + 1;
                    }
                    long x = keep;
                    long j = n - 1;
                    while (j >= 0) {
                        digits[j] = (char) (48 + (x % 10));
                        x = x / 10;
                        j = j - 1;
                    }
                    exp_out[0] = e;
                    return 0;
                }
            }
            return -1;
        }
        return -1;
    }

    // Append the `%g` exponent suffix: e, sign, at least two digits.
    void append_exponent(char* out, long* pos, long e) {
        unsafe {
            out[pos[0]] = 101; // 'e'
            pos[0] = pos[0] + 1;
            long ae = e;
            if (e < 0) {
                out[pos[0]] = 45; // '-'
                ae = -e;
            } else {
                out[pos[0]] = 43; // '+'
            }
            pos[0] = pos[0] + 1;
            if (ae >= 100) {
                out[pos[0]] = (char) (48 + (ae / 100));
                pos[0] = pos[0] + 1;
            }
            long rem = ae % 100;
            out[pos[0]] = (char) (48 + (rem / 10));
            out[pos[0] + 1] = (char) (48 + (rem % 10));
            pos[0] = pos[0] + 2;
        }
    }

    long format_g(double v, long precision, long alt, char* out) {
        unsafe {
            long pos = 0;
            long neg = 0;
            double a = v;
            if (v < 0.0) {
                neg = 1;
                a = v * -1.0;
            } else if (v == 0.0) {
                if ((1.0 / v) < 0.0) {
                    neg = 1;
                }
            }
            if (a != a) {
                out[0] = 110;
                out[1] = 97;
                out[2] = 110;
                return 3;
            }
            if (a > 1.7976931348623157e308) {
                if (neg != 0) {
                    out[0] = 45;
                    pos = 1;
                }
                out[pos] = 105;
                out[pos + 1] = 110;
                out[pos + 2] = 102;
                return pos + 3;
            }
            long p = precision;
            if (p < 0) {
                p = 6;
            }
            if (p == 0) {
                p = 1;
            }
            if (p > 15) {
                return -1;
            }
            long e = 0;
            char* digits = (char*) __ivy_alloc(64);
            if (digits == (char*) 0) {
                return -1;
            }
            long k = 0;
            while (k < 24) {
                digits[k] = 48;
                k = k + 1;
            }
            if (a != 0.0) {
                if (this.decimal_digits(a, p, &e, digits) != 0) {
                    __ivy_free((void*) digits);
                    return -1;
                }
            }
            long nd = p;
            if (alt == 0) {
                while (nd > 1 && digits[nd - 1] == 48) {
                    nd = nd - 1;
                }
            }
            if (neg != 0) {
                out[pos] = 45;
                pos = pos + 1;
            }
            bool sci = false;
            if (e < -4) {
                sci = true;
            }
            if (e >= p) {
                sci = true;
            }
            if (sci) {
                out[pos] = digits[0];
                pos = pos + 1;
                if (nd > 1 || alt != 0) {
                    out[pos] = 46;
                    pos = pos + 1;
                    long j = 1;
                    while (j < nd) {
                        out[pos] = digits[j];
                        pos = pos + 1;
                        j = j + 1;
                    }
                    if (alt != 0) {
                        while (j < p) {
                            out[pos] = 48;
                            pos = pos + 1;
                            j = j + 1;
                        }
                    }
                }
                this.append_exponent(out, &pos, e);
            } else if (e >= 0) {
                long int_digits = e + 1;
                long j = 0;
                while (j < nd && j < int_digits) {
                    out[pos] = digits[j];
                    pos = pos + 1;
                    j = j + 1;
                }
                while (j < int_digits) {
                    out[pos] = 48;
                    pos = pos + 1;
                    j = j + 1;
                }
                if (j < nd || alt != 0) {
                    out[pos] = 46;
                    pos = pos + 1;
                    long stop = nd;
                    if (alt != 0) {
                        stop = p;
                    }
                    while (j < stop) {
                        out[pos] = digits[j];
                        pos = pos + 1;
                        j = j + 1;
                    }
                }
            } else {
                // 0 < value < 1 in fixed notation: always at least one
                // fractional digit, even after trailing-zero stripping
                // collapses the mantissa to a single digit (0.1, 0.0001).
                out[pos] = 48;
                pos = pos + 1;
                long stop = nd;
                if (alt != 0) {
                    stop = p;
                }
                out[pos] = 46;
                pos = pos + 1;
                long z = -e - 1;
                while (z > 0) {
                    out[pos] = 48;
                    pos = pos + 1;
                    z = z - 1;
                }
                long j = 0;
                while (j < stop) {
                    out[pos] = digits[j];
                    pos = pos + 1;
                    j = j + 1;
                }
            }
            __ivy_free((void*) digits);
            return pos;
        }
        return 0;
    }

    long format_e(double v, long precision, long alt, char* out) {
        unsafe {
            long pos = 0;
            long neg = 0;
            double a = v;
            if (v < 0.0) {
                neg = 1;
                a = v * -1.0;
            } else if (v == 0.0) {
                if ((1.0 / v) < 0.0) {
                    neg = 1;
                }
            }
            if (a != a) {
                out[0] = 110;
                out[1] = 97;
                out[2] = 110;
                return 3;
            }
            if (a > 1.7976931348623157e308) {
                if (neg != 0) {
                    out[0] = 45;
                    pos = 1;
                }
                out[pos] = 105;
                out[pos + 1] = 110;
                out[pos + 2] = 102;
                return pos + 3;
            }
            long p = precision;
            if (p < 0) {
                p = 6;
            }
            if (p > 15) {
                return -1;
            }
            long nd = p + 1;
            long e = 0;
            char* digits = (char*) __ivy_alloc(64);
            if (digits == (char*) 0) {
                return -1;
            }
            long k = 0;
            while (k < 24) {
                digits[k] = 48;
                k = k + 1;
            }
            if (a != 0.0) {
                if (this.decimal_digits(a, nd, &e, digits) != 0) {
                    __ivy_free((void*) digits);
                    return -1;
                }
            }
            if (neg != 0) {
                out[pos] = 45;
                pos = pos + 1;
            }
            out[pos] = digits[0];
            pos = pos + 1;
            if (p > 0 || alt != 0) {
                out[pos] = 46;
                pos = pos + 1;
            }
            long j = 1;
            while (j < nd) {
                out[pos] = digits[j];
                pos = pos + 1;
                j = j + 1;
            }
            this.append_exponent(out, &pos, e);
            __ivy_free((void*) digits);
            return pos;
        }
        return 0;
    }

    // %f. Returns -1 for |v| >= 1e15 or a precision > 17: the port keeps
    // those specs gated (documented divergence) instead of emitting bytes
    // it cannot format exactly.
    long format_f(double v, long precision, long alt, char* out) {
        unsafe {
            long pos = 0;
            long neg = 0;
            double a = v;
            if (v < 0.0) {
                neg = 1;
                a = v * -1.0;
            } else if (v == 0.0) {
                if ((1.0 / v) < 0.0) {
                    neg = 1;
                }
            }
            if (a != a) {
                out[0] = 110;
                out[1] = 97;
                out[2] = 110;
                return 3;
            }
            if (a > 1.7976931348623157e308) {
                if (neg != 0) {
                    out[0] = 45;
                    pos = 1;
                }
                out[pos] = 105;
                out[pos + 1] = 110;
                out[pos + 2] = 102;
                return pos + 3;
            }
            long p = precision;
            if (p < 0) {
                p = 6;
            }
            if (p > 17 || a >= 1e15) {
                return -1;
            }
            long ip = (long) a;
            double frac = a - (double) ip;
            char digits[24];
            long k = 0;
            while (k <= p) {
                frac = frac * 10.0;
                long dd = (long) frac;
                frac = frac - (double) dd;
                digits[k] = (char) (48 + dd);
                k = k + 1;
            }
            long roundup = 0;
            if (digits[p] > 53) {
                roundup = 1;
            } else if (digits[p] == 53) {
                if (frac > 0.0) {
                    roundup = 1;
                } else {
                    long last = 0;
                    if (p > 0) {
                        last = (long) (digits[p - 1] - 48);
                    } else {
                        last = ip % 10;
                    }
                    if ((last % 2) != 0) {
                        roundup = 1;
                    }
                }
            }
            if (roundup != 0) {
                long carry_all = 1;
                k = p - 1;
                while (k >= 0) {
                    if (digits[k] == 57) {
                        digits[k] = 48;
                        k = k - 1;
                    } else {
                        digits[k] = (char) (digits[k] + 1);
                        carry_all = 0;
                        k = -1;
                    }
                }
                if (carry_all != 0) {
                    ip = ip + 1;
                    long j = 0;
                    while (j < p) {
                        digits[j] = 48;
                        j = j + 1;
                    }
                }
            }
            if (neg != 0) {
                out[0] = 45;
                pos = 1;
            }
            char ib[24];
            long ipos = 0;
            uint64 im = (uint64) ip;
            if (im == 0) {
                ib[0] = 48;
                ipos = 1;
            } else {
                while (im > 0) {
                    ib[ipos] = (char) (48 + (long) (im % 10));
                    ipos = ipos + 1;
                    im = im / 10;
                }
            }
            long j = ipos - 1;
            while (j >= 0) {
                out[pos] = ib[j];
                pos = pos + 1;
                j = j - 1;
            }
            if (p > 0 || alt != 0) {
                out[pos] = 46;
                pos = pos + 1;
            }
            k = 0;
            while (k < p) {
                out[pos] = digits[k];
                pos = pos + 1;
                k = k + 1;
            }
            return pos;
        }
        return 0;
    }

    // Emit a numeric body with an optional sign and field padding.
    void emit_field(char* body, long body_len, long sign_char, long zero_ok,
                    long minus, long width, long is_err) {
        if (body_len < 0) {
            return;
        }
        long sign_len = 0;
        if (sign_char != 0) {
            sign_len = 1;
        }
        long total = body_len + sign_len;
        long pad = 0;
        if (width > total) {
            pad = width - total;
        }
        if (minus != 0) {
            if (sign_char != 0) {
                this.stream_byte(is_err, sign_char);
            }
            this.stream_write(is_err, body, body_len);
            long k = 0;
            while (k < pad) {
                this.stream_byte(is_err, 32);
                k = k + 1;
            }
        } else if (zero_ok != 0 && pad > 0) {
            if (sign_char != 0) {
                this.stream_byte(is_err, sign_char);
            }
            long k = 0;
            while (k < pad) {
                this.stream_byte(is_err, 48);
                k = k + 1;
            }
            this.stream_write(is_err, body, body_len);
        } else {
            long k = 0;
            while (k < pad) {
                this.stream_byte(is_err, 32);
                k = k + 1;
            }
            if (sign_char != 0) {
                this.stream_byte(is_err, sign_char);
            }
            this.stream_write(is_err, body, body_len);
        }
    }

    // ---- P4: value rendering, extraction, and builtin dispatch ----

    // Oracle extractString (interpreter.cpp:1079-1086): a Str value, or a
    // pointer whose pointee is a Str.
    long extract_string_value(long value_index) {
        long k = this.value_kind(value_index);
        if (k == 5) {
            return value_index;
        }
        if (k == 3 && this.pointer_is_null(value_index) == 0) {
            long cell = this.pointer_cell(value_index);
            long pointee = this.cell_value(cell);
            if (this.value_kind(pointee) == 5) {
                return pointee;
            }
        }
        return -1;
    }

    void stream_string_value(long is_err, long value_index) {
        long s = this.extract_string_value(value_index);
        if (s < 0) {
            return;
        }
        long n = this.read_string_length(s);
        if (n <= 0) {
            return;
        }
        unsafe {
            this.stream_write(is_err, this.values[s].string_bytes, n);
        }
    }

    void stream_float(long is_err, double value) {
        unsafe {
            char* float_buf = (char*) __ivy_alloc(128);
            if (float_buf == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            long n = this.format_g(value, 6, 0, float_buf);
            if (n > 0) {
                this.stream_write(is_err, float_buf, n);
            }
            __ivy_free((void*) float_buf);
        }
    }

    // Oracle printValueTo (interpreter.cpp:1102-1124): the MIR expression type
    // decides char/bool rendering; the value kind decides everything else.
    void stream_value(long is_err, long value_index, const char* type_base) {
        long k = this.value_kind(value_index);
        if (k == 1) {
            long iv = this.read_int(value_index);
            if (this.is_char_base(type_base)) {
                this.stream_byte(is_err, iv);
            } else if (this.same_name(type_base, "bool")) {
                if (iv != 0) {
                    this.stream_text(is_err, "true");
                } else {
                    this.stream_text(is_err, "false");
                }
            } else {
                this.stream_long(is_err, iv);
            }
        } else if (k == 2) {
            this.stream_float(is_err, this.read_float(value_index));
        } else if (k == 5) {
            this.stream_string_value(is_err, value_index);
        } else if (k == 3) {
            if (this.pointer_is_null(value_index) != 0) {
                this.stream_text(is_err, "nullptr");
            } else {
                this.stream_text(is_err, "(ptr)");
            }
        } else if (k == 4) {
            long si = this.read_struct_index(value_index);
            this.stream_byte(is_err, 123); // '{'
            if (si >= 0 && si < this.struct_count) {
                unsafe {
                    this.stream_text(is_err, this.structs[si].name);
                }
            }
            this.stream_byte(is_err, 125); // '}'
        } else if (k == 0) {
            this.stream_text(is_err, "void");
        }
    }

    long expr_kind(MUnit* u, long expr_idx) {
        long k = -1;
        unsafe {
            if (u != (MUnit*) 0 && expr_idx >= 0 && expr_idx < u->ex_n) {
                k = u->exprs[expr_idx].kind;
            }
        }
        return k;
    }

    const char* expr_type_base(MUnit* u, long expr_idx) {
        unsafe {
            const char* base = (char*) 0;
            if (u != (MUnit*) 0 && expr_idx >= 0 && expr_idx < u->ex_n) {
                const char* t = u->exprs[expr_idx].type.base;
                if (t != (char*) 0) {
                    base = t;
                }
            }
            if (base == (char*) 0) {
                base = (char*) "";
            }
            return base;
        }
        return "";
    }

    // io::print / println / eprint / eprintln (interpreter.cpp:916-961).
    // The {} format path is selected only when argument 0 is a StringLit
    // expression; otherwise every argument is printed with its MIR type.
    long builtin_io(MUnit* u, long astart, long an, long* vals, const char* callee) {
        unsafe {
        long is_err = 0;
        long is_ln = 0;
        if (this.same_name(callee, "io::println") ||
            this.same_name(callee, "io::eprintln")) {
            is_ln = 1;
        }
        if (this.same_name(callee, "io::eprint") ||
            this.same_name(callee, "io::eprintln")) {
            is_err = 1;
        }
        bool has_fmt = false;
        if (an > 0 && vals != (long*) 0 && u != (MUnit*) 0 &&
            astart >= 0 && astart < u->a_n) {
            if (this.expr_kind(u, u->args[astart]) == 2) {
                has_fmt = true;
            }
        }
        if (has_fmt) {
            long fmt = vals[0];
            long fmt_len = this.read_string_length(fmt);
            long argi = 1;
            long i = 0;
            while (i < fmt_len) {
                long b = this.read_string_byte(fmt, i);
                if (b == 123 && (i + 1) < fmt_len &&
                    this.read_string_byte(fmt, i + 1) == 125) {
                    if (argi < an) {
                        long expr = -1;
                        if (u != (MUnit*) 0 && astart >= 0 &&
                            (astart + argi) < u->a_n) {
                            expr = u->args[astart + argi];
                        }
                        this.stream_value(is_err, vals[argi],
                                          this.expr_type_base(u, expr));
                        argi = argi + 1;
                    }
                    i = i + 2;
                } else {
                    this.stream_byte(is_err, b);
                    i = i + 1;
                }
            }
        } else {
            long j = 0;
            while (j < an) {
                long expr = -1;
                if (u != (MUnit*) 0 && astart >= 0 &&
                    (astart + j) < u->a_n) {
                    expr = u->args[astart + j];
                }
                this.stream_value(is_err, vals[j],
                                  this.expr_type_base(u, expr));
                j = j + 1;
            }
        }
        if (is_ln != 0) {
            this.stream_byte(is_err, 10);
        }
        return this.make_void();
        }
    }

    // ivy::print / ivy::println (interpreter.cpp:967-984): only the first
    // argument is rendered; println adds one newline (including for zero args).
    long builtin_ivy_print(long an, long* vals, const char* callee) {
        unsafe {
        long is_ln = 0;
        if (this.same_name(callee, "ivy::println")) {
            is_ln = 1;
        }
        if (an > 0 && vals != (long*) 0) {
            this.stream_value(0, vals[0], "");
        }
        if (is_ln != 0) {
            this.stream_byte(0, 10);
        }
        return this.make_void();
        }
    }

    void terminate(long kind, long status) {
        if (this.setup_done == 0 || this.is_released()) {
            return;
        }
        this.termination_kind_ = kind;
        this.termination_status_ = status;
        this.result.state = 3;
        this.result.value_index = -1;
        this.result.status = status;
    }

    long builtin_printf(long* vals, long an, long line, long col) {
        unsafe {
        if (an <= 0 || vals == (long*) 0) {
            return this.make_int(0);
        }
        long fmt = this.extract_string_value(vals[0]);
        if (fmt < 0) {
            return this.make_int(0);
        }
        long fmt_len = this.read_string_length(fmt);
        {
            char* buf = (char*) __ivy_alloc(1024);
            if (buf == (char*) 0) {
                this.allocation_failed = 1;
                return this.make_int(0);
            }
            char* digits = buf + 512;
            long total = 0;
            long ai = 1;
            long i = 0;
            while (i < fmt_len) {
                long c = this.read_string_byte(fmt, i);
                if (c != 37) { // '%'
                    this.stream_byte(0, c);
                    total = total + 1;
                    i = i + 1;
                } else {
                    long mark = i;
                    i = i + 1;
                    if (i >= fmt_len) {
                        break;
                    }
                    long minus = 0;
                    long plus = 0;
                    long space = 0;
                    long alt = 0;
                    long zero = 0;
                    long width = 0;
                    long prec = -1;
                    long hasprec = 0;
                    long seen_digit = 0;
                    while (i < fmt_len) {
                        long fc = this.read_string_byte(fmt, i);
                        if (fc == 45) {
                            minus = 1;
                            i = i + 1;
                        } else if (fc == 43) {
                            plus = 1;
                            i = i + 1;
                        } else if (fc == 32) {
                            space = 1;
                            i = i + 1;
                        } else if (fc == 35) {
                            alt = 1;
                            i = i + 1;
                        } else if (fc == 48 && seen_digit == 0) {
                            zero = 1;
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                    while (i < fmt_len) {
                        long dc = this.read_string_byte(fmt, i);
                        if (dc >= 48 && dc <= 57) {
                            if (width <= 100000) {
                                width = width * 10 + (dc - 48);
                            }
                            seen_digit = 1;
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                    if (i < fmt_len && this.read_string_byte(fmt, i) == 46) {
                        hasprec = 1;
                        prec = 0;
                        i = i + 1;
                        while (i < fmt_len) {
                            long pc = this.read_string_byte(fmt, i);
                            if (pc >= 48 && pc <= 57) {
                                if (prec <= 100000) {
                                    prec = prec * 10 + (pc - 48);
                                }
                                i = i + 1;
                            } else {
                                break;
                            }
                        }
                    }
                    long flags_end = i;
                    while (i < fmt_len) {
                        long mc = this.read_string_byte(fmt, i);
                        if (mc == 108 || mc == 104 || mc == 122 ||
                            mc == 106 || mc == 116) {
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                    if (i >= fmt_len) {
                        break;
                    }
                    long spec = this.read_string_byte(fmt, i);
                    i = i + 1;
                    if (spec == 37) {
                        this.stream_byte(0, 37);
                        total = total + 1;
                    } else if (width > 200 || prec > 17) {
                        this.error(line, col,
                            "IvyInterpret v0.4: printf width/precision not supported");
                        break;
                    } else {
                        long arg = -1;
                        if (ai < an) {
                            arg = vals[ai];
                        }
                        ai = ai + 1;
                        long arg_kind = this.value_kind(arg);
                        long sign_char = 0;
                        long pad = 0;
                        if (spec == 100 || spec == 105) { // d i
                            long v = 0;
                            if (arg_kind == 1) {
                                v = this.read_int(arg);
                            } else if (arg_kind == 2) {
                                v = (long) this.read_float(arg);
                            }
                            long neg = 0;
                            uint64 mag = 0;
                            if (v < 0) {
                                neg = 1;
                                mag = (uint64) 0 - (uint64) v;
                            } else {
                                mag = (uint64) v;
                            }
                            long nd = 0;
                            if (!(hasprec != 0 && prec == 0 && mag == 0)) {
                                nd = this.format_uint(mag, digits);
                            }
                            long bl = 0;
                            if (hasprec != 0) {
                                long z = prec - nd;
                                while (z > 0) {
                                    buf[bl] = 48;
                                    bl = bl + 1;
                                    z = z - 1;
                                }
                            }
                            long q = 0;
                            while (q < nd) {
                                buf[bl] = digits[q];
                                bl = bl + 1;
                                q = q + 1;
                            }
                            if (neg != 0) {
                                sign_char = 45;
                            } else if (plus != 0) {
                                sign_char = 43;
                            } else if (space != 0) {
                                sign_char = 32;
                            }
                            long zok = 0;
                            if (zero != 0 && minus == 0 && hasprec == 0) {
                                zok = 1;
                            }
                            long body_total = bl;
                            if (sign_char != 0) {
                                body_total = body_total + 1;
                            }
                            if (width > body_total) {
                                pad = width - body_total;
                            }
                            this.emit_field(buf, bl, sign_char, zok, minus, width, 0);
                            total = total + body_total + pad;
                        } else if (spec == 117) { // u
                            long v = 0;
                            if (arg_kind == 1) {
                                v = this.read_int(arg);
                            } else if (arg_kind == 2) {
                                v = (long) this.read_float(arg);
                            }
                            uint64 mag = (uint64) v;
                            long nd = 0;
                            if (!(hasprec != 0 && prec == 0 && mag == 0)) {
                                nd = this.format_uint(mag, digits);
                            }
                            long bl = 0;
                            if (hasprec != 0) {
                                long z = prec - nd;
                                while (z > 0) {
                                    buf[bl] = 48;
                                    bl = bl + 1;
                                    z = z - 1;
                                }
                            }
                            long q = 0;
                            while (q < nd) {
                                buf[bl] = digits[q];
                                bl = bl + 1;
                                q = q + 1;
                            }
                            long zok = 0;
                            if (zero != 0 && minus == 0 && hasprec == 0) {
                                zok = 1;
                            }
                            long body_total = bl;
                            if (width > body_total) {
                                pad = width - body_total;
                            }
                            this.emit_field(buf, bl, 0, zok, minus, width, 0);
                            total = total + body_total + pad;
                        } else if (spec == 102 || spec == 103 || spec == 101) { // f g e
                            double dv = 0.0;
                            if (arg_kind == 2) {
                                dv = this.read_float(arg);
                            } else if (arg_kind == 1) {
                                dv = (double) this.read_int(arg);
                            }
                            long pp = -1;
                            if (hasprec != 0) {
                                pp = prec;
                            }
                            long blen = -1;
                            if (spec == 102) {
                                blen = this.format_f(dv, pp, alt, digits);
                            } else if (spec == 103) {
                                blen = this.format_g(dv, pp, alt, digits);
                            } else {
                                blen = this.format_e(dv, pp, alt, digits);
                            }
                            if (blen < 0) {
                                this.error(line, col,
                                    "IvyInterpret v0.4: printf float spec out of supported range");
                                break;
                            }
                            long off = 0;
                            if (blen > 0 && digits[0] == 45) {
                                sign_char = 45;
                                off = 1;
                            } else if (plus != 0) {
                                sign_char = 43;
                            } else if (space != 0) {
                                sign_char = 32;
                            }
                            long zok = 0;
                            if (zero != 0 && minus == 0) {
                                zok = 1;
                            }
                            long body_total = blen - off;
                            if (sign_char != 0) {
                                body_total = body_total + 1;
                            }
                            if (width > body_total) {
                                pad = width - body_total;
                            }
                            this.emit_field(digits + off, blen - off, sign_char,
                                            zok, minus, width, 0);
                            total = total + body_total + pad;
                        } else if (spec == 115) { // s
                            long sv = this.extract_string_value(arg);
                            long sl = 0;
                            if (sv >= 0) {
                                sl = this.read_string_length(sv);
                                if (sl > 0) {
                                    this.stream_write(0, this.values[sv].string_bytes, sl);
                                }
                            }
                            total = total + sl;
                        } else if (spec == 99) { // c
                            long cv = 0;
                            if (arg_kind == 1) {
                                cv = this.read_int(arg);
                            }
                            this.stream_byte(0, cv);
                            total = total + 1;
                        } else if (spec == 112) { // p
                            this.stream_text(0, "(ptr)");
                            total = total + 5;
                        } else {
                            this.stream_byte(0, 37);
                            total = total + 1;
                            long q = mark + 1;
                            while (q < flags_end) {
                                long rc = this.read_string_byte(fmt, q);
                                this.stream_byte(0, rc);
                                total = total + 1;
                                q = q + 1;
                            }
                            this.stream_byte(0, spec);
                            total = total + 1;
                        }
                    }
                }
            }
            __ivy_free((void*) buf);
            return this.make_int(total);
        }
        return this.make_int(0);
        }
    }

    // All non-io/ivy::print-family builtins (interpreter.cpp:1131-1287).
    long eval_builtin(MUnit* u, long astart, long an, long* vals,
                      const char* callee, long line, long col) {
        unsafe {
        if (this.same_name(callee, "__ivy_alloc") ||
            this.same_name(callee, "malloc")) {
            long n = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                n = this.read_int(vals[0]);
            }
            if (n <= 0) {
                n = 1;
            }
            this.next_heap_alloc_id_ = this.next_heap_alloc_id_ + 1;
            long cell = this.new_cell(this.make_int(0));
            if (cell < 0) {
                return this.make_void();
            }
            return this.make_pointer(cell, 0, 3,
                                     this.next_heap_alloc_id_, (char*) 0);
        }
        if (this.same_name(callee, "__ivy_free") ||
            this.same_name(callee, "free")) {
            if (an > 0 && vals != (long*) 0) {
                long p = vals[0];
                if (this.value_kind(p) == 3 && this.pointer_is_null(p) == 0) {
                    long cell = this.pointer_cell(p);
                    if (cell >= 0 && cell < this.cell_count) {
                        this.values[cell].kind = 0; // Void, cell stays allocated
                    }
                }
            }
            return this.make_void();
        }
        if (this.same_name(callee, "puts")) {
            long n = 0;
            if (an > 0 && vals != (long*) 0) {
                long s = this.extract_string_value(vals[0]);
                if (s >= 0) {
                    n = this.read_string_length(s);
                    this.stream_string_value(0, vals[0]);
                }
            }
            this.stream_byte(0, 10);
            return this.make_int(n + 1);
        }
        if (this.same_name(callee, "putchar")) {
            long byte = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                byte = this.read_int(vals[0]);
            }
            this.stream_byte(0, byte);
            if (an > 0 && vals != (long*) 0) {
                return vals[0];
            }
            return this.make_int(0);
        }
        if (this.same_name(callee, "printf")) {
            return this.builtin_printf(vals, an, line, col);
        }
        if (this.same_name(callee, "exit")) {
            long code = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                code = this.read_int(vals[0]);
            }
            this.terminate(1, code);
            return this.make_void();
        }
        if (this.same_name(callee, "abort")) {
            // Oracle probe on this build: std::abort ends the process with
            // status 0xC0000409 (-1073740791) and no flushed stdout.
            this.terminate(2, -1073740791);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::print_int")) {
            long v = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                v = this.read_int(vals[0]);
            }
            this.stream_long(0, v);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::print_float")) {
            double v = 0.0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 2) {
                v = this.read_float(vals[0]);
            }
            this.stream_float(0, v);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::print_str")) {
            if (an > 0 && vals != (long*) 0) {
                this.stream_string_value(0, vals[0]);
            }
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::print_char")) {
            long v = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                v = this.read_int(vals[0]);
            }
            this.stream_byte(0, v);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::println_int")) {
            long v = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                v = this.read_int(vals[0]);
            }
            this.stream_long(0, v);
            this.stream_byte(0, 10);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::println_float")) {
            double v = 0.0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 2) {
                v = this.read_float(vals[0]);
            }
            this.stream_float(0, v);
            this.stream_byte(0, 10);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::println_str")) {
            if (an > 0 && vals != (long*) 0) {
                this.stream_string_value(0, vals[0]);
            }
            this.stream_byte(0, 10);
            return this.make_void();
        }
        if (this.same_name(callee, "ivy::println_char")) {
            long v = 0;
            if (an > 0 && vals != (long*) 0 && this.value_kind(vals[0]) == 1) {
                v = this.read_int(vals[0]);
            }
            this.stream_byte(0, v);
            this.stream_byte(0, 10);
            return this.make_void();
        }
        return this.make_void();
        }
    }

    // Diagnostic messages are built in a short-lived heap scratch buffer and
    // then interned (copied) by error(), so no caller buffer escapes. The
    // scratch size is derived from the dynamic parts so a long identifier or
    // operator can never overrun a fixed buffer.
    long diagnostic_scratch_size(const char* part) {
        return 64 + this.slen(part);
    }

    void error_undefined_var(long line, long col, const char* name) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(name));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "undefined variable '");
            this.append_to_msg(msg, &len, name);
            this.append_to_msg(msg, &len, "'");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    void error_unsupported_unary(long line, long col, const char* op) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(op));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "IvyInterpret v0.2: unsupported unary op '");
            this.append_to_msg(msg, &len, op);
            this.append_to_msg(msg, &len, "'");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    void error_unsupported_binary(long line, long col, const char* op) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(op));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "IvyInterpret v0.2: unsupported binary op '");
            this.append_to_msg(msg, &len, op);
            this.append_to_msg(msg, &len, "'");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    void error_index_out_of_bounds(long line, long col, long idx, long sz) {
        unsafe {
            char* msg = (char*) __ivy_alloc(128);
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "index out of bounds: index ");
            this.append_long(msg, &len, idx);
            this.append_to_msg(msg, &len, " out of range [0, ");
            this.append_long(msg, &len, sz);
            this.append_to_msg(msg, &len, ")");
            this.error(line, col, msg);
            __ivy_free((void*) msg);
        }
    }

    // True when `op` is exactly `plain` followed by one character, e.g.
    // plain "+" matches "+=" (the oracle strips the trailing '=' of a
    // compound assignment operator).  This replaces copying into a local
    // char array, which the Ivy subset cannot pass as a pointer.
    bool compound_plain_is(const char* op, const char* plain) {
        if (this.is_null_name(op) || this.is_null_name(plain)) {
            return false;
        }
        long plen = this.slen(plain);
        if (this.slen(op) != plen + 1) {
            return false;
        }
        long i = 0;
        unsafe {
            while (i < plen) {
                if (op[i] != plain[i]) {
                    return false;
                }
                i = i + 1;
            }
        }
        return true;
    }

    long lookup_local_cell(const char* name) {
        if (this.is_null_name(name) || this.current_frame < 0) {
            return -1;
        }
        long f = this.current_frame;
        while (f >= 0 && f < this.frame_count) {
            long c = this.find_local(f, name);
            if (c >= 0) {
                return c;
            }
            unsafe {
                f = this.frames[f].caller_index;
            }
        }
        return -1;
    }

    long lvalue_cell(MUnit* u, long expr_idx) {
        if (this.is_released()) {
            return -1;
        }
        unsafe {
            if (u == (MUnit*) 0 || expr_idx < 0 || expr_idx >= u->ex_n) {
                return -1;
            }
            long kind = u->exprs[expr_idx].kind;
            long a_idx = u->exprs[expr_idx].a;
            long b_idx = u->exprs[expr_idx].b;
            long astart = u->exprs[expr_idx].astart;
            long an = u->exprs[expr_idx].an;
            long line = u->exprs[expr_idx].line;
            long col = u->exprs[expr_idx].col;
            const char* sval = u->exprs[expr_idx].sval;
            if (kind == 6) { // IdentRef
                long c = this.lookup_local_cell(sval);
                if (c < 0) {
                    return -1;
                }
                long val_idx = this.cell_value(c);
                if (this.value_kind(val_idx) == 3 && this.pointer_is_null(val_idx) == 0) {
                    return this.pointer_cell(val_idx);
                }
                return c;
            }
            if (kind == 7) { // This
                long c = this.lookup_local_cell("this");
                if (c < 0) {
                    return -1;
                }
                long val_idx = this.cell_value(c);
                if (this.value_kind(val_idx) == 3 && this.pointer_is_null(val_idx) == 0) {
                    return this.pointer_cell(val_idx);
                }
                return c;
            }
            if (kind == 8) { // Unary
                if (this.same_name(sval, "*")) {
                    long v = this.eval_expr(u, a_idx);
                    if (this.value_kind(v) == 3 && this.pointer_is_null(v) == 0) {
                        return this.pointer_cell(v);
                    }
                    return -1;
                }
                return -1;
            }
            if (kind == 11) { // Call (A5: reference-returning call lvalue)
                long v = this.eval_call(u, astart, an, sval, line, col);
                if (this.value_kind(v) == 3 && this.pointer_is_null(v) == 0) {
                    return this.pointer_cell(v);
                }
                return -1;
            }
            if (kind == 12) { // Index
                long arrCell = this.lvalue_cell(u, a_idx);
                long idxVal = this.eval_expr(u, b_idx);
                long i = 0;
                if (this.value_kind(idxVal) == 1) {
                    i = this.read_int(idxVal);
                }
                if (arrCell >= 0) {
                    long arrVal = this.cell_value(arrCell);
                    if (this.value_kind(arrVal) == 4) {
                        long st_idx = this.read_struct_index(arrVal);
                        if (st_idx >= 0 && st_idx < this.struct_count) {
                            const char* sname = (char*) 0;
                            long sz = 0;
                            sname = this.structs[st_idx].name;
                            sz = this.structs[st_idx].field_count;
                            if (this.same_name(sname, "__array")) {
                                if (i < 0 || i >= sz) {
                                    this.error_index_out_of_bounds(line, col, i, sz);
                                    return -1;
                                }
                                return this.lookup_field_order(st_idx, i);
                            }
                        }
                    }
                }
                return -1;
            }
            if (kind == 13) { // Member (lvalue): base.field / ptr->field
                long baseCell = this.lvalue_cell(u, a_idx);
                long baseVal = -1;
                if (baseCell >= 0) {
                    baseVal = this.cell_value(baseCell);
                }
                long mflag = 0;
                unsafe { mflag = u->exprs[expr_idx].flag; }
                if (this.value_kind(baseVal) == 3 && mflag != 0) { // isArrow
                    long pc = this.pointer_cell(baseVal);
                    if (pc >= 0) {
                        baseVal = this.cell_value(pc);
                    }
                }
                if (this.value_kind(baseVal) == 4) {
                    long st_idx = this.read_struct_index(baseVal);
                    long fc = this.lookup_field(st_idx, sval);
                    if (fc >= 0) {
                        return fc;
                    }
                }
                return -1;
            }
        }
        return -1;
    }

    long eval_expr(MUnit* u, long expr_idx) {
        if (this.is_released() || this.termination_kind_ != 0) {
            return this.make_void();
        }
        unsafe {
            if (u == (MUnit*) 0 || expr_idx < 0 || expr_idx >= u->ex_n) {
                return this.make_void();
            }
            long kind = u->exprs[expr_idx].kind;
            long ival = u->exprs[expr_idx].ival;
            double fval = u->exprs[expr_idx].fval;
            long flag = u->exprs[expr_idx].flag;
            long a_idx = u->exprs[expr_idx].a;
            long b_idx = u->exprs[expr_idx].b;
            long c_idx = u->exprs[expr_idx].c;
            long astart = u->exprs[expr_idx].astart;
            long an = u->exprs[expr_idx].an;
            long line = u->exprs[expr_idx].line;
            long col = u->exprs[expr_idx].col;
            const char* sval = u->exprs[expr_idx].sval;
            const char* type_base = u->exprs[expr_idx].type.base;
            long type_array_size = u->exprs[expr_idx].type.array_size;
            long type_ptr_depth = u->exprs[expr_idx].type.ptr_depth;
            bool type_is_ref = u->exprs[expr_idx].type.is_ref;

        if (kind == 0) { // IntegerLit
            return this.make_int(ival);
        }
        if (kind == 1) { // FloatLit
            return this.make_float(fval);
        }
        if (kind == 2) { // StringLit
            long raw_len = this.slen(sval);
            char* buf = (char*) __ivy_alloc(raw_len + 1);
            if (buf == (char*) 0) {
                this.allocation_failed = 1;
                return this.make_void();
            }
            StrBuf rawb;
            rawb.p = (char*) sval;
            StrBuf outb;
            outb.p = buf;
            long dec_len = 0;
            LongPtr lenp;
            lenp.p = &dec_len;
            bool ok = interpreter::decode_string_literal(rawb, outb, lenp);
            long res = -1;
            if (ok) {
                res = this.make_string(buf, dec_len);
            } else {
                res = this.make_string(buf, 0);
            }
            __ivy_free((void*) buf);
            return res;
        }
        if (kind == 3) { // CharLit
            long char_val = 0;
            StrBuf rawb;
            rawb.p = (char*) sval;
            LongPtr valp;
            valp.p = &char_val;
            interpreter::decode_char_literal(rawb, valp);
            return this.make_int(char_val);
        }
        if (kind == 4) { // BoolLit
            return this.make_int(ival != 0 ? 1 : 0);
        }
        if (kind == 5) { // NullptrLit
            return this.make_null_pointer();
        }
        if (kind == 6) { // IdentRef
            long c = this.lookup_local_cell(sval);
            if (c < 0) {
                this.error_undefined_var(line, col, sval);
                return this.make_void();
            }
            if (type_array_size > 0) {
                return this.cell_value(c);
            }
            if (type_ptr_depth > 0 && !type_is_ref) {
                return this.make_cell_pointer(c);
            }
            if (type_is_ref) {
                long cv = this.cell_value(c);
                if (this.value_kind(cv) == 3 && this.pointer_is_null(cv) == 0) {
                    long pc = this.pointer_cell(cv);
                    if (pc >= 0) {
                        return this.cell_value(pc);
                    }
                }
            }
            return this.cell_value(c);
        }
        if (kind == 7) { // This
            long c = this.lookup_local_cell("this");
            if (c < 0) {
                this.error(line, col, "'this' is only valid inside a method");
                return this.make_void();
            }
            if (type_is_ref) {
                long cv = this.cell_value(c);
                if (this.value_kind(cv) == 3 && this.pointer_is_null(cv) == 0) {
                    long pc = this.pointer_cell(cv);
                    if (pc >= 0) {
                        return this.cell_value(pc);
                    }
                }
            }
            return this.cell_value(c);
        }
        if (kind == 8) { // Unary
            if (this.same_name(sval, "&")) {
                long c = this.lvalue_cell(u, a_idx);
                if (c < 0) {
                    this.error(line, col, "cannot take address");
                    return this.make_void();
                }
                return this.make_cell_pointer(c);
            }
            if (this.same_name(sval, "*")) {
                long op_val = this.eval_expr(u, a_idx);
                if (this.value_kind(op_val) != 3) {
                    this.error(line, col, "dereference of non-pointer");
                    return this.make_void();
                }
                if (this.pointer_is_null(op_val) != 0) {
                    this.error(line, col, "null pointer dereference");
                    return this.make_void();
                }
                long pc = this.pointer_cell(op_val);
                if (pc >= 0) {
                    return this.cell_value(pc);
                }
                return this.make_void();
            }
            bool is_prefix = flag != 0;
            if (is_prefix && (this.same_name(sval, "++") || this.same_name(sval, "--"))) {
                long c = this.lvalue_cell(u, a_idx);
                if (c >= 0) {
                    long cv = this.cell_value(c);
                    if (this.value_kind(cv) == 1) {
                        long cur = this.read_int(cv);
                        long delta = this.same_name(sval, "++") ? 1 : -1;
                        long nv = this.make_int(cur + delta);
                        this.cell_write(c, nv);
                        return nv;
                    }
                }
            }
            if (!is_prefix && (this.same_name(sval, "++") || this.same_name(sval, "--"))) {
                long c = this.lvalue_cell(u, a_idx);
                if (c >= 0) {
                    long cv = this.cell_value(c);
                    if (this.value_kind(cv) == 1) {
                        long cur = this.read_int(cv);
                        long delta = this.same_name(sval, "++") ? 1 : -1;
                        long nv = this.make_int(cur + delta);
                        this.cell_write(c, nv);
                        return cv;
                    }
                }
            }
            long v = this.eval_expr(u, a_idx);
            if (this.same_name(sval, "-")) {
                if (this.value_kind(v) == 1) {
                    return this.make_int(-this.read_int(v));
                }
                if (this.value_kind(v) == 2) {
                    // Multiply by -1.0 instead of unary '-': the native
                    // compiler lowers float negation to 0.0 - x, which
                    // loses the sign of a negative zero.
                    return this.make_float(this.read_float(v) * -1.0);
                }
            }
            if (this.same_name(sval, "!") || this.same_name(sval, "not")) {
                long bv = 0;
                if (this.value_kind(v) == 1) {
                    bv = this.read_int(v);
                } else if (this.value_kind(v) == 2) {
                    bv = (this.read_float(v) != 0.0) ? 1 : 0;
                }
                return this.make_int(bv == 0 ? 1 : 0);
            }
            if (this.same_name(sval, "~") && this.value_kind(v) == 1) {
                return this.make_int(~this.read_int(v));
            }
            if (this.same_name(sval, "+")) {
                return v;
            }
            this.error_unsupported_unary(line, col, sval);
            return this.make_void();
        }
        if (kind == 9) { // Binary
            if (this.same_name(sval, "&&")) {
                long lv = this.eval_expr(u, a_idx);
                if (this.value_kind(lv) == 1 && this.read_int(lv) == 0) {
                    return this.make_int(0);
                }
                long rv = this.eval_expr(u, b_idx);
                long r_truth = 0;
                if (this.value_kind(rv) == 1) {
                    r_truth = (this.read_int(rv) != 0) ? 1 : 0;
                } else if (this.value_kind(rv) == 2) {
                    r_truth = (this.read_float(rv) != 0.0) ? 1 : 0;
                }
                return this.make_int(r_truth);
            }
            if (this.same_name(sval, "||")) {
                long lv = this.eval_expr(u, a_idx);
                if (this.value_kind(lv) == 1 && this.read_int(lv) != 0) {
                    return this.make_int(1);
                }
                long rv = this.eval_expr(u, b_idx);
                long r_truth = 0;
                if (this.value_kind(rv) == 1) {
                    r_truth = (this.read_int(rv) != 0) ? 1 : 0;
                } else if (this.value_kind(rv) == 2) {
                    r_truth = (this.read_float(rv) != 0.0) ? 1 : 0;
                }
                return this.make_int(r_truth);
            }
            if (this.same_name(sval, ",")) {
                this.eval_expr(u, a_idx);
                return this.eval_expr(u, b_idx);
            }
            long lv = this.eval_expr(u, a_idx);
            long rv = this.eval_expr(u, b_idx);
            long lk = this.value_kind(lv);
            long rk = this.value_kind(rv);

            if (lk == 1 && rk == 1) {
                long l = this.read_int(lv);
                long r = this.read_int(rv);
                if (this.same_name(sval, "+")) return this.make_int(l + r);
                if (this.same_name(sval, "-")) return this.make_int(l - r);
                if (this.same_name(sval, "*")) return this.make_int(l * r);
                if (this.same_name(sval, "/")) {
                    if (r == 0) {
                        this.error(line, col, "division by zero");
                        return this.make_int(0);
                    }
                    return this.make_int(l / r);
                }
                if (this.same_name(sval, "%")) {
                    if (r == 0) {
                        this.error(line, col, "modulo by zero");
                        return this.make_int(0);
                    }
                    return this.make_int(l % r);
                }
                if (this.same_name(sval, "==")) return this.make_int(l == r ? 1 : 0);
                if (this.same_name(sval, "!=")) return this.make_int(l != r ? 1 : 0);
                if (this.same_name(sval, "<"))  return this.make_int(l <  r ? 1 : 0);
                if (this.same_name(sval, "<=")) return this.make_int(l <= r ? 1 : 0);
                if (this.same_name(sval, ">"))  return this.make_int(l >  r ? 1 : 0);
                if (this.same_name(sval, ">=")) return this.make_int(l >= r ? 1 : 0);
                if (this.same_name(sval, "&"))  return this.make_int(l & r);
                if (this.same_name(sval, "|"))  return this.make_int(l | r);
                if (this.same_name(sval, "^"))  return this.make_int(l ^ r);
                if (this.same_name(sval, "<<")) return this.make_int(l << r);
                if (this.same_name(sval, ">>")) return this.make_int(l >> r);
            }
            if (lk == 2 || rk == 2) {
                double l = (lk == 2) ? this.read_float(lv) : (double) this.read_int(lv);
                double r = (rk == 2) ? this.read_float(rv) : (double) this.read_int(rv);
                if (this.same_name(sval, "+")) return this.make_float(l + r);
                if (this.same_name(sval, "-")) return this.make_float(l - r);
                if (this.same_name(sval, "*")) return this.make_float(l * r);
                if (this.same_name(sval, "/")) return this.make_float(l / r);
                if (this.same_name(sval, "==")) return this.make_int(l == r ? 1 : 0);
                if (this.same_name(sval, "!=")) return this.make_int(l != r ? 1 : 0);
                if (this.same_name(sval, "<"))  return this.make_int(l <  r ? 1 : 0);
                if (this.same_name(sval, "<=")) return this.make_int(l <= r ? 1 : 0);
                if (this.same_name(sval, ">"))  return this.make_int(l >  r ? 1 : 0);
                if (this.same_name(sval, ">=")) return this.make_int(l >= r ? 1 : 0);
            }
            if (lk == 5 || rk == 5) {
                if (this.same_name(sval, "==")) {
                    return this.make_int(this.equal_strings(lv, rv) ? 1 : 0);
                }
                if (this.same_name(sval, "!=")) {
                    return this.make_int(this.equal_strings(lv, rv) ? 0 : 1);
                }
            }
            if (lk == 3 || rk == 3) {
                bool lnull = (lk == 3) ? (this.pointer_is_null(lv) != 0) : (lk == 1 ? (this.read_int(lv) == 0) : false);
                bool rnull = (rk == 3) ? (this.pointer_is_null(rv) != 0) : (rk == 1 ? (this.read_int(rv) == 0) : false);
                if (this.same_name(sval, "==")) return this.make_int(lnull == rnull ? 1 : 0);
                if (this.same_name(sval, "!=")) return this.make_int(lnull != rnull ? 1 : 0);
            }
            this.error_unsupported_binary(line, col, sval);
            return this.make_void();
        }
        if (kind == 10) { // Ternary
            long cond = this.eval_expr(u, a_idx);
            bool taken = false;
            if (this.value_kind(cond) == 1) {
                taken = (this.read_int(cond) != 0);
            } else if (this.value_kind(cond) == 2) {
                taken = (this.read_float(cond) != 0.0);
            }
            return this.eval_expr(u, taken ? b_idx : c_idx);
        }
        if (kind == 12) { // Index
            long baseVal = this.eval_expr(u, a_idx);
            long idxVal = this.eval_expr(u, b_idx);
            long idx = 0;
            if (this.value_kind(idxVal) == 1) {
                idx = this.read_int(idxVal);
            }
            if (this.value_kind(baseVal) == 4) {
                long st_idx = this.read_struct_index(baseVal);
                if (st_idx >= 0 && st_idx < this.struct_count) {
                    const char* sname = this.structs[st_idx].name;
                    long sz = this.structs[st_idx].field_count;
                    if (this.same_name(sname, "__array")) {
                        if (idx < 0 || idx >= sz) {
                            this.error_index_out_of_bounds(line, col, idx, sz);
                            return this.make_void();
                        }
                        long fc = this.lookup_field_order(st_idx, idx);
                        if (fc >= 0) {
                            return this.cell_value(fc);
                        }
                        return this.make_int(0);
                    }
                }
            }
            this.error(line, col, "IvyInterpret v0.2: pointer index not yet supported");
            return this.make_void();
        }
        if (kind == 13) { // Member (value): base.field / ptr->field
            long baseVal = this.eval_expr(u, a_idx);
            if (this.value_kind(baseVal) == 3 && flag != 0) { // isArrow
                if (this.pointer_is_null(baseVal) != 0) {
                    this.error(line, col, "arrow on null/non-pointer");
                    return this.make_void();
                }
                long pc = this.pointer_cell(baseVal);
                if (pc < 0) {
                    this.error(line, col, "arrow on null/non-pointer");
                    return this.make_void();
                }
                baseVal = this.cell_value(pc);
            }
            if (this.value_kind(baseVal) != 4) {
                this.error(line, col, "member access on non-struct");
                return this.make_void();
            }
            long st_idx = this.read_struct_index(baseVal);
            long fc = this.lookup_field(st_idx, sval);
            if (fc < 0) {
                this.error(line, col, "no field");
                return this.make_void();
            }
            long cv = this.cell_value(fc);
            if (cv < 0) {
                return this.make_void();
            }
            return cv;
        }
        if (kind == 14) { // Assign
            long c = this.lvalue_cell(u, a_idx);
            if (c < 0) {
                this.error(line, col, "cannot assign to expression");
                return this.make_void();
            }
            long cv = this.cell_value(c);
            long target = c;
            if (this.value_kind(cv) == 3 && this.pointer_is_null(cv) == 0) {
                target = this.pointer_cell(cv);
            }
            long rhs = this.eval_expr(u, b_idx);
            if (this.same_name(sval, "=")) {
                this.cell_write(target, rhs);
                return this.cell_value(target);
            }
            long lv = this.cell_value(target);
            if (this.value_kind(lv) == 1 && this.value_kind(rhs) == 1) {
                long l = this.read_int(lv);
                long r = this.read_int(rhs);
                long res = l;
                if (this.compound_plain_is(sval, "+")) res = l + r;
                else if (this.compound_plain_is(sval, "-")) res = l - r;
                else if (this.compound_plain_is(sval, "*")) res = l * r;
                else if (this.compound_plain_is(sval, "/") && r != 0) res = l / r;
                else if (this.compound_plain_is(sval, "%") && r != 0) res = l % r;
                else if (this.compound_plain_is(sval, "&")) res = l & r;
                else if (this.compound_plain_is(sval, "|")) res = l | r;
                else if (this.compound_plain_is(sval, "^")) res = l ^ r;
                else if (this.compound_plain_is(sval, "<<")) res = l << r;
                else if (this.compound_plain_is(sval, ">>")) res = l >> r;
                else {
                    this.error(line, col, "unsupported compound op");
                    return this.make_void();
                }
                long nw = this.make_int(res);
                this.cell_write(target, nw);
                return nw;
            }
            if (this.value_kind(lv) == 2 || this.value_kind(rhs) == 2) {
                double l = (this.value_kind(lv) == 2) ? this.read_float(lv) : (double) this.read_int(lv);
                double r = (this.value_kind(rhs) == 2) ? this.read_float(rhs) : (double) this.read_int(rhs);
                double res = l;
                if (this.compound_plain_is(sval, "+")) res = l + r;
                else if (this.compound_plain_is(sval, "-")) res = l - r;
                else if (this.compound_plain_is(sval, "*")) res = l * r;
                else if (this.compound_plain_is(sval, "/")) res = l / r;
                else {
                    this.error(line, col, "unsupported compound float op");
                    return this.make_void();
                }
                long nw = this.make_float(res);
                this.cell_write(target, nw);
                return nw;
            }
            this.error(line, col, "unsupported compound assignment");
            return this.make_void();
        }
        if (kind == 19) { // Cast
            // Oracle gap: mir_builder's post-pass walkExpr does not recurse
            // into Cast (src/mir/mir_builder.cpp:1288-1313), so a StringLit
            // or CharLit under a cast keeps its zero-initialised `decoded`
            // payload: casts of literals see the empty string / integer 0.
            long operand_kind = -1;
            unsafe {
                if (a_idx >= 0 && a_idx < u->ex_n) {
                    operand_kind = u->exprs[a_idx].kind;
                }
            }
            if (operand_kind == 2) { // StringLit
                return this.make_string("", 0);
            }
            if (operand_kind == 3) { // CharLit
                return this.make_int(0);
            }
            long operand = this.eval_expr(u, a_idx);
            long op_k = this.value_kind(operand);
            if (op_k == 1) { // int
                if (this.is_float_base(type_base)) {
                    return this.make_float((double) this.read_int(operand));
                }
                return this.make_int(this.read_int(operand));
            }
            if (op_k == 2) { // float
                if (this.is_float_base(type_base)) {
                    return this.make_float(this.read_float(operand));
                }
                if (this.is_integer_base(type_base)) {
                    return this.make_int((long) this.read_float(operand));
                }
                return this.make_float(this.read_float(operand));
            }
            if (op_k == 3) { // pointer
                if (type_ptr_depth > 0) {
                    return operand;
                }
                if (this.is_integer_base(type_base)) {
                    return this.make_int(this.pointer_is_null(operand) != 0 ? 0 : 1);
                }
                return operand;
            }
            return operand;
        }
        if (kind == 17) { // InitList: aggregate struct value (positional elements)
            // NOTE (P5 gap): MIR carries no per-struct field-name metadata, so
            // elements are registered as positional fields (order 0..an-1) and
            // named member access on user structs cannot be resolved here.
            // Each InitList registers a fresh struct so instances do not share
            // field cells (mirrors make_array's per-instance struct_index).
            const char* sname = type_base;
            long st_idx = this.register_struct(sname);
            if (st_idx < 0) {
                return this.make_void();
            }
            long sv = this.make_struct_value(st_idx);
            if (sv < 0) {
                return this.make_void();
            }
            if (!this.ensure_fields()) {
                return this.make_void();
            }
            long i = 0;
            while (i < an) {
                long ei = -1;
                unsafe {
                    ei = u->args[astart + i];
                }
                long fv = -1;
                if (ei >= 0) {
                    fv = this.eval_expr(u, ei);
                } else {
                    fv = this.make_int(0);
                }
                long fc = this.new_cell(fv);
                if (fc < 0) {
                    return this.make_void();
                }
                long order = i;
                long fi = this.field_count;
                unsafe {
                    this.fields[fi].struct_index = st_idx;
                    this.fields[fi].order = order;
                    this.fields[fi].name = (char*) "";
                    this.fields[fi].cell_index = fc;
                    this.structs[st_idx].field_count = order + 1;
                }
                this.field_count = this.field_count + 1;
                i = i + 1;
            }
            return sv;
        }
        if (kind == 11) { // Call (P2: static target resolution and frames)
            return this.eval_call(u, astart, an, sval, line, col);
        }

        this.error(line, col, "IvyInterpret v0.2: unsupported expression");
        return this.make_void();
        }
    }

    // ---- P2: call resolution, parameter binding, CFG runner ----

    // Null check for borrowed C strings; the cast itself needs unsafe.
    bool null_str(const char* p) {
        unsafe {
            return p == (char*) 0;
        }
    }

    // True when `s` starts with the NUL-terminated `head`.
    bool has_prefix(const char* s, const char* head) {
        if (this.null_str(s) || this.null_str(head)) {
            return false;
        }
        unsafe {
            long i = 0;
            while (head[i] != 0) {
                if (s[i] != head[i]) {
                    return false;
                }
                i = i + 1;
            }
        }
        return true;
    }

    // The port stores the already-qualified `MFunction.name` ("ns::f"), so the
    // oracle's `namespacePrefix + name == requested` retry (interpreter.cpp:74)
    // becomes a "::<callee>" suffix match on the stored name.
    bool qualified_suffix_matches(const char* full, const char* callee) {
        if (this.null_str(full) || this.null_str(callee)) {
            return false;
        }
        long flen = this.slen(full);
        long clen = this.slen(callee);
        if (clen <= 0 || flen <= clen + 2) {
            return false;
        }
        unsafe {
            if (full[flen - clen - 1] != 58 || full[flen - clen - 2] != 58) {
                return false;
            }
            long i = 0;
            while (i < clen) {
                if (full[flen - clen + i] != callee[i]) {
                    return false;
                }
                i = i + 1;
            }
        }
        return true;
    }

    bool function_has_body(MUnit* u, long fn_index) {
        bool unit_is_null = false;
        unsafe {
            unit_is_null = u == (MUnit*) 0;
        }
        if (unit_is_null || fn_index < 0) {
            return false;
        }
        long has_body = 0;
        long fn_n = 0;
        unsafe {
            fn_n = u->fn_n;
            if (fn_index < fn_n) {
                has_body = u->fns[fn_index].has_body;
            }
        }
        return has_body != 0;
    }

    // Oracle matchSig (src/mir/interpreter.cpp:57-65): a callee never takes
    // more parameters than arguments; every non-extern-C callee needs an exact
    // count; extern "C" (variadic) callers may pass extra fixed arguments.
    bool signature_matches(MUnit* u, long fn_index, long argc) {
        bool unit_is_null = false;
        unsafe {
            unit_is_null = u == (MUnit*) 0;
        }
        if (unit_is_null || fn_index < 0) {
            return false;
        }
        long np = 0;
        long is_extern_c = 0;
        unsafe {
            np = u->fns[fn_index].pn;
            is_extern_c = u->fns[fn_index].is_extern_c;
        }
        if (np > argc) {
            return false;
        }
        if (is_extern_c == 0 && np != argc) {
            return false;
        }
        return true;
    }

    // Three passes, exactly like the oracle's call() (interpreter.cpp:66-85):
    //   1. exact qualified name + has_body + signature match
    //   2. "::<callee>" suffix + has_body + signature match
    //   3. first same-name function with a body, ignoring arity (legacy)
    // Pointer identity is returned because MExpr.Call has no target pointer;
    // see H53_NOTES.md §13 for the parameter-type overload gap.
    long resolve_call(MUnit* u, const char* callee, long argc) {
        bool unit_is_null = false;
        unsafe {
            unit_is_null = u == (MUnit*) 0;
        }
        if (unit_is_null || this.is_null_name(callee) || argc < 0) {
            return -1;
        }
        long fn_n = 0;
        unsafe {
            fn_n = u->fn_n;
        }
        long i = 0;
        while (i < fn_n) {
            bool match = false;
            long has_body = 0;
            unsafe {
                has_body = u->fns[i].has_body;
                if (has_body != 0) {
                    match = this.same_name(u->fns[i].name, callee);
                }
            }
            if (match && this.signature_matches(u, i, argc)) {
                return i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < fn_n) {
            bool match = false;
            long has_body = 0;
            unsafe {
                has_body = u->fns[i].has_body;
                if (has_body != 0) {
                    match = this.qualified_suffix_matches(u->fns[i].name, callee);
                }
            }
            if (match && this.signature_matches(u, i, argc)) {
                return i;
            }
            i = i + 1;
        }
        i = 0;
        while (i < fn_n) {
            bool match = false;
            long has_body = 0;
            unsafe {
                has_body = u->fns[i].has_body;
                if (has_body != 0) {
                    match = this.same_name(u->fns[i].name, callee);
                }
            }
            if (match) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    void error_function_not_found(const char* name) {
        unsafe {
            char* msg = (char*) __ivy_alloc(this.diagnostic_scratch_size(name));
            if (msg == (char*) 0) {
                this.allocation_failed = 1;
                return;
            }
            msg[0] = 0;
            long len = 0;
            this.append_to_msg(msg, &len, "IvyInterpret v0.2: function '");
            if (!this.is_null_name(name)) {
                this.append_to_msg(msg, &len, name);
            }
            this.append_to_msg(msg, &len, "' not found");
            this.error(0, 0, msg);
            __ivy_free((void*) msg);
        }
    }

    // Argument value storage is a short-lived heap run of value indices; the
    // values themselves stay in the append-only value pool.
    long* alloc_arg_values(long count) {
        unsafe {
            if (count <= 0) {
                return (long*) 0;
            }
            if (count > this.signed_long_max() / 8) {
                this.allocation_failed = 1;
                return (long*) 0;
            }
            long* out = (long*) __ivy_alloc((unsigned long long) count * 8);
            if (out == (long*) 0) {
                this.allocation_failed = 1;
                return (long*) 0;
            }
            return out;
        }
    }

    // Evaluate the contiguous `MUnit.args` run left-to-right, exactly once per
    // argument, even when the callee turns out to be unresolved.
    void evaluate_arg_run(MUnit* u, long arg_start, long arg_count, long* out) {
        long j = 0;
        while (j < arg_count) {
            long e = -1;
            unsafe {
                if (u != (MUnit*) 0 && arg_start >= 0 && (arg_start + j) < u->a_n) {
                    e = u->args[arg_start + j];
                }
            }
            long v = this.make_void();
            if (e >= 0) {
                v = this.eval_expr(u, e);
            }
            unsafe {
                if (out != (long*) 0) {
                    out[j] = v;
                }
            }
            j = j + 1;
        }
    }

    // Oracle isBuiltin (interpreter.cpp:1053-1074).
    bool is_builtin_name(const char* name) {
        if (this.null_str(name)) {
            return false;
        }
        if (this.same_name(name, "move") ||
            this.same_name(name, "printf") || this.same_name(name, "puts") ||
            this.same_name(name, "putchar") || this.same_name(name, "exit") ||
            this.same_name(name, "abort") ||
            this.same_name(name, "__ivy_alloc") || this.same_name(name, "__ivy_free") ||
            this.same_name(name, "malloc") || this.same_name(name, "free")) {
            return true;
        }
        if (!this.has_prefix(name, "ivy::") && !this.has_prefix(name, "io::")) {
            return false;
        }
        return this.same_name(name, "io::print") || this.same_name(name, "io::println") ||
               this.same_name(name, "io::eprint") || this.same_name(name, "io::eprintln") ||
               this.same_name(name, "ivy::print") || this.same_name(name, "ivy::println") ||
               this.same_name(name, "ivy::print_int") || this.same_name(name, "ivy::print_float") ||
               this.same_name(name, "ivy::print_str") || this.same_name(name, "ivy::print_char") ||
               this.same_name(name, "ivy::println_int") || this.same_name(name, "ivy::println_float") ||
               this.same_name(name, "ivy::println_str") || this.same_name(name, "ivy::println_char");
    }

    // MExpr kind 11. Oracle evalCall order (interpreter.cpp:905-1046):
    // arguments left-to-right, io::*, ivy::print/println, move, the other
    // builtins, virtual dispatch (P5), the static target, then name lookup.
    long eval_call(MUnit* u, long astart, long an, const char* callee, long line, long col) {
        long count = an;
        if (count < 0) {
            count = 0;
        }
        LongPtr vals;
        unsafe {
            vals.p = this.alloc_arg_values(count);
        }
        bool vals_missing = false;
        unsafe {
            vals_missing = vals.p == (long*) 0;
        }
        if (count > 0 && vals_missing) {
            return this.make_void();
        }
        unsafe {
            this.evaluate_arg_run(u, astart, count, vals.p);
        }
        long out = -1;
        if (this.termination_kind_ != 0) {
            out = this.make_void();
        } else if (this.is_null_name(callee)) {
            this.error(line, col, "IvyInterpret v0.2: unsupported expression");
            out = this.make_void();
        } else if (this.same_name(callee, "io::print") ||
                   this.same_name(callee, "io::println") ||
                   this.same_name(callee, "io::eprint") ||
                   this.same_name(callee, "io::eprintln")) {
            unsafe {
                out = this.builtin_io(u, astart, count, vals.p, callee);
            }
        } else if (this.same_name(callee, "ivy::print") ||
                   this.same_name(callee, "ivy::println")) {
            unsafe {
                out = this.builtin_ivy_print(count, vals.p, callee);
            }
        } else if (this.same_name(callee, "move")) {
            out = this.make_void();
            if (count > 0) {
                unsafe {
                    out = vals.p[0];
                }
            }
        } else if (this.is_builtin_name(callee)) {
            unsafe {
                out = this.eval_builtin(u, astart, count, vals.p, callee, line, col);
            }
        } else {
            long target = this.resolve_call(u, callee, count);
            if (target < 0) {
                this.error_function_not_found(callee);
                out = this.make_void();
            } else {
                unsafe {
                    out = this.run_function(u, target, vals.p, count);
                }
            }
        }
        unsafe {
            if (vals.p != (long*) 0) {
                __ivy_free((void*) vals.p);
            }
        }
        return out;
    }
    // True when `block_index` is a block of `fn_index` in this unit. The
    // oracle stores raw Block* edges, so it cannot name another function's
    // block at all; the port must reject that case explicitly because its
    // edges are unit-level indices (MFunction.block_start/block_n).
    bool block_in_function(MUnit* u, long fn_index, long block_index) {
        bool ok = false;
        unsafe {
            if (u != (MUnit*) 0 && fn_index >= 0 && fn_index < u->fn_n &&
                block_index >= 0 && u->fns[fn_index].block_n > 0 &&
                u->fns[fn_index].block_start >= 0 &&
                block_index >= u->fns[fn_index].block_start &&
                block_index - u->fns[fn_index].block_start < u->fns[fn_index].block_n &&
                block_index < u->bl_n) {
                ok = true;
            }
        }
        return ok;
    }

    // Execute one instruction. Returns 0 (continue with `next`), 1 (returned)
    // or 3 (unsupported instruction; the function is abandoned). A block
    // change is recorded in IFrame.block_index and detected by the runner,
    // matching the oracle's curBlock comparison (interpreter.cpp:168).
    long exec_inst(MUnit* u, long frame, long inst_idx) {
        bool unit_is_null = false;
        unsafe {
            unit_is_null = u == (MUnit*) 0;
        }
        if (this.is_released() || unit_is_null || frame < 0 ||
            frame >= this.frame_count || inst_idx < 0) {
            return 3;
        }
        if (this.termination_kind_ != 0) {
            return 4; // terminated: unwind this frame
        }
        long kind = 0;
        long a = -1;
        long b = -1;
        long c = -1;
        long line = 0;
        long col = 0;
        long ptr_depth = 0;
        long array_size = 0;
        long is_ref = 0;
        StrBuf var;
        unsafe {
            var.p = (char*) 0;
        }
        long in_n = 0;
        long arm_start = -1;
        long arm_an = 0;
        unsafe {
            in_n = u->in_n;
            if (inst_idx < in_n) {
                kind = u->insts[inst_idx].kind;
                a = u->insts[inst_idx].a;
                b = u->insts[inst_idx].b;
                c = u->insts[inst_idx].c;
                arm_start = u->insts[inst_idx].astart;
                arm_an = u->insts[inst_idx].an;
                line = u->insts[inst_idx].line;
                col = u->insts[inst_idx].col;
                var.p = (char*) u->insts[inst_idx].var;
                ptr_depth = u->insts[inst_idx].type.ptr_depth;
                array_size = u->insts[inst_idx].type.array_size;
                is_ref = u->insts[inst_idx].type.is_ref ? 1 : 0;
            }
        }
        if (inst_idx >= in_n) {
            return 3;
        }
        if (kind == 0) { // Alloca
            if (array_size > 0) {
                long arr_cell = this.make_array(array_size);
                if (arr_cell < 0) {
                    return 3;
                }
                unsafe {
                    if (!this.is_null_name(var.p)) {
                        this.bind_local(frame, var.p, arr_cell);
                    }
                }
                return 0;
            }
            if (is_ref != 0) {
                // A reference alloca aliases the referenced cell; evaluating
                // the initializer would copy the value and break the alias.
                // With no initializer the oracle binds a null cell silently
                // (src/mir/interpreter.cpp:195-209).
                if (a < 0) {
                    unsafe {
                        if (!this.is_null_name(var.p)) {
                            this.bind_local(frame, var.p, this.new_cell(this.make_null_pointer()));
                        }
                    }
                    return 0;
                }
                long target = this.lvalue_cell(u, a);
                if (target >= 0) {
                    unsafe {
                        if (!this.is_null_name(var.p)) {
                            this.bind_local(frame, var.p, target);
                        }
                    }
                    return 0;
                }
                this.error(line, col, "cannot bind reference to non-lvalue");
                unsafe {
                    if (!this.is_null_name(var.p)) {
                        this.bind_local(frame, var.p, this.new_cell(this.make_null_pointer()));
                    }
                }
                return 0;
            }
            long init = -1;
            if (a >= 0) {
                init = this.eval_expr(u, a);
                if (this.termination_kind_ != 0) {
                    return 4;
                }
            } else if (ptr_depth > 0) {
                init = this.make_null_pointer();
            } else {
                // Aggregate default construction is a P5 gap: the model has no
                // MUnit aggregate table, so scalars and arrays start at 0.
                init = this.make_int(0);
            }
            unsafe {
                if (this.is_null_name(var.p)) {
                    return 0;
                }
                if (ptr_depth > 0 && init >= 0 && this.value_kind(init) == 3 &&
                    this.pointer_is_null(init) == 0) {
                    this.bind_local(frame, var.p, this.pointer_cell(init));
                } else {
                    this.bind_local(frame, var.p, this.new_cell(init));
                }
            }
            return 0;
        }
        if (kind == 1) { // Store
            long target = this.lvalue_cell(u, a);
            if (target < 0) {
                this.error(line, col, "cannot assign to expression");
                return 0;
            }
            long target_value = this.cell_value(target);
            if (target_value >= 0 && this.value_kind(target_value) == 3 &&
                this.pointer_is_null(target_value) == 0) {
                long pointee = this.pointer_cell(target_value);
                if (pointee >= 0) {
                    target = pointee;
                }
            }
            long rhs = this.eval_expr(u, b);
            if (this.termination_kind_ != 0) {
                return 4;
            }
            this.cell_write(target, rhs);
            return 0;
        }
        if (kind == 2) { // Eval
            if (a >= 0) {
                this.eval_expr(u, a);
            }
            if (this.termination_kind_ != 0) {
                return 4;
            }
            return 0;
        }
        if (kind == 3) { // Ret
            long value = -1;
            if (a >= 0) {
                long fn_index = -1;
                long ret_is_ref = 0;
                unsafe {
                    fn_index = this.frames[frame].function_index;
                    if (fn_index >= 0 && fn_index < u->fn_n) {
                        ret_is_ref = u->fns[fn_index].ret.is_ref ? 1 : 0;
                    }
                }
                if (ret_is_ref != 0) {
                    // A5: return a Ptr to the referenced cell so the caller can
                    // alias it instead of receiving a copied value.
                    long target = this.lvalue_cell(u, a);
                    if (target >= 0) {
                        value = this.make_cell_pointer(target);
                    } else {
                        value = this.eval_expr(u, a);
                    }
                } else {
                    value = this.eval_expr(u, a);
                }
            }
            if (this.termination_kind_ != 0) {
                this.set_frame_return(frame, 0, -1);
                return 4;
            }
            this.set_frame_return(frame, 1, value);
            return 1;
        }
        if (kind == 4) { // CondBranch
            long cond = this.eval_expr(u, a);
            if (this.termination_kind_ != 0) {
                return 4;
            }
            bool taken = false;
            long cond_kind = this.value_kind(cond);
            if (cond_kind == 1) {
                taken = this.read_int(cond) != 0;
            } else if (cond_kind == 2) {
                taken = this.read_float(cond) != 0.0;
            }
            long dest = b;
            if (!taken) {
                dest = c;
            }
            this.set_frame_edge(frame, dest);
            return 0;
        }
        if (kind == 5) { // Jump
            this.set_frame_edge(frame, b);
            return 0;
        }
        if (kind == 6) { // Switch
            // Oracle parity (interpreter.cpp:286-300): a non-integer or
            // absent condition evaluates to 0, the default target comes from
            // the instruction's `b`, the first arm whose value equals the
            // condition wins, and a missing/unknown target is a null block.
            long cond_int = 0;
            if (a >= 0) {
                cond_int = this.read_int(this.eval_expr(u, a));
                if (this.termination_kind_ != 0) {
                    return 4;
                }
            }
            long dest = b;
            long arm_n = 0;
            unsafe {
                arm_n = u->arm_n;
            }
            long i = arm_start;
            long k = 0;
            while (k < arm_an && i >= 0 && i < arm_n) {
                long arm_value = 0;
                long arm_block = -1;
                unsafe {
                    arm_value = u->arm_val[i];
                    arm_block = u->arm_blk[i];
                }
                if (arm_value == cond_int) {
                    dest = arm_block;
                    break;
                }
                i = i + 1;
                k = k + 1;
            }
            this.set_frame_edge(frame, dest);
            return 0;
        }
        this.error(line, col, "IvyInterpret v0.2: unsupported instruction");
        return 3;
    }

    // execFunction + execBlock equivalent (src/mir/interpreter.cpp:124-175).
    // Pushes a frame, binds parameters from the already evaluated argument
    // values, walks blocks until a terminator/implicit end, then pops.
    long run_function(MUnit* u, long fn_index, long* arg_values, long arg_count) {
        bool unit_is_null = false;
        unsafe {
            unit_is_null = u == (MUnit*) 0;
        }
        if (this.is_released() || unit_is_null || fn_index < 0) {
            return this.make_void();
        }
        long fn_n = 0;
        long pstart = 0;
        long pn = 0;
        long block_start = -1;
        long block_n = 0;
        long pa_n = 0;
        unsafe {
            fn_n = u->fn_n;
            if (fn_index >= fn_n) {
                return this.make_void();
            }
            pstart = u->fns[fn_index].pstart;
            pn = u->fns[fn_index].pn;
            block_start = u->fns[fn_index].block_start;
            block_n = u->fns[fn_index].block_n;
            pa_n = u->pa_n;
        }
        long frame = this.push_frame(fn_index, -1, -1);
        if (frame < 0) {
            return this.make_void();
        }
        this.set_frame_position(frame, block_start, -1);
        long limit = pn;
        if (arg_count < limit) {
            limit = arg_count;
        }
        long k = 0;
        while (k < limit) {
            long pidx = pstart + k;
            StrBuf pname;
            unsafe {
                pname.p = (char*) 0;
            }
            long param_is_ref = 0;
            long param_ptr_depth = 0;
            unsafe {
                if (pidx >= 0 && pidx < pa_n) {
                    pname.p = (char*) u->params[pidx].name;
                    param_is_ref = u->params[pidx].type.is_ref ? 1 : 0;
                    param_ptr_depth = u->params[pidx].type.ptr_depth;
                }
            }
            bool bind = false;
            unsafe {
                if (!this.is_null_name(pname.p)) {
                    bind = pname.p[0] != 0;
                }
            }
            if (bind) {
                long arg_value = -1;
                unsafe {
                    if (arg_values != (long*) 0) {
                        arg_value = arg_values[k];
                    }
                }
                long cell = -1;
                bool shares_arg_cell = false;
                if (param_is_ref != 0 || param_ptr_depth > 0) {
                    if (arg_value >= 0 && this.value_kind(arg_value) == 3 &&
                        this.pointer_is_null(arg_value) == 0) {
                        cell = this.pointer_cell(arg_value);
                        shares_arg_cell = cell >= 0;
                    }
                }
                if (!shares_arg_cell) {
                    cell = this.new_cell(arg_value);
                }
                if (cell >= 0) {
                    unsafe {
                        this.bind_local(frame, pname.p, cell);
                    }
                }
            }
            k = k + 1;
        }
        long returned = 0;
        long cur_block = -1;
        if (block_start >= 0 && block_n > 0) {
            cur_block = block_start;
        } else {
            returned = 1;
        }
        long in_n = 0;
        unsafe {
            in_n = u->in_n;
        }
        while (returned == 0) {
            if (this.termination_kind_ != 0) {
                returned = 1;
                break;
            }
            // Oracle: an edge to a null/unknown block ends the function
            // (execFunction's `while (!returned && curBlock)`). A block of
            // another function has no oracle analogue because its edges are
            // raw Block*; the port treats it as the same invalid edge rather
            // than reading a neighbour's instructions.
            if (!this.block_in_function(u, fn_index, cur_block)) {
                returned = 1;
                break;
            }
            long first = -1;
            long last = -1;
            unsafe {
                first = u->blocks[cur_block].first;
                last = u->blocks[cur_block].last;
            }
            // The builder emits a block's instructions as the contiguous
            // chain first..last with strictly increasing `next` indices. The
            // oracle has no first/last fields, so any disagreement is corrupt
            // metadata with no oracle-defined behaviour: stop the block and
            // take the ordinary implicit return instead of executing the
            // instructions of a neighbouring block.
            bool chain_ok = first >= 0 && last >= first && last < in_n;
            long inst = first;
            long changed = 0;
            while (chain_ok && inst >= 0 && inst <= last) {
                long code = this.exec_inst(u, frame, inst);
                if (code == 1 || code == 3 || code == 4) {
                    returned = 1;
                    changed = 1;
                    break;
                }
                if (this.termination_kind_ != 0) {
                    returned = 1;
                    changed = 1;
                    break;
                }
                long next_block = -1;
                long marker = -1;
                unsafe {
                    next_block = this.frames[frame].block_index;
                    marker = this.frames[frame].inst_index;
                }
                if (next_block != cur_block) {
                    cur_block = next_block;
                    changed = 1;
                    break;
                }
                if (marker >= 0) {
                    // Self-edge (see set_frame_edge): the oracle resets
                    // curInst to 0 and execBlock increments it to 1, so the
                    // block resumes at its second instruction.
                    long resume = -1;
                    unsafe {
                        resume = u->insts[first].next;
                    }
                    if (resume < 0 || resume > last) {
                        returned = 1;
                        break;
                    }
                    this.set_frame_position(frame, cur_block, -1);
                    inst = resume;
                    continue;
                }
                if (inst == last) {
                    break;
                }
                long next_inst = -1;
                unsafe {
                    next_inst = u->insts[inst].next;
                }
                if (next_inst <= inst) {
                    break;
                }
                inst = next_inst;
            }
            if (returned != 0) {
                break;
            }
            if (changed == 0) {
                // Fell off a non-terminated block: implicit return.
                returned = 1;
            }
        }
        long ret_state = 0;
        long ret_value = -1;
        bool terminated = false;
        if (this.termination_kind_ != 0) {
            terminated = true;
        }
        unsafe {
            if (frame >= 0 && frame < this.frame_count) {
                ret_state = this.frames[frame].return_state;
                ret_value = this.frames[frame].return_value;
            }
        }
        this.pop_frame();
        if (terminated) {
            return this.make_void();
        }
        if (ret_state == 0 || ret_value < 0) {
            return this.make_void();
        }
        return ret_value;
    }

    // Public P2 entry point: evaluate the `MUnit.args` run starting at
    // `arg_start` (or pass -1 for none), resolve `name`, and run it.
    IResult call_by_name(MUnit* u, const char* name, long arg_start, long arg_count) {
        IResult res;
        res.state = 0;
        res.value_index = -1;
        res.status = 0;
        bool unit_is_null = false;
        unsafe {
            unit_is_null = u == (MUnit*) 0;
        }
        if (this.setup_done == 0 || this.is_released() || unit_is_null ||
            this.is_null_name(name) || arg_count < 0) {
            this.result = res;
            return res;
        }
        this.failed_ = 0;
        this.termination_kind_ = 0;
        this.termination_status_ = 0;
        long count = arg_count;
        LongPtr vals;
        unsafe {
            vals.p = this.alloc_arg_values(count);
        }
        bool vals_missing = false;
        unsafe {
            vals_missing = vals.p == (long*) 0;
        }
        if (count > 0 && vals_missing) {
            res.state = 2;
            this.result = res;
            return res;
        }
        unsafe {
            this.evaluate_arg_run(u, arg_start, count, vals.p);
        }
        long value = -1;
        long target = this.resolve_call(u, name, count);
        if (target < 0) {
            this.error_function_not_found(name);
        } else {
            unsafe {
                value = this.run_function(u, target, vals.p, count);
            }
        }
        unsafe {
            if (vals.p != (long*) 0) {
                __ivy_free((void*) vals.p);
            }
        }
        res.value_index = value;
        res.state = 1;
        if (this.termination_kind_ != 0) {
            // echo 3: interpreted termination. The value is discarded; P6
            // maps status to the host process (see H53_NOTES.md §15).
            res.state = 3;
            res.value_index = -1;
            res.status = this.termination_status_;
            while (this.current_frame >= 0) {
                if (this.pop_frame() < 0) {
                    break;
                }
            }
        } else if (this.failed_ != 0) {
            res.state = 2;
        }
        this.result = res;
        return res;
    }

    IResult call_main(MUnit* u) {
        return this.call_by_name(u, "main", -1, 0);
    }

    IResult run_unit(MUnit* u) {
        return this.call_main(u);
    }

    bool has_failed() {
        return this.failed_ != 0;
    }

    // ---- P4 public stream and termination accessors ----

    long stdout_length() {
        if (this.setup_done == 0 || this.is_released()) {
            return 0;
        }
        unsafe {
            if (this.control == (InterpreterControl*) 0) {
                return 0;
            }
            return this.control->out_len;
        }
        return 0;
    }

    long stderr_length() {
        if (this.setup_done == 0 || this.is_released()) {
            return 0;
        }
        unsafe {
            if (this.control == (InterpreterControl*) 0) {
                return 0;
            }
            return this.control->err_len;
        }
        return 0;
    }

    const char* stdout_bytes() {
        if (this.setup_done == 0 || this.is_released()) {
            return "";
        }
        unsafe {
            if (this.control == (InterpreterControl*) 0 ||
                this.control->out_buf == (char*) 0 ||
                this.control->out_len <= 0) {
                return "";
            }
            return this.control->out_buf;
        }
        return "";
    }

    const char* stderr_bytes() {
        if (this.setup_done == 0 || this.is_released()) {
            return "";
        }
        unsafe {
            if (this.control == (InterpreterControl*) 0 ||
                this.control->err_buf == (char*) 0 ||
                this.control->err_len <= 0) {
                return "";
            }
            return this.control->err_buf;
        }
        return "";
    }

    long termination_kind() {
        return this.termination_kind_;
    }

    long termination_status() {
        return this.termination_status_;
    }

    long active_frame_count() {
        if (this.setup_done == 0 || this.is_released()) {
            return 0;
        }
        long n = 0;
        long i = 0;
        while (i < this.frame_count) {
            unsafe {
                if (this.frames[i].active != 0) {
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        return n;
    }

    void release() {
        if (this.setup_done == 0 || this.is_released()) {
            this.released = 1;
            return;
        }
        unsafe {
            if (this.control != (InterpreterControl*) 0) {
                this.control->released = 1;
                // P4: the shared control block owns both stream buffers. The
                // first release frees them once and empties every alias; a
                // later release of another shallow copy returns above.
                if (this.control->out_buf != (char*) 0) {
                    __ivy_free((void*) this.control->out_buf);
                    this.control->out_buf = (char*) 0;
                }
                this.control->out_len = 0;
                this.control->out_cap = 0;
                if (this.control->err_buf != (char*) 0) {
                    __ivy_free((void*) this.control->err_buf);
                    this.control->err_buf = (char*) 0;
                }
                this.control->err_len = 0;
                this.control->err_cap = 0;
            }
            long i = 0;
            while (i < this.string_buffer_count) {
                __ivy_free((void*) this.string_buffers[i]);
                i = i + 1;
            }
            if (this.string_buffers != (long*) 0) {
                __ivy_free((void*) this.string_buffers);
            }
            if (this.locals != (ILocal*) 0) {
                __ivy_free(this.locals);
            }
            if (this.frames != (IFrame*) 0) {
                __ivy_free(this.frames);
            }
            if (this.fields != (IField*) 0) {
                __ivy_free(this.fields);
            }
            if (this.structs != (IStruct*) 0) {
                __ivy_free(this.structs);
            }
            if (this.cells != (ICell*) 0) {
                __ivy_free(this.cells);
            }
            if (this.values != (IValue*) 0) {
                __ivy_free(this.values);
            }
            if (this.dline_ != (long*) 0) {
                __ivy_free(this.dline_);
            }
            if (this.dcol_ != (long*) 0) {
                __ivy_free(this.dcol_);
            }
            if (this.dmsg_ != (long*) 0) {
                __ivy_free((void*) this.dmsg_);
            }
        }
        unsafe {
            this.values = (IValue*) 0;
            this.cells = (ICell*) 0;
            this.structs = (IStruct*) 0;
            this.fields = (IField*) 0;
            this.frames = (IFrame*) 0;
            this.locals = (ILocal*) 0;
            this.string_buffers = (long*) 0;
            this.dline_ = (long*) 0;
            this.dcol_ = (long*) 0;
            this.dmsg_ = (long*) 0;
        }
        this.value_count = 0;
        this.cell_count = 0;
        this.struct_count = 0;
        this.field_count = 0;
        this.frame_count = 0;
        this.local_count = 0;
        this.string_buffer_count = 0;
        this.diag_count_ = 0;
        this.failed_ = 0;
        this.value_capacity = 0;
        this.cell_capacity = 0;
        this.struct_capacity = 0;
        this.field_capacity = 0;
        this.frame_capacity = 0;
        this.local_capacity = 0;
        this.string_buffer_capacity = 0;
        this.diag_capacity_ = 0;
        this.current_frame = -1;
        this.result.state = 0;
        this.result.value_index = -1;
        this.result.status = 0;
        this.released = 1;
        // Keep setup_done set so this released model cannot be reinitialised
        // with recycled cell/frame identities.
    }
};
