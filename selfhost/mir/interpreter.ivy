            long owner = -1;
            bool matches = false;
            unsafe {
                owner = this.fields[i].struct_index;
                const char* field_name = this.fields[i].name;
                matches = this.same_name(field_name, name);
            }
            if (owner == struct_index && matches) {
                return i;
