            long element_value = this.make_int(0);
            if (element_value < 0) {
                return -1;
            }
            long element_cell = this.new_cell(element_value);
            if (element_cell < 0) {
                return -1;
            }
            if (!this.ensure_fields()) {
                return -1;
            }
            long order = 0;
            long field_index = this.field_count;
            unsafe {
                order = this.structs[struct_index].field_count;
                this.fields[field_index].struct_index = struct_index;
                this.fields[field_index].order = order;
                this.fields[field_index].name = "";
                this.fields[field_index].cell_index = element_cell;
                this.structs[struct_index].field_count = order + 1;
            }
            this.field_count = this.field_count + 1;
            i = i + 1;
        }
        long array_value = this.make_struct_value(struct_index);
        if (array_value < 0) {
            return -1;
        }
        return this.new_cell(array_value);
