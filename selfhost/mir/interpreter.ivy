            this.values[index].cell_index = -1;
            this.values[index].pointer_is_null = 1;
            this.values[index].provenance_kind = 0;
            this.values[index].provenance_id = 0;
            this.values[index].provenance_name = (char*) 0;
            this.values[index].struct_index = -1;
            this.values[index].string_bytes = (char*) 0;
            this.values[index].string_length = 0;
