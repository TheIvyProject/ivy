// selfhost/mir/mirdrive.ivy - H5.1 differential-test driver for the MIR
// builder port.
//
// Reads file paths from stdin (one per line), lexes + preprocesses + parses
// each with the Ivy ports, runs the Ivy HIR builder and the Ivy MIR builder,
// and prints `=== path ===` + the `ivy --mir` dump (or the diagnostics of
// the stage that failed, in the oracle format).  Used by
// selfhost/difftest.ps1
//   (-Oracle --mir -Modules token,lexer,preprocessor,ast,parser,hir,
//    hir_builder,mir,mir_builder -Driver mirdrive).
//
// The pipeline mirrors the `--mir` path of src/app/main.cpp:
//
//   lexer -> preprocessor -> parser -> HIR builder -> MIR builder -> dump
//
// A diagnostic of any stage replaces the dump (the oracle prints the
// diagnostic on stderr and no dump at all) and the driver exits with 1.

#pragma ivy cnumber
import token;
import lexer;
import preprocessor;
import ast;
import parser;
import hir;
import hir_builder;
import mir;
import mir_builder;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);

// The MIR dump printer.  Free functions cannot take raw-pointer parameters,
// so the printer is a struct whose fields hold them.
struct MirDumper {
    MUnit mu;

    long slen(const char* s) {
        long i = 0;
        unsafe {
            while (s[i] != 0) {
                i = i + 1;
            }
        }
        return i;
    }

    void pad(long depth) {
        long i = 0;
        while (i < depth) {
            io::print("  ");
            i = i + 1;
        }
    }

    // dumpHirType in src/app/main.cpp (the MIR dump uses the same type
    // printer as the HIR dump).
    void dump_type(AType t) {
        if (t.is_const != 0) {
            io::print("const ");
        }
        if (t.is_unsigned != 0) {
            io::print("unsigned ");
        }
        io::print(t.base);
        long i = 0;
        while (i < t.ptr_depth) {
            io::print("*");
            i = i + 1;
        }
        if (t.is_ref != 0) {
            io::print("&");
        }
    }

    // mirLifetimeSuffix in src/app/main.cpp: the ` [lt: X]` suffix of an
    // expression (note the space after the colon - the parameter suffix
    // has none).
    void print_lt(long kind, const char* name) {
        if (kind == 0) {
            return;
        }
        io::print(" [lt: ");
        if (kind == 1) {
            io::print(name);
        } else if (kind == 2) {
            io::print("static");
        } else if (kind == 3) {
            io::print("local");
        } else {
            io::print("unknown");
        }
        io::print("]");
    }

    // dumpMirExpr in src/app/main.cpp.
    void dump_expr(long idx, long depth) {
        MExpr e;
        unsafe {
            e = this.mu.exprs[idx];
        }
        this.pad(depth);
        if (e.kind == 0) {
            io::print("int {}", e.ival);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 1) {
            // The float literal is printed as the TEXT of the literal: the
            // oracle prints the double with `operator<<`, and the runtime
            // of the port formats a double differently (`_gcvt` keeps the
            // trailing dot of "2.").  The HIR already carries the text
            // that the oracle prints.
            io::print("float {}", e.sval);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 2) {
            io::print("string {}", e.sval);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 3) {
            io::print("char {}", e.sval);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 4) {
            if (e.ival != 0) {
                io::print("bool true");
            } else {
                io::print("bool false");
            }
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 5) {
            io::print("nullptr");
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 6) {
            io::print("ident {}", e.sval);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 7) {
            io::print("this");
            this.print_lt(e.lt, e.ltname);
            io::println("");
            return;
        }
        if (e.kind == 8) {
            // Unary
            if (e.flag != 0) {
                io::print("prefix '");
            } else {
                io::print("postfix '");
            }
            io::print(e.sval);
            io::print("' : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 9) {
            // Binary
            io::print("binary '");
            io::print(e.sval);
            io::print("' : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 10) {
            // Ternary
            io::print("ternary ?: : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            this.dump_expr(e.c, depth + 1);
            return;
        }
        if (e.kind == 11) {
            // Call
            if (e.flag != 0) {
                io::print("virtual_call '");
                io::print(e.sval2);
                io::print("' slot={}", e.ival);
            } else {
                io::print("call");
            }
            io::print(" : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.mu.args[e.astart + j];
                }
                if (ai >= 0) {
                    this.dump_expr(ai, depth + 1);
                }
                j = j + 1;
            }
            return;
        }
        if (e.kind == 12) {
            // Index
            io::print("index : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 13) {
            // Member
            io::print("member ");
            if (e.flag != 0) {
                io::print("->");
            } else {
                io::print(".");
            }
            io::print(e.sval);
            io::print(" : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 14) {
            // Assign
            io::print("assign '");
            io::print(e.sval);
            io::print("' : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            this.dump_expr(e.b, depth + 1);
            return;
        }
        if (e.kind == 15) {
            // New
            io::print("new : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.mu.args[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 16) {
            // Delete
            if (e.flag != 0) {
                io::print("delete[]");
            } else {
                io::print("delete");
            }
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            return;
        }
        if (e.kind == 17) {
            // InitList
            io::print("init-list : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::print(" ({})", e.an);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.mu.args[e.astart + j];
                }
                this.dump_expr(ai, depth + 1);
                j = j + 1;
            }
            return;
        }
        if (e.kind == 18) {
            // Lambda
            io::print("lambda : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::print(" func={}", e.sval);
            io::print(" closure={}", e.sval2);
            io::print(" ({} captures)", e.an);
            io::println("");
            long j = 0;
            while (j < e.an) {
                long ai = -1;
                unsafe {
                    ai = this.mu.args[e.astart + j];
                }
                if (ai >= 0) {
                    this.dump_expr(ai, depth + 1);
                }
                j = j + 1;
            }
            return;
        }
        if (e.kind == 19) {
            // Cast
            if (e.flag == 1) {
                io::print("reinterpret_cast");
            } else if (e.flag == 2) {
                io::print("const_cast");
            } else if (e.flag == 3) {
                io::print("C-cast");
            } else {
                io::print("static_cast");
            }
            io::print(" : ");
            this.dump_type(e.type);
            this.print_lt(e.lt, e.ltname);
            io::println("");
            this.dump_expr(e.a, depth + 1);
            return;
        }
    }

    // dumpMirBlock in src/app/main.cpp.  The switch instruction prints
    // nothing (the oracle has no `case Kind::Switch`).
    void dump_block(long idx, long index) {
        io::println("  block {}", index);
        MBlock b;
        unsafe {
            b = this.mu.blocks[idx];
        }
        long i = b.first;
        while (i >= 0) {
            this.dump_inst(i);
            MInst s;
            unsafe {
                s = this.mu.insts[i];
            }
            i = s.next;
        }
    }

    // The [unsafe] marker of an instruction.
    void print_mark(long in_unsafe) {
        if (in_unsafe != 0) {
            io::print(" [unsafe]");
        }
    }

    void dump_inst(long idx) {
        MInst s;
        unsafe {
            s = this.mu.insts[idx];
        }

        if (s.kind == 0) {
            // Alloca
            io::print("    alloca ");
            this.dump_type(s.type);
            io::print(" {}", s.var);
            this.print_mark(s.in_unsafe);
            io::println("");
            if (s.a >= 0) {
                this.dump_expr(s.a, 3);
            }
            return;
        }
        if (s.kind == 1) {
            // Store
            io::print("    store");
            this.print_mark(s.in_unsafe);
            io::println("");
            if (s.a >= 0) {
                this.dump_expr(s.a, 3);
            }
            if (s.b >= 0) {
                this.dump_expr(s.b, 3);
            }
            return;
        }
        if (s.kind == 2) {
            // Eval
            io::print("    eval");
            this.print_mark(s.in_unsafe);
            io::println("");
            if (s.a >= 0) {
                this.dump_expr(s.a, 3);
            }
            return;
        }
        if (s.kind == 3) {
            // Ret
            io::print("    ret");
            this.print_mark(s.in_unsafe);
            io::println("");
            if (s.a >= 0) {
                this.dump_expr(s.a, 3);
            }
            return;
        }
        if (s.kind == 4) {
            // CondBranch (the targets are not printed)
            io::print("    condbranch");
            this.print_mark(s.in_unsafe);
            io::println("");
            if (s.a >= 0) {
                this.dump_expr(s.a, 3);
            }
            return;
        }
        if (s.kind == 5) {
            // Jump (the target is not printed)
            io::print("    jump");
            this.print_mark(s.in_unsafe);
            io::println("");
            return;
        }
        // Switch: the oracle prints nothing for it.
        return;
    }

    // dumpMir in src/app/main.cpp.
    void dump_function(long idx) {
        MFunction f;
        unsafe {
            f = this.mu.fns[idx];
        }
        io::print("function {}", f.name);
        if (f.is_extern_c != 0) {
            io::print(" [extern \"C\"]");
        }
        io::println("");
        io::print("  return ");
        this.dump_type(f.ret);
        io::print("(");
        long j = 0;
        while (j < f.pn) {
            if (j > 0) {
                io::print(", ");
            }
            MParam p;
            unsafe {
                p = this.mu.params[f.pstart + j];
            }
            this.dump_type(p.type);
            if (this.slen(p.name) > 0) {
                io::print(" {}", p.name);
            }
            bool has_lt = false;
            unsafe {
                has_lt = p.lt != (char*)0;
            }
            if (has_lt && this.slen(p.lt) > 0) {
                // The parameter suffix has NO space after the colon (an
                // asymmetry of the oracle).
                io::print(" [lt:{}]", p.lt);
            }
            j = j + 1;
        }
        io::println(")");
        if (f.lt_n > 0) {
            io::print("  lifetimes:");
            long k = 0;
            while (k < f.lt_n) {
                MLifetime l;
                unsafe {
                    l = this.mu.lts[f.lt_start + k];
                }
                io::print(" {}", l.name);
                k = k + 1;
            }
            io::println("");
        }
        bool has_ret_lt = false;
        unsafe {
            has_ret_lt = f.return_lifetime != (char*)0;
        }
        if (has_ret_lt && this.slen(f.return_lifetime) > 0) {
            io::println("  return lifetime: {}", f.return_lifetime);
        }
        long b = 0;
        while (b < f.block_n) {
            long bi = 0;
            unsafe {
                bi = this.mu.blocks[f.block_start + b].first;
            }
            this.dump_block(f.block_start + b, b);
            b = b + 1;
        }
        io::println("");
    }

    void dump_unit() {
        long i = 0;
        while (i < this.mu.fn_n) {
            this.dump_function(i);
            i = i + 1;
        }
    }
};

// Run the pipeline over the files that are read from stdin.  Returns 1 when
// a stage reported a diagnostic (the oracle exits with 1 in that case).
long run() {
    long failed = 0;
    while (true) {
        unsafe {
            char* line = io::read_line();
            if (line == (char*)0) {
                break;
            }
            uint64 np = __ivy_strlen(line);
            if (np > 0 && line[np - 1] == 13) {
                line[np - 1] = 0;
            }
            io::println("=== {} ===", line);
            char* content = io::read_file(line);
            if (content == (char*)0) {
                // The oracle cannot open the file either: it prints the
                // message on stderr and exits with 2.
                io::println("ivy: error: cannot open file '\"{}\"'", line);
                if (failed == 0) {
                    failed = 2;
                }
                __ivy_free(line);
                continue;
            }
            {
                uint64 len = __ivy_strlen(content);
                long cap = (long)len + 16;

                Lexer lx;
                lx.setup(content, len, line);
                lx.lex_all(cap);

                if (!lx.had_error()) {
                    long in_n = lx.token_count();
                    long out_cap = in_n * 8 + 256;
                    Preprocessor pp;
                    pp.setup(lx.tokens(), in_n, content, (long)len, line, (long)np,
                             out_cap, 1024);
                    pp.run();
                    long dc = pp.diag_count();
                    long di = 0;
                    bool pp_failed = false;
                    char* fname = line;
                    if (pp.has_line_file() != 0) {
                        fname = pp.line_file();
                    }
                    while (di < dc) {
                        long w = pp.diag_warn(di);
                        if (w == 0) {
                            pp_failed = true;
                        }
                        io::print(fname);
                        io::print(":{}", pp.diag_line(di));
                        io::print(":{}", pp.diag_col(di));
                        if (w != 0) {
                            io::print(": warning: ");
                        } else {
                            io::print(": error: ");
                        }
                        io::println("{}", pp.diag_msg(di));
                        di = di + 1;
                    }
                    if (!pp_failed) {
                        Parser pa;
                        pa.setup(pp.output(), pp.output_count(), pp.arena(), (long)len);
                        pa.set_cnumber(pp.cnumber_enabled());
                        pa.parse();
                        if (pa.failed() != 0) {
                            failed = 1;
                            long nd = pa.diag_count();
                            long k = 0;
                            while (k < nd) {
                                io::print(fname);
                                io::print(":{}", pa.diag_line(k));
                                io::print(":{}", pa.diag_col(k));
                                io::print(": error: ");
                                io::println("{}", pa.diag_msg(k));
                                k = k + 1;
                            }
                        } else {
                            HirBuilder hb;
                            hb.setup(pa, pp.output_count());
                            hb.build();
                            long hd = hb.diag_count();
                            long k = 0;
                            while (k < hd) {
                                failed = 1;
                                io::print(fname);
                                io::print(":{}", hb.diag_line(k));
                                io::print(":{}", hb.diag_col(k));
                                io::print(": error: ");
                                io::println("{}", hb.diag_msg(k));
                                k = k + 1;
                            }
                            if (hd == 0) {
                                // The MIR stage: a diagnostic replaces the
                                // dump (the oracle prints no dump at all
                                // when the MIR builder reports one).
                                HUnit u = hb.unit();
                                MirBuilder mb;
                                mb.setup(u);
                                mb.build();
                                long md = mb.diag_count();
                                k = 0;
                                while (k < md) {
                                    failed = 1;
                                    io::print(fname);
                                    io::print(":{}", mb.diag_line(k));
                                    io::print(":{}", mb.diag_col(k));
                                    io::print(": error: ");
                                    io::println("{}", mb.diag_msg(k));
                                    k = k + 1;
                                }
                                if (md == 0) {
                                    MUnit mu = mb.unit();
                                    MirDumper d;
                                    d.mu = mu;
                                    d.dump_unit();
                                }
                                mb.release();
                            }
                            hb.release();
                        }
                        pa.release();
                    }
                    pp.release();
                }
                lx.release();
                __ivy_free(content);
            }
            __ivy_free(line);
        }
    }
    return failed;
}

int32 main() {
    long r = run();
    unsafe {
        return (int32) r;
    }
    return 0;
}
