// Test 7.1: Range-based for loop
// Array iteration with by-value and by-reference loop variables.
// Safety: the loop bound N is captured once from the array type
// (compile-time constant) — the body cannot mutate the bound, so
// iterator-invalidation (a la std::vector::push_back in C++) is
// impossible for fixed-size Ivy arrays.

#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

int32_t main() {
    int32_t arr[5];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    arr[4] = 50;

    // By-value: read each element
    int32_t sum = 0;
    for (int32_t x : arr) {
        sum = sum + x;
    }

    // By-reference: double each element in-place
    for (int32_t& x : arr) {
        x = x * 2;
    }

    // Verify doubling: now arr = {20, 40, 60, 80, 100}
    int32_t sum2 = 0;
    for (int32_t x : arr) {
        sum2 = sum2 + x;
    }

    // break inside range-for: stop at first element >= 60
    // arr = {20, 40, 60, 80, 100} → stops at 60 (index 2)
    int32_t firstBig = -1;
    for (int32_t x : arr) {
        if (x >= 60) {
            firstBig = x;
            break;
        }
    }

    // continue inside range-for: sum even elements only
    // arr = {20, 40, 60, 80, 100} — all even → 300
    int32_t evenSum = 0;
    for (int32_t x : arr) {
        if (x % 2 != 0) continue;
        evenSum = evenSum + x;
    }

    // Nested range-for: accumulate i*5 + j for all (i, j) pairs.
    // 5*5 = 25 iterations: sum(i*5+j) for i,j in [0,5)
    //   = 5*sum(i*5) + 5*sum(j) = 5*50 + 5*10 = 250 + 50 = 300
    int32_t mat[5];
    mat[0] = 0; mat[1] = 1; mat[2] = 2; mat[3] = 3; mat[4] = 4;
    int32_t nested = 0;
    for (int32_t i : mat) {
        for (int32_t j : mat) {
            nested = nested + i * 5 + j;
        }
    }

    printf("sum = %d\n", sum);        // 150
    printf("sum2 = %d\n", sum2);     // 300
    printf("firstBig = %d\n", firstBig);  // 60
    printf("evenSum = %d\n", evenSum);    // 300
    printf("nested = %d\n", nested);      // 300

    // (150 + 300 + 60 + 300 + 300) % 256 = 1110 % 256 = 86
    return (sum + sum2 + firstBig + evenSum + nested) % 256;
}
