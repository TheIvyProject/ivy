#pragma ivy cnumber
extern "C" int printf(const char* fmt, ...);

// Template struct: a simple Box holding one value of type T.
template <typename T>
struct Box {
    T value;

    T get() {
        return this.value;
    }

    void set(T v) {
        this.value = v;
    }
};

int main() {
    Box<int32_t> a;
    a.set(42);
    printf("a.get() = %d\n", a.get());  // 42
    printf("a.value = %d\n", a.value);   // 42

    Box<int32_t> b;
    b.set(100);
    printf("b.get() = %d\n", b.get());  // 100

    int32_t sum = a.get() + b.get();
    printf("sum = %d\n", sum);          // 142

    printf("all template struct tests passed\n");
    return 0;
}
