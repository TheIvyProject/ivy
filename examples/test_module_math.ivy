// 9.2 test: Module interface unit — exports math functions.
export module math;

// Exported functions — signatures are stored in math.ivm
export int32 add(int32 a, int32 b) {
    return a + b;
}

export int32 mul(int32 a, int32 b) {
    return a * b;
}

// Exported struct
export struct Vec2 {
    int32 x;
    int32 y;
};

// Exported type alias
using Scalar = int32;
