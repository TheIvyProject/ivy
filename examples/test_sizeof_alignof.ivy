// 8.3 test: sizeof / alignof
#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

struct Point {
    int x;
    int y;
    int z;
};

struct Big {
    long long a;
    int b;
    long long c;
};

int main() {
    printf("sizeof(char) = %d\n",      sizeof(char));
    printf("sizeof(int) = %d\n",      sizeof(int));
    printf("sizeof(long long) = %d\n", sizeof(long long));
    printf("sizeof(float) = %d\n",    sizeof(float));
    printf("sizeof(double) = %d\n",   sizeof(double));
    printf("sizeof(ptr) = %d\n",       sizeof(int*));
    printf("sizeof(Point) = %d\n",    sizeof(Point));
    printf("sizeof(Big) = %d\n",      sizeof(Big));
    printf("alignof(char) = %d\n",    alignof(char));
    printf("alignof(int) = %d\n",     alignof(int));
    printf("alignof(long long) = %d\n", alignof(long long));
    printf("alignof(Point) = %d\n",   alignof(Point));
    printf("alignof(Big) = %d\n",     alignof(Big));
    printf("alignof(ptr) = %d\n",     alignof(int*));
    return 0;
}
