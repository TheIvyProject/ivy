#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

struct Logger {
    int32 id;
    Logger(int32 id_) : id(id_) {
        printf("Logger(%d) constructed\n", this.id);
    }
    ~Logger() {
        printf("Logger(%d) destroyed\n", this.id);
    }
};

// RAII with break: the loop-scope local's dtor runs before break.
int32 test_break() {
    int32 sum = 0;
    for (int32 i = 0; i < 10; ++i) {
        Logger loop(i);
        sum = sum + i;
        if (i == 3) {
            printf("breaking at i=3, sum=%d\n", sum);
            break;
        }
    }
    return sum;
}

// RAII with continue: the loop-scope local's dtor runs before continue.
int32 test_continue() {
    int32 sum = 0;
    for (int32 i = 0; i < 5; ++i) {
        Logger loop(100 + i);
        if (i == 2) {
            printf("continuing at i=2\n");
            continue;
        }
        sum = sum + i;
    }
    return sum;
}

int main() {
    printf("=== test: RAII with break ===\n");
    int32 s1 = test_break();
    printf("test_break returned %d (expected 0+1+2+3=6)\n", s1);
    printf("---\n");

    printf("=== test: RAII with continue ===\n");
    int32 s2 = test_continue();
    printf("test_continue returned %d (expected 0+1+3+4=8)\n", s2);
    printf("---\n");
    return 0;
}
