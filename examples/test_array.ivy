// Test T[N] — array type with bounds checking
// Bounds checking is injected by codegen (unless inside [[ivy::unsafe]]).

#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

// Fill array and sum elements
int sum_array() {
    int arr[5];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    arr[4] = 50;

    int total = 0;
    for (int i = 0; i < 5; i = i + 1) {
        total = total + arr[i];
    }
    return total;  // expected: 150
}

// Read from zero-initialized array
int zero_init_test() {
    int buf[8];
    int sum = 0;
    for (int i = 0; i < 8; i = i + 1) {
        sum = sum + buf[i];  // all zeros
    }
    return sum;  // expected: 0
}

int main() {
    int s = sum_array();
    printf("sum_array = %d\n", s);  // 150

    int z = zero_init_test();
    printf("zero_init = %d\n", z);  // 0

    // Direct element access
    int data[3];
    data[0] = 100;
    data[1] = 200;
    data[2] = 300;
    printf("data[2] = %d\n", data[2]);  // 300

    printf("all tests passed\n");
    return 0;
}
