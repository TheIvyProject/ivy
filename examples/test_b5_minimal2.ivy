// B5 minimal test 2: expected<T, E> with implicit E conversion (error case)
import expected;

enum class Err { Bad, Worse };

expected<int32, Err> computeResult(int32 input) {
    if (input < 0) {
        return Err::Worse;
    }
    return input * 2;
}

int32 main() {
    expected<int32, Err> errResult = computeResult(-1);
    // Return 1 if hasValue is false (error case), 0 if true
    if (!errResult.hasValue) {
        return 1;
    }
    return 0;
}
