// Test nested short-circuit &&/||/?: codegen (PHI predecessor fix).
//
// EXPECT: compiles without backend crash and runs with exit 0.
// The rhs of &&/|| (and branches of ?:) may themselves contain &&/||,
// which create nested CFG blocks — the PHI must use the real fall-through
// block, not the assumed eval block.

#pragma ivy cnumber

bool is_a(char c) {
    if (c == 'a') {
        return true;
    }
    return false;
}

bool is_b(char c) {
    if (c == 'b') {
        return true;
    }
    return false;
}

int32 main() {
    int32 fails = 0;

    // 1. simple || / &&
    if (true || false) {
    } else {
        fails = fails + 1;
    }
    if (true && false) {
        fails = fails + 1;
    }

    // 2. (a || b) && c
    if ((false || true) && true) {
    } else {
        fails = fails + 1;
    }

    // 3. a || (b && c)
    if (is_a('x') || ('.' == '.' && is_b('b'))) {
    } else {
        fails = fails + 1;
    }

    // 4. three-level nesting with calls in the middle
    if (('e' == 'e' || 'e' == 'E') && (is_a('e') || (('e' == '+' || 'e' == '-') && is_b('e')))) {
        fails = fails + 1;
    }

    // 5. ternary with &&/|| in branches
    int32 t1 = (true && true) ? 1 : 0;
    if (t1 != 1) {
        fails = fails + 1;
    }
    int32 t2 = false ? 1 : (true || false ? 2 : 3);
    if (t2 != 2) {
        fails = fails + 1;
    }

    // 6. && in while condition
    int32 i = 0;
    int32 n = 0;
    while (i < 10 && n < 3) {
        i = i + 1;
        n = n + 1;
    }
    if (n != 3) {
        fails = fails + 1;
    }

    // 7. bare parenthesized ternary (no binary op before ?)
    int32 t3 = (true ? 7 : 8);
    if (t3 != 7) {
        fails = fails + 1;
    }
    int32 t4 = ((1 == 1) ? 9 : 10);
    if (t4 != 9) {
        fails = fails + 1;
    }

    io::println("shortcircuit fails={}", fails);
    return fails;
}
