#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

// Overload by param count
int add(int a, int b) { return a + b; }
int add(int a, int b, int c) { return a + b + c; }

// Overload by param type
int32 square(int32 x) { return x * x; }
int64 square(int64 x) { return x * x; }

// Overload with different param types
int32 power(int32 base, int32 exp) {
    int32 result = 1;
    for (int32 i = 0; i < exp; i = i + 1) result = result * base;
    return result;
}
int64 power(int64 base, int64 exp) {
    int64 result = 1;
    for (int64 i = 0; i < exp; i = i + 1) result = result * base;
    return result;
}

int main() {
    // Overload by param count
    int r1 = add(10, 20);
    int r2 = add(10, 20, 30);
    printf("add(10,20) = %d\n", r1);        // 30
    printf("add(10,20,30) = %d\n", r2);     // 60

    // Overload by param type — use typed variables to force resolution.
    int32 s1 = square(5);
    int64 big = 100000;
    int64 s2 = square(big);
    printf("square(5) = %d\n", s1);          // 25
    printf("square(100000) = %lld\n", s2);   // 10000000000

    // Overload with int32 params
    int32 p1 = power(2, 10);
    printf("power(2,10) = %d\n", p1);        // 1024

    // Overload with int64 params
    int64 b3 = 3;
    int64 e20 = 20;
    int64 p2 = power(b3, e20);
    printf("power(3,20) = %lld\n", p2);      // 3486784401

    printf("all overload tests passed\n");
    return 0;
}
