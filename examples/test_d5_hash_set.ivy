// D5 test: ivy::hash_set<T>
//
// Tests hash_set with insert, contains, remove, growth, and tombstone reuse.

#pragma ivy cnumber
import hash_set;

extern "C" int printf(const char* fmt, ...);

int main() {
    // 1. Default constructor + len()
    hash_set<int32> s1;
    if (s1.len() != 0) {
        printf("FAIL: s1.len() should be 0\n");
        return 1;
    }

    // 2. Insert
    s1.insert(10);
    s1.insert(20);
    s1.insert(30);
    if (s1.len() != 3) {
        printf("FAIL: s1.len() should be 3\n");
        return 1;
    }

    // 3. Contains
    if (!s1.contains(10)) {
        printf("FAIL: s1 should contain 10\n");
        return 1;
    }
    if (!s1.contains(20)) {
        printf("FAIL: s1 should contain 20\n");
        return 1;
    }
    if (!s1.contains(30)) {
        printf("FAIL: s1 should contain 30\n");
        return 1;
    }
    if (s1.contains(999)) {
        printf("FAIL: s1 should not contain 999\n");
        return 1;
    }

    // 4. Duplicate insert (no-op)
    s1.insert(10);
    if (s1.len() != 3) {
        printf("FAIL: s1.len() should still be 3 after duplicate\n");
        return 1;
    }

    // 5. Remove
    s1.remove(20);
    if (s1.len() != 2) {
        printf("FAIL: s1.len() should be 2 after remove\n");
        return 1;
    }
    if (s1.contains(20)) {
        printf("FAIL: s1 should not contain 20 after remove\n");
        return 1;
    }
    if (!s1.contains(10)) {
        printf("FAIL: s1 should still contain 10\n");
        return 1;
    }

    // 6. Re-insert after remove
    s1.insert(20);
    if (s1.len() != 3) {
        printf("FAIL: s1.len() should be 3 after re-insert\n");
        return 1;
    }
    if (!s1.contains(20)) {
        printf("FAIL: s1 should contain 20 after re-insert\n");
        return 1;
    }

    // 7. Growth — insert many elements
    hash_set<int32> s2;
    int32 i = 0;
    while (i < 100) {
        s2.insert(i);
        i = i + 1;
    }
    if (s2.len() != 100) {
        printf("FAIL: s2.len() should be 100, got %llu\n", s2.len());
        return 1;
    }
    i = 0;
    while (i < 100) {
        if (!s2.contains(i)) {
            printf("FAIL: s2 should contain %d\n", i);
            return 1;
        }
        i = i + 1;
    }

    // 8. Remove half
    i = 0;
    while (i < 50) {
        s2.remove(i);
        i = i + 1;
    }
    if (s2.len() != 50) {
        printf("FAIL: s2.len() should be 50, got %llu\n", s2.len());
        return 1;
    }
    i = 0;
    while (i < 50) {
        if (s2.contains(i)) {
            printf("FAIL: s2 should not contain %d\n", i);
            return 1;
        }
        i = i + 1;
    }
    i = 50;
    while (i < 100) {
        if (!s2.contains(i)) {
            printf("FAIL: s2 should contain %d\n", i);
            return 1;
        }
        i = i + 1;
    }

    // 9. Remove all remaining
    i = 50;
    while (i < 100) {
        s2.remove(i);
        i = i + 1;
    }
    if (s2.len() != 0) {
        printf("FAIL: s2.len() should be 0, got %llu\n", s2.len());
        return 1;
    }

    printf("D5 ivy::hash_set tests passed\n");
    return 0;
}
