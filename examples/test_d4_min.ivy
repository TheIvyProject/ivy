// D4 minimal test: unique_ptr basic
#pragma ivy cnumber
import unique_ptr;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void  __ivy_free(void* p);
extern "C" int   printf(const char* fmt, ...);

int32 main() {
    unsafe {
        int32* mem = (int32*)__ivy_alloc(4);
        *mem = 42;
        unique_ptr<int32> p = unique_ptr<int32>(mem);
        int32 val = *p;
        printf("val = %d\n", val);
    }
    return 0;
}
