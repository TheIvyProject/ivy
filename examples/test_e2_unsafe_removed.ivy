// E2 test: [[ivy::unsafe]] attribute is removed
// This test verifies that [[ivy::unsafe]] now reports an error
// directing the user to use `unsafe { }` keyword instead.
//
// EXPECT: compile failure with error message containing "removed"
// and "unsafe { }"

#pragma ivy cnumber

extern "C" {
    int printf(const char* fmt, ...);
}

int main() {
    int x = 42;

    // E2: This should fail to compile
    [[ivy::unsafe]] {
        int* p = &x;
        printf("should not reach here: %d\n", *p);
    }

    return 0;
}
