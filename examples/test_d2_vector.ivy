// D2 test: ivy::vector<T>
//
// Tests the dynamic array type with RAII, push, pop, len, operator[].
//
// Run: ivyc test_d2_vector.ivy -o test_d2_vector.exe && ./test_d2_vector.exe

#pragma ivy cnumber
import vector;

int main() {
    // 1. Default constructor + len()
    vector<int32> v1;
    if (v1.len() != 0) {
        io::eprintln("FAIL: v1.len() should be 0");
        return 1;
    }

    // 2. Push elements
    v1.push(10);
    v1.push(20);
    v1.push(30);
    if (v1.len() != 3) {
        io::eprintln("FAIL: v1.len() should be 3");
        return 1;
    }

    // 3. Element access via operator[]
    if (v1[0] != 10) {
        io::eprintln("FAIL: v1[0] should be 10");
        return 1;
    }
    if (v1[1] != 20) {
        io::eprintln("FAIL: v1[1] should be 20");
        return 1;
    }
    if (v1[2] != 30) {
        io::eprintln("FAIL: v1[2] should be 30");
        return 1;
    }

    // 4. Modify via operator[]
    v1[1] = 99;
    if (v1[1] != 99) {
        io::eprintln("FAIL: v1[1] should be 99 after modify");
        return 1;
    }

    // 5. Pop
    v1.pop();
    if (v1.len() != 2) {
        io::eprintln("FAIL: v1.len() should be 2 after pop");
        return 1;
    }
    if (v1[1] != 99) {
        io::eprintln("FAIL: v1[1] should still be 99");
        return 1;
    }

    // 6. Push many elements to test growth
    vector<int32> v2;
    int32 i = 0;
    while (i < 100) {
        v2.push(i * 2);
        i = i + 1;
    }
    if (v2.len() != 100) {
        io::eprintln("FAIL: v2.len() should be 100");
        return 1;
    }
    if (v2[50] != 100) {
        io::eprintln("FAIL: v2[50] should be 100");
        return 1;
    }
    if (v2[99] != 198) {
        io::eprintln("FAIL: v2[99] should be 198");
        return 1;
    }

    // 7. Pop back to empty
    while (v2.len() > 0) {
        v2.pop();
    }
    if (v2.len() != 0) {
        io::eprintln("FAIL: v2.len() should be 0 after popping all");
        return 1;
    }

    // 8. Range-based for over vector
    vector<int32> v3;
    v3.push(1);
    v3.push(2);
    v3.push(3);
    v3.push(4);
    v3.push(5);
    int32 sum = 0;
    for (int32 x : v3) {
        sum = sum + x;
    }
    if (sum != 15) {
        io::println("FAIL: range-for sum should be 15");
        return 1;
    }

    // 9. Range-based for with reference — modify elements
    vector<int32> v4;
    v4.push(10);
    v4.push(20);
    v4.push(30);
    int32 total = 0;
    for (int32& x : v4) {
        x = x * 2;
        total = total + x;
    }
    if (total != 120) {
        io::println("FAIL: range-for ref total should be 120");
        return 1;
    }
    if (v4[0] != 20 || v4[1] != 40 || v4[2] != 60) {
        io::println("FAIL: range-for ref did not modify elements");
        return 1;
    }

    io::println("D2 ivy::vector tests passed");
    return 0;
}
