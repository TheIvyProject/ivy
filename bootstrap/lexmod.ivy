// bootstrap/lexmod.ivy — F1.1/F1.2: Ivy port of src/parsing/lexer.cpp
// (+ token.h) as an importable module.
//
// Contains ONLY structs with methods + zero free functions: in module
// files, free functions cannot call each other (not even same-file), so
// every helper (keyword table, char classes, kind codes) is a method.
// Tokens live in a stride-5 uint64 buffer (kind/start/count/line/col);
// lexemes materialize from source text on demand.
//
// Used by lexdrive (F1.1 --lex differential) and ppmod (F1.2).

#pragma ivy cnumber

export module lexmod;

import string;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);
extern "C" void __ivy_memcpy(void* dst, const void* src, unsigned long long n);

export struct Lexer {
    string src_;
    const char* buf_;
    uint64 len_;
    uint64 pos_;
    uint64 line_;
    uint64 col_;
    string path_;
    // Token buffer: stride-5 [kind,start,count,line,col] per token.
    uint64* tbuf_;
    uint64 tlen_;
    uint64 tcap_;
    // print_errs: print diagnostics as encountered. store: push tokens.
    bool print_errs_;
    bool store_;
    bool failed_;

    void setup(string src, uint64 len, string path) {
        this.src_ = src;
        this.len_ = len;
        this.pos_ = 0;
        this.line_ = 1;
        this.col_ = 1;
        this.path_ = path;
        this.print_errs_ = false;
        this.store_ = false;
        this.failed_ = false;
        unsafe {
            this.buf_ = this.src_.cstr();
            this.tbuf_ = (uint64*)0;
        }
        this.tlen_ = 0;
        this.tcap_ = 0;
        this.check_bom();
    }

    void reset() {
        this.pos_ = 0;
        this.line_ = 1;
        this.col_ = 1;
        this.tlen_ = 0;
        this.check_bom();
    }

    bool failed() {
        return this.failed_;
    }

    void check_bom() {
        unsafe {
            if (this.len_ >= 3) {
                const char* b = this.buf_;
                int32 b0 = (int32)b[0];
                int32 b1 = (int32)b[1];
                int32 b2 = (int32)b[2];
                if (b0 == 239 && b1 == 187 && b2 == 191) {
                    this.pos_ = 3;
                }
            }
        }
    }

    char peek_at(uint64 off) {
        unsafe {
            const char* b = this.buf_;
            if (this.pos_ + off >= this.len_) {
                return '\0';
            }
            return b[this.pos_ + off];
        }
        return '?';
    }

    char peek() {
        return this.peek_at(0);
    }

    void advance() {
        unsafe {
            const char* b = this.buf_;
            char c = b[this.pos_];
            this.pos_ = this.pos_ + 1;
            if (c == '\n') {
                this.line_ = this.line_ + 1;
                this.col_ = 1;
            } else {
                this.col_ = this.col_ + 1;
            }
        }
    }

    void error_at(uint64 line, uint64 col, string msg) {
        this.failed_ = true;
        if (this.print_errs_) {
            io::println("\"{}\":{}:{}: error: {}", this.path_.cstr(), line, col, msg.cstr());
        }
    }

    void tgrow() {
        unsafe {
            uint64 new_cap = this.tcap_ * 2;
            if (new_cap == 0) {
                new_cap = 16;
            }
            uint64* nbuf = (uint64*)__ivy_alloc(new_cap * 5 * 8);
            if (this.tlen_ > 0) {
                __ivy_memcpy(nbuf, this.tbuf_, this.tlen_ * 5 * 8);
            }
            __ivy_free(this.tbuf_);
            this.tbuf_ = nbuf;
            this.tcap_ = new_cap;
        }
    }

    void emit(uint64 line, uint64 col, uint64 code, uint64 start, uint64 count) {
        if (this.store_) {
            if (this.tlen_ >= this.tcap_) {
                this.tgrow();
            }
            unsafe {
                uint64* b = this.tbuf_;
                uint64 o = this.tlen_ * 5;
                b[o] = code;
                b[o + 1] = start;
                b[o + 2] = count;
                b[o + 3] = line;
                b[o + 4] = col;
            }
            this.tlen_ = this.tlen_ + 1;
        }
    }

    uint64 tok_count() {
        return this.tlen_;
    }

    uint64 kind_at(uint64 i) {
        unsafe {
            return this.tbuf_[i * 5];
        }
        return 999;
    }

    uint64 start_at(uint64 i) {
        unsafe {
            return this.tbuf_[i * 5 + 1];
        }
        return 0;
    }

    uint64 count_at(uint64 i) {
        unsafe {
            return this.tbuf_[i * 5 + 2];
        }
        return 0;
    }

    uint64 line_at(uint64 i) {
        unsafe {
            return this.tbuf_[i * 5 + 3];
        }
        return 0;
    }

    uint64 col_at(uint64 i) {
        unsafe {
            return this.tbuf_[i * 5 + 4];
        }
        return 0;
    }

    // Token kind codes, in src/parsing/token.h order.
    uint64 tkc(string name) {
        if (name == string("identifier")) { return 0; }
        if (name == string("keyword")) { return 1; }
        if (name == string("integer")) { return 2; }
        if (name == string("float")) { return 3; }
        if (name == string("string")) { return 4; }
        if (name == string("char")) { return 5; }
        if (name == string("lifetime")) { return 6; }
        if (name == string("eof")) { return 7; }
        if (name == string("plus")) { return 8; }
        if (name == string("minus")) { return 9; }
        if (name == string("star")) { return 10; }
        if (name == string("slash")) { return 11; }
        if (name == string("percent")) { return 12; }
        if (name == string("assign")) { return 13; }
        if (name == string("plus_assign")) { return 14; }
        if (name == string("minus_assign")) { return 15; }
        if (name == string("star_assign")) { return 16; }
        if (name == string("slash_assign")) { return 17; }
        if (name == string("percent_assign")) { return 18; }
        if (name == string("amp")) { return 19; }
        if (name == string("pipe")) { return 20; }
        if (name == string("caret")) { return 21; }
        if (name == string("tilde")) { return 22; }
        if (name == string("amp_assign")) { return 23; }
        if (name == string("pipe_assign")) { return 24; }
        if (name == string("caret_assign")) { return 25; }
        if (name == string("shl")) { return 26; }
        if (name == string("shr")) { return 27; }
        if (name == string("shl_assign")) { return 28; }
        if (name == string("shr_assign")) { return 29; }
        if (name == string("bang")) { return 30; }
        if (name == string("eq")) { return 31; }
        if (name == string("ne")) { return 32; }
        if (name == string("lt")) { return 33; }
        if (name == string("gt")) { return 34; }
        if (name == string("le")) { return 35; }
        if (name == string("ge")) { return 36; }
        if (name == string("andand")) { return 37; }
        if (name == string("oror")) { return 38; }
        if (name == string("plusplus")) { return 39; }
        if (name == string("minusminus")) { return 40; }
        if (name == string("arrow")) { return 41; }
        if (name == string("dot")) { return 42; }
        if (name == string("arrowstar")) { return 43; }
        if (name == string("dotstar")) { return 44; }
        if (name == string("question")) { return 45; }
        if (name == string("colon")) { return 46; }
        if (name == string("coloncolon")) { return 47; }
        if (name == string("semi")) { return 48; }
        if (name == string("comma")) { return 49; }
        if (name == string("lparen")) { return 50; }
        if (name == string("rparen")) { return 51; }
        if (name == string("lbrace")) { return 52; }
        if (name == string("rbrace")) { return 53; }
        if (name == string("lbracket")) { return 54; }
        if (name == string("rbracket")) { return 55; }
        if (name == string("ellipsis")) { return 56; }
        if (name == string("hash")) { return 57; }
        if (name == string("hashhash")) { return 58; }
        return 999;
    }

    // Print one token line directly with the kind display name
    // (mirroring tokenKindName()). Names print as literals (no temp
    // strings) to keep per-token churn minimal at scale.
    void print_tok_lex(uint64 ln, uint64 co, const char* nm, string lx) {
        if (lx.empty()) {
            io::println("{}:{}\t{}", ln, co, nm);
        } else {
            io::println("{}:{}\t{}\t'{}'", ln, co, nm, lx.cstr());
        }
    }

    void print_tok(uint64 code, uint64 ln, uint64 co, string lx) {
        if (code == 0) { this.print_tok_lex(ln, co, "identifier", lx); return; }
        if (code == 1) { this.print_tok_lex(ln, co, "keyword", lx); return; }
        if (code == 2) { this.print_tok_lex(ln, co, "integer", lx); return; }
        if (code == 3) { this.print_tok_lex(ln, co, "float", lx); return; }
        if (code == 4) { this.print_tok_lex(ln, co, "string", lx); return; }
        if (code == 5) { this.print_tok_lex(ln, co, "char", lx); return; }
        if (code == 6) { this.print_tok_lex(ln, co, "lifetime", lx); return; }
        if (code == 7) { this.print_tok_lex(ln, co, "eof", lx); return; }
        if (code == 8) { this.print_tok_lex(ln, co, "+", lx); return; }
        if (code == 9) { this.print_tok_lex(ln, co, "-", lx); return; }
        if (code == 10) { this.print_tok_lex(ln, co, "*", lx); return; }
        if (code == 11) { this.print_tok_lex(ln, co, "/", lx); return; }
        if (code == 12) { this.print_tok_lex(ln, co, "%", lx); return; }
        if (code == 13) { this.print_tok_lex(ln, co, "=", lx); return; }
        if (code == 14) { this.print_tok_lex(ln, co, "+=", lx); return; }
        if (code == 15) { this.print_tok_lex(ln, co, "-=", lx); return; }
        if (code == 16) { this.print_tok_lex(ln, co, "*=", lx); return; }
        if (code == 17) { this.print_tok_lex(ln, co, "/=", lx); return; }
        if (code == 18) { this.print_tok_lex(ln, co, "%=", lx); return; }
        if (code == 19) { this.print_tok_lex(ln, co, "&", lx); return; }
        if (code == 20) { this.print_tok_lex(ln, co, "|", lx); return; }
        if (code == 21) { this.print_tok_lex(ln, co, "^", lx); return; }
        if (code == 22) { this.print_tok_lex(ln, co, "~", lx); return; }
        if (code == 23) { this.print_tok_lex(ln, co, "&=", lx); return; }
        if (code == 24) { this.print_tok_lex(ln, co, "|=", lx); return; }
        if (code == 25) { this.print_tok_lex(ln, co, "^=", lx); return; }
        if (code == 26) { this.print_tok_lex(ln, co, "<<", lx); return; }
        if (code == 27) { this.print_tok_lex(ln, co, ">>", lx); return; }
        if (code == 28) { this.print_tok_lex(ln, co, "<<=", lx); return; }
        if (code == 29) { this.print_tok_lex(ln, co, ">>=", lx); return; }
        if (code == 30) { this.print_tok_lex(ln, co, "!", lx); return; }
        if (code == 31) { this.print_tok_lex(ln, co, "==", lx); return; }
        if (code == 32) { this.print_tok_lex(ln, co, "!=", lx); return; }
        if (code == 33) { this.print_tok_lex(ln, co, "<", lx); return; }
        if (code == 34) { this.print_tok_lex(ln, co, ">", lx); return; }
        if (code == 35) { this.print_tok_lex(ln, co, "<=", lx); return; }
        if (code == 36) { this.print_tok_lex(ln, co, ">=", lx); return; }
        if (code == 37) { this.print_tok_lex(ln, co, "&&", lx); return; }
        if (code == 38) { this.print_tok_lex(ln, co, "||", lx); return; }
        if (code == 39) { this.print_tok_lex(ln, co, "++", lx); return; }
        if (code == 40) { this.print_tok_lex(ln, co, "--", lx); return; }
        if (code == 41) { this.print_tok_lex(ln, co, "->", lx); return; }
        if (code == 42) { this.print_tok_lex(ln, co, ".", lx); return; }
        if (code == 43) { this.print_tok_lex(ln, co, "->*", lx); return; }
        if (code == 44) { this.print_tok_lex(ln, co, ".*", lx); return; }
        if (code == 45) { this.print_tok_lex(ln, co, "?", lx); return; }
        if (code == 46) { this.print_tok_lex(ln, co, ":", lx); return; }
        if (code == 47) { this.print_tok_lex(ln, co, "::", lx); return; }
        if (code == 48) { this.print_tok_lex(ln, co, ";", lx); return; }
        if (code == 49) { this.print_tok_lex(ln, co, ",", lx); return; }
        if (code == 50) { this.print_tok_lex(ln, co, "(", lx); return; }
        if (code == 51) { this.print_tok_lex(ln, co, ")", lx); return; }
        if (code == 52) { this.print_tok_lex(ln, co, "{", lx); return; }
        if (code == 53) { this.print_tok_lex(ln, co, "}", lx); return; }
        if (code == 54) { this.print_tok_lex(ln, co, "[", lx); return; }
        if (code == 55) { this.print_tok_lex(ln, co, "]", lx); return; }
        if (code == 56) { this.print_tok_lex(ln, co, "...", lx); return; }
        if (code == 57) { this.print_tok_lex(ln, co, "#", lx); return; }
        if (code == 58) { this.print_tok_lex(ln, co, "##", lx); return; }
        this.print_tok_lex(ln, co, "?", lx);
    }

    // Full C++ keyword set, mirrored from Lexer::keywords().
