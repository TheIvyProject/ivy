    bool is_raw_prefix(string id) {
        if (id == string("R")) { return true; }
        if (id == string("u8R")) { return true; }
        if (id == string("uR")) { return true; }
        if (id == string("UR")) { return true; }
        if (id == string("LR")) { return true; }
        return false;
    }

    bool is_str_prefix(string id) {
        if (id == string("L")) { return true; }
        if (id == string("u")) { return true; }
        if (id == string("U")) { return true; }
        if (id == string("u8")) { return true; }
        return false;
    }

    bool is_char_prefix(string id) {
        if (id == string("L")) { return true; }
        if (id == string("u")) { return true; }
        if (id == string("U")) { return true; }
        return false;
    }

    bool ch_is_ident_start(char c) {
        if (c == '_') { return true; }
        if (c >= 'a') {
            if (c <= 'z') { return true; }
        }
        if (c >= 'A') {
            if (c <= 'Z') { return true; }
        }
        return false;
    }

    bool ch_is_ident_cont(char c) {
        if (this.ch_is_ident_start(c)) { return true; }
        if (c >= '0') {
            if (c <= '9') { return true; }
        }
        return false;
    }

    bool ch_is_digit(char c) {
        if (c >= '0') {
            if (c <= '9') { return true; }
        }
        return false;
    }

    bool ch_is_hex(char c) {
        if (this.ch_is_digit(c)) { return true; }
        if (c >= 'a') {
            if (c <= 'f') { return true; }
        }
        if (c >= 'A') {
            if (c <= 'F') { return true; }
        }
        return false;
    }

    bool ch_is_bin(char c) {
        if (c == '0') { return true; }
        if (c == '1') { return true; }
        return false;
    }

    bool ch_is_suffix(char c) {
        if (c == 'u') { return true; }
        if (c == 'U') { return true; }
        if (c == 'l') { return true; }
        if (c == 'L') { return true; }
        if (c == 'f') { return true; }
        if (c == 'F') { return true; }
        return false;
    }

    void skip_trivia() {
        while (true) {
            char c = this.peek();
            if (c == ' ' || c == '\t' || c == '\r' || c == '\v' || c == '\f' || c == '\n') {
                this.advance();
            } else {
                if (c == '/' && this.peek_at(1) == '/') {
                    while (this.peek() != '\n' && this.peek() != '\0') {
                        this.advance();
                    }
                } else {
                    if (c == '/' && this.peek_at(1) == '*') {
                        uint64 sl = this.line_;
                        uint64 sc = this.col_;
                        this.advance();
                        this.advance();
                        bool closed = false;
                        while (this.peek() != '\0') {
                            if (this.peek() == '*' && this.peek_at(1) == '/') {
                                this.advance();
                                this.advance();
                                closed = true;
                                break;
                            }
                            this.advance();
                        }
                        if (!closed) {
                            this.error_at(sl, sc, string("unterminated block comment"));
                        }
                    } else {
                        break;
                    }
                }
            }
        }
    }

    void lex_word(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        while (this.ch_is_ident_cont(this.peek())) {
            this.advance();
        }
        string id = src.substr(start, this.pos_ - start);
        if (this.is_raw_prefix(id) && this.peek() == '"') {
            this.lex_raw(start, line, col);
            return;
        }
        if (this.is_str_prefix(id)) {
            if (this.peek() == '"') {
                this.lex_string(start, line, col);
                return;
            }
            if (this.peek() == '\'') {
                this.lex_char(start, line, col);
                return;
            }
        }
        if (this.is_kw(id)) {
            this.emit(line, col, this.tkc(string("keyword")), start, this.pos_ - start);
        } else {
            this.emit(line, col, this.tkc(string("identifier")), start, this.pos_ - start);
        }
    }

    void lex_token() {
        uint64 start = this.pos_;
        uint64 line = this.line_;
        uint64 col = this.col_;
        char c = this.peek();
        if (c == '$' && this.ch_is_ident_start(this.peek_at(1))) {
            this.advance();
            while (this.ch_is_ident_cont(this.peek())) {
                this.advance();
            }
            this.emit(line, col, this.tkc(string("lifetime")), start, this.pos_ - start);
            return;
        }
        if (this.ch_is_ident_start(c)) {
            this.lex_word(start, line, col);
            return;
        }
        if (this.ch_is_digit(c) || (c == '.' && this.ch_is_digit(this.peek_at(1)))) {
            this.lex_number(line, col);
            return;
        }
        if (c == '"') {
            this.lex_string(start, line, col);
            return;
        }
        if (c == '\'') {
            this.lex_char(start, line, col);
            return;
        }
        if (this.try_op3(start, line, col)) {
            return;
        }
        if (this.try_op2(start, line, col)) {
            return;
        }
        if (this.try_op1(start, line, col)) {
            return;
        }
        this.error_at(line, col, string("unexpected character"));
        this.advance();
        this.emit(line, col, this.tkc(string("eof")), start, 1);
    }

    bool try_op3(uint64 start, uint64 line, uint64 col) {
        char p0 = this.peek();
        char p1 = this.peek_at(1);
        char p2 = this.peek_at(2);
        if (p0 == '.' && p1 == '.' && p2 == '.') {
            this.advance();
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("ellipsis")), start, 3);
            return true;
        }
        if (p0 == '<' && p1 == '<' && p2 == '=') {
            this.advance();
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("shl_assign")), start, 3);
            return true;
        }
        if (p0 == '>' && p1 == '>' && p2 == '=') {
            this.advance();
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("shr_assign")), start, 3);
            return true;
        }
        if (p0 == '-' && p1 == '>' && p2 == '*') {
            this.advance();
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("arrowstar")), start, 3);
            return true;
        }
        return false;
    }

    bool try_op2(uint64 start, uint64 line, uint64 col) {
        char p0 = this.peek();
        char p1 = this.peek_at(1);
        if (p0 == '<' && p1 == '<') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("shl")), start, 2);
            return true;
        }
        if (p0 == '>' && p1 == '>') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("shr")), start, 2);
            return true;
        }
        if (p0 == '+' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("plus_assign")), start, 2);
            return true;
        }
        if (p0 == '-' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("minus_assign")), start, 2);
            return true;
        }
        if (p0 == '*' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("star_assign")), start, 2);
            return true;
        }
        if (p0 == '/' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("slash_assign")), start, 2);
            return true;
        }
        if (p0 == '%' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("percent_assign")), start, 2);
            return true;
        }
        if (p0 == '&' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("amp_assign")), start, 2);
            return true;
        }
        if (p0 == '|' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("pipe_assign")), start, 2);
            return true;
        }
        if (p0 == '^' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("caret_assign")), start, 2);
            return true;
        }
        if (p0 == '+' && p1 == '+') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("plusplus")), start, 2);
            return true;
        }
        if (p0 == '-' && p1 == '-') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("minusminus")), start, 2);
            return true;
        }
        if (p0 == '-' && p1 == '>') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("arrow")), start, 2);
            return true;
        }
        if (p0 == '<' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("le")), start, 2);
            return true;
        }
        if (p0 == '>' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("ge")), start, 2);
            return true;
        }
        if (p0 == '=' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("eq")), start, 2);
            return true;
        }
        if (p0 == '!' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("ne")), start, 2);
            return true;
        }
        if (p0 == '&' && p1 == '&') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("andand")), start, 2);
            return true;
        }
        if (p0 == '|' && p1 == '|') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("oror")), start, 2);
            return true;
        }
        if (p0 == ':' && p1 == ':') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("coloncolon")), start, 2);
            return true;
        }
        if (p0 == '.' && p1 == '*') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("dotstar")), start, 2);
            return true;
        }
        if (p0 == '#' && p1 == '#') {
            this.advance();
            this.advance();
            this.emit(line, col, this.tkc(string("hashhash")), start, 2);
            return true;
        }
        return false;
    }

    bool try_op1(uint64 start, uint64 line, uint64 col) {
        char p0 = this.peek();
        if (p0 == '+') {
            this.advance();
            this.emit(line, col, this.tkc(string("plus")), start, 1);
            return true;
        }
        if (p0 == '-') {
            this.advance();
            this.emit(line, col, this.tkc(string("minus")), start, 1);
            return true;
        }
        if (p0 == '*') {
            this.advance();
            this.emit(line, col, this.tkc(string("star")), start, 1);
            return true;
        }
        if (p0 == '/') {
            this.advance();
            this.emit(line, col, this.tkc(string("slash")), start, 1);
            return true;
        }
        if (p0 == '%') {
            this.advance();
            this.emit(line, col, this.tkc(string("percent")), start, 1);
            return true;
        }
        if (p0 == '=') {
            this.advance();
            this.emit(line, col, this.tkc(string("assign")), start, 1);
            return true;
        }
        if (p0 == '<') {
            this.advance();
            this.emit(line, col, this.tkc(string("lt")), start, 1);
            return true;
        }
        if (p0 == '>') {
            this.advance();
            this.emit(line, col, this.tkc(string("gt")), start, 1);
            return true;
        }
        if (p0 == '!') {
            this.advance();
            this.emit(line, col, this.tkc(string("bang")), start, 1);
            return true;
        }
        if (p0 == '~') {
            this.advance();
            this.emit(line, col, this.tkc(string("tilde")), start, 1);
            return true;
        }
        if (p0 == '&') {
            this.advance();
            this.emit(line, col, this.tkc(string("amp")), start, 1);
            return true;
        }
        if (p0 == '|') {
            this.advance();
            this.emit(line, col, this.tkc(string("pipe")), start, 1);
            return true;
        }
        if (p0 == '^') {
            this.advance();
            this.emit(line, col, this.tkc(string("caret")), start, 1);
            return true;
        }
        if (p0 == '?') {
            this.advance();
            this.emit(line, col, this.tkc(string("question")), start, 1);
            return true;
        }
        if (p0 == ':') {
            this.advance();
            this.emit(line, col, this.tkc(string("colon")), start, 1);
            return true;
        }
        if (p0 == ';') {
            this.advance();
            this.emit(line, col, this.tkc(string("semi")), start, 1);
            return true;
        }
        if (p0 == ',') {
            this.advance();
            this.emit(line, col, this.tkc(string("comma")), start, 1);
            return true;
        }
        if (p0 == '(') {
            this.advance();
            this.emit(line, col, this.tkc(string("lparen")), start, 1);
            return true;
        }
        if (p0 == ')') {
            this.advance();
            this.emit(line, col, this.tkc(string("rparen")), start, 1);
            return true;
        }
        if (p0 == '{') {
            this.advance();
            this.emit(line, col, this.tkc(string("lbrace")), start, 1);
            return true;
        }
        if (p0 == '}') {
            this.advance();
            this.emit(line, col, this.tkc(string("rbrace")), start, 1);
            return true;
        }
        if (p0 == '[') {
            this.advance();
            this.emit(line, col, this.tkc(string("lbracket")), start, 1);
            return true;
        }
        if (p0 == ']') {
            this.advance();
            this.emit(line, col, this.tkc(string("rbracket")), start, 1);
            return true;
        }
        if (p0 == '.') {
            this.advance();
            this.emit(line, col, this.tkc(string("dot")), start, 1);
            return true;
        }
        if (p0 == '#') {
            this.advance();
            this.emit(line, col, this.tkc(string("hash")), start, 1);
            return true;
        }
        return false;
    }

    void lex_number(uint64 line, uint64 col) {
        uint64 start = this.pos_;
        bool is_float = false;
        if (this.peek() == '0' && (this.peek_at(1) == 'x' || this.peek_at(1) == 'X')) {
            this.advance();
            this.advance();
            bool any = false;
            while (this.ch_is_hex(this.peek()) || this.peek() == '\'') {
                if (this.peek() != '\'') {
                    any = true;
                }
                this.advance();
            }
            if (!any) {
                this.error_at(line, col, string("invalid hexadecimal literal: expected hex digits after '0x'"));
            }
        } else {
            if (this.peek() == '0' && (this.peek_at(1) == 'b' || this.peek_at(1) == 'B')) {
                this.advance();
                this.advance();
                bool any = false;
                while (this.ch_is_bin(this.peek()) || this.peek() == '\'') {
                    if (this.peek() != '\'') {
                        any = true;
                    }
                    this.advance();
                }
                if (!any) {
                    this.error_at(line, col, string("invalid binary literal: expected binary digits after '0b'"));
                }
            } else {
                while (this.ch_is_digit(this.peek()) || this.peek() == '\'') {
                    this.advance();
                }
                if (this.peek() == '.' && this.peek_at(1) != '.') {
                    is_float = true;
                    this.advance();
                    while (this.ch_is_digit(this.peek()) || this.peek() == '\'') {
                        this.advance();
                    }
                }
                if ((this.peek() == 'e' || this.peek() == 'E') && (this.ch_is_digit(this.peek_at(1)) || ((this.peek_at(1) == '+' || this.peek_at(1) == '-') && this.ch_is_digit(this.peek_at(2))))) {
                    is_float = true;
                    this.advance();
                    if (this.peek() == '+' || this.peek() == '-') {
                        this.advance();
                    }
                    while (this.ch_is_digit(this.peek()) || this.peek() == '\'') {
                        this.advance();
                    }
                }
            }
        }
        while (this.ch_is_suffix(this.peek())) {
            if (this.peek() == 'f' || this.peek() == 'F') {
                is_float = true;
            }
            this.advance();
        }
        if (is_float) {
            this.emit(line, col, this.tkc(string("float")), start, this.pos_ - start);
        } else {
            this.emit(line, col, this.tkc(string("integer")), start, this.pos_ - start);
        }
    }

    void lex_string(uint64 start, uint64 line, uint64 col) {
        this.advance();
        while (true) {
            char c = this.peek();
            if (c == '\0' || c == '\n') {
                this.error_at(line, col, string("unterminated string literal"));
                break;
            }
            this.advance();
            if (c == '"') {
                break;
            }
            if (c == '\\' && this.peek() != '\0') {
                this.advance();
            }
        }
        this.emit(line, col, this.tkc(string("string")), start, this.pos_ - start);
    }

    void lex_char(uint64 start, uint64 line, uint64 col) {
        this.advance();
        while (true) {
            char c = this.peek();
            if (c == '\0' || c == '\n') {
                this.error_at(line, col, string("unterminated character literal"));
                break;
            }
            this.advance();
            if (c == '\'') {
                break;
            }
            if (c == '\\' && this.peek() != '\0') {
                this.advance();
            }
        }
        this.emit(line, col, this.tkc(string("char")), start, this.pos_ - start);
    }

    void lex_raw(uint64 start, uint64 line, uint64 col) {
        this.advance();
        uint64 dstart = this.pos_;
        while (this.peek() != '(' && this.peek() != '\0' && this.peek() != '\n') {
            this.advance();
        }
        if (this.peek() != '(') {
            this.error_at(line, col, string("unterminated raw string literal"));
            this.emit(line, col, this.tkc(string("string")), start, this.pos_ - start);
            return;
        }
        this.advance();
        uint64 dlen = this.pos_ - dstart - 1;
        bool closed = false;
        while (this.pos_ < this.len_) {
            if (this.peek() == ')' && this.match_delim(dstart, dlen) && this.peek_at(1 + dlen) == '"') {
                this.advance();
                uint64 k = 0;
                while (k < dlen) {
                    this.advance();
                    k = k + 1;
                }
                this.advance();
                closed = true;
                break;
            }
            this.advance();
        }
        if (!closed) {
            this.error_at(line, col, string("unterminated raw string literal"));
        }
        this.emit(line, col, this.tkc(string("string")), start, this.pos_ - start);
    }

    bool match_delim(uint64 dstart, uint64 dlen) {
        uint64 k = 0;
        while (k < dlen) {
            unsafe {
                const char* b = this.buf_;
                if (b[this.pos_ + 1 + k] != b[dstart + k]) {
                    return false;
                }
            }
            k = k + 1;
        }
        return true;
    }

    void scan() {
        while (this.pos_ < this.len_) {
            this.skip_trivia();
            if (this.pos_ >= this.len_) {
                break;
            }
            this.lex_token();
        }
        this.emit(this.line_, this.col_, this.tkc(string("eof")), this.pos_, 0);
    }

    // Print stored tokens in `ivy --lex` format (caller: lexdrive).
    void print_toks() {
        string src = this.src_;
        uint64 eof_code = this.tkc(string("eof"));
        uint64 i = 0;
        uint64 n = this.tok_count();
        while (i < n) {
            uint64 code = this.kind_at(i);
            uint64 ln = this.line_at(i);
            uint64 co = this.col_at(i);
            if (code == eof_code) {
                io::print("{}:{}\teof", ln, co);
            } else {
                string lx = src.substr(this.start_at(i), this.count_at(i));
                this.print_tok(code, ln, co, lx);
            }
            i = i + 1;
        }
    }
};
