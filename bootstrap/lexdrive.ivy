// bootstrap/lexdrive.ivy — F1.1 driver: lex files to `ivy --lex` format.
//
// Reads file paths from stdin (one per line; user main() takes no argv),
// lexes each with lexmod, prints `=== path ===` + token lines. Used by
// bootstrap/difftest.ps1 for differential testing vs the C++ lexer.

#pragma ivy cnumber

import string;
import lexmod;

extern "C" void __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);
extern "C" void __ivy_memcpy(void* dst, const void* src, unsigned long long n);

void lex_one_file(string path) {
    unsafe {
        char* content = io::read_file(path.cstr());
        if (content == (char*)0) {
            io::println("ivy: error: cannot open file '{}'", path.cstr());
            return;
        }
        uint64 len = __ivy_strlen(content);
        string src = string(content);
        __ivy_free(content);
        Lexer lx;
        lx.setup(src, len, path);
        // Pass 1: silent error detect.
        lx.scan();
        bool bad = lx.failed();
        lx.reset();
        if (bad) {
            // Pass 2a: print errors only (tokens suppressed, like run()).
            lx.print_errs_ = true;
            lx.scan();
        } else {
            // Pass 2b: store + print tokens.
            lx.store_ = true;
            lx.scan();
            lx.print_toks();
        }
    }
}

void lex_all() {
    while (true) {
        bool done = false;
        unsafe {
            char* line = io::read_line();
            if (line == (char*)0) {
                done = true;
            } else {
                // Strip a trailing CR so CRLF-fed stdin still yields a
                // valid path (read_line strips LF only).
                uint64 n = __ivy_strlen(line);
                if (n > 0 && line[n - 1] == '\r') {
                    char zero = 0;
                    __ivy_memcpy(line + (n - 1), &zero, 1);
                }
                string path = string(line);
                __ivy_free(line);
                io::println("=== {} ===", path.cstr());
                lex_one_file(path);
            }
        }
        if (done) {
            break;
        }
    }
}

int32 main() {
    lex_all();
    return 0;
}
