// bootstrap/lexer.ivy — F1.1: Ivy port of src/parsing/lexer.cpp (+ token.h).
//
// Reference implementation for differential testing: output must match
// `ivy --lex` (raw lexer dump) byte-for-byte on the corpus (examples/ +
// std/ + bootstrap/ + synthetic error files). See bootstrap/difftest.ps1.
//
// Design notes (constraints of the C++-built compiler):
// - User main() takes no argv → driver reads file paths from stdin
//   (io::read_line, one path per line).
// - Two passes per file: silent error-detect, then print pass (tokens if
//   clean, errors if not) — mirrors run(): diagnostics suppress tokens.
// - Keywords: linear if-chain over string == (exact; hash_set<string>
//   would hash pointer bytes, not contents).
// - All raw-pointer indexing inside unsafe blocks.

#pragma ivy cnumber
import string;

extern "C" void* __ivy_alloc(unsigned long long n);
extern "C" void __ivy_free(void* p);
extern "C" unsigned long long __ivy_strlen(const char* s);
extern "C" void __ivy_memcpy(void* dst, const void* src, unsigned long long n);

// Full C++ keyword set, mirrored from Lexer::keywords().
// The parser decides subset validity; the lexer knows them all.
bool is_keyword(string id) {
        if (id == string("alignas")) { return true; }
        if (id == string("alignof")) { return true; }
        if (id == string("and")) { return true; }
        if (id == string("and_eq")) { return true; }
        if (id == string("asm")) { return true; }
        if (id == string("auto")) { return true; }
        if (id == string("bfloat16")) { return true; }
        if (id == string("bfloat16_t")) { return true; }
        if (id == string("bitand")) { return true; }
        if (id == string("bitor")) { return true; }
        if (id == string("bool")) { return true; }
        if (id == string("break")) { return true; }
        if (id == string("case")) { return true; }
        if (id == string("catch")) { return true; }
        if (id == string("char")) { return true; }
        if (id == string("char16_t")) { return true; }
        if (id == string("char32_t")) { return true; }
        if (id == string("char8_t")) { return true; }
        if (id == string("class")) { return true; }
        if (id == string("co_await")) { return true; }
        if (id == string("co_return")) { return true; }
        if (id == string("co_yield")) { return true; }
        if (id == string("compl")) { return true; }
        if (id == string("concept")) { return true; }
        if (id == string("const")) { return true; }
        if (id == string("const_cast")) { return true; }
        if (id == string("consteval")) { return true; }
        if (id == string("constexpr")) { return true; }
        if (id == string("constinit")) { return true; }
        if (id == string("continue")) { return true; }
        if (id == string("cpp")) { return true; }
        if (id == string("decltype")) { return true; }
        if (id == string("default")) { return true; }
        if (id == string("delete")) { return true; }
        if (id == string("do")) { return true; }
        if (id == string("double")) { return true; }
        if (id == string("dynamic_cast")) { return true; }
        if (id == string("else")) { return true; }
        if (id == string("enum")) { return true; }
        if (id == string("explicit")) { return true; }
        if (id == string("export")) { return true; }
        if (id == string("extern")) { return true; }
        if (id == string("false")) { return true; }
        if (id == string("final")) { return true; }
        if (id == string("float")) { return true; }
        if (id == string("float128")) { return true; }
        if (id == string("float128_t")) { return true; }
        if (id == string("float16")) { return true; }
        if (id == string("float16_t")) { return true; }
        if (id == string("float32")) { return true; }
        if (id == string("float32_t")) { return true; }
        if (id == string("float64")) { return true; }
        if (id == string("float64_t")) { return true; }
        if (id == string("fn")) { return true; }
        if (id == string("for")) { return true; }
        if (id == string("friend")) { return true; }
        if (id == string("goto")) { return true; }
        if (id == string("if")) { return true; }
        if (id == string("import")) { return true; }
        if (id == string("inline")) { return true; }
        if (id == string("int")) { return true; }
        if (id == string("int128")) { return true; }
        if (id == string("int16")) { return true; }
        if (id == string("int16_t")) { return true; }
        if (id == string("int32")) { return true; }
        if (id == string("int32_t")) { return true; }
        if (id == string("int64")) { return true; }
        if (id == string("int64_t")) { return true; }
        if (id == string("int8")) { return true; }
        if (id == string("int8_t")) { return true; }
        if (id == string("iptr")) { return true; }
        if (id == string("lifetime")) { return true; }
        if (id == string("long")) { return true; }
        if (id == string("max_align_t")) { return true; }
        if (id == string("module")) { return true; }
        if (id == string("mutable")) { return true; }
        if (id == string("namespace")) { return true; }
        if (id == string("new")) { return true; }
        if (id == string("nextcase")) { return true; }
        if (id == string("noexcept")) { return true; }
        if (id == string("not")) { return true; }
        if (id == string("not_eq")) { return true; }
        if (id == string("nullopt")) { return true; }
        if (id == string("nullptr")) { return true; }
        if (id == string("nullptr_t")) { return true; }
        if (id == string("operator")) { return true; }
        if (id == string("or")) { return true; }
        if (id == string("or_eq")) { return true; }
        if (id == string("override")) { return true; }
        if (id == string("private")) { return true; }
        if (id == string("protected")) { return true; }
        if (id == string("ptrdiff_t")) { return true; }
        if (id == string("public")) { return true; }
        if (id == string("register")) { return true; }
        if (id == string("reinterpret_cast")) { return true; }
        if (id == string("requires")) { return true; }
        if (id == string("return")) { return true; }
        if (id == string("short")) { return true; }
        if (id == string("signed")) { return true; }
        if (id == string("size")) { return true; }
        if (id == string("size_t")) { return true; }
        if (id == string("sizeof")) { return true; }
        if (id == string("static")) { return true; }
        if (id == string("static_assert")) { return true; }
        if (id == string("static_cast")) { return true; }
        if (id == string("struct")) { return true; }
        if (id == string("switch")) { return true; }
        if (id == string("template")) { return true; }
        if (id == string("this")) { return true; }
        if (id == string("thread_local")) { return true; }
        if (id == string("throw")) { return true; }
        if (id == string("true")) { return true; }
        if (id == string("try")) { return true; }
        if (id == string("typedef")) { return true; }
        if (id == string("typeid")) { return true; }
        if (id == string("typename")) { return true; }
        if (id == string("uint128")) { return true; }
        if (id == string("uint16")) { return true; }
        if (id == string("uint16_t")) { return true; }
        if (id == string("uint32")) { return true; }
        if (id == string("uint32_t")) { return true; }
        if (id == string("uint64")) { return true; }
        if (id == string("uint64_t")) { return true; }
        if (id == string("uint8")) { return true; }
        if (id == string("uint8_t")) { return true; }
        if (id == string("union")) { return true; }
        if (id == string("unsafe")) { return true; }
        if (id == string("unsigned")) { return true; }
        if (id == string("uptr")) { return true; }
        if (id == string("using")) { return true; }
        if (id == string("virtual")) { return true; }
        if (id == string("void")) { return true; }
        if (id == string("volatile")) { return true; }
        if (id == string("wchar_t")) { return true; }
        if (id == string("while")) { return true; }
        if (id == string("xor")) { return true; }
        if (id == string("xor_eq")) { return true; }
    return false;
}

bool is_raw_prefix(string id) {
    if (id == string("R")) { return true; }
    if (id == string("u8R")) { return true; }
    if (id == string("uR")) { return true; }
    if (id == string("UR")) { return true; }
    if (id == string("LR")) { return true; }
    return false;
}

bool is_str_prefix(string id) {
    if (id == string("L")) { return true; }
    if (id == string("u")) { return true; }
    if (id == string("U")) { return true; }
    if (id == string("u8")) { return true; }
    return false;
}

bool is_char_prefix(string id) {
    if (id == string("L")) { return true; }
    if (id == string("u")) { return true; }
    if (id == string("U")) { return true; }
    return false;
}

bool ch_is_ident_start(char c) {
    if (c == '_') { return true; }
    if (c >= 'a') {
        if (c <= 'z') { return true; }
    }
    if (c >= 'A') {
        if (c <= 'Z') { return true; }
    }
    return false;
}

bool ch_is_ident_cont(char c) {
    if (ch_is_ident_start(c)) { return true; }
    if (c >= '0') {
        if (c <= '9') { return true; }
    }
    return false;
}

bool ch_is_digit(char c) {
    if (c >= '0') {
        if (c <= '9') { return true; }
    }
    return false;
}

bool ch_is_hex(char c) {
    if (ch_is_digit(c)) { return true; }
    if (c >= 'a') {
        if (c <= 'f') { return true; }
    }
    if (c >= 'A') {
        if (c <= 'F') { return true; }
    }
    return false;
}

bool ch_is_bin(char c) {
    if (c == '0') { return true; }
    if (c == '1') { return true; }
    return false;
}

bool ch_is_suffix(char c) {
    if (c == 'u') { return true; }
    if (c == 'U') { return true; }
    if (c == 'l') { return true; }
    if (c == 'L') { return true; }
    if (c == 'f') { return true; }
    if (c == 'F') { return true; }
    return false;
}

struct Lexer {
    string src_;
    const char* buf_;
    uint64 len_;
    uint64 pos_;
    uint64 line_;
    uint64 col_;
    string path_;
    // mode: 0 = silent error-detect, 1 = print tokens, 2 = print errors.
    uint64 mode_;
    bool failed_;

    void setup(string src, uint64 len, string path) {
        this.src_ = src;
        this.len_ = len;
        this.pos_ = 0;
        this.line_ = 1;
        this.col_ = 1;
        this.path_ = path;
        this.mode_ = 0;
        this.failed_ = false;
        unsafe {
            this.buf_ = this.src_.cstr();
        }
        this.check_bom();
    }

    void reset() {
        this.pos_ = 0;
        this.line_ = 1;
        this.col_ = 1;
        this.check_bom();
    }

    void check_bom() {
        unsafe {
            if (this.len_ >= 3) {
                const char* b = this.buf_;
                int32 b0 = (int32)b[0];
                int32 b1 = (int32)b[1];
                int32 b2 = (int32)b[2];
                if (b0 == 239 && b1 == 187 && b2 == 191) {
                    this.pos_ = 3;
                }
            }
        }
    }

    // Bounds-checked peek: NUL past the end (mirrors C++ peek()).
    char peek_at(uint64 off) {
        unsafe {
            const char* b = this.buf_;
            if (this.pos_ + off >= this.len_) {
                return '\0';
            }
            return b[this.pos_ + off];
        }
        return '?';
    }

    char peek() {
        return this.peek_at(0);
    }

    void advance() {
        unsafe {
            const char* b = this.buf_;
            char c = b[this.pos_];
            this.pos_ = this.pos_ + 1;
            if (c == '\n') {
                this.line_ = this.line_ + 1;
                this.col_ = 1;
            } else {
                this.col_ = this.col_ + 1;
            }
        }
    }

    void error_at(uint64 line, uint64 col, string msg) {
        this.failed_ = true;
        if (this.mode_ == 2) {
            // Quoted path mirrors main.cpp (filesystem::path operator<<).
            io::println("\"{}\":{}:{}: error: {}", this.path_.cstr(), line, col, msg.cstr());
        }
    }

    void emit_kind(uint64 line, uint64 col, string kind) {
        if (this.mode_ == 1) {
            io::println("{}:{}\t{}", line, col, kind.cstr());
        }
    }

    void emit_lex(uint64 line, uint64 col, string kind, string lex) {
        if (this.mode_ == 1) {
            io::println("{}:{}\t{}\t'{}'", line, col, kind.cstr(), lex.cstr());
        }
    }

    void skip_trivia() {
        while (true) {
            char c = this.peek();
            if (c == ' ' || c == '\t' || c == '\r' || c == '\v' || c == '\f' || c == '\n') {
                this.advance();
            } else {
                if (c == '/' && this.peek_at(1) == '/') {
                    while (this.peek() != '\n' && this.peek() != '\0') {
                        this.advance();
                    }
                } else {
                    if (c == '/' && this.peek_at(1) == '*') {
                        uint64 sl = this.line_;
                        uint64 sc = this.col_;
                        this.advance();
                        this.advance();
                        bool closed = false;
                        while (this.peek() != '\0') {
                            if (this.peek() == '*' && this.peek_at(1) == '/') {
                                this.advance();
                                this.advance();
                                closed = true;
                                break;
                            }
                            this.advance();
                        }
                        if (!closed) {
                            this.error_at(sl, sc, string("unterminated block comment"));
                        }
                    } else {
                        break;
                    }
                }
            }
        }
    }

    void lex_word(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        while (ch_is_ident_cont(this.peek())) {
            this.advance();
        }
        string id = src.substr(start, this.pos_ - start);
        if (is_raw_prefix(id) && this.peek() == '"') {
            this.lex_raw(start, line, col);
            return;
        }
        if (is_str_prefix(id)) {
            if (this.peek() == '"') {
                this.lex_string(start, line, col);
                return;
            }
            if (this.peek() == '\'') {
                this.lex_char(start, line, col);
                return;
            }
        }
        if (is_keyword(id)) {
            this.emit_lex(line, col, string("keyword"), id);
        } else {
            this.emit_lex(line, col, string("identifier"), id);
        }
    }

    void lex_token() {
        string src = this.src_;
        uint64 start = this.pos_;
        uint64 line = this.line_;
        uint64 col = this.col_;
        char c = this.peek();
        // $identifier — lifetime variable token.
        if (c == '$' && ch_is_ident_start(this.peek_at(1))) {
            this.advance();
            while (ch_is_ident_cont(this.peek())) {
                this.advance();
            }
            this.emit_lex(line, col, string("lifetime"), src.substr(start, this.pos_ - start));
            return;
        }
        if (ch_is_ident_start(c)) {
            this.lex_word(start, line, col);
            return;
        }
        if (ch_is_digit(c) || (c == '.' && ch_is_digit(this.peek_at(1)))) {
            this.lex_number(line, col);
            return;
        }
        if (c == '"') {
            this.lex_string(start, line, col);
            return;
        }
        if (c == '\'') {
            this.lex_char(start, line, col);
            return;
        }
        if (this.try_op3(start, line, col)) {
            return;
        }
        if (this.try_op2(start, line, col)) {
            return;
        }
        if (this.try_op1(start, line, col)) {
            return;
        }
        this.error_at(line, col, string("unexpected character"));
        this.advance();
        // Mirror C++: recovery emits an EOF-kind token which stops --tokens.
        this.emit_kind(line, col, string("eof"));
    }

    // Longest-match operator scan, in kOperators table order.
    bool try_op3(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        char p0 = this.peek();
        char p1 = this.peek_at(1);
        char p2 = this.peek_at(2);
        if (p0 == '.' && p1 == '.' && p2 == '.') {
            this.advance();
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("..."), src.substr(start, 3));
            return true;
        }
        if (p0 == '<' && p1 == '<' && p2 == '=') {
            this.advance();
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("<<="), src.substr(start, 3));
            return true;
        }
        if (p0 == '>' && p1 == '>' && p2 == '=') {
            this.advance();
            this.advance();
            this.advance();
            this.emit_lex(line, col, string(">>="), src.substr(start, 3));
            return true;
        }
        if (p0 == '-' && p1 == '>' && p2 == '*') {
            this.advance();
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("->*"), src.substr(start, 3));
            return true;
        }
        return false;
    }

    bool try_op2(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        char p0 = this.peek();
        char p1 = this.peek_at(1);
        if (p0 == '<' && p1 == '<') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("<<"), src.substr(start, 2));
            return true;
        }
        if (p0 == '>' && p1 == '>') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string(">>"), src.substr(start, 2));
            return true;
        }
        if (p0 == '+' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("+="), src.substr(start, 2));
            return true;
        }
        if (p0 == '-' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("-="), src.substr(start, 2));
            return true;
        }
        if (p0 == '*' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("*="), src.substr(start, 2));
            return true;
        }
        if (p0 == '/' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("/="), src.substr(start, 2));
            return true;
        }
        if (p0 == '%' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("%="), src.substr(start, 2));
            return true;
        }
        if (p0 == '&' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("&="), src.substr(start, 2));
            return true;
        }
        if (p0 == '|' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("|="), src.substr(start, 2));
            return true;
        }
        if (p0 == '^' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("^="), src.substr(start, 2));
            return true;
        }
        if (p0 == '+' && p1 == '+') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("++"), src.substr(start, 2));
            return true;
        }
        if (p0 == '-' && p1 == '-') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("--"), src.substr(start, 2));
            return true;
        }
        if (p0 == '-' && p1 == '>') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("->"), src.substr(start, 2));
            return true;
        }
        if (p0 == '<' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("<="), src.substr(start, 2));
            return true;
        }
        if (p0 == '>' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string(">="), src.substr(start, 2));
            return true;
        }
        if (p0 == '=' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("=="), src.substr(start, 2));
            return true;
        }
        if (p0 == '!' && p1 == '=') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("!="), src.substr(start, 2));
            return true;
        }
        if (p0 == '&' && p1 == '&') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("&&"), src.substr(start, 2));
            return true;
        }
        if (p0 == '|' && p1 == '|') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("||"), src.substr(start, 2));
            return true;
        }
        if (p0 == ':' && p1 == ':') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("::"), src.substr(start, 2));
            return true;
        }
        if (p0 == '.' && p1 == '*') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string(".*"), src.substr(start, 2));
            return true;
        }
        if (p0 == '#' && p1 == '#') {
            this.advance();
            this.advance();
            this.emit_lex(line, col, string("##"), src.substr(start, 2));
            return true;
        }
        return false;
    }

    bool try_op1(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        char p0 = this.peek();
        if (p0 == '+') {
            this.advance();
            this.emit_lex(line, col, string("+"), src.substr(start, 1));
            return true;
        }
        if (p0 == '-') {
            this.advance();
            this.emit_lex(line, col, string("-"), src.substr(start, 1));
            return true;
        }
        if (p0 == '*') {
            this.advance();
            this.emit_lex(line, col, string("*"), src.substr(start, 1));
            return true;
        }
        if (p0 == '/') {
            this.advance();
            this.emit_lex(line, col, string("/"), src.substr(start, 1));
            return true;
        }
        if (p0 == '%') {
            this.advance();
            this.emit_lex(line, col, string("%"), src.substr(start, 1));
            return true;
        }
        if (p0 == '=') {
            this.advance();
            this.emit_lex(line, col, string("="), src.substr(start, 1));
            return true;
        }
        if (p0 == '<') {
            this.advance();
            this.emit_lex(line, col, string("<"), src.substr(start, 1));
            return true;
        }
        if (p0 == '>') {
            this.advance();
            this.emit_lex(line, col, string(">"), src.substr(start, 1));
            return true;
        }
        if (p0 == '!') {
            this.advance();
            this.emit_lex(line, col, string("!"), src.substr(start, 1));
            return true;
        }
        if (p0 == '~') {
            this.advance();
            this.emit_lex(line, col, string("~"), src.substr(start, 1));
            return true;
        }
        if (p0 == '&') {
            this.advance();
            this.emit_lex(line, col, string("&"), src.substr(start, 1));
            return true;
        }
        if (p0 == '|') {
            this.advance();
            this.emit_lex(line, col, string("|"), src.substr(start, 1));
            return true;
        }
        if (p0 == '^') {
            this.advance();
            this.emit_lex(line, col, string("^"), src.substr(start, 1));
            return true;
        }
        if (p0 == '?') {
            this.advance();
            this.emit_lex(line, col, string("?"), src.substr(start, 1));
            return true;
        }
        if (p0 == ':') {
            this.advance();
            this.emit_lex(line, col, string(":"), src.substr(start, 1));
            return true;
        }
        if (p0 == ';') {
            this.advance();
            this.emit_lex(line, col, string(";"), src.substr(start, 1));
            return true;
        }
        if (p0 == ',') {
            this.advance();
            this.emit_lex(line, col, string(","), src.substr(start, 1));
            return true;
        }
        if (p0 == '(') {
            this.advance();
            this.emit_lex(line, col, string("("), src.substr(start, 1));
            return true;
        }
        if (p0 == ')') {
            this.advance();
            this.emit_lex(line, col, string(")"), src.substr(start, 1));
            return true;
        }
        if (p0 == '{') {
            this.advance();
            this.emit_lex(line, col, string("{"), src.substr(start, 1));
            return true;
        }
        if (p0 == '}') {
            this.advance();
            this.emit_lex(line, col, string("}"), src.substr(start, 1));
            return true;
        }
        if (p0 == '[') {
            this.advance();
            this.emit_lex(line, col, string("["), src.substr(start, 1));
            return true;
        }
        if (p0 == ']') {
            this.advance();
            this.emit_lex(line, col, string("]"), src.substr(start, 1));
            return true;
        }
        if (p0 == '.') {
            this.advance();
            this.emit_lex(line, col, string("."), src.substr(start, 1));
            return true;
        }
        if (p0 == '#') {
            this.advance();
            this.emit_lex(line, col, string("#"), src.substr(start, 1));
            return true;
        }
        return false;
    }

    void lex_number(uint64 line, uint64 col) {
        string src = this.src_;
        uint64 start = this.pos_;
        bool is_float = false;
        if (this.peek() == '0' && (this.peek_at(1) == 'x' || this.peek_at(1) == 'X')) {
            this.advance();
            this.advance();
            bool any = false;
            while (ch_is_hex(this.peek()) || this.peek() == '\'') {
                if (this.peek() != '\'') {
                    any = true;
                }
                this.advance();
            }
            if (!any) {
                this.error_at(line, col, string("invalid hexadecimal literal: expected hex digits after '0x'"));
            }
        } else {
            if (this.peek() == '0' && (this.peek_at(1) == 'b' || this.peek_at(1) == 'B')) {
                this.advance();
                this.advance();
                bool any = false;
                while (ch_is_bin(this.peek()) || this.peek() == '\'') {
                    if (this.peek() != '\'') {
                        any = true;
                    }
                    this.advance();
                }
                if (!any) {
                    this.error_at(line, col, string("invalid binary literal: expected binary digits after '0b'"));
                }
            } else {
                while (ch_is_digit(this.peek()) || this.peek() == '\'') {
                    this.advance();
                }
                if (this.peek() == '.' && this.peek_at(1) != '.') {
                    is_float = true;
                    this.advance();
                    while (ch_is_digit(this.peek()) || this.peek() == '\'') {
                        this.advance();
                    }
                }
                if ((this.peek() == 'e' || this.peek() == 'E') && (ch_is_digit(this.peek_at(1)) || ((this.peek_at(1) == '+' || this.peek_at(1) == '-') && ch_is_digit(this.peek_at(2))))) {
                    is_float = true;
                    this.advance();
                    if (this.peek() == '+' || this.peek() == '-') {
                        this.advance();
                    }
                    while (ch_is_digit(this.peek()) || this.peek() == '\'') {
                        this.advance();
                    }
                }
            }
        }
        while (ch_is_suffix(this.peek())) {
            if (this.peek() == 'f' || this.peek() == 'F') {
                is_float = true;
            }
            this.advance();
        }
        if (is_float) {
            this.emit_lex(line, col, string("float"), src.substr(start, this.pos_ - start));
        } else {
            this.emit_lex(line, col, string("integer"), src.substr(start, this.pos_ - start));
        }
    }

    void lex_string(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        this.advance();
        while (true) {
            char c = this.peek();
            if (c == '\0' || c == '\n') {
                this.error_at(line, col, string("unterminated string literal"));
                break;
            }
            this.advance();
            if (c == '"') {
                break;
            }
            if (c == '\\' && this.peek() != '\0') {
                this.advance();
            }
        }
        this.emit_lex(line, col, string("string"), src.substr(start, this.pos_ - start));
    }

    void lex_char(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        this.advance();
        while (true) {
            char c = this.peek();
            if (c == '\0' || c == '\n') {
                this.error_at(line, col, string("unterminated character literal"));
                break;
            }
            this.advance();
            if (c == '\'') {
                break;
            }
            if (c == '\\' && this.peek() != '\0') {
                this.advance();
            }
        }
        this.emit_lex(line, col, string("char"), src.substr(start, this.pos_ - start));
    }

    void lex_raw(uint64 start, uint64 line, uint64 col) {
        string src = this.src_;
        this.advance();
        uint64 dstart = this.pos_;
        while (this.peek() != '(' && this.peek() != '\0' && this.peek() != '\n') {
            this.advance();
        }
        if (this.peek() != '(') {
            this.error_at(line, col, string("unterminated raw string literal"));
            this.emit_lex(line, col, string("string"), src.substr(start, this.pos_ - start));
            return;
        }
        this.advance();
        uint64 dlen = this.pos_ - dstart - 1;
        bool closed = false;
        while (this.pos_ < this.len_) {
            if (this.peek() == ')' && this.match_delim(dstart, dlen) && this.peek_at(1 + dlen) == '"') {
                this.advance();
                uint64 k = 0;
                while (k < dlen) {
                    this.advance();
                    k = k + 1;
                }
                this.advance();
                closed = true;
                break;
            }
            this.advance();
        }
        if (!closed) {
            this.error_at(line, col, string("unterminated raw string literal"));
        }
        this.emit_lex(line, col, string("string"), src.substr(start, this.pos_ - start));
    }

    bool match_delim(uint64 dstart, uint64 dlen) {
        uint64 k = 0;
        while (k < dlen) {
            unsafe {
                const char* b = this.buf_;
                if (b[this.pos_ + 1 + k] != b[dstart + k]) {
                    return false;
                }
            }
            k = k + 1;
        }
        return true;
    }

    void scan() {
        while (this.pos_ < this.len_) {
            this.skip_trivia();
            if (this.pos_ >= this.len_) {
                break;
            }
            this.lex_token();
        }
        // Differential target is `ivy --lex` (raw lexer dump): EOF carries
        // the lexer's own position, and (like --tokens) main.cpp breaks
        // before printing the trailing newline — so no newline after eof.
        // NOTE: the 0:0 EOF seen under --tokens comes from the PREPROCESSOR
        // (it appends EOF{0,0}); replicating that quirk belongs to F1.2.
        if (this.mode_ == 1) {
            io::print("{}:{}\teof", this.line_, this.col_);
        }
    }

    void run_file() {
        this.mode_ = 0;
        this.failed_ = false;
        this.scan();
        bool bad = this.failed_;
        this.reset();
        this.failed_ = false;
        if (bad) {
            this.mode_ = 2;
        } else {
            this.mode_ = 1;
        }
        this.scan();
    }
};

void lex_one_file(string path) {
    unsafe {
        char* content = io::read_file(path.cstr());
        if (content == (char*)0) {
            io::println("ivy: error: cannot open file '{}'", path.cstr());
            return;
        }
        uint64 len = __ivy_strlen(content);
        string src = string(content);
        __ivy_free(content);
        Lexer lx;
        lx.setup(src, len, path);
        lx.run_file();
    }
}

void lex_all() {
    while (true) {
        bool done = false;
        unsafe {
            char* line = io::read_line();
            if (line == (char*)0) {
                done = true;
            } else {
                // Strip a trailing CR so CRLF-fed stdin still yields a
                // valid path (read_line strips LF only). Store via
                // memcpy — mirrors std/string.ivy (no direct p[i] store).
                uint64 n = __ivy_strlen(line);
                if (n > 0 && line[n - 1] == '\r') {
                    char zero = 0;
                    __ivy_memcpy(line + (n - 1), &zero, 1);
                }
                string path = string(line);
                __ivy_free(line);
                io::println("=== {} ===", path.cstr());
                lex_one_file(path);
            }
        }
        if (done) {
            break;
        }
    }
}

int32 main() {
    lex_all();
    return 0;
}